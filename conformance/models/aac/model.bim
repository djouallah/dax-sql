{
  "name": "aac",
  "compatibilityLevel": 1604,
  "model": {
    "description": "Australia's National Electricity Market, over the Iceberg tables of the nem lakehouse, in Direct Lake: nothing is imported and no SQL endpoint is involved. Deployed by scripts/deploy_model.py, which writes the workspace and the lakehouse into the DirectLake expression. A quantity is one measure whatever the grain and whoever asks: the measures of fct_summary and fct_region pick the daily table or the 5-minute one themselves, by whether a time of day is asked for. Power BI and the dashboard's page (through its compiler) call the same measures.",
    "tables": [
      {
        "name": "dim_calendar",
        "description": "One row per day, from 2018-03-06 (where the history starts) to two years ahead.",
        "columns": [
          {
            "name": "date",
            "description": "Calendar date, NEM time (AEST all year).",
            "dataType": "dateTime",
            "sourceColumn": "date",
            "isKey": true,
            "sourceLineageTag": "date",
            "summarizeBy": "none",
            "formatString": "yyyy-MM-dd"
          },
          {
            "name": "year",
            "description": "Calendar year.",
            "dataType": "int64",
            "sourceColumn": "year",
            "sourceLineageTag": "year",
            "summarizeBy": "none"
          },
          {
            "name": "month",
            "description": "Month of the year, 1-12.",
            "dataType": "int64",
            "sourceColumn": "month",
            "sourceLineageTag": "month",
            "summarizeBy": "none"
          }
        ],
        "sourceLineageTag": "[mart].[dim_calendar]",
        "partitions": [
          {
            "name": "dim_calendar",
            "source": {
              "type": "entity",
              "entityName": "dim_calendar"
            }
          }
        ]
      },
      {
        "name": "dim_duid",
        "description": "One row per unit: the units on AEMO's registration list, the ones in the data that are not on it (retired plant, replaced DUIDs), and the WA facilities.",
        "columns": [
          {
            "name": "DUID",
            "description": "AEMO's id of a dispatchable unit.",
            "dataType": "string",
            "sourceColumn": "DUID",
            "isKey": true,
            "sourceLineageTag": "DUID",
            "summarizeBy": "none"
          },
          {
            "name": "Region",
            "description": "NSW1, QLD1, SA1, TAS1, VIC1; WA1 for Western Australia, another market.",
            "dataType": "string",
            "sourceColumn": "Region",
            "sourceLineageTag": "Region",
            "summarizeBy": "none"
          },
          {
            "name": "State",
            "description": "The region's name.",
            "dataType": "string",
            "sourceColumn": "State",
            "sourceLineageTag": "State",
            "summarizeBy": "none"
          },
          {
            "name": "FuelSourceDescriptor",
            "description": "The fuel as registered; blank for the loads AEMO gives no energy source for.",
            "dataType": "string",
            "sourceColumn": "FuelSourceDescriptor",
            "sourceLineageTag": "FuelSourceDescriptor",
            "summarizeBy": "none"
          },
          {
            "name": "Participant",
            "description": "The registered participant that operates the unit.",
            "dataType": "string",
            "sourceColumn": "Participant",
            "sourceLineageTag": "Participant",
            "summarizeBy": "none"
          },
          {
            "name": "StationName",
            "description": "The power station the unit belongs to; blank for WA.",
            "dataType": "string",
            "sourceColumn": "StationName",
            "sourceLineageTag": "StationName",
            "summarizeBy": "none"
          },
          {
            "name": "TechnologyType",
            "description": "AEMO's technology descriptor; blank off the registration list.",
            "dataType": "string",
            "sourceColumn": "TechnologyType",
            "sourceLineageTag": "TechnologyType",
            "summarizeBy": "none"
          },
          {
            "name": "Classification",
            "description": "Scheduled, Semi-Scheduled (wind and solar farms that can be capped) or Non-Scheduled; blank off the registration list.",
            "dataType": "string",
            "sourceColumn": "Classification",
            "sourceLineageTag": "Classification",
            "summarizeBy": "none"
          },
          {
            "name": "CO2eFactor",
            "description": "CO2-e emitted per MWh sent out, tonnes: AEMO's factor for the unit's gensets (MMSDM GENUNITS through DUALLOC), registered or not. Blank for loads, AEMO's dummy units, the gensets AEMO lists \"On Exclusion List\" and WA.",
            "dataType": "double",
            "sourceColumn": "CO2eFactor",
            "sourceLineageTag": "CO2eFactor",
            "summarizeBy": "none",
            "formatString": "0.000"
          },
          {
            "name": "Renewable",
            "description": "Whether the unit's fuel is renewable; the list of fuels is in dim_duid.sql.",
            "dataType": "boolean",
            "sourceColumn": "Renewable",
            "sourceLineageTag": "Renewable",
            "summarizeBy": "none"
          },
          {
            "name": "RegCapMW",
            "description": "Registered generating capacity, MW.",
            "dataType": "double",
            "sourceColumn": "RegCapMW",
            "sourceLineageTag": "RegCapMW",
            "summarizeBy": "none"
          },
          {
            "name": "MaxCapMW",
            "description": "Maximum generating capacity, MW.",
            "dataType": "double",
            "sourceColumn": "MaxCapMW",
            "sourceLineageTag": "MaxCapMW",
            "summarizeBy": "none"
          },
          {
            "name": "StorageMWh",
            "description": "A battery's storage, MWh.",
            "dataType": "double",
            "sourceColumn": "StorageMWh",
            "sourceLineageTag": "StorageMWh",
            "summarizeBy": "none"
          },
          {
            "name": "latitude",
            "description": "Latitude; blank when unknown.",
            "dataType": "double",
            "sourceColumn": "latitude",
            "sourceLineageTag": "latitude",
            "summarizeBy": "none"
          },
          {
            "name": "longitude",
            "description": "Longitude; blank when unknown.",
            "dataType": "double",
            "sourceColumn": "longitude",
            "sourceLineageTag": "longitude",
            "summarizeBy": "none"
          },
          {
            "name": "Storage",
            "description": "Whether the unit is storage, a battery (the fuel \"Grid\"). The rule is in dim_duid.sql; the measures that leave storage out filter on it.",
            "dataType": "boolean",
            "sourceColumn": "Storage",
            "sourceLineageTag": "Storage",
            "summarizeBy": "none"
          },
          {
            "name": "Plant",
            "description": "What units are grouped by when they are grouped by plant: the station, or the unit itself when it has none.",
            "dataType": "string",
            "sourceColumn": "Plant",
            "sourceLineageTag": "Plant",
            "summarizeBy": "none"
          },
          {
            "name": "Owner",
            "description": "Who the output is counted to: the participant, or for rooftop solar the estimate it is. Blank where AEMO names no participant.",
            "dataType": "string",
            "sourceColumn": "Owner",
            "sourceLineageTag": "Owner",
            "summarizeBy": "none"
          }
        ],
        "sourceLineageTag": "[mart].[dim_duid]",
        "partitions": [
          {
            "name": "dim_duid",
            "source": {
              "type": "entity",
              "entityName": "dim_duid"
            }
          }
        ],
        "measures": [
          {
            "name": "Registered units",
            "description": "The units in the selection, whether they ran or not. For the ones that did, [Units].",
            "expression": "COUNTROWS(dim_duid)",
            "formatString": "#,##0"
          },
          {
            "name": "Registered MW",
            "description": "Registered generating capacity of the units in the selection, MW.",
            "expression": "SUM(dim_duid[RegCapMW])",
            "formatString": "#,##0"
          },
          {
            "name": "Storage MWh",
            "description": "Storage of the batteries in the selection, MWh.",
            "expression": "SUM(dim_duid[StorageMWh])",
            "formatString": "#,##0"
          }
        ]
      },
      {
        "name": "fct_summary",
        "description": "Output and price per unit and 5 minutes: the daily files where they have landed, the intraday feed after them. A unit's row carries the price of its region, so no measure joins two facts. An interval at 0 MW is not stored.",
        "columns": [
          {
            "name": "date",
            "description": "Date of the dispatch interval, NEM time (AEST all year).",
            "dataType": "dateTime",
            "sourceColumn": "date",
            "sourceLineageTag": "date",
            "summarizeBy": "none",
            "formatString": "yyyy-MM-dd"
          },
          {
            "name": "time",
            "description": "Time of day as HHMM: 1435 is 14:35. The interval ends at it.",
            "dataType": "int64",
            "sourceColumn": "time",
            "sourceLineageTag": "time",
            "summarizeBy": "none"
          },
          {
            "name": "DUID",
            "description": "The unit.",
            "dataType": "string",
            "sourceColumn": "DUID",
            "sourceLineageTag": "DUID",
            "summarizeBy": "none"
          },
          {
            "name": "mw",
            "description": "MW in that 5 minutes; a battery charging is negative.",
            "dataType": "decimal",
            "sourceColumn": "mw",
            "sourceLineageTag": "mw",
            "summarizeBy": "none",
            "formatString": "#,##0.00"
          },
          {
            "name": "price",
            "description": "The regional reference price of the unit's region in that interval, $/MWh.",
            "dataType": "decimal",
            "sourceColumn": "price",
            "sourceLineageTag": "price",
            "summarizeBy": "none",
            "formatString": "$#,##0.00"
          },
          {
            "name": "cutoff",
            "description": "The newest interval in the facts when the row was written. Provenance only.",
            "dataType": "dateTime",
            "sourceColumn": "cutoff",
            "sourceLineageTag": "cutoff",
            "summarizeBy": "none",
            "formatString": "yyyy-MM-dd HH:mm"
          }
        ],
        "sourceLineageTag": "[mart].[fct_summary]",
        "partitions": [
          {
            "name": "fct_summary",
            "source": {
              "type": "entity",
              "entityName": "fct_summary"
            }
          }
        ],
        "measures": [
          {
            "name": "Reads 5 minutes",
            "description": "Whether the measures of fct_summary have to read it rather than its daily table: a time of day is asked for (any column of dim_time is filtered or grouped), or a column of fct_summary itself is filtered. Hidden: it is the one place the rule is written.",
            "expression": "ISCROSSFILTERED(dim_time[time]) || ISFILTERED(fct_summary[date]) || ISFILTERED(fct_summary[time]) || ISFILTERED(fct_summary[DUID]) || ISFILTERED(fct_summary[mw]) || ISFILTERED(fct_summary[price]) || ISFILTERED(fct_summary[cutoff])",
            "isHidden": true
          },
          {
            "name": "Newest whole day",
            "description": "The newest day fct_summary_daily holds, whatever the filters: the measures that read it add fct_summary for the days after it. The daily table is written in date order with no gaps (a day once it is whole, the days after its newest; a refill below its oldest), so the days after this one are the days it lacks. A cutoff, not the set of those days (an EXCEPT): over a year grouped by unit or plant, that set took more memory than the capacity gives a query (1.4 GB against 1 GB, 2026-10-07). Hidden: it is the one place the rule is written.",
            "expression": "CALCULATE(MAX(fct_summary_daily[date]), REMOVEFILTERS())",
            "isHidden": true
          },
          {
            "name": "Generation MWh",
            "description": "Energy generated. Output only: a unit that is charging (negative) generates nothing. A 5-minute row is MW / 12. Which table: fct_summary when a time of day is asked for (dim_time is filtered or grouped) or a column of fct_summary is filtered; otherwise fct_summary_daily, plus fct_summary for the days after the newest one the daily table holds ([Newest whole day]). The number is the same from either. CONVERT is there because MW is a fixed decimal: divided as one, the energy of a small unit at one 5-minute time is rounded to 4 decimals. Rooftop solar is in it: five units, ROOFTOP_<region>, the half-hourly estimate on the straight line between two half hours.",
            "expression": "VAR _last = [Newest whole day]\nRETURN\n    IF([Reads 5 minutes],\n        CONVERT(SUMX(fct_summary, MAX(fct_summary[mw], 0)), DOUBLE) / 12,\n        SUM(fct_summary_daily[output_mwh]) + CONVERT(CALCULATE(SUMX(fct_summary, MAX(fct_summary[mw], 0)), KEEPFILTERS(dim_calendar[date] > _last)), DOUBLE) / 12)",
            "formatString": "#,##0"
          },
          {
            "name": "Charging MWh",
            "description": "Energy the batteries took, negative. Which table: fct_summary when a time of day is asked for (dim_time is filtered or grouped) or a column of fct_summary is filtered; otherwise fct_summary_daily, plus fct_summary for the days after the newest one the daily table holds ([Newest whole day]). The number is the same from either. CONVERT is there because MW is a fixed decimal: divided as one, the energy of a small unit at one 5-minute time is rounded to 4 decimals.",
            "expression": "VAR _last = [Newest whole day]\nRETURN\n    IF([Reads 5 minutes],\n        CONVERT(SUMX(fct_summary, MIN(fct_summary[mw], 0)), DOUBLE) / 12,\n        SUM(fct_summary_daily[charging_mwh]) + CONVERT(CALCULATE(SUMX(fct_summary, MIN(fct_summary[mw], 0)), KEEPFILTERS(dim_calendar[date] > _last)), DOUBLE) / 12)",
            "formatString": "#,##0"
          },
          {
            "name": "Revenue",
            "description": "What the output earned at the spot price, $: each 5 minutes of output at the price of the unit's region in that interval. Which table: fct_summary when a time of day is asked for (dim_time is filtered or grouped) or a column of fct_summary is filtered; otherwise fct_summary_daily, plus fct_summary for the days after the newest one the daily table holds ([Newest whole day]). The number is the same from either.",
            "expression": "VAR _last = [Newest whole day]\nRETURN\n    IF([Reads 5 minutes],\n        SUMX(fct_summary, MAX(fct_summary[mw], 0) * fct_summary[price]) / 12,\n        SUM(fct_summary_daily[revenue]) + CALCULATE(SUMX(fct_summary, MAX(fct_summary[mw], 0) * fct_summary[price]), KEEPFILTERS(dim_calendar[date] > _last)) / 12)",
            "formatString": "$#,##0"
          },
          {
            "name": "Capture price",
            "description": "The price the output earned, $/MWh: the 5-minute prices of the unit's region weighted by the output. From [Revenue] and [Generation MWh], so it reads the table they read.",
            "expression": "DIVIDE([Revenue], [Generation MWh])",
            "formatString": "$#,##0.00"
          },
          {
            "name": "Units",
            "description": "Units with output or charging in the selection, rooftop solar's five (one per region) left out: they are not plant. Which table: fct_summary when a time of day is asked for (dim_time is filtered or grouped) or a column of fct_summary is filtered; otherwise fct_summary_daily, plus fct_summary for the days after the newest one the daily table holds ([Newest whole day]). The number is the same from either.",
            "expression": "VAR _last = [Newest whole day]\nRETURN\n    CALCULATE(\n        IF([Reads 5 minutes],\n            DISTINCTCOUNT(fct_summary[DUID]),\n            COUNTROWS(DISTINCT(UNION(VALUES(fct_summary_daily[DUID]), CALCULATETABLE(VALUES(fct_summary[DUID]), KEEPFILTERS(dim_calendar[date] > _last)))))),\n        KEEPFILTERS(dim_duid[FuelSourceDescriptor] <> \"Rooftop solar\"))",
            "formatString": "#,##0"
          },
          {
            "name": "Latest update",
            "description": "The newest interval the table had seen at its last write, whatever is filtered.",
            "expression": "CALCULATE(MAX(fct_summary[cutoff]), REMOVEFILTERS())",
            "formatString": "yyyy-MM-dd HH:mm"
          },
          {
            "name": "Renewable share",
            "description": "Renewable share of the output, %. Rooftop solar is in it, as the units of the fuel \"Rooftop solar\". Batteries (fuel Grid) are in neither the renewables nor the total. 0 when the units ran and none is renewable, blank when no generator ran.",
            "expression": "DIVIDE(\n    100 * COALESCE(CALCULATE([Generation MWh], dim_duid[Renewable] = TRUE()), 0),\n    CALCULATE([Generation MWh], dim_duid[Storage] = FALSE())\n)",
            "formatString": "0.0"
          },
          {
            "name": "Generation share",
            "description": "The share of the output of all the units the selection shows, %: per fuel, the fuel's part of what is shown. Batteries discharging are in the whole, as they are in the stack of the generation chart.",
            "expression": "DIVIDE(100 * [Generation MWh], CALCULATE([Generation MWh], ALLSELECTED(dim_duid)))",
            "formatString": "0.0"
          },
          {
            "name": "Renewable share change",
            "description": "The change of [Renewable share], percentage points. Against the days just before the selection: as many days, ending the day before its first. Blank unless both have every hour of their days. Asked over a range of dim_calendar[date].",
            "expression": "VAR _first = MIN(dim_calendar[date])\nVAR _days = DATEDIFF(_first, MAX(dim_calendar[date]), DAY) + 1\nVAR _now = [Renewable share]\nVAR _before = CALCULATE([Renewable share], DATESBETWEEN(dim_calendar[date], _first - _days, _first - 1))\nVAR _whole = [Hours] = 24 * _days && CALCULATE([Hours], DATESBETWEEN(dim_calendar[date], _first - _days, _first - 1)) = 24 * _days\nRETURN IF(_whole, _now - _before)",
            "formatString": "0.0"
          },
          {
            "name": "Capacity MW",
            "description": "The registered capacity of the units that have output in the selection, MW: what [Capacity factor] divides by. [Registered MW] is every unit on the list, whether it ran or not.",
            "expression": "VAR _last = [Newest whole day]\nRETURN\n    IF([Reads 5 minutes],\n        CALCULATE(SUM(dim_duid[RegCapMW]), SUMMARIZE(fct_summary, dim_duid[DUID])),\n        CALCULATE(SUM(dim_duid[RegCapMW]),\n            DISTINCT(UNION(SUMMARIZE(fct_summary_daily, dim_duid[DUID]), CALCULATETABLE(SUMMARIZE(fct_summary, dim_duid[DUID]), KEEPFILTERS(dim_calendar[date] > _last))))))",
            "formatString": "#,##0"
          },
          {
            "name": "Capacity factor",
            "description": "Energy over what the registered capacity could make in the hours of the selection, %. The capacity is that of the units with output or charging in the selection (found in the daily table when no time of day is asked for); a unit without a registered capacity is left out. The hours are [Hours].",
            "expression": "VAR hours = [Hours]\nVAR capacity = [Capacity MW]\nRETURN DIVIDE(100 * CALCULATE([Generation MWh], dim_duid[RegCapMW] > 0), capacity * hours)",
            "formatString": "0.0"
          },
          {
            "name": "Generation MW",
            "description": "Output of the units in MW at a 5-minute time, always from fct_summary: read it at one time, it is a sum over the intervals in the selection. For energy use [Generation MWh]. Rooftop solar is in it: five units, ROOFTOP_<region>, the half-hourly estimate on the straight line between two half hours.",
            "expression": "SUMX(fct_summary, MAX(fct_summary[mw], 0))",
            "formatString": "#,##0"
          },
          {
            "name": "Charging MW",
            "description": "What the batteries are taking in MW at a 5-minute time, negative, always from fct_summary: read it at one time, like [Generation MW]. For energy use [Charging MWh].",
            "expression": "SUMX(fct_summary, MIN(fct_summary[mw], 0))",
            "formatString": "#,##0"
          },
          {
            "name": "Average MW",
            "description": "A unit's average MW over the 5-minute intervals it ran in, always from fct_summary: an interval at 0 MW has no row and is not counted. Read it per unit.",
            "expression": "AVERAGE(fct_summary[mw])",
            "formatString": "#,##0.0"
          },
          {
            "name": "Days with output",
            "description": "The days on which the selection has output or charging, always from fct_summary. At one time of day, what an average day divides by.",
            "expression": "DISTINCTCOUNT(fct_summary[date])",
            "formatString": "#,##0"
          },
          {
            "name": "Price seen",
            "description": "The plain average of the price on the units' rows, $/MWh, always from fct_summary: the price the units in the selection saw while they ran, not weighted by their output.",
            "expression": "AVERAGE(fct_summary[price])",
            "formatString": "$#,##0.00"
          },
          {
            "name": "Charging price",
            "description": "The price the charging paid, $/MWh: the 5-minute prices of the unit's region weighted by what it took. Always from fct_summary. Next to [Capture price], a battery's spread.",
            "expression": "DIVIDE(SUMX(fct_summary, MIN(fct_summary[mw], 0) * fct_summary[price]), SUMX(fct_summary, MIN(fct_summary[mw], 0)))",
            "formatString": "$#,##0.00"
          },
          {
            "name": "Battery spread",
            "description": "What a MWh discharged earned over what a MWh charged paid, $/MWh: [Capture price] less [Charging price]. Blank unless the selection both discharged and charged.",
            "expression": "VAR _sold = [Capture price]\nVAR _bought = [Charging price]\nRETURN IF(NOT ISBLANK(_sold) && NOT ISBLANK(_bought), _sold - _bought)",
            "formatString": "$#,##0.00"
          },
          {
            "name": "Average generation MW",
            "description": "The output as an average MW: [Generation MWh] over [Hours], the hours the selection holds. Follows the unit filters; rooftop solar is in it, as the units of the fuel \"Rooftop solar\".",
            "expression": "DIVIDE([Generation MWh], [Hours])",
            "formatString": "#,##0"
          },
          {
            "name": "Average generation MW change",
            "description": "The change of [Average generation MW], %. Against the days just before the selection: as many days, ending the day before its first. Blank unless both have every hour of their days. Asked over a range of dim_calendar[date].",
            "expression": "VAR _first = MIN(dim_calendar[date])\nVAR _days = DATEDIFF(_first, MAX(dim_calendar[date]), DAY) + 1\nVAR _now = [Average generation MW]\nVAR _before = CALCULATE([Average generation MW], DATESBETWEEN(dim_calendar[date], _first - _days, _first - 1))\nVAR _whole = [Hours] = 24 * _days && CALCULATE([Hours], DATESBETWEEN(dim_calendar[date], _first - _days, _first - 1)) = 24 * _days\nRETURN IF(_whole, DIVIDE(100 * (_now - _before), _before))",
            "formatString": "0.0"
          },
          {
            "name": "Generation MW on an average day",
            "description": "By time of day: the output at that time on an average day, MW. [Generation MW] over the days that have a row at it. Always from fct_summary.",
            "expression": "DIVIDE([Generation MW], [Days with output])",
            "formatString": "#,##0.0"
          },
          {
            "name": "Charging MW on an average day",
            "description": "By time of day: what the units took at that time on an average day, MW, negative. [Charging MW] over the days that have a row at it. Always from fct_summary.",
            "expression": "DIVIDE([Charging MW], [Days with output])",
            "formatString": "#,##0.0"
          },
          {
            "name": "Emissions t",
            "description": "Tonnes of CO2-e emitted: each unit's output ([Generation MWh]'s, from the same table) times its dim_duid[CO2eFactor]. A unit with no factor counts nothing: loads, and the gensets AEMO lists \"On Exclusion List\" (Colongra, Jeeralang, Braemar 3 and 6), so the total is short of AEMO's by what those emit. Rooftop solar has no unit and emits nothing.",
            "expression": "VAR _last = [Newest whole day]\nRETURN\n    IF([Reads 5 minutes],\n        SUMX(fct_summary, MAX(fct_summary[mw], 0) * RELATED(dim_duid[CO2eFactor])) / 12,\n        SUMX(fct_summary_daily, fct_summary_daily[output_mwh] * RELATED(dim_duid[CO2eFactor]))\n            + CALCULATE(SUMX(fct_summary, MAX(fct_summary[mw], 0) * RELATED(dim_duid[CO2eFactor])), KEEPFILTERS(dim_calendar[date] > _last)) / 12)",
            "formatString": "#,##0"
          },
          {
            "name": "Emissions intensity",
            "description": "Tonnes of CO2-e per MWh, over the units that have a factor: [Emissions t] divided by their [Generation MWh]. Rooftop solar is not in it.",
            "expression": "DIVIDE([Emissions t], CALCULATE([Generation MWh], NOT ISBLANK(dim_duid[CO2eFactor])))",
            "formatString": "0.000"
          },
          {
            "name": "Emissions intensity change",
            "description": "The change of [Emissions intensity], %. Against the days just before the selection: as many days, ending the day before its first. Blank unless both have every hour of their days. Asked over a range of dim_calendar[date].",
            "expression": "VAR _first = MIN(dim_calendar[date])\nVAR _days = DATEDIFF(_first, MAX(dim_calendar[date]), DAY) + 1\nVAR _now = [Emissions intensity]\nVAR _before = CALCULATE([Emissions intensity], DATESBETWEEN(dim_calendar[date], _first - _days, _first - 1))\nVAR _whole = [Hours] = 24 * _days && CALCULATE([Hours], DATESBETWEEN(dim_calendar[date], _first - _days, _first - 1)) = 24 * _days\nRETURN IF(_whole, DIVIDE(100 * (_now - _before), _before))",
            "formatString": "0.0"
          }
        ]
      },
      {
        "name": "dim_region",
        "description": "One row per region: what the units, the regional table and rooftop are all filtered by.",
        "columns": [
          {
            "name": "Region",
            "description": "NSW1, QLD1, SA1, TAS1, VIC1; WA1 is Western Australia, another market (units, no prices).",
            "dataType": "string",
            "sourceColumn": "Region",
            "isKey": true,
            "sourceLineageTag": "Region",
            "summarizeBy": "none"
          },
          {
            "name": "State",
            "description": "The region's name.",
            "dataType": "string",
            "sourceColumn": "State",
            "sourceLineageTag": "State",
            "summarizeBy": "none"
          }
        ],
        "sourceLineageTag": "[mart].[dim_region]",
        "partitions": [
          {
            "name": "dim_region",
            "source": {
              "type": "entity",
              "entityName": "dim_region"
            }
          }
        ]
      },
      {
        "name": "dim_time",
        "description": "The 5-minute times of a day, 288 rows: the time axis of every fact, and what a measure reads rooftop solar against between two half hours.",
        "columns": [
          {
            "name": "time",
            "description": "Time of day as HHMM: 1435 is 14:35. An interval ends at it.",
            "dataType": "int64",
            "sourceColumn": "time",
            "isKey": true,
            "sourceLineageTag": "time",
            "summarizeBy": "none"
          },
          {
            "name": "minute",
            "description": "The same time as minutes since midnight, 0 to 1435.",
            "dataType": "int64",
            "sourceColumn": "minute",
            "sourceLineageTag": "minute",
            "summarizeBy": "none"
          },
          {
            "name": "hour",
            "description": "Hour of day, 0 to 23.",
            "dataType": "int64",
            "sourceColumn": "hour",
            "sourceLineageTag": "hour",
            "summarizeBy": "none"
          }
        ],
        "sourceLineageTag": "[mart].[dim_time]",
        "partitions": [
          {
            "name": "dim_time",
            "source": {
              "type": "entity",
              "entityName": "dim_time"
            }
          }
        ]
      },
      {
        "name": "fct_region",
        "description": "Price, demand and net interchange per region and 5 minutes, with the region's semi-scheduled wind and solar. The intraday record where it exists (2026-08 on), the next-day record before it.",
        "columns": [
          {
            "name": "REGIONID",
            "description": "The region.",
            "dataType": "string",
            "sourceColumn": "REGIONID",
            "sourceLineageTag": "REGIONID",
            "summarizeBy": "none"
          },
          {
            "name": "date",
            "description": "Date of the interval, NEM time (AEST all year).",
            "dataType": "dateTime",
            "sourceColumn": "date",
            "sourceLineageTag": "date",
            "summarizeBy": "none",
            "formatString": "yyyy-MM-dd"
          },
          {
            "name": "time",
            "description": "Time of day as HHMM: 1435 is 14:35. The interval ends at it.",
            "dataType": "int64",
            "sourceColumn": "time",
            "sourceLineageTag": "time",
            "summarizeBy": "none"
          },
          {
            "name": "price",
            "description": "The regional reference price (AEMO's RRP), $/MWh.",
            "dataType": "decimal",
            "sourceColumn": "price",
            "sourceLineageTag": "price",
            "summarizeBy": "none",
            "formatString": "$#,##0.00"
          },
          {
            "name": "demand",
            "description": "Operational demand, MW: rooftop solar is not in it.",
            "dataType": "decimal",
            "sourceColumn": "demand",
            "sourceLineageTag": "demand",
            "summarizeBy": "none",
            "formatString": "#,##0.00"
          },
          {
            "name": "net_interchange",
            "description": "MW, positive when the region exports.",
            "dataType": "decimal",
            "sourceColumn": "net_interchange",
            "sourceLineageTag": "net_interchange",
            "summarizeBy": "none",
            "formatString": "#,##0.00"
          },
          {
            "name": "wind_available",
            "description": "MW the region's semi-scheduled wind could make. Blank before 2026-08.",
            "dataType": "decimal",
            "sourceColumn": "wind_available",
            "sourceLineageTag": "wind_available",
            "summarizeBy": "none",
            "formatString": "#,##0.00"
          },
          {
            "name": "wind_curtailed",
            "description": "MW of it that was not dispatched.",
            "dataType": "decimal",
            "sourceColumn": "wind_curtailed",
            "sourceLineageTag": "wind_curtailed",
            "summarizeBy": "none",
            "formatString": "#,##0.00"
          },
          {
            "name": "solar_available",
            "description": "MW the region's semi-scheduled solar could make. Blank before 2026-08.",
            "dataType": "decimal",
            "sourceColumn": "solar_available",
            "sourceLineageTag": "solar_available",
            "summarizeBy": "none",
            "formatString": "#,##0.00"
          },
          {
            "name": "solar_curtailed",
            "description": "MW of it that was not dispatched.",
            "dataType": "decimal",
            "sourceColumn": "solar_curtailed",
            "sourceLineageTag": "solar_curtailed",
            "summarizeBy": "none",
            "formatString": "#,##0.00"
          }
        ],
        "sourceLineageTag": "[mart].[fct_region]",
        "partitions": [
          {
            "name": "fct_region",
            "source": {
              "type": "entity",
              "entityName": "fct_region"
            }
          }
        ],
        "measures": [
          {
            "name": "Reads 5 minutes regional",
            "description": "Whether the measures of fct_region have to read it rather than its daily table: a time of day is asked for (any column of dim_time is filtered or grouped), or a column of fct_region itself is filtered. Hidden: it is the one place the rule is written.",
            "expression": "ISCROSSFILTERED(dim_time[time]) || ISFILTERED(fct_region[REGIONID]) || ISFILTERED(fct_region[date]) || ISFILTERED(fct_region[time]) || ISFILTERED(fct_region[price]) || ISFILTERED(fct_region[demand]) || ISFILTERED(fct_region[net_interchange]) || ISFILTERED(fct_region[wind_available]) || ISFILTERED(fct_region[wind_curtailed]) || ISFILTERED(fct_region[solar_available]) || ISFILTERED(fct_region[solar_curtailed])",
            "isHidden": true
          },
          {
            "name": "Newest whole day regional",
            "description": "The newest day fct_region_daily holds, whatever the filters: the measures that read it add fct_region for the days after it. Every region has the same days (3,136 each, 2026-10-07). The daily table is written in date order with no gaps (a day once it is whole, the days after its newest; a refill below its oldest), so the days after this one are the days it lacks. A cutoff, not the set of those days (an EXCEPT): over a year grouped by unit or plant, that set took more memory than the capacity gives a query (1.4 GB against 1 GB, 2026-10-07). Hidden: it is the one place the rule is written.",
            "expression": "CALCULATE(MAX(fct_region_daily[date]), REMOVEFILTERS())",
            "isHidden": true
          },
          {
            "name": "Average price",
            "description": "The plain average of the 5-minute regional prices in the selection, $/MWh. Which table: fct_region when a time of day is asked for or a column of fct_region is filtered; otherwise fct_region_daily (a day there is 288 intervals), plus fct_region for the days after the newest one it holds ([Newest whole day regional]). The daily table is what lets a reader that cannot hold years of 5-minute rows, a browser, ask the same measure over a long range.",
            "expression": "VAR _last = [Newest whole day regional]\nRETURN\n    IF([Reads 5 minutes regional],\n        AVERAGE(fct_region[price]),\n        DIVIDE(\n            288 * SUM(fct_region_daily[price]) + CALCULATE(SUM(fct_region[price]), KEEPFILTERS(dim_calendar[date] > _last)),\n            288 * COUNT(fct_region_daily[price]) + CALCULATE(COUNT(fct_region[price]), KEEPFILTERS(dim_calendar[date] > _last))))",
            "formatString": "$#,##0.00"
          },
          {
            "name": "Average price change",
            "description": "The change of [Average price], $/MWh. Against the days just before the selection: as many days, ending the day before its first. Blank unless both have every hour of their days. Asked over a range of dim_calendar[date].",
            "expression": "VAR _first = MIN(dim_calendar[date])\nVAR _days = DATEDIFF(_first, MAX(dim_calendar[date]), DAY) + 1\nVAR _now = [Average price]\nVAR _before = CALCULATE([Average price], DATESBETWEEN(dim_calendar[date], _first - _days, _first - 1))\nVAR _whole = [Hours] = 24 * _days && CALCULATE([Hours], DATESBETWEEN(dim_calendar[date], _first - _days, _first - 1)) = 24 * _days\nRETURN IF(_whole, _now - _before)",
            "formatString": "$#,##0.00"
          },
          {
            "name": "Demand MWh",
            "description": "Operational demand as energy; rooftop solar is not in it. Which table: fct_region when a time of day is asked for or a column of fct_region is filtered; otherwise fct_region_daily (a day there is 288 intervals), plus fct_region for the days after the newest one it holds ([Newest whole day regional]).",
            "expression": "VAR _last = [Newest whole day regional]\nRETURN\n    IF([Reads 5 minutes regional],\n        SUM(fct_region[demand]) / 12,\n        24 * SUM(fct_region_daily[demand]) + CALCULATE(SUM(fct_region[demand]), KEEPFILTERS(dim_calendar[date] > _last)) / 12)",
            "formatString": "#,##0"
          },
          {
            "name": "Net interchange MW",
            "description": "Average net flow out of a region, MW; positive is exporting. Read it per region. Which table: fct_region when a time of day is asked for or a column of fct_region is filtered; otherwise fct_region_daily (a day there is 288 intervals), plus fct_region for the days after the newest one it holds ([Newest whole day regional]).",
            "expression": "VAR _last = [Newest whole day regional]\nRETURN\n    IF([Reads 5 minutes regional],\n        AVERAGE(fct_region[net_interchange]),\n        DIVIDE(\n            288 * SUM(fct_region_daily[net_interchange]) + CALCULATE(SUM(fct_region[net_interchange]), KEEPFILTERS(dim_calendar[date] > _last)),\n            288 * COUNT(fct_region_daily[net_interchange]) + CALCULATE(COUNT(fct_region[net_interchange]), KEEPFILTERS(dim_calendar[date] > _last))))",
            "formatString": "#,##0"
          },
          {
            "name": "Demand MW",
            "description": "Operational demand in MW at a 5-minute time, always from fct_region: read it at one time, it is a sum over the regions and the intervals in the selection. Blank when a region in the selection has no demand yet, so that it is left out and not undercounted. For energy use [Demand MWh].",
            "expression": "IF(COUNT(fct_region[demand]) = COUNTROWS(fct_region), SUM(fct_region[demand]))",
            "formatString": "#,##0"
          },
          {
            "name": "Demand with rooftop MW",
            "description": "Operational demand plus what rooftop solar supplied, MW at a 5-minute time: AEMO's operational demand leaves rooftop out, the generation stack has it. Blank when a region has no demand yet. Asked through the dimensions (dim_calendar, dim_time, dim_region), which reach both.",
            "expression": "VAR _demand = [Demand MW]\nRETURN IF(NOT ISBLANK(_demand), _demand + COALESCE(CALCULATE([Generation MW], dim_duid[FuelSourceDescriptor] = \"Rooftop solar\"), 0))",
            "formatString": "#,##0"
          },
          {
            "name": "Demand with rooftop MWh",
            "description": "Operational demand plus what rooftop solar supplied, MWh: [Demand with rooftop MW] as energy. Asked through the dimensions, which reach both.",
            "expression": "VAR _demand = [Demand MWh]\nRETURN IF(NOT ISBLANK(_demand), _demand + COALESCE(CALCULATE([Generation MWh], dim_duid[FuelSourceDescriptor] = \"Rooftop solar\"), 0))",
            "formatString": "#,##0"
          },
          {
            "name": "Hours",
            "description": "The hours the selection holds data for: its 5-minute intervals / 12. What a capacity factor divides by, and / 24 the days. Which table: fct_region when a time of day is asked for or a column of fct_region is filtered; otherwise 24 hours per day of fct_region_daily, plus the intervals of fct_region on the days after the newest one it holds ([Newest whole day regional]).",
            "expression": "VAR _last = [Newest whole day regional]\nRETURN\n    IF([Reads 5 minutes regional],\n        COUNTROWS(SUMMARIZE(fct_region, fct_region[date], fct_region[time])) / 12,\n        24 * DISTINCTCOUNT(fct_region_daily[date]) + CALCULATE(COUNTROWS(SUMMARIZE(fct_region, fct_region[date], fct_region[time])), KEEPFILTERS(dim_calendar[date] > _last)) / 12)",
            "formatString": "#,##0.0"
          },
          {
            "name": "Negative price share",
            "description": "Share of the 5-minute intervals with a price below zero, %, always from fct_region. Read it per region.",
            "expression": "100 * AVERAGEX(fct_region, IF(fct_region[price] < 0, 1, 0))",
            "formatString": "0.0"
          },
          {
            "name": "Lowest price",
            "description": "The lowest 5-minute price in the selection, $/MWh, always from fct_region.",
            "expression": "MIN(fct_region[price])",
            "formatString": "$#,##0.00"
          },
          {
            "name": "Average demand MW",
            "description": "Operational demand as an average MW: [Demand MWh] over [Hours]. Summed over the regions in the selection.",
            "expression": "DIVIDE([Demand MWh], [Hours])",
            "formatString": "#,##0"
          },
          {
            "name": "Regional wind curtailed MWh",
            "description": "Semi-scheduled wind not dispatched, from AEMO's regional figures (2026-08 on, up to the newest interval).",
            "expression": "SUM(fct_region[wind_curtailed]) / 12",
            "formatString": "#,##0"
          },
          {
            "name": "Regional wind available MWh",
            "description": "What the region's semi-scheduled wind could have made.",
            "expression": "SUM(fct_region[wind_available]) / 12",
            "formatString": "#,##0"
          },
          {
            "name": "Regional solar curtailed MWh",
            "description": "Semi-scheduled solar not dispatched, from AEMO's regional figures (2026-08 on, up to the newest interval).",
            "expression": "SUM(fct_region[solar_curtailed]) / 12",
            "formatString": "#,##0"
          },
          {
            "name": "Regional solar available MWh",
            "description": "What the region's semi-scheduled solar could have made.",
            "expression": "SUM(fct_region[solar_available]) / 12",
            "formatString": "#,##0"
          }
        ]
      },
      {
        "name": "fct_interconnector",
        "description": "Flow on each link between regions, per 5 minutes, back to 2018. Positive from the first region in the id to the second (T-V-MNSP1 > 0: Tasmania to Victoria); the limits bound it in the same sign.",
        "columns": [
          {
            "name": "interconnector",
            "description": "AEMO's id of the link.",
            "dataType": "string",
            "sourceColumn": "interconnector",
            "sourceLineageTag": "interconnector",
            "summarizeBy": "none"
          },
          {
            "name": "date",
            "description": "Date of the interval, NEM time (AEST all year).",
            "dataType": "dateTime",
            "sourceColumn": "date",
            "sourceLineageTag": "date",
            "summarizeBy": "none",
            "formatString": "yyyy-MM-dd"
          },
          {
            "name": "time",
            "description": "Time of day as HHMM: 1435 is 14:35. The interval ends at it.",
            "dataType": "int64",
            "sourceColumn": "time",
            "sourceLineageTag": "time",
            "summarizeBy": "none"
          },
          {
            "name": "mw",
            "description": "The dispatch target flow, MW.",
            "dataType": "decimal",
            "sourceColumn": "mw",
            "sourceLineageTag": "mw",
            "summarizeBy": "none",
            "formatString": "#,##0.00"
          },
          {
            "name": "export_limit",
            "description": "Limit in the positive direction, MW.",
            "dataType": "decimal",
            "sourceColumn": "export_limit",
            "sourceLineageTag": "export_limit",
            "summarizeBy": "none",
            "formatString": "#,##0.00"
          },
          {
            "name": "import_limit",
            "description": "Limit in the negative direction, MW.",
            "dataType": "decimal",
            "sourceColumn": "import_limit",
            "sourceLineageTag": "import_limit",
            "summarizeBy": "none",
            "formatString": "#,##0.00"
          }
        ],
        "sourceLineageTag": "[mart].[fct_interconnector]",
        "partitions": [
          {
            "name": "fct_interconnector",
            "source": {
              "type": "entity",
              "entityName": "fct_interconnector"
            }
          }
        ],
        "measures": [
          {
            "name": "Flow MW",
            "description": "Average flow on a link, MW. Read it per link.",
            "expression": "AVERAGE(fct_interconnector[mw])",
            "formatString": "#,##0"
          },
          {
            "name": "Flow utilisation",
            "description": "The flow as a share of the limit in its direction, %: export_limit when it flows from from_region, import_limit (negative) the other way. 0 when that limit is not above zero, blank where the link has no rows (so a query of the links' rows keeps only the links its filters reach). Read it per link and interval.",
            "expression": "VAR _flow = SUM(fct_interconnector[mw])\nVAR _limit = IF(_flow >= 0, SUM(fct_interconnector[export_limit]), -SUM(fct_interconnector[import_limit]))\nRETURN IF(NOT ISBLANK(_flow), IF(_limit > 0, DIVIDE(100 * ABS(_flow), _limit), 0))",
            "formatString": "0"
          },
          {
            "name": "No flow",
            "description": "1 when a link is out: carrying under 1 MW with its two limits closed on each other (less than 5 MW apart); 0 when not; blank where the link has no rows. A number, not a boolean: a boolean measure is never blank (IF's missing else is FALSE), so a query of the links' rows would keep every link, the ones its filters leave out included. Read it per link and interval.",
            "expression": "VAR _flow = SUM(fct_interconnector[mw])\nRETURN IF(NOT ISBLANK(_flow), IF(ABS(_flow) < 1 && SUM(fct_interconnector[export_limit]) - SUM(fct_interconnector[import_limit]) < 5, 1, 0))"
          }
        ]
      },
      {
        "name": "dim_interconnector",
        "description": "One row per link between two regions, from AEMO's MMSDM INTERCONNECTOR: what fct_interconnector's id stands for.",
        "columns": [
          {
            "name": "interconnector",
            "description": "AEMO's id of the link, as fct_interconnector carries it.",
            "dataType": "string",
            "sourceColumn": "interconnector",
            "isKey": true,
            "sourceLineageTag": "interconnector",
            "summarizeBy": "none"
          },
          {
            "name": "from_region",
            "description": "The region a positive flow leaves.",
            "dataType": "string",
            "sourceColumn": "from_region",
            "sourceLineageTag": "from_region",
            "summarizeBy": "none"
          },
          {
            "name": "to_region",
            "description": "The region a positive flow enters.",
            "dataType": "string",
            "sourceColumn": "to_region",
            "sourceLineageTag": "to_region",
            "summarizeBy": "none"
          },
          {
            "name": "description",
            "description": "AEMO's description of the link.",
            "dataType": "string",
            "sourceColumn": "description",
            "sourceLineageTag": "description",
            "summarizeBy": "none"
          }
        ],
        "sourceLineageTag": "[mart].[dim_interconnector]",
        "partitions": [
          {
            "name": "dim_interconnector",
            "source": {
              "type": "entity",
              "entityName": "dim_interconnector"
            }
          }
        ]
      },
      {
        "name": "fct_curtailment",
        "description": "Curtailment per semi-scheduled unit (wind and solar farms) and day, up to the newest whole day of the next-day files.",
        "columns": [
          {
            "name": "DUID",
            "description": "The unit.",
            "dataType": "string",
            "sourceColumn": "DUID",
            "sourceLineageTag": "DUID",
            "summarizeBy": "none"
          },
          {
            "name": "date",
            "description": "Date of the interval, NEM time (AEST all year).",
            "dataType": "dateTime",
            "sourceColumn": "date",
            "sourceLineageTag": "date",
            "summarizeBy": "none",
            "formatString": "yyyy-MM-dd"
          },
          {
            "name": "curtailed_mwh",
            "description": "What the unit could have made and was not dispatched for: sum of max(availability - target, 0) / 12.",
            "dataType": "decimal",
            "sourceColumn": "curtailed_mwh",
            "sourceLineageTag": "curtailed_mwh",
            "summarizeBy": "none",
            "formatString": "#,##0.00"
          },
          {
            "name": "available_mwh",
            "description": "What the unit could have made.",
            "dataType": "decimal",
            "sourceColumn": "available_mwh",
            "sourceLineageTag": "available_mwh",
            "summarizeBy": "none",
            "formatString": "#,##0.00"
          }
        ],
        "sourceLineageTag": "[mart].[fct_curtailment]",
        "partitions": [
          {
            "name": "fct_curtailment",
            "source": {
              "type": "entity",
              "entityName": "fct_curtailment"
            }
          }
        ],
        "measures": [
          {
            "name": "Curtailed MWh",
            "description": "Energy semi-scheduled wind and solar farms could have made and were not dispatched for.",
            "expression": "SUM(fct_curtailment[curtailed_mwh])",
            "formatString": "#,##0"
          },
          {
            "name": "Available MWh",
            "description": "Energy those farms could have made.",
            "expression": "SUM(fct_curtailment[available_mwh])",
            "formatString": "#,##0"
          },
          {
            "name": "Curtailment rate",
            "description": "Curtailed energy over available energy, %.",
            "expression": "DIVIDE(100 * [Curtailed MWh], [Available MWh])",
            "formatString": "0.0"
          }
        ]
      },
      {
        "name": "fct_curtailment_region",
        "description": "Curtailment per region, day and fuel (Wind, Solar): the semi-scheduled farms (fct_curtailment) added up to their newest day, AEMO's regional figures after it (source). What the curtailment chart reads when no unit is picked.",
        "columns": [
          {
            "name": "REGIONID",
            "description": "NEM region.",
            "dataType": "string",
            "sourceColumn": "REGIONID",
            "sourceLineageTag": "REGIONID",
            "summarizeBy": "none"
          },
          {
            "name": "date",
            "description": "Date, NEM time (AEST all year).",
            "dataType": "dateTime",
            "sourceColumn": "date",
            "sourceLineageTag": "date",
            "summarizeBy": "none",
            "formatString": "yyyy-MM-dd"
          },
          {
            "name": "fuel",
            "description": "Wind or Solar.",
            "dataType": "string",
            "sourceColumn": "fuel",
            "sourceLineageTag": "fuel",
            "summarizeBy": "none"
          },
          {
            "name": "curtailed_mwh",
            "description": "Energy available and not dispatched.",
            "dataType": "decimal",
            "sourceColumn": "curtailed_mwh",
            "sourceLineageTag": "curtailed_mwh",
            "summarizeBy": "none",
            "formatString": "#,##0.00"
          },
          {
            "name": "available_mwh",
            "description": "Energy available.",
            "dataType": "decimal",
            "sourceColumn": "available_mwh",
            "sourceLineageTag": "available_mwh",
            "summarizeBy": "none",
            "formatString": "#,##0.00"
          },
          {
            "name": "source",
            "description": "farms (the units' next-day data, added up) or aemo (AEMO's regional figures, the days after the farms' newest).",
            "dataType": "string",
            "sourceColumn": "source",
            "sourceLineageTag": "source",
            "summarizeBy": "none"
          }
        ],
        "sourceLineageTag": "[mart].[fct_curtailment_region]",
        "partitions": [
          {
            "name": "fct_curtailment_region",
            "source": {
              "type": "entity",
              "entityName": "fct_curtailment_region"
            }
          }
        ],
        "measures": [
          {
            "name": "Wind and solar curtailed MWh",
            "description": "Energy the semi-scheduled wind and solar farms could have made and were not dispatched for: the farms' own figures to their newest day, AEMO's regional ones after.",
            "expression": "SUM(fct_curtailment_region[curtailed_mwh])",
            "formatString": "#,##0"
          },
          {
            "name": "Wind and solar available MWh",
            "description": "Energy those farms could have made, from the same sources.",
            "expression": "SUM(fct_curtailment_region[available_mwh])",
            "formatString": "#,##0"
          },
          {
            "name": "Wind and solar curtailment rate",
            "description": "Curtailed energy over available energy, %.",
            "expression": "DIVIDE(100 * [Wind and solar curtailed MWh], [Wind and solar available MWh])",
            "formatString": "0.0"
          }
        ]
      },
      {
        "name": "fct_summary_daily",
        "description": "Energy per unit and day: fct_summary one grain up, whole days only (a day is written once the next-day files hold all of it). The measures of fct_summary read this table when no time of day is asked for: output_mwh, charging_mwh and revenue are the day's sums of what they sum at 5 minutes, so the answer is the same. mwh (net) and price (the day's average) are not the same numbers and no measure reads them: they are kept for the dashboard's Analyze tab, which is SQL.",
        "columns": [
          {
            "name": "DUID",
            "description": "The unit.",
            "dataType": "string",
            "sourceColumn": "DUID",
            "sourceLineageTag": "DUID",
            "summarizeBy": "none"
          },
          {
            "name": "date",
            "description": "Calendar date, NEM time (AEST all year).",
            "dataType": "dateTime",
            "sourceColumn": "date",
            "sourceLineageTag": "date",
            "summarizeBy": "none",
            "formatString": "yyyy-MM-dd"
          },
          {
            "name": "mwh",
            "description": "The day's net energy, MWh: a battery's charging is taken off its output.",
            "dataType": "decimal",
            "sourceColumn": "mwh",
            "sourceLineageTag": "mwh",
            "summarizeBy": "none",
            "formatString": "#,##0.00"
          },
          {
            "name": "price",
            "description": "The day's average price of the unit's region, $/MWh.",
            "dataType": "decimal",
            "sourceColumn": "price",
            "sourceLineageTag": "price",
            "summarizeBy": "none",
            "formatString": "$#,##0.00"
          },
          {
            "name": "output_mwh",
            "description": "The day's output, MWh: the 5-minute intervals above 0 MW. What [Generation MWh] sums.",
            "dataType": "double",
            "sourceColumn": "output_mwh",
            "sourceLineageTag": "output_mwh",
            "summarizeBy": "none",
            "formatString": "#,##0.00"
          },
          {
            "name": "charging_mwh",
            "description": "The day's charging, MWh, negative: the 5-minute intervals below 0 MW.",
            "dataType": "double",
            "sourceColumn": "charging_mwh",
            "sourceLineageTag": "charging_mwh",
            "summarizeBy": "none",
            "formatString": "#,##0.00"
          },
          {
            "name": "revenue",
            "description": "What the day's output earned, $: each interval's output at its own 5-minute price.",
            "dataType": "double",
            "sourceColumn": "revenue",
            "sourceLineageTag": "revenue",
            "summarizeBy": "none",
            "formatString": "$#,##0.00"
          }
        ],
        "sourceLineageTag": "[mart].[fct_summary_daily]",
        "partitions": [
          {
            "name": "fct_summary_daily",
            "source": {
              "type": "entity",
              "entityName": "fct_summary_daily"
            }
          }
        ],
        "measures": [
          {
            "name": "Average MWh a day",
            "description": "A unit's average output per day, MWh, over the whole days it ran in. Names this table, like the measures of the tables by month. Read it per unit.",
            "expression": "AVERAGE(fct_summary_daily[output_mwh])",
            "formatString": "#,##0.0"
          }
        ]
      },
      {
        "name": "fct_region_daily",
        "description": "Price, demand and net interchange per region and day: the plain average of the day's 288 intervals, whole days only. The measures of fct_region read this table when no time of day is asked for; it is also where fct_summary_daily takes its price.",
        "columns": [
          {
            "name": "REGIONID",
            "description": "The region.",
            "dataType": "string",
            "sourceColumn": "REGIONID",
            "sourceLineageTag": "REGIONID",
            "summarizeBy": "none"
          },
          {
            "name": "date",
            "description": "Calendar date, NEM time (AEST all year).",
            "dataType": "dateTime",
            "sourceColumn": "date",
            "sourceLineageTag": "date",
            "summarizeBy": "none",
            "formatString": "yyyy-MM-dd"
          },
          {
            "name": "price",
            "description": "Average regional reference price of the day, $/MWh.",
            "dataType": "decimal",
            "sourceColumn": "price",
            "sourceLineageTag": "price",
            "summarizeBy": "none",
            "formatString": "$#,##0.00"
          },
          {
            "name": "demand",
            "description": "Average operational demand of the day, MW.",
            "dataType": "decimal",
            "sourceColumn": "demand",
            "sourceLineageTag": "demand",
            "summarizeBy": "none",
            "formatString": "#,##0.00"
          },
          {
            "name": "net_interchange",
            "description": "Average net flow out of the region, MW; positive is exporting.",
            "dataType": "decimal",
            "sourceColumn": "net_interchange",
            "sourceLineageTag": "net_interchange",
            "summarizeBy": "none",
            "formatString": "#,##0.00"
          }
        ],
        "sourceLineageTag": "[mart].[fct_region_daily]",
        "partitions": [
          {
            "name": "fct_region_daily",
            "source": {
              "type": "entity",
              "entityName": "fct_region_daily"
            }
          }
        ],
        "measures": [
          {
            "name": "Negative price days share",
            "description": "Share of the whole days whose average price was below zero, %. Not [Negative price share], which counts 5-minute intervals: this one names the daily table. Read it per region.",
            "expression": "100 * AVERAGEX(fct_region_daily, IF(fct_region_daily[price] < 0, 1, 0))",
            "formatString": "0.0"
          },
          {
            "name": "Lowest daily price",
            "description": "The lowest daily average price in the selection, $/MWh. Names the daily table.",
            "expression": "MIN(fct_region_daily[price])",
            "formatString": "$#,##0.00"
          }
        ]
      },
      {
        "name": "dim_month",
        "description": "The whole months the hour-of-day tables hold, with their number of days: the divisor that turns a month's energy at an hour into an average MW.",
        "columns": [
          {
            "name": "month",
            "description": "The month's first day.",
            "dataType": "dateTime",
            "sourceColumn": "month",
            "isKey": true,
            "sourceLineageTag": "month",
            "summarizeBy": "none",
            "formatString": "yyyy-MM"
          },
          {
            "name": "days",
            "description": "Days in the month.",
            "dataType": "int64",
            "sourceColumn": "days",
            "sourceLineageTag": "days",
            "summarizeBy": "none"
          }
        ],
        "sourceLineageTag": "[mart].[dim_month]",
        "partitions": [
          {
            "name": "dim_month",
            "source": {
              "type": "entity",
              "entityName": "dim_month"
            }
          }
        ],
        "measures": [
          {
            "name": "Month days",
            "description": "Days of the months in the selection.",
            "expression": "SUM(dim_month[days])",
            "formatString": "#,##0"
          }
        ]
      },
      {
        "name": "fct_summary_hourly",
        "description": "Output energy per unit, month and hour of day, whole months only: what an average-day chart reads over a long range.",
        "columns": [
          {
            "name": "DUID",
            "description": "The unit.",
            "dataType": "string",
            "sourceColumn": "DUID",
            "sourceLineageTag": "DUID",
            "summarizeBy": "none"
          },
          {
            "name": "month",
            "description": "The month's first day.",
            "dataType": "dateTime",
            "sourceColumn": "month",
            "sourceLineageTag": "month",
            "summarizeBy": "none",
            "formatString": "yyyy-MM"
          },
          {
            "name": "hour",
            "description": "Hour of day, 0 to 23, as time // 100: the interval ending 14:00 is hour 14.",
            "dataType": "int64",
            "sourceColumn": "hour",
            "sourceLineageTag": "hour",
            "summarizeBy": "none"
          },
          {
            "name": "mwh",
            "description": "Output energy at that hour over the month, MWh; charging is left out.",
            "dataType": "decimal",
            "sourceColumn": "mwh",
            "sourceLineageTag": "mwh",
            "summarizeBy": "none",
            "formatString": "#,##0.00"
          }
        ],
        "sourceLineageTag": "[mart].[fct_summary_hourly]",
        "partitions": [
          {
            "name": "fct_summary_hourly",
            "source": {
              "type": "entity",
              "entityName": "fct_summary_hourly"
            }
          }
        ],
        "measures": [
          {
            "name": "Output MWh hourly",
            "description": "Output energy at an hour of day over the months in the selection.",
            "expression": "SUM(fct_summary_hourly[mwh])",
            "formatString": "#,##0"
          },
          {
            "name": "Average MW at hour",
            "description": "Average output at an hour of day over the months in the selection, MW: the energy at that hour over the days of those months. Read it per hour.",
            "expression": "DIVIDE([Output MWh hourly], [Month days])",
            "formatString": "#,##0"
          }
        ]
      },
      {
        "name": "fct_region_hourly",
        "description": "Average price per region, month and hour of day, whole months only: what a price-by-hour chart reads over a long range.",
        "columns": [
          {
            "name": "REGIONID",
            "description": "The region.",
            "dataType": "string",
            "sourceColumn": "REGIONID",
            "sourceLineageTag": "REGIONID",
            "summarizeBy": "none"
          },
          {
            "name": "month",
            "description": "The month's first day.",
            "dataType": "dateTime",
            "sourceColumn": "month",
            "sourceLineageTag": "month",
            "summarizeBy": "none",
            "formatString": "yyyy-MM"
          },
          {
            "name": "hour",
            "description": "Hour of day, 0 to 23, as time // 100: the interval ending 14:00 is hour 14.",
            "dataType": "int64",
            "sourceColumn": "hour",
            "sourceLineageTag": "hour",
            "summarizeBy": "none"
          },
          {
            "name": "price",
            "description": "Plain average of the month's prices at that hour, $/MWh.",
            "dataType": "decimal",
            "sourceColumn": "price",
            "sourceLineageTag": "price",
            "summarizeBy": "none",
            "formatString": "$#,##0.00"
          },
          {
            "name": "intervals",
            "description": "How many intervals were averaged.",
            "dataType": "int64",
            "sourceColumn": "intervals",
            "sourceLineageTag": "intervals",
            "summarizeBy": "none"
          }
        ],
        "sourceLineageTag": "[mart].[fct_region_hourly]",
        "partitions": [
          {
            "name": "fct_region_hourly",
            "source": {
              "type": "entity",
              "entityName": "fct_region_hourly"
            }
          }
        ],
        "measures": [
          {
            "name": "Price at hour",
            "description": "Average price at an hour of day over the months in the selection: the monthly averages weighted by their intervals.",
            "expression": "DIVIDE(SUMX(fct_region_hourly, fct_region_hourly[price] * fct_region_hourly[intervals]), SUM(fct_region_hourly[intervals]))",
            "formatString": "$#,##0.00"
          }
        ]
      }
    ],
