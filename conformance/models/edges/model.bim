{
  "name": "dax-conformance-edges",
  "compatibilityLevel": 1604,
  "model": {
    "culture": "en-US",
    "discourageImplicitMeasures": true,
    "defaultPowerBIDataSourceVersion": "powerBI_V3",
    "tables": [
      {
        "name": "Date",
        "dataCategory": "Time",
        "columns": [
          {
            "name": "Date",
            "dataType": "dateTime",
            "sourceColumn": "Date",
            "isKey": true
          },
          {
            "name": "Year",
            "dataType": "int64",
            "sourceColumn": "Year"
          },
          {
            "name": "Quarter",
            "dataType": "string",
            "sourceColumn": "Quarter"
          },
          {
            "name": "Month",
            "dataType": "int64",
            "sourceColumn": "Month"
          },
          {
            "name": "Month Name",
            "dataType": "string",
            "sourceColumn": "Month Name",
            "sortByColumn": "Month"
          },
          {
            "name": "YearMonth",
            "dataType": "int64",
            "sourceColumn": "YearMonth"
          },
          {
            "name": "Year Month",
            "dataType": "string",
            "sourceColumn": "Year Month"
          },
          {
            "name": "Weekday",
            "dataType": "int64",
            "sourceColumn": "Weekday"
          },
          {
            "name": "Day Name",
            "dataType": "string",
            "sourceColumn": "Day Name",
            "sortByColumn": "Weekday"
          },
          {
            "name": "Weekend",
            "dataType": "boolean",
            "sourceColumn": "Weekend"
          },
          {
            "name": "Day Of Year",
            "dataType": "int64",
            "sourceColumn": "Day Of Year"
          }
        ],
        "partitions": [
          {
            "name": "Date",
            "source": {
              "type": "entity",
              "entityName": "Date"
            }
          }
        ]
      },
      {
        "name": "Region",
        "columns": [
          {
