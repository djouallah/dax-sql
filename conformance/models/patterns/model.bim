      {
        "name": "Time Intelligence",
        "calculationGroup": {
          "precedence": 10,
          "calculationItems": [
            {
              "name": "Current",
              "expression": "SELECTEDMEASURE()",
              "ordinal": 0
            },
            {
              "name": "PY",
              "expression": "CALCULATE(SELECTEDMEASURE(), SAMEPERIODLASTYEAR('Date'[Date]))",
              "ordinal": 1
            },
            {
              "name": "YoY",
              "expression": "VAR cur = SELECTEDMEASURE() VAR py = CALCULATE(SELECTEDMEASURE(), SAMEPERIODLASTYEAR('Date'[Date])) RETURN IF(NOT ISBLANK(cur) && NOT ISBLANK(py), cur - py)",
              "ordinal": 2
            },
            {
              "name": "YoY %",
              "expression": "DIVIDE(CALCULATE(SELECTEDMEASURE(), 'Time Intelligence'[Time Intelligence] = \"YoY\"), CALCULATE(SELECTEDMEASURE(), 'Time Intelligence'[Time Intelligence] = \"PY\"))",
              "ordinal": 3
            },
            {
              "name": "YTD",
              "expression": "CALCULATE(SELECTEDMEASURE(), DATESYTD('Date'[Date]))",
              "ordinal": 4
            },
            {
              "name": "MAT",
              "expression": "CALCULATE(SELECTEDMEASURE(), DATESINPERIOD('Date'[Date], MAX('Date'[Date]), -1, YEAR))",
              "ordinal": 5
            }
          ]
        },
        "columns": [
          {
            "name": "Time Intelligence",
            "dataType": "string",
            "sourceColumn": "Name",
            "sortByColumn": "Ordinal"
          },
          {
            "name": "Ordinal",
            "dataType": "int64",
            "sourceColumn": "Ordinal"
          }
        ],
        "partitions": [
          {
            "name": "Time Intelligence Partition",
            "source": {
              "type": "calculationGroup"
            }
          }
        ]
      },
