{
  "name": "dax-conformance-scott",
  "compatibilityLevel": 1604,
  "model": {
    "culture": "en-US",
    "defaultPowerBIDataSourceVersion": "powerBI_V3",
    "description": "The SCOTT schema with dataset-scoped metrics",
    "tables": [
      {
        "name": "emp",
        "columns": [
          {
            "name": "empno",
            "dataType": "int64",
            "sourceColumn": "empno",
            "isKey": true
          },
          {
            "name": "ename",
            "dataType": "string",
            "sourceColumn": "ename"
          },
          {
            "name": "job",
            "dataType": "string",
            "sourceColumn": "job"
          },
          {
            "name": "mgr",
            "dataType": "int64",
            "sourceColumn": "mgr"
          },
          {
            "name": "hiredate",
            "dataType": "dateTime",
            "sourceColumn": "hiredate"
          },
          {
            "name": "sal",
            "dataType": "decimal",
            "sourceColumn": "sal"
          },
          {
            "name": "comm",
            "dataType": "decimal",
            "sourceColumn": "comm"
          },
          {
            "name": "deptno",
            "dataType": "int64",
            "sourceColumn": "deptno"
          }
        ],
        "partitions": [
          {
            "name": "emp",
            "source": {
              "type": "entity",
              "entityName": "emp",
              "schemaName": "scott"
            }
          }
        ],
        "measures": [
          {
            "name": "sum_sal",
            "description": "Total salary",
            "expression": "SUM('emp'[sal])",
            "annotations": [
              {
                "name": "Ossie",
                "value": "{\"dataset\":\"emp\",\"home\":\"emp\",\"expression\":{\"sql\":\"SUM(sal)\"},\"dax\":\"SUM('emp'[sal])\",\"datatype\":\"Decimal\"}"
              }
            ]
          },
          {
            "name": "avg_sal",
            "description": "Average salary",
            "expression": "AVERAGEX('emp', CONVERT('emp'[sal], DOUBLE))",
            "annotations": [
              {
                "name": "Ossie",
                "value": "{\"dataset\":\"emp\",\"home\":\"emp\",\"expression\":{\"sql\":\"AVG(CAST(sal AS DOUBLE))\"},\"dax\":\"AVERAGEX('emp', CONVERT('emp'[sal], DOUBLE))\",\"datatype\":\"Float\"}"
              }
            ]
          },
          {
            "name": "emp_count",
            "description": "Number of employees",
            "expression": "COUNTROWS('emp')",
            "annotations": [
              {
                "name": "Ossie",
                "value": "{\"dataset\":\"emp\",\"home\":\"emp\",\"expression\":{\"sql\":\"COUNT(*)\"},\"dax\":\"COUNTROWS('emp')\",\"datatype\":\"Integer\"}"
              }
            ]
          },
          {
            "name": "comm_count",
            "description": "Number of employees that have a commission",
            "expression": "COUNTA('emp'[comm])",
            "annotations": [
              {
                "name": "Ossie",
                "value": "{\"dataset\":\"emp\",\"home\":\"emp\",\"expression\":{\"sql\":\"COUNT(comm)\"},\"dax\":\"COUNTA('emp'[comm])\",\"datatype\":\"Integer\"}"
              }
            ]
          },
          {
            "name": "sum_comm",
            "description": "Total commission",
            "expression": "SUM('emp'[comm])",
            "annotations": [
              {
                "name": "Ossie",
                "value": "{\"dataset\":\"emp\",\"home\":\"emp\",\"expression\":{\"sql\":\"SUM(comm)\"},\"dax\":\"SUM('emp'[comm])\",\"datatype\":\"Decimal\"}"
              }
            ]
          },
          {
            "name": "avg_comm",
            "description": "Average commission, over the employees that have a commission",
            "expression": "AVERAGEX('emp', CONVERT('emp'[comm], DOUBLE))",
            "annotations": [
              {
                "name": "Ossie",
                "value": "{\"dataset\":\"emp\",\"home\":\"emp\",\"expression\":{\"sql\":\"AVG(CAST(comm AS DOUBLE))\"},\"dax\":\"AVERAGEX('emp', CONVERT('emp'[comm], DOUBLE))\",\"datatype\":\"Float\"}"
              }
            ]
          }
        ]
      },
      {
