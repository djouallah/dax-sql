// note: check_model.py: [Average MW at hour] per month, over the newest three
EVALUATE
            VAR newest = MAX(dim_month[month])
            RETURN CALCULATETABLE(
                SUMMARIZECOLUMNS(dim_month[month], "Average MW at hour", [Average MW at hour]),
                dim_month[month] > EDATE(newest, -3))
            ORDER BY dim_month[month]
