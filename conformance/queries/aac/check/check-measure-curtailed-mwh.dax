// note: check_model.py: [Curtailed MWh] per day, over the newest week fct_summary holds
EVALUATE
            VAR newest = MAX(fct_summary[date])
            RETURN CALCULATETABLE(
                SUMMARIZECOLUMNS(dim_calendar[date], "Curtailed MWh", [Curtailed MWh]),
                dim_calendar[date] > newest - 7, dim_calendar[date] <= newest)
            ORDER BY dim_calendar[date]
