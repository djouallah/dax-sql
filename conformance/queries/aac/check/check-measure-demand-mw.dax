// note: check_model.py: [Demand MW] per day, over the newest week fct_summary holds
EVALUATE
            VAR newest = MAX(fct_summary[date])
            RETURN CALCULATETABLE(
                SUMMARIZECOLUMNS(dim_calendar[date], "Demand MW", [Demand MW]),
                dim_calendar[date] > newest - 7, dim_calendar[date] <= newest)
            ORDER BY dim_calendar[date]
