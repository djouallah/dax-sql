// note: check_model.py: [Newest whole day regional] per day, over the newest week fct_summary holds
EVALUATE
            VAR newest = MAX(fct_summary[date])
            RETURN CALCULATETABLE(
                SUMMARIZECOLUMNS(dim_calendar[date], "Newest whole day regional", [Newest whole day regional]),
                dim_calendar[date] > newest - 7, dim_calendar[date] <= newest)
            ORDER BY dim_calendar[date]
