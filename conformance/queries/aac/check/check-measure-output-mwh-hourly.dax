// note: check_model.py: [Output MWh hourly] per month, over the newest three
EVALUATE
            VAR newest = MAX(dim_month[month])
            RETURN CALCULATETABLE(
                SUMMARIZECOLUMNS(dim_month[month], "Output MWh hourly", [Output MWh hourly]),
                dim_month[month] > EDATE(newest, -3))
            ORDER BY dim_month[month]
