// note: check_model.py: [Registered units] per day, over the newest week fct_summary holds
EVALUATE
            VAR newest = MAX(fct_summary[date])
            RETURN CALCULATETABLE(
                SUMMARIZECOLUMNS(dim_calendar[date], "Registered units", [Registered units]),
                dim_calendar[date] > newest - 7, dim_calendar[date] <= newest)
            ORDER BY dim_calendar[date]
