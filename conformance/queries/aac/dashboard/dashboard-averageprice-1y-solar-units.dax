// note: the dashboard's averagePrice query, the price KPI over the range (page state: 1 year to 2026-08-11, fuel Solar, units HPR1 BALDHWF1)
EVALUATE CALCULATETABLE(ROW("avg", [Average price]), dim_calendar[date] >= dt"2026-07-28", dim_calendar[date] <= dt"2026-08-11", dim_duid[FuelSourceDescriptor] = "Solar", dim_duid[DUID] IN {"HPR1", "BALDHWF1"})
