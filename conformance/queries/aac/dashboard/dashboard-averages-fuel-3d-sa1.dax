// note: the dashboard's averages query, the generation KPIs: each series as an average MW with its share, largest first (page state: 3 days to 2026-08-11, region SA1)
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS(dim_duid[FuelSourceDescriptor], "avg", [Average generation MW], "share", [Generation share]), fct_summary[date] >= dt"2026-08-09", fct_summary[date] <= dt"2026-08-11", fct_region[date] >= dt"2026-08-09", fct_region[date] <= dt"2026-08-11", dim_calendar[date] >= dt"2026-08-09", dim_calendar[date] <= dt"2026-08-11", dim_region[Region] = "SA1"), "series", [FuelSourceDescriptor], "avg", [avg], "share", [share]) ORDER BY [avg] DESC, [series]
