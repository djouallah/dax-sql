// note: the dashboard's batteryDay query, batteries: discharge, charge and price seen on an average day (page state: 3 days to 2026-08-11, units HPR1 BALDHWF1)
EVALUATE CALCULATETABLE(SUMMARIZECOLUMNS(fct_summary[time], "discharge", [Generation MW on an average day], "charge", [Charging MW on an average day], "price", [Price seen]), fct_summary[date] >= dt"2026-08-09", fct_summary[date] <= dt"2026-08-11", fct_summary[DUID] IN {"HPR1", "BALDHWF1"}, dim_duid[Storage] = TRUE()) ORDER BY [time]
