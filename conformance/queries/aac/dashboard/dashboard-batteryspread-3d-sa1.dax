// note: the dashboard's batterySpread query, batteries: sold and bought prices and their spread (page state: 3 days to 2026-08-11, region SA1)
EVALUATE CALCULATETABLE(ROW("sold", [Capture price], "bought", [Charging price], "spread", [Battery spread]), fct_summary[date] >= dt"2026-08-09", fct_summary[date] <= dt"2026-08-11", dim_duid[Region] = "SA1", dim_duid[Storage] = TRUE())
