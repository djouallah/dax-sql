// note: the dashboard's capacityFactor query, capacity factor per unit and per fuel (the total rows) (page state: 3 days to 2026-08-11, fuel Wind)
EVALUATE FILTER(SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS(dim_duid[FuelSourceDescriptor], ROLLUPADDISSUBTOTAL(ROLLUPGROUP(dim_duid[DUID], dim_duid[StationName]), "total"), "cap", [Capacity MW], "cf", [Capacity factor]), fct_summary[date] >= dt"2026-08-09", fct_summary[date] <= dt"2026-08-11", fct_region[date] >= dt"2026-08-09", fct_region[date] <= dt"2026-08-11", dim_calendar[date] >= dt"2026-08-09", dim_calendar[date] <= dt"2026-08-11", dim_duid[FuelSourceDescriptor] = "Wind", dim_duid[RegCapMW] > 0, dim_duid[Storage] = FALSE()), "fuel", [FuelSourceDescriptor], "DUID", [DUID], "station", [StationName], "cap", [cap], "cf", [cf], "total", [total]), NOT ISBLANK([cf])) ORDER BY [cf], [fuel], [DUID], [station], [total]
