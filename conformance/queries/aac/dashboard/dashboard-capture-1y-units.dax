// note: the dashboard's capture query, capture price by fuel, the fuels with half a percent or more of the output (page state: 1 year to 2026-08-11, units HPR1 BALDHWF1)
EVALUATE FILTER(SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS(dim_duid[FuelSourceDescriptor], "capture", [Capture price], "volume", [Generation MWh], "share", [Generation share]), dim_calendar[date] >= dt"2026-07-28", dim_calendar[date] <= dt"2026-08-11", dim_duid[DUID] IN {"HPR1", "BALDHWF1"}, dim_duid[Storage] = FALSE()), "fuel", [FuelSourceDescriptor], "capture", [capture], "volume", [volume], "share", [share]), [volume] > 0 && [share] >= 0.5) ORDER BY [capture], [fuel]
