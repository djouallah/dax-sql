// note: the dashboard's changePrice query, the price KPI's change against the days before (page state: 3 days to 2026-08-11, units HPR1 BALDHWF1)
EVALUATE CALCULATETABLE(ROW("v", [Average price change]), dim_calendar[date] >= dt"2026-08-09", dim_calendar[date] <= dt"2026-08-11", dim_duid[DUID] IN {"HPR1", "BALDHWF1"})
