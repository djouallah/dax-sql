// note: the dashboard's curtailedFarms query, the 15 farms that lost the most to curtailment (page state: 3 days to 2026-08-11, fuel Wind)
EVALUATE TOPN(15, FILTER(SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS(dim_duid[DUID], dim_duid[FuelSourceDescriptor], dim_duid[StationName], "cur", [Curtailed MWh], "rate", [Curtailment rate]), fct_curtailment[date] >= dt"2026-08-09", fct_curtailment[date] <= dt"2026-08-11", dim_duid[FuelSourceDescriptor] = "Wind"), "DUID", [DUID], "fuel", [FuelSourceDescriptor], "station", [StationName], "cur", [cur], "rate", [rate]), [cur] > 0), [cur], DESC) ORDER BY [cur] DESC, [DUID], [fuel], [station]
