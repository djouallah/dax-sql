// note: the dashboard's curtailment query, the curtailment chart: per day (per month beyond 120 days) and fuel (page state: 1 year to 2026-08-11, region SA1)
EVALUATE CALCULATETABLE(SUMMARIZECOLUMNS(dim_calendar[year], dim_calendar[month], fct_curtailment_region[fuel], "cur", [Wind and solar curtailed MWh], "avail", [Wind and solar available MWh], "rate", [Wind and solar curtailment rate]), dim_calendar[date] >= dt"2025-08-11", dim_calendar[date] <= dt"2026-08-11", fct_curtailment_region[REGIONID] = "SA1") ORDER BY [year], [month], [fuel]
