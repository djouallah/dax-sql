// note: the dashboard's curtailment query, the curtailment chart: per day (per month beyond 120 days) and fuel (page state: 1 year to 2026-08-11, units HPR1 BALDHWF1)
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS(dim_calendar[year], dim_calendar[month], dim_duid[FuelSourceDescriptor], "cur", [Curtailed MWh], "avail", [Available MWh], "rate", [Curtailment rate]), dim_calendar[date] >= dt"2025-08-11", dim_calendar[date] <= dt"2026-08-11", fct_curtailment[DUID] IN {"HPR1", "BALDHWF1"}), "year", [year], "month", [month], "fuel", [FuelSourceDescriptor], "cur", [cur], "avail", [avail], "rate", [rate]) ORDER BY [year], [month], [fuel]
