// note: the dashboard's curtailment query, the curtailment chart: per day (per month beyond 120 days) and fuel (page state: 3 days to 2026-08-11, units HPR1 BALDHWF1)
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS(dim_calendar[date], dim_duid[FuelSourceDescriptor], "cur", [Curtailed MWh], "avail", [Available MWh], "rate", [Curtailment rate]), dim_calendar[date] >= dt"2026-08-09", dim_calendar[date] <= dt"2026-08-11", fct_curtailment[DUID] IN {"HPR1", "BALDHWF1"}), "date", [date], "fuel", [FuelSourceDescriptor], "cur", [cur], "avail", [avail], "rate", [rate]) ORDER BY [date], [fuel]
