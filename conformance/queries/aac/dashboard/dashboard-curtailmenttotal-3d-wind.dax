// note: the dashboard's curtailmentTotal query, the curtailment KPI over the range (page state: 3 days to 2026-08-11, fuel Wind)
EVALUATE CALCULATETABLE(ROW("cur", [Wind and solar curtailed MWh], "rate", [Wind and solar curtailment rate]), dim_calendar[date] >= dt"2026-08-09", dim_calendar[date] <= dt"2026-08-11", fct_curtailment_region[fuel] = "Wind")
