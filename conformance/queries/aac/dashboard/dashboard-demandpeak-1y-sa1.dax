// note: the dashboard's demandPeak query, the demand peak: the largest row of the demand line (TOPN 1) (page state: 1 year to 2026-08-11, region SA1)
EVALUATE TOPN(1, CALCULATETABLE(SUMMARIZECOLUMNS(dim_calendar[date], "demand", [Demand with rooftop MWh]), dim_calendar[date] >= dt"2026-07-28", dim_calendar[date] <= dt"2026-08-11", dim_region[Region] = "SA1"), [demand], DESC) ORDER BY [demand] DESC, [date]
