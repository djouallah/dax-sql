// note: the dashboard's emissions query, emissions tonnes and intensity per interval, with the range's total (page state: 1 year to 2026-08-11, region SA1)
EVALUATE CALCULATETABLE(SUMMARIZECOLUMNS(ROLLUPADDISSUBTOTAL(dim_calendar[date], "all"), "t", [Emissions t], "i", [Emissions intensity]), dim_calendar[date] >= dt"2026-07-28", dim_calendar[date] <= dt"2026-08-11", dim_duid[Region] = "SA1") ORDER BY [date], [all]
