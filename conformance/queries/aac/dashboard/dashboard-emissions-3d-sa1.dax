// note: the dashboard's emissions query, emissions tonnes and intensity per interval, with the range's total (page state: 3 days to 2026-08-11, region SA1)
EVALUATE CALCULATETABLE(SUMMARIZECOLUMNS(ROLLUPADDISSUBTOTAL(ROLLUPGROUP(fct_summary[date], fct_summary[time]), "all"), "t", [Emissions t], "i", [Emissions intensity]), fct_summary[date] >= dt"2026-08-09", fct_summary[date] <= dt"2026-08-11", dim_duid[Region] = "SA1") ORDER BY [date], [time], [all]
