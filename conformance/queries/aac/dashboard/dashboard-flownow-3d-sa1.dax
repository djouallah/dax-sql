// note: the dashboard's flowNow query, Flows: the generators' output and renewable share per interval of a day (page state: 3 days to 2026-08-11, region SA1)
EVALUATE CALCULATETABLE(SUMMARIZECOLUMNS(fct_summary[time], "mw", [Generation MW], "share", [Renewable share]), fct_summary[date] = dt"2026-08-11", dim_duid[Storage] = FALSE(), dim_duid[Region] = "SA1")
