// note: the dashboard's flows query, Flows: the links' flows and limits per interval, with utilisation and outage flag (page state: 3 days to 2026-08-11, region SA1)
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS(fct_interconnector[interconnector], fct_interconnector[date], fct_interconnector[time], fct_interconnector[mw], fct_interconnector[export_limit], fct_interconnector[import_limit], "util", [Flow utilisation], "out", [No flow]), fct_interconnector[date] >= dt"2026-08-09", fct_interconnector[date] <= dt"2026-08-11", (dim_interconnector[from_region] = "SA1" || dim_interconnector[to_region] = "SA1")), "id", [interconnector], "date", [date], "time", [time], "mw", [mw], "export_limit", [export_limit], "import_limit", [import_limit], "util", [util], "out", [out]) ORDER BY [date], [time], [id], [mw], [export_limit], [import_limit]
