// note: the dashboard's generation query, the generation chart: output and charging per series and interval, with the per-interval total (page state: 3 days to 2026-08-11, fuel Wind)
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS(fct_summary[date], fct_summary[time], ROLLUPADDISSUBTOTAL(fct_summary[DUID], "all"), "output", [Generation MW], "charging", [Charging MW]), fct_summary[date] >= dt"2026-08-09", fct_summary[date] <= dt"2026-08-11", dim_duid[FuelSourceDescriptor] = "Wind"), "date", [date], "time", [time], "series", [DUID], "output", [output], "charging", [charging], "all", [all]) ORDER BY [date], [time], [series], [all]
