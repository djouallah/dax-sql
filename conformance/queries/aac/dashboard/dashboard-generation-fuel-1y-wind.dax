// note: the dashboard's generation query, the generation chart: output and charging per series and interval, with the per-interval total (page state: 1 year to 2026-08-11, fuel Wind)
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS(dim_calendar[date], ROLLUPADDISSUBTOTAL(dim_duid[FuelSourceDescriptor], "all"), "output", [Generation MWh], "charging", [Charging MWh], "share", [Generation share]), dim_calendar[date] >= dt"2026-07-28", dim_calendar[date] <= dt"2026-08-11", dim_duid[FuelSourceDescriptor] = "Wind"), "date", [date], "series", [FuelSourceDescriptor], "output", [output], "charging", [charging], "share", [share], "all", [all]) ORDER BY [date], [series], [all]
