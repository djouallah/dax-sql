// note: the dashboard's generation query, the generation chart: output and charging per series and interval, with the per-interval total (page state: 3 days to 2026-08-11, region SA1)
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS(fct_summary[date], fct_summary[time], ROLLUPADDISSUBTOTAL(dim_duid[FuelSourceDescriptor], "all"), "output", [Generation MW], "charging", [Charging MW], "share", [Generation share]), fct_summary[date] >= dt"2026-08-09", fct_summary[date] <= dt"2026-08-11", dim_duid[Region] = "SA1"), "date", [date], "time", [time], "series", [FuelSourceDescriptor], "output", [output], "charging", [charging], "share", [share], "all", [all]) ORDER BY [date], [time], [series], [all]
