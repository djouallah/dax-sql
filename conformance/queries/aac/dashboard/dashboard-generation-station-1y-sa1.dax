// note: the dashboard's generation query, the generation chart: output and charging per series and interval, with the per-interval total (page state: 1 year to 2026-08-11, region SA1)
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS(dim_calendar[date], ROLLUPADDISSUBTOTAL(dim_duid[Plant], "all"), "output", [Generation MWh], "charging", [Charging MWh]), dim_calendar[date] >= dt"2026-07-28", dim_calendar[date] <= dt"2026-08-11", dim_duid[Region] = "SA1"), "date", [date], "series", [Plant], "output", [output], "charging", [charging], "all", [all]) ORDER BY [date], [series], [all]
