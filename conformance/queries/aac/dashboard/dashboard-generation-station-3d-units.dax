// note: the dashboard's generation query, the generation chart: output and charging per series and interval, with the per-interval total (page state: 3 days to 2026-08-11, units HPR1 BALDHWF1)
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS(fct_summary[date], fct_summary[time], ROLLUPADDISSUBTOTAL(dim_duid[Plant], "all"), "output", [Generation MW], "charging", [Charging MW]), fct_summary[date] >= dt"2026-08-09", fct_summary[date] <= dt"2026-08-11", fct_summary[DUID] IN {"HPR1", "BALDHWF1"}), "date", [date], "time", [time], "series", [Plant], "output", [output], "charging", [charging], "all", [all]) ORDER BY [date], [time], [series], [all]
