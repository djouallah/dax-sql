// note: the dashboard's generationAverage query, the generation KPI over the range (page state: 3 days to 2026-08-11, units HPR1 BALDHWF1)
EVALUATE CALCULATETABLE(ROW("avg", [Average generation MW]), fct_summary[date] >= dt"2026-08-09", fct_summary[date] <= dt"2026-08-11", fct_region[date] >= dt"2026-08-09", fct_region[date] <= dt"2026-08-11", dim_calendar[date] >= dt"2026-08-09", dim_calendar[date] <= dt"2026-08-11", fct_summary[DUID] IN {"HPR1", "BALDHWF1"})
