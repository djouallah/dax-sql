// note: the dashboard's generationNotOf query, the generation chart's "Other units": the series not drawn one by one (page state: 1 year to 2026-08-11, fuel Wind)
EVALUATE CALCULATETABLE(SUMMARIZECOLUMNS(dim_calendar[date], "output", [Generation MWh], "charging", [Charging MWh]), dim_calendar[date] >= dt"2026-07-28", dim_calendar[date] <= dt"2026-08-11", dim_duid[FuelSourceDescriptor] = "Wind", NOT (dim_duid[DUID] IN {"HPR1", "BALDHWF1"})) ORDER BY [date]
