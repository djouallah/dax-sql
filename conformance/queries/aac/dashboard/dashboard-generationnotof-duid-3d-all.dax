// note: the dashboard's generationNotOf query, the generation chart's "Other units": the series not drawn one by one (page state: 3 days to 2026-08-11, all)
EVALUATE CALCULATETABLE(SUMMARIZECOLUMNS(fct_summary[date], fct_summary[time], "output", [Generation MW], "charging", [Charging MW]), fct_summary[date] >= dt"2026-08-09", fct_summary[date] <= dt"2026-08-11", NOT (fct_summary[DUID] IN {"HPR1", "BALDHWF1"})) ORDER BY [date], [time]
