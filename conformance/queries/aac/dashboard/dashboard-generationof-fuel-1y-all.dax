// note: the dashboard's generationOf query, the hero's "Other" fuels, added up per interval (page state: 1 year to 2026-08-11, all)
EVALUATE CALCULATETABLE(SUMMARIZECOLUMNS(dim_calendar[date], "output", [Generation MWh], "charging", [Charging MWh]), dim_calendar[date] >= dt"2026-07-28", dim_calendar[date] <= dt"2026-08-11", (ISBLANK(dim_duid[FuelSourceDescriptor]) || dim_duid[FuelSourceDescriptor] IN {"Diesel"})) ORDER BY [date]
