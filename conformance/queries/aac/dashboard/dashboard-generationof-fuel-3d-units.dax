// note: the dashboard's generationOf query, the hero's "Other" fuels, added up per interval (page state: 3 days to 2026-08-11, units HPR1 BALDHWF1)
EVALUATE CALCULATETABLE(SUMMARIZECOLUMNS(fct_summary[date], fct_summary[time], "output", [Generation MW], "charging", [Charging MW]), fct_summary[date] >= dt"2026-08-09", fct_summary[date] <= dt"2026-08-11", fct_summary[DUID] IN {"HPR1", "BALDHWF1"}, (ISBLANK(dim_duid[FuelSourceDescriptor]) || dim_duid[FuelSourceDescriptor] IN {"Diesel"})) ORDER BY [date], [time]
