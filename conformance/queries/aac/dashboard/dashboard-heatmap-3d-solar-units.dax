// note: the dashboard's heatmap query, the price heatmap: per date (month) and hour (page state: 3 days to 2026-08-11, fuel Solar, units HPR1 BALDHWF1)
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS(fct_region[date], dim_time[hour], "price", [Average price]), fct_region[date] >= dt"2026-08-09", fct_region[date] <= dt"2026-08-11", dim_duid[FuelSourceDescriptor] = "Solar", dim_duid[DUID] IN {"HPR1", "BALDHWF1"}), "date", [date], "y", [hour], "price", [price]) ORDER BY [date], [y]
