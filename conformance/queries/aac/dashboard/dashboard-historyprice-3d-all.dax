// note: the dashboard's historyPrice query, History: the average price and demand per day (page state: 3 days to 2026-08-11, all)
EVALUATE CALCULATETABLE(SUMMARIZECOLUMNS(dim_calendar[date], "price", [Average price], "demand", [Average demand MW]), dim_calendar[date] >= dt"2026-07-28", dim_calendar[date] <= dt"2026-08-11") ORDER BY [date]
