// note: the dashboard's historyShare query, History: the renewable share per day (page state: 3 days to 2026-08-11, all)
EVALUATE CALCULATETABLE(SUMMARIZECOLUMNS(dim_calendar[date], "re", [Renewable share]), dim_calendar[date] >= dt"2026-07-28", dim_calendar[date] <= dt"2026-08-11") ORDER BY [date]
