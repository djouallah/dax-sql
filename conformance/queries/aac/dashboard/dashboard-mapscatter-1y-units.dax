// note: the dashboard's mapScatter query, the map: each unit with a position and its average MW (page state: 1 year to 2026-08-11, units HPR1 BALDHWF1)
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS(dim_duid[DUID], dim_duid[FuelSourceDescriptor], dim_duid[Region], dim_duid[latitude], dim_duid[longitude], "mw", [Average MWh a day]), dim_calendar[date] >= dt"2026-07-28", dim_calendar[date] <= dt"2026-08-11", dim_duid[DUID] IN {"HPR1", "BALDHWF1"}, NOT ISBLANK(dim_duid[latitude])), "DUID", [DUID], "fuel", [FuelSourceDescriptor], "Region", [Region], "lat", [latitude], "lon", [longitude], "mw", [mw])
