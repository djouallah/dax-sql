// note: the dashboard's negativePrices query, the negative-price share and the lowest price per region (page state: 3 days to 2026-08-11, fuel Solar, units HPR1 BALDHWF1)
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS(fct_region[REGIONID], "pct", [Negative price share], "lowest", [Lowest price]), fct_region[date] >= dt"2026-08-09", fct_region[date] <= dt"2026-08-11", dim_duid[FuelSourceDescriptor] = "Solar", dim_duid[DUID] IN {"HPR1", "BALDHWF1"}), "region", [REGIONID], "pct", [pct], "lowest", [lowest]) ORDER BY [region]
