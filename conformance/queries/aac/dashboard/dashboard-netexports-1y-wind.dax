// note: the dashboard's netExports query, net exports per region and interval (page state: 1 year to 2026-08-11, fuel Wind)
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS(dim_calendar[date], dim_region[Region], "mw", [Net interchange MW]), dim_calendar[date] >= dt"2026-07-28", dim_calendar[date] <= dt"2026-08-11", dim_duid[FuelSourceDescriptor] = "Wind"), "date", [date], "region", [Region], "mw", [mw]) ORDER BY [date], [region]
