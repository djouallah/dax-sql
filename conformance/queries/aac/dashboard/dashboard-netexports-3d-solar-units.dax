// note: the dashboard's netExports query, net exports per region and interval (page state: 3 days to 2026-08-11, fuel Solar, units HPR1 BALDHWF1)
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS(fct_region[date], fct_region[time], fct_region[REGIONID], "mw", [Net interchange MW]), fct_region[date] >= dt"2026-08-09", fct_region[date] <= dt"2026-08-11", dim_duid[FuelSourceDescriptor] = "Solar", dim_duid[DUID] IN {"HPR1", "BALDHWF1"}), "date", [date], "time", [time], "region", [REGIONID], "mw", [mw]) ORDER BY [date], [time], [region]
