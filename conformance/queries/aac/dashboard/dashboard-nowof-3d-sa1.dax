// note: the dashboard's nowOf query, "Right now": the output of some fuels together (the hero's "Other") (page state: 3 days to 2026-08-11, region SA1)
EVALUATE CALCULATETABLE(ROW("mw", [Generation MW]), fct_summary[date] = dt"2026-08-11", fct_summary[time] = 1200, dim_duid[Region] = "SA1", (ISBLANK(dim_duid[FuelSourceDescriptor]) || dim_duid[FuelSourceDescriptor] IN {"Diesel"}))
