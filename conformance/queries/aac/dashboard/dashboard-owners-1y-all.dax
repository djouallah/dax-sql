// note: the dashboard's owners query, energy by owner and plant, with its share (page state: 1 year to 2026-08-11, all)
EVALUATE FILTER(SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS(dim_duid[Owner], dim_duid[Plant], dim_duid[FuelSourceDescriptor], "mwh", [Generation MWh], "share", [Generation share]), dim_calendar[date] >= dt"2026-07-28", dim_calendar[date] <= dt"2026-08-11"), "owner", [Owner], "plant", [Plant], "fuel", [FuelSourceDescriptor], "mwh", [mwh], "share", [share]), [mwh] > 0) ORDER BY [mwh] DESC, [owner], [plant], [fuel]
