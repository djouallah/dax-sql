// note: the dashboard's owners query, energy by owner and plant, with its share (page state: 3 days to 2026-08-11, units HPR1 BALDHWF1)
EVALUATE FILTER(SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS(dim_duid[Owner], dim_duid[Plant], dim_duid[FuelSourceDescriptor], "mwh", [Generation MWh], "share", [Generation share]), fct_summary[date] >= dt"2026-08-09", fct_summary[date] <= dt"2026-08-11", fct_summary[DUID] IN {"HPR1", "BALDHWF1"}), "owner", [Owner], "plant", [Plant], "fuel", [FuelSourceDescriptor], "mwh", [mwh], "share", [share]), [mwh] > 0) ORDER BY [mwh] DESC, [owner], [plant], [fuel]
