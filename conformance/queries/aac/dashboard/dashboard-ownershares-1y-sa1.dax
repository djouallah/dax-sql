// note: the dashboard's ownerShares query, each owner's energy and share (page state: 1 year to 2026-08-11, region SA1)
EVALUATE FILTER(SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS(dim_duid[Owner], "mwh", [Generation MWh], "share", [Generation share]), dim_calendar[date] >= dt"2026-07-28", dim_calendar[date] <= dt"2026-08-11", dim_duid[Region] = "SA1"), "owner", [Owner], "mwh", [mwh], "share", [share]), [mwh] > 0)
