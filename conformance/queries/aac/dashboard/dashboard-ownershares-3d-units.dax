// note: the dashboard's ownerShares query, each owner's energy and share (page state: 3 days to 2026-08-11, units HPR1 BALDHWF1)
EVALUATE FILTER(SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS(dim_duid[Owner], "mwh", [Generation MWh], "share", [Generation share]), fct_summary[date] >= dt"2026-08-09", fct_summary[date] <= dt"2026-08-11", fct_summary[DUID] IN {"HPR1", "BALDHWF1"}), "owner", [Owner], "mwh", [mwh], "share", [share]), [mwh] > 0)
