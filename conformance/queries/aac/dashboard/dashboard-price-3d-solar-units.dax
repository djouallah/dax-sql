// note: the dashboard's price query, the price chart: per region and interval, with all regions' total (page state: 3 days to 2026-08-11, fuel Solar, units HPR1 BALDHWF1)
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS(fct_region[date], fct_region[time], ROLLUPADDISSUBTOTAL(fct_region[REGIONID], "total"), "avg_price", [Average price]), fct_region[date] >= dt"2026-08-09", fct_region[date] <= dt"2026-08-11", dim_duid[FuelSourceDescriptor] = "Solar", dim_duid[DUID] IN {"HPR1", "BALDHWF1"}), "date", [date], "time", [time], "Region", [REGIONID], "avg_price", [avg_price], "total", [total]) ORDER BY [date], [time], [Region], [total]
