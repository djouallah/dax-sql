// note: the dashboard's renewableShareByPeriod query, the renewable share per interval (the fuel filter ignored) (page state: 1 year to 2026-08-11, region SA1)
EVALUATE CALCULATETABLE(SUMMARIZECOLUMNS(dim_calendar[date], "share", [Renewable share]), dim_calendar[date] >= dt"2026-07-28", dim_calendar[date] <= dt"2026-08-11", dim_duid[Region] = "SA1") ORDER BY [date]
