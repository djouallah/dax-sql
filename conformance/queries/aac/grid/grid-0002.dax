// note: the view expander's grid (tools/ossie/grid.mjs), group: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.Participant, AGG(t."Registered units") AS v FROM aac.dim_duid AS t GROUP BY t.Participant
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('dim_duid'[Participant], "__rows", COUNTROWS('dim_duid'), "v", 'dim_duid'[Registered units]), "Participant", 'dim_duid'[Participant], "v", [v])
