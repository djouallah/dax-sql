// note: the view expander's grid (tools/ossie/grid.mjs), two groups: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.Participant, t.TechnologyType, AGG(t."Storage MWh") AS v FROM aac.dim_duid AS t GROUP BY t.Participant, t.TechnologyType
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('dim_duid'[Participant], 'dim_duid'[TechnologyType], "__rows", COUNTROWS(dim_duid), "v", 'dim_duid'[Storage MWh]), "Participant", 'dim_duid'[Participant], "TechnologyType", 'dim_duid'[TechnologyType], "v", [v])
