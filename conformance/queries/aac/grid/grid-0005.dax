// note: the view expander's grid (tools/ossie/grid.mjs), where: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.Participant, AGG(t."Registered MW") AS v FROM aac.dim_duid AS t WHERE t.Owner IS NULL GROUP BY t.Participant
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('dim_duid'[Participant], "__rows", COUNTROWS(dim_duid), "v", 'dim_duid'[Registered MW]), ISBLANK('dim_duid'[Owner])), "Participant", 'dim_duid'[Participant], "v", [v])
