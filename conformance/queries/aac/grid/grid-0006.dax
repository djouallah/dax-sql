// note: the view expander's grid (tools/ossie/grid.mjs), where and: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.Participant, AGG(t."Registered units") AS v FROM aac.dim_duid AS t WHERE t.StationName IS NULL AND t.TechnologyType = 'Wind - Onshore' GROUP BY t.Participant
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('dim_duid'[Participant], "__rows", COUNTROWS(dim_duid), "v", 'dim_duid'[Registered units]), ISBLANK('dim_duid'[StationName]), ('dim_duid'[TechnologyType] = "Wind - Onshore")), "Participant", 'dim_duid'[Participant], "v", [v])
