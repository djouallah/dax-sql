// note: the view expander's grid (tools/ossie/grid.mjs), where total: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT AGG(t."Registered MW") AS v FROM aac.dim_duid AS t WHERE t.longitude BETWEEN 116.3075 AND 138.5181
EVALUATE SELECTCOLUMNS(CALCULATETABLE(ROW("v", 'dim_duid'[Registered MW]), (('dim_duid'[longitude] >= 116.3075) && ('dim_duid'[longitude] <= 138.5181))), "v", [v])
