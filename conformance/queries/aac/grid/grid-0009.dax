// note: the view expander's grid (tools/ossie/grid.mjs), having: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.Participant, AGG(t."Registered MW") AS v FROM aac.dim_duid AS t GROUP BY t.Participant HAVING AGG(t."Storage MWh") > 0
EVALUATE SELECTCOLUMNS(FILTER(SUMMARIZECOLUMNS('dim_duid'[Participant], "__rows", COUNTROWS('dim_duid'), "v", 'dim_duid'[Registered MW]), ('dim_duid'[Storage MWh] > 0)), "Participant", 'dim_duid'[Participant], "v", [v])
