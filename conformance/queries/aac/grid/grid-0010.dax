// note: the view expander's grid (tools/ossie/grid.mjs), having null: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.Participant, AGG(t."Storage MWh") AS v FROM aac.dim_duid AS t GROUP BY t.Participant HAVING AGG(t."Storage MWh") IS NOT NULL
EVALUATE SELECTCOLUMNS(FILTER(SUMMARIZECOLUMNS('dim_duid'[Participant], "__rows", COUNTROWS(dim_duid), "v", 'dim_duid'[Storage MWh]), NOT(ISBLANK([v]))), "Participant", 'dim_duid'[Participant], "v", [v])
