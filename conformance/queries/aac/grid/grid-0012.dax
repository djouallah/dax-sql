// note: the view expander's grid (tools/ossie/grid.mjs), order by measure: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.Participant, AGG(t."Storage MWh") AS v FROM aac.dim_duid AS t GROUP BY t.Participant ORDER BY v DESC NULLS LAST, t.Participant NULLS FIRST
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('dim_duid'[Participant], "__rows", COUNTROWS('dim_duid'), "v", 'dim_duid'[Storage MWh]), "Participant", 'dim_duid'[Participant], "v", [v]) ORDER BY [v] DESC, [Participant]
