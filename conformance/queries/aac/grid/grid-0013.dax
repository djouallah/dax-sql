// note: the view expander's grid (tools/ossie/grid.mjs), group by all: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.Participant, AGG(t."Registered MW") AS v FROM aac.dim_duid AS t GROUP BY ALL
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('dim_duid'[Participant], "__rows", COUNTROWS('dim_duid'), "v", 'dim_duid'[Registered MW]), "Participant", 'dim_duid'[Participant], "v", [v])
