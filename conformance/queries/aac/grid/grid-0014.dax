// note: the view expander's grid (tools/ossie/grid.mjs), rollup: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.Region, AGG(t."Storage MWh") AS v FROM aac.dim_duid AS t GROUP BY ROLLUP (t.Region) ORDER BY t.Region NULLS LAST
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS(ROLLUPADDISSUBTOTAL('dim_duid'[Region], "__level1_Region"), "__rows", COUNTROWS('dim_duid'), "v", 'dim_duid'[Storage MWh]), "Region", 'dim_duid'[Region], "v", [v]) ORDER BY ISBLANK([Region]), [Region]
