// note: the view expander's grid (tools/ossie/grid.mjs), cte: its SQL as dax-sql's SQL front end writes it in DAX:
// WITH s AS (SELECT Participant, "Registered units" AS mm FROM aac.dim_duid WHERE CO2eFactor = 1.163) SELECT Participant, AGG(mm) AS v FROM s GROUP BY Participant
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('dim_duid'[Participant], "__rows", COUNTROWS('dim_duid'), "v", 'dim_duid'[Registered units]), ('dim_duid'[CO2eFactor] = 1.163)), "Participant", 'dim_duid'[Participant], "v", [v])
