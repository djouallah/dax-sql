// note: the view expander's grid (tools/ossie/grid.mjs), derived table: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT s.Participant, s.v FROM (SELECT t.Participant, AGG(t."Registered MW") AS v FROM aac.dim_duid AS t GROUP BY t.Participant) AS s WHERE s.v IS NOT NULL
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('dim_duid'[Participant], "__rows", COUNTROWS(dim_duid), "v", 'dim_duid'[Registered MW]), "Participant", 'dim_duid'[Participant], "v", [v])
