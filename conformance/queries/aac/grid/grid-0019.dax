// note: the view expander's grid (tools/ossie/grid.mjs), star: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.Storage, AGG(f."Price seen") AS v FROM aac.fct_summary AS f JOIN aac.dim_duid AS o ON f.DUID = o.DUID GROUP BY o.Storage
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('dim_duid'[Storage], "__rows", COUNTROWS(fct_summary), "v", 'fct_summary'[Price seen]), NOT(ISBLANK('dim_duid'[DUID]))), "Storage", 'dim_duid'[Storage], "v", [v])
