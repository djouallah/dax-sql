// note: the view expander's grid (tools/ossie/grid.mjs), star where many: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.Storage, AGG(f."Average MW") AS v FROM aac.fct_summary AS f JOIN aac.dim_duid AS o ON f.DUID = o.DUID WHERE f.DUID IS NOT NULL GROUP BY o.Storage
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('dim_duid'[Storage], "__rows", COUNTROWS('fct_summary'), "v", 'fct_summary'[Average MW]), NOT(ISBLANK('fct_summary'[DUID])), NOT(ISBLANK('dim_duid'[DUID]))), "Storage", 'dim_duid'[Storage], "v", [v])
