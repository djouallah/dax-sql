// note: the view expander's grid (tools/ossie/grid.mjs), star two sides: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.Storage, f."date", AGG(f."Days with output") AS v FROM aac.fct_summary AS f JOIN aac.dim_duid AS o ON f.DUID = o.DUID GROUP BY o.Storage, f."date"
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('dim_duid'[Storage], 'fct_summary'[date], "__rows", COUNTROWS('fct_summary'), "v", 'fct_summary'[Days with output]), NOT(ISBLANK('dim_duid'[DUID]))), "Storage", 'dim_duid'[Storage], "date", 'fct_summary'[date], "v", [v])
