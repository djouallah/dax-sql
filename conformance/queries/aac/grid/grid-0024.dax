// note: the view expander's grid (tools/ossie/grid.mjs), one side counted once: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.Plant, AGG(f."Price seen") AS a, AGG(o."Storage MWh") AS b FROM aac.fct_summary AS f JOIN aac.dim_duid AS o ON f.DUID = o.DUID GROUP BY o.Plant
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('dim_duid'[Plant], "__rows", COUNTROWS('fct_summary'), "a", 'fct_summary'[Price seen], "b", CALCULATE('dim_duid'[Storage MWh], 'fct_summary')), NOT(ISBLANK('dim_duid'[DUID]))), "Plant", 'dim_duid'[Plant], "a", [a], "b", [b])
