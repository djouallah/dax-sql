// note: the view expander's grid (tools/ossie/grid.mjs), chasm: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.Storage, AGG(a."Days with output") AS x, AGG(b."Average MWh a day") AS y FROM aac.dim_duid AS o LEFT JOIN aac.fct_summary AS a ON a.DUID = o.DUID LEFT JOIN aac.fct_summary_daily AS b ON b.DUID = o.DUID GROUP BY o.Storage
DEFINE
VAR __v1 = GENERATEALL(GENERATEALL(SELECTCOLUMNS('dim_duid', "o.DUID", 'dim_duid'[DUID], "o.Storage", 'dim_duid'[Storage]), FILTER(SELECTCOLUMNS('fct_summary', "a.date", 'fct_summary'[date], "a.time", 'fct_summary'[time], "a.DUID", 'fct_summary'[DUID], "a.mw", 'fct_summary'[mw], "a.price", 'fct_summary'[price], "a.cutoff", 'fct_summary'[cutoff]), ([a.DUID] = [o.DUID]))), FILTER(SELECTCOLUMNS('fct_summary_daily', "b.DUID", 'fct_summary_daily'[DUID], "b.date", 'fct_summary_daily'[date], "b.mwh", 'fct_summary_daily'[mwh], "b.price", 'fct_summary_daily'[price], "b.output_mwh", 'fct_summary_daily'[output_mwh], "b.charging_mwh", 'fct_summary_daily'[charging_mwh], "b.revenue", 'fct_summary_daily'[revenue]), ([b.DUID] = [o.DUID])))
VAR __v2 = DISTINCT(SELECTCOLUMNS(__v1, "Storage", [o.Storage]))
EVALUATE SELECTCOLUMNS(ADDCOLUMNS(__v2, "__m1", CALCULATE('fct_summary'[Days with output], REMOVEFILTERS(), TREATAS(SELECTCOLUMNS(FILTER(__v1, (NOT((((((ISBLANK([a.date]) && ISBLANK([a.time])) && ISBLANK([a.DUID])) && ISBLANK([a.mw])) && ISBLANK([a.price])) && ISBLANK([a.cutoff]))) && ([o.Storage] == [Storage]))), "__k1", [a.date], "__k2", [a.time], "__k3", [a.DUID], "__k4", [a.mw], "__k5", [a.price], "__k6", [a.cutoff]), 'fct_summary'[date], 'fct_summary'[time], 'fct_summary'[DUID], 'fct_summary'[mw], 'fct_summary'[price], 'fct_summary'[cutoff])), "__m2", CALCULATE('fct_summary_daily'[Average MWh a day], REMOVEFILTERS(), TREATAS(SELECTCOLUMNS(FILTER(__v1, (NOT(((((((ISBLANK([b.DUID]) && ISBLANK([b.date])) && ISBLANK([b.mwh])) && ISBLANK([b.price])) && ISBLANK([b.output_mwh])) && ISBLANK([b.charging_mwh])) && ISBLANK([b.revenue]))) && ([o.Storage] == [Storage]))), "__k1", [b.DUID], "__k2", [b.date], "__k3", [b.mwh], "__k4", [b.price], "__k5", [b.output_mwh], "__k6", [b.charging_mwh], "__k7", [b.revenue]), 'fct_summary_daily'[DUID], 'fct_summary_daily'[date], 'fct_summary_daily'[mwh], 'fct_summary_daily'[price], 'fct_summary_daily'[output_mwh], 'fct_summary_daily'[charging_mwh], 'fct_summary_daily'[revenue]))), "Storage", [Storage], "x", [__m1], "y", [__m2])
