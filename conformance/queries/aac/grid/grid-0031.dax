// note: the view expander's grid (tools/ossie/grid.mjs), two metrics: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.FuelSourceDescriptor, AGG(t."Storage MWh") AS a, AGG(t."Registered units") AS b FROM aac.dim_duid AS t GROUP BY t.FuelSourceDescriptor
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('dim_duid'[FuelSourceDescriptor], "__rows", COUNTROWS(dim_duid), "a", 'dim_duid'[Storage MWh], "b", 'dim_duid'[Registered units]), "FuelSourceDescriptor", 'dim_duid'[FuelSourceDescriptor], "a", [a], "b", [b])
