// note: the view expander's grid (tools/ossie/grid.mjs), two groups: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.FuelSourceDescriptor, t.DUID, AGG(t."Registered MW") AS v FROM aac.dim_duid AS t GROUP BY t.FuelSourceDescriptor, t.DUID
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('dim_duid'[FuelSourceDescriptor], 'dim_duid'[DUID], "__rows", COUNTROWS('dim_duid'), "v", 'dim_duid'[Registered MW]), "FuelSourceDescriptor", 'dim_duid'[FuelSourceDescriptor], "DUID", 'dim_duid'[DUID], "v", [v])
