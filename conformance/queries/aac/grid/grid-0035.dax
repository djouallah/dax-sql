// note: the view expander's grid (tools/ossie/grid.mjs), where or: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.FuelSourceDescriptor, AGG(t."Registered units") AS v FROM aac.dim_duid AS t WHERE t.Storage <> FALSE OR t.Plant IS NOT NULL GROUP BY t.FuelSourceDescriptor
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('dim_duid'[FuelSourceDescriptor], "__rows", COUNTROWS('dim_duid'), "v", 'dim_duid'[Registered units]), (('dim_duid'[Storage] <> FALSE()) || NOT(ISBLANK('dim_duid'[Plant])))), "FuelSourceDescriptor", 'dim_duid'[FuelSourceDescriptor], "v", [v])
