// note: the view expander's grid (tools/ossie/grid.mjs), having: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.FuelSourceDescriptor, AGG(t."Registered MW") AS v FROM aac.dim_duid AS t GROUP BY t.FuelSourceDescriptor HAVING AGG(t."Registered units") > 0
EVALUATE SELECTCOLUMNS(FILTER(SUMMARIZECOLUMNS('dim_duid'[FuelSourceDescriptor], "__rows", COUNTROWS(dim_duid), "v", 'dim_duid'[Registered MW]), ('dim_duid'[Registered units] > 0)), "FuelSourceDescriptor", 'dim_duid'[FuelSourceDescriptor], "v", [v])
