// note: the view expander's grid (tools/ossie/grid.mjs), having null: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.FuelSourceDescriptor, AGG(t."Registered units") AS v FROM aac.dim_duid AS t GROUP BY t.FuelSourceDescriptor HAVING AGG(t."Storage MWh") IS NOT NULL
EVALUATE SELECTCOLUMNS(FILTER(SUMMARIZECOLUMNS('dim_duid'[FuelSourceDescriptor], "__rows", COUNTROWS('dim_duid'), "v", 'dim_duid'[Registered units]), NOT(ISBLANK('dim_duid'[Storage MWh]))), "FuelSourceDescriptor", 'dim_duid'[FuelSourceDescriptor], "v", [v])
