// note: the view expander's grid (tools/ossie/grid.mjs), order limit: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.FuelSourceDescriptor, AGG(t."Registered units") AS v FROM aac.dim_duid AS t GROUP BY t.FuelSourceDescriptor ORDER BY t.FuelSourceDescriptor NULLS FIRST LIMIT 3
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('dim_duid'[FuelSourceDescriptor], "__rows", COUNTROWS('dim_duid'), "v", 'dim_duid'[Registered units]), "FuelSourceDescriptor", 'dim_duid'[FuelSourceDescriptor], "v", [v]) ORDER BY [FuelSourceDescriptor]
