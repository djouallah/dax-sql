// note: the view expander's grid (tools/ossie/grid.mjs), rollup: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.Renewable, AGG(t."Registered units") AS v FROM aac.dim_duid AS t GROUP BY ROLLUP (t.Renewable) ORDER BY t.Renewable NULLS LAST
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS(ROLLUPADDISSUBTOTAL('dim_duid'[Renewable], "__level1_Renewable"), "__rows", COUNTROWS('dim_duid'), "v", 'dim_duid'[Registered units]), "Renewable", 'dim_duid'[Renewable], "v", [v]) ORDER BY ISBLANK([Renewable]), [Renewable]
