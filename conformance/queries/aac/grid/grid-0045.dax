// note: the view expander's grid (tools/ossie/grid.mjs), cte: its SQL as dax-sql's SQL front end writes it in DAX:
// WITH s AS (SELECT FuelSourceDescriptor, "Registered units" AS mm FROM aac.dim_duid WHERE Classification IS NOT NULL) SELECT FuelSourceDescriptor, AGG(mm) AS v FROM s GROUP BY FuelSourceDescriptor
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('dim_duid'[FuelSourceDescriptor], "__rows", COUNTROWS('dim_duid'), "v", 'dim_duid'[Registered units]), NOT(ISBLANK('dim_duid'[Classification]))), "FuelSourceDescriptor", 'dim_duid'[FuelSourceDescriptor], "v", [v])
