// note: the view expander's grid (tools/ossie/grid.mjs), derived table: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT s.FuelSourceDescriptor, s.v FROM (SELECT t.FuelSourceDescriptor, AGG(t."Registered MW") AS v FROM aac.dim_duid AS t GROUP BY t.FuelSourceDescriptor) AS s WHERE s.v IS NOT NULL
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('dim_duid'[FuelSourceDescriptor], "__rows", COUNTROWS('dim_duid'), "v", 'dim_duid'[Registered MW]), "FuelSourceDescriptor", 'dim_duid'[FuelSourceDescriptor], "v", [v])
