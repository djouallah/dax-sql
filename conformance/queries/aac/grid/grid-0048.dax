// note: the view expander's grid (tools/ossie/grid.mjs), star where one: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.TechnologyType, AGG(f."Price seen") AS v FROM aac.fct_summary AS f JOIN aac.dim_duid AS o ON f.DUID = o.DUID WHERE o.DUID IS NOT NULL GROUP BY o.TechnologyType
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('dim_duid'[TechnologyType], "__rows", COUNTROWS('fct_summary'), "v", 'fct_summary'[Price seen]), NOT(ISBLANK('dim_duid'[DUID])), NOT(ISBLANK('dim_duid'[DUID]))), "TechnologyType", 'dim_duid'[TechnologyType], "v", [v])
