// note: the view expander's grid (tools/ossie/grid.mjs), star where many: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.TechnologyType, AGG(f."Days with output") AS v FROM aac.fct_summary AS f JOIN aac.dim_duid AS o ON f.DUID = o.DUID WHERE f.DUID IS NOT NULL GROUP BY o.TechnologyType
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('dim_duid'[TechnologyType], "__rows", COUNTROWS('fct_summary'), "v", 'fct_summary'[Days with output]), NOT(ISBLANK('fct_summary'[DUID])), NOT(ISBLANK('dim_duid'[DUID]))), "TechnologyType", 'dim_duid'[TechnologyType], "v", [v])
