// note: the view expander's grid (tools/ossie/grid.mjs), star two sides: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.TechnologyType, f."date", AGG(f."Average MW") AS v FROM aac.fct_summary AS f JOIN aac.dim_duid AS o ON f.DUID = o.DUID GROUP BY o.TechnologyType, f."date"
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('dim_duid'[TechnologyType], 'fct_summary'[date], "__rows", COUNTROWS('fct_summary'), "v", 'fct_summary'[Average MW]), NOT(ISBLANK('dim_duid'[DUID]))), "TechnologyType", 'dim_duid'[TechnologyType], "date", 'fct_summary'[date], "v", [v])
