// note: the view expander's grid (tools/ossie/grid.mjs), one side counted once: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.Storage, AGG(f."Price seen") AS a, AGG(o."Registered units") AS b FROM aac.fct_summary AS f JOIN aac.dim_duid AS o ON f.DUID = o.DUID GROUP BY o.Storage
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('dim_duid'[Storage], "__rows", COUNTROWS('fct_summary'), "a", 'fct_summary'[Price seen], "b", CALCULATE('dim_duid'[Registered units], 'fct_summary')), NOT(ISBLANK('dim_duid'[DUID]))), "Storage", 'dim_duid'[Storage], "a", [a], "b", [b])
