// note: the view expander's grid (tools/ossie/grid.mjs), fan-out: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT f.cutoff, AGG(o."Registered MW") AS v FROM aac.fct_summary AS f JOIN aac.dim_duid AS o ON f.DUID = o.DUID GROUP BY f.cutoff
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('fct_summary'[cutoff], "__rows", COUNTROWS('fct_summary'), "v", CALCULATE('dim_duid'[Registered MW], 'fct_summary')), NOT(ISBLANK('dim_duid'[DUID]))), "cutoff", 'fct_summary'[cutoff], "v", [v])
