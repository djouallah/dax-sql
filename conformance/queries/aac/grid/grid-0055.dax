EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('dim_region'[Region], "__rows", COUNTROWS(fct_curtailment), "v", 'fct_curtailment'[Curtailed MWh]), NOT(ISBLANK('dim_duid'[DUID])), NOT(ISBLANK('dim_region'[Region]))), "Region", 'dim_region'[Region], "v", [v])
