// note: the view expander's grid (tools/ossie/grid.mjs), chasm: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.Owner, AGG(a."Days with output") AS x, AGG(b."Output MWh hourly") AS y FROM aac.dim_duid AS o LEFT JOIN aac.fct_summary AS a ON a.DUID = o.DUID LEFT JOIN aac.fct_summary_hourly AS b ON b.DUID = o.DUID GROUP BY o.Owner
DEFINE
VAR __v1 = GENERATEALL(GENERATEALL(SELECTCOLUMNS(dim_duid, "o.DUID", 'dim_duid'[DUID], "o.Owner", 'dim_duid'[Owner]), FILTER(SELECTCOLUMNS(fct_summary, "a.date", 'fct_summary'[date], "a.time", 'fct_summary'[time], "a.DUID", 'fct_summary'[DUID], "a.mw", 'fct_summary'[mw], "a.price", 'fct_summary'[price], "a.cutoff", 'fct_summary'[cutoff]), ([a.DUID] = [o.DUID]))), FILTER(SELECTCOLUMNS(fct_summary_hourly, "b.DUID", 'fct_summary_hourly'[DUID], "b.month", 'fct_summary_hourly'[month], "b.hour", 'fct_summary_hourly'[hour], "b.mwh", 'fct_summary_hourly'[mwh]), ([b.DUID] = [o.DUID])))
VAR __v2 = DISTINCT(SELECTCOLUMNS(__v1, "Owner", [o.Owner]))
EVALUATE SELECTCOLUMNS(ADDCOLUMNS(__v2, "__m1", CALCULATE('fct_summary'[Days with output], REMOVEFILTERS(), TREATAS(SELECTCOLUMNS(FILTER(__v1, (NOT((((((ISBLANK([a.date]) && ISBLANK([a.time])) && ISBLANK([a.DUID])) && ISBLANK([a.mw])) && ISBLANK([a.price])) && ISBLANK([a.cutoff]))) && ([o.Owner] == [Owner]))), "__k1", [a.date], "__k2", [a.time], "__k3", [a.DUID], "__k4", [a.mw], "__k5", [a.price], "__k6", [a.cutoff]), 'fct_summary'[date], 'fct_summary'[time], 'fct_summary'[DUID], 'fct_summary'[mw], 'fct_summary'[price], 'fct_summary'[cutoff])), "__m2", CALCULATE('fct_summary_hourly'[Output MWh hourly], REMOVEFILTERS(), TREATAS(SELECTCOLUMNS(FILTER(__v1, (NOT((((ISBLANK([b.DUID]) && ISBLANK([b.month])) && ISBLANK([b.hour])) && ISBLANK([b.mwh]))) && ([o.Owner] == [Owner]))), "__k1", [b.DUID], "__k2", [b.month], "__k3", [b.hour], "__k4", [b.mwh]), 'fct_summary_hourly'[DUID], 'fct_summary_hourly'[month], 'fct_summary_hourly'[hour], 'fct_summary_hourly'[mwh]))), "Owner", [Owner], "x", [__m1], "y", [__m2])
