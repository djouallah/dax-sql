// note: the view expander's grid (tools/ossie/grid.mjs), chasm: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.Owner, AGG(a."Days with output") AS x, AGG(b."Output MWh hourly") AS y FROM aac.dim_duid AS o LEFT JOIN aac.fct_summary AS a ON a.DUID = o.DUID LEFT JOIN aac.fct_summary_hourly AS b ON b.DUID = o.DUID GROUP BY o.Owner
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('dim_duid'[Owner], "__rows", COUNTROWS('dim_duid'), "x", CALCULATE('fct_summary'[Days with output], KEEPFILTERS(NOT(ISBLANK('dim_duid'[DUID])))), "y", CALCULATE('fct_summary_hourly'[Output MWh hourly], KEEPFILTERS(NOT(ISBLANK('dim_duid'[DUID]))))), "Owner", 'dim_duid'[Owner], "x", [x], "y", [y])
