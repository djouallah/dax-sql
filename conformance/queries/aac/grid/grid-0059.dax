// note: the view expander's grid (tools/ossie/grid.mjs), two metrics: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.Storage, AGG(t."Registered MW") AS a, AGG(t."Registered units") AS b FROM aac.dim_duid AS t GROUP BY t.Storage
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('dim_duid'[Storage], "__rows", COUNTROWS(dim_duid), "a", 'dim_duid'[Registered MW], "b", 'dim_duid'[Registered units]), "Storage", 'dim_duid'[Storage], "a", [a], "b", [b])
