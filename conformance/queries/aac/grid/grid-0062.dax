// note: the view expander's grid (tools/ossie/grid.mjs), where and: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.Storage, AGG(t."Registered units") AS v FROM aac.dim_duid AS t WHERE t.latitude IS NOT NULL AND NOT (t.Storage = TRUE) GROUP BY t.Storage
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('dim_duid'[Storage], "__rows", COUNTROWS(dim_duid), "v", 'dim_duid'[Registered units]), NOT(ISBLANK('dim_duid'[latitude])), NOT(('dim_duid'[Storage] = TRUE()))), "Storage", 'dim_duid'[Storage], "v", [v])
