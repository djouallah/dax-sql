// note: the view expander's grid (tools/ossie/grid.mjs), having null: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.Storage, AGG(t."Registered MW") AS v FROM aac.dim_duid AS t GROUP BY t.Storage HAVING AGG(t."Registered MW") IS NOT NULL
EVALUATE SELECTCOLUMNS(FILTER(SUMMARIZECOLUMNS('dim_duid'[Storage], "__rows", COUNTROWS('dim_duid'), "v", 'dim_duid'[Registered MW]), NOT(ISBLANK([v]))), "Storage", 'dim_duid'[Storage], "v", [v])
