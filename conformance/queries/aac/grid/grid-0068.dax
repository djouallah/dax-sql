// note: the view expander's grid (tools/ossie/grid.mjs), order by measure: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.Storage, AGG(t."Registered units") AS v FROM aac.dim_duid AS t GROUP BY t.Storage ORDER BY v DESC NULLS LAST, t.Storage NULLS FIRST
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('dim_duid'[Storage], "__rows", COUNTROWS('dim_duid'), "v", 'dim_duid'[Registered units]), "Storage", 'dim_duid'[Storage], "v", [v]) ORDER BY [v] DESC, [Storage]
