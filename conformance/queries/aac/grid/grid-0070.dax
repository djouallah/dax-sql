// note: the view expander's grid (tools/ossie/grid.mjs), rollup: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.DUID, AGG(t."Registered units") AS v FROM aac.dim_duid AS t GROUP BY ROLLUP (t.DUID) ORDER BY t.DUID NULLS LAST
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS(ROLLUPADDISSUBTOTAL('dim_duid'[DUID], "__level1_DUID"), "__rows", COUNTROWS('dim_duid'), "v", 'dim_duid'[Registered units]), "DUID", 'dim_duid'[DUID], "v", [v]) ORDER BY ISBLANK([DUID]), [DUID]
