// note: the view expander's grid (tools/ossie/grid.mjs), ratio: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.Storage, CAST(AGG(t."Registered units") AS DOUBLE) / NULLIF(AGG(t."Storage MWh"), 0) AS r FROM aac.dim_duid AS t GROUP BY t.Storage
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('dim_duid'[Storage], "__rows", COUNTROWS(dim_duid), "r", IF(ISBLANK(COUNTROWS(dim_duid)), BLANK(), (CONVERT('dim_duid'[Registered units], DOUBLE) / IF(('dim_duid'[Storage MWh] == 0), BLANK(), 'dim_duid'[Storage MWh])))), "Storage", 'dim_duid'[Storage], "r", [r])
