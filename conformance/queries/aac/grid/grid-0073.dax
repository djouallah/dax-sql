// note: the view expander's grid (tools/ossie/grid.mjs), cte: its SQL as dax-sql's SQL front end writes it in DAX:
// WITH s AS (SELECT Storage, "Registered units" AS mm FROM aac.dim_duid WHERE Renewable IN (TRUE, FALSE)) SELECT Storage, AGG(mm) AS v FROM s GROUP BY Storage
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('dim_duid'[Storage], "__rows", COUNTROWS('dim_duid'), "v", 'dim_duid'[Registered units]), ('dim_duid'[Renewable] IN {TRUE(), FALSE()})), "Storage", 'dim_duid'[Storage], "v", [v])
