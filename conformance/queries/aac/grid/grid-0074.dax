// note: the view expander's grid (tools/ossie/grid.mjs), derived table: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT s.Storage, s.v FROM (SELECT t.Storage, AGG(t."Registered MW") AS v FROM aac.dim_duid AS t GROUP BY t.Storage) AS s WHERE s.v IS NOT NULL
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('dim_duid'[Storage], "__rows", COUNTROWS('dim_duid'), "v", 'dim_duid'[Registered MW]), "Storage", 'dim_duid'[Storage], "v", [v])
