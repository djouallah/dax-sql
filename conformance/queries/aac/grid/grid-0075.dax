// note: the view expander's grid (tools/ossie/grid.mjs), star: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.Renewable, AGG(f."Price seen") AS v FROM aac.fct_summary AS f JOIN aac.dim_duid AS o ON f.DUID = o.DUID GROUP BY o.Renewable
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('dim_duid'[Renewable], "__rows", COUNTROWS(fct_summary), "v", 'fct_summary'[Price seen]), NOT(ISBLANK('dim_duid'[DUID]))), "Renewable", 'dim_duid'[Renewable], "v", [v])
