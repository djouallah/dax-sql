// note: the view expander's grid (tools/ossie/grid.mjs), star where many: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.Renewable, AGG(f."Average MW") AS v FROM aac.fct_summary AS f JOIN aac.dim_duid AS o ON f.DUID = o.DUID WHERE f."time" IN (1200, 1900) GROUP BY o.Renewable
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('dim_duid'[Renewable], "__rows", COUNTROWS(fct_summary), "v", 'fct_summary'[Average MW]), ('fct_summary'[time] IN {1200, 1900}), NOT(ISBLANK('dim_duid'[DUID]))), "Renewable", 'dim_duid'[Renewable], "v", [v])
