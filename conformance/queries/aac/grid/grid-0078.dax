// note: the view expander's grid (tools/ossie/grid.mjs), star two sides: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.Renewable, f."time", AGG(f."Days with output") AS v FROM aac.fct_summary AS f JOIN aac.dim_duid AS o ON f.DUID = o.DUID GROUP BY o.Renewable, f."time"
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('dim_duid'[Renewable], 'fct_summary'[time], "__rows", COUNTROWS(fct_summary), "v", 'fct_summary'[Days with output]), NOT(ISBLANK('dim_duid'[DUID]))), "Renewable", 'dim_duid'[Renewable], "time", 'fct_summary'[time], "v", [v])
