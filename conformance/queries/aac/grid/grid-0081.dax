// note: the view expander's grid (tools/ossie/grid.mjs), one to many: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.Owner, AGG(o."Storage MWh") AS a, AGG(f."Curtailed MWh") AS b FROM aac.dim_duid AS o LEFT JOIN aac.fct_curtailment AS f ON f.DUID = o.DUID GROUP BY o.Owner
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('dim_duid'[Owner], "__rows", COUNTROWS('dim_duid'), "a", 'dim_duid'[Storage MWh], "b", CALCULATE('fct_curtailment'[Curtailed MWh], KEEPFILTERS(NOT(ISBLANK('dim_duid'[DUID]))))), "Owner", 'dim_duid'[Owner], "a", [a], "b", [b])
