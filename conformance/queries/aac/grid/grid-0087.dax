// note: the view expander's grid (tools/ossie/grid.mjs), two metrics: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.Classification, AGG(t."Registered units") AS a, AGG(t."Registered units") AS b FROM aac.dim_duid AS t GROUP BY t.Classification
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('dim_duid'[Classification], "__rows", COUNTROWS(dim_duid), "a", 'dim_duid'[Registered units], "b", 'dim_duid'[Registered units]), "Classification", 'dim_duid'[Classification], "a", [a], "b", [b])
