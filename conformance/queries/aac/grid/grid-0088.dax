// note: the view expander's grid (tools/ossie/grid.mjs), two groups: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.Classification, t.Region, AGG(t."Storage MWh") AS v FROM aac.dim_duid AS t GROUP BY t.Classification, t.Region
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('dim_duid'[Classification], 'dim_duid'[Region], "__rows", COUNTROWS('dim_duid'), "v", 'dim_duid'[Storage MWh]), "Classification", 'dim_duid'[Classification], "Region", 'dim_duid'[Region], "v", [v])
