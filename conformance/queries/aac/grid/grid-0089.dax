// note: the view expander's grid (tools/ossie/grid.mjs), where: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.Classification, AGG(t."Registered units") AS v FROM aac.dim_duid AS t WHERE NOT (t.MaxCapMW = 432) GROUP BY t.Classification
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('dim_duid'[Classification], "__rows", COUNTROWS('dim_duid'), "v", 'dim_duid'[Registered units]), NOT(('dim_duid'[MaxCapMW] = 432))), "Classification", 'dim_duid'[Classification], "v", [v])
