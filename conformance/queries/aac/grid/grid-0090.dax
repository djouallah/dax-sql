// note: the view expander's grid (tools/ossie/grid.mjs), where and: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.Classification, AGG(t."Registered MW") AS v FROM aac.dim_duid AS t WHERE t.Classification <> 'Scheduled' AND t.Plant IS NOT NULL GROUP BY t.Classification
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('dim_duid'[Classification], "__rows", COUNTROWS('dim_duid'), "v", 'dim_duid'[Registered MW]), ('dim_duid'[Classification] <> "Scheduled"), NOT(ISBLANK('dim_duid'[Plant]))), "Classification", 'dim_duid'[Classification], "v", [v])
