// note: the view expander's grid (tools/ossie/grid.mjs), where or: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.Classification, AGG(t."Storage MWh") AS v FROM aac.dim_duid AS t WHERE t.latitude >= -32.3714 OR t.Classification = 'Scheduled' GROUP BY t.Classification
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('dim_duid'[Classification], "__rows", COUNTROWS('dim_duid'), "v", 'dim_duid'[Storage MWh]), (('dim_duid'[latitude] >= (-32.3714)) || ('dim_duid'[Classification] = "Scheduled"))), "Classification", 'dim_duid'[Classification], "v", [v])
