// note: the view expander's grid (tools/ossie/grid.mjs), where total: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT AGG(t."Registered units") AS v FROM aac.dim_duid AS t WHERE t.Owner IN ('Stanwell Corporation Limited', 'AGL SA Generation Pty Limited')
EVALUATE SELECTCOLUMNS(CALCULATETABLE(ROW("v", 'dim_duid'[Registered units]), ('dim_duid'[Owner] IN {"Stanwell Corporation Limited", "AGL SA Generation Pty Limited"})), "v", [v])
