// note: the view expander's grid (tools/ossie/grid.mjs), having: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.Classification, AGG(t."Registered MW") AS v FROM aac.dim_duid AS t GROUP BY t.Classification HAVING AGG(t."Registered MW") > 0
EVALUATE SELECTCOLUMNS(FILTER(SUMMARIZECOLUMNS('dim_duid'[Classification], "__rows", COUNTROWS(dim_duid), "v", 'dim_duid'[Registered MW]), ([v] > 0)), "Classification", 'dim_duid'[Classification], "v", [v])
