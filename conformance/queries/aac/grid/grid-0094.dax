// note: the view expander's grid (tools/ossie/grid.mjs), having null: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.Classification, AGG(t."Registered MW") AS v FROM aac.dim_duid AS t GROUP BY t.Classification HAVING AGG(t."Storage MWh") IS NOT NULL
EVALUATE SELECTCOLUMNS(FILTER(SUMMARIZECOLUMNS('dim_duid'[Classification], "__rows", COUNTROWS('dim_duid'), "v", 'dim_duid'[Registered MW]), NOT(ISBLANK('dim_duid'[Storage MWh]))), "Classification", 'dim_duid'[Classification], "v", [v])
