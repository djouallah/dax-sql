// note: the view expander's grid (tools/ossie/grid.mjs), order by measure: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.Classification, AGG(t."Registered units") AS v FROM aac.dim_duid AS t GROUP BY t.Classification ORDER BY v DESC NULLS LAST, t.Classification NULLS FIRST
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('dim_duid'[Classification], "__rows", COUNTROWS(dim_duid), "v", 'dim_duid'[Registered units]), "Classification", 'dim_duid'[Classification], "v", [v]) ORDER BY [v] DESC, [Classification]
