// note: the view expander's grid (tools/ossie/grid.mjs), group by all: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.Classification, AGG(t."Storage MWh") AS v FROM aac.dim_duid AS t GROUP BY ALL
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('dim_duid'[Classification], "__rows", COUNTROWS(dim_duid), "v", 'dim_duid'[Storage MWh]), "Classification", 'dim_duid'[Classification], "v", [v])
