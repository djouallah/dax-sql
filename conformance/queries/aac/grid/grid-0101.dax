// note: the view expander's grid (tools/ossie/grid.mjs), cte: its SQL as dax-sql's SQL front end writes it in DAX:
// WITH s AS (SELECT Classification, "Registered MW" AS mm FROM aac.dim_duid WHERE MaxCapMW < 200) SELECT Classification, AGG(mm) AS v FROM s GROUP BY Classification
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('dim_duid'[Classification], "__rows", COUNTROWS('dim_duid'), "v", 'dim_duid'[Registered MW]), ('dim_duid'[MaxCapMW] < 200)), "Classification", 'dim_duid'[Classification], "v", [v])
