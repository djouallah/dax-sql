// note: the view expander's grid (tools/ossie/grid.mjs), derived table: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT s.Classification, s.v FROM (SELECT t.Classification, AGG(t."Registered MW") AS v FROM aac.dim_duid AS t GROUP BY t.Classification) AS s WHERE s.v IS NOT NULL
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('dim_duid'[Classification], "__rows", COUNTROWS(dim_duid), "v", 'dim_duid'[Registered MW]), "Classification", 'dim_duid'[Classification], "v", [v])
