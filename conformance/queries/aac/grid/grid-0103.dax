// note: the view expander's grid (tools/ossie/grid.mjs), star: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o."year", AGG(f."Average MW") AS v FROM aac.fct_summary AS f JOIN aac.dim_calendar AS o ON f."date" = o."date" GROUP BY o."year"
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('dim_calendar'[year], "__rows", COUNTROWS('fct_summary'), "v", 'fct_summary'[Average MW]), NOT(ISBLANK('dim_calendar'[date]))), "year", 'dim_calendar'[year], "v", [v])
