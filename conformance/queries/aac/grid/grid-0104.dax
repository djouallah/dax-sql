// note: the view expander's grid (tools/ossie/grid.mjs), star where one: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o."year", AGG(f."Days with output") AS v FROM aac.fct_summary AS f JOIN aac.dim_calendar AS o ON f."date" = o."date" WHERE o."date" = DATE '2026-10-03' GROUP BY o."year"
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('dim_calendar'[year], "__rows", COUNTROWS('fct_summary'), "v", 'fct_summary'[Days with output]), ('dim_calendar'[date] = DATE(2026, 10, 3)), NOT(ISBLANK('dim_calendar'[date]))), "year", 'dim_calendar'[year], "v", [v])
