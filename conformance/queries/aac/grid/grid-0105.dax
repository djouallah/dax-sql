// note: the view expander's grid (tools/ossie/grid.mjs), star where many: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o."year", AGG(f."Days with output") AS v FROM aac.fct_summary AS f JOIN aac.dim_calendar AS o ON f."date" = o."date" WHERE f.cutoff IN (TIMESTAMP '2026-08-04 04:00:00', TIMESTAMP '2026-08-08 04:00:00') GROUP BY o."year"
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('dim_calendar'[year], "__rows", COUNTROWS('fct_summary'), "v", 'fct_summary'[Days with output]), ('fct_summary'[cutoff] IN {(DATE(2026, 8, 4) + TIME(4, 0, 0)), (DATE(2026, 8, 8) + TIME(4, 0, 0))}), NOT(ISBLANK('dim_calendar'[date]))), "year", 'dim_calendar'[year], "v", [v])
