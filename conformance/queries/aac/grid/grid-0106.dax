// note: the view expander's grid (tools/ossie/grid.mjs), star two sides: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o."year", f."date", AGG(f."Days with output") AS v FROM aac.fct_summary AS f JOIN aac.dim_calendar AS o ON f."date" = o."date" GROUP BY o."year", f."date"
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('dim_calendar'[year], 'fct_summary'[date], "__rows", COUNTROWS(fct_summary), "v", 'fct_summary'[Days with output]), NOT(ISBLANK('dim_calendar'[date]))), "year", 'dim_calendar'[year], "date", 'fct_summary'[date], "v", [v])
