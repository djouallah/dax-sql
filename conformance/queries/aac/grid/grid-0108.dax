// note: the view expander's grid (tools/ossie/grid.mjs), one side counted once: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.Owner, AGG(f."Available MWh") AS a, AGG(o."Registered units") AS b FROM aac.fct_curtailment AS f LEFT JOIN aac.dim_duid AS o ON f.DUID = o.DUID GROUP BY o.Owner
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('dim_duid'[Owner], "__rows", COUNTROWS('fct_curtailment'), "a", 'fct_curtailment'[Available MWh], "b", CALCULATE('dim_duid'[Registered units], 'fct_curtailment')), "Owner", 'dim_duid'[Owner], "a", [a], "b", [b])
