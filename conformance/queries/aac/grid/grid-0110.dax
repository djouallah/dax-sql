// note: the view expander's grid (tools/ossie/grid.mjs), fan-out: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT f."date", AGG(o."Registered units") AS v FROM aac.fct_curtailment AS f LEFT JOIN aac.dim_duid AS o ON f.DUID = o.DUID GROUP BY f."date"
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('fct_curtailment'[date], "__rows", COUNTROWS('fct_curtailment'), "v", CALCULATE('dim_duid'[Registered units], 'fct_curtailment')), "date", 'fct_curtailment'[date], "v", [v])
