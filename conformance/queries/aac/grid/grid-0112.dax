// note: the view expander's grid (tools/ossie/grid.mjs), chasm: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.State, AGG(a."Storage MWh") AS x, AGG(b."Lowest price") AS y FROM aac.dim_region AS o LEFT JOIN aac.dim_duid AS a ON a.Region = o.Region LEFT JOIN aac.fct_region AS b ON b.REGIONID = o.Region GROUP BY o.State
DEFINE
VAR __v1 = GENERATEALL(GENERATEALL(SELECTCOLUMNS(dim_region, "o.Region", 'dim_region'[Region], "o.State", 'dim_region'[State]), FILTER(SELECTCOLUMNS(dim_duid, "a.DUID", 'dim_duid'[DUID], "a.Region", 'dim_duid'[Region]), ([a.Region] = [o.Region]))), FILTER(SELECTCOLUMNS(fct_region, "b.REGIONID", 'fct_region'[REGIONID], "b.date", 'fct_region'[date], "b.time", 'fct_region'[time], "b.price", 'fct_region'[price], "b.demand", 'fct_region'[demand], "b.net_interchange", 'fct_region'[net_interchange], "b.wind_available", 'fct_region'[wind_available], "b.wind_curtailed", 'fct_region'[wind_curtailed], "b.solar_available", 'fct_region'[solar_available], "b.solar_curtailed", 'fct_region'[solar_curtailed]), ([b.REGIONID] = [o.Region])))
VAR __v2 = DISTINCT(SELECTCOLUMNS(__v1, "State", [o.State]))
EVALUATE SELECTCOLUMNS(ADDCOLUMNS(__v2, "__m1", CALCULATE('dim_duid'[Storage MWh], REMOVEFILTERS(), TREATAS(SELECTCOLUMNS(FILTER(__v1, (NOT(ISBLANK([a.DUID])) && ([o.State] == [State]))), "__k1", [a.DUID]), 'dim_duid'[DUID])), "__m2", CALCULATE('fct_region'[Lowest price], REMOVEFILTERS(), TREATAS(SELECTCOLUMNS(FILTER(__v1, (NOT((((((((((ISBLANK([b.REGIONID]) && ISBLANK([b.date])) && ISBLANK([b.time])) && ISBLANK([b.price])) && ISBLANK([b.demand])) && ISBLANK([b.net_interchange])) && ISBLANK([b.wind_available])) && ISBLANK([b.wind_curtailed])) && ISBLANK([b.solar_available])) && ISBLANK([b.solar_curtailed]))) && ([o.State] == [State]))), "__k1", [b.REGIONID], "__k2", [b.date], "__k3", [b.time], "__k4", [b.price], "__k5", [b.demand], "__k6", [b.net_interchange], "__k7", [b.wind_available], "__k8", [b.wind_curtailed], "__k9", [b.solar_available], "__k10", [b.solar_curtailed]), 'fct_region'[REGIONID], 'fct_region'[date], 'fct_region'[time], 'fct_region'[price], 'fct_region'[demand], 'fct_region'[net_interchange], 'fct_region'[wind_available], 'fct_region'[wind_curtailed], 'fct_region'[solar_available], 'fct_region'[solar_curtailed]))), "State", [State], "x", [__m1], "y", [__m2])
