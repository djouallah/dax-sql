// note: the view expander's grid (tools/ossie/grid.mjs), two metrics: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.DUID, AGG(t."Registered units") AS a, AGG(t."Registered units") AS b FROM aac.dim_duid AS t GROUP BY t.DUID
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('dim_duid'[DUID], "__rows", COUNTROWS('dim_duid'), "a", 'dim_duid'[Registered units], "b", 'dim_duid'[Registered units]), "DUID", 'dim_duid'[DUID], "a", [a], "b", [b])
