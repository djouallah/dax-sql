// note: the view expander's grid (tools/ossie/grid.mjs), two groups: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.DUID, t.Plant, AGG(t."Storage MWh") AS v FROM aac.dim_duid AS t GROUP BY t.DUID, t.Plant
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('dim_duid'[DUID], 'dim_duid'[Plant], "__rows", COUNTROWS(dim_duid), "v", 'dim_duid'[Storage MWh]), "DUID", 'dim_duid'[DUID], "Plant", 'dim_duid'[Plant], "v", [v])
