// note: the view expander's grid (tools/ossie/grid.mjs), where total: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT AGG(t."Registered MW") AS v FROM aac.dim_duid AS t WHERE t.StationName IS NULL
EVALUATE SELECTCOLUMNS(CALCULATETABLE(ROW("v", 'dim_duid'[Registered MW]), ISBLANK('dim_duid'[StationName])), "v", [v])
