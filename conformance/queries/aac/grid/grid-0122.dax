// note: the view expander's grid (tools/ossie/grid.mjs), having null: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.DUID, AGG(t."Storage MWh") AS v FROM aac.dim_duid AS t GROUP BY t.DUID HAVING AGG(t."Registered units") IS NOT NULL
EVALUATE SELECTCOLUMNS(FILTER(SUMMARIZECOLUMNS('dim_duid'[DUID], "__rows", COUNTROWS(dim_duid), "v", 'dim_duid'[Storage MWh]), NOT(ISBLANK('dim_duid'[Registered units]))), "DUID", 'dim_duid'[DUID], "v", [v])
