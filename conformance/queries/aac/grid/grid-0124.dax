// note: the view expander's grid (tools/ossie/grid.mjs), order by measure: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.DUID, AGG(t."Storage MWh") AS v FROM aac.dim_duid AS t GROUP BY t.DUID ORDER BY v DESC NULLS LAST, t.DUID NULLS FIRST
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('dim_duid'[DUID], "__rows", COUNTROWS(dim_duid), "v", 'dim_duid'[Storage MWh]), "DUID", 'dim_duid'[DUID], "v", [v]) ORDER BY [v] DESC, [DUID]
