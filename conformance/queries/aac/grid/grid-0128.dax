// note: the view expander's grid (tools/ossie/grid.mjs), ratio: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.DUID, CAST(AGG(t."Registered units") AS DOUBLE) / NULLIF(AGG(t."Registered MW"), 0) AS r FROM aac.dim_duid AS t GROUP BY t.DUID
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('dim_duid'[DUID], "__rows", COUNTROWS('dim_duid'), "r", IF(ISBLANK(COUNTROWS('dim_duid')), BLANK(), (CONVERT('dim_duid'[Registered units], DOUBLE) / IF(('dim_duid'[Registered MW] == 0), BLANK(), 'dim_duid'[Registered MW])))), "DUID", 'dim_duid'[DUID], "r", [r])
