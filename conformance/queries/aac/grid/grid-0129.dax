// note: the view expander's grid (tools/ossie/grid.mjs), cte: its SQL as dax-sql's SQL front end writes it in DAX:
// WITH s AS (SELECT DUID, "Registered units" AS mm FROM aac.dim_duid WHERE Participant IS NULL) SELECT DUID, AGG(mm) AS v FROM s GROUP BY DUID
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('dim_duid'[DUID], "__rows", COUNTROWS('dim_duid'), "v", 'dim_duid'[Registered units]), ISBLANK('dim_duid'[Participant])), "DUID", 'dim_duid'[DUID], "v", [v])
