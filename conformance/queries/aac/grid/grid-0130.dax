// note: the view expander's grid (tools/ossie/grid.mjs), derived table: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT s.DUID, s.v FROM (SELECT t.DUID, AGG(t."Registered MW") AS v FROM aac.dim_duid AS t GROUP BY t.DUID) AS s WHERE s.v IS NOT NULL
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('dim_duid'[DUID], "__rows", COUNTROWS('dim_duid'), "v", 'dim_duid'[Registered MW]), "DUID", 'dim_duid'[DUID], "v", [v])
