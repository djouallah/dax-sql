// note: the view expander's grid (tools/ossie/grid.mjs), star where many: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o."month", AGG(f."Price seen") AS v FROM aac.fct_summary AS f JOIN aac.dim_calendar AS o ON f."date" = o."date" WHERE f.DUID IS NOT NULL GROUP BY o."month"
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('dim_calendar'[month], "__rows", COUNTROWS(fct_summary), "v", 'fct_summary'[Price seen]), NOT(ISBLANK('fct_summary'[DUID])), NOT(ISBLANK('dim_calendar'[date]))), "month", 'dim_calendar'[month], "v", [v])
