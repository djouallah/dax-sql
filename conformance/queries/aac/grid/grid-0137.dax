// note: the view expander's grid (tools/ossie/grid.mjs), one to many: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.State, AGG(o."Registered MW") AS a, AGG(f."Curtailment rate") AS b FROM aac.dim_duid AS o LEFT JOIN aac.fct_curtailment AS f ON f.DUID = o.DUID GROUP BY o.State
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('dim_duid'[State], "__rows", COUNTROWS('dim_duid'), "a", 'dim_duid'[Registered MW], "b", CALCULATE('fct_curtailment'[Curtailment rate], KEEPFILTERS(NOT(ISBLANK('dim_duid'[DUID]))))), "State", 'dim_duid'[State], "a", [a], "b", [b])
