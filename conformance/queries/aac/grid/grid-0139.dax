// note: the view expander's grid (tools/ossie/grid.mjs), chasm: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.State, AGG(a."Storage MWh") AS x, AGG(b."Wind and solar curtailed MWh") AS y FROM aac.dim_region AS o LEFT JOIN aac.dim_duid AS a ON a.Region = o.Region LEFT JOIN aac.fct_curtailment_region AS b ON b.REGIONID = o.Region GROUP BY o.State
DEFINE
VAR __v1 = GENERATEALL(GENERATEALL(SELECTCOLUMNS(dim_region, "o.Region", 'dim_region'[Region], "o.State", 'dim_region'[State]), FILTER(SELECTCOLUMNS(dim_duid, "a.DUID", 'dim_duid'[DUID], "a.Region", 'dim_duid'[Region]), ([a.Region] = [o.Region]))), FILTER(SELECTCOLUMNS(fct_curtailment_region, "b.REGIONID", 'fct_curtailment_region'[REGIONID], "b.date", 'fct_curtailment_region'[date], "b.fuel", 'fct_curtailment_region'[fuel], "b.curtailed_mwh", 'fct_curtailment_region'[curtailed_mwh], "b.available_mwh", 'fct_curtailment_region'[available_mwh], "b.source", 'fct_curtailment_region'[source]), ([b.REGIONID] = [o.Region])))
VAR __v2 = DISTINCT(SELECTCOLUMNS(__v1, "State", [o.State]))
EVALUATE SELECTCOLUMNS(ADDCOLUMNS(__v2, "__m1", CALCULATE('dim_duid'[Storage MWh], REMOVEFILTERS(), TREATAS(SELECTCOLUMNS(FILTER(__v1, (NOT(ISBLANK([a.DUID])) && ([o.State] == [State]))), "__k1", [a.DUID]), 'dim_duid'[DUID])), "__m2", CALCULATE('fct_curtailment_region'[Wind and solar curtailed MWh], REMOVEFILTERS(), TREATAS(SELECTCOLUMNS(FILTER(__v1, (NOT((((((ISBLANK([b.REGIONID]) && ISBLANK([b.date])) && ISBLANK([b.fuel])) && ISBLANK([b.curtailed_mwh])) && ISBLANK([b.available_mwh])) && ISBLANK([b.source]))) && ([o.State] == [State]))), "__k1", [b.REGIONID], "__k2", [b.date], "__k3", [b.fuel], "__k4", [b.curtailed_mwh], "__k5", [b.available_mwh], "__k6", [b.source]), 'fct_curtailment_region'[REGIONID], 'fct_curtailment_region'[date], 'fct_curtailment_region'[fuel], 'fct_curtailment_region'[curtailed_mwh], 'fct_curtailment_region'[available_mwh], 'fct_curtailment_region'[source]))), "State", [State], "x", [__m1], "y", [__m2])
