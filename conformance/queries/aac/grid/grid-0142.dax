// note: the view expander's grid (tools/ossie/grid.mjs), two metrics: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.Renewable, AGG(t."Registered MW") AS a, AGG(t."Registered MW") AS b FROM aac.dim_duid AS t GROUP BY t.Renewable
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('dim_duid'[Renewable], "__rows", COUNTROWS('dim_duid'), "a", 'dim_duid'[Registered MW], "b", 'dim_duid'[Registered MW]), "Renewable", 'dim_duid'[Renewable], "a", [a], "b", [b])
