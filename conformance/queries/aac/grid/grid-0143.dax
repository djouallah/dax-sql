// note: the view expander's grid (tools/ossie/grid.mjs), two groups: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.Renewable, t.Plant, AGG(t."Registered units") AS v FROM aac.dim_duid AS t GROUP BY t.Renewable, t.Plant
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('dim_duid'[Renewable], 'dim_duid'[Plant], "__rows", COUNTROWS('dim_duid'), "v", 'dim_duid'[Registered units]), "Renewable", 'dim_duid'[Renewable], "Plant", 'dim_duid'[Plant], "v", [v])
