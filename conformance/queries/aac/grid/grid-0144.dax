// note: the view expander's grid (tools/ossie/grid.mjs), where: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.Renewable, AGG(t."Storage MWh") AS v FROM aac.dim_duid AS t WHERE t.Plant <> 'ROOFTOP_NSW1' GROUP BY t.Renewable
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('dim_duid'[Renewable], "__rows", COUNTROWS(dim_duid), "v", 'dim_duid'[Storage MWh]), ('dim_duid'[Plant] <> "ROOFTOP_NSW1")), "Renewable", 'dim_duid'[Renewable], "v", [v])
