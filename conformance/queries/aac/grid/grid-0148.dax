// note: the view expander's grid (tools/ossie/grid.mjs), having: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.Renewable, AGG(t."Registered MW") AS v FROM aac.dim_duid AS t GROUP BY t.Renewable HAVING AGG(t."Registered MW") > 0
EVALUATE SELECTCOLUMNS(FILTER(SUMMARIZECOLUMNS('dim_duid'[Renewable], "__rows", COUNTROWS(dim_duid), "v", 'dim_duid'[Registered MW]), ([v] > 0)), "Renewable", 'dim_duid'[Renewable], "v", [v])
