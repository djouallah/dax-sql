// note: the view expander's grid (tools/ossie/grid.mjs), having null: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.Renewable, AGG(t."Registered units") AS v FROM aac.dim_duid AS t GROUP BY t.Renewable HAVING AGG(t."Registered MW") IS NOT NULL
EVALUATE SELECTCOLUMNS(FILTER(SUMMARIZECOLUMNS('dim_duid'[Renewable], "__rows", COUNTROWS('dim_duid'), "v", 'dim_duid'[Registered units]), NOT(ISBLANK('dim_duid'[Registered MW]))), "Renewable", 'dim_duid'[Renewable], "v", [v])
