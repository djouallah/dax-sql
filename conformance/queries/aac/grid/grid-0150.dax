// note: the view expander's grid (tools/ossie/grid.mjs), order limit: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.Renewable, AGG(t."Storage MWh") AS v FROM aac.dim_duid AS t GROUP BY t.Renewable ORDER BY t.Renewable NULLS FIRST LIMIT 3
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('dim_duid'[Renewable], "__rows", COUNTROWS(dim_duid), "v", 'dim_duid'[Storage MWh]), "Renewable", 'dim_duid'[Renewable], "v", [v]) ORDER BY [Renewable]
