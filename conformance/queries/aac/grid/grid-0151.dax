// note: the view expander's grid (tools/ossie/grid.mjs), order by measure: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.Renewable, AGG(t."Registered units") AS v FROM aac.dim_duid AS t GROUP BY t.Renewable ORDER BY v DESC NULLS LAST, t.Renewable NULLS FIRST
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('dim_duid'[Renewable], "__rows", COUNTROWS(dim_duid), "v", 'dim_duid'[Registered units]), "Renewable", 'dim_duid'[Renewable], "v", [v]) ORDER BY [v] DESC, [Renewable]
