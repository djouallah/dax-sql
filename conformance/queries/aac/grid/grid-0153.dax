// note: the view expander's grid (tools/ossie/grid.mjs), rollup: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.State, AGG(t."Registered units") AS v FROM aac.dim_duid AS t GROUP BY ROLLUP (t.State) ORDER BY t.State NULLS LAST
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS(ROLLUPADDISSUBTOTAL('dim_duid'[State], "__level1_State"), "__rows", COUNTROWS('dim_duid'), "v", 'dim_duid'[Registered units]), "State", 'dim_duid'[State], "v", [v]) ORDER BY ISBLANK([State]), [State]
