// note: the view expander's grid (tools/ossie/grid.mjs), ratio: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.Renewable, CAST(AGG(t."Storage MWh") AS DOUBLE) / NULLIF(AGG(t."Registered units"), 0) AS r FROM aac.dim_duid AS t GROUP BY t.Renewable
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('dim_duid'[Renewable], "__rows", COUNTROWS('dim_duid'), "r", IF(ISBLANK(COUNTROWS('dim_duid')), BLANK(), (CONVERT('dim_duid'[Storage MWh], DOUBLE) / IF(('dim_duid'[Registered units] == 0), BLANK(), 'dim_duid'[Registered units])))), "Renewable", 'dim_duid'[Renewable], "r", [r])
