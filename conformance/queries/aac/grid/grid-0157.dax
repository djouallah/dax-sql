// note: the view expander's grid (tools/ossie/grid.mjs), derived table: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT s.Renewable, s.v FROM (SELECT t.Renewable, AGG(t."Storage MWh") AS v FROM aac.dim_duid AS t GROUP BY t.Renewable) AS s WHERE s.v IS NOT NULL
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('dim_duid'[Renewable], "__rows", COUNTROWS('dim_duid'), "v", 'dim_duid'[Storage MWh]), "Renewable", 'dim_duid'[Renewable], "v", [v])
