// note: the view expander's grid (tools/ossie/grid.mjs), star: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o."month", AGG(f."Price seen") AS v FROM aac.fct_summary AS f LEFT JOIN aac.dim_calendar AS o ON f."date" = o."date" GROUP BY o."month"
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('dim_calendar'[month], "__rows", COUNTROWS('fct_summary'), "v", 'fct_summary'[Price seen]), "month", 'dim_calendar'[month], "v", [v])
