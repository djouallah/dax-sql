// note: the view expander's grid (tools/ossie/grid.mjs), star where many: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o."month", AGG(f."Price seen") AS v FROM aac.fct_summary AS f LEFT JOIN aac.dim_calendar AS o ON f."date" = o."date" WHERE f.price <> -2.9 GROUP BY o."month"
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('dim_calendar'[month], "__rows", COUNTROWS(fct_summary), "v", 'fct_summary'[Price seen]), ('fct_summary'[price] <> (-2.9))), "month", 'dim_calendar'[month], "v", [v])
