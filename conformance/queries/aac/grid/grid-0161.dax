// note: the view expander's grid (tools/ossie/grid.mjs), star two sides: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o."month", f."time", AGG(f."Price seen") AS v FROM aac.fct_summary AS f LEFT JOIN aac.dim_calendar AS o ON f."date" = o."date" GROUP BY o."month", f."time"
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('dim_calendar'[month], 'fct_summary'[time], "__rows", COUNTROWS(fct_summary), "v", 'fct_summary'[Price seen]), "month", 'dim_calendar'[month], "time", 'fct_summary'[time], "v", [v])
