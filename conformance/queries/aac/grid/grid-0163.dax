// note: the view expander's grid (tools/ossie/grid.mjs), one side counted once: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.State, AGG(f."Curtailed MWh") AS a, AGG(o."Registered units") AS b FROM aac.fct_curtailment AS f JOIN aac.dim_duid AS o ON f.DUID = o.DUID GROUP BY o.State
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('dim_duid'[State], "__rows", COUNTROWS(fct_curtailment), "a", 'fct_curtailment'[Curtailed MWh], "b", CALCULATE('dim_duid'[Registered units], fct_curtailment)), NOT(ISBLANK('dim_duid'[DUID]))), "State", 'dim_duid'[State], "a", [a], "b", [b])
