// note: the view expander's grid (tools/ossie/grid.mjs), chasm: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.Region, AGG(a."Registered units") AS x, AGG(b."Lowest daily price") AS y FROM aac.dim_region AS o LEFT JOIN aac.dim_duid AS a ON a.Region = o.Region LEFT JOIN aac.fct_region_daily AS b ON b.REGIONID = o.Region GROUP BY o.Region
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('dim_region'[Region], "__rows", COUNTROWS('dim_region'), "x", CALCULATE('dim_duid'[Registered units], KEEPFILTERS(NOT(ISBLANK('dim_region'[Region])))), "y", CALCULATE('fct_region_daily'[Lowest daily price], KEEPFILTERS(NOT(ISBLANK('dim_region'[Region]))))), "Region", 'dim_region'[Region], "x", [x], "y", [y])
