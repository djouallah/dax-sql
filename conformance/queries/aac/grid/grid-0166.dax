// note: the view expander's grid (tools/ossie/grid.mjs), chasm: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.Region, AGG(a."Registered units") AS x, AGG(b."Lowest daily price") AS y FROM aac.dim_region AS o LEFT JOIN aac.dim_duid AS a ON a.Region = o.Region LEFT JOIN aac.fct_region_daily AS b ON b.REGIONID = o.Region GROUP BY o.Region
DEFINE
VAR __v1 = GENERATEALL(GENERATEALL(SELECTCOLUMNS('dim_region', "o.Region", 'dim_region'[Region]), FILTER(SELECTCOLUMNS('dim_duid', "a.DUID", 'dim_duid'[DUID], "a.Region", 'dim_duid'[Region]), ([a.Region] = [o.Region]))), FILTER(SELECTCOLUMNS('fct_region_daily', "b.REGIONID", 'fct_region_daily'[REGIONID], "b.date", 'fct_region_daily'[date], "b.price", 'fct_region_daily'[price], "b.demand", 'fct_region_daily'[demand], "b.net_interchange", 'fct_region_daily'[net_interchange]), ([b.REGIONID] = [o.Region])))
VAR __v2 = DISTINCT(SELECTCOLUMNS(__v1, "Region", [o.Region]))
EVALUATE SELECTCOLUMNS(ADDCOLUMNS(__v2, "__m1", CALCULATE('dim_duid'[Registered units], REMOVEFILTERS(), TREATAS(SELECTCOLUMNS(FILTER(__v1, (NOT(ISBLANK([a.DUID])) && ([o.Region] == [Region]))), "__k1", [a.DUID]), 'dim_duid'[DUID])), "__m2", CALCULATE('fct_region_daily'[Lowest daily price], REMOVEFILTERS(), TREATAS(SELECTCOLUMNS(FILTER(__v1, (NOT(((((ISBLANK([b.REGIONID]) && ISBLANK([b.date])) && ISBLANK([b.price])) && ISBLANK([b.demand])) && ISBLANK([b.net_interchange]))) && ([o.Region] == [Region]))), "__k1", [b.REGIONID], "__k2", [b.date], "__k3", [b.price], "__k4", [b.demand], "__k5", [b.net_interchange]), 'fct_region_daily'[REGIONID], 'fct_region_daily'[date], 'fct_region_daily'[price], 'fct_region_daily'[demand], 'fct_region_daily'[net_interchange]))), "Region", [Region], "x", [__m1], "y", [__m2])
