// note: the view expander's grid (tools/ossie/grid.mjs), two groups: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t."time", t.cutoff, AGG(t."Average MW") AS v FROM aac.fct_summary AS t GROUP BY t."time", t.cutoff
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('fct_summary'[time], 'fct_summary'[cutoff], "__rows", COUNTROWS('fct_summary'), "v", 'fct_summary'[Average MW]), "time", 'fct_summary'[time], "cutoff", 'fct_summary'[cutoff], "v", [v])
