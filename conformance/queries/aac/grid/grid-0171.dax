// note: the view expander's grid (tools/ossie/grid.mjs), where: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.DUID, AGG(t."Days with output") AS v FROM aac.fct_summary AS t WHERE t.mw IN (524.002, 978.282) GROUP BY t.DUID
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('fct_summary'[DUID], "__rows", COUNTROWS('fct_summary'), "v", 'fct_summary'[Days with output]), ('fct_summary'[mw] IN {524.002, 978.282})), "DUID", 'fct_summary'[DUID], "v", [v])
