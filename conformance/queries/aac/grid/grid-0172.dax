// note: the view expander's grid (tools/ossie/grid.mjs), where and: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.DUID, AGG(t."Average MW") AS v FROM aac.fct_summary AS t WHERE t.cutoff >= TIMESTAMP '2026-08-06 04:00:00' AND t.cutoff >= TIMESTAMP '2026-08-12 19:00:00' GROUP BY t.DUID
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('fct_summary'[DUID], "__rows", COUNTROWS(fct_summary), "v", 'fct_summary'[Average MW]), ('fct_summary'[cutoff] >= (DATE(2026, 8, 6) + TIME(4, 0, 0))), ('fct_summary'[cutoff] >= (DATE(2026, 8, 12) + TIME(19, 0, 0)))), "DUID", 'fct_summary'[DUID], "v", [v])
