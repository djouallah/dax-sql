// note: the view expander's grid (tools/ossie/grid.mjs), where or: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.DUID, AGG(t."Price seen") AS v FROM aac.fct_summary AS t WHERE t.mw < 296.112 OR NOT (t.DUID = 'LYA1') GROUP BY t.DUID
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('fct_summary'[DUID], "__rows", COUNTROWS(fct_summary), "v", 'fct_summary'[Price seen]), (('fct_summary'[mw] < 296.112) || NOT(('fct_summary'[DUID] = "LYA1")))), "DUID", 'fct_summary'[DUID], "v", [v])
