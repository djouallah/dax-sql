// note: the view expander's grid (tools/ossie/grid.mjs), where total: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT AGG(t."Price seen") AS v FROM aac.fct_summary AS t WHERE t."date" <> DATE '2026-08-11'
EVALUATE SELECTCOLUMNS(CALCULATETABLE(ROW("v", 'fct_summary'[Price seen]), ('fct_summary'[date] <> DATE(2026, 8, 11))), "v", [v])
