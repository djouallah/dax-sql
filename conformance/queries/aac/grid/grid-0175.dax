// note: the view expander's grid (tools/ossie/grid.mjs), having: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.DUID, AGG(t."Price seen") AS v FROM aac.fct_summary AS t GROUP BY t.DUID HAVING AGG(t."Price seen") > 0
EVALUATE SELECTCOLUMNS(FILTER(SUMMARIZECOLUMNS('fct_summary'[DUID], "__rows", COUNTROWS(fct_summary), "v", 'fct_summary'[Price seen]), ([v] > 0)), "DUID", 'fct_summary'[DUID], "v", [v])
