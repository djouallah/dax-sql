// note: the view expander's grid (tools/ossie/grid.mjs), having null: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.DUID, AGG(t."Average MW") AS v FROM aac.fct_summary AS t GROUP BY t.DUID HAVING AGG(t."Price seen") IS NOT NULL
EVALUATE SELECTCOLUMNS(FILTER(SUMMARIZECOLUMNS('fct_summary'[DUID], "__rows", COUNTROWS('fct_summary'), "v", 'fct_summary'[Average MW]), NOT(ISBLANK('fct_summary'[Price seen]))), "DUID", 'fct_summary'[DUID], "v", [v])
