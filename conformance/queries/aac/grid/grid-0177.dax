// note: the view expander's grid (tools/ossie/grid.mjs), order limit: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.DUID, AGG(t."Price seen") AS v FROM aac.fct_summary AS t GROUP BY t.DUID ORDER BY t.DUID NULLS FIRST LIMIT 3
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('fct_summary'[DUID], "__rows", COUNTROWS('fct_summary'), "v", 'fct_summary'[Price seen]), "DUID", 'fct_summary'[DUID], "v", [v]) ORDER BY [DUID]
