// note: the view expander's grid (tools/ossie/grid.mjs), scalar ops: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.DUID, AGG(t."Average MW") * 2 AS a, AGG(t."Average MW") + 1 AS b, COALESCE(AGG(t."Average MW"), 0) AS c FROM aac.fct_summary AS t GROUP BY t.DUID
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('fct_summary'[DUID], "__rows", COUNTROWS('fct_summary'), "a", ('fct_summary'[Average MW] * 2), "b", ('fct_summary'[Average MW] + 1), "c", IF(ISBLANK(COUNTROWS('fct_summary')), BLANK(), COALESCE('fct_summary'[Average MW], 0))), "DUID", 'fct_summary'[DUID], "a", [a], "b", [b], "c", [c])
