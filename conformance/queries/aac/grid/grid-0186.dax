// note: the view expander's grid (tools/ossie/grid.mjs), star where one: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.Region, AGG(f."Registered units") AS v FROM aac.dim_duid AS f LEFT JOIN aac.dim_region AS o ON f.Region = o.Region WHERE o.State IN ('Western Australia', 'South Australia') GROUP BY o.Region
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('dim_region'[Region], "__rows", COUNTROWS('dim_duid'), "v", 'dim_duid'[Registered units]), ('dim_region'[State] IN {"Western Australia", "South Australia"})), "Region", 'dim_region'[Region], "v", [v])
