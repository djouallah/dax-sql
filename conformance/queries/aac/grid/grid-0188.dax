// note: the view expander's grid (tools/ossie/grid.mjs), star two sides: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.Region, f.StationName, AGG(f."Registered units") AS v FROM aac.dim_duid AS f LEFT JOIN aac.dim_region AS o ON f.Region = o.Region GROUP BY o.Region, f.StationName
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('dim_region'[Region], 'dim_duid'[StationName], "__rows", COUNTROWS('dim_duid'), "v", 'dim_duid'[Registered units]), "Region", 'dim_region'[Region], "StationName", 'dim_duid'[StationName], "v", [v])
