// note: the view expander's grid (tools/ossie/grid.mjs), star total: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT AGG(f."Registered units") AS v FROM aac.dim_duid AS f JOIN aac.dim_region AS o ON f.Region = o.Region
EVALUATE SELECTCOLUMNS(CALCULATETABLE(ROW("v", 'dim_duid'[Registered units]), NOT(ISBLANK('dim_region'[Region]))), "v", [v])
