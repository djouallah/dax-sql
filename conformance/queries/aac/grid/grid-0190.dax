// note: the view expander's grid (tools/ossie/grid.mjs), one side counted once: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.DUID, AGG(f."Average MWh a day") AS a, AGG(o."Registered units") AS b FROM aac.fct_summary_daily AS f LEFT JOIN aac.dim_duid AS o ON f.DUID = o.DUID GROUP BY o.DUID
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('dim_duid'[DUID], "__rows", COUNTROWS('fct_summary_daily'), "a", 'fct_summary_daily'[Average MWh a day], "b", CALCULATE('dim_duid'[Registered units], 'fct_summary_daily')), "DUID", 'dim_duid'[DUID], "a", [a], "b", [b])
