// note: the view expander's grid (tools/ossie/grid.mjs), chasm: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.Region, AGG(a."Registered MW") AS x, AGG(b."Price at hour") AS y FROM aac.dim_region AS o LEFT JOIN aac.dim_duid AS a ON a.Region = o.Region LEFT JOIN aac.fct_region_hourly AS b ON b.REGIONID = o.Region GROUP BY o.Region
DEFINE
VAR __v1 = GENERATEALL(GENERATEALL(SELECTCOLUMNS(dim_region, "o.Region", 'dim_region'[Region]), FILTER(SELECTCOLUMNS(dim_duid, "a.DUID", 'dim_duid'[DUID], "a.Region", 'dim_duid'[Region]), ([a.Region] = [o.Region]))), FILTER(SELECTCOLUMNS(fct_region_hourly, "b.REGIONID", 'fct_region_hourly'[REGIONID], "b.month", 'fct_region_hourly'[month], "b.hour", 'fct_region_hourly'[hour], "b.price", 'fct_region_hourly'[price], "b.intervals", 'fct_region_hourly'[intervals]), ([b.REGIONID] = [o.Region])))
VAR __v2 = DISTINCT(SELECTCOLUMNS(__v1, "Region", [o.Region]))
EVALUATE SELECTCOLUMNS(ADDCOLUMNS(__v2, "__m1", CALCULATE('dim_duid'[Registered MW], REMOVEFILTERS(), TREATAS(SELECTCOLUMNS(FILTER(__v1, (NOT(ISBLANK([a.DUID])) && ([o.Region] == [Region]))), "__k1", [a.DUID]), 'dim_duid'[DUID])), "__m2", CALCULATE('fct_region_hourly'[Price at hour], REMOVEFILTERS(), TREATAS(SELECTCOLUMNS(FILTER(__v1, (NOT(((((ISBLANK([b.REGIONID]) && ISBLANK([b.month])) && ISBLANK([b.hour])) && ISBLANK([b.price])) && ISBLANK([b.intervals]))) && ([o.Region] == [Region]))), "__k1", [b.REGIONID], "__k2", [b.month], "__k3", [b.hour], "__k4", [b.price], "__k5", [b.intervals]), 'fct_region_hourly'[REGIONID], 'fct_region_hourly'[month], 'fct_region_hourly'[hour], 'fct_region_hourly'[price], 'fct_region_hourly'[intervals]))), "Region", [Region], "x", [__m1], "y", [__m2])
