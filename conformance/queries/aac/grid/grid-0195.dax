// note: the view expander's grid (tools/ossie/grid.mjs), group: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t."time", AGG(t."Average MW") AS v FROM aac.fct_summary AS t GROUP BY t."time"
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('fct_summary'[time], "__rows", COUNTROWS('fct_summary'), "v", 'fct_summary'[Average MW]), "time", 'fct_summary'[time], "v", [v])
