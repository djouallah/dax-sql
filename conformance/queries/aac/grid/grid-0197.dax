// note: the view expander's grid (tools/ossie/grid.mjs), two groups: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t."time", t.DUID, AGG(t."Price seen") AS v FROM aac.fct_summary AS t GROUP BY t."time", t.DUID
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('fct_summary'[time], 'fct_summary'[DUID], "__rows", COUNTROWS('fct_summary'), "v", 'fct_summary'[Price seen]), "time", 'fct_summary'[time], "DUID", 'fct_summary'[DUID], "v", [v])
