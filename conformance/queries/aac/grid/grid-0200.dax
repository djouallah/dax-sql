// note: the view expander's grid (tools/ossie/grid.mjs), where or: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t."time", AGG(t."Days with output") AS v FROM aac.fct_summary AS t WHERE t.cutoff < TIMESTAMP '2026-08-08 04:00:00' OR t."date" = DATE '2026-08-12' GROUP BY t."time"
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('fct_summary'[time], "__rows", COUNTROWS('fct_summary'), "v", 'fct_summary'[Days with output]), (('fct_summary'[cutoff] < (DATE(2026, 8, 8) + TIME(4, 0, 0))) || ('fct_summary'[date] = DATE(2026, 8, 12)))), "time", 'fct_summary'[time], "v", [v])
