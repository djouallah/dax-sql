// note: the view expander's grid (tools/ossie/grid.mjs), where total: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT AGG(t."Price seen") AS v FROM aac.fct_summary AS t WHERE NOT (t.price = 98.77)
EVALUATE SELECTCOLUMNS(CALCULATETABLE(ROW("v", 'fct_summary'[Price seen]), NOT(('fct_summary'[price] = 98.77))), "v", [v])
