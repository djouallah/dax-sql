// note: the view expander's grid (tools/ossie/grid.mjs), having: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t."time", AGG(t."Average MW") AS v FROM aac.fct_summary AS t GROUP BY t."time" HAVING AGG(t."Price seen") > 0
EVALUATE SELECTCOLUMNS(FILTER(SUMMARIZECOLUMNS('fct_summary'[time], "__rows", COUNTROWS('fct_summary'), "v", 'fct_summary'[Average MW]), ('fct_summary'[Price seen] > 0)), "time", 'fct_summary'[time], "v", [v])
