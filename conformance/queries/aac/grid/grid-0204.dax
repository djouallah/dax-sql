// note: the view expander's grid (tools/ossie/grid.mjs), order limit: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t."time", AGG(t."Days with output") AS v FROM aac.fct_summary AS t GROUP BY t."time" ORDER BY t."time" NULLS FIRST LIMIT 3
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('fct_summary'[time], "__rows", COUNTROWS('fct_summary'), "v", 'fct_summary'[Days with output]), "time", 'fct_summary'[time], "v", [v]) ORDER BY [time]
