// note: the view expander's grid (tools/ossie/grid.mjs), rollup: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t."date", AGG(t."Average MW") AS v FROM aac.fct_summary AS t GROUP BY ROLLUP (t."date") ORDER BY t."date" NULLS LAST
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS(ROLLUPADDISSUBTOTAL('fct_summary'[date], "__level1_date"), "__rows", COUNTROWS(fct_summary), "v", 'fct_summary'[Average MW]), "date", 'fct_summary'[date], "v", [v]) ORDER BY ISBLANK([date]), [date]
