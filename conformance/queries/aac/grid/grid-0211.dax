// note: the view expander's grid (tools/ossie/grid.mjs), derived table: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT s."time", s.v FROM (SELECT t."time", AGG(t."Days with output") AS v FROM aac.fct_summary AS t GROUP BY t."time") AS s WHERE s.v IS NOT NULL
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('fct_summary'[time], "__rows", COUNTROWS(fct_summary), "v", 'fct_summary'[Days with output]), "time", 'fct_summary'[time], "v", [v])
