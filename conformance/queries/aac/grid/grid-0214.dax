// note: the view expander's grid (tools/ossie/grid.mjs), star where many: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.Region, AGG(f."Registered MW") AS v FROM aac.dim_duid AS f LEFT JOIN aac.dim_region AS o ON f.Region = o.Region WHERE f.longitude IS NOT NULL GROUP BY o.Region
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('dim_region'[Region], "__rows", COUNTROWS(dim_duid), "v", 'dim_duid'[Registered MW]), NOT(ISBLANK('dim_duid'[longitude]))), "Region", 'dim_region'[Region], "v", [v])
