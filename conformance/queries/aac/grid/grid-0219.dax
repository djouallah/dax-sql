// note: the view expander's grid (tools/ossie/grid.mjs), fan-out: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT f.DUID, AGG(o."Storage MWh") AS v FROM aac.fct_summary_daily AS f LEFT JOIN aac.dim_duid AS o ON f.DUID = o.DUID GROUP BY f.DUID
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('fct_summary_daily'[DUID], "__rows", COUNTROWS('fct_summary_daily'), "v", CALCULATE('dim_duid'[Storage MWh], 'fct_summary_daily')), "DUID", 'fct_summary_daily'[DUID], "v", [v])
