// note: the view expander's grid (tools/ossie/grid.mjs), chasm: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.Region, AGG(a."Regional wind available MWh") AS x, AGG(b."Lowest daily price") AS y FROM aac.dim_region AS o LEFT JOIN aac.fct_region AS a ON a.REGIONID = o.Region LEFT JOIN aac.fct_region_daily AS b ON b.REGIONID = o.Region GROUP BY o.Region
DEFINE
VAR __v1 = GENERATEALL(GENERATEALL(SELECTCOLUMNS('dim_region', "o.Region", 'dim_region'[Region]), FILTER(SELECTCOLUMNS('fct_region', "a.REGIONID", 'fct_region'[REGIONID], "a.date", 'fct_region'[date], "a.time", 'fct_region'[time], "a.price", 'fct_region'[price], "a.demand", 'fct_region'[demand], "a.net_interchange", 'fct_region'[net_interchange], "a.wind_available", 'fct_region'[wind_available], "a.wind_curtailed", 'fct_region'[wind_curtailed], "a.solar_available", 'fct_region'[solar_available], "a.solar_curtailed", 'fct_region'[solar_curtailed]), ([a.REGIONID] = [o.Region]))), FILTER(SELECTCOLUMNS('fct_region_daily', "b.REGIONID", 'fct_region_daily'[REGIONID], "b.date", 'fct_region_daily'[date], "b.price", 'fct_region_daily'[price], "b.demand", 'fct_region_daily'[demand], "b.net_interchange", 'fct_region_daily'[net_interchange]), ([b.REGIONID] = [o.Region])))
VAR __v2 = DISTINCT(SELECTCOLUMNS(__v1, "Region", [o.Region]))
EVALUATE SELECTCOLUMNS(ADDCOLUMNS(__v2, "__m1", CALCULATE('fct_region'[Regional wind available MWh], REMOVEFILTERS(), TREATAS(SELECTCOLUMNS(FILTER(__v1, (NOT((((((((((ISBLANK([a.REGIONID]) && ISBLANK([a.date])) && ISBLANK([a.time])) && ISBLANK([a.price])) && ISBLANK([a.demand])) && ISBLANK([a.net_interchange])) && ISBLANK([a.wind_available])) && ISBLANK([a.wind_curtailed])) && ISBLANK([a.solar_available])) && ISBLANK([a.solar_curtailed]))) && ([o.Region] == [Region]))), "__k1", [a.REGIONID], "__k2", [a.date], "__k3", [a.time], "__k4", [a.price], "__k5", [a.demand], "__k6", [a.net_interchange], "__k7", [a.wind_available], "__k8", [a.wind_curtailed], "__k9", [a.solar_available], "__k10", [a.solar_curtailed]), 'fct_region'[REGIONID], 'fct_region'[date], 'fct_region'[time], 'fct_region'[price], 'fct_region'[demand], 'fct_region'[net_interchange], 'fct_region'[wind_available], 'fct_region'[wind_curtailed], 'fct_region'[solar_available], 'fct_region'[solar_curtailed])), "__m2", CALCULATE('fct_region_daily'[Lowest daily price], REMOVEFILTERS(), TREATAS(SELECTCOLUMNS(FILTER(__v1, (NOT(((((ISBLANK([b.REGIONID]) && ISBLANK([b.date])) && ISBLANK([b.price])) && ISBLANK([b.demand])) && ISBLANK([b.net_interchange]))) && ([o.Region] == [Region]))), "__k1", [b.REGIONID], "__k2", [b.date], "__k3", [b.price], "__k4", [b.demand], "__k5", [b.net_interchange]), 'fct_region_daily'[REGIONID], 'fct_region_daily'[date], 'fct_region_daily'[price], 'fct_region_daily'[demand], 'fct_region_daily'[net_interchange]))), "Region", [Region], "x", [__m1], "y", [__m2])
