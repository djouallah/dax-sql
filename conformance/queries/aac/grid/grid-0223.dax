// note: the view expander's grid (tools/ossie/grid.mjs), two metrics: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t."time", AGG(t."Price seen") AS a, AGG(t."Days with output") AS b FROM aac.fct_summary AS t GROUP BY t."time"
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('fct_summary'[time], "__rows", COUNTROWS('fct_summary'), "a", 'fct_summary'[Price seen], "b", 'fct_summary'[Days with output]), "time", 'fct_summary'[time], "a", [a], "b", [b])
