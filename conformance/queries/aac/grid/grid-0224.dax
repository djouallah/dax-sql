// note: the view expander's grid (tools/ossie/grid.mjs), two groups: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.DUID, t."time", AGG(t."Price seen") AS v FROM aac.fct_summary AS t GROUP BY t.DUID, t."time"
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('fct_summary'[DUID], 'fct_summary'[time], "__rows", COUNTROWS(fct_summary), "v", 'fct_summary'[Price seen]), "DUID", 'fct_summary'[DUID], "time", 'fct_summary'[time], "v", [v])
