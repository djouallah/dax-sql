// note: the view expander's grid (tools/ossie/grid.mjs), where and: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t."time", AGG(t."Price seen") AS v FROM aac.fct_summary AS t WHERE t.mw IN (497.459, 2.965) AND t.mw >= 0.513 GROUP BY t."time"
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('fct_summary'[time], "__rows", COUNTROWS('fct_summary'), "v", 'fct_summary'[Price seen]), ('fct_summary'[mw] IN {497.459, 2.965}), ('fct_summary'[mw] >= 0.513)), "time", 'fct_summary'[time], "v", [v])
