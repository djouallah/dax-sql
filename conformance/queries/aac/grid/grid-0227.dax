// note: the view expander's grid (tools/ossie/grid.mjs), where or: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t."time", AGG(t."Average MW") AS v FROM aac.fct_summary AS t WHERE t.DUID = 'ROOFTOP_SA1' OR t."time" <> 1200 GROUP BY t."time"
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('fct_summary'[time], "__rows", COUNTROWS('fct_summary'), "v", 'fct_summary'[Average MW]), (('fct_summary'[DUID] = "ROOFTOP_SA1") || ('fct_summary'[time] <> 1200))), "time", 'fct_summary'[time], "v", [v])
