// note: the view expander's grid (tools/ossie/grid.mjs), where total: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT AGG(t."Average MW") AS v FROM aac.fct_summary AS t WHERE t.cutoff IS NOT NULL
EVALUATE SELECTCOLUMNS(CALCULATETABLE(ROW("v", 'fct_summary'[Average MW]), NOT(ISBLANK('fct_summary'[cutoff]))), "v", [v])
