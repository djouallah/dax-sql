// note: the view expander's grid (tools/ossie/grid.mjs), group by all: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.DUID, AGG(t."Average MW") AS v FROM aac.fct_summary AS t GROUP BY ALL
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('fct_summary'[DUID], "__rows", COUNTROWS('fct_summary'), "v", 'fct_summary'[Average MW]), "DUID", 'fct_summary'[DUID], "v", [v])
