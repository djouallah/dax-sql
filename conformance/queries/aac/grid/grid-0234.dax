// note: the view expander's grid (tools/ossie/grid.mjs), rollup: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.DUID, AGG(t."Days with output") AS v FROM aac.fct_summary AS t GROUP BY ROLLUP (t.DUID) ORDER BY t.DUID NULLS LAST
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS(ROLLUPADDISSUBTOTAL('fct_summary'[DUID], "__level1_DUID"), "__rows", COUNTROWS(fct_summary), "v", 'fct_summary'[Days with output]), "DUID", 'fct_summary'[DUID], "v", [v]) ORDER BY ISBLANK([DUID]), [DUID]
