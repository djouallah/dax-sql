// note: the view expander's grid (tools/ossie/grid.mjs), star where one: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.Region, AGG(f."Storage MWh") AS v FROM aac.dim_duid AS f JOIN aac.dim_region AS o ON f.Region = o.Region WHERE o.Region <> 'WA1' GROUP BY o.Region
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('dim_region'[Region], "__rows", COUNTROWS(dim_duid), "v", 'dim_duid'[Storage MWh]), ('dim_region'[Region] <> "WA1"), NOT(ISBLANK('dim_region'[Region]))), "Region", 'dim_region'[Region], "v", [v])
