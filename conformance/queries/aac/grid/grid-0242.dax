// note: the view expander's grid (tools/ossie/grid.mjs), star two sides: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.Region, f.Owner, AGG(f."Registered MW") AS v FROM aac.dim_duid AS f JOIN aac.dim_region AS o ON f.Region = o.Region GROUP BY o.Region, f.Owner
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('dim_region'[Region], 'dim_duid'[Owner], "__rows", COUNTROWS('dim_duid'), "v", 'dim_duid'[Registered MW]), NOT(ISBLANK('dim_region'[Region]))), "Region", 'dim_region'[Region], "Owner", 'dim_duid'[Owner], "v", [v])
