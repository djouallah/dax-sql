// note: the view expander's grid (tools/ossie/grid.mjs), star total: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT AGG(f."Lowest price") AS v FROM aac.fct_region AS f JOIN aac.dim_region AS o ON f.REGIONID = o.Region
EVALUATE SELECTCOLUMNS(CALCULATETABLE(ROW("v", 'fct_region'[Lowest price]), NOT(ISBLANK('dim_region'[Region]))), "v", [v])
