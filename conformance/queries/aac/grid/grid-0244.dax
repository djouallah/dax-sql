// note: the view expander's grid (tools/ossie/grid.mjs), one side counted once: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.Renewable, AGG(f."Average MWh a day") AS a, AGG(o."Storage MWh") AS b FROM aac.fct_summary_daily AS f LEFT JOIN aac.dim_duid AS o ON f.DUID = o.DUID GROUP BY o.Renewable
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('dim_duid'[Renewable], "__rows", COUNTROWS(fct_summary_daily), "a", 'fct_summary_daily'[Average MWh a day], "b", CALCULATE('dim_duid'[Storage MWh], fct_summary_daily)), "Renewable", 'dim_duid'[Renewable], "a", [a], "b", [b])
