// note: the view expander's grid (tools/ossie/grid.mjs), fan-out: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT f.DUID, AGG(o."Registered units") AS v FROM aac.fct_summary_hourly AS f LEFT JOIN aac.dim_duid AS o ON f.DUID = o.DUID GROUP BY f.DUID
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('fct_summary_hourly'[DUID], "__rows", COUNTROWS(fct_summary_hourly), "v", CALCULATE('dim_duid'[Registered units], fct_summary_hourly)), "DUID", 'fct_summary_hourly'[DUID], "v", [v])
