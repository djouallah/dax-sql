// note: the view expander's grid (tools/ossie/grid.mjs), chasm: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.Region, AGG(a."Lowest price") AS x, AGG(b."Price at hour") AS y FROM aac.dim_region AS o LEFT JOIN aac.fct_region AS a ON a.REGIONID = o.Region LEFT JOIN aac.fct_region_hourly AS b ON b.REGIONID = o.Region GROUP BY o.Region
DEFINE
VAR __v1 = GENERATEALL(GENERATEALL(SELECTCOLUMNS('dim_region', "o.Region", 'dim_region'[Region]), FILTER(SELECTCOLUMNS('fct_region', "a.REGIONID", 'fct_region'[REGIONID], "a.date", 'fct_region'[date], "a.time", 'fct_region'[time], "a.price", 'fct_region'[price], "a.demand", 'fct_region'[demand], "a.net_interchange", 'fct_region'[net_interchange], "a.wind_available", 'fct_region'[wind_available], "a.wind_curtailed", 'fct_region'[wind_curtailed], "a.solar_available", 'fct_region'[solar_available], "a.solar_curtailed", 'fct_region'[solar_curtailed]), ([a.REGIONID] = [o.Region]))), FILTER(SELECTCOLUMNS('fct_region_hourly', "b.REGIONID", 'fct_region_hourly'[REGIONID], "b.month", 'fct_region_hourly'[month], "b.hour", 'fct_region_hourly'[hour], "b.price", 'fct_region_hourly'[price], "b.intervals", 'fct_region_hourly'[intervals]), ([b.REGIONID] = [o.Region])))
VAR __v2 = DISTINCT(SELECTCOLUMNS(__v1, "Region", [o.Region]))
EVALUATE SELECTCOLUMNS(ADDCOLUMNS(__v2, "__m1", CALCULATE('fct_region'[Lowest price], REMOVEFILTERS(), TREATAS(SELECTCOLUMNS(FILTER(__v1, (NOT((((((((((ISBLANK([a.REGIONID]) && ISBLANK([a.date])) && ISBLANK([a.time])) && ISBLANK([a.price])) && ISBLANK([a.demand])) && ISBLANK([a.net_interchange])) && ISBLANK([a.wind_available])) && ISBLANK([a.wind_curtailed])) && ISBLANK([a.solar_available])) && ISBLANK([a.solar_curtailed]))) && ([o.Region] == [Region]))), "__k1", [a.REGIONID], "__k2", [a.date], "__k3", [a.time], "__k4", [a.price], "__k5", [a.demand], "__k6", [a.net_interchange], "__k7", [a.wind_available], "__k8", [a.wind_curtailed], "__k9", [a.solar_available], "__k10", [a.solar_curtailed]), 'fct_region'[REGIONID], 'fct_region'[date], 'fct_region'[time], 'fct_region'[price], 'fct_region'[demand], 'fct_region'[net_interchange], 'fct_region'[wind_available], 'fct_region'[wind_curtailed], 'fct_region'[solar_available], 'fct_region'[solar_curtailed])), "__m2", CALCULATE('fct_region_hourly'[Price at hour], REMOVEFILTERS(), TREATAS(SELECTCOLUMNS(FILTER(__v1, (NOT(((((ISBLANK([b.REGIONID]) && ISBLANK([b.month])) && ISBLANK([b.hour])) && ISBLANK([b.price])) && ISBLANK([b.intervals]))) && ([o.Region] == [Region]))), "__k1", [b.REGIONID], "__k2", [b.month], "__k3", [b.hour], "__k4", [b.price], "__k5", [b.intervals]), 'fct_region_hourly'[REGIONID], 'fct_region_hourly'[month], 'fct_region_hourly'[hour], 'fct_region_hourly'[price], 'fct_region_hourly'[intervals]))), "Region", [Region], "x", [__m1], "y", [__m2])
