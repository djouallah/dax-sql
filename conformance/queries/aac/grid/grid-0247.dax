// note: the view expander's grid (tools/ossie/grid.mjs), chasm: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.Region, AGG(a."Lowest price") AS x, AGG(b."Price at hour") AS y FROM aac.dim_region AS o LEFT JOIN aac.fct_region AS a ON a.REGIONID = o.Region LEFT JOIN aac.fct_region_hourly AS b ON b.REGIONID = o.Region GROUP BY o.Region
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('dim_region'[Region], "__rows", COUNTROWS('dim_region'), "x", CALCULATE('fct_region'[Lowest price], KEEPFILTERS(NOT(ISBLANK('dim_region'[Region])))), "y", CALCULATE('fct_region_hourly'[Price at hour], KEEPFILTERS(NOT(ISBLANK('dim_region'[Region]))))), "Region", 'dim_region'[Region], "x", [x], "y", [y])
