// note: the view expander's grid (tools/ossie/grid.mjs), two metrics: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.DUID, AGG(t."Average MW") AS a, AGG(t."Average MW") AS b FROM aac.fct_summary AS t GROUP BY t.DUID
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('fct_summary'[DUID], "__rows", COUNTROWS('fct_summary'), "a", 'fct_summary'[Average MW], "b", 'fct_summary'[Average MW]), "DUID", 'fct_summary'[DUID], "a", [a], "b", [b])
