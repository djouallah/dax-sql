// note: the view expander's grid (tools/ossie/grid.mjs), two groups: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t."date", t.DUID, AGG(t."Price seen") AS v FROM aac.fct_summary AS t GROUP BY t."date", t.DUID
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('fct_summary'[date], 'fct_summary'[DUID], "__rows", COUNTROWS(fct_summary), "v", 'fct_summary'[Price seen]), "date", 'fct_summary'[date], "DUID", 'fct_summary'[DUID], "v", [v])
