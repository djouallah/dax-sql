// note: the view expander's grid (tools/ossie/grid.mjs), where: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.DUID, AGG(t."Average MW") AS v FROM aac.fct_summary AS t WHERE t.mw BETWEEN -147.42 AND 484.875 GROUP BY t.DUID
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('fct_summary'[DUID], "__rows", COUNTROWS('fct_summary'), "v", 'fct_summary'[Average MW]), (('fct_summary'[mw] >= (-147.42)) && ('fct_summary'[mw] <= 484.875))), "DUID", 'fct_summary'[DUID], "v", [v])
