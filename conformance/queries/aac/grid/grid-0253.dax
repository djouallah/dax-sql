// note: the view expander's grid (tools/ossie/grid.mjs), where and: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.DUID, AGG(t."Price seen") AS v FROM aac.fct_summary AS t WHERE t."date" < DATE '2026-08-05' AND t."time" = 1200 GROUP BY t.DUID
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('fct_summary'[DUID], "__rows", COUNTROWS('fct_summary'), "v", 'fct_summary'[Price seen]), ('fct_summary'[date] < DATE(2026, 8, 5)), ('fct_summary'[time] = 1200)), "DUID", 'fct_summary'[DUID], "v", [v])
