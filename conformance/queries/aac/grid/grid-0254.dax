// note: the view expander's grid (tools/ossie/grid.mjs), where or: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.DUID, AGG(t."Price seen") AS v FROM aac.fct_summary AS t WHERE t.mw BETWEEN -147.42 AND 962.144 OR NOT (t.price = 57.74) GROUP BY t.DUID
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('fct_summary'[DUID], "__rows", COUNTROWS('fct_summary'), "v", 'fct_summary'[Price seen]), ((('fct_summary'[mw] >= (-147.42)) && ('fct_summary'[mw] <= 962.144)) || NOT(('fct_summary'[price] = 57.74)))), "DUID", 'fct_summary'[DUID], "v", [v])
