// note: the view expander's grid (tools/ossie/grid.mjs), where total: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT AGG(t."Average MW") AS v FROM aac.fct_summary AS t WHERE t.price <> 2387.18
EVALUATE SELECTCOLUMNS(CALCULATETABLE(ROW("v", 'fct_summary'[Average MW]), ('fct_summary'[price] <> 2387.18)), "v", [v])
