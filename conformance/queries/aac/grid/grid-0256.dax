// note: the view expander's grid (tools/ossie/grid.mjs), having: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t."date", AGG(t."Average MW") AS v FROM aac.fct_summary AS t GROUP BY t."date" HAVING AGG(t."Price seen") > 0
EVALUATE SELECTCOLUMNS(FILTER(SUMMARIZECOLUMNS('fct_summary'[date], "__rows", COUNTROWS(fct_summary), "v", 'fct_summary'[Average MW]), ('fct_summary'[Price seen] > 0)), "date", 'fct_summary'[date], "v", [v])
