// note: the view expander's grid (tools/ossie/grid.mjs), having null: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t."date", AGG(t."Average MW") AS v FROM aac.fct_summary AS t GROUP BY t."date" HAVING AGG(t."Days with output") IS NOT NULL
EVALUATE SELECTCOLUMNS(FILTER(SUMMARIZECOLUMNS('fct_summary'[date], "__rows", COUNTROWS(fct_summary), "v", 'fct_summary'[Average MW]), NOT(ISBLANK('fct_summary'[Days with output]))), "date", 'fct_summary'[date], "v", [v])
