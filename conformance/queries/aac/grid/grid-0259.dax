// note: the view expander's grid (tools/ossie/grid.mjs), order by measure: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.DUID, AGG(t."Average MW") AS v FROM aac.fct_summary AS t GROUP BY t.DUID ORDER BY v DESC NULLS LAST, t.DUID NULLS FIRST
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('fct_summary'[DUID], "__rows", COUNTROWS(fct_summary), "v", 'fct_summary'[Average MW]), "DUID", 'fct_summary'[DUID], "v", [v]) ORDER BY [v] DESC, [DUID]
