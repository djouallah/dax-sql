// note: the view expander's grid (tools/ossie/grid.mjs), rollup: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.cutoff, AGG(t."Average MW") AS v FROM aac.fct_summary AS t GROUP BY ROLLUP (t.cutoff) ORDER BY t.cutoff NULLS LAST
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS(ROLLUPADDISSUBTOTAL('fct_summary'[cutoff], "__level1_cutoff"), "__rows", COUNTROWS('fct_summary'), "v", 'fct_summary'[Average MW]), "cutoff", 'fct_summary'[cutoff], "v", [v]) ORDER BY ISBLANK([cutoff]), [cutoff]
