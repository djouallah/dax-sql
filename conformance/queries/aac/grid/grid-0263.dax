// note: the view expander's grid (tools/ossie/grid.mjs), ratio: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.DUID, CAST(AGG(t."Average MW") AS DOUBLE) / NULLIF(AGG(t."Average MW"), 0) AS r FROM aac.fct_summary AS t GROUP BY t.DUID
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('fct_summary'[DUID], "__rows", COUNTROWS(fct_summary), "r", IF(ISBLANK(COUNTROWS(fct_summary)), BLANK(), (CONVERT('fct_summary'[Average MW], DOUBLE) / IF(('fct_summary'[Average MW] == 0), BLANK(), 'fct_summary'[Average MW])))), "DUID", 'fct_summary'[DUID], "r", [r])
