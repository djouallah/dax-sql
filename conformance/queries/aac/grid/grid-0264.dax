// note: the view expander's grid (tools/ossie/grid.mjs), cte: its SQL as dax-sql's SQL front end writes it in DAX:
// WITH s AS (SELECT DUID, "Price seen" AS mm FROM aac.fct_summary WHERE cutoff = TIMESTAMP '2026-08-10 04:00:00') SELECT DUID, AGG(mm) AS v FROM s GROUP BY DUID
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('fct_summary'[DUID], "__rows", COUNTROWS(fct_summary), "v", 'fct_summary'[Price seen]), ('fct_summary'[cutoff] = (DATE(2026, 8, 10) + TIME(4, 0, 0)))), "DUID", 'fct_summary'[DUID], "v", [v])
