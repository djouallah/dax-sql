// note: the view expander's grid (tools/ossie/grid.mjs), star where many: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.Region, AGG(f."Regional solar curtailed MWh") AS v FROM aac.fct_region AS f LEFT JOIN aac.dim_region AS o ON f.REGIONID = o.Region WHERE f.solar_curtailed BETWEEN 0 AND 69.91 GROUP BY o.Region
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('dim_region'[Region], "__rows", COUNTROWS(fct_region), "v", 'fct_region'[Regional solar curtailed MWh]), (('fct_region'[solar_curtailed] >= 0) && ('fct_region'[solar_curtailed] <= 69.91))), "Region", 'dim_region'[Region], "v", [v])
