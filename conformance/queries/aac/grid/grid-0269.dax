// note: the view expander's grid (tools/ossie/grid.mjs), star two sides: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.Region, f.REGIONID, AGG(f."Regional solar available MWh") AS v FROM aac.fct_region AS f LEFT JOIN aac.dim_region AS o ON f.REGIONID = o.Region GROUP BY o.Region, f.REGIONID
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('dim_region'[Region], 'fct_region'[REGIONID], "__rows", COUNTROWS('fct_region'), "v", 'fct_region'[Regional solar available MWh]), "Region", 'dim_region'[Region], "REGIONID", 'fct_region'[REGIONID], "v", [v])
