// note: the view expander's grid (tools/ossie/grid.mjs), one side counted once: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.Participant, AGG(f."Output MWh hourly") AS a, AGG(o."Registered units") AS b FROM aac.fct_summary_hourly AS f LEFT JOIN aac.dim_duid AS o ON f.DUID = o.DUID GROUP BY o.Participant
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('dim_duid'[Participant], "__rows", COUNTROWS(fct_summary_hourly), "a", 'fct_summary_hourly'[Output MWh hourly], "b", CALCULATE('dim_duid'[Registered units], fct_summary_hourly)), "Participant", 'dim_duid'[Participant], "a", [a], "b", [b])
