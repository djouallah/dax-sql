// note: the view expander's grid (tools/ossie/grid.mjs), one to many: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.State, AGG(o."Registered units") AS a, AGG(f."Output MWh hourly") AS b FROM aac.dim_duid AS o LEFT JOIN aac.fct_summary_hourly AS f ON f.DUID = o.DUID GROUP BY o.State
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('dim_duid'[State], "__rows", COUNTROWS(dim_duid), "a", 'dim_duid'[Registered units], "b", CALCULATE('fct_summary_hourly'[Output MWh hourly], KEEPFILTERS(NOT(ISBLANK('dim_duid'[DUID]))))), "State", 'dim_duid'[State], "a", [a], "b", [b])
