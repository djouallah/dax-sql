// note: the view expander's grid (tools/ossie/grid.mjs), chasm: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o."year", AGG(a."Regional solar curtailed MWh") AS x, AGG(b."Days with output") AS y FROM aac.dim_calendar AS o LEFT JOIN aac.fct_region AS a ON a."date" = o."date" LEFT JOIN aac.fct_summary AS b ON b."date" = o."date" GROUP BY o."year"
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('dim_calendar'[year], "__rows", COUNTROWS('dim_calendar'), "x", CALCULATE('fct_region'[Regional solar curtailed MWh], KEEPFILTERS(NOT(ISBLANK('dim_calendar'[date])))), "y", CALCULATE('fct_summary'[Days with output], KEEPFILTERS(NOT(ISBLANK('dim_calendar'[date]))))), "year", 'dim_calendar'[year], "x", [x], "y", [y])
