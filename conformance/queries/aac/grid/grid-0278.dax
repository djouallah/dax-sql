// note: the view expander's grid (tools/ossie/grid.mjs), two groups: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t."date", t.REGIONID, AGG(t."Regional solar available MWh") AS v FROM aac.fct_region AS t GROUP BY t."date", t.REGIONID
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('fct_region'[date], 'fct_region'[REGIONID], "__rows", COUNTROWS(fct_region), "v", 'fct_region'[Regional solar available MWh]), "date", 'fct_region'[date], "REGIONID", 'fct_region'[REGIONID], "v", [v])
