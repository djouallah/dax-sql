// note: the view expander's grid (tools/ossie/grid.mjs), where: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t."date", AGG(t."Days with output") AS v FROM aac.fct_summary AS t WHERE t.cutoff IS NOT NULL GROUP BY t."date"
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('fct_summary'[date], "__rows", COUNTROWS('fct_summary'), "v", 'fct_summary'[Days with output]), NOT(ISBLANK('fct_summary'[cutoff]))), "date", 'fct_summary'[date], "v", [v])
