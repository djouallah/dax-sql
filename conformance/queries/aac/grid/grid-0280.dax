// note: the view expander's grid (tools/ossie/grid.mjs), where and: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t."date", AGG(t."Days with output") AS v FROM aac.fct_summary AS t WHERE t.cutoff IN (TIMESTAMP '2026-08-07 04:00:00', TIMESTAMP '2026-08-13 04:00:00') AND t.price >= 23.43 GROUP BY t."date"
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('fct_summary'[date], "__rows", COUNTROWS('fct_summary'), "v", 'fct_summary'[Days with output]), ('fct_summary'[cutoff] IN {(DATE(2026, 8, 7) + TIME(4, 0, 0)), (DATE(2026, 8, 13) + TIME(4, 0, 0))}), ('fct_summary'[price] >= 23.43)), "date", 'fct_summary'[date], "v", [v])
