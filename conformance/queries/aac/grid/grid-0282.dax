// note: the view expander's grid (tools/ossie/grid.mjs), where total: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT AGG(t."Average MW") AS v FROM aac.fct_summary AS t WHERE t.price BETWEEN -38.76 AND 44.87
EVALUATE SELECTCOLUMNS(CALCULATETABLE(ROW("v", 'fct_summary'[Average MW]), (('fct_summary'[price] >= (-38.76)) && ('fct_summary'[price] <= 44.87))), "v", [v])
