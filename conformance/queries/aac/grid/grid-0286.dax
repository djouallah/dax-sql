// note: the view expander's grid (tools/ossie/grid.mjs), order by measure: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t."date", AGG(t."Average MW") AS v FROM aac.fct_summary AS t GROUP BY t."date" ORDER BY v DESC NULLS LAST, t."date" NULLS FIRST
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('fct_summary'[date], "__rows", COUNTROWS(fct_summary), "v", 'fct_summary'[Average MW]), "date", 'fct_summary'[date], "v", [v]) ORDER BY [v] DESC, [date]
