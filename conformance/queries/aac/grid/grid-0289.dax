// note: the view expander's grid (tools/ossie/grid.mjs), scalar ops: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t."date", AGG(t."Price seen") * 2 AS a, AGG(t."Price seen") + 1 AS b, COALESCE(AGG(t."Price seen"), 0) AS c FROM aac.fct_summary AS t GROUP BY t."date"
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('fct_summary'[date], "__rows", COUNTROWS(fct_summary), "a", ('fct_summary'[Price seen] * 2), "b", ('fct_summary'[Price seen] + 1), "c", IF(ISBLANK(COUNTROWS(fct_summary)), BLANK(), COALESCE('fct_summary'[Price seen], 0))), "date", 'fct_summary'[date], "a", [a], "b", [b], "c", [c])
