// note: the view expander's grid (tools/ossie/grid.mjs), ratio: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t."date", CAST(AGG(t."Average MW") AS DOUBLE) / NULLIF(AGG(t."Days with output"), 0) AS r FROM aac.fct_summary AS t GROUP BY t."date"
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('fct_summary'[date], "__rows", COUNTROWS(fct_summary), "r", IF(ISBLANK(COUNTROWS(fct_summary)), BLANK(), (CONVERT('fct_summary'[Average MW], DOUBLE) / IF(('fct_summary'[Days with output] == 0), BLANK(), 'fct_summary'[Days with output])))), "date", 'fct_summary'[date], "r", [r])
