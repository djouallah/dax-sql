// note: the view expander's grid (tools/ossie/grid.mjs), cte: its SQL as dax-sql's SQL front end writes it in DAX:
// WITH s AS (SELECT "date", "Days with output" AS mm FROM aac.fct_summary WHERE DUID IS NOT NULL) SELECT "date", AGG(mm) AS v FROM s GROUP BY "date"
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('fct_summary'[date], "__rows", COUNTROWS('fct_summary'), "v", 'fct_summary'[Days with output]), NOT(ISBLANK('fct_summary'[DUID]))), "date", 'fct_summary'[date], "v", [v])
