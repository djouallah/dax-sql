// note: the view expander's grid (tools/ossie/grid.mjs), derived table: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT s."date", s.v FROM (SELECT t."date", AGG(t."Days with output") AS v FROM aac.fct_summary AS t GROUP BY t."date") AS s WHERE s.v IS NOT NULL
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('fct_summary'[date], "__rows", COUNTROWS('fct_summary'), "v", 'fct_summary'[Days with output]), "date", 'fct_summary'[date], "v", [v])
