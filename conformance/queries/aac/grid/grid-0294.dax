// note: the view expander's grid (tools/ossie/grid.mjs), star where one: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.State, AGG(f."Lowest price") AS v FROM aac.fct_region AS f JOIN aac.dim_region AS o ON f.REGIONID = o.Region WHERE NOT (o.Region = 'SA1') GROUP BY o.State
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('dim_region'[State], "__rows", COUNTROWS('fct_region'), "v", 'fct_region'[Lowest price]), NOT(('dim_region'[Region] = "SA1")), NOT(ISBLANK('dim_region'[Region]))), "State", 'dim_region'[State], "v", [v])
