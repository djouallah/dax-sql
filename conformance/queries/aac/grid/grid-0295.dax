// note: the view expander's grid (tools/ossie/grid.mjs), star where many: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.State, AGG(f."Regional wind available MWh") AS v FROM aac.fct_region AS f JOIN aac.dim_region AS o ON f.REGIONID = o.Region WHERE f.price = 111.6 GROUP BY o.State
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('dim_region'[State], "__rows", COUNTROWS('fct_region'), "v", 'fct_region'[Regional wind available MWh]), ('fct_region'[price] = 111.6), NOT(ISBLANK('dim_region'[Region]))), "State", 'dim_region'[State], "v", [v])
