// note: the view expander's grid (tools/ossie/grid.mjs), star two sides: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.State, f."time", AGG(f."Regional solar curtailed MWh") AS v FROM aac.fct_region AS f JOIN aac.dim_region AS o ON f.REGIONID = o.Region GROUP BY o.State, f."time"
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('dim_region'[State], 'fct_region'[time], "__rows", COUNTROWS('fct_region'), "v", 'fct_region'[Regional solar curtailed MWh]), NOT(ISBLANK('dim_region'[Region]))), "State", 'dim_region'[State], "time", 'fct_region'[time], "v", [v])
