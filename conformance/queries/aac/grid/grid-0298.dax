// note: the view expander's grid (tools/ossie/grid.mjs), one side counted once: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.State, AGG(f."Output MWh hourly") AS a, AGG(o."Storage MWh") AS b FROM aac.fct_summary_hourly AS f LEFT JOIN aac.dim_duid AS o ON f.DUID = o.DUID GROUP BY o.State
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('dim_duid'[State], "__rows", COUNTROWS('fct_summary_hourly'), "a", 'fct_summary_hourly'[Output MWh hourly], "b", CALCULATE('dim_duid'[Storage MWh], 'fct_summary_hourly')), "State", 'dim_duid'[State], "a", [a], "b", [b])
