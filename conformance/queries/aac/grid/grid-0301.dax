// note: the view expander's grid (tools/ossie/grid.mjs), chasm: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o."year", AGG(a."Regional wind curtailed MWh") AS x, AGG(b."Average MWh a day") AS y FROM aac.dim_calendar AS o LEFT JOIN aac.fct_region AS a ON a."date" = o."date" LEFT JOIN aac.fct_summary_daily AS b ON b."date" = o."date" GROUP BY o."year"
DEFINE
VAR __v1 = GENERATEALL(GENERATEALL(SELECTCOLUMNS(dim_calendar, "o.date", 'dim_calendar'[date], "o.year", 'dim_calendar'[year]), FILTER(SELECTCOLUMNS(fct_region, "a.REGIONID", 'fct_region'[REGIONID], "a.date", 'fct_region'[date], "a.time", 'fct_region'[time], "a.price", 'fct_region'[price], "a.demand", 'fct_region'[demand], "a.net_interchange", 'fct_region'[net_interchange], "a.wind_available", 'fct_region'[wind_available], "a.wind_curtailed", 'fct_region'[wind_curtailed], "a.solar_available", 'fct_region'[solar_available], "a.solar_curtailed", 'fct_region'[solar_curtailed]), ([a.date] = [o.date]))), FILTER(SELECTCOLUMNS(fct_summary_daily, "b.DUID", 'fct_summary_daily'[DUID], "b.date", 'fct_summary_daily'[date], "b.mwh", 'fct_summary_daily'[mwh], "b.price", 'fct_summary_daily'[price], "b.output_mwh", 'fct_summary_daily'[output_mwh], "b.charging_mwh", 'fct_summary_daily'[charging_mwh], "b.revenue", 'fct_summary_daily'[revenue]), ([b.date] = [o.date])))
VAR __v2 = DISTINCT(SELECTCOLUMNS(__v1, "year", [o.year]))
EVALUATE SELECTCOLUMNS(ADDCOLUMNS(__v2, "__m1", CALCULATE('fct_region'[Regional wind curtailed MWh], REMOVEFILTERS(), TREATAS(SELECTCOLUMNS(FILTER(__v1, (NOT((((((((((ISBLANK([a.REGIONID]) && ISBLANK([a.date])) && ISBLANK([a.time])) && ISBLANK([a.price])) && ISBLANK([a.demand])) && ISBLANK([a.net_interchange])) && ISBLANK([a.wind_available])) && ISBLANK([a.wind_curtailed])) && ISBLANK([a.solar_available])) && ISBLANK([a.solar_curtailed]))) && ([o.year] == [year]))), "__k1", [a.REGIONID], "__k2", [a.date], "__k3", [a.time], "__k4", [a.price], "__k5", [a.demand], "__k6", [a.net_interchange], "__k7", [a.wind_available], "__k8", [a.wind_curtailed], "__k9", [a.solar_available], "__k10", [a.solar_curtailed]), 'fct_region'[REGIONID], 'fct_region'[date], 'fct_region'[time], 'fct_region'[price], 'fct_region'[demand], 'fct_region'[net_interchange], 'fct_region'[wind_available], 'fct_region'[wind_curtailed], 'fct_region'[solar_available], 'fct_region'[solar_curtailed])), "__m2", CALCULATE('fct_summary_daily'[Average MWh a day], REMOVEFILTERS(), TREATAS(SELECTCOLUMNS(FILTER(__v1, (NOT(((((((ISBLANK([b.DUID]) && ISBLANK([b.date])) && ISBLANK([b.mwh])) && ISBLANK([b.price])) && ISBLANK([b.output_mwh])) && ISBLANK([b.charging_mwh])) && ISBLANK([b.revenue]))) && ([o.year] == [year]))), "__k1", [b.DUID], "__k2", [b.date], "__k3", [b.mwh], "__k4", [b.price], "__k5", [b.output_mwh], "__k6", [b.charging_mwh], "__k7", [b.revenue]), 'fct_summary_daily'[DUID], 'fct_summary_daily'[date], 'fct_summary_daily'[mwh], 'fct_summary_daily'[price], 'fct_summary_daily'[output_mwh], 'fct_summary_daily'[charging_mwh], 'fct_summary_daily'[revenue]))), "year", [year], "x", [__m1], "y", [__m2])
