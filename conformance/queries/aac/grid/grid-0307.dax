// note: the view expander's grid (tools/ossie/grid.mjs), where and: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t."date", AGG(t."Days with output") AS v FROM aac.fct_summary AS t WHERE NOT (t."date" = DATE '2026-08-11') AND t.price <> 105.52 GROUP BY t."date"
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('fct_summary'[date], "__rows", COUNTROWS(fct_summary), "v", 'fct_summary'[Days with output]), NOT(('fct_summary'[date] = DATE(2026, 8, 11))), ('fct_summary'[price] <> 105.52)), "date", 'fct_summary'[date], "v", [v])
