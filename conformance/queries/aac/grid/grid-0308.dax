// note: the view expander's grid (tools/ossie/grid.mjs), where or: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t."date", AGG(t."Days with output") AS v FROM aac.fct_summary AS t WHERE t.price IN (-20.25, 105.87) OR t.price >= -36.87 GROUP BY t."date"
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('fct_summary'[date], "__rows", COUNTROWS('fct_summary'), "v", 'fct_summary'[Days with output]), (('fct_summary'[price] IN {(-20.25), 105.87}) || ('fct_summary'[price] >= (-36.87)))), "date", 'fct_summary'[date], "v", [v])
