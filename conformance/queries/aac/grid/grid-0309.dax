// note: the view expander's grid (tools/ossie/grid.mjs), where total: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT AGG(t."Days with output") AS v FROM aac.fct_summary AS t WHERE NOT (t."time" = 1900)
EVALUATE SELECTCOLUMNS(CALCULATETABLE(ROW("v", 'fct_summary'[Days with output]), NOT(('fct_summary'[time] = 1900))), "v", [v])
