// note: the view expander's grid (tools/ossie/grid.mjs), order limit: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t."date", AGG(t."Regional wind curtailed MWh") AS v FROM aac.fct_region AS t GROUP BY t."date" ORDER BY t."date" NULLS FIRST LIMIT 3
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('fct_region'[date], "__rows", COUNTROWS('fct_region'), "v", 'fct_region'[Regional wind curtailed MWh]), "date", 'fct_region'[date], "v", [v]) ORDER BY [date]
