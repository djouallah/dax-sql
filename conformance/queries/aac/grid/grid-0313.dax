// note: the view expander's grid (tools/ossie/grid.mjs), order by measure: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t."date", AGG(t."Regional solar available MWh") AS v FROM aac.fct_region AS t GROUP BY t."date" ORDER BY v DESC NULLS LAST, t."date" NULLS FIRST
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('fct_region'[date], "__rows", COUNTROWS(fct_region), "v", 'fct_region'[Regional solar available MWh]), "date", 'fct_region'[date], "v", [v]) ORDER BY [v] DESC, [date]
