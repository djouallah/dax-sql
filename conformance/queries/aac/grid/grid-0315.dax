// note: the view expander's grid (tools/ossie/grid.mjs), rollup: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t."date", AGG(t."Regional solar available MWh") AS v FROM aac.fct_region AS t GROUP BY ROLLUP (t."date") ORDER BY t."date" NULLS LAST
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS(ROLLUPADDISSUBTOTAL('fct_region'[date], "__level1_date"), "__rows", COUNTROWS('fct_region'), "v", 'fct_region'[Regional solar available MWh]), "date", 'fct_region'[date], "v", [v]) ORDER BY ISBLANK([date]), [date]
