// note: the view expander's grid (tools/ossie/grid.mjs), cte: its SQL as dax-sql's SQL front end writes it in DAX:
// WITH s AS (SELECT "date", "Average MW" AS mm FROM aac.fct_summary WHERE DUID = 'ROOFTOP_QLD1') SELECT "date", AGG(mm) AS v FROM s GROUP BY "date"
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('fct_summary'[date], "__rows", COUNTROWS(fct_summary), "v", 'fct_summary'[Average MW]), ('fct_summary'[DUID] = "ROOFTOP_QLD1")), "date", 'fct_summary'[date], "v", [v])
