// note: the view expander's grid (tools/ossie/grid.mjs), star: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.Region, AGG(f."Regional wind available MWh") AS v FROM aac.fct_region AS f LEFT JOIN aac.dim_region AS o ON f.REGIONID = o.Region GROUP BY o.Region
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('dim_region'[Region], "__rows", COUNTROWS('fct_region'), "v", 'fct_region'[Regional wind available MWh]), "Region", 'dim_region'[Region], "v", [v])
