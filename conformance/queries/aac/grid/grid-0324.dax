// note: the view expander's grid (tools/ossie/grid.mjs), star total: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT AGG(f."Regional wind available MWh") AS v FROM aac.fct_region AS f JOIN aac.dim_calendar AS o ON f."date" = o."date"
EVALUATE SELECTCOLUMNS(CALCULATETABLE(ROW("v", 'fct_region'[Regional wind available MWh]), NOT(ISBLANK('dim_calendar'[date]))), "v", [v])
