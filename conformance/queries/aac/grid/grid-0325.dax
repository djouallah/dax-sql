// note: the view expander's grid (tools/ossie/grid.mjs), one side counted once: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.Renewable, AGG(f."Output MWh hourly") AS a, AGG(o."Registered MW") AS b FROM aac.fct_summary_hourly AS f JOIN aac.dim_duid AS o ON f.DUID = o.DUID GROUP BY o.Renewable
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('dim_duid'[Renewable], "__rows", COUNTROWS('fct_summary_hourly'), "a", 'fct_summary_hourly'[Output MWh hourly], "b", CALCULATE('dim_duid'[Registered MW], 'fct_summary_hourly')), NOT(ISBLANK('dim_duid'[DUID]))), "Renewable", 'dim_duid'[Renewable], "a", [a], "b", [b])
