// note: the view expander's grid (tools/ossie/grid.mjs), chasm: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o."year", AGG(a."Regional wind available MWh") AS x, AGG(b."Lowest daily price") AS y FROM aac.dim_calendar AS o LEFT JOIN aac.fct_region AS a ON a."date" = o."date" LEFT JOIN aac.fct_region_daily AS b ON b."date" = o."date" GROUP BY o."year"
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('dim_calendar'[year], "__rows", COUNTROWS('dim_calendar'), "x", CALCULATE('fct_region'[Regional wind available MWh], KEEPFILTERS(NOT(ISBLANK('dim_calendar'[date])))), "y", CALCULATE('fct_region_daily'[Lowest daily price], KEEPFILTERS(NOT(ISBLANK('dim_calendar'[date]))))), "year", 'dim_calendar'[year], "x", [x], "y", [y])
