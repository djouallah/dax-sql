// note: the view expander's grid (tools/ossie/grid.mjs), two groups: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.REGIONID, t."time", AGG(t."Regional wind curtailed MWh") AS v FROM aac.fct_region AS t GROUP BY t.REGIONID, t."time"
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('fct_region'[REGIONID], 'fct_region'[time], "__rows", COUNTROWS('fct_region'), "v", 'fct_region'[Regional wind curtailed MWh]), "REGIONID", 'fct_region'[REGIONID], "time", 'fct_region'[time], "v", [v])
