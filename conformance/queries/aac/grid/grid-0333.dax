// note: the view expander's grid (tools/ossie/grid.mjs), where: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t."date", AGG(t."Regional solar curtailed MWh") AS v FROM aac.fct_region AS t WHERE t.wind_curtailed >= 5.83 GROUP BY t."date"
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('fct_region'[date], "__rows", COUNTROWS('fct_region'), "v", 'fct_region'[Regional solar curtailed MWh]), ('fct_region'[wind_curtailed] >= 5.83)), "date", 'fct_region'[date], "v", [v])
