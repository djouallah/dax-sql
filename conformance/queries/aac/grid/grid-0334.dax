// note: the view expander's grid (tools/ossie/grid.mjs), where and: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t."date", AGG(t."Lowest price") AS v FROM aac.fct_region AS t WHERE t.demand IN (6169.77, 1077.18) AND t.wind_curtailed IS NULL GROUP BY t."date"
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('fct_region'[date], "__rows", COUNTROWS('fct_region'), "v", 'fct_region'[Lowest price]), ('fct_region'[demand] IN {6169.77, 1077.18}), ISBLANK('fct_region'[wind_curtailed])), "date", 'fct_region'[date], "v", [v])
