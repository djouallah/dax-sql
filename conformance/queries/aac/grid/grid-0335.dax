// note: the view expander's grid (tools/ossie/grid.mjs), where or: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t."date", AGG(t."Lowest price") AS v FROM aac.fct_region AS t WHERE t."date" = DATE '2026-08-05' OR t.solar_curtailed < 23.48 GROUP BY t."date"
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('fct_region'[date], "__rows", COUNTROWS(fct_region), "v", 'fct_region'[Lowest price]), (('fct_region'[date] = DATE(2026, 8, 5)) || ('fct_region'[solar_curtailed] < 23.48))), "date", 'fct_region'[date], "v", [v])
