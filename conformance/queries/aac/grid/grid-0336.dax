// note: the view expander's grid (tools/ossie/grid.mjs), where total: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT AGG(t."Regional solar available MWh") AS v FROM aac.fct_region AS t WHERE t.net_interchange = 775.97
EVALUATE SELECTCOLUMNS(CALCULATETABLE(ROW("v", 'fct_region'[Regional solar available MWh]), ('fct_region'[net_interchange] = 775.97)), "v", [v])
