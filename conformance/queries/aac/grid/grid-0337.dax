// note: the view expander's grid (tools/ossie/grid.mjs), having: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t."date", AGG(t."Regional wind available MWh") AS v FROM aac.fct_region AS t GROUP BY t."date" HAVING AGG(t."Regional wind available MWh") > 0
EVALUATE SELECTCOLUMNS(FILTER(SUMMARIZECOLUMNS('fct_region'[date], "__rows", COUNTROWS('fct_region'), "v", 'fct_region'[Regional wind available MWh]), ([v] > 0)), "date", 'fct_region'[date], "v", [v])
