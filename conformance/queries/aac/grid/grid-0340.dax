// note: the view expander's grid (tools/ossie/grid.mjs), order by measure: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t."time", AGG(t."Regional wind available MWh") AS v FROM aac.fct_region AS t GROUP BY t."time" ORDER BY v DESC NULLS LAST, t."time" NULLS FIRST
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('fct_region'[time], "__rows", COUNTROWS(fct_region), "v", 'fct_region'[Regional wind available MWh]), "time", 'fct_region'[time], "v", [v]) ORDER BY [v] DESC, [time]
