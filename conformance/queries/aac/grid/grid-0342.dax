// note: the view expander's grid (tools/ossie/grid.mjs), rollup: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.REGIONID, AGG(t."Regional solar available MWh") AS v FROM aac.fct_region AS t GROUP BY ROLLUP (t.REGIONID) ORDER BY t.REGIONID NULLS LAST
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS(ROLLUPADDISSUBTOTAL('fct_region'[REGIONID], "__level1_REGIONID"), "__rows", COUNTROWS(fct_region), "v", 'fct_region'[Regional solar available MWh]), "REGIONID", 'fct_region'[REGIONID], "v", [v]) ORDER BY ISBLANK([REGIONID]), [REGIONID]
