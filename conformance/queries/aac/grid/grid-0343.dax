// note: the view expander's grid (tools/ossie/grid.mjs), scalar ops: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t."date", AGG(t."Regional solar curtailed MWh") * 2 AS a, AGG(t."Regional solar curtailed MWh") + 1 AS b, COALESCE(AGG(t."Regional solar curtailed MWh"), 0) AS c FROM aac.fct_region AS t GROUP BY t."date"
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('fct_region'[date], "__rows", COUNTROWS(fct_region), "a", ('fct_region'[Regional solar curtailed MWh] * 2), "b", ('fct_region'[Regional solar curtailed MWh] + 1), "c", IF(ISBLANK(COUNTROWS(fct_region)), BLANK(), COALESCE('fct_region'[Regional solar curtailed MWh], 0))), "date", 'fct_region'[date], "a", [a], "b", [b], "c", [c])
