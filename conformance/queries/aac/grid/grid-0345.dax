// note: the view expander's grid (tools/ossie/grid.mjs), cte: its SQL as dax-sql's SQL front end writes it in DAX:
// WITH s AS (SELECT "date", "Regional solar curtailed MWh" AS mm FROM aac.fct_region WHERE solar_available IN (4873.38, 681.67)) SELECT "date", AGG(mm) AS v FROM s GROUP BY "date"
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('fct_region'[date], "__rows", COUNTROWS(fct_region), "v", 'fct_region'[Regional solar curtailed MWh]), ('fct_region'[solar_available] IN {4873.38, 681.67})), "date", 'fct_region'[date], "v", [v])
