// note: the view expander's grid (tools/ossie/grid.mjs), star where one: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o."year", AGG(f."Regional wind available MWh") AS v FROM aac.fct_region AS f LEFT JOIN aac.dim_calendar AS o ON f."date" = o."date" WHERE o."month" IS NOT NULL GROUP BY o."year"
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('dim_calendar'[year], "__rows", COUNTROWS('fct_region'), "v", 'fct_region'[Regional wind available MWh]), NOT(ISBLANK('dim_calendar'[month]))), "year", 'dim_calendar'[year], "v", [v])
