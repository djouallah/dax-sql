// note: the view expander's grid (tools/ossie/grid.mjs), star where many: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o."year", AGG(f."Regional solar available MWh") AS v FROM aac.fct_region AS f LEFT JOIN aac.dim_calendar AS o ON f."date" = o."date" WHERE f.solar_curtailed IS NOT NULL GROUP BY o."year"
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('dim_calendar'[year], "__rows", COUNTROWS('fct_region'), "v", 'fct_region'[Regional solar available MWh]), NOT(ISBLANK('fct_region'[solar_curtailed]))), "year", 'dim_calendar'[year], "v", [v])
