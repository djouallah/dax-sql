// note: the view expander's grid (tools/ossie/grid.mjs), fan-out: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT f."hour", AGG(o."Month days") AS v FROM aac.fct_summary_hourly AS f LEFT JOIN aac.dim_month AS o ON f."month" = o."month" GROUP BY f."hour"
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('fct_summary_hourly'[hour], "__rows", COUNTROWS('fct_summary_hourly'), "v", CALCULATE('dim_month'[Month days], 'fct_summary_hourly')), "hour", 'fct_summary_hourly'[hour], "v", [v])
