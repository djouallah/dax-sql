// note: the view expander's grid (tools/ossie/grid.mjs), chasm: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o."year", AGG(a."Flow MW") AS x, AGG(b."Price seen") AS y FROM aac.dim_calendar AS o LEFT JOIN aac.fct_interconnector AS a ON a."date" = o."date" LEFT JOIN aac.fct_summary AS b ON b."date" = o."date" GROUP BY o."year"
DEFINE
VAR __v1 = GENERATEALL(GENERATEALL(SELECTCOLUMNS(dim_calendar, "o.date", 'dim_calendar'[date], "o.year", 'dim_calendar'[year]), FILTER(SELECTCOLUMNS(fct_interconnector, "a.interconnector", 'fct_interconnector'[interconnector], "a.date", 'fct_interconnector'[date], "a.time", 'fct_interconnector'[time], "a.mw", 'fct_interconnector'[mw], "a.export_limit", 'fct_interconnector'[export_limit], "a.import_limit", 'fct_interconnector'[import_limit]), ([a.date] = [o.date]))), FILTER(SELECTCOLUMNS(fct_summary, "b.date", 'fct_summary'[date], "b.time", 'fct_summary'[time], "b.DUID", 'fct_summary'[DUID], "b.mw", 'fct_summary'[mw], "b.price", 'fct_summary'[price], "b.cutoff", 'fct_summary'[cutoff]), ([b.date] = [o.date])))
VAR __v2 = DISTINCT(SELECTCOLUMNS(__v1, "year", [o.year]))
EVALUATE SELECTCOLUMNS(ADDCOLUMNS(__v2, "__m1", CALCULATE('fct_interconnector'[Flow MW], REMOVEFILTERS(), TREATAS(SELECTCOLUMNS(FILTER(__v1, (NOT((((((ISBLANK([a.interconnector]) && ISBLANK([a.date])) && ISBLANK([a.time])) && ISBLANK([a.mw])) && ISBLANK([a.export_limit])) && ISBLANK([a.import_limit]))) && ([o.year] == [year]))), "__k1", [a.interconnector], "__k2", [a.date], "__k3", [a.time], "__k4", [a.mw], "__k5", [a.export_limit], "__k6", [a.import_limit]), 'fct_interconnector'[interconnector], 'fct_interconnector'[date], 'fct_interconnector'[time], 'fct_interconnector'[mw], 'fct_interconnector'[export_limit], 'fct_interconnector'[import_limit])), "__m2", CALCULATE('fct_summary'[Price seen], REMOVEFILTERS(), TREATAS(SELECTCOLUMNS(FILTER(__v1, (NOT((((((ISBLANK([b.date]) && ISBLANK([b.time])) && ISBLANK([b.DUID])) && ISBLANK([b.mw])) && ISBLANK([b.price])) && ISBLANK([b.cutoff]))) && ([o.year] == [year]))), "__k1", [b.date], "__k2", [b.time], "__k3", [b.DUID], "__k4", [b.mw], "__k5", [b.price], "__k6", [b.cutoff]), 'fct_summary'[date], 'fct_summary'[time], 'fct_summary'[DUID], 'fct_summary'[mw], 'fct_summary'[price], 'fct_summary'[cutoff]))), "year", [year], "x", [__m1], "y", [__m2])
