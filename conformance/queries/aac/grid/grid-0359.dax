// note: the view expander's grid (tools/ossie/grid.mjs), two groups: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.interconnector, t."time", AGG(t."Flow MW") AS v FROM aac.fct_interconnector AS t GROUP BY t.interconnector, t."time"
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('fct_interconnector'[interconnector], 'fct_interconnector'[time], "__rows", COUNTROWS(fct_interconnector), "v", 'fct_interconnector'[Flow MW]), "interconnector", 'fct_interconnector'[interconnector], "time", 'fct_interconnector'[time], "v", [v])
