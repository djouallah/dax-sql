// note: the view expander's grid (tools/ossie/grid.mjs), where: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t."date", AGG(t."Lowest price") AS v FROM aac.fct_region AS t WHERE t.wind_curtailed >= 2.68 GROUP BY t."date"
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('fct_region'[date], "__rows", COUNTROWS('fct_region'), "v", 'fct_region'[Lowest price]), ('fct_region'[wind_curtailed] >= 2.68)), "date", 'fct_region'[date], "v", [v])
