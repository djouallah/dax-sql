// note: the view expander's grid (tools/ossie/grid.mjs), where total: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT AGG(t."Regional solar curtailed MWh") AS v FROM aac.fct_region AS t WHERE t.wind_curtailed IS NOT NULL
EVALUATE SELECTCOLUMNS(CALCULATETABLE(ROW("v", 'fct_region'[Regional solar curtailed MWh]), NOT(ISBLANK('fct_region'[wind_curtailed]))), "v", [v])
