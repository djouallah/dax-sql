// note: the view expander's grid (tools/ossie/grid.mjs), having null: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t."time", AGG(t."Regional wind curtailed MWh") AS v FROM aac.fct_region AS t GROUP BY t."time" HAVING AGG(t."Regional wind available MWh") IS NOT NULL
EVALUATE SELECTCOLUMNS(FILTER(SUMMARIZECOLUMNS('fct_region'[time], "__rows", COUNTROWS(fct_region), "v", 'fct_region'[Regional wind curtailed MWh]), NOT(ISBLANK('fct_region'[Regional wind available MWh]))), "time", 'fct_region'[time], "v", [v])
