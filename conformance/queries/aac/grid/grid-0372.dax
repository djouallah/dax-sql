// note: the view expander's grid (tools/ossie/grid.mjs), cte: its SQL as dax-sql's SQL front end writes it in DAX:
// WITH s AS (SELECT "date", "Regional solar curtailed MWh" AS mm FROM aac.fct_region WHERE NOT (wind_curtailed = 4.33)) SELECT "date", AGG(mm) AS v FROM s GROUP BY "date"
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('fct_region'[date], "__rows", COUNTROWS(fct_region), "v", 'fct_region'[Regional solar curtailed MWh]), NOT(('fct_region'[wind_curtailed] = 4.33))), "date", 'fct_region'[date], "v", [v])
