// note: the view expander's grid (tools/ossie/grid.mjs), derived table: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT s."date", s.v FROM (SELECT t."date", AGG(t."Regional solar curtailed MWh") AS v FROM aac.fct_region AS t GROUP BY t."date") AS s WHERE s.v IS NOT NULL
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('fct_region'[date], "__rows", COUNTROWS('fct_region'), "v", 'fct_region'[Regional solar curtailed MWh]), "date", 'fct_region'[date], "v", [v])
