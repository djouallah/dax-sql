// note: the view expander's grid (tools/ossie/grid.mjs), star: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o."month", AGG(f."Regional solar available MWh") AS v FROM aac.fct_region AS f JOIN aac.dim_calendar AS o ON f."date" = o."date" GROUP BY o."month"
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('dim_calendar'[month], "__rows", COUNTROWS('fct_region'), "v", 'fct_region'[Regional solar available MWh]), NOT(ISBLANK('dim_calendar'[date]))), "month", 'dim_calendar'[month], "v", [v])
