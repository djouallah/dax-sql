// note: the view expander's grid (tools/ossie/grid.mjs), star two sides: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o."month", f."date", AGG(f."Lowest price") AS v FROM aac.fct_region AS f JOIN aac.dim_calendar AS o ON f."date" = o."date" GROUP BY o."month", f."date"
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('dim_calendar'[month], 'fct_region'[date], "__rows", COUNTROWS(fct_region), "v", 'fct_region'[Lowest price]), NOT(ISBLANK('dim_calendar'[date]))), "month", 'dim_calendar'[month], "date", 'fct_region'[date], "v", [v])
