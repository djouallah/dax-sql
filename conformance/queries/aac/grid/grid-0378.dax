// note: the view expander's grid (tools/ossie/grid.mjs), star total: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT AGG(f."Flow MW") AS v FROM aac.fct_interconnector AS f JOIN aac.dim_calendar AS o ON f."date" = o."date"
EVALUATE SELECTCOLUMNS(CALCULATETABLE(ROW("v", 'fct_interconnector'[Flow MW]), NOT(ISBLANK('dim_calendar'[date]))), "v", [v])
