// note: the view expander's grid (tools/ossie/grid.mjs), chasm: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o."month", AGG(a."Flow MW") AS x, AGG(b."Regional wind available MWh") AS y FROM aac.dim_calendar AS o LEFT JOIN aac.fct_interconnector AS a ON a."date" = o."date" LEFT JOIN aac.fct_region AS b ON b."date" = o."date" GROUP BY o."month"
DEFINE
VAR __v1 = GENERATEALL(GENERATEALL(SELECTCOLUMNS('dim_calendar', "o.date", 'dim_calendar'[date], "o.month", 'dim_calendar'[month]), FILTER(SELECTCOLUMNS('fct_interconnector', "a.interconnector", 'fct_interconnector'[interconnector], "a.date", 'fct_interconnector'[date], "a.time", 'fct_interconnector'[time], "a.mw", 'fct_interconnector'[mw], "a.export_limit", 'fct_interconnector'[export_limit], "a.import_limit", 'fct_interconnector'[import_limit]), ([a.date] = [o.date]))), FILTER(SELECTCOLUMNS('fct_region', "b.REGIONID", 'fct_region'[REGIONID], "b.date", 'fct_region'[date], "b.time", 'fct_region'[time], "b.price", 'fct_region'[price], "b.demand", 'fct_region'[demand], "b.net_interchange", 'fct_region'[net_interchange], "b.wind_available", 'fct_region'[wind_available], "b.wind_curtailed", 'fct_region'[wind_curtailed], "b.solar_available", 'fct_region'[solar_available], "b.solar_curtailed", 'fct_region'[solar_curtailed]), ([b.date] = [o.date])))
VAR __v2 = DISTINCT(SELECTCOLUMNS(__v1, "month", [o.month]))
EVALUATE SELECTCOLUMNS(ADDCOLUMNS(__v2, "__m1", CALCULATE('fct_interconnector'[Flow MW], REMOVEFILTERS(), TREATAS(SELECTCOLUMNS(FILTER(__v1, (NOT((((((ISBLANK([a.interconnector]) && ISBLANK([a.date])) && ISBLANK([a.time])) && ISBLANK([a.mw])) && ISBLANK([a.export_limit])) && ISBLANK([a.import_limit]))) && ([o.month] == [month]))), "__k1", [a.interconnector], "__k2", [a.date], "__k3", [a.time], "__k4", [a.mw], "__k5", [a.export_limit], "__k6", [a.import_limit]), 'fct_interconnector'[interconnector], 'fct_interconnector'[date], 'fct_interconnector'[time], 'fct_interconnector'[mw], 'fct_interconnector'[export_limit], 'fct_interconnector'[import_limit])), "__m2", CALCULATE('fct_region'[Regional wind available MWh], REMOVEFILTERS(), TREATAS(SELECTCOLUMNS(FILTER(__v1, (NOT((((((((((ISBLANK([b.REGIONID]) && ISBLANK([b.date])) && ISBLANK([b.time])) && ISBLANK([b.price])) && ISBLANK([b.demand])) && ISBLANK([b.net_interchange])) && ISBLANK([b.wind_available])) && ISBLANK([b.wind_curtailed])) && ISBLANK([b.solar_available])) && ISBLANK([b.solar_curtailed]))) && ([o.month] == [month]))), "__k1", [b.REGIONID], "__k2", [b.date], "__k3", [b.time], "__k4", [b.price], "__k5", [b.demand], "__k6", [b.net_interchange], "__k7", [b.wind_available], "__k8", [b.wind_curtailed], "__k9", [b.solar_available], "__k10", [b.solar_curtailed]), 'fct_region'[REGIONID], 'fct_region'[date], 'fct_region'[time], 'fct_region'[price], 'fct_region'[demand], 'fct_region'[net_interchange], 'fct_region'[wind_available], 'fct_region'[wind_curtailed], 'fct_region'[solar_available], 'fct_region'[solar_curtailed]))), "month", [month], "x", [__m1], "y", [__m2])
