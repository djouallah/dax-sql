// note: the view expander's grid (tools/ossie/grid.mjs), group: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t."time", AGG(t."Regional solar available MWh") AS v FROM aac.fct_region AS t GROUP BY t."time"
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('fct_region'[time], "__rows", COUNTROWS(fct_region), "v", 'fct_region'[Regional solar available MWh]), "time", 'fct_region'[time], "v", [v])
