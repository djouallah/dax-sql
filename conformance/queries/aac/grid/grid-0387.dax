// note: the view expander's grid (tools/ossie/grid.mjs), where: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t."date", AGG(t."Lowest price") AS v FROM aac.fct_region AS t WHERE t.net_interchange BETWEEN -797.78 AND 57.89 GROUP BY t."date"
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('fct_region'[date], "__rows", COUNTROWS('fct_region'), "v", 'fct_region'[Lowest price]), (('fct_region'[net_interchange] >= (-797.78)) && ('fct_region'[net_interchange] <= 57.89))), "date", 'fct_region'[date], "v", [v])
