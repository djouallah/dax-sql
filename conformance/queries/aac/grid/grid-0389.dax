// note: the view expander's grid (tools/ossie/grid.mjs), where or: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t."date", AGG(t."Regional wind available MWh") AS v FROM aac.fct_region AS t WHERE t.solar_available BETWEEN 0 AND 3247.87 OR t.solar_curtailed IS NOT NULL GROUP BY t."date"
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('fct_region'[date], "__rows", COUNTROWS(fct_region), "v", 'fct_region'[Regional wind available MWh]), ((('fct_region'[solar_available] >= 0) && ('fct_region'[solar_available] <= 3247.87)) || NOT(ISBLANK('fct_region'[solar_curtailed])))), "date", 'fct_region'[date], "v", [v])
