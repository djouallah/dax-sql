// note: the view expander's grid (tools/ossie/grid.mjs), where total: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT AGG(t."Regional wind available MWh") AS v FROM aac.fct_region AS t WHERE t.REGIONID IS NOT NULL
EVALUATE SELECTCOLUMNS(CALCULATETABLE(ROW("v", 'fct_region'[Regional wind available MWh]), NOT(ISBLANK('fct_region'[REGIONID]))), "v", [v])
