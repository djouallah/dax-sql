// note: the view expander's grid (tools/ossie/grid.mjs), having: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t."time", AGG(t."Lowest price") AS v FROM aac.fct_region AS t GROUP BY t."time" HAVING AGG(t."Regional wind curtailed MWh") > 0
EVALUATE SELECTCOLUMNS(FILTER(SUMMARIZECOLUMNS('fct_region'[time], "__rows", COUNTROWS(fct_region), "v", 'fct_region'[Lowest price]), ('fct_region'[Regional wind curtailed MWh] > 0)), "time", 'fct_region'[time], "v", [v])
