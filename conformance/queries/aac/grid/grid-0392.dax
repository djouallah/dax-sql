// note: the view expander's grid (tools/ossie/grid.mjs), having null: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.REGIONID, AGG(t."Regional solar available MWh") AS v FROM aac.fct_region AS t GROUP BY t.REGIONID HAVING AGG(t."Regional wind available MWh") IS NOT NULL
EVALUATE SELECTCOLUMNS(FILTER(SUMMARIZECOLUMNS('fct_region'[REGIONID], "__rows", COUNTROWS('fct_region'), "v", 'fct_region'[Regional solar available MWh]), NOT(ISBLANK('fct_region'[Regional wind available MWh]))), "REGIONID", 'fct_region'[REGIONID], "v", [v])
