// note: the view expander's grid (tools/ossie/grid.mjs), order by measure: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.REGIONID, AGG(t."Regional solar curtailed MWh") AS v FROM aac.fct_region AS t GROUP BY t.REGIONID ORDER BY v DESC NULLS LAST, t.REGIONID NULLS FIRST
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('fct_region'[REGIONID], "__rows", COUNTROWS('fct_region'), "v", 'fct_region'[Regional solar curtailed MWh]), "REGIONID", 'fct_region'[REGIONID], "v", [v]) ORDER BY [v] DESC, [REGIONID]
