// note: the view expander's grid (tools/ossie/grid.mjs), group by all: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.REGIONID, AGG(t."Regional wind available MWh") AS v FROM aac.fct_region AS t GROUP BY ALL
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('fct_region'[REGIONID], "__rows", COUNTROWS('fct_region'), "v", 'fct_region'[Regional wind available MWh]), "REGIONID", 'fct_region'[REGIONID], "v", [v])
