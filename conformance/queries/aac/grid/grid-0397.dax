// note: the view expander's grid (tools/ossie/grid.mjs), scalar ops: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t."time", AGG(t."Lowest price") * 2 AS a, AGG(t."Lowest price") + 1 AS b, COALESCE(AGG(t."Lowest price"), 0) AS c FROM aac.fct_region AS t GROUP BY t."time"
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('fct_region'[time], "__rows", COUNTROWS(fct_region), "a", ('fct_region'[Lowest price] * 2), "b", ('fct_region'[Lowest price] + 1), "c", IF(ISBLANK(COUNTROWS(fct_region)), BLANK(), COALESCE('fct_region'[Lowest price], 0))), "time", 'fct_region'[time], "a", [a], "b", [b], "c", [c])
