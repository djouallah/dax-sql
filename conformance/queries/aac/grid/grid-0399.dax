// note: the view expander's grid (tools/ossie/grid.mjs), cte: its SQL as dax-sql's SQL front end writes it in DAX:
// WITH s AS (SELECT "date", "Lowest price" AS mm FROM aac.fct_region WHERE wind_curtailed = 2.68) SELECT "date", AGG(mm) AS v FROM s GROUP BY "date"
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('fct_region'[date], "__rows", COUNTROWS(fct_region), "v", 'fct_region'[Lowest price]), ('fct_region'[wind_curtailed] = 2.68)), "date", 'fct_region'[date], "v", [v])
