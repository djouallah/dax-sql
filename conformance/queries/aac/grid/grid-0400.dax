// note: the view expander's grid (tools/ossie/grid.mjs), derived table: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT s."time", s.v FROM (SELECT t."time", AGG(t."Regional wind available MWh") AS v FROM aac.fct_region AS t GROUP BY t."time") AS s WHERE s.v IS NOT NULL
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('fct_region'[time], "__rows", COUNTROWS('fct_region'), "v", 'fct_region'[Regional wind available MWh]), "time", 'fct_region'[time], "v", [v])
