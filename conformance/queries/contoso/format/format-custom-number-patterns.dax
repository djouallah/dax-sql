// note: FORMAT with custom number patterns: rounding, # and 0, thousands and scaling commas, literals, sections, exponents, blank and text
EVALUATE ROW("c0", FORMAT(1.005, "0.00"),
    "c1", FORMAT(2.5, "0"),
    "c2", FORMAT(-2.5, "0"),
    "c3", FORMAT(-0.001, "0.00"),
    "c4", FORMAT(0.5, "#.##"),
    "c5", FORMAT(5, "#.##"),
    "c6", FORMAT(5, "0.0#"),
    "c7", FORMAT(5.125, "0.0#"),
    "c8", FORMAT(0, "#"),
    "c9", FORMAT(0, "0"),
    "c10", FORMAT(5, "0000"),
    "c11", FORMAT(5, "0,000"),
    "c12", FORMAT(1234567, "#,##0"),
    "c13", FORMAT(1234567, "#,##0,"),
    "c14", FORMAT(1234567890, "#,##0.0,,"),
    "c15", FORMAT(1e20, "#,##0"),
    "c16", FORMAT(5551234567, "(###) ###-####"),
    "c17", FORMAT(123456789, "000-00-0000"),
    "c18", FORMAT(1234.5, "\$#,##0.00"),
    "c19", FORMAT(1234.5, """USD ""0"),
    "c20", FORMAT(0.256, "0.0%"),
    "c21", FORMAT(-5, "0;(0)"),
    "c22", FORMAT(0, "0;(0);""zero"""),
    "c23", FORMAT(-0.001, "0.0;(0.0);""zero"""),
    "c24", FORMAT(-5, "0;;""z"""),
    "c25", FORMAT(0.000123, "0.00E+00"),
    "c26", FORMAT(123456, "0.00e-0"),
    "c27", FORMAT(9.996, "0.00E+00"),
    "c28", FORMAT(0, "0.00E+00"),
    "c29", FORMAT(-123456, "0.0E+00"),
    "c30", FORMAT(BLANK(), "0.00"),
    "c31", FORMAT("abc", "0"),
    "c32", FORMAT(1234.5678, ""))
