// note: FORMAT of dates and times: named and custom date/time patterns, week numbers, m as minutes after h, AM/PM, and dates with number patterns
EVALUATE ROW("c0", FORMAT(dt"2024-01-05", "Short Date"),
    "c1", FORMAT(dt"2024-01-05", "Long Date"),
    "c2", FORMAT(dt"2024-01-05", "dd/mm/yyyy"),
    "c3", FORMAT(dt"2024-01-05", "mmm d, yy"),
    "c4", FORMAT(dt"2024-01-05", "ddd mmmm"),
    "c5", FORMAT(dt"2024-08-05", """Q""q yyyy"),
    "c6", FORMAT(dt"2024-01-05", "y w ww"),
    "c7", FORMAT(dt"2024-12-31", "y ww"),
    "c8", FORMAT(dt"2024-01-05 15:04:09", "h:nn:ss AM/PM"),
    "c9", FORMAT(dt"2024-01-05 15:04:09", "hh:mm"),
    "c10", FORMAT(dt"2024-01-05 15:04:09", "h:mm a/p"),
    "c11", FORMAT(dt"2024-01-05 09:04:09", "Long Time"),
    "c12", FORMAT(dt"2024-01-05 09:04:09", "Short Time"),
    "c13", FORMAT(dt"2024-01-05 15:04:09", "General Date"),
    "c14", FORMAT(dt"2024-01-05", "General Date"),
    "c15", FORMAT(dt"2024-01-05", "c"),
    "c16", FORMAT(dt"2024-01-05", "ddddd"),
    "c17", FORMAT(dt"2024-01-05", "dddddd"),
    "c18", FORMAT(dt"2024-01-05", "yyyy\mm"),
    "c19", FORMAT(dt"2024-01-05", "0"),
    "c20", FORMAT(45296.5, "General Date"))
