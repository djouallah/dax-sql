// note: coupon bonds: PRICE, YIELD, DURATION, ACCRINTM, COUPDAYS, COUPDAYBS, COUPDAYSNC, COUPNCD, COUPPCD and COUPNUM
EVALUATE ROW("price", PRICE(DATE(2008, 2, 15), DATE(2017, 11, 15), 0.0575, 0.065, 100, 2, 0), "yield", YIELD(DATE(2008, 2, 15), DATE(2016, 11, 15), 0.0575, 95.04287, 100, 2, 0),
    "duration", DURATION(DATE(2018, 7, 1), DATE(2048, 1, 1), 0.08, 0.09, 2, 1), "accrintm", ACCRINTM(DATE(2008, 4, 1), DATE(2008, 6, 15), 0.1, 1000, 3),
    "coupdays", COUPDAYS(DATE(2011, 1, 25), DATE(2011, 11, 15), 2, 1), "coupdaybs", COUPDAYBS(DATE(2011, 1, 25), DATE(2011, 11, 15), 2, 1),
    "coupdaysnc", COUPDAYSNC(DATE(2011, 1, 25), DATE(2011, 11, 15), 2, 1), "coupncd", COUPNCD(DATE(2011, 1, 25), DATE(2011, 11, 15), 2, 1),
    "couppcd", COUPPCD(DATE(2011, 1, 25), DATE(2011, 11, 15), 2, 1), "coupnum", COUPNUM(DATE(2007, 1, 25), DATE(2008, 11, 15), 2, 1))
