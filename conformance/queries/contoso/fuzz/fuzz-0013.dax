// note: a random query (conformance/tools/fuzz.mjs contoso 120 20261124, number 13)
EVALUATE SUMMARIZECOLUMNS('Customer'[City], 'Date'[Quarter], KEEPFILTERS(TREATAS({ "Road Bike" }, 'Product'[Name])), KEEPFILTERS(TREATAS({ "Road Bike" }, 'Product'[Name])), "m0", IF(HASONEVALUE('Category'[Category]), CALCULATE(COUNTROWS('Sales'), DATESBETWEEN('Date'[Date], DATE(2024, 8, 4), DATE(1999, 1, 1)))), "m1", VAR v = COALESCE([Share of Category], 0) RETURN v * 2 + MAX([Red Sales Kept], [Avg Price]), "m2", IF(ISBLANK(IF(MAX('Sales'[Amount]) > 1, [All Sales], MIN('Returns'[ReturnQty]))), 0, IF(ISBLANK(AVERAGE('Sales'[Qty])), 0, SUM('Sales'[Qty]))))
