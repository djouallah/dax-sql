// note: a random query (conformance/tools/fuzz.mjs contoso 120 20261124, number 23)
EVALUATE SUMMARIZECOLUMNS('Customer'[Customer], 'Product'[Color], "m0", CALCULATE(VAR v = [Products Sold] RETURN v * 2 + COALESCE(MAX('Sales'[Amount]), 0), 'Date'[Quarter] IN { 1 }, 'Date'[Quarter] > 1), "m1", IF(ISBLANK(IF(ISINSCOPE('Customer'[Customer]), VAR v = [Sales YTD] RETURN v * 2 + [Best Customer Sales], CALCULATE([Target Total], DATESBETWEEN('Date'[Date], DATE(2024, 11, 13), DATE(1999, 1, 1))))), 0, (TOTALYTD([Red Sales], 'Date'[Date]) * CALCULATE(AVERAGE('Returns'[ReturnQty]), REMOVEFILTERS('Sales')))))
