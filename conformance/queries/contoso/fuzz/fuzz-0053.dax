// note: a random query (conformance/tools/fuzz.mjs contoso 120 20261124, number 53)
EVALUATE ADDCOLUMNS(VALUES('Product'[PriceBand]), "m0", IF(ISBLANK(SUMX(VALUES('Product'[PriceBand]), ROUND(SUM('Sales'[Qty]), 1))), 0, IF(ISINSCOPE('Product'[PriceBand]), DIVIDE(COUNTROWS('Sales'), CALCULATE([All Sales], ALL('Product'[Name]))), [Red Sales])))
