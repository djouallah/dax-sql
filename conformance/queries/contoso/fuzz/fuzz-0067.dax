// note: a random query (conformance/tools/fuzz.mjs contoso 120 20261124, number 67)
EVALUATE ADDCOLUMNS(VALUES('Customer'[Customer]), "m0", CALCULATE([Product Count], DATESBETWEEN('Date'[Date], DATE(2023, 9, 11), DATE(2024, 11, 23))), "m1", RANKX(ALL('Category'[Category]), RANKX(ALL('Date'[Quarter]), VAR v = MAX('Returns'[ReturnQty]) RETURN v * 2 + MIN('Returns'[ReturnQty]), , DESC, Dense)))
