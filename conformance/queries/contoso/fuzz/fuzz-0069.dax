// note: a random query (conformance/tools/fuzz.mjs contoso 120 20261124, number 69)
EVALUATE CALCULATETABLE(SUMMARIZECOLUMNS('Date'[Quarter], "m0", DIVIDE(VAR v = IF(ISINSCOPE('Product'[PriceBand]), MAX('Sales'[Qty]), SUM('Returns'[ReturnQty])) RETURN v * 2 + ROUND([Product Count], 0), CALCULATE(DIVIDE(CALCULATE(AVERAGE('Sales'[Amount]), DATESBETWEEN('Date'[Date], DATE(2023, 6, 5), DATE(2024, 6, 21))), [Red Sales Kept]), ALL('Product'[Color]))), "m1", DIVIDE(COUNTROWS(FILTER(VALUES('Product'[Price]), CALCULATE(MIN('Sales'[Qty]), ALL('Customer'[City]), ALL('Date'[Year])) > 100)), CALCULATE([Share of Category], ALL('Product'[Color])))), 'Product'[Name] >= "Helmet")
