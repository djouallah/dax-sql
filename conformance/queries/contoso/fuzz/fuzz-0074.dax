// note: a random query (conformance/tools/fuzz.mjs contoso 120 20261124, number 74)
EVALUATE CALCULATETABLE(SUMMARIZECOLUMNS('Category'[Category], 'Product'[Name], "m0", CALCULATE(CALCULATE(COALESCE([Return Rate], 0), 'Product'[Color] <> "Blue", REMOVEFILTERS('Date')), KEEPFILTERS('Product'[PriceBand] = "zz-none"), ALLEXCEPT('Date', 'Date'[Month])), "m1", IF(TOTALYTD(RANKX(ALL('Category'[Category]), [Red Sales Kept]), 'Date'[Date]) > 100, CALCULATE(IF(ISINSCOPE('Date'[Month]), [Share of Category], DISTINCTCOUNT('Customer'[City])), KEEPFILTERS('Date'[Year] IN { 2024, 2023 }), TREATAS({ "Clothing", "Accessories" }, 'Category'[Category])), CALCULATE(COUNTROWS('Customer'), FILTER(ALL('Date'[Month]), 'Date'[Month] <> 7), USERELATIONSHIP('Sales'[ShipDate], 'Date'[Date])))), 'Product'[Color] <> "Blue")
