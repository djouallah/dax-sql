// note: a random query (conformance/tools/fuzz.mjs contoso 150 31337 fuzz2, number 1)
EVALUATE SUMMARIZECOLUMNS('Product'[Name], 'Product'[PriceBand], "m0", IF(ISINSCOPE('Date'[Quarter]), IF(TOTALYTD(COUNTROWS('Customer'), 'Date'[Date]) > 100, DISTINCTCOUNT('Customer'[Customer]), ([Return Rate] - [Orders])), IF(ISBLANK(CALCULATE([Orders], 'Product'[Color] = "Blue", FILTER(VALUES('Product'[Color]), IF([Sales by Ship Date] > 10, [Customers], MAX('Returns'[ReturnQty])) > 100))), 0, RANKX(ALL('Category'[Category]), AVERAGE('Returns'[ReturnQty]), , DESC, Dense))), "m1", IF(CALCULATE(CALCULATE([Sales YTD], FILTER(ALL('Customer'[City]), 'Customer'[City] <> "London"), 'Product'[Price] = 1000), DATESBETWEEN('Date'[Date], DATE(2023, 12, 12), DATE(2024, 9, 6))) > 100, MAX(TOTALYTD([Sales PY], 'Date'[Date]), CALCULATE(DISTINCTCOUNT('Product'[Name]), DATESBETWEEN('Date'[Date], DATE(2024, 6, 2), DATE(2024, 8, 25)))), CALCULATE(COALESCE([Sales YTD], 0), TREATAS({ 2, 4 }, 'Date'[Quarter]), USERELATIONSHIP('Sales'[ShipDate], 'Date'[Date]))))
