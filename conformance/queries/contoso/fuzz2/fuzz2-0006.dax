// note: a random query (conformance/tools/fuzz.mjs contoso 150 31337 fuzz2, number 6)
EVALUATE TOPN(4, SUMMARIZECOLUMNS('Product'[PriceBand], "m0", DIVIDE(IF(HASONEVALUE('Category'[Category]), [Products Sold]), IF(ISINSCOPE('Date'[Year]), DISTINCTCOUNT('Date'[Month]), MIN('Sales'[Amount])))), [m0], DESC)
