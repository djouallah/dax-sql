// note: a random query (conformance/tools/fuzz.mjs contoso 150 31337 fuzz2, number 21)
EVALUATE SUMMARIZECOLUMNS('Product'[PriceBand], "m0", RANKX(ALL('Date'[Year]), [Sales YTD]), "m1", MAX(IF(ISBLANK(VAR v = [Product Count] RETURN v * 2 + [Share of Category]), 0, IF(COUNTROWS('Sales') > 10, [Best Customer Sales], SUM('Sales'[Qty]))), RANKX(ALL('Customer'[City]), IF(ISINSCOPE('Customer'[Customer]), [Avg Price], [Sales Amount]), , DESC, Dense)), "m2", IF(HASONEVALUE('Date'[Year]), CALCULATE([Line Value Column], DATESBETWEEN('Date'[Date], DATE(2024, 9, 11), DATE(2023, 3, 21)))))
