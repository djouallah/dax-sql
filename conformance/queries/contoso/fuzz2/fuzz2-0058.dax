// note: a random query (conformance/tools/fuzz.mjs contoso 150 31337 fuzz2, number 58)
EVALUATE SUMMARIZECOLUMNS('Category'[Category], 'Product'[Color], 'Customer'[City], "m0", IF(ISINSCOPE('Date'[Quarter]), SUM('Sales'[Amount]), IF(ISINSCOPE('Product'[PriceBand]), MINX(VALUES('Customer'[Customer]), DISTINCTCOUNT('Customer'[Customer])), IF([Returned] > 0, [Sales PY], COUNTROWS('Returns')))), "m1", [Returned], "m2", IF(([Customers] - CALCULATE(DISTINCTCOUNT('Product'[Color]), TREATAS({ "Road Bike" }, 'Product'[Name]))) > 10, TOTALYTD(IF(AVERAGE('Sales'[Qty]) > 1000, MIN('Sales'[Amount]), COUNTROWS('Returns')), 'Date'[Date]), DIVIDE(AVERAGE('Returns'[ReturnQty]), CALCULATE(RANKX(ALL('Date'[Quarter]), [All Sales], , DESC, Dense), ALL('Product'[PriceBand])))))
