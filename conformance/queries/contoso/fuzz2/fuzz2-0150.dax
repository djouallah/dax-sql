// note: a random query (conformance/tools/fuzz.mjs contoso 150 31337 fuzz2, number 150)
EVALUATE CALCULATETABLE(SUMMARIZECOLUMNS('Product'[Price], "m0", DIVIDE(MIN('Sales'[Amount]), CALCULATE(ABS([Best Customer Sales]), ALL('Customer'[City]))), "m1", MIN('Returns'[ReturnQty])), 'Customer'[Customer] <> "Bob")
