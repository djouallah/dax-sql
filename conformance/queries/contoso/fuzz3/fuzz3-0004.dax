EVALUATE SUMMARIZECOLUMNS('Scale'[Scale], "m0", CALCULATE(DIVIDE(CALCULATE(COUNTROWS('Customer'), ALLSELECTED('Date'[Quarter])), CALCULATE(TOTALYTD([Red Sales], 'Date'[Date]), ALL('Customer'[City]))), KEEPFILTERS('Product'[PriceBand] IN { "zz-none" })))
