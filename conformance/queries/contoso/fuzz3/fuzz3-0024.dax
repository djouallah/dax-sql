// note: a random query (conformance/tools/fuzz.mjs contoso 150 20261125 fuzz3, number 24)
EVALUATE SUMMARIZECOLUMNS('Date'[Year], 'Customer'[Customer], "m0", CALCULATE(CALCULATE(LEN(CONCATENATEX(VALUES('Customer'[City]), 'Customer'[City], ",")), INDEX(1, ALL('Product'[Color]), ORDERBY('Product'[Color], DESC))), ALLSELECTED('Customer'[Customer])), "m1", SWITCH(TRUE(), DIVIDE(ROUND([Returned], 0), CALCULATE(MAX([Big Orders], [Best Customer Sales]), ALL('Product'[Price]))) > 1, AVERAGE('Returns'[ReturnQty]), MINX(VALUES('Product'[Color]), [Sales by Ship Date]) < 10, DIVIDE(CALCULATE(MAX('Sales'[Qty]), ALLSELECTED('Category'[Category])), CALCULATE([Big Orders], ALL('Date'[Month]))), [Return Rate]))
