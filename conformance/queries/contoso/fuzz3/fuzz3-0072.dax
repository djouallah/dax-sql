// note: a random query (conformance/tools/fuzz.mjs contoso 150 20261125 fuzz3, number 72)
EVALUATE TOPN(4, ADDCOLUMNS(VALUES('Product'[PriceBand]), "m0", SWITCH(TRUE(), CALCULATE([All Sales], DATEADD('Date'[Date], -1, QUARTER)) > 100, CALCULATE(CALCULATE(AVERAGE('Sales'[Amount]), KEEPFILTERS('Date'[Year] IN { 2023 }), TREATAS({ "zz-none" }, 'Product'[PriceBand])), ALLSELECTED('Product'[Price])), DIVIDE(CALCULATE([Sales YTD], INDEX(-1, ALL('Customer'[City]), ORDERBY('Customer'[City], ASC))), CALCULATE(CALCULATE(COUNTROWS('Returns'), PARALLELPERIOD('Date'[Date], -1, QUARTER)), ALL('Product'[PriceBand]))) < 0, CALCULATE(CALCULATE(COUNTROWS('Returns'), PARALLELPERIOD('Date'[Date], -1, QUARTER)), 'Customer'[Customer] <> "Bob"), [All Sales])), [m0], DESC, 'Product'[PriceBand], ASC)
