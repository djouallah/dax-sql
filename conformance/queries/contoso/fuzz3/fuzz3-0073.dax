EVALUATE TOPN(3, ADDCOLUMNS(VALUES('Product'[Color]), "m0", IF(OR([Red Sales] > 1000, NOT(ISBLANK([Red Sales Kept]))), AVERAGE('Sales'[Amount]), [Big Orders])), [m0], DESC, 'Product'[Color], ASC)
