// note: a random query (conformance/tools/fuzz.mjs contoso 150 20261125 fuzz3, number 95)
EVALUATE SUMMARIZE('Sales', 'Product'[PriceBand], 'Date'[Quarter], "m0", (CALCULATE(DIVIDE(MAX('Sales'[Qty]), CALCULATE([Big Orders], ALL('Product'[Price]))), DATESBETWEEN('Date'[Date], DATE(2023, 4, 24), DATE(2023, 7, 26))) - VAR v = CALCULATE([Red Sales], ALLSELECTED('Product'), ALLSELECTED('Date'[Year])) RETURN v * 2 + COUNTROWS('Sales')), "m1", IF(ISINSCOPE('Customer'[City]), LEN(CONCATENATEX(VALUES('Category'[Category]), 'Category'[Category], ",")), CALCULATE(MAXX(VALUES('Customer'[Customer]), COUNTROWS('Customer')), DATESINPERIOD('Date'[Date], DATE(2023, 11, 5), -12, MONTH))))
