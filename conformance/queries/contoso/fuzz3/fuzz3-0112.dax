// note: a random query (conformance/tools/fuzz.mjs contoso 150 20261125 fuzz3, number 112)
EVALUATE ADDCOLUMNS(CROSSJOIN(VALUES('Date'[Quarter]), VALUES('Customer'[City])), "m0", DIVIDE(DIVIDE(IF([Red Sales] > 1000, [Line Value Column], [Avg Price]), CALCULATE([Product Count], DATESINPERIOD('Date'[Date], DATE(2023, 7, 8), -3, MONTH))), ABS(LEN(LEFT(UPPER(CONCATENATEX(VALUES('Product'[Color]), 'Product'[Color], "|", 'Product'[Color], ASC)), 4)))))
