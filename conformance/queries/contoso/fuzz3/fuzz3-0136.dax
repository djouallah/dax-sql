// note: a random query (conformance/tools/fuzz.mjs contoso 150 20261125 fuzz3, number 136)
EVALUATE ADDCOLUMNS(VALUES('Date'[Year]), "m0", IF(SELECTEDVALUE('Customer'[Customer]) = "Dan", CALCULATE([Red Sales Kept], DATESINPERIOD('Date'[Date], DATE(2024, 5, 30), -1, MONTH)), CALCULATE(MAX('Returns'[ReturnQty]), ALLSELECTED('Product'[Price]))), "m1", IF(ISBLANK(SUM('Sales'[Amount])), 0, CALCULATE([Customers], DATESBETWEEN('Date'[Date], DATE(2024, 12, 25), DATE(2024, 11, 9)))))
