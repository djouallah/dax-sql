// note: a random query (conformance/tools/fuzz.mjs contoso 150 20261125 fuzz3, number 149)
EVALUATE SUMMARIZECOLUMNS('Product'[Price], 'Date'[Year], 'Category'[Category], TREATAS({ "zz-none" }, 'Product'[PriceBand]), "m0", VAR v = IF(HASONEVALUE('Customer'[City]), (AVERAGE('Sales'[Amount]) * [Line Value Column])) RETURN v * 2 + [Sales Amount], "m1", COUNTROWS('Sales'), "m2", IF(ISINSCOPE('Product'[Color]), CALCULATE(SWITCH(TRUE(), [Return Rate] > 100, [Quantity], [Red Sales] < 10, DISTINCTCOUNT('Customer'[City]), [Product Count]), DATESBETWEEN('Date'[Date], DATE(2023, 9, 27), DATE(1999, 1, 1))), AVERAGE('Sales'[Qty])))
