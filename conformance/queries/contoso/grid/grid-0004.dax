// note: the view expander's grid (tools/ossie/grid.mjs), two groups: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.ProductKey, t.Color, AGG(t."Avg Price") AS v FROM contoso.Product AS t GROUP BY t.ProductKey, t.Color
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('Product'[ProductKey], 'Product'[Color], "__rows", COUNTROWS(Product), "v", 'Product'[Avg Price]), "ProductKey", 'Product'[ProductKey], "Color", 'Product'[Color], "v", [v])
