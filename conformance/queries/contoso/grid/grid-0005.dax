// note: the view expander's grid (tools/ossie/grid.mjs), where: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.ProductKey, AGG(t."Product Count") AS v FROM contoso.Product AS t WHERE t.CategoryKey IN (3, 1) GROUP BY t.ProductKey
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('Product'[ProductKey], "__rows", COUNTROWS('Product'), "v", 'Product'[Product Count]), ('Product'[CategoryKey] IN {3, 1})), "ProductKey", 'Product'[ProductKey], "v", [v])
