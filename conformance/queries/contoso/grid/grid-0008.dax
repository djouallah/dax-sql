// note: the view expander's grid (tools/ossie/grid.mjs), where total: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT AGG(t."Product Count") AS v FROM contoso.Product AS t WHERE t.Price >= 800
EVALUATE SELECTCOLUMNS(CALCULATETABLE(ROW("v", 'Product'[Product Count]), ('Product'[Price] >= 800)), "v", [v])
