// note: the view expander's grid (tools/ossie/grid.mjs), having: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.ProductKey, AGG(t."Avg Price") AS v FROM contoso.Product AS t GROUP BY t.ProductKey HAVING AGG(t."Product Count") > 0
EVALUATE SELECTCOLUMNS(FILTER(SUMMARIZECOLUMNS('Product'[ProductKey], "__rows", COUNTROWS(Product), "v", 'Product'[Avg Price]), ('Product'[Product Count] > 0)), "ProductKey", 'Product'[ProductKey], "v", [v])
