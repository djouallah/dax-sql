// note: the view expander's grid (tools/ossie/grid.mjs), order limit: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.ProductKey, AGG(t."Product Count") AS v FROM contoso.Product AS t GROUP BY t.ProductKey ORDER BY t.ProductKey NULLS FIRST LIMIT 3
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('Product'[ProductKey], "__rows", COUNTROWS(Product), "v", 'Product'[Product Count]), "ProductKey", 'Product'[ProductKey], "v", [v]) ORDER BY [ProductKey]
