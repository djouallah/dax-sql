// note: the view expander's grid (tools/ossie/grid.mjs), rollup: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.ProductKey, AGG(t."Avg Price") AS v FROM contoso.Product AS t GROUP BY ROLLUP (t.ProductKey) ORDER BY t.ProductKey NULLS LAST
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS(ROLLUPADDISSUBTOTAL('Product'[ProductKey], "__level1_ProductKey"), "__rows", COUNTROWS(Product), "v", 'Product'[Avg Price]), "ProductKey", 'Product'[ProductKey], "v", [v]) ORDER BY ISBLANK([ProductKey]), [ProductKey]
