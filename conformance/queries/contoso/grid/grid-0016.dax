// note: the view expander's grid (tools/ossie/grid.mjs), ratio: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.ProductKey, CAST(AGG(t."Product Count") AS DOUBLE) / NULLIF(AGG(t."Product Count"), 0) AS r FROM contoso.Product AS t GROUP BY t.ProductKey
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('Product'[ProductKey], "__rows", COUNTROWS('Product'), "r", IF(ISBLANK(COUNTROWS('Product')), BLANK(), (CONVERT('Product'[Product Count], DOUBLE) / IF(('Product'[Product Count] == 0), BLANK(), 'Product'[Product Count])))), "ProductKey", 'Product'[ProductKey], "r", [r])
