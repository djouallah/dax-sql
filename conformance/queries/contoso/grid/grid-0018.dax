// note: the view expander's grid (tools/ossie/grid.mjs), derived table: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT s.ProductKey, s.v FROM (SELECT t.ProductKey, AGG(t."Avg Price") AS v FROM contoso.Product AS t GROUP BY t.ProductKey) AS s WHERE s.v IS NOT NULL
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('Product'[ProductKey], "__rows", COUNTROWS(Product), "v", 'Product'[Avg Price]), "ProductKey", 'Product'[ProductKey], "v", [v])
