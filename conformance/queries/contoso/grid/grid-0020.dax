// note: the view expander's grid (tools/ossie/grid.mjs), star where one: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.Name, AGG(f."Line Value Column") AS v FROM contoso.Sales AS f JOIN contoso.Product AS o ON f.ProductKey = o.ProductKey WHERE o.ProductKey = 4 GROUP BY o.Name
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('Product'[Name], "__rows", COUNTROWS('Sales'), "v", 'Sales'[Line Value Column]), ('Product'[ProductKey] = 4), NOT(ISBLANK('Product'[ProductKey]))), "Name", 'Product'[Name], "v", [v])
