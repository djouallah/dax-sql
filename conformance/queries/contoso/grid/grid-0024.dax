// note: the view expander's grid (tools/ossie/grid.mjs), one side counted once: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.CategoryKey, AGG(f.Customers) AS a, AGG(o."Product Count") AS b FROM contoso.Sales AS f JOIN contoso.Product AS o ON f.ProductKey = o.ProductKey GROUP BY o.CategoryKey
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('Product'[CategoryKey], "__rows", COUNTROWS(Sales), "a", 'Sales'[Customers], "b", CALCULATE('Product'[Product Count], Sales)), NOT(ISBLANK('Product'[ProductKey]))), "CategoryKey", 'Product'[CategoryKey], "a", [a], "b", [b])
