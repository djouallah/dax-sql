// note: the view expander's grid (tools/ossie/grid.mjs), one to many: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.CategoryKey, AGG(o."Avg Price") AS a, AGG(f.Customers) AS b FROM contoso.Product AS o LEFT JOIN contoso.Sales AS f ON f.ProductKey = o.ProductKey GROUP BY o.CategoryKey
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('Product'[CategoryKey], "__rows", COUNTROWS('Product'), "a", 'Product'[Avg Price], "b", CALCULATE('Sales'[Customers], KEEPFILTERS(NOT(ISBLANK('Product'[ProductKey]))))), "CategoryKey", 'Product'[CategoryKey], "a", [a], "b", [b])
