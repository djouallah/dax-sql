// note: the view expander's grid (tools/ossie/grid.mjs), snowflake: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT c.Category, AGG(f.Customers) AS v FROM contoso.Sales AS f JOIN contoso.Product AS b ON f.ProductKey = b.ProductKey JOIN contoso.Category AS c ON b.CategoryKey = c.CategoryKey GROUP BY c.Category
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('Category'[Category], "__rows", COUNTROWS(Sales), "v", 'Sales'[Customers]), NOT(ISBLANK('Product'[ProductKey])), NOT(ISBLANK('Category'[CategoryKey]))), "Category", 'Category'[Category], "v", [v])
