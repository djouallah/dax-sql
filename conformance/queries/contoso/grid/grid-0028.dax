// note: the view expander's grid (tools/ossie/grid.mjs), chasm: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.Name, AGG(a.Returned) AS x, AGG(b.Quantity) AS y FROM contoso.Product AS o LEFT JOIN contoso.Returns AS a ON a.ProductKey = o.ProductKey LEFT JOIN contoso.Sales AS b ON b.ProductKey = o.ProductKey GROUP BY o.Name
DEFINE
VAR __v1 = GENERATEALL(GENERATEALL(SELECTCOLUMNS(Product, "o.ProductKey", 'Product'[ProductKey], "o.Name", 'Product'[Name]), FILTER(SELECTCOLUMNS(Returns, "a.Date", 'Returns'[Date], "a.ProductKey", 'Returns'[ProductKey], "a.ReturnQty", 'Returns'[ReturnQty]), ([a.ProductKey] = [o.ProductKey]))), FILTER(SELECTCOLUMNS(Sales, "b.OrderDate", 'Sales'[OrderDate], "b.ShipDate", 'Sales'[ShipDate], "b.ProductKey", 'Sales'[ProductKey], "b.CustomerKey", 'Sales'[CustomerKey], "b.Qty", 'Sales'[Qty], "b.Amount", 'Sales'[Amount]), ([b.ProductKey] = [o.ProductKey])))
VAR __v2 = DISTINCT(SELECTCOLUMNS(__v1, "Name", [o.Name]))
EVALUATE SELECTCOLUMNS(ADDCOLUMNS(__v2, "__m1", CALCULATE('Returns'[Returned], REMOVEFILTERS(), TREATAS(SELECTCOLUMNS(FILTER(__v1, (NOT(((ISBLANK([a.Date]) && ISBLANK([a.ProductKey])) && ISBLANK([a.ReturnQty]))) && ([o.Name] == [Name]))), "__k1", [a.Date], "__k2", [a.ProductKey], "__k3", [a.ReturnQty]), 'Returns'[Date], 'Returns'[ProductKey], 'Returns'[ReturnQty])), "__m2", CALCULATE('Sales'[Quantity], REMOVEFILTERS(), TREATAS(SELECTCOLUMNS(FILTER(__v1, (NOT((((((ISBLANK([b.OrderDate]) && ISBLANK([b.ShipDate])) && ISBLANK([b.ProductKey])) && ISBLANK([b.CustomerKey])) && ISBLANK([b.Qty])) && ISBLANK([b.Amount]))) && ([o.Name] == [Name]))), "__k1", [b.OrderDate], "__k2", [b.ShipDate], "__k3", [b.ProductKey], "__k4", [b.CustomerKey], "__k5", [b.Qty], "__k6", [b.Amount]), 'Sales'[OrderDate], 'Sales'[ShipDate], 'Sales'[ProductKey], 'Sales'[CustomerKey], 'Sales'[Qty], 'Sales'[Amount]))), "Name", [Name], "x", [__m1], "y", [__m2])
