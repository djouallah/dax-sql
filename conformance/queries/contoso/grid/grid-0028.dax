// note: the view expander's grid (tools/ossie/grid.mjs), chasm: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.Name, AGG(a.Returned) AS x, AGG(b.Quantity) AS y FROM contoso.Product AS o LEFT JOIN contoso.Returns AS a ON a.ProductKey = o.ProductKey LEFT JOIN contoso.Sales AS b ON b.ProductKey = o.ProductKey GROUP BY o.Name
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('Product'[Name], "__rows", COUNTROWS('Product'), "x", CALCULATE('Returns'[Returned], KEEPFILTERS(NOT(ISBLANK('Product'[ProductKey])))), "y", CALCULATE('Sales'[Quantity], KEEPFILTERS(NOT(ISBLANK('Product'[ProductKey]))))), "Name", 'Product'[Name], "x", [x], "y", [y])
