// note: the view expander's grid (tools/ossie/grid.mjs), group: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.CategoryKey, AGG(t."Product Count") AS v FROM contoso.Product AS t GROUP BY t.CategoryKey
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('Product'[CategoryKey], "__rows", COUNTROWS(Product), "v", 'Product'[Product Count]), "CategoryKey", 'Product'[CategoryKey], "v", [v])
