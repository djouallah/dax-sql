// note: the view expander's grid (tools/ossie/grid.mjs), two groups: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.ProductKey, t.Name, AGG(t."Product Count") AS v FROM contoso.Product AS t GROUP BY t.ProductKey, t.Name
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('Product'[ProductKey], 'Product'[Name], "__rows", COUNTROWS(Product), "v", 'Product'[Product Count]), "ProductKey", 'Product'[ProductKey], "Name", 'Product'[Name], "v", [v])
