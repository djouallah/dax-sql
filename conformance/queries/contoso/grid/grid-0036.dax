// note: the view expander's grid (tools/ossie/grid.mjs), where total: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT AGG(t."Product Count") AS v FROM contoso.Product AS t WHERE NOT (t.Color = 'Red')
EVALUATE SELECTCOLUMNS(CALCULATETABLE(ROW("v", 'Product'[Product Count]), NOT(('Product'[Color] = "Red"))), "v", [v])
