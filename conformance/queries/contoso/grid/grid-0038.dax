// note: the view expander's grid (tools/ossie/grid.mjs), having null: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.CategoryKey, AGG(t."Avg Price") AS v FROM contoso.Product AS t GROUP BY t.CategoryKey HAVING AGG(t."Avg Price") IS NOT NULL
EVALUATE SELECTCOLUMNS(FILTER(SUMMARIZECOLUMNS('Product'[CategoryKey], "__rows", COUNTROWS('Product'), "v", 'Product'[Avg Price]), NOT(ISBLANK([v]))), "CategoryKey", 'Product'[CategoryKey], "v", [v])
