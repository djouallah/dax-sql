// note: the view expander's grid (tools/ossie/grid.mjs), group by all: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.CategoryKey, AGG(t."Avg Price") AS v FROM contoso.Product AS t GROUP BY ALL
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('Product'[CategoryKey], "__rows", COUNTROWS('Product'), "v", 'Product'[Avg Price]), "CategoryKey", 'Product'[CategoryKey], "v", [v])
