// note: the view expander's grid (tools/ossie/grid.mjs), rollup: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.CategoryKey, AGG(t."Product Count") AS v FROM contoso.Product AS t GROUP BY ROLLUP (t.CategoryKey) ORDER BY t.CategoryKey NULLS LAST
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS(ROLLUPADDISSUBTOTAL('Product'[CategoryKey], "__level1_CategoryKey"), "__rows", COUNTROWS('Product'), "v", 'Product'[Product Count]), "CategoryKey", 'Product'[CategoryKey], "v", [v]) ORDER BY ISBLANK([CategoryKey]), [CategoryKey]
