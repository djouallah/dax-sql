// note: the view expander's grid (tools/ossie/grid.mjs), scalar ops: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.CategoryKey, AGG(t."Product Count") * 2 AS a, AGG(t."Product Count") + 1 AS b, COALESCE(AGG(t."Product Count"), 0) AS c FROM contoso.Product AS t GROUP BY t.CategoryKey
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('Product'[CategoryKey], "__rows", COUNTROWS(Product), "a", ('Product'[Product Count] * 2), "b", ('Product'[Product Count] + 1), "c", IF(ISBLANK(COUNTROWS(Product)), BLANK(), COALESCE('Product'[Product Count], 0))), "CategoryKey", 'Product'[CategoryKey], "a", [a], "b", [b], "c", [c])
