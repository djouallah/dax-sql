// note: the view expander's grid (tools/ossie/grid.mjs), cte: its SQL as dax-sql's SQL front end writes it in DAX:
// WITH s AS (SELECT CategoryKey, "Product Count" AS mm FROM contoso.Product WHERE NOT (Name = 'Road Bike')) SELECT CategoryKey, AGG(mm) AS v FROM s GROUP BY CategoryKey
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('Product'[CategoryKey], "__rows", COUNTROWS(Product), "v", 'Product'[Product Count]), NOT(('Product'[Name] = "Road Bike"))), "CategoryKey", 'Product'[CategoryKey], "v", [v])
