// note: the view expander's grid (tools/ossie/grid.mjs), star where one: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.Name, AGG(f."Sales Amount") AS v FROM contoso.Sales AS f LEFT JOIN contoso.Product AS o ON f.ProductKey = o.ProductKey WHERE o.CategoryKey IS NOT NULL GROUP BY o.Name
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('Product'[Name], "__rows", COUNTROWS('Sales'), "v", 'Sales'[Sales Amount]), NOT(ISBLANK('Product'[CategoryKey]))), "Name", 'Product'[Name], "v", [v])
