// note: the view expander's grid (tools/ossie/grid.mjs), star where many: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.Name, AGG(f.Customers) AS v FROM contoso.Sales AS f LEFT JOIN contoso.Product AS o ON f.ProductKey = o.ProductKey WHERE f.ShipDate IN (DATE '2024-02-16', DATE '2023-02-12') GROUP BY o.Name
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('Product'[Name], "__rows", COUNTROWS(Sales), "v", 'Sales'[Customers]), ('Sales'[ShipDate] IN {DATE(2024, 2, 16), DATE(2023, 2, 12)})), "Name", 'Product'[Name], "v", [v])
