// note: the view expander's grid (tools/ossie/grid.mjs), star two sides: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.Name, f.CustomerKey, AGG(f.Customers) AS v FROM contoso.Sales AS f LEFT JOIN contoso.Product AS o ON f.ProductKey = o.ProductKey GROUP BY o.Name, f.CustomerKey
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('Product'[Name], 'Sales'[CustomerKey], "__rows", COUNTROWS(Sales), "v", 'Sales'[Customers]), "Name", 'Product'[Name], "CustomerKey", 'Sales'[CustomerKey], "v", [v])
