// note: the view expander's grid (tools/ossie/grid.mjs), one side counted once: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.ProductKey, AGG(f."Sales Amount") AS a, AGG(o."Avg Price") AS b FROM contoso.Sales AS f LEFT JOIN contoso.Product AS o ON f.ProductKey = o.ProductKey GROUP BY o.ProductKey
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('Product'[ProductKey], "__rows", COUNTROWS('Sales'), "a", 'Sales'[Sales Amount], "b", CALCULATE('Product'[Avg Price], 'Sales')), "ProductKey", 'Product'[ProductKey], "a", [a], "b", [b])
