// note: the view expander's grid (tools/ossie/grid.mjs), one to many: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.ProductKey, AGG(o."Avg Price") AS a, AGG(f."Sales Amount") AS b FROM contoso.Product AS o LEFT JOIN contoso.Sales AS f ON f.ProductKey = o.ProductKey GROUP BY o.ProductKey
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('Product'[ProductKey], "__rows", COUNTROWS('Product'), "a", 'Product'[Avg Price], "b", CALCULATE('Sales'[Sales Amount], KEEPFILTERS(NOT(ISBLANK('Product'[ProductKey]))))), "ProductKey", 'Product'[ProductKey], "a", [a], "b", [b])
