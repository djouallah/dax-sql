// note: the view expander's grid (tools/ossie/grid.mjs), fan-out: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT f.Qty, AGG(o."Avg Price") AS v FROM contoso.Sales AS f LEFT JOIN contoso.Product AS o ON f.ProductKey = o.ProductKey GROUP BY f.Qty
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('Sales'[Qty], "__rows", COUNTROWS(Sales), "v", CALCULATE('Product'[Avg Price], Sales)), "Qty", 'Sales'[Qty], "v", [v])
