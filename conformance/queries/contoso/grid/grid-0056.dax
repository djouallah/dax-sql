// note: the view expander's grid (tools/ossie/grid.mjs), chasm: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.Quarter, AGG(a.Returned) AS x, AGG(b.Quantity) AS y FROM contoso."Date" AS o LEFT JOIN contoso.Returns AS a ON a."Date" = o."Date" LEFT JOIN contoso.Sales AS b ON b.OrderDate = o."Date" GROUP BY o.Quarter
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('Date'[Quarter], "__rows", COUNTROWS('Date'), "x", CALCULATE('Returns'[Returned], KEEPFILTERS(NOT(ISBLANK('Date'[Date])))), "y", CALCULATE('Sales'[Quantity], KEEPFILTERS(NOT(ISBLANK('Date'[Date]))))), "Quarter", 'Date'[Quarter], "x", [x], "y", [y])
