// note: the view expander's grid (tools/ossie/grid.mjs), where: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.ProductKey, AGG(t."Product Count") AS v FROM contoso.Product AS t WHERE t.CategoryKey = 2 GROUP BY t.ProductKey
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('Product'[ProductKey], "__rows", COUNTROWS(Product), "v", 'Product'[Product Count]), ('Product'[CategoryKey] = 2)), "ProductKey", 'Product'[ProductKey], "v", [v])
