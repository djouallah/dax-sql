// note: the view expander's grid (tools/ossie/grid.mjs), where and: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.ProductKey, AGG(t."Product Count") AS v FROM contoso.Product AS t WHERE t.Name IN ('Mountain Bike', 'Helmet') AND t.ProductKey IS NOT NULL GROUP BY t.ProductKey
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('Product'[ProductKey], "__rows", COUNTROWS('Product'), "v", 'Product'[Product Count]), ('Product'[Name] IN {"Mountain Bike", "Helmet"}), NOT(ISBLANK('Product'[ProductKey]))), "ProductKey", 'Product'[ProductKey], "v", [v])
