// note: the view expander's grid (tools/ossie/grid.mjs), where or: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.ProductKey, AGG(t."Avg Price") AS v FROM contoso.Product AS t WHERE t.Color IS NOT NULL OR t.Color = 'Black' GROUP BY t.ProductKey
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('Product'[ProductKey], "__rows", COUNTROWS(Product), "v", 'Product'[Avg Price]), (NOT(ISBLANK('Product'[Color])) || ('Product'[Color] = "Black"))), "ProductKey", 'Product'[ProductKey], "v", [v])
