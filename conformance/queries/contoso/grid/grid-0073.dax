// note: the view expander's grid (tools/ossie/grid.mjs), cte: its SQL as dax-sql's SQL front end writes it in DAX:
// WITH s AS (SELECT ProductKey, "Avg Price" AS mm FROM contoso.Product WHERE CategoryKey <> 3) SELECT ProductKey, AGG(mm) AS v FROM s GROUP BY ProductKey
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('Product'[ProductKey], "__rows", COUNTROWS(Product), "v", 'Product'[Avg Price]), ('Product'[CategoryKey] <> 3)), "ProductKey", 'Product'[ProductKey], "v", [v])
