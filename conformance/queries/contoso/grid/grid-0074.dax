// note: the view expander's grid (tools/ossie/grid.mjs), derived table: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT s.Name, s.v FROM (SELECT t.Name, AGG(t."Avg Price") AS v FROM contoso.Product AS t GROUP BY t.Name) AS s WHERE s.v IS NOT NULL
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('Product'[Name], "__rows", COUNTROWS('Product'), "v", 'Product'[Avg Price]), "Name", 'Product'[Name], "v", [v])
