// note: the view expander's grid (tools/ossie/grid.mjs), star where one: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.Color, AGG(f.Orders) AS v FROM contoso.Sales AS f JOIN contoso.Product AS o ON f.ProductKey = o.ProductKey WHERE o.Price <> 50 GROUP BY o.Color
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('Product'[Color], "__rows", COUNTROWS(Sales), "v", 'Sales'[Orders]), ('Product'[Price] <> 50), NOT(ISBLANK('Product'[ProductKey]))), "Color", 'Product'[Color], "v", [v])
