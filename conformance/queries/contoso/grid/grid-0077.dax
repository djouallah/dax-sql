// note: the view expander's grid (tools/ossie/grid.mjs), star where many: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.Color, AGG(f."Line Value Column") AS v FROM contoso.Sales AS f JOIN contoso.Product AS o ON f.ProductKey = o.ProductKey WHERE f.OrderDate <> DATE '2024-06-30' GROUP BY o.Color
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('Product'[Color], "__rows", COUNTROWS(Sales), "v", 'Sales'[Line Value Column]), ('Sales'[OrderDate] <> DATE(2024, 6, 30)), NOT(ISBLANK('Product'[ProductKey]))), "Color", 'Product'[Color], "v", [v])
