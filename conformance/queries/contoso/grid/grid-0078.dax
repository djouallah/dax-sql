// note: the view expander's grid (tools/ossie/grid.mjs), star two sides: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.Color, f.Amount, AGG(f."Line Value Column") AS v FROM contoso.Sales AS f JOIN contoso.Product AS o ON f.ProductKey = o.ProductKey GROUP BY o.Color, f.Amount
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('Product'[Color], 'Sales'[Amount], "__rows", COUNTROWS('Sales'), "v", 'Sales'[Line Value Column]), NOT(ISBLANK('Product'[ProductKey]))), "Color", 'Product'[Color], "Amount", 'Sales'[Amount], "v", [v])
