// note: the view expander's grid (tools/ossie/grid.mjs), one side counted once: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.Color, AGG(f.Orders) AS a, AGG(o."Avg Price") AS b FROM contoso.Sales AS f JOIN contoso.Product AS o ON f.ProductKey = o.ProductKey GROUP BY o.Color
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('Product'[Color], "__rows", COUNTROWS(Sales), "a", 'Sales'[Orders], "b", CALCULATE('Product'[Avg Price], Sales)), NOT(ISBLANK('Product'[ProductKey]))), "Color", 'Product'[Color], "a", [a], "b", [b])
