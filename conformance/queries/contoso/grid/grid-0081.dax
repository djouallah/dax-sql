// note: the view expander's grid (tools/ossie/grid.mjs), one to many: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.Color, AGG(o."Product Count") AS a, AGG(f.Orders) AS b FROM contoso.Product AS o LEFT JOIN contoso.Sales AS f ON f.ProductKey = o.ProductKey GROUP BY o.Color
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('Product'[Color], "__rows", COUNTROWS('Product'), "a", 'Product'[Product Count], "b", CALCULATE('Sales'[Orders], KEEPFILTERS(NOT(ISBLANK('Product'[ProductKey]))))), "Color", 'Product'[Color], "a", [a], "b", [b])
