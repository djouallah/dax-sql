// note: the view expander's grid (tools/ossie/grid.mjs), chasm: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o."Month", AGG(a.Returned) AS x, AGG(b.Orders) AS y FROM contoso."Date" AS o LEFT JOIN contoso.Returns AS a ON a."Date" = o."Date" LEFT JOIN contoso.Sales AS b ON b.ShipDate = o."Date" GROUP BY o."Month"
DEFINE
VAR __v1 = GENERATEALL(GENERATEALL(SELECTCOLUMNS(Date, "o.Date", 'Date'[Date], "o.Month", 'Date'[Month]), FILTER(SELECTCOLUMNS(Returns, "a.Date", 'Returns'[Date], "a.ProductKey", 'Returns'[ProductKey], "a.ReturnQty", 'Returns'[ReturnQty]), ([a.Date] = [o.Date]))), FILTER(SELECTCOLUMNS(Sales, "b.OrderDate", 'Sales'[OrderDate], "b.ShipDate", 'Sales'[ShipDate], "b.ProductKey", 'Sales'[ProductKey], "b.CustomerKey", 'Sales'[CustomerKey], "b.Qty", 'Sales'[Qty], "b.Amount", 'Sales'[Amount]), ([b.ShipDate] = [o.Date])))
VAR __v2 = DISTINCT(SELECTCOLUMNS(__v1, "Month", [o.Month]))
EVALUATE SELECTCOLUMNS(ADDCOLUMNS(__v2, "__m1", CALCULATE('Returns'[Returned], REMOVEFILTERS(), TREATAS(SELECTCOLUMNS(FILTER(__v1, (NOT(((ISBLANK([a.Date]) && ISBLANK([a.ProductKey])) && ISBLANK([a.ReturnQty]))) && ([o.Month] == [Month]))), "__k1", [a.Date], "__k2", [a.ProductKey], "__k3", [a.ReturnQty]), 'Returns'[Date], 'Returns'[ProductKey], 'Returns'[ReturnQty])), "__m2", CALCULATE('Sales'[Orders], REMOVEFILTERS(), TREATAS(SELECTCOLUMNS(FILTER(__v1, (NOT((((((ISBLANK([b.OrderDate]) && ISBLANK([b.ShipDate])) && ISBLANK([b.ProductKey])) && ISBLANK([b.CustomerKey])) && ISBLANK([b.Qty])) && ISBLANK([b.Amount]))) && ([o.Month] == [Month]))), "__k1", [b.OrderDate], "__k2", [b.ShipDate], "__k3", [b.ProductKey], "__k4", [b.CustomerKey], "__k5", [b.Qty], "__k6", [b.Amount]), 'Sales'[OrderDate], 'Sales'[ShipDate], 'Sales'[ProductKey], 'Sales'[CustomerKey], 'Sales'[Qty], 'Sales'[Amount]))), "Month", [Month], "x", [__m1], "y", [__m2])
