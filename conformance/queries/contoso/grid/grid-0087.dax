// note: the view expander's grid (tools/ossie/grid.mjs), two groups: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.ShipDate, t.CustomerKey, AGG(t.Customers) AS v FROM contoso.Sales AS t GROUP BY t.ShipDate, t.CustomerKey
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('Sales'[ShipDate], 'Sales'[CustomerKey], "__rows", COUNTROWS('Sales'), "v", 'Sales'[Customers]), "ShipDate", 'Sales'[ShipDate], "CustomerKey", 'Sales'[CustomerKey], "v", [v])
