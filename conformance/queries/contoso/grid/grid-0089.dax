// note: the view expander's grid (tools/ossie/grid.mjs), where and: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.Name, AGG(t."Avg Price") AS v FROM contoso.Product AS t WHERE t.CategoryKey BETWEEN 1 AND 3 AND t.Price IN (50, 1000) GROUP BY t.Name
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('Product'[Name], "__rows", COUNTROWS(Product), "v", 'Product'[Avg Price]), (('Product'[CategoryKey] >= 1) && ('Product'[CategoryKey] <= 3)), ('Product'[Price] IN {50, 1000})), "Name", 'Product'[Name], "v", [v])
