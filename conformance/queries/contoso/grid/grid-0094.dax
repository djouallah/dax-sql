// note: the view expander's grid (tools/ossie/grid.mjs), order limit: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.Name, AGG(t."Product Count") AS v FROM contoso.Product AS t GROUP BY t.Name ORDER BY t.Name NULLS FIRST LIMIT 3
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('Product'[Name], "__rows", COUNTROWS(Product), "v", 'Product'[Product Count]), "Name", 'Product'[Name], "v", [v]) ORDER BY [Name]
