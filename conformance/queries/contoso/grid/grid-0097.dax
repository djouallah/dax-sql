// note: the view expander's grid (tools/ossie/grid.mjs), rollup: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.Color, AGG(t."Avg Price") AS v FROM contoso.Product AS t GROUP BY ROLLUP (t.Color) ORDER BY t.Color NULLS LAST
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS(ROLLUPADDISSUBTOTAL('Product'[Color], "__level1_Color"), "__rows", COUNTROWS(Product), "v", 'Product'[Avg Price]), "Color", 'Product'[Color], "v", [v]) ORDER BY ISBLANK([Color]), [Color]
