// note: the view expander's grid (tools/ossie/grid.mjs), scalar ops: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.ProductKey, AGG(t."Product Count") * 2 AS a, AGG(t."Product Count") + 1 AS b, COALESCE(AGG(t."Product Count"), 0) AS c FROM contoso.Product AS t GROUP BY t.ProductKey
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('Product'[ProductKey], "__rows", COUNTROWS('Product'), "a", ('Product'[Product Count] * 2), "b", ('Product'[Product Count] + 1), "c", IF(ISBLANK(COUNTROWS('Product')), BLANK(), COALESCE('Product'[Product Count], 0))), "ProductKey", 'Product'[ProductKey], "a", [a], "b", [b], "c", [c])
