// note: the view expander's grid (tools/ossie/grid.mjs), star where many: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.CategoryKey, AGG(f."Avg Price") AS v FROM contoso.Product AS f LEFT JOIN contoso.Category AS o ON f.CategoryKey = o.CategoryKey WHERE f.CategoryKey < 1 GROUP BY o.CategoryKey
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('Category'[CategoryKey], "__rows", COUNTROWS('Product'), "v", 'Product'[Avg Price]), ('Product'[CategoryKey] < 1)), "CategoryKey", 'Category'[CategoryKey], "v", [v])
