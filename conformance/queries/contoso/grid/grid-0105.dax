// note: the view expander's grid (tools/ossie/grid.mjs), star two sides: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.CategoryKey, f.Name, AGG(f."Product Count") AS v FROM contoso.Product AS f LEFT JOIN contoso.Category AS o ON f.CategoryKey = o.CategoryKey GROUP BY o.CategoryKey, f.Name
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('Category'[CategoryKey], 'Product'[Name], "__rows", COUNTROWS(Product), "v", 'Product'[Product Count]), "CategoryKey", 'Category'[CategoryKey], "Name", 'Product'[Name], "v", [v])
