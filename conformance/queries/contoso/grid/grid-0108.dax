// note: the view expander's grid (tools/ossie/grid.mjs), one to many: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.Name, AGG(o."Avg Price") AS a, AGG(f.Returned) AS b FROM contoso.Product AS o LEFT JOIN contoso.Returns AS f ON f.ProductKey = o.ProductKey GROUP BY o.Name
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('Product'[Name], "__rows", COUNTROWS(Product), "a", 'Product'[Avg Price], "b", CALCULATE('Returns'[Returned], KEEPFILTERS(NOT(ISBLANK('Product'[ProductKey]))))), "Name", 'Product'[Name], "a", [a], "b", [b])
