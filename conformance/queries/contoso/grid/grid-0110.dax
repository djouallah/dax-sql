// note: the view expander's grid (tools/ossie/grid.mjs), chasm: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.City, AGG(a."Target Total") AS x, AGG(b.Quantity) AS y FROM contoso.Customer AS o LEFT JOIN contoso.CityTarget AS a ON a.City = o.City LEFT JOIN contoso.Sales AS b ON b.CustomerKey = o.CustomerKey GROUP BY o.City
DEFINE
VAR __v1 = GENERATEALL(GENERATEALL(SELECTCOLUMNS('Customer', "o.CustomerKey", 'Customer'[CustomerKey], "o.City", 'Customer'[City]), FILTER(SELECTCOLUMNS('CityTarget', "a.City", 'CityTarget'[City], "a.Target", 'CityTarget'[Target]), ([a.City] = [o.City]))), FILTER(SELECTCOLUMNS('Sales', "b.OrderDate", 'Sales'[OrderDate], "b.ShipDate", 'Sales'[ShipDate], "b.ProductKey", 'Sales'[ProductKey], "b.CustomerKey", 'Sales'[CustomerKey], "b.Qty", 'Sales'[Qty], "b.Amount", 'Sales'[Amount]), ([b.CustomerKey] = [o.CustomerKey])))
VAR __v2 = DISTINCT(SELECTCOLUMNS(__v1, "City", [o.City]))
EVALUATE SELECTCOLUMNS(ADDCOLUMNS(__v2, "__m1", CALCULATE('CityTarget'[Target Total], REMOVEFILTERS(), TREATAS(SELECTCOLUMNS(FILTER(__v1, (NOT((ISBLANK([a.City]) && ISBLANK([a.Target]))) && ([o.City] == [City]))), "__k1", [a.City], "__k2", [a.Target]), 'CityTarget'[City], 'CityTarget'[Target])), "__m2", CALCULATE('Sales'[Quantity], REMOVEFILTERS(), TREATAS(SELECTCOLUMNS(FILTER(__v1, (NOT((((((ISBLANK([b.OrderDate]) && ISBLANK([b.ShipDate])) && ISBLANK([b.ProductKey])) && ISBLANK([b.CustomerKey])) && ISBLANK([b.Qty])) && ISBLANK([b.Amount]))) && ([o.City] == [City]))), "__k1", [b.OrderDate], "__k2", [b.ShipDate], "__k3", [b.ProductKey], "__k4", [b.CustomerKey], "__k5", [b.Qty], "__k6", [b.Amount]), 'Sales'[OrderDate], 'Sales'[ShipDate], 'Sales'[ProductKey], 'Sales'[CustomerKey], 'Sales'[Qty], 'Sales'[Amount]))), "City", [City], "x", [__m1], "y", [__m2])
