// note: the view expander's grid (tools/ossie/grid.mjs), group: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.ShipDate, AGG(t.Customers) AS v FROM contoso.Sales AS t GROUP BY t.ShipDate
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('Sales'[ShipDate], "__rows", COUNTROWS('Sales'), "v", 'Sales'[Customers]), "ShipDate", 'Sales'[ShipDate], "v", [v])
