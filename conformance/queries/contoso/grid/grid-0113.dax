// note: the view expander's grid (tools/ossie/grid.mjs), two metrics: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.ProductKey, AGG(t."Product Count") AS a, AGG(t."Avg Price") AS b FROM contoso.Product AS t GROUP BY t.ProductKey
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('Product'[ProductKey], "__rows", COUNTROWS('Product'), "a", 'Product'[Product Count], "b", 'Product'[Avg Price]), "ProductKey", 'Product'[ProductKey], "a", [a], "b", [b])
