// note: the view expander's grid (tools/ossie/grid.mjs), two groups: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.Amount, t.CustomerKey, AGG(t."Sales Amount") AS v FROM contoso.Sales AS t GROUP BY t.Amount, t.CustomerKey
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('Sales'[Amount], 'Sales'[CustomerKey], "__rows", COUNTROWS(Sales), "v", 'Sales'[Sales Amount]), "Amount", 'Sales'[Amount], "CustomerKey", 'Sales'[CustomerKey], "v", [v])
