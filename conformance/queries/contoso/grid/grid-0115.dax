// note: the view expander's grid (tools/ossie/grid.mjs), where: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.ProductKey, AGG(t."Avg Price") AS v FROM contoso.Product AS t WHERE t.ProductKey < 3 GROUP BY t.ProductKey
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('Product'[ProductKey], "__rows", COUNTROWS('Product'), "v", 'Product'[Avg Price]), ('Product'[ProductKey] < 3)), "ProductKey", 'Product'[ProductKey], "v", [v])
