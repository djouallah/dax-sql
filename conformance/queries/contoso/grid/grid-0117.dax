// note: the view expander's grid (tools/ossie/grid.mjs), where or: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.ProductKey, AGG(t."Product Count") AS v FROM contoso.Product AS t WHERE NOT (t.Color = 'Black') OR t.ProductKey BETWEEN 1 AND 1 GROUP BY t.ProductKey
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('Product'[ProductKey], "__rows", COUNTROWS(Product), "v", 'Product'[Product Count]), (NOT(('Product'[Color] = "Black")) || (('Product'[ProductKey] >= 1) && ('Product'[ProductKey] <= 1)))), "ProductKey", 'Product'[ProductKey], "v", [v])
