// note: the view expander's grid (tools/ossie/grid.mjs), rollup: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.Name, AGG(t."Avg Price") AS v FROM contoso.Product AS t GROUP BY ROLLUP (t.Name) ORDER BY t.Name NULLS LAST
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS(ROLLUPADDISSUBTOTAL('Product'[Name], "__level1_Name"), "__rows", COUNTROWS(Product), "v", 'Product'[Avg Price]), "Name", 'Product'[Name], "v", [v]) ORDER BY ISBLANK([Name]), [Name]
