// note: the view expander's grid (tools/ossie/grid.mjs), cte: its SQL as dax-sql's SQL front end writes it in DAX:
// WITH s AS (SELECT ProductKey, "Product Count" AS mm FROM contoso.Product WHERE Price < 60) SELECT ProductKey, AGG(mm) AS v FROM s GROUP BY ProductKey
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('Product'[ProductKey], "__rows", COUNTROWS('Product'), "v", 'Product'[Product Count]), ('Product'[Price] < 60)), "ProductKey", 'Product'[ProductKey], "v", [v])
