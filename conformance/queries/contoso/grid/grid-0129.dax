// note: the view expander's grid (tools/ossie/grid.mjs), star: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.CategoryKey, AGG(f."Avg Price") AS v FROM contoso.Product AS f LEFT JOIN contoso.Category AS o ON f.CategoryKey = o.CategoryKey GROUP BY o.CategoryKey
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('Category'[CategoryKey], "__rows", COUNTROWS(Product), "v", 'Product'[Avg Price]), "CategoryKey", 'Category'[CategoryKey], "v", [v])
