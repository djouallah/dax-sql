// note: the view expander's grid (tools/ossie/grid.mjs), fan-out: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT f."Date", AGG(o."Avg Price") AS v FROM contoso.Returns AS f LEFT JOIN contoso.Product AS o ON f.ProductKey = o.ProductKey GROUP BY f."Date"
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('Returns'[Date], "__rows", COUNTROWS(Returns), "v", CALCULATE('Product'[Avg Price], Returns)), "Date", 'Returns'[Date], "v", [v])
