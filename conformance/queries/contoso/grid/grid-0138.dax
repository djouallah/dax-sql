// note: the view expander's grid (tools/ossie/grid.mjs), group: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.Amount, AGG(t."Line Value Column") AS v FROM contoso.Sales AS t GROUP BY t.Amount
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('Sales'[Amount], "__rows", COUNTROWS(Sales), "v", 'Sales'[Line Value Column]), "Amount", 'Sales'[Amount], "v", [v])
