// note: the view expander's grid (tools/ossie/grid.mjs), two groups: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.Amount, t.ProductKey, AGG(t.Quantity) AS v FROM contoso.Sales AS t GROUP BY t.Amount, t.ProductKey
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('Sales'[Amount], 'Sales'[ProductKey], "__rows", COUNTROWS(Sales), "v", 'Sales'[Quantity]), "Amount", 'Sales'[Amount], "ProductKey", 'Sales'[ProductKey], "v", [v])
