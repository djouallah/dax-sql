// note: the view expander's grid (tools/ossie/grid.mjs), where: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.Name, AGG(t."Product Count") AS v FROM contoso.Product AS t WHERE t.ProductKey = 1 GROUP BY t.Name
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('Product'[Name], "__rows", COUNTROWS(Product), "v", 'Product'[Product Count]), ('Product'[ProductKey] = 1)), "Name", 'Product'[Name], "v", [v])
