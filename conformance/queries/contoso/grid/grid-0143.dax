// note: the view expander's grid (tools/ossie/grid.mjs), where or: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.Name, AGG(t."Avg Price") AS v FROM contoso.Product AS t WHERE t.ProductKey BETWEEN 1 AND 5 OR t.Price >= 50 GROUP BY t.Name
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('Product'[Name], "__rows", COUNTROWS('Product'), "v", 'Product'[Avg Price]), ((('Product'[ProductKey] >= 1) && ('Product'[ProductKey] <= 5)) || ('Product'[Price] >= 50))), "Name", 'Product'[Name], "v", [v])
