// note: the view expander's grid (tools/ossie/grid.mjs), where total: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT AGG(t."Product Count") AS v FROM contoso.Product AS t WHERE t.ProductKey BETWEEN 1 AND 5
EVALUATE SELECTCOLUMNS(CALCULATETABLE(ROW("v", 'Product'[Product Count]), (('Product'[ProductKey] >= 1) && ('Product'[ProductKey] <= 5))), "v", [v])
