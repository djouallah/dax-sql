// note: the view expander's grid (tools/ossie/grid.mjs), having: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.CustomerKey, AGG(t.Orders) AS v FROM contoso.Sales AS t GROUP BY t.CustomerKey HAVING AGG(t."Line Value Column") > 0
EVALUATE SELECTCOLUMNS(FILTER(SUMMARIZECOLUMNS('Sales'[CustomerKey], "__rows", COUNTROWS(Sales), "v", 'Sales'[Orders]), ('Sales'[Line Value Column] > 0)), "CustomerKey", 'Sales'[CustomerKey], "v", [v])
