// note: the view expander's grid (tools/ossie/grid.mjs), rollup: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.CustomerKey, AGG(t.Orders) AS v FROM contoso.Sales AS t GROUP BY ROLLUP (t.CustomerKey) ORDER BY t.CustomerKey NULLS LAST
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS(ROLLUPADDISSUBTOTAL('Sales'[CustomerKey], "__level1_CustomerKey"), "__rows", COUNTROWS('Sales'), "v", 'Sales'[Orders]), "CustomerKey", 'Sales'[CustomerKey], "v", [v]) ORDER BY ISBLANK([CustomerKey]), [CustomerKey]
