// note: the view expander's grid (tools/ossie/grid.mjs), scalar ops: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.ShipDate, AGG(t."Sales Amount") * 2 AS a, AGG(t."Sales Amount") + 1 AS b, COALESCE(AGG(t."Sales Amount"), 0) AS c FROM contoso.Sales AS t GROUP BY t.ShipDate
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('Sales'[ShipDate], "__rows", COUNTROWS(Sales), "a", ('Sales'[Sales Amount] * 2), "b", ('Sales'[Sales Amount] + 1), "c", IF(ISBLANK(COUNTROWS(Sales)), BLANK(), COALESCE('Sales'[Sales Amount], 0))), "ShipDate", 'Sales'[ShipDate], "a", [a], "b", [b], "c", [c])
