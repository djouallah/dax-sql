// note: the view expander's grid (tools/ossie/grid.mjs), cte: its SQL as dax-sql's SQL front end writes it in DAX:
// WITH s AS (SELECT Name, "Product Count" AS mm FROM contoso.Product WHERE Color = 'Black') SELECT Name, AGG(mm) AS v FROM s GROUP BY Name
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('Product'[Name], "__rows", COUNTROWS(Product), "v", 'Product'[Product Count]), ('Product'[Color] = "Black")), "Name", 'Product'[Name], "v", [v])
