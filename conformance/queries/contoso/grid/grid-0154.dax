// note: the view expander's grid (tools/ossie/grid.mjs), derived table: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT s.ShipDate, s.v FROM (SELECT t.ShipDate, AGG(t.Orders) AS v FROM contoso.Sales AS t GROUP BY t.ShipDate) AS s WHERE s.v IS NOT NULL
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('Sales'[ShipDate], "__rows", COUNTROWS(Sales), "v", 'Sales'[Orders]), "ShipDate", 'Sales'[ShipDate], "v", [v])
