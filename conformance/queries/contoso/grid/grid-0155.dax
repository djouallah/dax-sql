// note: the view expander's grid (tools/ossie/grid.mjs), star: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.Customer, AGG(f."Line Value Column") AS v FROM contoso.Sales AS f LEFT JOIN contoso.Customer AS o ON f.CustomerKey = o.CustomerKey GROUP BY o.Customer
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('Customer'[Customer], "__rows", COUNTROWS('Sales'), "v", 'Sales'[Line Value Column]), "Customer", 'Customer'[Customer], "v", [v])
