// note: the view expander's grid (tools/ossie/grid.mjs), star two sides: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.Customer, f.OrderDate, AGG(f."Sales Amount") AS v FROM contoso.Sales AS f LEFT JOIN contoso.Customer AS o ON f.CustomerKey = o.CustomerKey GROUP BY o.Customer, f.OrderDate
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('Customer'[Customer], 'Sales'[OrderDate], "__rows", COUNTROWS(Sales), "v", 'Sales'[Sales Amount]), "Customer", 'Customer'[Customer], "OrderDate", 'Sales'[OrderDate], "v", [v])
