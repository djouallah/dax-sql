// note: the view expander's grid (tools/ossie/grid.mjs), star total: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT AGG(f."Line Value Column") AS v FROM contoso.Sales AS f LEFT JOIN contoso.Customer AS o ON f.CustomerKey = o.CustomerKey
