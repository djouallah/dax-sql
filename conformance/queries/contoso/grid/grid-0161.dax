// note: the view expander's grid (tools/ossie/grid.mjs), fan-out: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT f.ProductKey, AGG(o."Product Count") AS v FROM contoso.Returns AS f JOIN contoso.Product AS o ON f.ProductKey = o.ProductKey GROUP BY f.ProductKey
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('Returns'[ProductKey], "__rows", COUNTROWS(Returns), "v", CALCULATE('Product'[Product Count], Returns)), NOT(ISBLANK('Product'[ProductKey]))), "ProductKey", 'Returns'[ProductKey], "v", [v])
