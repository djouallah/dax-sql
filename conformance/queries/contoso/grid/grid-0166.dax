// note: the view expander's grid (tools/ossie/grid.mjs), where: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.CustomerKey, AGG(t.Quantity) AS v FROM contoso.Sales AS t WHERE t.ProductKey IS NOT NULL GROUP BY t.CustomerKey
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('Sales'[CustomerKey], "__rows", COUNTROWS(Sales), "v", 'Sales'[Quantity]), NOT(ISBLANK('Sales'[ProductKey]))), "CustomerKey", 'Sales'[CustomerKey], "v", [v])
