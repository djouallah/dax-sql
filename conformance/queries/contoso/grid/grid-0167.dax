// note: the view expander's grid (tools/ossie/grid.mjs), where and: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.CustomerKey, AGG(t.Customers) AS v FROM contoso.Sales AS t WHERE t.ShipDate IS NOT NULL AND NOT (t.Amount = 1000) GROUP BY t.CustomerKey
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('Sales'[CustomerKey], "__rows", COUNTROWS(Sales), "v", 'Sales'[Customers]), NOT(ISBLANK('Sales'[ShipDate])), NOT(('Sales'[Amount] = 1000))), "CustomerKey", 'Sales'[CustomerKey], "v", [v])
