// note: the view expander's grid (tools/ossie/grid.mjs), where total: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT AGG(t."Sales Amount") AS v FROM contoso.Sales AS t WHERE t.ShipDate <> DATE '2024-03-02'
EVALUATE SELECTCOLUMNS(CALCULATETABLE(ROW("v", 'Sales'[Sales Amount]), ('Sales'[ShipDate] <> DATE(2024, 3, 2))), "v", [v])
