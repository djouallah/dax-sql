// note: the view expander's grid (tools/ossie/grid.mjs), scalar ops: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.Amount, AGG(t.Orders) * 2 AS a, AGG(t.Orders) + 1 AS b, COALESCE(AGG(t.Orders), 0) AS c FROM contoso.Sales AS t GROUP BY t.Amount
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('Sales'[Amount], "__rows", COUNTROWS('Sales'), "a", ('Sales'[Orders] * 2), "b", ('Sales'[Orders] + 1), "c", IF(ISBLANK(COUNTROWS('Sales')), BLANK(), COALESCE('Sales'[Orders], 0))), "Amount", 'Sales'[Amount], "a", [a], "b", [b], "c", [c])
