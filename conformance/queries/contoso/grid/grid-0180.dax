// note: the view expander's grid (tools/ossie/grid.mjs), star: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.CustomerKey, AGG(f."Line Value Column") AS v FROM contoso.Sales AS f JOIN contoso.Customer AS o ON f.CustomerKey = o.CustomerKey GROUP BY o.CustomerKey
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('Customer'[CustomerKey], "__rows", COUNTROWS('Sales'), "v", 'Sales'[Line Value Column]), NOT(ISBLANK('Customer'[CustomerKey]))), "CustomerKey", 'Customer'[CustomerKey], "v", [v])
