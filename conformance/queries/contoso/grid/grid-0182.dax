// note: the view expander's grid (tools/ossie/grid.mjs), star where many: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.Customer, AGG(f."Sales Amount") AS v FROM contoso.Sales AS f LEFT JOIN contoso.Customer AS o ON f.CustomerKey = o.CustomerKey WHERE f.ProductKey BETWEEN 1 AND 3 GROUP BY o.Customer
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('Customer'[Customer], "__rows", COUNTROWS(Sales), "v", 'Sales'[Sales Amount]), (('Sales'[ProductKey] >= 1) && ('Sales'[ProductKey] <= 3))), "Customer", 'Customer'[Customer], "v", [v])
