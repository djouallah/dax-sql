// note: the view expander's grid (tools/ossie/grid.mjs), star two sides: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.CustomerKey, f.Amount, AGG(f."Sales Amount") AS v FROM contoso.Sales AS f JOIN contoso.Customer AS o ON f.CustomerKey = o.CustomerKey GROUP BY o.CustomerKey, f.Amount
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('Customer'[CustomerKey], 'Sales'[Amount], "__rows", COUNTROWS(Sales), "v", 'Sales'[Sales Amount]), NOT(ISBLANK('Customer'[CustomerKey]))), "CustomerKey", 'Customer'[CustomerKey], "Amount", 'Sales'[Amount], "v", [v])
