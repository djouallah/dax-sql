// note: the view expander's grid (tools/ossie/grid.mjs), two metrics: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.ShipDate, AGG(t.Quantity) AS a, AGG(t.Quantity) AS b FROM contoso.Sales AS t GROUP BY t.ShipDate
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('Sales'[ShipDate], "__rows", COUNTROWS(Sales), "a", 'Sales'[Quantity], "b", 'Sales'[Quantity]), "ShipDate", 'Sales'[ShipDate], "a", [a], "b", [b])
