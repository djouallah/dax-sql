// note: the view expander's grid (tools/ossie/grid.mjs), two groups: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.CustomerKey, t.ProductKey, AGG(t.Customers) AS v FROM contoso.Sales AS t GROUP BY t.CustomerKey, t.ProductKey
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('Sales'[CustomerKey], 'Sales'[ProductKey], "__rows", COUNTROWS(Sales), "v", 'Sales'[Customers]), "CustomerKey", 'Sales'[CustomerKey], "ProductKey", 'Sales'[ProductKey], "v", [v])
