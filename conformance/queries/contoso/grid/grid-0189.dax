// note: the view expander's grid (tools/ossie/grid.mjs), where: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.ShipDate, AGG(t.Orders) AS v FROM contoso.Sales AS t WHERE NOT (t.OrderDate = DATE '2024-07-01') GROUP BY t.ShipDate
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('Sales'[ShipDate], "__rows", COUNTROWS(Sales), "v", 'Sales'[Orders]), NOT(('Sales'[OrderDate] = DATE(2024, 7, 1)))), "ShipDate", 'Sales'[ShipDate], "v", [v])
