// note: the view expander's grid (tools/ossie/grid.mjs), where total: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT AGG(t.Orders) AS v FROM contoso.Sales AS t WHERE t.CustomerKey < 1
EVALUATE SELECTCOLUMNS(CALCULATETABLE(ROW("v", 'Sales'[Orders]), ('Sales'[CustomerKey] < 1)), "v", [v])
