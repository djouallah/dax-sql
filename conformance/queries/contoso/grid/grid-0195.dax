// note: the view expander's grid (tools/ossie/grid.mjs), order limit: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.Amount, AGG(t.Orders) AS v FROM contoso.Sales AS t GROUP BY t.Amount ORDER BY t.Amount NULLS FIRST LIMIT 3
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('Sales'[Amount], "__rows", COUNTROWS('Sales'), "v", 'Sales'[Orders]), "Amount", 'Sales'[Amount], "v", [v]) ORDER BY [Amount]
