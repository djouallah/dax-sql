// note: the view expander's grid (tools/ossie/grid.mjs), order by measure: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.Amount, AGG(t."Sales Amount") AS v FROM contoso.Sales AS t GROUP BY t.Amount ORDER BY v DESC NULLS LAST, t.Amount NULLS FIRST
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('Sales'[Amount], "__rows", COUNTROWS('Sales'), "v", 'Sales'[Sales Amount]), "Amount", 'Sales'[Amount], "v", [v]) ORDER BY [v] DESC, [Amount]
