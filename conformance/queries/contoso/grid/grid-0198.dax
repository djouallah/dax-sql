// note: the view expander's grid (tools/ossie/grid.mjs), rollup: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.OrderDate, AGG(t.Orders) AS v FROM contoso.Sales AS t GROUP BY ROLLUP (t.OrderDate) ORDER BY t.OrderDate NULLS LAST
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS(ROLLUPADDISSUBTOTAL('Sales'[OrderDate], "__level1_OrderDate"), "__rows", COUNTROWS('Sales'), "v", 'Sales'[Orders]), "OrderDate", 'Sales'[OrderDate], "v", [v]) ORDER BY ISBLANK([OrderDate]), [OrderDate]
