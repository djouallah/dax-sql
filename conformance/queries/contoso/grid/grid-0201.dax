// note: the view expander's grid (tools/ossie/grid.mjs), cte: its SQL as dax-sql's SQL front end writes it in DAX:
// WITH s AS (SELECT ShipDate, "Sales Amount" AS mm FROM contoso.Sales WHERE ShipDate IS NOT NULL) SELECT ShipDate, AGG(mm) AS v FROM s GROUP BY ShipDate
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('Sales'[ShipDate], "__rows", COUNTROWS(Sales), "v", 'Sales'[Sales Amount]), NOT(ISBLANK('Sales'[ShipDate]))), "ShipDate", 'Sales'[ShipDate], "v", [v])
