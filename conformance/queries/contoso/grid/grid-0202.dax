// note: the view expander's grid (tools/ossie/grid.mjs), derived table: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT s.Amount, s.v FROM (SELECT t.Amount, AGG(t.Orders) AS v FROM contoso.Sales AS t GROUP BY t.Amount) AS s WHERE s.v IS NOT NULL
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('Sales'[Amount], "__rows", COUNTROWS(Sales), "v", 'Sales'[Orders]), "Amount", 'Sales'[Amount], "v", [v])
