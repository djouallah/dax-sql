// note: the view expander's grid (tools/ossie/grid.mjs), star: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.Customer, AGG(f.Orders) AS v FROM contoso.Sales AS f JOIN contoso.Customer AS o ON f.CustomerKey = o.CustomerKey GROUP BY o.Customer
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('Customer'[Customer], "__rows", COUNTROWS('Sales'), "v", 'Sales'[Orders]), NOT(ISBLANK('Customer'[CustomerKey]))), "Customer", 'Customer'[Customer], "v", [v])
