// note: the view expander's grid (tools/ossie/grid.mjs), star where one: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.CustomerKey, AGG(f."Sales Amount") AS v FROM contoso.Sales AS f JOIN contoso.Customer AS o ON f.CustomerKey = o.CustomerKey WHERE o.City = 'Paris' GROUP BY o.CustomerKey
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('Customer'[CustomerKey], "__rows", COUNTROWS('Sales'), "v", 'Sales'[Sales Amount]), ('Customer'[City] = "Paris"), NOT(ISBLANK('Customer'[CustomerKey]))), "CustomerKey", 'Customer'[CustomerKey], "v", [v])
