// note: the view expander's grid (tools/ossie/grid.mjs), star where many: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.CustomerKey, AGG(f.Customers) AS v FROM contoso.Sales AS f JOIN contoso.Customer AS o ON f.CustomerKey = o.CustomerKey WHERE f.CustomerKey = 1 GROUP BY o.CustomerKey
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('Customer'[CustomerKey], "__rows", COUNTROWS('Sales'), "v", 'Sales'[Customers]), ('Sales'[CustomerKey] = 1), NOT(ISBLANK('Customer'[CustomerKey]))), "CustomerKey", 'Customer'[CustomerKey], "v", [v])
