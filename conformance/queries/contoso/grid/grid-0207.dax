// note: the view expander's grid (tools/ossie/grid.mjs), star total: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT AGG(f.Quantity) AS v FROM contoso.Sales AS f JOIN contoso."Date" AS o ON f.OrderDate = o."Date"
EVALUATE SELECTCOLUMNS(CALCULATETABLE(ROW("v", 'Sales'[Quantity]), NOT(ISBLANK('Date'[Date]))), "v", [v])
