// note: the view expander's grid (tools/ossie/grid.mjs), two groups: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.ProductKey, t."Date", AGG(t.Returned) AS v FROM contoso.Returns AS t GROUP BY t.ProductKey, t."Date"
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('Returns'[ProductKey], 'Returns'[Date], "__rows", COUNTROWS(Returns), "v", 'Returns'[Returned]), "ProductKey", 'Returns'[ProductKey], "Date", 'Returns'[Date], "v", [v])
