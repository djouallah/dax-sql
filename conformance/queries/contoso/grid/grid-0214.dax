// note: the view expander's grid (tools/ossie/grid.mjs), where or: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.Amount, AGG(t.Customers) AS v FROM contoso.Sales AS t WHERE t.Amount BETWEEN 20 AND 20 OR t.ProductKey IS NOT NULL GROUP BY t.Amount
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('Sales'[Amount], "__rows", COUNTROWS('Sales'), "v", 'Sales'[Customers]), ((('Sales'[Amount] >= 20) && ('Sales'[Amount] <= 20)) || NOT(ISBLANK('Sales'[ProductKey])))), "Amount", 'Sales'[Amount], "v", [v])
