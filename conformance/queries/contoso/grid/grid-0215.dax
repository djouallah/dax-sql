// note: the view expander's grid (tools/ossie/grid.mjs), where total: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT AGG(t.Quantity) AS v FROM contoso.Sales AS t WHERE t.Amount IN (100, 2000)
EVALUATE SELECTCOLUMNS(CALCULATETABLE(ROW("v", 'Sales'[Quantity]), ('Sales'[Amount] IN {100, 2000})), "v", [v])
