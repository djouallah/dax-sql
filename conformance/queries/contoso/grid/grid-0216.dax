// note: the view expander's grid (tools/ossie/grid.mjs), having: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.Amount, AGG(t.Orders) AS v FROM contoso.Sales AS t GROUP BY t.Amount HAVING AGG(t.Customers) > 0
EVALUATE SELECTCOLUMNS(FILTER(SUMMARIZECOLUMNS('Sales'[Amount], "__rows", COUNTROWS(Sales), "v", 'Sales'[Orders]), ('Sales'[Customers] > 0)), "Amount", 'Sales'[Amount], "v", [v])
