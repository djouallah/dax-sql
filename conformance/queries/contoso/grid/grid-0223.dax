// note: the view expander's grid (tools/ossie/grid.mjs), ratio: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.Amount, CAST(AGG(t.Orders) AS DOUBLE) / NULLIF(AGG(t.Quantity), 0) AS r FROM contoso.Sales AS t GROUP BY t.Amount
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('Sales'[Amount], "__rows", COUNTROWS(Sales), "r", IF(ISBLANK(COUNTROWS(Sales)), BLANK(), (CONVERT('Sales'[Orders], DOUBLE) / IF(('Sales'[Quantity] == 0), BLANK(), 'Sales'[Quantity])))), "Amount", 'Sales'[Amount], "r", [r])
