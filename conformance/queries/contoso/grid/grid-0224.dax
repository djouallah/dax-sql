// note: the view expander's grid (tools/ossie/grid.mjs), cte: its SQL as dax-sql's SQL front end writes it in DAX:
// WITH s AS (SELECT Amount, Customers AS mm FROM contoso.Sales WHERE ProductKey IS NOT NULL) SELECT Amount, AGG(mm) AS v FROM s GROUP BY Amount
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('Sales'[Amount], "__rows", COUNTROWS('Sales'), "v", 'Sales'[Customers]), NOT(ISBLANK('Sales'[ProductKey]))), "Amount", 'Sales'[Amount], "v", [v])
