// note: the view expander's grid (tools/ossie/grid.mjs), star where one: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.Customer, AGG(f.Orders) AS v FROM contoso.Sales AS f JOIN contoso.Customer AS o ON f.CustomerKey = o.CustomerKey WHERE o.City IN ('Rome', 'Paris') GROUP BY o.Customer
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('Customer'[Customer], "__rows", COUNTROWS('Sales'), "v", 'Sales'[Orders]), ('Customer'[City] IN {"Rome", "Paris"}), NOT(ISBLANK('Customer'[CustomerKey]))), "Customer", 'Customer'[Customer], "v", [v])
