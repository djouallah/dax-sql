// note: the view expander's grid (tools/ossie/grid.mjs), two metrics: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.Amount, AGG(t."Sales Amount") AS a, AGG(t.Customers) AS b FROM contoso.Sales AS t GROUP BY t.Amount
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('Sales'[Amount], "__rows", COUNTROWS('Sales'), "a", 'Sales'[Sales Amount], "b", 'Sales'[Customers]), "Amount", 'Sales'[Amount], "a", [a], "b", [b])
