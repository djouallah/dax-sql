// note: the view expander's grid (tools/ossie/grid.mjs), where: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.Amount, AGG(t."Sales Amount") AS v FROM contoso.Sales AS t WHERE NOT (t.CustomerKey = 1) GROUP BY t.Amount
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('Sales'[Amount], "__rows", COUNTROWS(Sales), "v", 'Sales'[Sales Amount]), NOT(('Sales'[CustomerKey] = 1))), "Amount", 'Sales'[Amount], "v", [v])
