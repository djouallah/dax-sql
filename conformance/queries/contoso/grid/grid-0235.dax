// note: the view expander's grid (tools/ossie/grid.mjs), where and: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.Amount, AGG(t.Customers) AS v FROM contoso.Sales AS t WHERE t.ProductKey >= 2 AND t.Qty IN (3, 2) GROUP BY t.Amount
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('Sales'[Amount], "__rows", COUNTROWS(Sales), "v", 'Sales'[Customers]), ('Sales'[ProductKey] >= 2), ('Sales'[Qty] IN {3, 2})), "Amount", 'Sales'[Amount], "v", [v])
