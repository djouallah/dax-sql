// note: the view expander's grid (tools/ossie/grid.mjs), where or: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.Amount, AGG(t.Orders) AS v FROM contoso.Sales AS t WHERE t.ShipDate < DATE '2024-01-03' OR NOT (t.Qty = 1) GROUP BY t.Amount
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('Sales'[Amount], "__rows", COUNTROWS(Sales), "v", 'Sales'[Orders]), (('Sales'[ShipDate] < DATE(2024, 1, 3)) || NOT(('Sales'[Qty] = 1)))), "Amount", 'Sales'[Amount], "v", [v])
