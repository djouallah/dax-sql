// note: the view expander's grid (tools/ossie/grid.mjs), where total: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT AGG(t.Quantity) AS v FROM contoso.Sales AS t WHERE t.ShipDate BETWEEN DATE '2023-01-20' AND DATE '2024-03-02'
EVALUATE SELECTCOLUMNS(CALCULATETABLE(ROW("v", 'Sales'[Quantity]), (('Sales'[ShipDate] >= DATE(2023, 1, 20)) && ('Sales'[ShipDate] <= DATE(2024, 3, 2)))), "v", [v])
