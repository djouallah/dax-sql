// note: the view expander's grid (tools/ossie/grid.mjs), having null: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.Amount, AGG(t.Quantity) AS v FROM contoso.Sales AS t GROUP BY t.Amount HAVING AGG(t.Orders) IS NOT NULL
EVALUATE SELECTCOLUMNS(FILTER(SUMMARIZECOLUMNS('Sales'[Amount], "__rows", COUNTROWS('Sales'), "v", 'Sales'[Quantity]), NOT(ISBLANK('Sales'[Orders]))), "Amount", 'Sales'[Amount], "v", [v])
