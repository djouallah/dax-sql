// note: the view expander's grid (tools/ossie/grid.mjs), ratio: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.Amount, CAST(AGG(t.Quantity) AS DOUBLE) / NULLIF(AGG(t.Customers), 0) AS r FROM contoso.Sales AS t GROUP BY t.Amount
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('Sales'[Amount], "__rows", COUNTROWS(Sales), "r", IF(ISBLANK(COUNTROWS(Sales)), BLANK(), (CONVERT('Sales'[Quantity], DOUBLE) / IF(('Sales'[Customers] == 0), BLANK(), 'Sales'[Customers])))), "Amount", 'Sales'[Amount], "r", [r])
