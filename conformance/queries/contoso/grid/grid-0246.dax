// note: the view expander's grid (tools/ossie/grid.mjs), cte: its SQL as dax-sql's SQL front end writes it in DAX:
// WITH s AS (SELECT Amount, Quantity AS mm FROM contoso.Sales WHERE Qty = 3) SELECT Amount, AGG(mm) AS v FROM s GROUP BY Amount
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('Sales'[Amount], "__rows", COUNTROWS('Sales'), "v", 'Sales'[Quantity]), ('Sales'[Qty] = 3)), "Amount", 'Sales'[Amount], "v", [v])
