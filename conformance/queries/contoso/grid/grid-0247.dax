// note: the view expander's grid (tools/ossie/grid.mjs), derived table: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT s.ProductKey, s.v FROM (SELECT t.ProductKey, AGG(t.Returned) AS v FROM contoso.Returns AS t GROUP BY t.ProductKey) AS s WHERE s.v IS NOT NULL
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('Returns'[ProductKey], "__rows", COUNTROWS(Returns), "v", 'Returns'[Returned]), "ProductKey", 'Returns'[ProductKey], "v", [v])
