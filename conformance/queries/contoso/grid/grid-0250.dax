// note: the view expander's grid (tools/ossie/grid.mjs), star where many: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o."Year", AGG(f.Orders) AS v FROM contoso.Sales AS f JOIN contoso."Date" AS o ON f.OrderDate = o."Date" WHERE f.Amount IS NOT NULL GROUP BY o."Year"
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('Date'[Year], "__rows", COUNTROWS('Sales'), "v", 'Sales'[Orders]), NOT(ISBLANK('Sales'[Amount])), NOT(ISBLANK('Date'[Date]))), "Year", 'Date'[Year], "v", [v])
