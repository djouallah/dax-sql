// note: the view expander's grid (tools/ossie/grid.mjs), two groups: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.ReturnQty, t.ProductKey, AGG(t.Returned) AS v FROM contoso.Returns AS t GROUP BY t.ReturnQty, t.ProductKey
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('Returns'[ReturnQty], 'Returns'[ProductKey], "__rows", COUNTROWS('Returns'), "v", 'Returns'[Returned]), "ReturnQty", 'Returns'[ReturnQty], "ProductKey", 'Returns'[ProductKey], "v", [v])
