// note: the view expander's grid (tools/ossie/grid.mjs), where and: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.CustomerKey, AGG(t.Customers) AS v FROM contoso.Sales AS t WHERE t.CustomerKey = 1 AND t.CustomerKey = 99 GROUP BY t.CustomerKey
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('Sales'[CustomerKey], "__rows", COUNTROWS(Sales), "v", 'Sales'[Customers]), ('Sales'[CustomerKey] = 1), ('Sales'[CustomerKey] = 99)), "CustomerKey", 'Sales'[CustomerKey], "v", [v])
