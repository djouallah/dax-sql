// note: the view expander's grid (tools/ossie/grid.mjs), where or: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.CustomerKey, AGG(t."Line Value Column") AS v FROM contoso.Sales AS t WHERE t.ShipDate IN (DATE '2024-03-02', DATE '2024-01-12') OR t.ProductKey < 4 GROUP BY t.CustomerKey
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('Sales'[CustomerKey], "__rows", COUNTROWS('Sales'), "v", 'Sales'[Line Value Column]), (('Sales'[ShipDate] IN {DATE(2024, 3, 2), DATE(2024, 1, 12)}) || ('Sales'[ProductKey] < 4))), "CustomerKey", 'Sales'[CustomerKey], "v", [v])
