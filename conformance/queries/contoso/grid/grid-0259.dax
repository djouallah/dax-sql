// note: the view expander's grid (tools/ossie/grid.mjs), where total: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT AGG(t.Quantity) AS v FROM contoso.Sales AS t WHERE NOT (t.Amount = 1000)
EVALUATE SELECTCOLUMNS(CALCULATETABLE(ROW("v", 'Sales'[Quantity]), NOT(('Sales'[Amount] = 1000))), "v", [v])
