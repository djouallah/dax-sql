// note: the view expander's grid (tools/ossie/grid.mjs), having null: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.CustomerKey, AGG(t."Line Value Column") AS v FROM contoso.Sales AS t GROUP BY t.CustomerKey HAVING AGG(t."Sales Amount") IS NOT NULL
EVALUATE SELECTCOLUMNS(FILTER(SUMMARIZECOLUMNS('Sales'[CustomerKey], "__rows", COUNTROWS('Sales'), "v", 'Sales'[Line Value Column]), NOT(ISBLANK('Sales'[Sales Amount]))), "CustomerKey", 'Sales'[CustomerKey], "v", [v])
