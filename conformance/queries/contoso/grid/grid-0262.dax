// note: the view expander's grid (tools/ossie/grid.mjs), order limit: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.ProductKey, AGG(t.Returned) AS v FROM contoso.Returns AS t GROUP BY t.ProductKey ORDER BY t.ProductKey NULLS FIRST LIMIT 3
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('Returns'[ProductKey], "__rows", COUNTROWS('Returns'), "v", 'Returns'[Returned]), "ProductKey", 'Returns'[ProductKey], "v", [v]) ORDER BY [ProductKey]
