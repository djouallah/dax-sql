// note: the view expander's grid (tools/ossie/grid.mjs), rollup: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.Qty, AGG(t."Line Value Column") AS v FROM contoso.Sales AS t GROUP BY ROLLUP (t.Qty) ORDER BY t.Qty NULLS LAST
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS(ROLLUPADDISSUBTOTAL('Sales'[Qty], "__level1_Qty"), "__rows", COUNTROWS(Sales), "v", 'Sales'[Line Value Column]), "Qty", 'Sales'[Qty], "v", [v]) ORDER BY ISBLANK([Qty]), [Qty]
