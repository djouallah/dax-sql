// note: the view expander's grid (tools/ossie/grid.mjs), star where one: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.Quarter, AGG(f."Line Value Column") AS v FROM contoso.Sales AS f LEFT JOIN contoso."Date" AS o ON f.OrderDate = o."Date" WHERE o."Month" BETWEEN 1 AND 11 GROUP BY o.Quarter
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('Date'[Quarter], "__rows", COUNTROWS(Sales), "v", 'Sales'[Line Value Column]), (('Date'[Month] >= 1) && ('Date'[Month] <= 11))), "Quarter", 'Date'[Quarter], "v", [v])
