// note: the view expander's grid (tools/ossie/grid.mjs), star where many: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.Quarter, AGG(f."Line Value Column") AS v FROM contoso.Sales AS f LEFT JOIN contoso."Date" AS o ON f.OrderDate = o."Date" WHERE f.CustomerKey <> 3 GROUP BY o.Quarter
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('Date'[Quarter], "__rows", COUNTROWS('Sales'), "v", 'Sales'[Line Value Column]), ('Sales'[CustomerKey] <> 3)), "Quarter", 'Date'[Quarter], "v", [v])
