// note: the view expander's grid (tools/ossie/grid.mjs), two groups: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.Target, t.City, AGG(t."Target Total") AS v FROM contoso.CityTarget AS t GROUP BY t.Target, t.City
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('CityTarget'[Target], 'CityTarget'[City], "__rows", COUNTROWS(CityTarget), "v", 'CityTarget'[Target Total]), "Target", 'CityTarget'[Target], "City", 'CityTarget'[City], "v", [v])
