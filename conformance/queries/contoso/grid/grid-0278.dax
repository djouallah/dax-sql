// note: the view expander's grid (tools/ossie/grid.mjs), where: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.CustomerKey, AGG(t.Orders) AS v FROM contoso.Sales AS t WHERE t.CustomerKey <> 1 GROUP BY t.CustomerKey
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('Sales'[CustomerKey], "__rows", COUNTROWS(Sales), "v", 'Sales'[Orders]), ('Sales'[CustomerKey] <> 1)), "CustomerKey", 'Sales'[CustomerKey], "v", [v])
