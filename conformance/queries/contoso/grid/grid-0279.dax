// note: the view expander's grid (tools/ossie/grid.mjs), where and: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.CustomerKey, AGG(t."Line Value Column") AS v FROM contoso.Sales AS t WHERE t.CustomerKey BETWEEN 1 AND 1 AND t.Amount <> 50 GROUP BY t.CustomerKey
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('Sales'[CustomerKey], "__rows", COUNTROWS('Sales'), "v", 'Sales'[Line Value Column]), (('Sales'[CustomerKey] >= 1) && ('Sales'[CustomerKey] <= 1)), ('Sales'[Amount] <> 50)), "CustomerKey", 'Sales'[CustomerKey], "v", [v])
