// note: the view expander's grid (tools/ossie/grid.mjs), having: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.ProductKey, AGG(t.Returned) AS v FROM contoso.Returns AS t GROUP BY t.ProductKey HAVING AGG(t.Returned) > 0
EVALUATE SELECTCOLUMNS(FILTER(SUMMARIZECOLUMNS('Returns'[ProductKey], "__rows", COUNTROWS(Returns), "v", 'Returns'[Returned]), ([v] > 0)), "ProductKey", 'Returns'[ProductKey], "v", [v])
