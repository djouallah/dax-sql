// note: the view expander's grid (tools/ossie/grid.mjs), cte: its SQL as dax-sql's SQL front end writes it in DAX:
// WITH s AS (SELECT CustomerKey, Customers AS mm FROM contoso.Sales WHERE OrderDate <> DATE '2024-03-15') SELECT CustomerKey, AGG(mm) AS v FROM s GROUP BY CustomerKey
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('Sales'[CustomerKey], "__rows", COUNTROWS(Sales), "v", 'Sales'[Customers]), ('Sales'[OrderDate] <> DATE(2024, 3, 15))), "CustomerKey", 'Sales'[CustomerKey], "v", [v])
