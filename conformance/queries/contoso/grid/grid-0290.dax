// note: the view expander's grid (tools/ossie/grid.mjs), derived table: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT s.Target, s.v FROM (SELECT t.Target, AGG(t."Target Total") AS v FROM contoso.CityTarget AS t GROUP BY t.Target) AS s WHERE s.v IS NOT NULL
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('CityTarget'[Target], "__rows", COUNTROWS(CityTarget), "v", 'CityTarget'[Target Total]), "Target", 'CityTarget'[Target], "v", [v])
