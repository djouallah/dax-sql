// note: the view expander's grid (tools/ossie/grid.mjs), star where one: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.Quarter, AGG(f.Orders) AS v FROM contoso.Sales AS f LEFT JOIN contoso."Date" AS o ON f.OrderDate = o."Date" WHERE o."Year" < 2024 GROUP BY o.Quarter
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('Date'[Quarter], "__rows", COUNTROWS(Sales), "v", 'Sales'[Orders]), ('Date'[Year] < 2024)), "Quarter", 'Date'[Quarter], "v", [v])
