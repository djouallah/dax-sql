// note: the view expander's grid (tools/ossie/grid.mjs), star where many: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.Quarter, AGG(f.Orders) AS v FROM contoso.Sales AS f LEFT JOIN contoso."Date" AS o ON f.OrderDate = o."Date" WHERE f.OrderDate BETWEEN DATE '2023-01-15' AND DATE '2023-12-30' GROUP BY o.Quarter
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('Date'[Quarter], "__rows", COUNTROWS(Sales), "v", 'Sales'[Orders]), (('Sales'[OrderDate] >= DATE(2023, 1, 15)) && ('Sales'[OrderDate] <= DATE(2023, 12, 30)))), "Quarter", 'Date'[Quarter], "v", [v])
