// note: the view expander's grid (tools/ossie/grid.mjs), star two sides: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.Quarter, f.ShipDate, AGG(f."Sales Amount") AS v FROM contoso.Sales AS f JOIN contoso."Date" AS o ON f.ShipDate = o."Date" GROUP BY o.Quarter, f.ShipDate
DEFINE
VAR __v1 = GENERATE(SELECTCOLUMNS('Sales', "f.OrderDate", 'Sales'[OrderDate], "f.ShipDate", 'Sales'[ShipDate], "f.ProductKey", 'Sales'[ProductKey], "f.CustomerKey", 'Sales'[CustomerKey], "f.Qty", 'Sales'[Qty], "f.Amount", 'Sales'[Amount]), FILTER(SELECTCOLUMNS('Date', "o.Date", 'Date'[Date], "o.Quarter", 'Date'[Quarter]), ([f.ShipDate] = [o.Date])))
VAR __v2 = DISTINCT(SELECTCOLUMNS(__v1, "Quarter", [o.Quarter], "ShipDate", [f.ShipDate]))
EVALUATE SELECTCOLUMNS(ADDCOLUMNS(__v2, "__m1", CALCULATE('Sales'[Sales Amount], REMOVEFILTERS(), TREATAS(SELECTCOLUMNS(FILTER(__v1, ((NOT((((((ISBLANK([f.OrderDate]) && ISBLANK([f.ShipDate])) && ISBLANK([f.ProductKey])) && ISBLANK([f.CustomerKey])) && ISBLANK([f.Qty])) && ISBLANK([f.Amount]))) && ([o.Quarter] == [Quarter])) && ([f.ShipDate] == [ShipDate]))), "__k1", [f.OrderDate], "__k2", [f.ShipDate], "__k3", [f.ProductKey], "__k4", [f.CustomerKey], "__k5", [f.Qty], "__k6", [f.Amount]), 'Sales'[OrderDate], 'Sales'[ShipDate], 'Sales'[ProductKey], 'Sales'[CustomerKey], 'Sales'[Qty], 'Sales'[Amount]))), "Quarter", [Quarter], "ShipDate", [ShipDate], "v", [__m1])
