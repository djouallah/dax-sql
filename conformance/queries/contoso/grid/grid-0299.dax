// note: the view expander's grid (tools/ossie/grid.mjs), where total: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT AGG(t.Returned) AS v FROM contoso.Returns AS t WHERE t.ProductKey >= 4
EVALUATE SELECTCOLUMNS(CALCULATETABLE(ROW("v", 'Returns'[Returned]), ('Returns'[ProductKey] >= 4)), "v", [v])
