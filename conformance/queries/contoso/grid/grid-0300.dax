// note: the view expander's grid (tools/ossie/grid.mjs), having: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.ReturnQty, AGG(t.Returned) AS v FROM contoso.Returns AS t GROUP BY t.ReturnQty HAVING AGG(t.Returned) > 0
EVALUATE SELECTCOLUMNS(FILTER(SUMMARIZECOLUMNS('Returns'[ReturnQty], "__rows", COUNTROWS('Returns'), "v", 'Returns'[Returned]), ([v] > 0)), "ReturnQty", 'Returns'[ReturnQty], "v", [v])
