// note: the view expander's grid (tools/ossie/grid.mjs), derived table: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT s.City, s.v FROM (SELECT t.City, AGG(t."Target Total") AS v FROM contoso.CityTarget AS t GROUP BY t.City) AS s WHERE s.v IS NOT NULL
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('CityTarget'[City], "__rows", COUNTROWS(CityTarget), "v", 'CityTarget'[Target Total]), "City", 'CityTarget'[City], "v", [v])
