// note: the view expander's grid (tools/ossie/grid.mjs), where and: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.ReturnQty, AGG(t.Returned) AS v FROM contoso.Returns AS t WHERE t.ReturnQty IS NOT NULL AND NOT (t."Date" = DATE '2024-03-20') GROUP BY t.ReturnQty
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('Returns'[ReturnQty], "__rows", COUNTROWS(Returns), "v", 'Returns'[Returned]), NOT(ISBLANK('Returns'[ReturnQty])), NOT(('Returns'[Date] = DATE(2024, 3, 20)))), "ReturnQty", 'Returns'[ReturnQty], "v", [v])
