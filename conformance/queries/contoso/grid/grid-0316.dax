// note: the view expander's grid (tools/ossie/grid.mjs), where total: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT AGG(t.Returned) AS v FROM contoso.Returns AS t WHERE t.ReturnQty BETWEEN 1 AND 1
EVALUATE SELECTCOLUMNS(CALCULATETABLE(ROW("v", 'Returns'[Returned]), (('Returns'[ReturnQty] >= 1) && ('Returns'[ReturnQty] <= 1))), "v", [v])
