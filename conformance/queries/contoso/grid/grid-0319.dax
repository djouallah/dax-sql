// note: the view expander's grid (tools/ossie/grid.mjs), order limit: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.City, AGG(t."Target Total") AS v FROM contoso.CityTarget AS t GROUP BY t.City ORDER BY t.City NULLS FIRST LIMIT 3
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('CityTarget'[City], "__rows", COUNTROWS('CityTarget'), "v", 'CityTarget'[Target Total]), "City", 'CityTarget'[City], "v", [v]) ORDER BY [City]
