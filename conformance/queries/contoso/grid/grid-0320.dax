// note: the view expander's grid (tools/ossie/grid.mjs), order by measure: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.City, AGG(t."Target Total") AS v FROM contoso.CityTarget AS t GROUP BY t.City ORDER BY v DESC NULLS LAST, t.City NULLS FIRST
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('CityTarget'[City], "__rows", COUNTROWS(CityTarget), "v", 'CityTarget'[Target Total]), "City", 'CityTarget'[City], "v", [v]) ORDER BY [v] DESC, [City]
