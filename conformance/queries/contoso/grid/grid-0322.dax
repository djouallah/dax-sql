// note: the view expander's grid (tools/ossie/grid.mjs), rollup: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.City, AGG(t."Target Total") AS v FROM contoso.CityTarget AS t GROUP BY ROLLUP (t.City) ORDER BY t.City NULLS LAST
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS(ROLLUPADDISSUBTOTAL('CityTarget'[City], "__level1_City"), "__rows", COUNTROWS(CityTarget), "v", 'CityTarget'[Target Total]), "City", 'CityTarget'[City], "v", [v]) ORDER BY ISBLANK([City]), [City]
