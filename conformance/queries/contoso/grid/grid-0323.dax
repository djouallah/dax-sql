// note: the view expander's grid (tools/ossie/grid.mjs), cte: its SQL as dax-sql's SQL front end writes it in DAX:
// WITH s AS (SELECT ReturnQty, Returned AS mm FROM contoso.Returns WHERE "Date" IS NOT NULL) SELECT ReturnQty, AGG(mm) AS v FROM s GROUP BY ReturnQty
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('Returns'[ReturnQty], "__rows", COUNTROWS(Returns), "v", 'Returns'[Returned]), NOT(ISBLANK('Returns'[Date]))), "ReturnQty", 'Returns'[ReturnQty], "v", [v])
