// note: the view expander's grid (tools/ossie/grid.mjs), star total: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT AGG(f.Returned) AS v FROM contoso.Returns AS f JOIN contoso.Product AS o ON f.ProductKey = o.ProductKey
EVALUATE SELECTCOLUMNS(CALCULATETABLE(ROW("v", 'Returns'[Returned]), NOT(ISBLANK('Product'[ProductKey]))), "v", [v])
