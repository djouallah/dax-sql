// note: the view expander's grid (tools/ossie/grid.mjs), where and: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.ProductKey, AGG(t.Returned) AS v FROM contoso.Returns AS t WHERE t."Date" <> DATE '2024-03-20' AND t.ProductKey < 2 GROUP BY t.ProductKey
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('Returns'[ProductKey], "__rows", COUNTROWS('Returns'), "v", 'Returns'[Returned]), ('Returns'[Date] <> DATE(2024, 3, 20)), ('Returns'[ProductKey] < 2)), "ProductKey", 'Returns'[ProductKey], "v", [v])
