// note: the view expander's grid (tools/ossie/grid.mjs), where or: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.ProductKey, AGG(t.Returned) AS v FROM contoso.Returns AS t WHERE t.ReturnQty IS NOT NULL OR NOT (t.ReturnQty = 1) GROUP BY t.ProductKey
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('Returns'[ProductKey], "__rows", COUNTROWS(Returns), "v", 'Returns'[Returned]), (NOT(ISBLANK('Returns'[ReturnQty])) || NOT(('Returns'[ReturnQty] = 1)))), "ProductKey", 'Returns'[ProductKey], "v", [v])
