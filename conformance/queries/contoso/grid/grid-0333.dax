// note: the view expander's grid (tools/ossie/grid.mjs), having: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.City, AGG(t."Target Total") AS v FROM contoso.CityTarget AS t GROUP BY t.City HAVING AGG(t."Target Total") > 0
EVALUATE SELECTCOLUMNS(FILTER(SUMMARIZECOLUMNS('CityTarget'[City], "__rows", COUNTROWS('CityTarget'), "v", 'CityTarget'[Target Total]), ([v] > 0)), "City", 'CityTarget'[City], "v", [v])
