// note: the view expander's grid (tools/ossie/grid.mjs), having null: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.Target, AGG(t."Target Total") AS v FROM contoso.CityTarget AS t GROUP BY t.Target HAVING AGG(t."Target Total") IS NOT NULL
EVALUATE SELECTCOLUMNS(FILTER(SUMMARIZECOLUMNS('CityTarget'[Target], "__rows", COUNTROWS('CityTarget'), "v", 'CityTarget'[Target Total]), NOT(ISBLANK([v]))), "Target", 'CityTarget'[Target], "v", [v])
