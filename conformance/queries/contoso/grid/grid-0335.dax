// note: the view expander's grid (tools/ossie/grid.mjs), rollup: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.Target, AGG(t."Target Total") AS v FROM contoso.CityTarget AS t GROUP BY ROLLUP (t.Target) ORDER BY t.Target NULLS LAST
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS(ROLLUPADDISSUBTOTAL('CityTarget'[Target], "__level1_Target"), "__rows", COUNTROWS(CityTarget), "v", 'CityTarget'[Target Total]), "Target", 'CityTarget'[Target], "v", [v]) ORDER BY ISBLANK([Target]), [Target]
