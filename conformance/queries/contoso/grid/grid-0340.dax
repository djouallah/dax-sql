// note: the view expander's grid (tools/ossie/grid.mjs), star two sides: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.Name, f.ProductKey, AGG(f.Returned) AS v FROM contoso.Returns AS f LEFT JOIN contoso.Product AS o ON f.ProductKey = o.ProductKey GROUP BY o.Name, f.ProductKey
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('Product'[Name], 'Returns'[ProductKey], "__rows", COUNTROWS(Returns), "v", 'Returns'[Returned]), "Name", 'Product'[Name], "ProductKey", 'Returns'[ProductKey], "v", [v])
