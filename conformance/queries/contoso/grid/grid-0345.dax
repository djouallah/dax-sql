// note: the view expander's grid (tools/ossie/grid.mjs), where total: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT AGG(t.Returned) AS v FROM contoso.Returns AS t WHERE NOT (t.ProductKey = 2)
EVALUATE SELECTCOLUMNS(CALCULATETABLE(ROW("v", 'Returns'[Returned]), NOT(('Returns'[ProductKey] = 2))), "v", [v])
