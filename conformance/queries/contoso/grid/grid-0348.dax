// note: the view expander's grid (tools/ossie/grid.mjs), star: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.Color, AGG(f.Returned) AS v FROM contoso.Returns AS f LEFT JOIN contoso.Product AS o ON f.ProductKey = o.ProductKey GROUP BY o.Color
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('Product'[Color], "__rows", COUNTROWS(Returns), "v", 'Returns'[Returned]), "Color", 'Product'[Color], "v", [v])
