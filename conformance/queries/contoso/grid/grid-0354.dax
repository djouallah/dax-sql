// note: the view expander's grid (tools/ossie/grid.mjs), where and: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.ReturnQty, AGG(t.Returned) AS v FROM contoso.Returns AS t WHERE t."Date" < DATE '2024-02-20' AND t.ProductKey >= 4 GROUP BY t.ReturnQty
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('Returns'[ReturnQty], "__rows", COUNTROWS('Returns'), "v", 'Returns'[Returned]), ('Returns'[Date] < DATE(2024, 2, 20)), ('Returns'[ProductKey] >= 4)), "ReturnQty", 'Returns'[ReturnQty], "v", [v])
