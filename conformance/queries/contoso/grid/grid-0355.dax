// note: the view expander's grid (tools/ossie/grid.mjs), where or: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.ReturnQty, AGG(t.Returned) AS v FROM contoso.Returns AS t WHERE t."Date" >= DATE '2024-02-20' OR t.ReturnQty <> 1 GROUP BY t.ReturnQty
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('Returns'[ReturnQty], "__rows", COUNTROWS(Returns), "v", 'Returns'[Returned]), (('Returns'[Date] >= DATE(2024, 2, 20)) || ('Returns'[ReturnQty] <> 1))), "ReturnQty", 'Returns'[ReturnQty], "v", [v])
