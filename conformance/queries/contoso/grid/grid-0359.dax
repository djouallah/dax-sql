// note: the view expander's grid (tools/ossie/grid.mjs), star where one: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.Color, AGG(f.Returned) AS v FROM contoso.Returns AS f LEFT JOIN contoso.Product AS o ON f.ProductKey = o.ProductKey WHERE o.Color = 'Red' GROUP BY o.Color
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('Product'[Color], "__rows", COUNTROWS('Returns'), "v", 'Returns'[Returned]), ('Product'[Color] = "Red")), "Color", 'Product'[Color], "v", [v])
