// note: the view expander's grid (tools/ossie/grid.mjs), where and: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.ReturnQty, AGG(t.Returned) AS v FROM contoso.Returns AS t WHERE t.ReturnQty <> 1 AND t."Date" <> DATE '2023-02-15' GROUP BY t.ReturnQty
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('Returns'[ReturnQty], "__rows", COUNTROWS('Returns'), "v", 'Returns'[Returned]), ('Returns'[ReturnQty] <> 1), ('Returns'[Date] <> DATE(2023, 2, 15))), "ReturnQty", 'Returns'[ReturnQty], "v", [v])
