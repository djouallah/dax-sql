// note: the view expander's grid (tools/ossie/grid.mjs), where or: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.ReturnQty, AGG(t.Returned) AS v FROM contoso.Returns AS t WHERE t."Date" = DATE '2023-02-15' OR t.ProductKey IN (2, 2) GROUP BY t.ReturnQty
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('Returns'[ReturnQty], "__rows", COUNTROWS(Returns), "v", 'Returns'[Returned]), (('Returns'[Date] = DATE(2023, 2, 15)) || ('Returns'[ProductKey] IN {2, 2}))), "ReturnQty", 'Returns'[ReturnQty], "v", [v])
