// note: the view expander's grid (tools/ossie/grid.mjs), star where many: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.Color, AGG(f.Returned) AS v FROM contoso.Returns AS f JOIN contoso.Product AS o ON f.ProductKey = o.ProductKey WHERE f.ProductKey < 2 GROUP BY o.Color
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('Product'[Color], "__rows", COUNTROWS('Returns'), "v", 'Returns'[Returned]), ('Returns'[ProductKey] < 2), NOT(ISBLANK('Product'[ProductKey]))), "Color", 'Product'[Color], "v", [v])
