// note: the view expander's grid (tools/ossie/grid.mjs), where: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.Target, AGG(t."Target Total") AS v FROM contoso.CityTarget AS t WHERE t.Target BETWEEN 1000 AND 5000 GROUP BY t.Target
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('CityTarget'[Target], "__rows", COUNTROWS('CityTarget'), "v", 'CityTarget'[Target Total]), (('CityTarget'[Target] >= 1000) && ('CityTarget'[Target] <= 5000))), "Target", 'CityTarget'[Target], "v", [v])
