// note: the view expander's grid (tools/ossie/grid.mjs), where total: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT AGG(t."Target Total") AS v FROM contoso.CityTarget AS t WHERE t.Target BETWEEN 1000 AND 5000
EVALUATE SELECTCOLUMNS(CALCULATETABLE(ROW("v", 'CityTarget'[Target Total]), (('CityTarget'[Target] >= 1000) && ('CityTarget'[Target] <= 5000))), "v", [v])
