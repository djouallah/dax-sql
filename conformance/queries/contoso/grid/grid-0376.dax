// note: the view expander's grid (tools/ossie/grid.mjs), cte: its SQL as dax-sql's SQL front end writes it in DAX:
// WITH s AS (SELECT Target, "Target Total" AS mm FROM contoso.CityTarget WHERE City <> 'Rome') SELECT Target, AGG(mm) AS v FROM s GROUP BY Target
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('CityTarget'[Target], "__rows", COUNTROWS('CityTarget'), "v", 'CityTarget'[Target Total]), ('CityTarget'[City] <> "Rome")), "Target", 'CityTarget'[Target], "v", [v])
