// note: the view expander's grid (tools/ossie/grid.mjs), star where many: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o."Year", AGG(f.Returned) AS v FROM contoso.Returns AS f JOIN contoso."Date" AS o ON f."Date" = o."Date" WHERE f.ReturnQty IS NOT NULL GROUP BY o."Year"
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('Date'[Year], "__rows", COUNTROWS('Returns'), "v", 'Returns'[Returned]), NOT(ISBLANK('Returns'[ReturnQty])), NOT(ISBLANK('Date'[Date]))), "Year", 'Date'[Year], "v", [v])
