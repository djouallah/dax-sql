// note: the view expander's grid (tools/ossie/grid.mjs), star two sides: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o."Month", f."Date", AGG(f.Returned) AS v FROM contoso.Returns AS f LEFT JOIN contoso."Date" AS o ON f."Date" = o."Date" GROUP BY o."Month", f."Date"
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('Date'[Month], 'Returns'[Date], "__rows", COUNTROWS('Returns'), "v", 'Returns'[Returned]), "Month", 'Date'[Month], "Date", 'Returns'[Date], "v", [v])
