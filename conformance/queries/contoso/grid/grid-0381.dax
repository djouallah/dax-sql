// note: the view expander's grid (tools/ossie/grid.mjs), where: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.City, AGG(t."Target Total") AS v FROM contoso.CityTarget AS t WHERE t.City = 'Rome' GROUP BY t.City
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('CityTarget'[City], "__rows", COUNTROWS('CityTarget'), "v", 'CityTarget'[Target Total]), ('CityTarget'[City] = "Rome")), "City", 'CityTarget'[City], "v", [v])
