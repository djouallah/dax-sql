// note: the view expander's grid (tools/ossie/grid.mjs), star where many: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o."Month", AGG(f.Returned) AS v FROM contoso.Returns AS f LEFT JOIN contoso."Date" AS o ON f."Date" = o."Date" WHERE f.ProductKey < 3 GROUP BY o."Month"
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('Date'[Month], "__rows", COUNTROWS(Returns), "v", 'Returns'[Returned]), ('Returns'[ProductKey] < 3)), "Month", 'Date'[Month], "v", [v])
