// note: the view expander's grid (tools/ossie/grid.mjs), where total: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT AGG(t."Target Total") AS v FROM contoso.CityTarget AS t WHERE NOT (t.City = 'Rome')
EVALUATE SELECTCOLUMNS(CALCULATETABLE(ROW("v", 'CityTarget'[Target Total]), NOT(('CityTarget'[City] = "Rome"))), "v", [v])
