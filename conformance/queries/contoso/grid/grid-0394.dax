// note: the view expander's grid (tools/ossie/grid.mjs), cte: its SQL as dax-sql's SQL front end writes it in DAX:
// WITH s AS (SELECT City, "Target Total" AS mm FROM contoso.CityTarget WHERE Target BETWEEN 1000 AND 2000) SELECT City, AGG(mm) AS v FROM s GROUP BY City
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('CityTarget'[City], "__rows", COUNTROWS(CityTarget), "v", 'CityTarget'[Target Total]), (('CityTarget'[Target] >= 1000) && ('CityTarget'[Target] <= 2000))), "City", 'CityTarget'[City], "v", [v])
