// note: the view expander's grid (tools/ossie/grid.mjs), where and: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.Target, AGG(t."Target Total") AS v FROM contoso.CityTarget AS t WHERE NOT (t.City = 'Rome') AND t.Target >= 2000 GROUP BY t.Target
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('CityTarget'[Target], "__rows", COUNTROWS(CityTarget), "v", 'CityTarget'[Target Total]), NOT(('CityTarget'[City] = "Rome")), ('CityTarget'[Target] >= 2000)), "Target", 'CityTarget'[Target], "v", [v])
