// note: CROSSFILTER's direction as the number 3
EVALUATE ROW("products bought in Paris", CALCULATE(COUNTROWS(Product), CROSSFILTER(Sales[ProductKey], Product[ProductKey], 3), Customer[City] = "Paris"),
    "sales of red products", CALCULATE(COUNTROWS(Sales), CROSSFILTER(Sales[ProductKey], Product[ProductKey], 3), Product[Color] = "Red"))
