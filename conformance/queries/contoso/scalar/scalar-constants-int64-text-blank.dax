// note: 64-bit whole-number arithmetic, LEN / LEFT of a number, YEAR(BLANK()), DATEDIFF in weeks across a Sunday, and 1 / BLANK() as infinity (shown as 1E300 when above it)
EVALUATE ROW("a", 100000 * 100000, "b", 2147483647 + 1, "l", LEN(12345), "f", LEFT(12345, 2), "y", YEAR(BLANK()),
    "w", DATEDIFF(dt"2024-03-02", dt"2024-03-03", WEEK), "inf", VAR v = 1 / BLANK() RETURN IF(v > 1E300, 1E300, v))
