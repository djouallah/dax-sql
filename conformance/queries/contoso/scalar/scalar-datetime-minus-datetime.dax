// note: a datetime minus a datetime is in days, with the fraction
EVALUATE ROW("a", (DATE(2024, 1, 2) + 0.25) - (DATE(2024, 1, 1) + 0.75), "b", DATE(2024, 3, 1) - DATE(2024, 2, 1),
    "c", (MAX('Date'[Date]) + 0.5) - MIN('Date'[Date]), "d", 1.0 * ((DATE(2024, 1, 2) + 0.25) - (DATE(2024, 1, 1) + 0.75)))
