// note: FLOOR, CEILING and MROUND to a fractional multiple, where dividing by the multiple in binary lands just under or over a whole number (0.3 / 0.1 is 2.999...)
EVALUATE ROW("a", FLOOR(0.3, 0.1), "b", CEILING(0.7, 0.1), "c", MROUND(0.35, 0.1), "d", FLOOR(1.2, 0.4), "e", CEILING(0.6, 0.2),
    "f", MROUND(1.15, 0.1), "g", FLOOR(-0.3, -0.1), "h", CEILING(2.4, 0.8), "i", MROUND(7.5, 2.5))
