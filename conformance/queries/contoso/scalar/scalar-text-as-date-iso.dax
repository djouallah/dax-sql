// note: text given where a date is expected, in ISO form: YEAR, MONTH, DAY, HOUR, DATEDIFF, EOMONTH, EDATE and WEEKDAY read it as the date
EVALUATE ROW("y", YEAR("2024-03-05"), "m", MONTH("2024-03-05"), "d", DAY("2024-03-05"), "h", HOUR("2024-03-05 13:45:00"),
    "diff", DATEDIFF("2024-01-01", "2024-03-05", DAY), "eom", EOMONTH("2024-03-05", 0), "ed", EDATE("2024-01-31", 1), "wd", WEEKDAY("2024-03-05"))
