// note: ALLEXCEPT as a table (not a CALCULATE modifier): the rows of the table under the filters it keeps
EVALUATE CALCULATETABLE(ROW("color", COUNTROWS(ALLEXCEPT(Product, Product[Color])), "name", COUNTROWS(ALLEXCEPT(Product, Product[Name])),
    "paris", SUMX(FILTER(ALLEXCEPT(Customer, Customer[City]), Customer[City] = "Paris"), [Sales Amount])),
    Product[Color] = "Red", Product[Name] = "Jersey", Customer[City] = "Paris")
