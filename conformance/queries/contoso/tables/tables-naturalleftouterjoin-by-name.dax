// note: NATURALLEFTOUTERJOIN on a same-named computed column without lineage: unmatched left rows kept with blanks
EVALUATE NATURALLEFTOUTERJOIN(SELECTCOLUMNS(Category, "k", Category[CategoryKey] + 0, "Category", Category[Category]), SELECTCOLUMNS(FILTER(Product, Product[Price] > 55), "k", Product[CategoryKey] + 0, "Name", Product[Name]))
