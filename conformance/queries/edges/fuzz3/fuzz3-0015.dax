// note: a random query (conformance/tools/fuzz.mjs edges 150 20261125 fuzz3, number 15)
EVALUATE ADDCOLUMNS(VALUES('Store'[Store]), "m0", MAX(MAX(COALESCE([Total Quantity], 0), CALCULATE([Sales vs Target], INDEX(2, ALL('Date'[Weekend]), ORDERBY('Date'[Weekend], DESC)))), SWITCH(TRUE(), COUNTROWS(FILTER(VALUES('StoreProfile'[Format]), [Avg Per Customer] > 1)) > 1000, CALCULATE([Margin], DATESBETWEEN('Date'[Date], DATE(2023, 3, 10), DATE(2024, 8, 5))), SUMX(SUMMARIZE('Sales', 'Country'[Country]), MAX('Target'[Target])) < 100, [Quantity Or Zero], COUNTROWS(FILTER(VALUES('Product'[Product]), [Total Quantity] > 100)))))
