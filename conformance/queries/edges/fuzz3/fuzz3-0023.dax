// note: a random query (conformance/tools/fuzz.mjs edges 150 20261125 fuzz3, number 23)
// roles: Retail
EVALUATE SUMMARIZECOLUMNS('Date'[Quarter], "m0", [Sales PY], "m1", CALCULATE(ROUND(DISTINCTCOUNT('Date'[Quarter]), 1), SAMEPERIODLASTYEAR('Date'[Date])), "m2", IF(ISBLANK([Quantity Or Zero]), 0, (IF(SELECTEDVALUE('Customer'[Segment]) = "Online", [Target Amount], [Avg Per Customer]) + SWITCH(TRUE(), [Total Weight] > 1, [Sales Amount], [Margin %] < 100, [Sales PY], MIN('Target'[Target])))))
