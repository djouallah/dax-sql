// note: a random query (conformance/tools/fuzz.mjs edges 150 20261125 fuzz3, number 28)
EVALUATE ROW("m0", CALCULATE(LEN(CONCATENATEX(VALUES('Date'[Year]), 'Date'[Year], ",")), USERELATIONSHIP('Sales'[Ship Date], 'Date'[Date]), PARALLELPERIOD('Date'[Date], 1, QUARTER)), "m1", CALCULATE(DIVIDE(CALCULATE([Target Amount], INDEX(1, ALL('StoreProfile'[Format]), ORDERBY('StoreProfile'[Format], ASC))), IF(ISBLANK([Margin]), 0, AVERAGE('Sales'[Discount]))), 'StoreProfile'[Format] = "Flagship"))
