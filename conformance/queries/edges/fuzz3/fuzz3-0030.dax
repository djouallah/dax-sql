// note: a random query (conformance/tools/fuzz.mjs edges 150 20261125 fuzz3, number 30)
// roles: Retail
EVALUATE SUMMARIZECOLUMNS('Date'[Weekend], TREATAS({ "Brisbane" }, 'Customer'[City]), FILTER(ALL('Customer'[City]), 'Customer'[City] <> "Kyoto"), "m0", SWITCH(TRUE(), TOTALYTD(AVERAGE('Sales'[Discount]), 'Date'[Date]) > 100, [Margin %], (COUNTROWS('Customer') + COUNTROWS('Sales')) < 100, IF(ISINSCOPE('Product'[Color]), [Sales YTD], MAX('Target'[Target])), [Margin]), "m1", [Sales YoY %])
