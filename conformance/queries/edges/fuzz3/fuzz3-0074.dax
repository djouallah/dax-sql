// note: a random query (conformance/tools/fuzz.mjs edges 150 20261125 fuzz3, number 74)
EVALUATE TOPN(4, ADDCOLUMNS(VALUES('Customer'[Segment]), "m0", SWITCH(TRUE(), CALCULATE([Lines], DATEADD('Date'[Date], -1, QUARTER)) > 100, CALCULATE(CALCULATE(AVERAGE('Sales'[Unit Price]), KEEPFILTERS('Date'[Month] IN { 3, 1, 10 }), TREATAS({ "Céladon" }, 'Product'[Color])), ALLSELECTED('Customer'[City])), IF(ISINSCOPE('Region'[Region]), COUNTROWS(FILTER(VALUES('StoreProfile'[Format]), [Sales YTD] > 10)), SUM('Sales'[Discount])) < 100, SWITCH(TRUE(), [Sales Amount] > 1000, CALCULATE(MIN('Sales'[Quantity]), DATESINPERIOD('Date'[Date], DATE(2024, 3, 24), -3, QUARTER), ALLEXCEPT('Store', 'Store'[Store])), CALCULATE(COUNTROWS('Product'), INDEX(1, ALL('Product'[Brand]), ORDERBY('Product'[Brand], ASC))) < 0, ([Customers] - AVERAGE('Target'[Target])), COALESCE([Share In Scope], 0)), ABS([Sales YoY %]))), [m0], DESC, 'Customer'[Segment], ASC)
