// note: a random query (conformance/tools/fuzz.mjs edges 150 20261125 fuzz3, number 77)
EVALUATE SUMMARIZECOLUMNS('Date'[Year], "m0", CALCULATE(SWITCH(TRUE(), SWITCH(TRUE(), [Sales vs Target] > 1, SUM('Sales'[Quantity]), COUNTROWS('Sales') < 100, AVERAGE('Sales'[Unit Price]), [Total Quantity]) > 0, CALCULATE(AVERAGE('Target'[Target]), DATESBETWEEN('Date'[Date], DATE(1999, 1, 1), DATE(2023, 9, 8))), COUNTROWS(FILTER(VALUES('Product'[Brand]), [Margin %] > 100)) < 0, ROUND([Sales Amount], 1), DIVIDE([Avg Per Customer], CALCULATE([Share In Scope], ALL('Store'[Store])))), PARALLELPERIOD('Date'[Date], -1, YEAR)))
