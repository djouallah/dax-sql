// note: a random query (conformance/tools/fuzz.mjs edges 150 20261125 fuzz3, number 91)
EVALUATE ROW("m0", CALCULATE(VAR v = RANKX(ALL('Product'[Color]), [Total Quantity]) RETURN v * 2 + VAR v = [Shipped Amount] RETURN v * 2 + [Margin], INDEX(1, ALL('Country'[Country]), ORDERBY('Country'[Country], ASC))), "m1", SWITCH(TRUE(), [Sales Amount] > 1000, SUMX(SUMMARIZE('Sales', 'Customer'[City]), COUNTROWS(FILTER(VALUES('Country'[Country]), [Sales YoY %] > 0))), MAX(CALCULATE([Margin %], DATESBETWEEN('Date'[Date], DATE(2024, 7, 30), DATE(2024, 7, 20))), IF(MAX('Sales'[Unit Price]) > 1000, MIN('Target'[Target]), MIN('Sales'[Discount]))) < 100, CALCULATE(AVERAGE('Sales'[Discount]), KEEPFILTERS('Date'[Weekend] = TRUE())), CALCULATE(CALCULATE([Customers No Blank], INDEX(2, ALL('StoreProfile'[Format]), ORDERBY('StoreProfile'[Format], DESC))), NOT('Region'[Region] IN { "Europe" }))))
