// note: a random query (conformance/tools/fuzz.mjs edges 150 20261125 fuzz3, number 98)
EVALUATE SUMMARIZE('Sales', 'Date'[Quarter], 'Customer'[Segment], "m0", CALCULATE(SWITCH(TRUE(), COUNTROWS('Customer') > 10, [Target Amount], MAX('Target'[Target]) < 100, [Sales vs Target], [Customers No Blank]), KEEPFILTERS('StoreProfile'[Format] = "Flagship")))
