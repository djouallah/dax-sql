// note: a random query (conformance/tools/fuzz.mjs edges 150 20261125 fuzz3, number 131)
EVALUATE TOPN(3, ADDCOLUMNS(VALUES('StoreProfile'[Format]), "m0", IF(OR(SWITCH(TRUE(), [Sales Amount] > 0, [Share In Scope], [Total Weight] < 10, [Sales YTD], [Total Weight]) > 1, NOT(ISBLANK(MAX([Customers No Blank], [Margin %])))), DISTINCTCOUNT('Store'[Store]), CALCULATE([Big Customers], INDEX(-1, ALL('Date'[Year]), ORDERBY('Date'[Year], ASC))))), [m0], DESC, 'StoreProfile'[Format], ASC)
