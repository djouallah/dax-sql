// note: a random query (conformance/tools/fuzz.mjs edges 150 20261125 fuzz3, number 138)
EVALUATE ADDCOLUMNS(CROSSJOIN(VALUES('Date'[Year]), VALUES('Date'[Month])), "m0", ABS(COUNTROWS(GENERATE(VALUES('StoreProfile'[Format]), TOPN(1, VALUES('Product'[Brand]), CALCULATE([Big Customers], PARALLELPERIOD('Date'[Date], -1, QUARTER)))))))
