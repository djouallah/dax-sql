// note: the view expander's grid (tools/ossie/grid.mjs), two metrics: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.CustomerKey, AGG(t.Lines) AS a, AGG(t.Lines) AS b FROM "dax-conformance-edges".Sales AS t GROUP BY t.CustomerKey
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('Sales'[CustomerKey], "__rows", COUNTROWS('Sales'), "a", 'Sales'[Lines], "b", 'Sales'[Lines]), "CustomerKey", 'Sales'[CustomerKey], "a", [a], "b", [b])
