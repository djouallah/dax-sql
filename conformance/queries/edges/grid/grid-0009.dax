// note: the view expander's grid (tools/ossie/grid.mjs), two groups: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.CustomerKey, t.Quantity, AGG(t."Total Cost") AS v FROM "dax-conformance-edges".Sales AS t GROUP BY t.CustomerKey, t.Quantity
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('Sales'[CustomerKey], 'Sales'[Quantity], "__rows", COUNTROWS(Sales), "v", 'Sales'[Total Cost]), "CustomerKey", 'Sales'[CustomerKey], "Quantity", 'Sales'[Quantity], "v", [v])
