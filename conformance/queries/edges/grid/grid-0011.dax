// note: the view expander's grid (tools/ossie/grid.mjs), where and: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.CustomerKey, AGG(t."Customers No Blank") AS v FROM "dax-conformance-edges".Sales AS t WHERE t."Line Number" BETWEEN 1 AND 2 AND t."Loyalty Points" <> 25 GROUP BY t.CustomerKey
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('Sales'[CustomerKey], "__rows", COUNTROWS('Sales'), "v", 'Sales'[Customers No Blank]), (('Sales'[Line Number] >= 1) && ('Sales'[Line Number] <= 2)), ('Sales'[Loyalty Points] <> 25)), "CustomerKey", 'Sales'[CustomerKey], "v", [v])
