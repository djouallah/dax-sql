// note: the view expander's grid (tools/ossie/grid.mjs), where total: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT AGG(t."Total Quantity") AS v FROM "dax-conformance-edges".Sales AS t WHERE t."Order Date" IN (DATE '2024-02-12', DATE '2024-01-12')
EVALUATE SELECTCOLUMNS(CALCULATETABLE(ROW("v", 'Sales'[Total Quantity]), ('Sales'[Order Date] IN {DATE(2024, 2, 12), DATE(2024, 1, 12)})), "v", [v])
