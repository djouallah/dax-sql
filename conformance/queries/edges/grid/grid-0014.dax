// note: the view expander's grid (tools/ossie/grid.mjs), having: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.CustomerKey, AGG(t."Total Cost") AS v FROM "dax-conformance-edges".Sales AS t GROUP BY t.CustomerKey HAVING AGG(t."Customers No Blank") > 0
EVALUATE SELECTCOLUMNS(FILTER(SUMMARIZECOLUMNS('Sales'[CustomerKey], "__rows", COUNTROWS(Sales), "v", 'Sales'[Total Cost]), ('Sales'[Customers No Blank] > 0)), "CustomerKey", 'Sales'[CustomerKey], "v", [v])
