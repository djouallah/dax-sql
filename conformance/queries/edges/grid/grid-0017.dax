// note: the view expander's grid (tools/ossie/grid.mjs), order by measure: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.CustomerKey, AGG(t."Sales Amount") AS v FROM "dax-conformance-edges".Sales AS t GROUP BY t.CustomerKey ORDER BY v DESC NULLS LAST, t.CustomerKey NULLS FIRST
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('Sales'[CustomerKey], "__rows", COUNTROWS(Sales), "v", 'Sales'[Sales Amount]), "CustomerKey", 'Sales'[CustomerKey], "v", [v]) ORDER BY [v] DESC, [CustomerKey]
