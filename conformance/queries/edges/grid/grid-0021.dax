// note: the view expander's grid (tools/ossie/grid.mjs), ratio: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.CustomerKey, CAST(AGG(t."Total Quantity") AS DOUBLE) / NULLIF(AGG(t.Lines), 0) AS r FROM "dax-conformance-edges".Sales AS t GROUP BY t.CustomerKey
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('Sales'[CustomerKey], "__rows", COUNTROWS(Sales), "r", IF(ISBLANK(COUNTROWS(Sales)), BLANK(), (CONVERT('Sales'[Total Quantity], DOUBLE) / IF(('Sales'[Lines] == 0), BLANK(), 'Sales'[Lines])))), "CustomerKey", 'Sales'[CustomerKey], "r", [r])
