// note: the view expander's grid (tools/ossie/grid.mjs), cte: its SQL as dax-sql's SQL front end writes it in DAX:
// WITH s AS (SELECT CustomerKey, Lines AS mm FROM "dax-conformance-edges".Sales WHERE "Order Date" >= DATE '2023-11-07') SELECT CustomerKey, AGG(mm) AS v FROM s GROUP BY CustomerKey
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('Sales'[CustomerKey], "__rows", COUNTROWS(Sales), "v", 'Sales'[Lines]), ('Sales'[Order Date] >= DATE(2023, 11, 7))), "CustomerKey", 'Sales'[CustomerKey], "v", [v])
