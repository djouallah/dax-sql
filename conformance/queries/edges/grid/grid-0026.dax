// note: the view expander's grid (tools/ossie/grid.mjs), where: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.CustomerKey, AGG(t."Customers No Blank") AS v FROM "dax-conformance-edges".Sales AS t WHERE t.Discount IN (0.1, 0.25) GROUP BY t.CustomerKey
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('Sales'[CustomerKey], "__rows", COUNTROWS(Sales), "v", 'Sales'[Customers No Blank]), ('Sales'[Discount] IN {0.1, 0.25})), "CustomerKey", 'Sales'[CustomerKey], "v", [v])
