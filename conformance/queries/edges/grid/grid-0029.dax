// note: the view expander's grid (tools/ossie/grid.mjs), where total: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT AGG(t.Lines) AS v FROM "dax-conformance-edges".Sales AS t WHERE t."Order Date" BETWEEN DATE '2023-01-04' AND DATE '2023-09-30'
EVALUATE SELECTCOLUMNS(CALCULATETABLE(ROW("v", 'Sales'[Lines]), (('Sales'[Order Date] >= DATE(2023, 1, 4)) && ('Sales'[Order Date] <= DATE(2023, 9, 30)))), "v", [v])
