// note: the view expander's grid (tools/ossie/grid.mjs), having null: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.CustomerKey, AGG(t.Lines) AS v FROM "dax-conformance-edges".Sales AS t GROUP BY t.CustomerKey HAVING AGG(t.Customers) IS NOT NULL
EVALUATE SELECTCOLUMNS(FILTER(SUMMARIZECOLUMNS('Sales'[CustomerKey], "__rows", COUNTROWS(Sales), "v", 'Sales'[Lines]), NOT(ISBLANK('Sales'[Customers]))), "CustomerKey", 'Sales'[CustomerKey], "v", [v])
