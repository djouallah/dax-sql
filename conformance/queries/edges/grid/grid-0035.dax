// note: the view expander's grid (tools/ossie/grid.mjs), rollup: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.Quantity, AGG(t.Lines) AS v FROM "dax-conformance-edges".Sales AS t GROUP BY ROLLUP (t.Quantity) ORDER BY t.Quantity NULLS LAST
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS(ROLLUPADDISSUBTOTAL('Sales'[Quantity], "__level1_Quantity"), "__rows", COUNTROWS(Sales), "v", 'Sales'[Lines]), "Quantity", 'Sales'[Quantity], "v", [v]) ORDER BY ISBLANK([Quantity]), [Quantity]
