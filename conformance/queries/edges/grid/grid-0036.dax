// note: the view expander's grid (tools/ossie/grid.mjs), scalar ops: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.CustomerKey, AGG(t.Customers) * 2 AS a, AGG(t.Customers) + 1 AS b, COALESCE(AGG(t.Customers), 0) AS c FROM "dax-conformance-edges".Sales AS t GROUP BY t.CustomerKey
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('Sales'[CustomerKey], "__rows", COUNTROWS('Sales'), "a", ('Sales'[Customers] * 2), "b", ('Sales'[Customers] + 1), "c", IF(ISBLANK(COUNTROWS('Sales')), BLANK(), COALESCE('Sales'[Customers], 0))), "CustomerKey", 'Sales'[CustomerKey], "a", [a], "b", [b], "c", [c])
