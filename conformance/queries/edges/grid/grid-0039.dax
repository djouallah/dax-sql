// note: the view expander's grid (tools/ossie/grid.mjs), derived table: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT s.CustomerKey, s.v FROM (SELECT t.CustomerKey, AGG(t.Lines) AS v FROM "dax-conformance-edges".Sales AS t GROUP BY t.CustomerKey) AS s WHERE s.v IS NOT NULL
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('Sales'[CustomerKey], "__rows", COUNTROWS(Sales), "v", 'Sales'[Lines]), "CustomerKey", 'Sales'[CustomerKey], "v", [v])
