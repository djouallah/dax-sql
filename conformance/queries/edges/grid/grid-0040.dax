// note: the view expander's grid (tools/ossie/grid.mjs), group: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.StoreKey, AGG(t."Sales Amount") AS v FROM "dax-conformance-edges".Sales AS t GROUP BY t.StoreKey
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('Sales'[StoreKey], "__rows", COUNTROWS(Sales), "v", 'Sales'[Sales Amount]), "StoreKey", 'Sales'[StoreKey], "v", [v])
