// note: the view expander's grid (tools/ossie/grid.mjs), two metrics: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.StoreKey, AGG(t.Customers) AS a, AGG(t.Lines) AS b FROM "dax-conformance-edges".Sales AS t GROUP BY t.StoreKey
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('Sales'[StoreKey], "__rows", COUNTROWS('Sales'), "a", 'Sales'[Customers], "b", 'Sales'[Lines]), "StoreKey", 'Sales'[StoreKey], "a", [a], "b", [b])
