// note: the view expander's grid (tools/ossie/grid.mjs), two groups: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.StoreKey, t.Promo, AGG(t."Total Quantity") AS v FROM "dax-conformance-edges".Sales AS t GROUP BY t.StoreKey, t.Promo
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('Sales'[StoreKey], 'Sales'[Promo], "__rows", COUNTROWS('Sales'), "v", 'Sales'[Total Quantity]), "StoreKey", 'Sales'[StoreKey], "Promo", 'Sales'[Promo], "v", [v])
