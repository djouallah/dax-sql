// note: the view expander's grid (tools/ossie/grid.mjs), where: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.StoreKey, AGG(t."Customers No Blank") AS v FROM "dax-conformance-edges".Sales AS t WHERE t."Unit Price" BETWEEN 0 AND 9.99 GROUP BY t.StoreKey
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('Sales'[StoreKey], "__rows", COUNTROWS(Sales), "v", 'Sales'[Customers No Blank]), (('Sales'[Unit Price] >= 0) && ('Sales'[Unit Price] <= 9.99))), "StoreKey", 'Sales'[StoreKey], "v", [v])
