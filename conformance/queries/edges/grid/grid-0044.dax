// note: the view expander's grid (tools/ossie/grid.mjs), where and: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.StoreKey, AGG(t."Sales Amount") AS v FROM "dax-conformance-edges".Sales AS t WHERE t.StoreKey <> 'XXX-99' AND t.StoreKey <> 'PAR-02' GROUP BY t.StoreKey
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('Sales'[StoreKey], "__rows", COUNTROWS('Sales'), "v", 'Sales'[Sales Amount]), ('Sales'[StoreKey] <> "XXX-99"), ('Sales'[StoreKey] <> "PAR-02")), "StoreKey", 'Sales'[StoreKey], "v", [v])
