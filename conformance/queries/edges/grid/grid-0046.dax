// note: the view expander's grid (tools/ossie/grid.mjs), where total: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT AGG(t."Sales Amount") AS v FROM "dax-conformance-edges".Sales AS t WHERE t.StoreKey <> 'TYO-01'
EVALUATE SELECTCOLUMNS(CALCULATETABLE(ROW("v", 'Sales'[Sales Amount]), ('Sales'[StoreKey] <> "TYO-01")), "v", [v])
