// note: the view expander's grid (tools/ossie/grid.mjs), order limit: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.StoreKey, AGG(t."Total Cost") AS v FROM "dax-conformance-edges".Sales AS t GROUP BY t.StoreKey ORDER BY t.StoreKey NULLS FIRST LIMIT 3
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('Sales'[StoreKey], "__rows", COUNTROWS(Sales), "v", 'Sales'[Total Cost]), "StoreKey", 'Sales'[StoreKey], "v", [v]) ORDER BY [StoreKey]
