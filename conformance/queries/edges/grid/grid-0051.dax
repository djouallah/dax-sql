// note: the view expander's grid (tools/ossie/grid.mjs), group by all: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.StoreKey, AGG(t."Total Cost") AS v FROM "dax-conformance-edges".Sales AS t GROUP BY ALL
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('Sales'[StoreKey], "__rows", COUNTROWS('Sales'), "v", 'Sales'[Total Cost]), "StoreKey", 'Sales'[StoreKey], "v", [v])
