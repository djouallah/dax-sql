// note: the view expander's grid (tools/ossie/grid.mjs), rollup: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t."Line Number", AGG(t.Lines) AS v FROM "dax-conformance-edges".Sales AS t GROUP BY ROLLUP (t."Line Number") ORDER BY t."Line Number" NULLS LAST
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS(ROLLUPADDISSUBTOTAL('Sales'[Line Number], "__level1_Line Number"), "__rows", COUNTROWS(Sales), "v", 'Sales'[Lines]), "Line Number", 'Sales'[Line Number], "v", [v]) ORDER BY ISBLANK([Line Number]), [Line Number]
