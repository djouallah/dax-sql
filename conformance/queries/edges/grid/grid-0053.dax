// note: the view expander's grid (tools/ossie/grid.mjs), scalar ops: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.StoreKey, AGG(t."Sales Amount") * 2 AS a, AGG(t."Sales Amount") + 1 AS b, COALESCE(AGG(t."Sales Amount"), 0) AS c FROM "dax-conformance-edges".Sales AS t GROUP BY t.StoreKey
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('Sales'[StoreKey], "__rows", COUNTROWS(Sales), "a", ('Sales'[Sales Amount] * 2), "b", ('Sales'[Sales Amount] + 1), "c", IF(ISBLANK(COUNTROWS(Sales)), BLANK(), COALESCE('Sales'[Sales Amount], 0))), "StoreKey", 'Sales'[StoreKey], "a", [a], "b", [b], "c", [c])
