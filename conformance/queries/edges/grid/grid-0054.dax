// note: the view expander's grid (tools/ossie/grid.mjs), ratio: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.StoreKey, CAST(AGG(t."Total Cost") AS DOUBLE) / NULLIF(AGG(t."Total Cost"), 0) AS r FROM "dax-conformance-edges".Sales AS t GROUP BY t.StoreKey
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('Sales'[StoreKey], "__rows", COUNTROWS('Sales'), "r", IF(ISBLANK(COUNTROWS('Sales')), BLANK(), (CONVERT('Sales'[Total Cost], DOUBLE) / IF(('Sales'[Total Cost] == 0), BLANK(), 'Sales'[Total Cost])))), "StoreKey", 'Sales'[StoreKey], "r", [r])
