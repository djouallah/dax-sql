// note: the view expander's grid (tools/ossie/grid.mjs), cte: its SQL as dax-sql's SQL front end writes it in DAX:
// WITH s AS (SELECT StoreKey, "Customers No Blank" AS mm FROM "dax-conformance-edges".Sales WHERE NOT (StoreKey = 'PAR-02')) SELECT StoreKey, AGG(mm) AS v FROM s GROUP BY StoreKey
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('Sales'[StoreKey], "__rows", COUNTROWS(Sales), "v", 'Sales'[Customers No Blank]), NOT(('Sales'[StoreKey] = "PAR-02"))), "StoreKey", 'Sales'[StoreKey], "v", [v])
