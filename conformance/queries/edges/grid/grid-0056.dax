// note: the view expander's grid (tools/ossie/grid.mjs), derived table: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT s.StoreKey, s.v FROM (SELECT t.StoreKey, AGG(t.Lines) AS v FROM "dax-conformance-edges".Sales AS t GROUP BY t.StoreKey) AS s WHERE s.v IS NOT NULL
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('Sales'[StoreKey], "__rows", COUNTROWS('Sales'), "v", 'Sales'[Lines]), "StoreKey", 'Sales'[StoreKey], "v", [v])
