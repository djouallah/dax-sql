// note: the view expander's grid (tools/ossie/grid.mjs), where and: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t."Line Number", AGG(t."Sales Amount") AS v FROM "dax-conformance-edges".Sales AS t WHERE t."Unit Price" BETWEEN 0 AND 89.5 AND t."Order Number" BETWEEN 1 AND 35 GROUP BY t."Line Number"
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('Sales'[Line Number], "__rows", COUNTROWS(Sales), "v", 'Sales'[Sales Amount]), (('Sales'[Unit Price] >= 0) && ('Sales'[Unit Price] <= 89.5)), (('Sales'[Order Number] >= 1) && ('Sales'[Order Number] <= 35))), "Line Number", 'Sales'[Line Number], "v", [v])
