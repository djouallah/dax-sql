// note: the view expander's grid (tools/ossie/grid.mjs), where or: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t."Line Number", AGG(t."Customers No Blank") AS v FROM "dax-conformance-edges".Sales AS t WHERE NOT (t.Discount = 0) OR t."Unit Price" IN (18.75, 12.5) GROUP BY t."Line Number"
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('Sales'[Line Number], "__rows", COUNTROWS(Sales), "v", 'Sales'[Customers No Blank]), (NOT(('Sales'[Discount] = 0)) || ('Sales'[Unit Price] IN {18.75, 12.5}))), "Line Number", 'Sales'[Line Number], "v", [v])
