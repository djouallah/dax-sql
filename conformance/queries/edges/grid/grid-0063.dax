// note: the view expander's grid (tools/ossie/grid.mjs), where total: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT AGG(t."Customers No Blank") AS v FROM "dax-conformance-edges".Sales AS t WHERE t.Promo <> FALSE
EVALUATE SELECTCOLUMNS(CALCULATETABLE(ROW("v", 'Sales'[Customers No Blank]), ('Sales'[Promo] <> FALSE())), "v", [v])
