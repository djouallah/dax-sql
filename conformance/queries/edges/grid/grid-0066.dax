// note: the view expander's grid (tools/ossie/grid.mjs), order limit: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t."Line Number", AGG(t.Lines) AS v FROM "dax-conformance-edges".Sales AS t GROUP BY t."Line Number" ORDER BY t."Line Number" NULLS FIRST LIMIT 3
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('Sales'[Line Number], "__rows", COUNTROWS('Sales'), "v", 'Sales'[Lines]), "Line Number", 'Sales'[Line Number], "v", [v]) ORDER BY [Line Number]
