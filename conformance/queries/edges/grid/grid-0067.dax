// note: the view expander's grid (tools/ossie/grid.mjs), order by measure: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t."Line Number", AGG(t."Total Quantity") AS v FROM "dax-conformance-edges".Sales AS t GROUP BY t."Line Number" ORDER BY v DESC NULLS LAST, t."Line Number" NULLS FIRST
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('Sales'[Line Number], "__rows", COUNTROWS(Sales), "v", 'Sales'[Total Quantity]), "Line Number", 'Sales'[Line Number], "v", [v]) ORDER BY [v] DESC, [Line Number]
