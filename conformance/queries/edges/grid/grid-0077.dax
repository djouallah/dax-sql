// note: the view expander's grid (tools/ossie/grid.mjs), where: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t."Line Number", AGG(t.Customers) AS v FROM "dax-conformance-edges".Sales AS t WHERE t."Unit Price" <> 29.99 GROUP BY t."Line Number"
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('Sales'[Line Number], "__rows", COUNTROWS(Sales), "v", 'Sales'[Customers]), ('Sales'[Unit Price] <> 29.99)), "Line Number", 'Sales'[Line Number], "v", [v])
