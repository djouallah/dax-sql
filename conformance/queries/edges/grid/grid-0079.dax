// note: the view expander's grid (tools/ossie/grid.mjs), where or: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t."Line Number", AGG(t."Total Cost") AS v FROM "dax-conformance-edges".Sales AS t WHERE t.StoreKey IN ('PAR-01', 'PAR-02') OR NOT (t.Quantity = 0) GROUP BY t."Line Number"
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('Sales'[Line Number], "__rows", COUNTROWS(Sales), "v", 'Sales'[Total Cost]), (('Sales'[StoreKey] IN {"PAR-01", "PAR-02"}) || NOT(('Sales'[Quantity] = 0)))), "Line Number", 'Sales'[Line Number], "v", [v])
