// note: the view expander's grid (tools/ossie/grid.mjs), having null: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t."Line Number", AGG(t.Lines) AS v FROM "dax-conformance-edges".Sales AS t GROUP BY t."Line Number" HAVING AGG(t."Total Cost") IS NOT NULL
EVALUATE SELECTCOLUMNS(FILTER(SUMMARIZECOLUMNS('Sales'[Line Number], "__rows", COUNTROWS('Sales'), "v", 'Sales'[Lines]), NOT(ISBLANK('Sales'[Total Cost]))), "Line Number", 'Sales'[Line Number], "v", [v])
