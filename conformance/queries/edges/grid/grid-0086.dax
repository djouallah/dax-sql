// note: the view expander's grid (tools/ossie/grid.mjs), ratio: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t."Line Number", CAST(AGG(t."Total Quantity") AS DOUBLE) / NULLIF(AGG(t."Total Cost"), 0) AS r FROM "dax-conformance-edges".Sales AS t GROUP BY t."Line Number"
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('Sales'[Line Number], "__rows", COUNTROWS('Sales'), "r", IF(ISBLANK(COUNTROWS('Sales')), BLANK(), (CONVERT('Sales'[Total Quantity], DOUBLE) / IF(('Sales'[Total Cost] == 0), BLANK(), 'Sales'[Total Cost])))), "Line Number", 'Sales'[Line Number], "r", [r])
