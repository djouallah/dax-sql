// note: the view expander's grid (tools/ossie/grid.mjs), two groups: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.Quantity, t.Promo, AGG(t.Lines) AS v FROM "dax-conformance-edges".Sales AS t GROUP BY t.Quantity, t.Promo
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('Sales'[Quantity], 'Sales'[Promo], "__rows", COUNTROWS('Sales'), "v", 'Sales'[Lines]), "Quantity", 'Sales'[Quantity], "Promo", 'Sales'[Promo], "v", [v])
