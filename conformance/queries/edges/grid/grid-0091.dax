// note: the view expander's grid (tools/ossie/grid.mjs), where: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.Quantity, AGG(t."Total Cost") AS v FROM "dax-conformance-edges".Sales AS t WHERE t."Order Date" IS NOT NULL GROUP BY t.Quantity
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('Sales'[Quantity], "__rows", COUNTROWS(Sales), "v", 'Sales'[Total Cost]), NOT(ISBLANK('Sales'[Order Date]))), "Quantity", 'Sales'[Quantity], "v", [v])
