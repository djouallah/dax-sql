// note: the view expander's grid (tools/ossie/grid.mjs), where and: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.Quantity, AGG(t."Customers No Blank") AS v FROM "dax-conformance-edges".Sales AS t WHERE t.CustomerKey IN (8, 21) AND t."Order Number" <> 179 GROUP BY t.Quantity
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('Sales'[Quantity], "__rows", COUNTROWS('Sales'), "v", 'Sales'[Customers No Blank]), ('Sales'[CustomerKey] IN {8, 21}), ('Sales'[Order Number] <> 179)), "Quantity", 'Sales'[Quantity], "v", [v])
