// note: the view expander's grid (tools/ossie/grid.mjs), where total: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT AGG(t.Customers) AS v FROM "dax-conformance-edges".Sales AS t WHERE t."Unit Price" IN (149, 225)
EVALUATE SELECTCOLUMNS(CALCULATETABLE(ROW("v", 'Sales'[Customers]), ('Sales'[Unit Price] IN {149, 225})), "v", [v])
