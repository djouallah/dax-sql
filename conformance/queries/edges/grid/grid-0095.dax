// note: the view expander's grid (tools/ossie/grid.mjs), having: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.Quantity, AGG(t.Customers) AS v FROM "dax-conformance-edges".Sales AS t GROUP BY t.Quantity HAVING AGG(t."Customers No Blank") > 0
EVALUATE SELECTCOLUMNS(FILTER(SUMMARIZECOLUMNS('Sales'[Quantity], "__rows", COUNTROWS(Sales), "v", 'Sales'[Customers]), ('Sales'[Customers No Blank] > 0)), "Quantity", 'Sales'[Quantity], "v", [v])
