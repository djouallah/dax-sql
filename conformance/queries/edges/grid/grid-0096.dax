// note: the view expander's grid (tools/ossie/grid.mjs), having null: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.Quantity, AGG(t."Customers No Blank") AS v FROM "dax-conformance-edges".Sales AS t GROUP BY t.Quantity HAVING AGG(t.Lines) IS NOT NULL
EVALUATE SELECTCOLUMNS(FILTER(SUMMARIZECOLUMNS('Sales'[Quantity], "__rows", COUNTROWS('Sales'), "v", 'Sales'[Customers No Blank]), NOT(ISBLANK('Sales'[Lines]))), "Quantity", 'Sales'[Quantity], "v", [v])
