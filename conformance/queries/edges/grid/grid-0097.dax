// note: the view expander's grid (tools/ossie/grid.mjs), order limit: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.Quantity, AGG(t."Total Cost") AS v FROM "dax-conformance-edges".Sales AS t GROUP BY t.Quantity ORDER BY t.Quantity NULLS FIRST LIMIT 3
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('Sales'[Quantity], "__rows", COUNTROWS(Sales), "v", 'Sales'[Total Cost]), "Quantity", 'Sales'[Quantity], "v", [v]) ORDER BY [Quantity]
