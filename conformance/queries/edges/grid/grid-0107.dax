// note: the view expander's grid (tools/ossie/grid.mjs), two groups: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.StoreKey, t.Brand, AGG(t."Target Amount") AS v FROM "dax-conformance-edges".Target AS t GROUP BY t.StoreKey, t.Brand
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('Target'[StoreKey], 'Target'[Brand], "__rows", COUNTROWS('Target'), "v", 'Target'[Target Amount]), "StoreKey", 'Target'[StoreKey], "Brand", 'Target'[Brand], "v", [v])
