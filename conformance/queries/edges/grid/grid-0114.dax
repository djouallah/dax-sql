// note: the view expander's grid (tools/ossie/grid.mjs), order limit: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.StoreKey, AGG(t."Target Amount") AS v FROM "dax-conformance-edges".Target AS t GROUP BY t.StoreKey ORDER BY t.StoreKey NULLS FIRST LIMIT 3
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('Target'[StoreKey], "__rows", COUNTROWS(Target), "v", 'Target'[Target Amount]), "StoreKey", 'Target'[StoreKey], "v", [v]) ORDER BY [StoreKey]
