// note: the view expander's grid (tools/ossie/grid.mjs), rollup: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.StoreKey, AGG(t."Target Amount") AS v FROM "dax-conformance-edges".Target AS t GROUP BY ROLLUP (t.StoreKey) ORDER BY t.StoreKey NULLS LAST
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS(ROLLUPADDISSUBTOTAL('Target'[StoreKey], "__level1_StoreKey"), "__rows", COUNTROWS('Target'), "v", 'Target'[Target Amount]), "StoreKey", 'Target'[StoreKey], "v", [v]) ORDER BY ISBLANK([StoreKey]), [StoreKey]
