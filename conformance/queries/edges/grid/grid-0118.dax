// note: the view expander's grid (tools/ossie/grid.mjs), scalar ops: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.StoreKey, AGG(t."Target Amount") * 2 AS a, AGG(t."Target Amount") + 1 AS b, COALESCE(AGG(t."Target Amount"), 0) AS c FROM "dax-conformance-edges".Target AS t GROUP BY t.StoreKey
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('Target'[StoreKey], "__rows", COUNTROWS('Target'), "a", ('Target'[Target Amount] * 2), "b", ('Target'[Target Amount] + 1), "c", IF(ISBLANK(COUNTROWS('Target')), BLANK(), COALESCE('Target'[Target Amount], 0))), "StoreKey", 'Target'[StoreKey], "a", [a], "b", [b], "c", [c])
