// note: the view expander's grid (tools/ossie/grid.mjs), group: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t."Date", AGG(t."Target Amount") AS v FROM "dax-conformance-edges".Target AS t GROUP BY t."Date"
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('Target'[Date], "__rows", COUNTROWS('Target'), "v", 'Target'[Target Amount]), "Date", 'Target'[Date], "v", [v])
