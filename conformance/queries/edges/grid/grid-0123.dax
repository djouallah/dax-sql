// note: the view expander's grid (tools/ossie/grid.mjs), where and: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t."Date", AGG(t."Target Amount") AS v FROM "dax-conformance-edges".Target AS t WHERE t.StoreKey = 'PAR-01' AND t.StoreKey = 'NYC-01' GROUP BY t."Date"
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('Target'[Date], "__rows", COUNTROWS(Target), "v", 'Target'[Target Amount]), ('Target'[StoreKey] = "PAR-01"), ('Target'[StoreKey] = "NYC-01")), "Date", 'Target'[Date], "v", [v])
