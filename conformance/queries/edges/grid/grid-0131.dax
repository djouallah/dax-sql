// note: the view expander's grid (tools/ossie/grid.mjs), rollup: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t."Date", AGG(t."Target Amount") AS v FROM "dax-conformance-edges".Target AS t GROUP BY ROLLUP (t."Date") ORDER BY t."Date" NULLS LAST
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS(ROLLUPADDISSUBTOTAL('Target'[Date], "__level1_Date"), "__rows", COUNTROWS(Target), "v", 'Target'[Target Amount]), "Date", 'Target'[Date], "v", [v]) ORDER BY ISBLANK([Date]), [Date]
