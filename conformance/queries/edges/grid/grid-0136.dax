// note: the view expander's grid (tools/ossie/grid.mjs), two groups: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.Brand, t."Date", AGG(t."Target Amount") AS v FROM "dax-conformance-edges".Target AS t GROUP BY t.Brand, t."Date"
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('Target'[Brand], 'Target'[Date], "__rows", COUNTROWS(Target), "v", 'Target'[Target Amount]), "Brand", 'Target'[Brand], "Date", 'Target'[Date], "v", [v])
