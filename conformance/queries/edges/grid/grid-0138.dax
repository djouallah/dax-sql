// note: the view expander's grid (tools/ossie/grid.mjs), where and: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.Brand, AGG(t."Target Amount") AS v FROM "dax-conformance-edges".Target AS t WHERE NOT (t.StoreKey = 'ZZZ-00') AND t."Date" >= DATE '2024-11-01' GROUP BY t.Brand
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('Target'[Brand], "__rows", COUNTROWS('Target'), "v", 'Target'[Target Amount]), NOT(('Target'[StoreKey] = "ZZZ-00")), ('Target'[Date] >= DATE(2024, 11, 1))), "Brand", 'Target'[Brand], "v", [v])
