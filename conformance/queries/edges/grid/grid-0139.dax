// note: the view expander's grid (tools/ossie/grid.mjs), where or: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.Brand, AGG(t."Target Amount") AS v FROM "dax-conformance-edges".Target AS t WHERE t."Date" = DATE '2024-11-01' OR t."Date" BETWEEN DATE '2023-01-01' AND DATE '2023-03-01' GROUP BY t.Brand
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('Target'[Brand], "__rows", COUNTROWS(Target), "v", 'Target'[Target Amount]), (('Target'[Date] = DATE(2024, 11, 1)) || (('Target'[Date] >= DATE(2023, 1, 1)) && ('Target'[Date] <= DATE(2023, 3, 1))))), "Brand", 'Target'[Brand], "v", [v])
