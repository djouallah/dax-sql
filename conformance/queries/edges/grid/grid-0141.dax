// note: the view expander's grid (tools/ossie/grid.mjs), having: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.Brand, AGG(t."Target Amount") AS v FROM "dax-conformance-edges".Target AS t GROUP BY t.Brand HAVING AGG(t."Target Amount") > 0
EVALUATE SELECTCOLUMNS(FILTER(SUMMARIZECOLUMNS('Target'[Brand], "__rows", COUNTROWS('Target'), "v", 'Target'[Target Amount]), ([v] > 0)), "Brand", 'Target'[Brand], "v", [v])
