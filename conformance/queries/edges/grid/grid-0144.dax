// note: the view expander's grid (tools/ossie/grid.mjs), order by measure: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.Brand, AGG(t."Target Amount") AS v FROM "dax-conformance-edges".Target AS t GROUP BY t.Brand ORDER BY v DESC NULLS LAST, t.Brand NULLS FIRST
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('Target'[Brand], "__rows", COUNTROWS(Target), "v", 'Target'[Target Amount]), "Brand", 'Target'[Brand], "v", [v]) ORDER BY [v] DESC, [Brand]
