// note: the view expander's grid (tools/ossie/grid.mjs), derived table: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT s.Brand, s.v FROM (SELECT t.Brand, AGG(t."Target Amount") AS v FROM "dax-conformance-edges".Target AS t GROUP BY t.Brand) AS s WHERE s.v IS NOT NULL
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('Target'[Brand], "__rows", COUNTROWS(Target), "v", 'Target'[Target Amount]), "Brand", 'Target'[Brand], "v", [v])
