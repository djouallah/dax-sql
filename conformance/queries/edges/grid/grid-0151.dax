// note: the view expander's grid (tools/ossie/grid.mjs), where and: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t."Date", AGG(t."Target Amount") AS v FROM "dax-conformance-edges".Target AS t WHERE t.Brand IS NOT NULL AND t."Date" = DATE '2023-06-01' GROUP BY t."Date"
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('Target'[Date], "__rows", COUNTROWS('Target'), "v", 'Target'[Target Amount]), NOT(ISBLANK('Target'[Brand])), ('Target'[Date] = DATE(2023, 6, 1))), "Date", 'Target'[Date], "v", [v])
