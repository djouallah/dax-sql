// note: the view expander's grid (tools/ossie/grid.mjs), where total: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT AGG(t."Target Amount") AS v FROM "dax-conformance-edges".Target AS t WHERE t."Date" BETWEEN DATE '2023-01-01' AND DATE '2023-05-01'
EVALUATE SELECTCOLUMNS(CALCULATETABLE(ROW("v", 'Target'[Target Amount]), (('Target'[Date] >= DATE(2023, 1, 1)) && ('Target'[Date] <= DATE(2023, 5, 1)))), "v", [v])
