// note: the view expander's grid (tools/ossie/grid.mjs), where and: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.Brand, AGG(t."Target Amount") AS v FROM "dax-conformance-edges".Target AS t WHERE NOT (t."Date" = DATE '2024-12-01') AND t.StoreKey IN ('SYD-01', 'SYD-01') GROUP BY t.Brand
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('Target'[Brand], "__rows", COUNTROWS('Target'), "v", 'Target'[Target Amount]), NOT(('Target'[Date] = DATE(2024, 12, 1))), ('Target'[StoreKey] IN {"SYD-01", "SYD-01"})), "Brand", 'Target'[Brand], "v", [v])
