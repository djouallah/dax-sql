// note: the view expander's grid (tools/ossie/grid.mjs), where or: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.Brand, AGG(t."Target Amount") AS v FROM "dax-conformance-edges".Target AS t WHERE t.Brand IS NOT NULL OR t.StoreKey IS NOT NULL GROUP BY t.Brand
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('Target'[Brand], "__rows", COUNTROWS('Target'), "v", 'Target'[Target Amount]), (NOT(ISBLANK('Target'[Brand])) || NOT(ISBLANK('Target'[StoreKey])))), "Brand", 'Target'[Brand], "v", [v])
