// note: the view expander's grid (tools/ossie/grid.mjs), cte: its SQL as dax-sql's SQL front end writes it in DAX:
// WITH s AS (SELECT Brand, "Target Amount" AS mm FROM "dax-conformance-edges".Target WHERE NOT (StoreKey = 'TYO-01')) SELECT Brand, AGG(mm) AS v FROM s GROUP BY Brand
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('Target'[Brand], "__rows", COUNTROWS('Target'), "v", 'Target'[Target Amount]), NOT(('Target'[StoreKey] = "TYO-01"))), "Brand", 'Target'[Brand], "v", [v])
