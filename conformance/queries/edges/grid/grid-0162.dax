EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('Target'[Date], "__rows", COUNTROWS(Target), "v", 'Target'[Target Amount]), (('Target'[Date] IN {DATE(2023, 3, 1), DATE(2024, 6, 1)}) || NOT(ISBLANK('Target'[Date])))), "Date", 'Target'[Date], "v", [v])
