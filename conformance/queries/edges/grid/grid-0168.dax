// note: the view expander's grid (tools/ossie/grid.mjs), star two sides: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.Brand, f."Line Number", AGG(f."Sales Amount") AS v FROM "dax-conformance-edges".Sales AS f LEFT JOIN "dax-conformance-edges".Product AS o ON f.ProductKey = o.ProductKey GROUP BY o.Brand, f."Line Number"
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('Product'[Brand], 'Sales'[Line Number], "__rows", COUNTROWS('Sales'), "v", 'Sales'[Sales Amount]), "Brand", 'Product'[Brand], "Line Number", 'Sales'[Line Number], "v", [v])
