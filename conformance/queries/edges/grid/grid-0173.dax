EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('Product'[Color], 'Sales'[CustomerKey], "__rows", COUNTROWS(Sales), "v", 'Sales'[Total Cost]), "Color", 'Product'[Color], "CustomerKey", 'Sales'[CustomerKey], "v", [v])
