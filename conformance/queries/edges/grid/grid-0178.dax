// note: the view expander's grid (tools/ossie/grid.mjs), star two sides: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.Color, f.StoreKey, AGG(f."Customers No Blank") AS v FROM "dax-conformance-edges".Sales AS f LEFT JOIN "dax-conformance-edges".Product AS o ON f.ProductKey = o.ProductKey GROUP BY o.Color, f.StoreKey
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('Product'[Color], 'Sales'[StoreKey], "__rows", COUNTROWS(Sales), "v", 'Sales'[Customers No Blank]), "Color", 'Product'[Color], "StoreKey", 'Sales'[StoreKey], "v", [v])
