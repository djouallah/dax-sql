// note: the view expander's grid (tools/ossie/grid.mjs), star two sides: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.Segment, f.ProductKey, AGG(f."Sales Amount") AS v FROM "dax-conformance-edges".Sales AS f LEFT JOIN "dax-conformance-edges".Customer AS o ON f.CustomerKey = o.CustomerKey GROUP BY o.Segment, f.ProductKey
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('Customer'[Segment], 'Sales'[ProductKey], "__rows", COUNTROWS('Sales'), "v", 'Sales'[Sales Amount]), "Segment", 'Customer'[Segment], "ProductKey", 'Sales'[ProductKey], "v", [v])
