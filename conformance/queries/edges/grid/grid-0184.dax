// note: the view expander's grid (tools/ossie/grid.mjs), star: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.Segment, AGG(f."Total Quantity") AS v FROM "dax-conformance-edges".Sales AS f JOIN "dax-conformance-edges".Customer AS o ON f.CustomerKey = o.CustomerKey GROUP BY o.Segment
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('Customer'[Segment], "__rows", COUNTROWS(Sales), "v", 'Sales'[Total Quantity]), NOT(ISBLANK('Customer'[CustomerKey]))), "Segment", 'Customer'[Segment], "v", [v])
