// note: the view expander's grid (tools/ossie/grid.mjs), star: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.CountryKey, AGG(f."Sales Amount") AS v FROM "dax-conformance-edges".Sales AS f JOIN "dax-conformance-edges".Store AS o ON f.StoreKey = o.StoreKey GROUP BY o.CountryKey
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('Store'[CountryKey], "__rows", COUNTROWS('Sales'), "v", 'Sales'[Sales Amount]), NOT(ISBLANK('Store'[StoreKey]))), "CountryKey", 'Store'[CountryKey], "v", [v])
