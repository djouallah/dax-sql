// note: the view expander's grid (tools/ossie/grid.mjs), star two sides: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.CountryKey, f.ProductKey, AGG(f.Lines) AS v FROM "dax-conformance-edges".Sales AS f JOIN "dax-conformance-edges".Store AS o ON f.StoreKey = o.StoreKey GROUP BY o.CountryKey, f.ProductKey
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('Store'[CountryKey], 'Sales'[ProductKey], "__rows", COUNTROWS('Sales'), "v", 'Sales'[Lines]), NOT(ISBLANK('Store'[StoreKey]))), "CountryKey", 'Store'[CountryKey], "ProductKey", 'Sales'[ProductKey], "v", [v])
