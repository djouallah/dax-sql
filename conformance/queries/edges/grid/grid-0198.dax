// note: the view expander's grid (tools/ossie/grid.mjs), star total: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT AGG(f.Lines) AS v FROM "dax-conformance-edges".Sales AS f JOIN "dax-conformance-edges".Store AS o ON f.StoreKey = o.StoreKey
EVALUATE SELECTCOLUMNS(CALCULATETABLE(ROW("v", 'Sales'[Lines]), NOT(ISBLANK('Store'[StoreKey]))), "v", [v])
