// note: the view expander's grid (tools/ossie/grid.mjs), star where many: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o."Square Meters", AGG(f."Total Cost") AS v FROM "dax-conformance-edges".Sales AS f LEFT JOIN "dax-conformance-edges".Store AS o ON f.StoreKey = o.StoreKey WHERE f."Ship Date" = DATE '2023-10-07' GROUP BY o."Square Meters"
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('Store'[Square Meters], "__rows", COUNTROWS(Sales), "v", 'Sales'[Total Cost]), ('Sales'[Ship Date] = DATE(2023, 10, 7))), "Square Meters", 'Store'[Square Meters], "v", [v])
