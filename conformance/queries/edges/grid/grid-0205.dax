// note: the view expander's grid (tools/ossie/grid.mjs), star where one: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.StoreKey, AGG(f."Total Cost") AS v FROM "dax-conformance-edges".Sales AS f JOIN "dax-conformance-edges".Store AS o ON f.StoreKey = o.StoreKey WHERE o.Store <> 'San Francisco' GROUP BY o.StoreKey
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('Store'[StoreKey], "__rows", COUNTROWS('Sales'), "v", 'Sales'[Total Cost]), ('Store'[Store] <> "San Francisco"), NOT(ISBLANK('Store'[StoreKey]))), "StoreKey", 'Store'[StoreKey], "v", [v])
