// note: the view expander's grid (tools/ossie/grid.mjs), star: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.YearMonth, AGG(f."Customers No Blank") AS v FROM "dax-conformance-edges".Sales AS f LEFT JOIN "dax-conformance-edges"."Date" AS o ON f."Order Date" = o."Date" GROUP BY o.YearMonth
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('Date'[YearMonth], "__rows", COUNTROWS('Sales'), "v", 'Sales'[Customers No Blank]), "YearMonth", 'Date'[YearMonth], "v", [v])
