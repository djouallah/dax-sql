// note: the view expander's grid (tools/ossie/grid.mjs), star where many: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.YearMonth, AGG(f."Sales Amount") AS v FROM "dax-conformance-edges".Sales AS f LEFT JOIN "dax-conformance-edges"."Date" AS o ON f."Order Date" = o."Date" WHERE f."Order Date" = DATE '2023-04-19' GROUP BY o.YearMonth
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('Date'[YearMonth], "__rows", COUNTROWS('Sales'), "v", 'Sales'[Sales Amount]), ('Sales'[Order Date] = DATE(2023, 4, 19))), "YearMonth", 'Date'[YearMonth], "v", [v])
