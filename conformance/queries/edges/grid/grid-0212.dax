// note: the view expander's grid (tools/ossie/grid.mjs), star two sides: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.YearMonth, f.CustomerKey, AGG(f."Total Cost") AS v FROM "dax-conformance-edges".Sales AS f LEFT JOIN "dax-conformance-edges"."Date" AS o ON f."Order Date" = o."Date" GROUP BY o.YearMonth, f.CustomerKey
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('Date'[YearMonth], 'Sales'[CustomerKey], "__rows", COUNTROWS('Sales'), "v", 'Sales'[Total Cost]), "YearMonth", 'Date'[YearMonth], "CustomerKey", 'Sales'[CustomerKey], "v", [v])
