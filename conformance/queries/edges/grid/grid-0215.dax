// note: the view expander's grid (tools/ossie/grid.mjs), star where one: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o."Month Name", AGG(f."Customers No Blank") AS v FROM "dax-conformance-edges".Sales AS f JOIN "dax-conformance-edges"."Date" AS o ON f."Order Date" = o."Date" WHERE o."Year" IN (2024, 2023) GROUP BY o."Month Name"
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('Date'[Month Name], "__rows", COUNTROWS(Sales), "v", 'Sales'[Customers No Blank]), ('Date'[Year] IN {2024, 2023}), NOT(ISBLANK('Date'[Date]))), "Month Name", 'Date'[Month Name], "v", [v])
