// note: the view expander's grid (tools/ossie/grid.mjs), star where many: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o."Month Name", AGG(f."Sales Amount") AS v FROM "dax-conformance-edges".Sales AS f JOIN "dax-conformance-edges"."Date" AS o ON f."Order Date" = o."Date" WHERE f."Order Number" <> 195 GROUP BY o."Month Name"
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('Date'[Month Name], "__rows", COUNTROWS('Sales'), "v", 'Sales'[Sales Amount]), ('Sales'[Order Number] <> 195), NOT(ISBLANK('Date'[Date]))), "Month Name", 'Date'[Month Name], "v", [v])
