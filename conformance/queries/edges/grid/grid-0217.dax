// note: the view expander's grid (tools/ossie/grid.mjs), star two sides: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o."Month Name", f.Promo, AGG(f."Sales Amount") AS v FROM "dax-conformance-edges".Sales AS f JOIN "dax-conformance-edges"."Date" AS o ON f."Order Date" = o."Date" GROUP BY o."Month Name", f.Promo
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('Date'[Month Name], 'Sales'[Promo], "__rows", COUNTROWS('Sales'), "v", 'Sales'[Sales Amount]), NOT(ISBLANK('Date'[Date]))), "Month Name", 'Date'[Month Name], "Promo", 'Sales'[Promo], "v", [v])
