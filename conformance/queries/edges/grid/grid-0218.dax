// note: the view expander's grid (tools/ossie/grid.mjs), star total: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT AGG(f."Total Cost") AS v FROM "dax-conformance-edges".Sales AS f JOIN "dax-conformance-edges"."Date" AS o ON f."Order Date" = o."Date"
EVALUATE SELECTCOLUMNS(CALCULATETABLE(ROW("v", 'Sales'[Total Cost]), NOT(ISBLANK('Date'[Date]))), "v", [v])
