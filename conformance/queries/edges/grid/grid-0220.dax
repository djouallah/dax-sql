// note: the view expander's grid (tools/ossie/grid.mjs), star where one: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o."Month Name", AGG(f."Total Cost") AS v FROM "dax-conformance-edges".Sales AS f LEFT JOIN "dax-conformance-edges"."Date" AS o ON f."Order Date" = o."Date" WHERE o."Year Month" IN ('2024-04', '2023-08') GROUP BY o."Month Name"
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('Date'[Month Name], "__rows", COUNTROWS(Sales), "v", 'Sales'[Total Cost]), ('Date'[Year Month] IN {"2024-04", "2023-08"})), "Month Name", 'Date'[Month Name], "v", [v])
