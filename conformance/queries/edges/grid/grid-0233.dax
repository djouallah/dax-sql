// note: the view expander's grid (tools/ossie/grid.mjs), star total: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT AGG(f.Customers) AS v FROM "dax-conformance-edges".Sales AS f JOIN "dax-conformance-edges"."Date" AS o ON f."Ship Date" = o."Date"
DEFINE
VAR __v1 = GENERATE(SELECTCOLUMNS(Sales, "f.Order Number", 'Sales'[Order Number], "f.Line Number", 'Sales'[Line Number], "f.Order Date", 'Sales'[Order Date], "f.Ship Date", 'Sales'[Ship Date], "f.ProductKey", 'Sales'[ProductKey], "f.CustomerKey", 'Sales'[CustomerKey], "f.StoreKey", 'Sales'[StoreKey], "f.Quantity", 'Sales'[Quantity], "f.Unit Price", 'Sales'[Unit Price], "f.Unit Cost", 'Sales'[Unit Cost], "f.Discount", 'Sales'[Discount], "f.Promo", 'Sales'[Promo], "f.Loyalty Points", 'Sales'[Loyalty Points]), FILTER(SELECTCOLUMNS(Date, "o.Date", 'Date'[Date]), ([f.Ship Date] = [o.Date])))
VAR __v2 = ROW("__all", 1)
EVALUATE SELECTCOLUMNS(ADDCOLUMNS(__v2, "__m1", CALCULATE('Sales'[Customers], REMOVEFILTERS(), TREATAS(SELECTCOLUMNS(FILTER(__v1, NOT(((((((((((((ISBLANK([f.Order Number]) && ISBLANK([f.Line Number])) && ISBLANK([f.Order Date])) && ISBLANK([f.Ship Date])) && ISBLANK([f.ProductKey])) && ISBLANK([f.CustomerKey])) && ISBLANK([f.StoreKey])) && ISBLANK([f.Quantity])) && ISBLANK([f.Unit Price])) && ISBLANK([f.Unit Cost])) && ISBLANK([f.Discount])) && ISBLANK([f.Promo])) && ISBLANK([f.Loyalty Points])))), "__k1", [f.Order Number], "__k2", [f.Line Number], "__k3", [f.Order Date], "__k4", [f.Ship Date], "__k5", [f.ProductKey], "__k6", [f.CustomerKey], "__k7", [f.StoreKey], "__k8", [f.Quantity], "__k9", [f.Unit Price], "__k10", [f.Unit Cost], "__k11", [f.Discount], "__k12", [f.Promo], "__k13", [f.Loyalty Points]), 'Sales'[Order Number], 'Sales'[Line Number], 'Sales'[Order Date], 'Sales'[Ship Date], 'Sales'[ProductKey], 'Sales'[CustomerKey], 'Sales'[StoreKey], 'Sales'[Quantity], 'Sales'[Unit Price], 'Sales'[Unit Cost], 'Sales'[Discount], 'Sales'[Promo], 'Sales'[Loyalty Points]))), "v", [__m1])
