// note: the view expander's grid (tools/ossie/grid.mjs), star where many: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o."Month", AGG(f."Target Amount") AS v FROM "dax-conformance-edges".Target AS f JOIN "dax-conformance-edges"."Date" AS o ON f."Date" = o."Date" WHERE f.StoreKey = 'ZZZ-00' GROUP BY o."Month"
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('Date'[Month], "__rows", COUNTROWS(Target), "v", 'Target'[Target Amount]), ('Target'[StoreKey] = "ZZZ-00"), NOT(ISBLANK('Date'[Date]))), "Month", 'Date'[Month], "v", [v])
