// note: the view expander's grid (tools/ossie/grid.mjs), star: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.Weekday, AGG(f."Target Amount") AS v FROM "dax-conformance-edges".Target AS f LEFT JOIN "dax-conformance-edges"."Date" AS o ON f."Date" = o."Date" GROUP BY o.Weekday
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('Date'[Weekday], "__rows", COUNTROWS(Target), "v", 'Target'[Target Amount]), "Weekday", 'Date'[Weekday], "v", [v])
