// note: the view expander's grid (tools/ossie/grid.mjs), star where many: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.StoreKey, AGG(f."Target Amount") AS v FROM "dax-conformance-edges".Target AS f JOIN "dax-conformance-edges".Store AS o ON f.StoreKey = o.StoreKey WHERE f."Date" < DATE '2024-11-01' GROUP BY o.StoreKey
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('Store'[StoreKey], "__rows", COUNTROWS(Target), "v", 'Target'[Target Amount]), ('Target'[Date] < DATE(2024, 11, 1)), NOT(ISBLANK('Store'[StoreKey]))), "StoreKey", 'Store'[StoreKey], "v", [v])
