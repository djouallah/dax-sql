// note: the view expander's grid (tools/ossie/grid.mjs), star: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.Opened, AGG(f."Target Amount") AS v FROM "dax-conformance-edges".Target AS f LEFT JOIN "dax-conformance-edges".Store AS o ON f.StoreKey = o.StoreKey GROUP BY o.Opened
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('Store'[Opened], "__rows", COUNTROWS('Target'), "v", 'Target'[Target Amount]), "Opened", 'Store'[Opened], "v", [v])
