// note: the view expander's grid (tools/ossie/grid.mjs), star where many: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.ProductKey, AGG(f."Target Amount") AS v FROM "dax-conformance-edges".Target AS f LEFT JOIN "dax-conformance-edges".Product AS o ON f.Brand = o.Brand WHERE f.StoreKey IN ('AMS-01', 'NYC-01') GROUP BY o.ProductKey
DEFINE
VAR __v1 = GENERATEALL(SELECTCOLUMNS(Target, "f.Date", 'Target'[Date], "f.StoreKey", 'Target'[StoreKey], "f.Brand", 'Target'[Brand], "f.Target", 'Target'[Target]), FILTER(SELECTCOLUMNS(Product, "o.ProductKey", 'Product'[ProductKey], "o.Brand", 'Product'[Brand]), ([f.Brand] = [o.Brand])))
VAR __v2 = FILTER(__v1, ([f.StoreKey] IN {"AMS-01", "NYC-01"}))
VAR __v3 = DISTINCT(SELECTCOLUMNS(__v2, "ProductKey", [o.ProductKey]))
EVALUATE SELECTCOLUMNS(ADDCOLUMNS(__v3, "__m1", CALCULATE('Target'[Target Amount], REMOVEFILTERS(), TREATAS(SELECTCOLUMNS(FILTER(__v2, (NOT((((ISBLANK([f.Date]) && ISBLANK([f.StoreKey])) && ISBLANK([f.Brand])) && ISBLANK([f.Target]))) && ([o.ProductKey] == [ProductKey]))), "__k1", [f.Date], "__k2", [f.StoreKey], "__k3", [f.Brand], "__k4", [f.Target]), 'Target'[Date], 'Target'[StoreKey], 'Target'[Brand], 'Target'[Target]))), "ProductKey", [ProductKey], "v", [__m1])
