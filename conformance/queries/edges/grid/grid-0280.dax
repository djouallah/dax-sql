// note: the view expander's grid (tools/ossie/grid.mjs), chasm: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o."Square Meters", AGG(a."Total Quantity") AS x, AGG(b."Target Amount") AS y FROM "dax-conformance-edges".Store AS o LEFT JOIN "dax-conformance-edges".Sales AS a ON a.StoreKey = o.StoreKey LEFT JOIN "dax-conformance-edges".Target AS b ON b.StoreKey = o.StoreKey GROUP BY o."Square Meters"
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('Store'[Square Meters], "__rows", COUNTROWS('Store'), "x", CALCULATE('Sales'[Total Quantity], KEEPFILTERS(NOT(ISBLANK('Store'[StoreKey])))), "y", CALCULATE('Target'[Target Amount], KEEPFILTERS(NOT(ISBLANK('Store'[StoreKey]))))), "Square Meters", 'Store'[Square Meters], "x", [x], "y", [y])
