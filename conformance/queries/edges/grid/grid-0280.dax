// note: the view expander's grid (tools/ossie/grid.mjs), chasm: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o."Square Meters", AGG(a."Total Quantity") AS x, AGG(b."Target Amount") AS y FROM "dax-conformance-edges".Store AS o LEFT JOIN "dax-conformance-edges".Sales AS a ON a.StoreKey = o.StoreKey LEFT JOIN "dax-conformance-edges".Target AS b ON b.StoreKey = o.StoreKey GROUP BY o."Square Meters"
DEFINE
VAR __v1 = GENERATEALL(GENERATEALL(SELECTCOLUMNS(Store, "o.StoreKey", 'Store'[StoreKey], "o.Square Meters", 'Store'[Square Meters]), FILTER(SELECTCOLUMNS(Sales, "a.Order Number", 'Sales'[Order Number], "a.Line Number", 'Sales'[Line Number], "a.Order Date", 'Sales'[Order Date], "a.Ship Date", 'Sales'[Ship Date], "a.ProductKey", 'Sales'[ProductKey], "a.CustomerKey", 'Sales'[CustomerKey], "a.StoreKey", 'Sales'[StoreKey], "a.Quantity", 'Sales'[Quantity], "a.Unit Price", 'Sales'[Unit Price], "a.Unit Cost", 'Sales'[Unit Cost], "a.Discount", 'Sales'[Discount], "a.Promo", 'Sales'[Promo], "a.Loyalty Points", 'Sales'[Loyalty Points]), ([a.StoreKey] = [o.StoreKey]))), FILTER(SELECTCOLUMNS(Target, "b.Date", 'Target'[Date], "b.StoreKey", 'Target'[StoreKey], "b.Brand", 'Target'[Brand], "b.Target", 'Target'[Target]), ([b.StoreKey] = [o.StoreKey])))
VAR __v2 = DISTINCT(SELECTCOLUMNS(__v1, "Square Meters", [o.Square Meters]))
EVALUATE SELECTCOLUMNS(ADDCOLUMNS(__v2, "__m1", CALCULATE('Sales'[Total Quantity], REMOVEFILTERS(), TREATAS(SELECTCOLUMNS(FILTER(__v1, (NOT(((((((((((((ISBLANK([a.Order Number]) && ISBLANK([a.Line Number])) && ISBLANK([a.Order Date])) && ISBLANK([a.Ship Date])) && ISBLANK([a.ProductKey])) && ISBLANK([a.CustomerKey])) && ISBLANK([a.StoreKey])) && ISBLANK([a.Quantity])) && ISBLANK([a.Unit Price])) && ISBLANK([a.Unit Cost])) && ISBLANK([a.Discount])) && ISBLANK([a.Promo])) && ISBLANK([a.Loyalty Points]))) && ([o.Square Meters] == [Square Meters]))), "__k1", [a.Order Number], "__k2", [a.Line Number], "__k3", [a.Order Date], "__k4", [a.Ship Date], "__k5", [a.ProductKey], "__k6", [a.CustomerKey], "__k7", [a.StoreKey], "__k8", [a.Quantity], "__k9", [a.Unit Price], "__k10", [a.Unit Cost], "__k11", [a.Discount], "__k12", [a.Promo], "__k13", [a.Loyalty Points]), 'Sales'[Order Number], 'Sales'[Line Number], 'Sales'[Order Date], 'Sales'[Ship Date], 'Sales'[ProductKey], 'Sales'[CustomerKey], 'Sales'[StoreKey], 'Sales'[Quantity], 'Sales'[Unit Price], 'Sales'[Unit Cost], 'Sales'[Discount], 'Sales'[Promo], 'Sales'[Loyalty Points])), "__m2", CALCULATE('Target'[Target Amount], REMOVEFILTERS(), TREATAS(SELECTCOLUMNS(FILTER(__v1, (NOT((((ISBLANK([b.Date]) && ISBLANK([b.StoreKey])) && ISBLANK([b.Brand])) && ISBLANK([b.Target]))) && ([o.Square Meters] == [Square Meters]))), "__k1", [b.Date], "__k2", [b.StoreKey], "__k3", [b.Brand], "__k4", [b.Target]), 'Target'[Date], 'Target'[StoreKey], 'Target'[Brand], 'Target'[Target]))), "Square Meters", [Square Meters], "x", [__m1], "y", [__m2])
