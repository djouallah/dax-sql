// note: the view expander's grid (tools/ossie/grid.mjs), chasm: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.Weekday, AGG(a."Customers No Blank") AS x, AGG(b."Target Amount") AS y FROM "dax-conformance-edges"."Date" AS o LEFT JOIN "dax-conformance-edges".Sales AS a ON a."Order Date" = o."Date" LEFT JOIN "dax-conformance-edges".Target AS b ON b."Date" = o."Date" GROUP BY o.Weekday
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('Date'[Weekday], "__rows", COUNTROWS('Date'), "x", CALCULATE('Sales'[Customers No Blank], KEEPFILTERS(NOT(ISBLANK('Date'[Date])))), "y", CALCULATE('Target'[Target Amount], KEEPFILTERS(NOT(ISBLANK('Date'[Date]))))), "Weekday", 'Date'[Weekday], "x", [x], "y", [y])
