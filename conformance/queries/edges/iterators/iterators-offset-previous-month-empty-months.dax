// note: OFFSET -1 over the months of the Date table for sales and for the store x brand x month targets: the month after an empty month (Sales 2023-08; Target 2023-04, 2024-07, 2024-08) gets a blank previous value, and the first month has no previous month
EVALUATE
SUMMARIZECOLUMNS(
    'Date'[YearMonth],
    "Sales", [Sales Amount],
    "Previous Month Sales", CALCULATE([Sales Amount], OFFSET(-1, ALLSELECTED('Date'[YearMonth]), ORDERBY('Date'[YearMonth], ASC))),
    "Target", [Target Amount],
    "Previous Month Target", CALCULATE([Target Amount], OFFSET(-1, ALLSELECTED('Date'[YearMonth]), ORDERBY('Date'[YearMonth], ASC))),
    "Target Change", [Target Amount] - CALCULATE([Target Amount], OFFSET(-1, ALLSELECTED('Date'[YearMonth]), ORDERBY('Date'[YearMonth], ASC)))
)
ORDER BY 'Date'[YearMonth]
