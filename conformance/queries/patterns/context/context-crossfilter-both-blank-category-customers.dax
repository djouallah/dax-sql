// note: grouped by category, the blank one (lines whose product is missing) included: CROSSFILTER BOTH lets those lines filter Customer back, reaching a real customer and the blank customer row
EVALUATE
SUMMARIZECOLUMNS(
    Category[Category],
    "Lines", [Order Lines],
    "Sales Customer Keys", [Customers],
    "Customer Rows Both", CALCULATE(COUNTROWS(Customer), CROSSFILTER(Sales[CustomerKey], Customer[CustomerKey], BOTH)),
    "Customer Keys Both", CALCULATE(COUNTROWS(VALUES(Customer[CustomerKey])), CROSSFILTER(Sales[CustomerKey], Customer[CustomerKey], BOTH)),
    "Countries Both", CALCULATE(CONCATENATEX(VALUES(Customer[Country]), Customer[Country], ", ", Customer[Country], ASC), CROSSFILTER(Sales[CustomerKey], Customer[CustomerKey], BOTH))
)
ORDER BY Category[Category]
