// note: the shape a Power BI table visual writes (filter-table VARs, a grand total, TOPN windowing), with a percent of ALLSELECTED() that is one on the total row
DEFINE
    VAR __DS0FilterTable = TREATAS({2023, 2024}, 'Date'[Year])
    VAR __DS0FilterTable2 = TREATAS({"France", "Germany"}, 'Customer'[Country])
    VAR __DS0Core =
        SUMMARIZECOLUMNS(
            ROLLUPADDISSUBTOTAL('Category'[Category], "IsGrandTotalRowTotal"),
            __DS0FilterTable,
            __DS0FilterTable2,
            "Sales_Amount", 'Sales'[Sales Amount],
            "Margin__", 'Sales'[Margin %],
            "Pct_Of_Selected", 'Sales'[Context Pct Of Selected]
        )
    VAR __DS0PrimaryWindowed = TOPN(502, __DS0Core, [IsGrandTotalRowTotal], 0, 'Category'[Category], 1)
EVALUATE
__DS0PrimaryWindowed
ORDER BY [IsGrandTotalRowTotal] DESC, 'Category'[Category]
