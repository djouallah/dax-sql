// note: cohort matrix from the Customer[First Order] calculated column: customers active each year, by year of first order
EVALUATE
VAR Cohorts =
    DISTINCT(
        SELECTCOLUMNS(
            FILTER(Customer, NOT ISBLANK(Customer[First Order])),
            "Cohort Year", YEAR(Customer[First Order])
        )
    )
RETURN
    ADDCOLUMNS(
        CROSSJOIN(Cohorts, VALUES('Date'[Year])),
        "Active Customers",
            VAR cy = [Cohort Year]
            RETURN CALCULATE([Customers], FILTER(Customer, YEAR(Customer[First Order]) = cy))
    )
ORDER BY [Cohort Year], 'Date'[Year]
