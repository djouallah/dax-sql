EVALUATE SUMMARIZE('Sales', 'Employee'[Title], 'Product'[Color], "m0", CALCULATE([Sales USD], INDEX(1, ALL('Date'[Day Name]), ORDERBY('Date'[Day Name], ASC))), "m1", TOTALYTD(AVERAGE('Sales'[Quantity]), 'Date'[Date]))
