// note: a random query (conformance/tools/fuzz.mjs patterns 150 20261125 fuzz3, number 20)
EVALUATE CALCULATETABLE(SUMMARIZECOLUMNS('Date'[Month], 'Customer'[City], "m0", COUNTROWS(FILTER(VALUES('Product'[Brand]), [Sales Rolling 12M Manual] > 100)), "m1", IF(ISINSCOPE('Product'[Price Band]), DIVIDE(IF(ISINSCOPE('Customer'[City]), [ABC Product Class], [Segment Customer Count AOV]), CALCULATE(SUM('Sales'[Quantity]), ALL('Date'[Year]))), RANKX(ALL('Category'[Category]), IF(ISINSCOPE('Customer'[City]), COUNTROWS('Inventory'), [Visual Prev Month Sales])))), PARALLELPERIOD('Date'[Date], -1, QUARTER))
