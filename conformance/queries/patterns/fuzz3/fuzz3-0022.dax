// note: a random query (conformance/tools/fuzz.mjs patterns 150 20261125 fuzz3, number 22)
// roles: France
EVALUATE SUMMARIZECOLUMNS('Date'[Quarter], "m0", [Sales Ordered and Delivered in Period], "m1", CALCULATE(ROUND(DISTINCTCOUNT('Date'[Quarter]), 1), SAMEPERIODLASTYEAR('Date'[Date])), "m2", IF(ISBLANK([Category Rank By Metric]), 0, (IF(SELECTEDVALUE('Subcategory'[Subcategory]) = "Brakes", [Budget at Valid Grain], [Visual Category Rank]) + SWITCH(TRUE(), [Basket Orders With Bikes] > 1, [Customers with Sales Relationship], [Segment Customer Count Fixed] < 100, [Sales Delivered via Relationship], MIN('Budget'[Budget])))))
