// note: a random query (conformance/tools/fuzz.mjs patterns 150 20261125 fuzz3, number 29)
// roles: France
EVALUATE SUMMARIZECOLUMNS('Employee'[Title], TREATAS({ "Brakes" }, 'Subcategory'[Subcategory]), FILTER(ALL('Subcategory'[Subcategory]), 'Subcategory'[Subcategory] <> "Gloves"), "m0", SWITCH(TRUE(), TOTALYTD(AVERAGE('Inventory'[On Hand]), 'Date'[Date]) > 100, [Segment Customer Count Fixed], (COUNTROWS('Inventory') + COUNTROWS('Sales')) < 100, IF(ISINSCOPE('Product'[Price Band]), [Orders In Transit EOP], MAX('Budget'[Budget])), [Customers]), "m1", [Context Sum Of Largest Orders])
