// note: a random query (conformance/tools/fuzz.mjs patterns 150 20261125 fuzz3, number 46)
// roles: Bikes
EVALUATE ADDCOLUMNS(VALUES('Date'[Quarter]), "m0", CALCULATE((AVERAGE('Inventory'[On Hand]) * IF(SELECTEDVALUE('Product'[Brand]) = "Contoso", AVERAGE('Sales'[Line Amount]), [Budget via Product Category])), INDEX(2, ALL('Customer'[Gender]), ORDERBY('Customer'[Gender], DESC))), "m1", DISTINCTCOUNT('Category'[Category]))
