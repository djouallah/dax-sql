// note: a random query (conformance/tools/fuzz.mjs patterns 150 20261125 fuzz3, number 49)
EVALUATE CALCULATETABLE(SUMMARIZECOLUMNS('Currency'[Currency], "m0", IF(SELECTEDVALUE('Customer'[Gender]) = "M", ABS(CALCULATE(SUM('Sales'[Line Amount]), FILTER(VALUES('Date'[Year]), DIVIDE(MAX('Sales'[Quantity]), CALCULATE([Cumulative Sales All Dates], ALL('Product'[Brand]))) > 0))), ABS(IF(AND([Customers with Sales Relationship] > 1, NOT(ISBLANK([ABC Product Class]))), [Customers Avg Days Between Orders], MIN('Budget'[Budget])))), "m1", DISTINCTCOUNT('Category'[Category])), REMOVEFILTERS('Category'))
