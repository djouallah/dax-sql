// note: a random query (conformance/tools/fuzz.mjs patterns 150 20261125 fuzz3, number 63)
EVALUATE SUMMARIZE('Inventory', 'Date'[Day Name], 'Date'[Year], "m0", DIVIDE(IF(HASONEVALUE('Customer'[City]), DISTINCTCOUNT('Subcategory'[Subcategory])), CALCULATE(MIN('Sales'[Quantity]), ALL('Currency'[Currency]))))
