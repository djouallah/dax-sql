// note: a random query (conformance/tools/fuzz.mjs patterns 150 20261125 fuzz3, number 68)
EVALUATE SUMMARIZE('Inventory', 'Date'[Month], "m0", IF(ISINSCOPE('Category'[Category]), DISTINCTCOUNT('Customer'[City]), [Avg Order Value]), "m1", CALCULATE(MAX('Sales'[Line Amount]), PARALLELPERIOD('Date'[Date], -4, QUARTER)))
