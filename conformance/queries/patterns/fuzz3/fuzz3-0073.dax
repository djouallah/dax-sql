// note: a random query (conformance/tools/fuzz.mjs patterns 150 20261125 fuzz3, number 73)
EVALUATE TOPN(4, ADDCOLUMNS(VALUES('Product'[Price Band]), "m0", SWITCH(TRUE(), CALCULATE([Cumulative Customers Distinct], DATEADD('Date'[Date], -1, QUARTER)) > 100, CALCULATE(CALCULATE(AVERAGE('Sales'[Net Price]), KEEPFILTERS('Date'[Month] IN { 3, 1, 10 }), TREATAS({ "zz-none" }, 'Product'[Price Band])), ALLSELECTED('Subcategory'[Subcategory])), DIVIDE(CALCULATE([Sales PY DateAdd], INDEX(-1, ALL('Date'[Year]), ORDERBY('Date'[Year], ASC))), CALCULATE(CALCULATE(COUNTROWS('Product'), PARALLELPERIOD('Date'[Date], -1, QUARTER)), ALL('Subcategory'[Subcategory]))) < 0, CALCULATE(CALCULATE(COUNTROWS('Product'), PARALLELPERIOD('Date'[Date], -1, QUARTER)), 'Customer'[Gender] <> "F"), [Category Rank By Metric])), [m0], DESC, 'Product'[Price Band], ASC)
