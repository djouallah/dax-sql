// note: a random query (conformance/tools/fuzz.mjs patterns 150 20261125 fuzz3, number 91)
EVALUATE SUMMARIZECOLUMNS('Customer'[Gender], "m0", DIVIDE((DISTINCTCOUNT('Customer'[Gender]) + MIN('Sales'[Quantity])), CALCULATE(DIVIDE([Cumulative Sales All Dates], AVERAGE('Sales'[Quantity])), ALL('Customer'[Country]))), "m1", IF(OR(SUMX(SUMMARIZE('Inventory', 'Product'[Brand]), [Sales PY DateAdd]) > 0, NOT(ISBLANK(DIVIDE(MIN('Budget'[Budget]), [Customers Returning])))), AVERAGE('Budget'[Budget]), IF([Sales without Account Bridge] > 100, [Visual Category Rank], DISTINCTCOUNT('Product'[Price Band]))))
