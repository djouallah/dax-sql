// note: a random query (conformance/tools/fuzz.mjs patterns 150 20261125 fuzz3, number 98)
EVALUATE ROW("m0", CALCULATE(VAR v = RANKX(ALL('Product'[Brand]), [ABC Product Cumulative %]) RETURN v * 2 + VAR v = [Sales Rolling 30D] RETURN v * 2 + [Orders], INDEX(1, ALL('Customer'[Country]), ORDERBY('Customer'[Country], ASC))), "m1", SWITCH(TRUE(), [Customers with Sales Relationship] > 1000, SUMX(SUMMARIZE('Sales', 'Category'[Category]), COUNTROWS(FILTER(VALUES('Customer'[Country]), [Sales via Account Iteration] > 0))), MAX(CALCULATE([Segment Customer Count Fixed], DATESBETWEEN('Date'[Date], DATE(2024, 5, 13), DATE(2024, 4, 28))), IF(MAX('Sales'[Net Price]) > 1000, MIN('Inventory'[On Hand]), MIN('Inventory'[On Hand]))) < 100, CALCULATE(AVERAGE('Inventory'[On Hand]), KEEPFILTERS('Employee'[Title] = "VP Sales")), CALCULATE(CALCULATE([Customer First Purchase], INDEX(2, ALL('Currency'[Currency]), ORDERBY('Currency'[Currency], DESC))), NOT('Customer'[Gender] IN { "M" }))))
