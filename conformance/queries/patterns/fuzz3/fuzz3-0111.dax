// note: a random query (conformance/tools/fuzz.mjs patterns 150 20261125 fuzz3, number 111)
EVALUATE ADDCOLUMNS(CROSSJOIN(VALUES('Employee'[Title]), VALUES('Date'[Quarter])), "m0", DIVIDE(DIVIDE(IF([Customers New Lineage] > 1000, [Visual Running Sales], [Customers Via Expanded Sales]), CALCULATE([Margin], DATESINPERIOD('Date'[Date], DATE(2022, 10, 9), -3, MONTH))), ABS(LEN(LEFT(UPPER(CONCATENATEX(VALUES('Product'[Brand]), 'Product'[Brand], "|", 'Product'[Brand], ASC)), 4)))))
