// note: a random query (conformance/tools/fuzz.mjs patterns 150 20261125 fuzz3, number 148)
EVALUATE SUMMARIZECOLUMNS('Subcategory'[Subcategory], 'Date'[Quarter], 'Customer'[City], TREATAS({ "zz-none" }, 'Product'[Price Band]), "m0", VAR v = IF(HASONEVALUE('Date'[Year]), (AVERAGE('Sales'[Net Price]) * [Visual Moving Avg 3M])) RETURN v * 2 + [Orders], "m1", COUNTROWS('Sales'), "m2", IF(ISINSCOPE('Product'[Brand]), CALCULATE(SWITCH(TRUE(), [Budget Fiscal YTD] > 100, [Segment Customer Count], [Customers New] < 10, DISTINCTCOUNT('Date'[Year]), [Avg Daily Rate Relationship]), DATESBETWEEN('Date'[Date], DATE(2023, 2, 9), DATE(1999, 1, 1))), AVERAGE('Sales'[Net Price])))
