// note: the view expander's grid (tools/ossie/grid.mjs), two groups: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.EmployeeKey, t.Quantity, AGG(t."Customer Distinct Products") AS v FROM "dax-sql-patterns".Sales AS t GROUP BY t.EmployeeKey, t.Quantity
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('Sales'[EmployeeKey], 'Sales'[Quantity], "__rows", COUNTROWS(Sales), "v", 'Sales'[Customer Distinct Products]), "EmployeeKey", 'Sales'[EmployeeKey], "Quantity", 'Sales'[Quantity], "v", [v])
