// note: the view expander's grid (tools/ossie/grid.mjs), where: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.EmployeeKey, AGG(t."Total Cost") AS v FROM "dax-sql-patterns".Sales AS t WHERE NOT (t.ProductKey = 12) GROUP BY t.EmployeeKey
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('Sales'[EmployeeKey], "__rows", COUNTROWS(Sales), "v", 'Sales'[Total Cost]), NOT(('Sales'[ProductKey] = 12))), "EmployeeKey", 'Sales'[EmployeeKey], "v", [v])
