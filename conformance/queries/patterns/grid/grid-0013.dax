// note: the view expander's grid (tools/ossie/grid.mjs), where and: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.EmployeeKey, AGG(t."Total Quantity") AS v FROM "dax-sql-patterns".Sales AS t WHERE t."Net Price" = 42.55 AND t."Unit Cost" IS NOT NULL GROUP BY t.EmployeeKey
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('Sales'[EmployeeKey], "__rows", COUNTROWS('Sales'), "v", 'Sales'[Total Quantity]), ('Sales'[Net Price] = 42.55), NOT(ISBLANK('Sales'[Unit Cost]))), "EmployeeKey", 'Sales'[EmployeeKey], "v", [v])
