// note: the view expander's grid (tools/ossie/grid.mjs), where or: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.EmployeeKey, AGG(t."Sales Amount") AS v FROM "dax-sql-patterns".Sales AS t WHERE t.EmployeeKey <> 15 OR t.EmployeeKey >= 10 GROUP BY t.EmployeeKey
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('Sales'[EmployeeKey], "__rows", COUNTROWS(Sales), "v", 'Sales'[Sales Amount]), (('Sales'[EmployeeKey] <> 15) || ('Sales'[EmployeeKey] >= 10))), "EmployeeKey", 'Sales'[EmployeeKey], "v", [v])
