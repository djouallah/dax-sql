// note: the view expander's grid (tools/ossie/grid.mjs), order by measure: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.EmployeeKey, AGG(t."Customer Distinct Products") AS v FROM "dax-sql-patterns".Sales AS t GROUP BY t.EmployeeKey ORDER BY v DESC NULLS LAST, t.EmployeeKey NULLS FIRST
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('Sales'[EmployeeKey], "__rows", COUNTROWS('Sales'), "v", 'Sales'[Customer Distinct Products]), "EmployeeKey", 'Sales'[EmployeeKey], "v", [v]) ORDER BY [v] DESC, [EmployeeKey]
