// note: the view expander's grid (tools/ossie/grid.mjs), group by all: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.EmployeeKey, AGG(t."Total Cost") AS v FROM "dax-sql-patterns".Sales AS t GROUP BY ALL
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('Sales'[EmployeeKey], "__rows", COUNTROWS(Sales), "v", 'Sales'[Total Cost]), "EmployeeKey", 'Sales'[EmployeeKey], "v", [v])
