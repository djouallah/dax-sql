// note: the view expander's grid (tools/ossie/grid.mjs), ratio: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.EmployeeKey, CAST(AGG(t."Customer Distinct Products") AS DOUBLE) / NULLIF(AGG(t."Avg Order Value"), 0) AS r FROM "dax-sql-patterns".Sales AS t GROUP BY t.EmployeeKey
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('Sales'[EmployeeKey], "__rows", COUNTROWS('Sales'), "r", IF(ISBLANK(COUNTROWS('Sales')), BLANK(), (CONVERT('Sales'[Customer Distinct Products], DOUBLE) / IF(('Sales'[Avg Order Value] == 0), BLANK(), 'Sales'[Avg Order Value])))), "EmployeeKey", 'Sales'[EmployeeKey], "r", [r])
