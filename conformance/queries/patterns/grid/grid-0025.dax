// note: the view expander's grid (tools/ossie/grid.mjs), derived table: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT s.EmployeeKey, s.v FROM (SELECT t.EmployeeKey, AGG(t."Order Lines") AS v FROM "dax-sql-patterns".Sales AS t GROUP BY t.EmployeeKey) AS s WHERE s.v IS NOT NULL
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('Sales'[EmployeeKey], "__rows", COUNTROWS('Sales'), "v", 'Sales'[Order Lines]), "EmployeeKey", 'Sales'[EmployeeKey], "v", [v])
