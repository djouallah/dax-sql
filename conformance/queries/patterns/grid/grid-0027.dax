// note: the view expander's grid (tools/ossie/grid.mjs), two metrics: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.Quantity, AGG(t."Total Cost") AS a, AGG(t.Customers) AS b FROM "dax-sql-patterns".Sales AS t GROUP BY t.Quantity
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('Sales'[Quantity], "__rows", COUNTROWS(Sales), "a", 'Sales'[Total Cost], "b", 'Sales'[Customers]), "Quantity", 'Sales'[Quantity], "a", [a], "b", [b])
