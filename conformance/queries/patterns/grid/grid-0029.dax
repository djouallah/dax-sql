// note: the view expander's grid (tools/ossie/grid.mjs), where: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.Quantity, AGG(t."Avg Order Value") AS v FROM "dax-sql-patterns".Sales AS t WHERE t.CustomerKey IN (92, 1) GROUP BY t.Quantity
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('Sales'[Quantity], "__rows", COUNTROWS('Sales'), "v", 'Sales'[Avg Order Value]), ('Sales'[CustomerKey] IN {92, 1})), "Quantity", 'Sales'[Quantity], "v", [v])
