// note: the view expander's grid (tools/ossie/grid.mjs), where and: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.Quantity, AGG(t."Customer Distinct Products") AS v FROM "dax-sql-patterns".Sales AS t WHERE t."Net Price" = 34.04 AND t.CurrencyCode = 'EUR' GROUP BY t.Quantity
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('Sales'[Quantity], "__rows", COUNTROWS(Sales), "v", 'Sales'[Customer Distinct Products]), ('Sales'[Net Price] = 34.04), ('Sales'[CurrencyCode] = "EUR")), "Quantity", 'Sales'[Quantity], "v", [v])
