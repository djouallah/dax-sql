// note: the view expander's grid (tools/ossie/grid.mjs), where total: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT AGG(t."Sales Amount") AS v FROM "dax-sql-patterns".Sales AS t WHERE t.CurrencyCode <> 'EUR'
EVALUATE SELECTCOLUMNS(CALCULATETABLE(ROW("v", 'Sales'[Sales Amount]), ('Sales'[CurrencyCode] <> "EUR")), "v", [v])
