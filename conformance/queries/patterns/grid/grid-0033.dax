// note: the view expander's grid (tools/ossie/grid.mjs), having: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.Quantity, AGG(t."Total Cost") AS v FROM "dax-sql-patterns".Sales AS t GROUP BY t.Quantity HAVING AGG(t.Orders) > 0
EVALUATE SELECTCOLUMNS(FILTER(SUMMARIZECOLUMNS('Sales'[Quantity], "__rows", COUNTROWS('Sales'), "v", 'Sales'[Total Cost]), ('Sales'[Orders] > 0)), "Quantity", 'Sales'[Quantity], "v", [v])
