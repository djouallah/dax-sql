// note: the view expander's grid (tools/ossie/grid.mjs), having null: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.Quantity, AGG(t."Order Lines") AS v FROM "dax-sql-patterns".Sales AS t GROUP BY t.Quantity HAVING AGG(t.Orders) IS NOT NULL
EVALUATE SELECTCOLUMNS(FILTER(SUMMARIZECOLUMNS('Sales'[Quantity], "__rows", COUNTROWS(Sales), "v", 'Sales'[Order Lines]), NOT(ISBLANK('Sales'[Orders]))), "Quantity", 'Sales'[Quantity], "v", [v])
