// note: the view expander's grid (tools/ossie/grid.mjs), order by measure: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.Quantity, AGG(t."Avg Order Value") AS v FROM "dax-sql-patterns".Sales AS t GROUP BY t.Quantity ORDER BY v DESC NULLS LAST, t.Quantity NULLS FIRST
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('Sales'[Quantity], "__rows", COUNTROWS('Sales'), "v", 'Sales'[Avg Order Value]), "Quantity", 'Sales'[Quantity], "v", [v]) ORDER BY [v] DESC, [Quantity]
