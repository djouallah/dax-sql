// note: the view expander's grid (tools/ossie/grid.mjs), rollup: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.EmployeeKey, AGG(t."Sales Amount") AS v FROM "dax-sql-patterns".Sales AS t GROUP BY ROLLUP (t.EmployeeKey) ORDER BY t.EmployeeKey NULLS LAST
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS(ROLLUPADDISSUBTOTAL('Sales'[EmployeeKey], "__level1_EmployeeKey"), "__rows", COUNTROWS(Sales), "v", 'Sales'[Sales Amount]), "EmployeeKey", 'Sales'[EmployeeKey], "v", [v]) ORDER BY ISBLANK([EmployeeKey]), [EmployeeKey]
