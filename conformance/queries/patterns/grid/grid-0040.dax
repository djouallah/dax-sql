// note: the view expander's grid (tools/ossie/grid.mjs), ratio: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.Quantity, CAST(AGG(t.Customers) AS DOUBLE) / NULLIF(AGG(t.Orders), 0) AS r FROM "dax-sql-patterns".Sales AS t GROUP BY t.Quantity
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('Sales'[Quantity], "__rows", COUNTROWS(Sales), "r", IF(ISBLANK(COUNTROWS(Sales)), BLANK(), (CONVERT('Sales'[Customers], DOUBLE) / IF(('Sales'[Orders] == 0), BLANK(), 'Sales'[Orders])))), "Quantity", 'Sales'[Quantity], "r", [r])
