// note: the view expander's grid (tools/ossie/grid.mjs), two metrics: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.CurrencyCode, AGG(t."Total Quantity") AS a, AGG(t."Customer Distinct Products") AS b FROM "dax-sql-patterns".Sales AS t GROUP BY t.CurrencyCode
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('Sales'[CurrencyCode], "__rows", COUNTROWS('Sales'), "a", 'Sales'[Total Quantity], "b", 'Sales'[Customer Distinct Products]), "CurrencyCode", 'Sales'[CurrencyCode], "a", [a], "b", [b])
