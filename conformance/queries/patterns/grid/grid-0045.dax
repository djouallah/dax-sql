// note: the view expander's grid (tools/ossie/grid.mjs), two groups: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.CurrencyCode, t.EmployeeKey, AGG(t."Total Cost") AS v FROM "dax-sql-patterns".Sales AS t GROUP BY t.CurrencyCode, t.EmployeeKey
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('Sales'[CurrencyCode], 'Sales'[EmployeeKey], "__rows", COUNTROWS('Sales'), "v", 'Sales'[Total Cost]), "CurrencyCode", 'Sales'[CurrencyCode], "EmployeeKey", 'Sales'[EmployeeKey], "v", [v])
