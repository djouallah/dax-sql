// note: the view expander's grid (tools/ossie/grid.mjs), where: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.CurrencyCode, AGG(t.Orders) AS v FROM "dax-sql-patterns".Sales AS t WHERE t.EmployeeKey IS NOT NULL GROUP BY t.CurrencyCode
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('Sales'[CurrencyCode], "__rows", COUNTROWS('Sales'), "v", 'Sales'[Orders]), NOT(ISBLANK('Sales'[EmployeeKey]))), "CurrencyCode", 'Sales'[CurrencyCode], "v", [v])
