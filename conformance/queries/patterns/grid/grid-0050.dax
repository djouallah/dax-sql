// note: the view expander's grid (tools/ossie/grid.mjs), having: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.CurrencyCode, AGG(t."Total Quantity") AS v FROM "dax-sql-patterns".Sales AS t GROUP BY t.CurrencyCode HAVING AGG(t.Customers) > 0
EVALUATE SELECTCOLUMNS(FILTER(SUMMARIZECOLUMNS('Sales'[CurrencyCode], "__rows", COUNTROWS(Sales), "v", 'Sales'[Total Quantity]), ('Sales'[Customers] > 0)), "CurrencyCode", 'Sales'[CurrencyCode], "v", [v])
