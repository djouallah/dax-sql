// note: the view expander's grid (tools/ossie/grid.mjs), scalar ops: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.CurrencyCode, AGG(t."Customer Distinct Products") * 2 AS a, AGG(t."Customer Distinct Products") + 1 AS b, COALESCE(AGG(t."Customer Distinct Products"), 0) AS c FROM "dax-sql-patterns".Sales AS t GROUP BY t.CurrencyCode
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('Sales'[CurrencyCode], "__rows", COUNTROWS('Sales'), "a", ('Sales'[Customer Distinct Products] * 2), "b", ('Sales'[Customer Distinct Products] + 1), "c", IF(ISBLANK(COUNTROWS('Sales')), BLANK(), COALESCE('Sales'[Customer Distinct Products], 0))), "CurrencyCode", 'Sales'[CurrencyCode], "a", [a], "b", [b], "c", [c])
