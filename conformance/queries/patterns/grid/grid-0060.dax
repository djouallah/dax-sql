// note: the view expander's grid (tools/ossie/grid.mjs), two metrics: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.CurrencyCode, AGG(t."Total Cost") AS a, AGG(t.Orders) AS b FROM "dax-sql-patterns".Sales AS t GROUP BY t.CurrencyCode
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('Sales'[CurrencyCode], "__rows", COUNTROWS(Sales), "a", 'Sales'[Total Cost], "b", 'Sales'[Orders]), "CurrencyCode", 'Sales'[CurrencyCode], "a", [a], "b", [b])
