// note: the view expander's grid (tools/ossie/grid.mjs), where: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.CurrencyCode, AGG(t.Customers) AS v FROM "dax-sql-patterns".Sales AS t WHERE t.ProductKey = 28 GROUP BY t.CurrencyCode
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('Sales'[CurrencyCode], "__rows", COUNTROWS(Sales), "v", 'Sales'[Customers]), ('Sales'[ProductKey] = 28)), "CurrencyCode", 'Sales'[CurrencyCode], "v", [v])
