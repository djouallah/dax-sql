// note: the view expander's grid (tools/ossie/grid.mjs), where and: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.CurrencyCode, AGG(t.Customers) AS v FROM "dax-sql-patterns".Sales AS t WHERE t.Quantity IN (6, 4) AND t.Quantity BETWEEN 1 AND 2 GROUP BY t.CurrencyCode
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('Sales'[CurrencyCode], "__rows", COUNTROWS(Sales), "v", 'Sales'[Customers]), ('Sales'[Quantity] IN {6, 4}), (('Sales'[Quantity] >= 1) && ('Sales'[Quantity] <= 2))), "CurrencyCode", 'Sales'[CurrencyCode], "v", [v])
