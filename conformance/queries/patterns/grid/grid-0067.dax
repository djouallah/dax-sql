// note: the view expander's grid (tools/ossie/grid.mjs), order limit: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.CurrencyCode, AGG(t."Avg Order Value") AS v FROM "dax-sql-patterns".Sales AS t GROUP BY t.CurrencyCode ORDER BY t.CurrencyCode NULLS FIRST LIMIT 3
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('Sales'[CurrencyCode], "__rows", COUNTROWS('Sales'), "v", 'Sales'[Avg Order Value]), "CurrencyCode", 'Sales'[CurrencyCode], "v", [v]) ORDER BY [CurrencyCode]
