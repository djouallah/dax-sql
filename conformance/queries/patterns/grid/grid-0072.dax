// note: the view expander's grid (tools/ossie/grid.mjs), ratio: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.CurrencyCode, CAST(AGG(t.Orders) AS DOUBLE) / NULLIF(AGG(t."Total Quantity"), 0) AS r FROM "dax-sql-patterns".Sales AS t GROUP BY t.CurrencyCode
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('Sales'[CurrencyCode], "__rows", COUNTROWS('Sales'), "r", IF(ISBLANK(COUNTROWS('Sales')), BLANK(), (CONVERT('Sales'[Orders], DOUBLE) / IF(('Sales'[Total Quantity] == 0), BLANK(), 'Sales'[Total Quantity])))), "CurrencyCode", 'Sales'[CurrencyCode], "r", [r])
