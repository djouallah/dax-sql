// note: the view expander's grid (tools/ossie/grid.mjs), group: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.EmployeeKey, AGG(t."Total Quantity") AS v FROM "dax-sql-patterns".Sales AS t GROUP BY t.EmployeeKey
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('Sales'[EmployeeKey], "__rows", COUNTROWS(Sales), "v", 'Sales'[Total Quantity]), "EmployeeKey", 'Sales'[EmployeeKey], "v", [v])
