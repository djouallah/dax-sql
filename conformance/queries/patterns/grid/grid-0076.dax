// note: the view expander's grid (tools/ossie/grid.mjs), two metrics: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.EmployeeKey, AGG(t."Total Quantity") AS a, AGG(t.Orders) AS b FROM "dax-sql-patterns".Sales AS t GROUP BY t.EmployeeKey
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('Sales'[EmployeeKey], "__rows", COUNTROWS(Sales), "a", 'Sales'[Total Quantity], "b", 'Sales'[Orders]), "EmployeeKey", 'Sales'[EmployeeKey], "a", [a], "b", [b])
