// note: the view expander's grid (tools/ossie/grid.mjs), where: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.EmployeeKey, AGG(t.Customers) AS v FROM "dax-sql-patterns".Sales AS t WHERE t.Quantity = 5 GROUP BY t.EmployeeKey
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('Sales'[EmployeeKey], "__rows", COUNTROWS(Sales), "v", 'Sales'[Customers]), ('Sales'[Quantity] = 5)), "EmployeeKey", 'Sales'[EmployeeKey], "v", [v])
