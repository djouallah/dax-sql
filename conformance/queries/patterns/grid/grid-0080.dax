// note: the view expander's grid (tools/ossie/grid.mjs), where total: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT AGG(t."Order Lines") AS v FROM "dax-sql-patterns".Sales AS t WHERE t.EmployeeKey IN (1, 8)
EVALUATE SELECTCOLUMNS(CALCULATETABLE(ROW("v", 'Sales'[Order Lines]), ('Sales'[EmployeeKey] IN {1, 8})), "v", [v])
