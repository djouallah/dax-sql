// note: the view expander's grid (tools/ossie/grid.mjs), having: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.EmployeeKey, AGG(t."Order Lines") AS v FROM "dax-sql-patterns".Sales AS t GROUP BY t.EmployeeKey HAVING AGG(t."Sales Amount") > 0
EVALUATE SELECTCOLUMNS(FILTER(SUMMARIZECOLUMNS('Sales'[EmployeeKey], "__rows", COUNTROWS(Sales), "v", 'Sales'[Order Lines]), ('Sales'[Sales Amount] > 0)), "EmployeeKey", 'Sales'[EmployeeKey], "v", [v])
