// note: the view expander's grid (tools/ossie/grid.mjs), having null: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.EmployeeKey, AGG(t.Orders) AS v FROM "dax-sql-patterns".Sales AS t GROUP BY t.EmployeeKey HAVING AGG(t."Total Quantity") IS NOT NULL
EVALUATE SELECTCOLUMNS(FILTER(SUMMARIZECOLUMNS('Sales'[EmployeeKey], "__rows", COUNTROWS(Sales), "v", 'Sales'[Orders]), NOT(ISBLANK('Sales'[Total Quantity]))), "EmployeeKey", 'Sales'[EmployeeKey], "v", [v])
