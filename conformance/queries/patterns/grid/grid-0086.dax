// note: the view expander's grid (tools/ossie/grid.mjs), rollup: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.CurrencyCode, AGG(t."Total Quantity") AS v FROM "dax-sql-patterns".Sales AS t GROUP BY ROLLUP (t.CurrencyCode) ORDER BY t.CurrencyCode NULLS LAST
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS(ROLLUPADDISSUBTOTAL('Sales'[CurrencyCode], "__level1_CurrencyCode"), "__rows", COUNTROWS(Sales), "v", 'Sales'[Total Quantity]), "CurrencyCode", 'Sales'[CurrencyCode], "v", [v]) ORDER BY ISBLANK([CurrencyCode]), [CurrencyCode]
