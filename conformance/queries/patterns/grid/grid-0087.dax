// note: the view expander's grid (tools/ossie/grid.mjs), scalar ops: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.EmployeeKey, AGG(t."Total Cost") * 2 AS a, AGG(t."Total Cost") + 1 AS b, COALESCE(AGG(t."Total Cost"), 0) AS c FROM "dax-sql-patterns".Sales AS t GROUP BY t.EmployeeKey
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('Sales'[EmployeeKey], "__rows", COUNTROWS(Sales), "a", ('Sales'[Total Cost] * 2), "b", ('Sales'[Total Cost] + 1), "c", IF(ISBLANK(COUNTROWS(Sales)), BLANK(), COALESCE('Sales'[Total Cost], 0))), "EmployeeKey", 'Sales'[EmployeeKey], "a", [a], "b", [b], "c", [c])
