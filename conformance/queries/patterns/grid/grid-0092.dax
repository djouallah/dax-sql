// note: the view expander's grid (tools/ossie/grid.mjs), two metrics: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t."Line Number", AGG(t.Customers) AS a, AGG(t."Total Cost") AS b FROM "dax-sql-patterns".Sales AS t GROUP BY t."Line Number"
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('Sales'[Line Number], "__rows", COUNTROWS('Sales'), "a", 'Sales'[Customers], "b", 'Sales'[Total Cost]), "Line Number", 'Sales'[Line Number], "a", [a], "b", [b])
