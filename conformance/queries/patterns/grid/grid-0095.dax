// note: the view expander's grid (tools/ossie/grid.mjs), where or: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t."Line Number", AGG(t."Total Quantity") AS v FROM "dax-sql-patterns".Sales AS t WHERE t."Unit Cost" >= 15.76 OR t.CustomerKey IS NOT NULL GROUP BY t."Line Number"
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('Sales'[Line Number], "__rows", COUNTROWS(Sales), "v", 'Sales'[Total Quantity]), (('Sales'[Unit Cost] >= 15.76) || NOT(ISBLANK('Sales'[CustomerKey])))), "Line Number", 'Sales'[Line Number], "v", [v])
