// note: the view expander's grid (tools/ossie/grid.mjs), where total: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT AGG(t."Total Quantity") AS v FROM "dax-sql-patterns".Sales AS t WHERE t.CurrencyCode IN ('USD', 'AUD')
EVALUATE SELECTCOLUMNS(CALCULATETABLE(ROW("v", 'Sales'[Total Quantity]), ('Sales'[CurrencyCode] IN {"USD", "AUD"})), "v", [v])
