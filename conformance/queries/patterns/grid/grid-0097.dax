// note: the view expander's grid (tools/ossie/grid.mjs), having: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t."Line Number", AGG(t.Customers) AS v FROM "dax-sql-patterns".Sales AS t GROUP BY t."Line Number" HAVING AGG(t."Total Cost") > 0
EVALUATE SELECTCOLUMNS(FILTER(SUMMARIZECOLUMNS('Sales'[Line Number], "__rows", COUNTROWS('Sales'), "v", 'Sales'[Customers]), ('Sales'[Total Cost] > 0)), "Line Number", 'Sales'[Line Number], "v", [v])
