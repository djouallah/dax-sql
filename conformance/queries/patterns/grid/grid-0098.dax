// note: the view expander's grid (tools/ossie/grid.mjs), having null: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t."Line Number", AGG(t."Total Quantity") AS v FROM "dax-sql-patterns".Sales AS t GROUP BY t."Line Number" HAVING AGG(t."Avg Order Value") IS NOT NULL
EVALUATE SELECTCOLUMNS(FILTER(SUMMARIZECOLUMNS('Sales'[Line Number], "__rows", COUNTROWS(Sales), "v", 'Sales'[Total Quantity]), NOT(ISBLANK('Sales'[Avg Order Value]))), "Line Number", 'Sales'[Line Number], "v", [v])
