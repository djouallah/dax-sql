// note: the view expander's grid (tools/ossie/grid.mjs), order limit: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t."Line Number", AGG(t."Avg Order Value") AS v FROM "dax-sql-patterns".Sales AS t GROUP BY t."Line Number" ORDER BY t."Line Number" NULLS FIRST LIMIT 3
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('Sales'[Line Number], "__rows", COUNTROWS(Sales), "v", 'Sales'[Avg Order Value]), "Line Number", 'Sales'[Line Number], "v", [v]) ORDER BY [Line Number]
