// note: the view expander's grid (tools/ossie/grid.mjs), derived table: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT s."Line Number", s.v FROM (SELECT t."Line Number", AGG(t."Sales Amount") AS v FROM "dax-sql-patterns".Sales AS t GROUP BY t."Line Number") AS s WHERE s.v IS NOT NULL
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('Sales'[Line Number], "__rows", COUNTROWS('Sales'), "v", 'Sales'[Sales Amount]), "Line Number", 'Sales'[Line Number], "v", [v])
