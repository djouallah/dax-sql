// note: the view expander's grid (tools/ossie/grid.mjs), where or: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.YearMonth, AGG(t."Budget Amount") AS v FROM "dax-sql-patterns".Budget AS t WHERE t.YearMonth BETWEEN 202301 AND 202410 OR t.Budget < 16003 GROUP BY t.YearMonth
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('Budget'[YearMonth], "__rows", COUNTROWS(Budget), "v", 'Budget'[Budget Amount]), ((('Budget'[YearMonth] >= 202301) && ('Budget'[YearMonth] <= 202410)) || ('Budget'[Budget] < 16003))), "YearMonth", 'Budget'[YearMonth], "v", [v])
