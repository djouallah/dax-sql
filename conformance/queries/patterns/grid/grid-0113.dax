// note: the view expander's grid (tools/ossie/grid.mjs), having: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.YearMonth, AGG(t."Budget Amount") AS v FROM "dax-sql-patterns".Budget AS t GROUP BY t.YearMonth HAVING AGG(t."Budget Amount") > 0
EVALUATE SELECTCOLUMNS(FILTER(SUMMARIZECOLUMNS('Budget'[YearMonth], "__rows", COUNTROWS(Budget), "v", 'Budget'[Budget Amount]), ([v] > 0)), "YearMonth", 'Budget'[YearMonth], "v", [v])
