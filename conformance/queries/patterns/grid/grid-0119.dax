// note: the view expander's grid (tools/ossie/grid.mjs), scalar ops: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.YearMonth, AGG(t."Budget Amount") * 2 AS a, AGG(t."Budget Amount") + 1 AS b, COALESCE(AGG(t."Budget Amount"), 0) AS c FROM "dax-sql-patterns".Budget AS t GROUP BY t.YearMonth
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('Budget'[YearMonth], "__rows", COUNTROWS(Budget), "a", ('Budget'[Budget Amount] * 2), "b", ('Budget'[Budget Amount] + 1), "c", IF(ISBLANK(COUNTROWS(Budget)), BLANK(), COALESCE('Budget'[Budget Amount], 0))), "YearMonth", 'Budget'[YearMonth], "a", [a], "b", [b], "c", [c])
