// note: the view expander's grid (tools/ossie/grid.mjs), two groups: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.CategoryKey, t.YearMonth, AGG(t."Budget Amount") AS v FROM "dax-sql-patterns".Budget AS t GROUP BY t.CategoryKey, t.YearMonth
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('Budget'[CategoryKey], 'Budget'[YearMonth], "__rows", COUNTROWS('Budget'), "v", 'Budget'[Budget Amount]), "CategoryKey", 'Budget'[CategoryKey], "YearMonth", 'Budget'[YearMonth], "v", [v])
