// note: the view expander's grid (tools/ossie/grid.mjs), where and: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.CategoryKey, AGG(t."Budget Amount") AS v FROM "dax-sql-patterns".Budget AS t WHERE t.Budget IS NOT NULL AND t.CategoryKey >= 1 GROUP BY t.CategoryKey
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('Budget'[CategoryKey], "__rows", COUNTROWS(Budget), "v", 'Budget'[Budget Amount]), NOT(ISBLANK('Budget'[Budget])), ('Budget'[CategoryKey] >= 1)), "CategoryKey", 'Budget'[CategoryKey], "v", [v])
