// note: the view expander's grid (tools/ossie/grid.mjs), where total: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT AGG(t."Budget Amount") AS v FROM "dax-sql-patterns".Budget AS t WHERE NOT (t.YearMonth = 202305)
EVALUATE SELECTCOLUMNS(CALCULATETABLE(ROW("v", 'Budget'[Budget Amount]), NOT(('Budget'[YearMonth] = 202305))), "v", [v])
