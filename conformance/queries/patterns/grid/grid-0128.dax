// note: the view expander's grid (tools/ossie/grid.mjs), having: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.CategoryKey, AGG(t."Budget Amount") AS v FROM "dax-sql-patterns".Budget AS t GROUP BY t.CategoryKey HAVING AGG(t."Budget Amount") > 0
EVALUATE SELECTCOLUMNS(FILTER(SUMMARIZECOLUMNS('Budget'[CategoryKey], "__rows", COUNTROWS('Budget'), "v", 'Budget'[Budget Amount]), ([v] > 0)), "CategoryKey", 'Budget'[CategoryKey], "v", [v])
