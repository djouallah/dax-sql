// note: the view expander's grid (tools/ossie/grid.mjs), order by measure: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.CategoryKey, AGG(t."Budget Amount") AS v FROM "dax-sql-patterns".Budget AS t GROUP BY t.CategoryKey ORDER BY v DESC NULLS LAST, t.CategoryKey NULLS FIRST
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('Budget'[CategoryKey], "__rows", COUNTROWS(Budget), "v", 'Budget'[Budget Amount]), "CategoryKey", 'Budget'[CategoryKey], "v", [v]) ORDER BY [v] DESC, [CategoryKey]
