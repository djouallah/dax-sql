// note: the view expander's grid (tools/ossie/grid.mjs), cte: its SQL as dax-sql's SQL front end writes it in DAX:
// WITH s AS (SELECT CategoryKey, "Budget Amount" AS mm FROM "dax-sql-patterns".Budget WHERE CategoryKey >= 3) SELECT CategoryKey, AGG(mm) AS v FROM s GROUP BY CategoryKey
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('Budget'[CategoryKey], "__rows", COUNTROWS(Budget), "v", 'Budget'[Budget Amount]), ('Budget'[CategoryKey] >= 3)), "CategoryKey", 'Budget'[CategoryKey], "v", [v])
