// note: the view expander's grid (tools/ossie/grid.mjs), where and: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.CategoryKey, AGG(t."Budget Amount") AS v FROM "dax-sql-patterns".Budget AS t WHERE t.YearMonth BETWEEN 202301 AND 202305 AND t.CategoryKey < 1 GROUP BY t.CategoryKey
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('Budget'[CategoryKey], "__rows", COUNTROWS(Budget), "v", 'Budget'[Budget Amount]), (('Budget'[YearMonth] >= 202301) && ('Budget'[YearMonth] <= 202305)), ('Budget'[CategoryKey] < 1)), "CategoryKey", 'Budget'[CategoryKey], "v", [v])
