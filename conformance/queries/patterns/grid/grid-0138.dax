// note: the view expander's grid (tools/ossie/grid.mjs), where or: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.CategoryKey, AGG(t."Budget Amount") AS v FROM "dax-sql-patterns".Budget AS t WHERE t.CategoryKey <> 2 OR t.YearMonth = 202403 GROUP BY t.CategoryKey
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('Budget'[CategoryKey], "__rows", COUNTROWS('Budget'), "v", 'Budget'[Budget Amount]), (('Budget'[CategoryKey] <> 2) || ('Budget'[YearMonth] = 202403))), "CategoryKey", 'Budget'[CategoryKey], "v", [v])
