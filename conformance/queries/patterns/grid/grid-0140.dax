// note: the view expander's grid (tools/ossie/grid.mjs), rollup: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.CategoryKey, AGG(t."Budget Amount") AS v FROM "dax-sql-patterns".Budget AS t GROUP BY ROLLUP (t.CategoryKey) ORDER BY t.CategoryKey NULLS LAST
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS(ROLLUPADDISSUBTOTAL('Budget'[CategoryKey], "__level1_CategoryKey"), "__rows", COUNTROWS(Budget), "v", 'Budget'[Budget Amount]), "CategoryKey", 'Budget'[CategoryKey], "v", [v]) ORDER BY ISBLANK([CategoryKey]), [CategoryKey]
