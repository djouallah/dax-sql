// note: the view expander's grid (tools/ossie/grid.mjs), two groups: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.YearMonth, t.CategoryKey, AGG(t."Budget Amount") AS v FROM "dax-sql-patterns".Budget AS t GROUP BY t.YearMonth, t.CategoryKey
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('Budget'[YearMonth], 'Budget'[CategoryKey], "__rows", COUNTROWS(Budget), "v", 'Budget'[Budget Amount]), "YearMonth", 'Budget'[YearMonth], "CategoryKey", 'Budget'[CategoryKey], "v", [v])
