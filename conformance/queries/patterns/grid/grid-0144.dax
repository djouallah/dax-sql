// note: the view expander's grid (tools/ossie/grid.mjs), where and: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.YearMonth, AGG(t."Budget Amount") AS v FROM "dax-sql-patterns".Budget AS t WHERE t.Budget >= 16461 AND t.YearMonth IS NOT NULL GROUP BY t.YearMonth
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('Budget'[YearMonth], "__rows", COUNTROWS('Budget'), "v", 'Budget'[Budget Amount]), ('Budget'[Budget] >= 16461), NOT(ISBLANK('Budget'[YearMonth]))), "YearMonth", 'Budget'[YearMonth], "v", [v])
