// note: the view expander's grid (tools/ossie/grid.mjs), where and: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.YearMonth, AGG(t."Budget Amount") AS v FROM "dax-sql-patterns".Budget AS t WHERE t.CategoryKey BETWEEN 1 AND 3 AND t.YearMonth >= 202409 GROUP BY t.YearMonth
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('Budget'[YearMonth], "__rows", COUNTROWS(Budget), "v", 'Budget'[Budget Amount]), (('Budget'[CategoryKey] >= 1) && ('Budget'[CategoryKey] <= 3)), ('Budget'[YearMonth] >= 202409)), "YearMonth", 'Budget'[YearMonth], "v", [v])
