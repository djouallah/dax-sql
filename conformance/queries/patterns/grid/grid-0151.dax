// note: the view expander's grid (tools/ossie/grid.mjs), where total: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT AGG(t."Budget Amount") AS v FROM "dax-sql-patterns".Budget AS t WHERE t.Budget >= 14455
EVALUATE SELECTCOLUMNS(CALCULATETABLE(ROW("v", 'Budget'[Budget Amount]), ('Budget'[Budget] >= 14455)), "v", [v])
