// note: the view expander's grid (tools/ossie/grid.mjs), star: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.SubcategoryKey, AGG(f.Orders) AS v FROM "dax-sql-patterns".Sales AS f LEFT JOIN "dax-sql-patterns".Product AS o ON f.ProductKey = o.ProductKey GROUP BY o.SubcategoryKey
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('Product'[SubcategoryKey], "__rows", COUNTROWS(Sales), "v", 'Sales'[Orders]), "SubcategoryKey", 'Product'[SubcategoryKey], "v", [v])
