// note: the view expander's grid (tools/ossie/grid.mjs), star where many: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.SubcategoryKey, AGG(f."Sales Amount") AS v FROM "dax-sql-patterns".Sales AS f LEFT JOIN "dax-sql-patterns".Product AS o ON f.ProductKey = o.ProductKey WHERE f."Delivery Date" = DATE '2024-01-27' GROUP BY o.SubcategoryKey
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('Product'[SubcategoryKey], "__rows", COUNTROWS(Sales), "v", 'Sales'[Sales Amount]), ('Sales'[Delivery Date] = DATE(2024, 1, 27))), "SubcategoryKey", 'Product'[SubcategoryKey], "v", [v])
