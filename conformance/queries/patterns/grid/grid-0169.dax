// note: the view expander's grid (tools/ossie/grid.mjs), star: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.Brand, AGG(f.Customers) AS v FROM "dax-sql-patterns".Sales AS f LEFT JOIN "dax-sql-patterns".Product AS o ON f.ProductKey = o.ProductKey GROUP BY o.Brand
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('Product'[Brand], "__rows", COUNTROWS('Sales'), "v", 'Sales'[Customers]), "Brand", 'Product'[Brand], "v", [v])
