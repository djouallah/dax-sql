// note: the view expander's grid (tools/ossie/grid.mjs), star where many: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.Brand, AGG(f."Total Cost") AS v FROM "dax-sql-patterns".Sales AS f LEFT JOIN "dax-sql-patterns".Product AS o ON f.ProductKey = o.ProductKey WHERE NOT (f."Unit Cost" = 18.9) GROUP BY o.Brand
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('Product'[Brand], "__rows", COUNTROWS('Sales'), "v", 'Sales'[Total Cost]), NOT(('Sales'[Unit Cost] = 18.9))), "Brand", 'Product'[Brand], "v", [v])
