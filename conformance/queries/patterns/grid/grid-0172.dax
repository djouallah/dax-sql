// note: the view expander's grid (tools/ossie/grid.mjs), star two sides: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.Brand, f.EmployeeKey, AGG(f.Orders) AS v FROM "dax-sql-patterns".Sales AS f LEFT JOIN "dax-sql-patterns".Product AS o ON f.ProductKey = o.ProductKey GROUP BY o.Brand, f.EmployeeKey
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('Product'[Brand], 'Sales'[EmployeeKey], "__rows", COUNTROWS('Sales'), "v", 'Sales'[Orders]), "Brand", 'Product'[Brand], "EmployeeKey", 'Sales'[EmployeeKey], "v", [v])
