// note: the view expander's grid (tools/ossie/grid.mjs), star: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.City, AGG(f."Order Lines") AS v FROM "dax-sql-patterns".Sales AS f JOIN "dax-sql-patterns".Customer AS o ON f.CustomerKey = o.CustomerKey GROUP BY o.City
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('Customer'[City], "__rows", COUNTROWS(Sales), "v", 'Sales'[Order Lines]), NOT(ISBLANK('Customer'[CustomerKey]))), "City", 'Customer'[City], "v", [v])
