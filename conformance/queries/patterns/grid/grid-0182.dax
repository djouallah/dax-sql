// note: the view expander's grid (tools/ossie/grid.mjs), star total: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT AGG(f.Orders) AS v FROM "dax-sql-patterns".Sales AS f JOIN "dax-sql-patterns".Customer AS o ON f.CustomerKey = o.CustomerKey
EVALUATE SELECTCOLUMNS(CALCULATETABLE(ROW("v", 'Sales'[Orders]), NOT(ISBLANK('Customer'[CustomerKey]))), "v", [v])
