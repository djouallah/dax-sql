// note: the view expander's grid (tools/ossie/grid.mjs), star where one: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.City, AGG(f.Customers) AS v FROM "dax-sql-patterns".Sales AS f JOIN "dax-sql-patterns".Customer AS o ON f.CustomerKey = o.CustomerKey WHERE o."Birth Year" IS NOT NULL GROUP BY o.City
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('Customer'[City], "__rows", COUNTROWS('Sales'), "v", 'Sales'[Customers]), NOT(ISBLANK('Customer'[Birth Year])), NOT(ISBLANK('Customer'[CustomerKey]))), "City", 'Customer'[City], "v", [v])
