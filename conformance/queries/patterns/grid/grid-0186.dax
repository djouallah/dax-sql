// note: the view expander's grid (tools/ossie/grid.mjs), star two sides: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.City, f.CurrencyCode, AGG(f.Customers) AS v FROM "dax-sql-patterns".Sales AS f JOIN "dax-sql-patterns".Customer AS o ON f.CustomerKey = o.CustomerKey GROUP BY o.City, f.CurrencyCode
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('Customer'[City], 'Sales'[CurrencyCode], "__rows", COUNTROWS('Sales'), "v", 'Sales'[Customers]), NOT(ISBLANK('Customer'[CustomerKey]))), "City", 'Customer'[City], "CurrencyCode", 'Sales'[CurrencyCode], "v", [v])
