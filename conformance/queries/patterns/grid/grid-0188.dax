// note: the view expander's grid (tools/ossie/grid.mjs), star: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.Weekday, AGG(f.Orders) AS v FROM "dax-sql-patterns".Sales AS f JOIN "dax-sql-patterns"."Date" AS o ON f."Order Date" = o."Date" GROUP BY o.Weekday
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('Date'[Weekday], "__rows", COUNTROWS(Sales), "v", 'Sales'[Orders]), NOT(ISBLANK('Date'[Date]))), "Weekday", 'Date'[Weekday], "v", [v])
