// note: the view expander's grid (tools/ossie/grid.mjs), star where many: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.Weekday, AGG(f."Customer Distinct Products") AS v FROM "dax-sql-patterns".Sales AS f JOIN "dax-sql-patterns"."Date" AS o ON f."Order Date" = o."Date" WHERE f."Line Number" IN (2, 4) GROUP BY o.Weekday
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('Date'[Weekday], "__rows", COUNTROWS(Sales), "v", 'Sales'[Customer Distinct Products]), ('Sales'[Line Number] IN {2, 4}), NOT(ISBLANK('Date'[Date]))), "Weekday", 'Date'[Weekday], "v", [v])
