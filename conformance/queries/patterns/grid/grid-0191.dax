// note: the view expander's grid (tools/ossie/grid.mjs), star two sides: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.Weekday, f.Quantity, AGG(f."Total Cost") AS v FROM "dax-sql-patterns".Sales AS f JOIN "dax-sql-patterns"."Date" AS o ON f."Order Date" = o."Date" GROUP BY o.Weekday, f.Quantity
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('Date'[Weekday], 'Sales'[Quantity], "__rows", COUNTROWS('Sales'), "v", 'Sales'[Total Cost]), NOT(ISBLANK('Date'[Date]))), "Weekday", 'Date'[Weekday], "Quantity", 'Sales'[Quantity], "v", [v])
