// note: the view expander's grid (tools/ossie/grid.mjs), star total: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT AGG(f.Customers) AS v FROM "dax-sql-patterns".Sales AS f JOIN "dax-sql-patterns"."Date" AS o ON f."Order Date" = o."Date"
EVALUATE SELECTCOLUMNS(CALCULATETABLE(ROW("v", 'Sales'[Customers]), NOT(ISBLANK('Date'[Date]))), "v", [v])
