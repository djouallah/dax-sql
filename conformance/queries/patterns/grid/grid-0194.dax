// note: the view expander's grid (tools/ossie/grid.mjs), star where one: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o."Working Day", AGG(f."Total Cost") AS v FROM "dax-sql-patterns".Sales AS f JOIN "dax-sql-patterns"."Date" AS o ON f."Order Date" = o."Date" WHERE o.YearMonth = 202309 GROUP BY o."Working Day"
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('Date'[Working Day], "__rows", COUNTROWS('Sales'), "v", 'Sales'[Total Cost]), ('Date'[YearMonth] = 202309), NOT(ISBLANK('Date'[Date]))), "Working Day", 'Date'[Working Day], "v", [v])
