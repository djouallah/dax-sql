// note: the view expander's grid (tools/ossie/grid.mjs), star two sides: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o."Working Day", f."Line Number", AGG(f."Customer Distinct Products") AS v FROM "dax-sql-patterns".Sales AS f JOIN "dax-sql-patterns"."Date" AS o ON f."Order Date" = o."Date" GROUP BY o."Working Day", f."Line Number"
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('Date'[Working Day], 'Sales'[Line Number], "__rows", COUNTROWS(Sales), "v", 'Sales'[Customer Distinct Products]), NOT(ISBLANK('Date'[Date]))), "Working Day", 'Date'[Working Day], "Line Number", 'Sales'[Line Number], "v", [v])
