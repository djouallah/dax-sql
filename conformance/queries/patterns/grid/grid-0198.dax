// note: the view expander's grid (tools/ossie/grid.mjs), star: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o."Day Name", AGG(f."Order Lines") AS v FROM "dax-sql-patterns".Sales AS f LEFT JOIN "dax-sql-patterns"."Date" AS o ON f."Order Date" = o."Date" GROUP BY o."Day Name"
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('Date'[Day Name], "__rows", COUNTROWS(Sales), "v", 'Sales'[Order Lines]), "Day Name", 'Date'[Day Name], "v", [v])
