// note: the view expander's grid (tools/ossie/grid.mjs), star where one: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o."Day Name", AGG(f."Total Cost") AS v FROM "dax-sql-patterns".Sales AS f LEFT JOIN "dax-sql-patterns"."Date" AS o ON f."Order Date" = o."Date" WHERE o."Working Day" IS NOT NULL GROUP BY o."Day Name"
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('Date'[Day Name], "__rows", COUNTROWS(Sales), "v", 'Sales'[Total Cost]), NOT(ISBLANK('Date'[Working Day]))), "Day Name", 'Date'[Day Name], "v", [v])
