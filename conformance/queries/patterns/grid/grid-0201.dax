// note: the view expander's grid (tools/ossie/grid.mjs), star two sides: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o."Day Name", f.CurrencyCode, AGG(f.Orders) AS v FROM "dax-sql-patterns".Sales AS f LEFT JOIN "dax-sql-patterns"."Date" AS o ON f."Order Date" = o."Date" GROUP BY o."Day Name", f.CurrencyCode
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('Date'[Day Name], 'Sales'[CurrencyCode], "__rows", COUNTROWS(Sales), "v", 'Sales'[Orders]), "Day Name", 'Date'[Day Name], "CurrencyCode", 'Sales'[CurrencyCode], "v", [v])
