// note: the view expander's grid (tools/ossie/grid.mjs), star where many: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o."Month Name", AGG(f."Total Cost") AS v FROM "dax-sql-patterns".Sales AS f JOIN "dax-sql-patterns"."Date" AS o ON f."Delivery Date" = o."Date" WHERE NOT (f."Order Number" = 461) GROUP BY o."Month Name"
DEFINE
VAR __v1 = GENERATE(SELECTCOLUMNS('Sales', "f.Order Number", 'Sales'[Order Number], "f.Line Number", 'Sales'[Line Number], "f.Order Date", 'Sales'[Order Date], "f.Delivery Date", 'Sales'[Delivery Date], "f.ProductKey", 'Sales'[ProductKey], "f.CustomerKey", 'Sales'[CustomerKey], "f.EmployeeKey", 'Sales'[EmployeeKey], "f.CurrencyCode", 'Sales'[CurrencyCode], "f.Quantity", 'Sales'[Quantity], "f.Net Price", 'Sales'[Net Price], "f.Unit Cost", 'Sales'[Unit Cost]), FILTER(SELECTCOLUMNS('Date', "o.Date", 'Date'[Date], "o.Month Name", 'Date'[Month Name]), ([f.Delivery Date] = [o.Date])))
VAR __v2 = FILTER(__v1, NOT(([f.Order Number] = 461)))
VAR __v3 = DISTINCT(SELECTCOLUMNS(__v2, "Month Name", [o.Month Name]))
EVALUATE SELECTCOLUMNS(ADDCOLUMNS(__v3, "__m1", CALCULATE('Sales'[Total Cost], REMOVEFILTERS(), TREATAS(SELECTCOLUMNS(FILTER(__v2, (NOT(((((((((((ISBLANK([f.Order Number]) && ISBLANK([f.Line Number])) && ISBLANK([f.Order Date])) && ISBLANK([f.Delivery Date])) && ISBLANK([f.ProductKey])) && ISBLANK([f.CustomerKey])) && ISBLANK([f.EmployeeKey])) && ISBLANK([f.CurrencyCode])) && ISBLANK([f.Quantity])) && ISBLANK([f.Net Price])) && ISBLANK([f.Unit Cost]))) && ([o.Month Name] == [Month Name]))), "__k1", [f.Order Number], "__k2", [f.Line Number], "__k3", [f.Order Date], "__k4", [f.Delivery Date], "__k5", [f.ProductKey], "__k6", [f.CustomerKey], "__k7", [f.EmployeeKey], "__k8", [f.CurrencyCode], "__k9", [f.Quantity], "__k10", [f.Net Price], "__k11", [f.Unit Cost]), 'Sales'[Order Number], 'Sales'[Line Number], 'Sales'[Order Date], 'Sales'[Delivery Date], 'Sales'[ProductKey], 'Sales'[CustomerKey], 'Sales'[EmployeeKey], 'Sales'[CurrencyCode], 'Sales'[Quantity], 'Sales'[Net Price], 'Sales'[Unit Cost]))), "Month Name", [Month Name], "v", [__m1])
