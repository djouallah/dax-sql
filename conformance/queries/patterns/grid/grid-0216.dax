// note: the view expander's grid (tools/ossie/grid.mjs), star two sides: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o."Working Day", f.EmployeeKey, AGG(f."Order Lines") AS v FROM "dax-sql-patterns".Sales AS f LEFT JOIN "dax-sql-patterns"."Date" AS o ON f."Delivery Date" = o."Date" GROUP BY o."Working Day", f.EmployeeKey
DEFINE
VAR __v1 = GENERATEALL(SELECTCOLUMNS('Sales', "f.Order Number", 'Sales'[Order Number], "f.Line Number", 'Sales'[Line Number], "f.Order Date", 'Sales'[Order Date], "f.Delivery Date", 'Sales'[Delivery Date], "f.ProductKey", 'Sales'[ProductKey], "f.CustomerKey", 'Sales'[CustomerKey], "f.EmployeeKey", 'Sales'[EmployeeKey], "f.CurrencyCode", 'Sales'[CurrencyCode], "f.Quantity", 'Sales'[Quantity], "f.Net Price", 'Sales'[Net Price], "f.Unit Cost", 'Sales'[Unit Cost]), FILTER(SELECTCOLUMNS('Date', "o.Date", 'Date'[Date], "o.Working Day", 'Date'[Working Day]), ([f.Delivery Date] = [o.Date])))
VAR __v2 = DISTINCT(SELECTCOLUMNS(__v1, "Working Day", [o.Working Day], "EmployeeKey", [f.EmployeeKey]))
EVALUATE SELECTCOLUMNS(ADDCOLUMNS(__v2, "__m1", CALCULATE('Sales'[Order Lines], REMOVEFILTERS(), TREATAS(SELECTCOLUMNS(FILTER(__v1, ((NOT(((((((((((ISBLANK([f.Order Number]) && ISBLANK([f.Line Number])) && ISBLANK([f.Order Date])) && ISBLANK([f.Delivery Date])) && ISBLANK([f.ProductKey])) && ISBLANK([f.CustomerKey])) && ISBLANK([f.EmployeeKey])) && ISBLANK([f.CurrencyCode])) && ISBLANK([f.Quantity])) && ISBLANK([f.Net Price])) && ISBLANK([f.Unit Cost]))) && ([o.Working Day] == [Working Day])) && ([f.EmployeeKey] == [EmployeeKey]))), "__k1", [f.Order Number], "__k2", [f.Line Number], "__k3", [f.Order Date], "__k4", [f.Delivery Date], "__k5", [f.ProductKey], "__k6", [f.CustomerKey], "__k7", [f.EmployeeKey], "__k8", [f.CurrencyCode], "__k9", [f.Quantity], "__k10", [f.Net Price], "__k11", [f.Unit Cost]), 'Sales'[Order Number], 'Sales'[Line Number], 'Sales'[Order Date], 'Sales'[Delivery Date], 'Sales'[ProductKey], 'Sales'[CustomerKey], 'Sales'[EmployeeKey], 'Sales'[CurrencyCode], 'Sales'[Quantity], 'Sales'[Net Price], 'Sales'[Unit Cost]))), "Working Day", [Working Day], "EmployeeKey", [EmployeeKey], "v", [__m1])
