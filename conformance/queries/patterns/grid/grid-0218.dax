// note: the view expander's grid (tools/ossie/grid.mjs), star: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.Title, AGG(f.Customers) AS v FROM "dax-sql-patterns".Sales AS f LEFT JOIN "dax-sql-patterns".Employee AS o ON f.EmployeeKey = o.EmployeeKey GROUP BY o.Title
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('Employee'[Title], "__rows", COUNTROWS('Sales'), "v", 'Sales'[Customers]), "Title", 'Employee'[Title], "v", [v])
