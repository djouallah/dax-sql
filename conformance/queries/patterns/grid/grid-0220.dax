// note: the view expander's grid (tools/ossie/grid.mjs), star where many: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.Title, AGG(f."Customer Distinct Products") AS v FROM "dax-sql-patterns".Sales AS f LEFT JOIN "dax-sql-patterns".Employee AS o ON f.EmployeeKey = o.EmployeeKey WHERE f."Line Number" < 3 GROUP BY o.Title
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('Employee'[Title], "__rows", COUNTROWS('Sales'), "v", 'Sales'[Customer Distinct Products]), ('Sales'[Line Number] < 3)), "Title", 'Employee'[Title], "v", [v])
