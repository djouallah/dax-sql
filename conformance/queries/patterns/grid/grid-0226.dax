// note: the view expander's grid (tools/ossie/grid.mjs), star two sides: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.ParentEmployeeKey, f.CurrencyCode, AGG(f."Sales Amount") AS v FROM "dax-sql-patterns".Sales AS f LEFT JOIN "dax-sql-patterns".Employee AS o ON f.EmployeeKey = o.EmployeeKey GROUP BY o.ParentEmployeeKey, f.CurrencyCode
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('Employee'[ParentEmployeeKey], 'Sales'[CurrencyCode], "__rows", COUNTROWS('Sales'), "v", 'Sales'[Sales Amount]), "ParentEmployeeKey", 'Employee'[ParentEmployeeKey], "CurrencyCode", 'Sales'[CurrencyCode], "v", [v])
