// note: the view expander's grid (tools/ossie/grid.mjs), star where one: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.ParentEmployeeKey, AGG(f."Total Quantity") AS v FROM "dax-sql-patterns".Sales AS f LEFT JOIN "dax-sql-patterns".Employee AS o ON f.EmployeeKey = o.EmployeeKey WHERE o.Employee <> 'Dev Patel' GROUP BY o.ParentEmployeeKey
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('Employee'[ParentEmployeeKey], "__rows", COUNTROWS('Sales'), "v", 'Sales'[Total Quantity]), ('Employee'[Employee] <> "Dev Patel")), "ParentEmployeeKey", 'Employee'[ParentEmployeeKey], "v", [v])
