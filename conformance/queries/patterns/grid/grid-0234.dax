// note: the view expander's grid (tools/ossie/grid.mjs), star where one: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.Currency, AGG(f.Orders) AS v FROM "dax-sql-patterns".Sales AS f LEFT JOIN "dax-sql-patterns".Currency AS o ON f.CurrencyCode = o.CurrencyCode WHERE o.Currency IN ('US Dollar', 'Euro') GROUP BY o.Currency
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('Currency'[Currency], "__rows", COUNTROWS('Sales'), "v", 'Sales'[Orders]), ('Currency'[Currency] IN {"US Dollar", "Euro"})), "Currency", 'Currency'[Currency], "v", [v])
