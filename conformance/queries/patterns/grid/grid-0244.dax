// note: the view expander's grid (tools/ossie/grid.mjs), star where one: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.Currency, AGG(f."Avg Order Value") AS v FROM "dax-sql-patterns".Sales AS f JOIN "dax-sql-patterns".Currency AS o ON f.CurrencyCode = o.CurrencyCode WHERE o.CurrencyCode <> 'AUD' GROUP BY o.Currency
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('Currency'[Currency], "__rows", COUNTROWS('Sales'), "v", 'Sales'[Avg Order Value]), ('Currency'[CurrencyCode] <> "AUD"), NOT(ISBLANK('Currency'[CurrencyCode]))), "Currency", 'Currency'[Currency], "v", [v])
