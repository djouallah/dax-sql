// note: the view expander's grid (tools/ossie/grid.mjs), star where many: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.Currency, AGG(f."Customer Distinct Products") AS v FROM "dax-sql-patterns".Sales AS f JOIN "dax-sql-patterns".Currency AS o ON f.CurrencyCode = o.CurrencyCode WHERE f."Delivery Date" < DATE '2024-03-04' GROUP BY o.Currency
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('Currency'[Currency], "__rows", COUNTROWS(Sales), "v", 'Sales'[Customer Distinct Products]), ('Sales'[Delivery Date] < DATE(2024, 3, 4)), NOT(ISBLANK('Currency'[CurrencyCode]))), "Currency", 'Currency'[Currency], "v", [v])
