// note: the view expander's grid (tools/ossie/grid.mjs), star where one: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.Category, AGG(f."Budget Amount") AS v FROM "dax-sql-patterns".Budget AS f LEFT JOIN "dax-sql-patterns".Category AS o ON f.CategoryKey = o.CategoryKey WHERE o.Category <> 'Clothing' GROUP BY o.Category
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('Category'[Category], "__rows", COUNTROWS('Budget'), "v", 'Budget'[Budget Amount]), ('Category'[Category] <> "Clothing")), "Category", 'Category'[Category], "v", [v])
