EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('Category'[Category], 'Budget'[CategoryKey], "__rows", COUNTROWS(Budget), "v", 'Budget'[Budget Amount]), "Category", 'Category'[Category], "CategoryKey", 'Budget'[CategoryKey], "v", [v])
