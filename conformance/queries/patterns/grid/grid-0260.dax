// note: the view expander's grid (tools/ossie/grid.mjs), star two sides: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.CategoryKey, f.YearMonth, AGG(f."Budget Amount") AS v FROM "dax-sql-patterns".Budget AS f JOIN "dax-sql-patterns".Category AS o ON f.CategoryKey = o.CategoryKey GROUP BY o.CategoryKey, f.YearMonth
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('Category'[CategoryKey], 'Budget'[YearMonth], "__rows", COUNTROWS('Budget'), "v", 'Budget'[Budget Amount]), NOT(ISBLANK('Category'[CategoryKey]))), "CategoryKey", 'Category'[CategoryKey], "YearMonth", 'Budget'[YearMonth], "v", [v])
