// note: the view expander's grid (tools/ossie/grid.mjs), star where one: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o."Month", AGG(f."Budget Amount") AS v FROM "dax-sql-patterns".Budget AS f LEFT JOIN "dax-sql-patterns"."Date" AS o ON f.YearMonth = o.YearMonth WHERE o.Quarter = 4 GROUP BY o."Month"
DEFINE
VAR __v1 = GENERATEALL(SELECTCOLUMNS('Budget', "f.CategoryKey", 'Budget'[CategoryKey], "f.YearMonth", 'Budget'[YearMonth], "f.Budget", 'Budget'[Budget]), FILTER(SELECTCOLUMNS('Date', "o.Date", 'Date'[Date], "o.Month", 'Date'[Month], "o.Quarter", 'Date'[Quarter], "o.YearMonth", 'Date'[YearMonth]), ([f.YearMonth] = [o.YearMonth])))
VAR __v2 = FILTER(__v1, ([o.Quarter] = 4))
VAR __v3 = DISTINCT(SELECTCOLUMNS(__v2, "Month", [o.Month]))
EVALUATE SELECTCOLUMNS(ADDCOLUMNS(__v3, "__m1", CALCULATE('Budget'[Budget Amount], REMOVEFILTERS(), TREATAS(SELECTCOLUMNS(FILTER(__v2, (NOT(((ISBLANK([f.CategoryKey]) && ISBLANK([f.YearMonth])) && ISBLANK([f.Budget]))) && ([o.Month] == [Month]))), "__k1", [f.CategoryKey], "__k2", [f.YearMonth], "__k3", [f.Budget]), 'Budget'[CategoryKey], 'Budget'[YearMonth], 'Budget'[Budget]))), "Month", [Month], "v", [__m1])
