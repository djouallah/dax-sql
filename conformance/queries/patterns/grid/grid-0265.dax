// note: the view expander's grid (tools/ossie/grid.mjs), star total: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT AGG(f."Budget Amount") AS v FROM "dax-sql-patterns".Budget AS f LEFT JOIN "dax-sql-patterns"."Date" AS o ON f.YearMonth = o.YearMonth
DEFINE
VAR __v1 = GENERATEALL(SELECTCOLUMNS('Budget', "f.CategoryKey", 'Budget'[CategoryKey], "f.YearMonth", 'Budget'[YearMonth], "f.Budget", 'Budget'[Budget]), FILTER(SELECTCOLUMNS('Date', "o.Date", 'Date'[Date], "o.YearMonth", 'Date'[YearMonth]), ([f.YearMonth] = [o.YearMonth])))
VAR __v2 = ROW("__all", 1)
EVALUATE SELECTCOLUMNS(ADDCOLUMNS(__v2, "__m1", CALCULATE('Budget'[Budget Amount], REMOVEFILTERS(), TREATAS(SELECTCOLUMNS(FILTER(__v1, NOT(((ISBLANK([f.CategoryKey]) && ISBLANK([f.YearMonth])) && ISBLANK([f.Budget])))), "__k1", [f.CategoryKey], "__k2", [f.YearMonth], "__k3", [f.Budget]), 'Budget'[CategoryKey], 'Budget'[YearMonth], 'Budget'[Budget]))), "v", [__m1])
