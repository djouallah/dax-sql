// note: the view expander's grid (tools/ossie/grid.mjs), star where one: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o."Month Name", AGG(f.Snapshots) AS v FROM "dax-sql-patterns".Inventory AS f JOIN "dax-sql-patterns"."Date" AS o ON f."Date" = o."Date" WHERE o."Day Name" IS NOT NULL GROUP BY o."Month Name"
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('Date'[Month Name], "__rows", COUNTROWS('Inventory'), "v", 'Inventory'[Snapshots]), NOT(ISBLANK('Date'[Day Name])), NOT(ISBLANK('Date'[Date]))), "Month Name", 'Date'[Month Name], "v", [v])
