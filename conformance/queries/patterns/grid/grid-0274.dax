// note: the view expander's grid (tools/ossie/grid.mjs), star where many: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o."Month Name", AGG(f.Snapshots) AS v FROM "dax-sql-patterns".Inventory AS f JOIN "dax-sql-patterns"."Date" AS o ON f."Date" = o."Date" WHERE NOT (f."On Hand" = 33) GROUP BY o."Month Name"
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('Date'[Month Name], "__rows", COUNTROWS('Inventory'), "v", 'Inventory'[Snapshots]), NOT(('Inventory'[On Hand] = 33)), NOT(ISBLANK('Date'[Date]))), "Month Name", 'Date'[Month Name], "v", [v])
