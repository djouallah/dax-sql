// note: the view expander's grid (tools/ossie/grid.mjs), star where many: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o."Fiscal Year", AGG(f.Snapshots) AS v FROM "dax-sql-patterns".Inventory AS f LEFT JOIN "dax-sql-patterns"."Date" AS o ON f."Date" = o."Date" WHERE f."Date" IS NOT NULL GROUP BY o."Fiscal Year"
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('Date'[Fiscal Year], "__rows", COUNTROWS(Inventory), "v", 'Inventory'[Snapshots]), NOT(ISBLANK('Inventory'[Date]))), "Fiscal Year", 'Date'[Fiscal Year], "v", [v])
