// note: the view expander's grid (tools/ossie/grid.mjs), star total: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT AGG(f.Snapshots) AS v FROM "dax-sql-patterns".Inventory AS f JOIN "dax-sql-patterns".Product AS o ON f.ProductKey = o.ProductKey
EVALUATE SELECTCOLUMNS(CALCULATETABLE(ROW("v", 'Inventory'[Snapshots]), NOT(ISBLANK('Product'[ProductKey]))), "v", [v])
