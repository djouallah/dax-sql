// note: the view expander's grid (tools/ossie/grid.mjs), star where many: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.Color, AGG(f.Snapshots) AS v FROM "dax-sql-patterns".Inventory AS f JOIN "dax-sql-patterns".Product AS o ON f.ProductKey = o.ProductKey WHERE f."On Hand" < 90 GROUP BY o.Color
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('Product'[Color], "__rows", COUNTROWS(Inventory), "v", 'Inventory'[Snapshots]), ('Inventory'[On Hand] < 90), NOT(ISBLANK('Product'[ProductKey]))), "Color", 'Product'[Color], "v", [v])
