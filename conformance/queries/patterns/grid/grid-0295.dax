// note: the view expander's grid (tools/ossie/grid.mjs), chasm: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o."Day Name", AGG(a."Budget Amount") AS x, AGG(b.Orders) AS y FROM "dax-sql-patterns"."Date" AS o LEFT JOIN "dax-sql-patterns".Budget AS a ON a.YearMonth = o.YearMonth LEFT JOIN "dax-sql-patterns".Sales AS b ON b."Order Date" = o."Date" GROUP BY o."Day Name"
DEFINE
VAR __v1 = GENERATEALL(GENERATEALL(SELECTCOLUMNS(Date, "o.Date", 'Date'[Date], "o.Day Name", 'Date'[Day Name], "o.YearMonth", 'Date'[YearMonth]), FILTER(SELECTCOLUMNS(Budget, "a.CategoryKey", 'Budget'[CategoryKey], "a.YearMonth", 'Budget'[YearMonth], "a.Budget", 'Budget'[Budget]), ([a.YearMonth] = [o.YearMonth]))), FILTER(SELECTCOLUMNS(Sales, "b.Order Number", 'Sales'[Order Number], "b.Line Number", 'Sales'[Line Number], "b.Order Date", 'Sales'[Order Date], "b.Delivery Date", 'Sales'[Delivery Date], "b.ProductKey", 'Sales'[ProductKey], "b.CustomerKey", 'Sales'[CustomerKey], "b.EmployeeKey", 'Sales'[EmployeeKey], "b.CurrencyCode", 'Sales'[CurrencyCode], "b.Quantity", 'Sales'[Quantity], "b.Net Price", 'Sales'[Net Price], "b.Unit Cost", 'Sales'[Unit Cost]), ([b.Order Date] = [o.Date])))
VAR __v2 = DISTINCT(SELECTCOLUMNS(__v1, "Day Name", [o.Day Name]))
EVALUATE SELECTCOLUMNS(ADDCOLUMNS(__v2, "__m1", CALCULATE('Budget'[Budget Amount], REMOVEFILTERS(), TREATAS(SELECTCOLUMNS(FILTER(__v1, (NOT(((ISBLANK([a.CategoryKey]) && ISBLANK([a.YearMonth])) && ISBLANK([a.Budget]))) && ([o.Day Name] == [Day Name]))), "__k1", [a.CategoryKey], "__k2", [a.YearMonth], "__k3", [a.Budget]), 'Budget'[CategoryKey], 'Budget'[YearMonth], 'Budget'[Budget])), "__m2", CALCULATE('Sales'[Orders], REMOVEFILTERS(), TREATAS(SELECTCOLUMNS(FILTER(__v1, (NOT(((((((((((ISBLANK([b.Order Number]) && ISBLANK([b.Line Number])) && ISBLANK([b.Order Date])) && ISBLANK([b.Delivery Date])) && ISBLANK([b.ProductKey])) && ISBLANK([b.CustomerKey])) && ISBLANK([b.EmployeeKey])) && ISBLANK([b.CurrencyCode])) && ISBLANK([b.Quantity])) && ISBLANK([b.Net Price])) && ISBLANK([b.Unit Cost]))) && ([o.Day Name] == [Day Name]))), "__k1", [b.Order Number], "__k2", [b.Line Number], "__k3", [b.Order Date], "__k4", [b.Delivery Date], "__k5", [b.ProductKey], "__k6", [b.CustomerKey], "__k7", [b.EmployeeKey], "__k8", [b.CurrencyCode], "__k9", [b.Quantity], "__k10", [b.Net Price], "__k11", [b.Unit Cost]), 'Sales'[Order Number], 'Sales'[Line Number], 'Sales'[Order Date], 'Sales'[Delivery Date], 'Sales'[ProductKey], 'Sales'[CustomerKey], 'Sales'[EmployeeKey], 'Sales'[CurrencyCode], 'Sales'[Quantity], 'Sales'[Net Price], 'Sales'[Unit Cost]))), "Day Name", [Day Name], "x", [__m1], "y", [__m2])
