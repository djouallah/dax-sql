// note: the view expander's grid (tools/ossie/grid.mjs), chasm: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.Weekday, AGG(a."Budget Amount") AS x, AGG(b.Snapshots) AS y FROM "dax-sql-patterns"."Date" AS o LEFT JOIN "dax-sql-patterns".Budget AS a ON a.YearMonth = o.YearMonth LEFT JOIN "dax-sql-patterns".Inventory AS b ON b."Date" = o."Date" GROUP BY o.Weekday
DEFINE
VAR __v1 = GENERATEALL(GENERATEALL(SELECTCOLUMNS('Date', "o.Date", 'Date'[Date], "o.Weekday", 'Date'[Weekday], "o.YearMonth", 'Date'[YearMonth]), FILTER(SELECTCOLUMNS('Budget', "a.CategoryKey", 'Budget'[CategoryKey], "a.YearMonth", 'Budget'[YearMonth], "a.Budget", 'Budget'[Budget]), ([a.YearMonth] = [o.YearMonth]))), FILTER(SELECTCOLUMNS('Inventory', "b.Date", 'Inventory'[Date], "b.ProductKey", 'Inventory'[ProductKey], "b.On Hand", 'Inventory'[On Hand]), ([b.Date] = [o.Date])))
VAR __v2 = DISTINCT(SELECTCOLUMNS(__v1, "Weekday", [o.Weekday]))
EVALUATE SELECTCOLUMNS(ADDCOLUMNS(__v2, "__m1", CALCULATE('Budget'[Budget Amount], REMOVEFILTERS(), TREATAS(SELECTCOLUMNS(FILTER(__v1, (NOT(((ISBLANK([a.CategoryKey]) && ISBLANK([a.YearMonth])) && ISBLANK([a.Budget]))) && ([o.Weekday] == [Weekday]))), "__k1", [a.CategoryKey], "__k2", [a.YearMonth], "__k3", [a.Budget]), 'Budget'[CategoryKey], 'Budget'[YearMonth], 'Budget'[Budget])), "__m2", CALCULATE('Inventory'[Snapshots], REMOVEFILTERS(), TREATAS(SELECTCOLUMNS(FILTER(__v1, (NOT(((ISBLANK([b.Date]) && ISBLANK([b.ProductKey])) && ISBLANK([b.On Hand]))) && ([o.Weekday] == [Weekday]))), "__k1", [b.Date], "__k2", [b.ProductKey], "__k3", [b.On Hand]), 'Inventory'[Date], 'Inventory'[ProductKey], 'Inventory'[On Hand]))), "Weekday", [Weekday], "x", [__m1], "y", [__m2])
