// note: the view expander's grid (tools/ossie/grid.mjs), chasm: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o."Fiscal Year", AGG(a.Snapshots) AS x, AGG(b."Total Quantity") AS y FROM "dax-sql-patterns"."Date" AS o LEFT JOIN "dax-sql-patterns".Inventory AS a ON a."Date" = o."Date" LEFT JOIN "dax-sql-patterns".Sales AS b ON b."Order Date" = o."Date" GROUP BY o."Fiscal Year"
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('Date'[Fiscal Year], "__rows", COUNTROWS('Date'), "x", CALCULATE('Inventory'[Snapshots], KEEPFILTERS(NOT(ISBLANK('Date'[Date])))), "y", CALCULATE('Sales'[Total Quantity], KEEPFILTERS(NOT(ISBLANK('Date'[Date]))))), "Fiscal Year", 'Date'[Fiscal Year], "x", [x], "y", [y])
