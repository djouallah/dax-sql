// note: the view expander's grid (tools/ossie/grid.mjs), chasm: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.Weekday, AGG(a.Snapshots) AS x, AGG(b."Avg Order Value") AS y FROM "dax-sql-patterns"."Date" AS o LEFT JOIN "dax-sql-patterns".Inventory AS a ON a."Date" = o."Date" LEFT JOIN "dax-sql-patterns".Sales AS b ON b."Delivery Date" = o."Date" GROUP BY o.Weekday
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('Date'[Weekday], "__rows", COUNTROWS('Date'), "x", CALCULATE('Inventory'[Snapshots], KEEPFILTERS(NOT(ISBLANK('Date'[Date])))), "y", CALCULATE('Sales'[Avg Order Value], KEEPFILTERS(NOT(ISBLANK('Date'[Date]))), USERELATIONSHIP('Sales'[Delivery Date], 'Date'[Date]))), "Weekday", 'Date'[Weekday], "x", [x], "y", [y])
