// note: the view expander's grid (tools/ossie/grid.mjs), chasm: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.Weekday, AGG(a.Snapshots) AS x, AGG(b."Avg Order Value") AS y FROM "dax-sql-patterns"."Date" AS o LEFT JOIN "dax-sql-patterns".Inventory AS a ON a."Date" = o."Date" LEFT JOIN "dax-sql-patterns".Sales AS b ON b."Delivery Date" = o."Date" GROUP BY o.Weekday
DEFINE
VAR __v1 = GENERATEALL(GENERATEALL(SELECTCOLUMNS('Date', "o.Date", 'Date'[Date], "o.Weekday", 'Date'[Weekday]), FILTER(SELECTCOLUMNS('Inventory', "a.Date", 'Inventory'[Date], "a.ProductKey", 'Inventory'[ProductKey], "a.On Hand", 'Inventory'[On Hand]), ([a.Date] = [o.Date]))), FILTER(SELECTCOLUMNS('Sales', "b.Order Number", 'Sales'[Order Number], "b.Line Number", 'Sales'[Line Number], "b.Order Date", 'Sales'[Order Date], "b.Delivery Date", 'Sales'[Delivery Date], "b.ProductKey", 'Sales'[ProductKey], "b.CustomerKey", 'Sales'[CustomerKey], "b.EmployeeKey", 'Sales'[EmployeeKey], "b.CurrencyCode", 'Sales'[CurrencyCode], "b.Quantity", 'Sales'[Quantity], "b.Net Price", 'Sales'[Net Price], "b.Unit Cost", 'Sales'[Unit Cost]), ([b.Delivery Date] = [o.Date])))
VAR __v2 = DISTINCT(SELECTCOLUMNS(__v1, "Weekday", [o.Weekday]))
EVALUATE SELECTCOLUMNS(ADDCOLUMNS(__v2, "__m1", CALCULATE('Inventory'[Snapshots], REMOVEFILTERS(), TREATAS(SELECTCOLUMNS(FILTER(__v1, (NOT(((ISBLANK([a.Date]) && ISBLANK([a.ProductKey])) && ISBLANK([a.On Hand]))) && ([o.Weekday] == [Weekday]))), "__k1", [a.Date], "__k2", [a.ProductKey], "__k3", [a.On Hand]), 'Inventory'[Date], 'Inventory'[ProductKey], 'Inventory'[On Hand])), "__m2", CALCULATE('Sales'[Avg Order Value], REMOVEFILTERS(), TREATAS(SELECTCOLUMNS(FILTER(__v1, (NOT(((((((((((ISBLANK([b.Order Number]) && ISBLANK([b.Line Number])) && ISBLANK([b.Order Date])) && ISBLANK([b.Delivery Date])) && ISBLANK([b.ProductKey])) && ISBLANK([b.CustomerKey])) && ISBLANK([b.EmployeeKey])) && ISBLANK([b.CurrencyCode])) && ISBLANK([b.Quantity])) && ISBLANK([b.Net Price])) && ISBLANK([b.Unit Cost]))) && ([o.Weekday] == [Weekday]))), "__k1", [b.Order Number], "__k2", [b.Line Number], "__k3", [b.Order Date], "__k4", [b.Delivery Date], "__k5", [b.ProductKey], "__k6", [b.CustomerKey], "__k7", [b.EmployeeKey], "__k8", [b.CurrencyCode], "__k9", [b.Quantity], "__k10", [b.Net Price], "__k11", [b.Unit Cost]), 'Sales'[Order Number], 'Sales'[Line Number], 'Sales'[Order Date], 'Sales'[Delivery Date], 'Sales'[ProductKey], 'Sales'[CustomerKey], 'Sales'[EmployeeKey], 'Sales'[CurrencyCode], 'Sales'[Quantity], 'Sales'[Net Price], 'Sales'[Unit Cost]))), "Weekday", [Weekday], "x", [__m1], "y", [__m2])
