// note: the view expander's grid (tools/ossie/grid.mjs), chasm: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.SubcategoryKey, AGG(a.Snapshots) AS x, AGG(b."Total Cost") AS y FROM "dax-sql-patterns".Product AS o LEFT JOIN "dax-sql-patterns".Inventory AS a ON a.ProductKey = o.ProductKey LEFT JOIN "dax-sql-patterns".Sales AS b ON b.ProductKey = o.ProductKey GROUP BY o.SubcategoryKey
DEFINE
VAR __v1 = GENERATEALL(GENERATEALL(SELECTCOLUMNS('Product', "o.ProductKey", 'Product'[ProductKey], "o.SubcategoryKey", 'Product'[SubcategoryKey]), FILTER(SELECTCOLUMNS('Inventory', "a.Date", 'Inventory'[Date], "a.ProductKey", 'Inventory'[ProductKey], "a.On Hand", 'Inventory'[On Hand]), ([a.ProductKey] = [o.ProductKey]))), FILTER(SELECTCOLUMNS('Sales', "b.Order Number", 'Sales'[Order Number], "b.Line Number", 'Sales'[Line Number], "b.Order Date", 'Sales'[Order Date], "b.Delivery Date", 'Sales'[Delivery Date], "b.ProductKey", 'Sales'[ProductKey], "b.CustomerKey", 'Sales'[CustomerKey], "b.EmployeeKey", 'Sales'[EmployeeKey], "b.CurrencyCode", 'Sales'[CurrencyCode], "b.Quantity", 'Sales'[Quantity], "b.Net Price", 'Sales'[Net Price], "b.Unit Cost", 'Sales'[Unit Cost]), ([b.ProductKey] = [o.ProductKey])))
VAR __v2 = DISTINCT(SELECTCOLUMNS(__v1, "SubcategoryKey", [o.SubcategoryKey]))
EVALUATE SELECTCOLUMNS(ADDCOLUMNS(__v2, "__m1", CALCULATE('Inventory'[Snapshots], REMOVEFILTERS(), TREATAS(SELECTCOLUMNS(FILTER(__v1, (NOT(((ISBLANK([a.Date]) && ISBLANK([a.ProductKey])) && ISBLANK([a.On Hand]))) && ([o.SubcategoryKey] == [SubcategoryKey]))), "__k1", [a.Date], "__k2", [a.ProductKey], "__k3", [a.On Hand]), 'Inventory'[Date], 'Inventory'[ProductKey], 'Inventory'[On Hand])), "__m2", CALCULATE('Sales'[Total Cost], REMOVEFILTERS(), TREATAS(SELECTCOLUMNS(FILTER(__v1, (NOT(((((((((((ISBLANK([b.Order Number]) && ISBLANK([b.Line Number])) && ISBLANK([b.Order Date])) && ISBLANK([b.Delivery Date])) && ISBLANK([b.ProductKey])) && ISBLANK([b.CustomerKey])) && ISBLANK([b.EmployeeKey])) && ISBLANK([b.CurrencyCode])) && ISBLANK([b.Quantity])) && ISBLANK([b.Net Price])) && ISBLANK([b.Unit Cost]))) && ([o.SubcategoryKey] == [SubcategoryKey]))), "__k1", [b.Order Number], "__k2", [b.Line Number], "__k3", [b.Order Date], "__k4", [b.Delivery Date], "__k5", [b.ProductKey], "__k6", [b.CustomerKey], "__k7", [b.EmployeeKey], "__k8", [b.CurrencyCode], "__k9", [b.Quantity], "__k10", [b.Net Price], "__k11", [b.Unit Cost]), 'Sales'[Order Number], 'Sales'[Line Number], 'Sales'[Order Date], 'Sales'[Delivery Date], 'Sales'[ProductKey], 'Sales'[CustomerKey], 'Sales'[EmployeeKey], 'Sales'[CurrencyCode], 'Sales'[Quantity], 'Sales'[Net Price], 'Sales'[Unit Cost]))), "SubcategoryKey", [SubcategoryKey], "x", [__m1], "y", [__m2])
