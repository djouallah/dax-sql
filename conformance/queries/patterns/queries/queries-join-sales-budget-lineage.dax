// note: NATURALLEFTOUTERJOIN of two SUMMARIZECOLUMNS results joined on the year and category columns they share by lineage: 2022 and the blank category keep their rows with a blank budget
DEFINE
	VAR s = SUMMARIZECOLUMNS('Date'[Year], 'Category'[Category], "Sales", [Sales Amount])
	VAR b = SUMMARIZECOLUMNS('Date'[Year], 'Category'[Category], "Budget", [Budget Amount])
EVALUATE
NATURALLEFTOUTERJOIN(s, b)
ORDER BY 'Date'[Year], 'Category'[Category]
