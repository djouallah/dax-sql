// note: RANK over ALLSELECTED brands inside a measure ranks each brand within the country of the current row
DEFINE
	MEASURE Sales[Queries Brand Rank] = RANK(SKIP, ALLSELECTED('Product'[Brand]), ORDERBY([Sales Amount], DESC))
EVALUATE
SUMMARIZECOLUMNS(
	'Customer'[Country],
	'Product'[Brand],
	TREATAS({"Contoso", "Fabrikam", "Litware", "Northwind"}, 'Product'[Brand]),
	TREATAS({"France", "Germany", "United States", "Australia"}, 'Customer'[Country]),
	"Sales_Amount", 'Sales'[Sales Amount],
	"Brand_Rank", [Queries Brand Rank]
)
ORDER BY 'Customer'[Country], 'Product'[Brand]
