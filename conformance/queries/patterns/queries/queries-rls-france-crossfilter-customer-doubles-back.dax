// note: under the France role, whose filter sits on Customer, CROSSFILTER BOTH on Sales-Customer would let the secured filter flow to Sales and back to Customer itself (a DAX error: row-level security cannot double back to its own table through CROSSFILTER)
// expect: error
// roles: France
EVALUATE
SUMMARIZECOLUMNS(
	Customer[City],
	"Sales", [Sales Amount],
	"Customers", COUNTROWS(Customer),
	"Customers Via Sales", CALCULATE(COUNTROWS(Customer), CROSSFILTER(Sales[CustomerKey], Customer[CustomerKey], BOTH))
)
ORDER BY Customer[City]
