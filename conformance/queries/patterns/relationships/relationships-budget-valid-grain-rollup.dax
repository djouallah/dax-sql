// note: a guarded budget shows only at category and month-or-coarser grain; subcategory rows keep sales but lose the budget, subtotals keep both
EVALUATE
SUMMARIZECOLUMNS(
    ROLLUPADDISSUBTOTAL(Category[Category], "Category Total", Subcategory[Subcategory], "Subcategory Total"),
    TREATAS({ 2024 }, 'Date'[Year]),
    "Budget", [Budget at Valid Grain],
    "Sales", [Sales Amount]
)
