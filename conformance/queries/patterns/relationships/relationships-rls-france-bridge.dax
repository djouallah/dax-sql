EVALUATE
SUMMARIZECOLUMNS(
    ROLLUPADDISSUBTOTAL(Account[Account Type], "Is Total"),
    "Accounts", COUNTROWS(Account),
    "Holders", COUNTROWS(AccountCustomer),
    "Customers", COUNTROWS(Customer),
    "Sales", [Sales Amount]
)
