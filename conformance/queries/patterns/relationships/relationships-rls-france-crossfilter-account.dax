EVALUATE
SUMMARIZECOLUMNS(
    ROLLUPADDISSUBTOTAL(Account[Account Type], "Is Total"),
    "Accounts", COUNTROWS(Account),
    "Accounts Held Both Ways", [Accounts Held Bridge],
    "Holders", COUNTROWS(AccountCustomer),
    "Accounts Reached by Sales", [Accounts with Sales Bridge]
)
