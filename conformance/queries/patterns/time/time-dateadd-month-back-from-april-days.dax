// note: DATEADD by -1 MONTH day by day through April, into a longer March: April 30 alone moves to March 30 only
EVALUATE
SUMMARIZECOLUMNS(
    'Date'[Date],
    TREATAS({202404}, 'Date'[YearMonth]),
    "Days", COUNTROWS(DATEADD('Date'[Date], -1, MONTH)),
    "First", CALCULATE(MIN('Date'[Date]), DATEADD('Date'[Date], -1, MONTH)),
    "Last", CALCULATE(MAX('Date'[Date]), DATEADD('Date'[Date], -1, MONTH)),
    "Previous Month Day", [Sales PM DateAdd]
)
ORDER BY 'Date'[Date]
