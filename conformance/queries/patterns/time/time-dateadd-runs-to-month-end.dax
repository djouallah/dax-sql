// note: DATEADD of a run of days ending on a month end, into a longer month: a run of two or more reaches the moved month's end, one day alone does not
EVALUATE
UNION(
    ROW("Case", "Apr 29-30 2024 -1 MONTH",
        "Days", CALCULATE(COUNTROWS(DATEADD('Date'[Date], -1, MONTH)), DATESBETWEEN('Date'[Date], dt"2024-04-29", dt"2024-04-30")),
        "First", CALCULATE(CALCULATE(MIN('Date'[Date]), DATEADD('Date'[Date], -1, MONTH)), DATESBETWEEN('Date'[Date], dt"2024-04-29", dt"2024-04-30")),
        "Last", CALCULATE(CALCULATE(MAX('Date'[Date]), DATEADD('Date'[Date], -1, MONTH)), DATESBETWEEN('Date'[Date], dt"2024-04-29", dt"2024-04-30"))),
    ROW("Case", "Apr 15-30 2024 -1 MONTH",
        "Days", CALCULATE(COUNTROWS(DATEADD('Date'[Date], -1, MONTH)), DATESBETWEEN('Date'[Date], dt"2024-04-15", dt"2024-04-30")),
        "First", CALCULATE(CALCULATE(MIN('Date'[Date]), DATEADD('Date'[Date], -1, MONTH)), DATESBETWEEN('Date'[Date], dt"2024-04-15", dt"2024-04-30")),
        "Last", CALCULATE(CALCULATE(MAX('Date'[Date]), DATEADD('Date'[Date], -1, MONTH)), DATESBETWEEN('Date'[Date], dt"2024-04-15", dt"2024-04-30"))),
    ROW("Case", "Feb 28-29 2024 +1 MONTH",
        "Days", CALCULATE(COUNTROWS(DATEADD('Date'[Date], 1, MONTH)), DATESBETWEEN('Date'[Date], dt"2024-02-28", dt"2024-02-29")),
        "First", CALCULATE(CALCULATE(MIN('Date'[Date]), DATEADD('Date'[Date], 1, MONTH)), DATESBETWEEN('Date'[Date], dt"2024-02-28", dt"2024-02-29")),
        "Last", CALCULATE(CALCULATE(MAX('Date'[Date]), DATEADD('Date'[Date], 1, MONTH)), DATESBETWEEN('Date'[Date], dt"2024-02-28", dt"2024-02-29"))),
    ROW("Case", "Feb 27-28 2023 +1 YEAR",
        "Days", CALCULATE(COUNTROWS(DATEADD('Date'[Date], 1, YEAR)), DATESBETWEEN('Date'[Date], dt"2023-02-27", dt"2023-02-28")),
        "First", CALCULATE(CALCULATE(MIN('Date'[Date]), DATEADD('Date'[Date], 1, YEAR)), DATESBETWEEN('Date'[Date], dt"2023-02-27", dt"2023-02-28")),
        "Last", CALCULATE(CALCULATE(MAX('Date'[Date]), DATEADD('Date'[Date], 1, YEAR)), DATESBETWEEN('Date'[Date], dt"2023-02-27", dt"2023-02-28"))),
    ROW("Case", "Feb 28 2023 +1 YEAR",
        "Days", CALCULATE(COUNTROWS(DATEADD('Date'[Date], 1, YEAR)), DATESBETWEEN('Date'[Date], dt"2023-02-28", dt"2023-02-28")),
        "First", CALCULATE(CALCULATE(MIN('Date'[Date]), DATEADD('Date'[Date], 1, YEAR)), DATESBETWEEN('Date'[Date], dt"2023-02-28", dt"2023-02-28")),
        "Last", CALCULATE(CALCULATE(MAX('Date'[Date]), DATEADD('Date'[Date], 1, YEAR)), DATESBETWEEN('Date'[Date], dt"2023-02-28", dt"2023-02-28")))
)
