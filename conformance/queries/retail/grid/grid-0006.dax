// note: the view expander's grid (tools/ossie/grid.mjs), where total: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT AGG(t.customer_count) AS v FROM retail_model.customers AS t WHERE t.region <> 'WEST'
EVALUATE SELECTCOLUMNS(CALCULATETABLE(ROW("v", 'customers'[customer_count]), ('customers'[region] <> "WEST")), "v", COALESCE([v], 0))
