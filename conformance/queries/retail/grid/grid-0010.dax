// note: the view expander's grid (tools/ossie/grid.mjs), order by measure: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.customer_id, AGG(t.customer_count) AS v FROM retail_model.customers AS t GROUP BY t.customer_id ORDER BY v DESC NULLS LAST, t.customer_id NULLS FIRST
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('customers'[customer_id], "__rows", COUNTROWS('customers'), "v", 'customers'[customer_count]), "customer_id", 'customers'[customer_id], "v", COALESCE([v], 0)) ORDER BY [v] DESC, [customer_id]
