// note: the view expander's grid (tools/ossie/grid.mjs), rollup: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.region, AGG(t.customer_count) AS v FROM retail_model.customers AS t GROUP BY ROLLUP (t.region) ORDER BY t.region NULLS LAST
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS(ROLLUPADDISSUBTOTAL('customers'[region], "__level1_region"), "__rows", COUNTROWS(customers), "v", 'customers'[customer_count]), "region", 'customers'[region], "v", COALESCE([v], 0)) ORDER BY ISBLANK([region]), [region]
