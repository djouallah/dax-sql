// note: the view expander's grid (tools/ossie/grid.mjs), scalar ops: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.customer_id, AGG(t.customer_count) * 2 AS a, AGG(t.customer_count) + 1 AS b, COALESCE(AGG(t.customer_count), 0) AS c FROM retail_model.customers AS t GROUP BY t.customer_id
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('customers'[customer_id], "__rows", COUNTROWS('customers'), "a", IF(ISBLANK(COUNTROWS('customers')), BLANK(), (COALESCE('customers'[customer_count], 0) * 2)), "b", IF(ISBLANK(COUNTROWS('customers')), BLANK(), (COALESCE('customers'[customer_count], 0) + 1)), "c", IF(ISBLANK(COUNTROWS('customers')), BLANK(), COALESCE(COALESCE('customers'[customer_count], 0), 0))), "customer_id", 'customers'[customer_id], "a", [a], "b", [b], "c", [c])
