// note: the view expander's grid (tools/ossie/grid.mjs), cte: its SQL as dax-sql's SQL front end writes it in DAX:
// WITH s AS (SELECT customer_id, customer_count AS mm FROM retail_model.customers WHERE region IS NOT NULL) SELECT customer_id, AGG(mm) AS v FROM s GROUP BY customer_id
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('customers'[customer_id], "__rows", COUNTROWS(customers), "v", 'customers'[customer_count]), NOT(ISBLANK('customers'[region]))), "customer_id", 'customers'[customer_id], "v", COALESCE([v], 0))
