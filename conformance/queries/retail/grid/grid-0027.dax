// note: the view expander's grid (tools/ossie/grid.mjs), having: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.region, AGG(t.customer_count) AS v FROM retail_model.customers AS t GROUP BY t.region HAVING AGG(t.customer_count) > 0
EVALUATE SELECTCOLUMNS(FILTER(SUMMARIZECOLUMNS('customers'[region], "__rows", COUNTROWS(customers), "v", 'customers'[customer_count]), (COALESCE([v], 0) > 0)), "region", 'customers'[region], "v", COALESCE([v], 0))
