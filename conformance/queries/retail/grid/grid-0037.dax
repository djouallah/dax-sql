// note: the view expander's grid (tools/ossie/grid.mjs), where or: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.region, AGG(t.customer_count) AS v FROM retail_model.customers AS t WHERE t.customer_id <> 'C3' OR t.region = 'EAST' GROUP BY t.region
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('customers'[region], "__rows", COUNTROWS('customers'), "v", 'customers'[customer_count]), (('customers'[customer_id] <> "C3") || ('customers'[region] = "EAST"))), "region", 'customers'[region], "v", COALESCE([v], 0))
