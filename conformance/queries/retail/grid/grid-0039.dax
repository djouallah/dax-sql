// note: the view expander's grid (tools/ossie/grid.mjs), cte: its SQL as dax-sql's SQL front end writes it in DAX:
// WITH s AS (SELECT region, customer_count AS mm FROM retail_model.customers WHERE customer_id IN ('C4', 'C4')) SELECT region, AGG(mm) AS v FROM s GROUP BY region
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('customers'[region], "__rows", COUNTROWS('customers'), "v", 'customers'[customer_count]), ('customers'[customer_id] IN {"C4", "C4"})), "region", 'customers'[region], "v", COALESCE([v], 0))
