// note: the view expander's grid (tools/ossie/grid.mjs), where or: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.customer_id, AGG(t.customer_count) AS v FROM retail_model.customers AS t WHERE NOT (t.customer_id = 'C1') OR t.customer_id <> 'C2' GROUP BY t.customer_id
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('customers'[customer_id], "__rows", COUNTROWS(customers), "v", 'customers'[customer_count]), (NOT(('customers'[customer_id] = "C1")) || ('customers'[customer_id] <> "C2"))), "customer_id", 'customers'[customer_id], "v", COALESCE([v], 0))
