// note: the view expander's grid (tools/ossie/grid.mjs), where or: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.customer_id, AGG(t.customer_count) AS v FROM retail_model.customers AS t WHERE t.customer_id IN ('C1', 'C2') OR t.region <> 'NORTH' GROUP BY t.customer_id
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('customers'[customer_id], "__rows", COUNTROWS('customers'), "v", 'customers'[customer_count]), (('customers'[customer_id] IN {"C1", "C2"}) || ('customers'[region] <> "NORTH"))), "customer_id", 'customers'[customer_id], "v", COALESCE([v], 0))
