// note: the view expander's grid (tools/ossie/grid.mjs), where: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.amount, AGG(t.total_revenue) AS v FROM retail_model.orders AS t WHERE t.amount <> 200 GROUP BY t.amount
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('orders'[amount], "__rows", COUNTROWS('orders'), "v", 'orders'[total_revenue]), ('orders'[amount] <> 200)), "amount", 'orders'[amount], "v", [v])
