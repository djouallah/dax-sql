// note: the view expander's grid (tools/ossie/grid.mjs), where and: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.amount, AGG(t.total_revenue) AS v FROM retail_model.orders AS t WHERE t.amount < 100 AND t.amount BETWEEN 50 AND 300 GROUP BY t.amount
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('orders'[amount], "__rows", COUNTROWS('orders'), "v", 'orders'[total_revenue]), ('orders'[amount] < 100), (('orders'[amount] >= 50) && ('orders'[amount] <= 300))), "amount", 'orders'[amount], "v", [v])
