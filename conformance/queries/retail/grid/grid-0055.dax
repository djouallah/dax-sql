// note: the view expander's grid (tools/ossie/grid.mjs), where or: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.amount, AGG(t.total_revenue) AS v FROM retail_model.orders AS t WHERE t.order_id IN ('O3', 'O2') OR t.customer_id IN ('C2', 'C3') GROUP BY t.amount
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('orders'[amount], "__rows", COUNTROWS(orders), "v", 'orders'[total_revenue]), (('orders'[order_id] IN {"O3", "O2"}) || ('orders'[customer_id] IN {"C2", "C3"}))), "amount", 'orders'[amount], "v", [v])
