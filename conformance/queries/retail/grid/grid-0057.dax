// note: the view expander's grid (tools/ossie/grid.mjs), having: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.amount, AGG(t.total_revenue) AS v FROM retail_model.orders AS t GROUP BY t.amount HAVING AGG(t.total_revenue) > 0
EVALUATE SELECTCOLUMNS(FILTER(SUMMARIZECOLUMNS('orders'[amount], "__rows", COUNTROWS('orders'), "v", 'orders'[total_revenue]), ([v] > 0)), "amount", 'orders'[amount], "v", [v])
