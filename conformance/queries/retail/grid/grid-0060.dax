// note: the view expander's grid (tools/ossie/grid.mjs), order by measure: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.amount, AGG(t.total_revenue) AS v FROM retail_model.orders AS t GROUP BY t.amount ORDER BY v DESC NULLS LAST, t.amount NULLS FIRST
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('orders'[amount], "__rows", COUNTROWS(orders), "v", 'orders'[total_revenue]), "amount", 'orders'[amount], "v", [v]) ORDER BY [v] DESC, [amount]
