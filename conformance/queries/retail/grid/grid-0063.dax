// note: the view expander's grid (tools/ossie/grid.mjs), scalar ops: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.amount, AGG(t.total_revenue) * 2 AS a, AGG(t.total_revenue) + 1 AS b, COALESCE(AGG(t.total_revenue), 0) AS c FROM retail_model.orders AS t GROUP BY t.amount
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('orders'[amount], "__rows", COUNTROWS(orders), "a", ('orders'[total_revenue] * 2), "b", ('orders'[total_revenue] + 1), "c", IF(ISBLANK(COUNTROWS(orders)), BLANK(), COALESCE('orders'[total_revenue], 0))), "amount", 'orders'[amount], "a", [a], "b", [b], "c", [c])
