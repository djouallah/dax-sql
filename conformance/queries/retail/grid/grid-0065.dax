// note: the view expander's grid (tools/ossie/grid.mjs), derived table: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT s.amount, s.v FROM (SELECT t.amount, AGG(t.total_revenue) AS v FROM retail_model.orders AS t GROUP BY t.amount) AS s WHERE s.v IS NOT NULL
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('orders'[amount], "__rows", COUNTROWS('orders'), "v", 'orders'[total_revenue]), "amount", 'orders'[amount], "v", [v])
