// note: the view expander's grid (tools/ossie/grid.mjs), where and: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.order_id, AGG(t.total_revenue) AS v FROM retail_model.orders AS t WHERE t.amount <> 100 AND t.amount IN (100, 300) GROUP BY t.order_id
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('orders'[order_id], "__rows", COUNTROWS(orders), "v", 'orders'[total_revenue]), ('orders'[amount] <> 100), ('orders'[amount] IN {100, 300})), "order_id", 'orders'[order_id], "v", [v])
