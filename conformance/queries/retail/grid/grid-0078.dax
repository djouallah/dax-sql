// note: the view expander's grid (tools/ossie/grid.mjs), cte: its SQL as dax-sql's SQL front end writes it in DAX:
// WITH s AS (SELECT order_id, total_revenue AS mm FROM retail_model.orders WHERE amount IN (100, 300)) SELECT order_id, AGG(mm) AS v FROM s GROUP BY order_id
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('orders'[order_id], "__rows", COUNTROWS('orders'), "v", 'orders'[total_revenue]), ('orders'[amount] IN {100, 300})), "order_id", 'orders'[order_id], "v", [v])
