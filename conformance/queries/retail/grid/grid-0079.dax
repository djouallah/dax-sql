// note: the view expander's grid (tools/ossie/grid.mjs), derived table: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT s.order_id, s.v FROM (SELECT t.order_id, AGG(t.total_revenue) AS v FROM retail_model.orders AS t GROUP BY t.order_id) AS s WHERE s.v IS NOT NULL
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('orders'[order_id], "__rows", COUNTROWS(orders), "v", 'orders'[total_revenue]), "order_id", 'orders'[order_id], "v", [v])
