// note: the view expander's grid (tools/ossie/grid.mjs), two groups: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.customer_id, t.order_id, AGG(t.total_revenue) AS v FROM retail_model.orders AS t GROUP BY t.customer_id, t.order_id
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('orders'[customer_id], 'orders'[order_id], "__rows", COUNTROWS('orders'), "v", 'orders'[total_revenue]), "customer_id", 'orders'[customer_id], "order_id", 'orders'[order_id], "v", [v])
