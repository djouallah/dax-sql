// note: the view expander's grid (tools/ossie/grid.mjs), where or: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.customer_id, AGG(t.total_revenue) AS v FROM retail_model.orders AS t WHERE NOT (t.order_id = 'O4') OR t.customer_id = 'C3' GROUP BY t.customer_id
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('orders'[customer_id], "__rows", COUNTROWS(orders), "v", 'orders'[total_revenue]), (NOT(('orders'[order_id] = "O4")) || ('orders'[customer_id] = "C3"))), "customer_id", 'orders'[customer_id], "v", [v])
