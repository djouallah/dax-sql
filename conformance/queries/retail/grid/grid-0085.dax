// note: the view expander's grid (tools/ossie/grid.mjs), where total: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT AGG(t.total_revenue) AS v FROM retail_model.orders AS t WHERE t.order_id <> 'O4'
EVALUATE SELECTCOLUMNS(CALCULATETABLE(ROW("v", 'orders'[total_revenue]), ('orders'[order_id] <> "O4")), "v", [v])
