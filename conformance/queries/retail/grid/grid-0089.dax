// note: the view expander's grid (tools/ossie/grid.mjs), order by measure: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.customer_id, AGG(t.total_revenue) AS v FROM retail_model.orders AS t GROUP BY t.customer_id ORDER BY v DESC NULLS LAST, t.customer_id NULLS FIRST
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('orders'[customer_id], "__rows", COUNTROWS('orders'), "v", 'orders'[total_revenue]), "customer_id", 'orders'[customer_id], "v", [v]) ORDER BY [v] DESC, [customer_id]
