// note: the view expander's grid (tools/ossie/grid.mjs), rollup: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.amount, AGG(t.total_revenue) AS v FROM retail_model.orders AS t GROUP BY ROLLUP (t.amount) ORDER BY t.amount NULLS LAST
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS(ROLLUPADDISSUBTOTAL('orders'[amount], "__level1_amount"), "__rows", COUNTROWS('orders'), "v", 'orders'[total_revenue]), "amount", 'orders'[amount], "v", [v]) ORDER BY ISBLANK([amount]), [amount]
