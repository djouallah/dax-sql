// note: the view expander's grid (tools/ossie/grid.mjs), scalar ops: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.customer_id, AGG(t.total_revenue) * 2 AS a, AGG(t.total_revenue) + 1 AS b, COALESCE(AGG(t.total_revenue), 0) AS c FROM retail_model.orders AS t GROUP BY t.customer_id
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('orders'[customer_id], "__rows", COUNTROWS('orders'), "a", ('orders'[total_revenue] * 2), "b", ('orders'[total_revenue] + 1), "c", IF(ISBLANK(COUNTROWS('orders')), BLANK(), COALESCE('orders'[total_revenue], 0))), "customer_id", 'orders'[customer_id], "a", [a], "b", [b], "c", [c])
