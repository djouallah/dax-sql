// note: the view expander's grid (tools/ossie/grid.mjs), where: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.customer_id, AGG(t.total_revenue) AS v FROM retail_model.orders AS t WHERE t.customer_id IN ('C1', 'C1') GROUP BY t.customer_id
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('orders'[customer_id], "__rows", COUNTROWS('orders'), "v", 'orders'[total_revenue]), ('orders'[customer_id] IN {"C1", "C1"})), "customer_id", 'orders'[customer_id], "v", [v])
