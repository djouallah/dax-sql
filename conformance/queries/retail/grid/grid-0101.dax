// note: the view expander's grid (tools/ossie/grid.mjs), where and: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.order_id, AGG(t.total_revenue) AS v FROM retail_model.orders AS t WHERE t.amount BETWEEN 50 AND 50 AND t.order_id <> 'O2' GROUP BY t.order_id
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('orders'[order_id], "__rows", COUNTROWS(orders), "v", 'orders'[total_revenue]), (('orders'[amount] >= 50) && ('orders'[amount] <= 50)), ('orders'[order_id] <> "O2")), "order_id", 'orders'[order_id], "v", [v])
