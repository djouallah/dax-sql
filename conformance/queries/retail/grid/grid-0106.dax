// note: the view expander's grid (tools/ossie/grid.mjs), where and: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.customer_id, AGG(t.total_revenue) AS v FROM retail_model.orders AS t WHERE t.customer_id IN ('C1', 'C2') AND t.amount BETWEEN 50 AND 100 GROUP BY t.customer_id
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('orders'[customer_id], "__rows", COUNTROWS(orders), "v", 'orders'[total_revenue]), ('orders'[customer_id] IN {"C1", "C2"}), (('orders'[amount] >= 50) && ('orders'[amount] <= 100))), "customer_id", 'orders'[customer_id], "v", [v])
