// note: the view expander's grid (tools/ossie/grid.mjs), cte: its SQL as dax-sql's SQL front end writes it in DAX:
// WITH s AS (SELECT customer_id, total_revenue AS mm FROM retail_model.orders WHERE order_id IN ('O1', 'O1')) SELECT customer_id, AGG(mm) AS v FROM s GROUP BY customer_id
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('orders'[customer_id], "__rows", COUNTROWS('orders'), "v", 'orders'[total_revenue]), ('orders'[order_id] IN {"O1", "O1"})), "customer_id", 'orders'[customer_id], "v", [v])
