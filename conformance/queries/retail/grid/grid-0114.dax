// note: the view expander's grid (tools/ossie/grid.mjs), two groups: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.customer_id, t.return_id, AGG(t.return_count) AS v FROM retail_model.returns AS t GROUP BY t.customer_id, t.return_id
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('returns'[customer_id], 'returns'[return_id], "__rows", COUNTROWS('returns'), "v", 'returns'[return_count]), "customer_id", 'returns'[customer_id], "return_id", 'returns'[return_id], "v", COALESCE([v], 0))
