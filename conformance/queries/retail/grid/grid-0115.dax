// note: the view expander's grid (tools/ossie/grid.mjs), where: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.customer_id, AGG(t.return_count) AS v FROM retail_model.returns AS t WHERE t.amount BETWEEN 10 AND 25 GROUP BY t.customer_id
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('returns'[customer_id], "__rows", COUNTROWS('returns'), "v", 'returns'[return_count]), (('returns'[amount] >= 10) && ('returns'[amount] <= 25))), "customer_id", 'returns'[customer_id], "v", COALESCE([v], 0))
