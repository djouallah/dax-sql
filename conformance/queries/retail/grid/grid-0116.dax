// note: the view expander's grid (tools/ossie/grid.mjs), where and: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.customer_id, AGG(t.return_count) AS v FROM retail_model.returns AS t WHERE t.return_id IS NOT NULL AND NOT (t.return_id = 'R2') GROUP BY t.customer_id
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('returns'[customer_id], "__rows", COUNTROWS(returns), "v", 'returns'[return_count]), NOT(ISBLANK('returns'[return_id])), NOT(('returns'[return_id] = "R2"))), "customer_id", 'returns'[customer_id], "v", COALESCE([v], 0))
