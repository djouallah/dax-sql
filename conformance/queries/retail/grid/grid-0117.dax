// note: the view expander's grid (tools/ossie/grid.mjs), where or: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.customer_id, AGG(t.total_returns) AS v FROM retail_model.returns AS t WHERE t.customer_id = 'C4' OR t.amount IS NOT NULL GROUP BY t.customer_id
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('returns'[customer_id], "__rows", COUNTROWS(returns), "v", 'returns'[total_returns]), (('returns'[customer_id] = "C4") || NOT(ISBLANK('returns'[amount])))), "customer_id", 'returns'[customer_id], "v", [v])
