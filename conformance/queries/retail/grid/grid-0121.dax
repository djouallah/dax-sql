// note: the view expander's grid (tools/ossie/grid.mjs), order limit: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.customer_id, AGG(t.total_returns) AS v FROM retail_model.returns AS t GROUP BY t.customer_id ORDER BY t.customer_id NULLS FIRST LIMIT 3
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('returns'[customer_id], "__rows", COUNTROWS(returns), "v", 'returns'[total_returns]), "customer_id", 'returns'[customer_id], "v", [v]) ORDER BY [customer_id]
