// note: the view expander's grid (tools/ossie/grid.mjs), scalar ops: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.customer_id, AGG(t.total_returns) * 2 AS a, AGG(t.total_returns) + 1 AS b, COALESCE(AGG(t.total_returns), 0) AS c FROM retail_model.returns AS t GROUP BY t.customer_id
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('returns'[customer_id], "__rows", COUNTROWS('returns'), "a", ('returns'[total_returns] * 2), "b", ('returns'[total_returns] + 1), "c", IF(ISBLANK(COUNTROWS('returns')), BLANK(), COALESCE('returns'[total_returns], 0))), "customer_id", 'returns'[customer_id], "a", [a], "b", [b], "c", [c])
