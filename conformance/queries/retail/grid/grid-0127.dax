// note: the view expander's grid (tools/ossie/grid.mjs), cte: its SQL as dax-sql's SQL front end writes it in DAX:
// WITH s AS (SELECT customer_id, return_count AS mm FROM retail_model.returns WHERE amount IS NOT NULL) SELECT customer_id, AGG(mm) AS v FROM s GROUP BY customer_id
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('returns'[customer_id], "__rows", COUNTROWS('returns'), "v", 'returns'[return_count]), NOT(ISBLANK('returns'[amount]))), "customer_id", 'returns'[customer_id], "v", COALESCE([v], 0))
