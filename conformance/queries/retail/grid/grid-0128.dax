// note: the view expander's grid (tools/ossie/grid.mjs), derived table: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT s.customer_id, s.v FROM (SELECT t.customer_id, AGG(t.return_count) AS v FROM retail_model.returns AS t GROUP BY t.customer_id) AS s WHERE s.v IS NOT NULL
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('returns'[customer_id], "__rows", COUNTROWS(returns), "v", 'returns'[return_count]), "customer_id", 'returns'[customer_id], "v", COALESCE([v], 0))
