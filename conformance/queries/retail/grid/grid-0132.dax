// note: the view expander's grid (tools/ossie/grid.mjs), where: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.return_id, AGG(t.total_returns) AS v FROM retail_model.returns AS t WHERE t.return_id IS NOT NULL GROUP BY t.return_id
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('returns'[return_id], "__rows", COUNTROWS(returns), "v", 'returns'[total_returns]), NOT(ISBLANK('returns'[return_id]))), "return_id", 'returns'[return_id], "v", [v])
