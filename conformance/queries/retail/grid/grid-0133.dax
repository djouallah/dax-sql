// note: the view expander's grid (tools/ossie/grid.mjs), where and: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.return_id, AGG(t.return_count) AS v FROM retail_model.returns AS t WHERE t.customer_id IN ('C1', 'C4') AND t.customer_id IN ('C4', 'C4') GROUP BY t.return_id
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('returns'[return_id], "__rows", COUNTROWS('returns'), "v", 'returns'[return_count]), ('returns'[customer_id] IN {"C1", "C4"}), ('returns'[customer_id] IN {"C4", "C4"})), "return_id", 'returns'[return_id], "v", COALESCE([v], 0))
