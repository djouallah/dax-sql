// note: the view expander's grid (tools/ossie/grid.mjs), order by measure: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.return_id, AGG(t.return_count) AS v FROM retail_model.returns AS t GROUP BY t.return_id ORDER BY v DESC NULLS LAST, t.return_id NULLS FIRST
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('returns'[return_id], "__rows", COUNTROWS('returns'), "v", 'returns'[return_count]), "return_id", 'returns'[return_id], "v", COALESCE([v], 0)) ORDER BY [v] DESC, [return_id]
