// note: the view expander's grid (tools/ossie/grid.mjs), rollup: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.amount, AGG(t.total_returns) AS v FROM retail_model.returns AS t GROUP BY ROLLUP (t.amount) ORDER BY t.amount NULLS LAST
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS(ROLLUPADDISSUBTOTAL('returns'[amount], "__level1_amount"), "__rows", COUNTROWS('returns'), "v", 'returns'[total_returns]), "amount", 'returns'[amount], "v", [v]) ORDER BY ISBLANK([amount]), [amount]
