// note: the view expander's grid (tools/ossie/grid.mjs), group: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.amount, AGG(t.total_returns) AS v FROM retail_model.returns AS t GROUP BY t.amount
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('returns'[amount], "__rows", COUNTROWS('returns'), "v", 'returns'[total_returns]), "amount", 'returns'[amount], "v", [v])
