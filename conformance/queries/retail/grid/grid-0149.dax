// note: the view expander's grid (tools/ossie/grid.mjs), where: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.amount, AGG(t.return_count) AS v FROM retail_model.returns AS t WHERE NOT (t.return_id = 'R2') GROUP BY t.amount
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('returns'[amount], "__rows", COUNTROWS(returns), "v", 'returns'[return_count]), NOT(('returns'[return_id] = "R2"))), "amount", 'returns'[amount], "v", COALESCE([v], 0))
