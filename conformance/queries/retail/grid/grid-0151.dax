// note: the view expander's grid (tools/ossie/grid.mjs), where or: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.amount, AGG(t.return_count) AS v FROM retail_model.returns AS t WHERE t.amount <> 10 OR t.amount = 25 GROUP BY t.amount
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('returns'[amount], "__rows", COUNTROWS(returns), "v", 'returns'[return_count]), (('returns'[amount] <> 10) || ('returns'[amount] = 25))), "amount", 'returns'[amount], "v", COALESCE([v], 0))
