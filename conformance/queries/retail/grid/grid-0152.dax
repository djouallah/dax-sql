// note: the view expander's grid (tools/ossie/grid.mjs), where total: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT AGG(t.total_returns) AS v FROM retail_model.returns AS t WHERE t.customer_id IS NOT NULL
EVALUATE SELECTCOLUMNS(CALCULATETABLE(ROW("v", 'returns'[total_returns]), NOT(ISBLANK('returns'[customer_id]))), "v", [v])
