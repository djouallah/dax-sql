// note: the view expander's grid (tools/ossie/grid.mjs), having null: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.amount, AGG(t.total_returns) AS v FROM retail_model.returns AS t GROUP BY t.amount HAVING AGG(t.return_count) IS NOT NULL
EVALUATE SELECTCOLUMNS(FILTER(SUMMARIZECOLUMNS('returns'[amount], "__rows", COUNTROWS('returns'), "v", 'returns'[total_returns]), NOT(ISBLANK(COALESCE('returns'[return_count], 0)))), "amount", 'returns'[amount], "v", [v])
