// note: the view expander's grid (tools/ossie/grid.mjs), ratio: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.amount, CAST(AGG(t.return_count) AS DOUBLE) / NULLIF(AGG(t.return_count), 0) AS r FROM retail_model.returns AS t GROUP BY t.amount
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('returns'[amount], "__rows", COUNTROWS(returns), "r", IF(ISBLANK(COUNTROWS(returns)), BLANK(), (CONVERT(COALESCE('returns'[return_count], 0), DOUBLE) / IF((COALESCE('returns'[return_count], 0) == 0), BLANK(), COALESCE('returns'[return_count], 0))))), "amount", 'returns'[amount], "r", [r])
