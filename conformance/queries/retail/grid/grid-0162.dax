// note: the view expander's grid (tools/ossie/grid.mjs), derived table: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT s.amount, s.v FROM (SELECT t.amount, AGG(t.return_count) AS v FROM retail_model.returns AS t GROUP BY t.amount) AS s WHERE s.v IS NOT NULL
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('returns'[amount], "__rows", COUNTROWS(returns), "v", 'returns'[return_count]), "amount", 'returns'[amount], "v", COALESCE([v], 0))
