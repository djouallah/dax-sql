// note: the view expander's grid (tools/ossie/grid.mjs), two metrics: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.return_id, AGG(t.return_count) AS a, AGG(t.total_returns) AS b FROM retail_model.returns AS t GROUP BY t.return_id
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('returns'[return_id], "__rows", COUNTROWS('returns'), "a", 'returns'[return_count], "b", 'returns'[total_returns]), "return_id", 'returns'[return_id], "a", COALESCE([a], 0), "b", [b])
