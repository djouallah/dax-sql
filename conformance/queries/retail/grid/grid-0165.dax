// note: the view expander's grid (tools/ossie/grid.mjs), where: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.return_id, AGG(t.return_count) AS v FROM retail_model.returns AS t WHERE t.customer_id = 'C1' GROUP BY t.return_id
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('returns'[return_id], "__rows", COUNTROWS(returns), "v", 'returns'[return_count]), ('returns'[customer_id] = "C1")), "return_id", 'returns'[return_id], "v", COALESCE([v], 0))
