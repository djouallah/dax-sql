// note: the view expander's grid (tools/ossie/grid.mjs), having null: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.return_id, AGG(t.return_count) AS v FROM retail_model.returns AS t GROUP BY t.return_id HAVING AGG(t.return_count) IS NOT NULL
EVALUATE SELECTCOLUMNS(FILTER(SUMMARIZECOLUMNS('returns'[return_id], "__rows", COUNTROWS(returns), "v", 'returns'[return_count]), NOT(ISBLANK(COALESCE([v], 0)))), "return_id", 'returns'[return_id], "v", COALESCE([v], 0))
