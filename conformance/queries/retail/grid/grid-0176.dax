// note: the view expander's grid (tools/ossie/grid.mjs), cte: its SQL as dax-sql's SQL front end writes it in DAX:
// WITH s AS (SELECT return_id, return_count AS mm FROM retail_model.returns WHERE amount IS NOT NULL) SELECT return_id, AGG(mm) AS v FROM s GROUP BY return_id
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('returns'[return_id], "__rows", COUNTROWS('returns'), "v", 'returns'[return_count]), NOT(ISBLANK('returns'[amount]))), "return_id", 'returns'[return_id], "v", COALESCE([v], 0))
