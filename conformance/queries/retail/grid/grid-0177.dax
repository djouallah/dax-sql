// note: the view expander's grid (tools/ossie/grid.mjs), derived table: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT s.return_id, s.v FROM (SELECT t.return_id, AGG(t.total_returns) AS v FROM retail_model.returns AS t GROUP BY t.return_id) AS s WHERE s.v IS NOT NULL
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('returns'[return_id], "__rows", COUNTROWS('returns'), "v", 'returns'[total_returns]), "return_id", 'returns'[return_id], "v", [v])
