// note: the view expander's grid (tools/ossie/grid.mjs), two metrics: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.return_id, AGG(t.total_returns) AS a, AGG(t.return_count) AS b FROM retail_model.returns AS t GROUP BY t.return_id
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('returns'[return_id], "__rows", COUNTROWS(returns), "a", 'returns'[total_returns], "b", 'returns'[return_count]), "return_id", 'returns'[return_id], "a", [a], "b", COALESCE([b], 0))
