// note: the view expander's grid (tools/ossie/grid.mjs), where and: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.return_id, AGG(t.return_count) AS v FROM retail_model.returns AS t WHERE NOT (t.return_id = 'R1') AND t.return_id IS NOT NULL GROUP BY t.return_id
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('returns'[return_id], "__rows", COUNTROWS(returns), "v", 'returns'[return_count]), NOT(('returns'[return_id] = "R1")), NOT(ISBLANK('returns'[return_id]))), "return_id", 'returns'[return_id], "v", COALESCE([v], 0))
