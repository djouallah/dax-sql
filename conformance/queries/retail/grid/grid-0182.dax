// note: the view expander's grid (tools/ossie/grid.mjs), where or: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.return_id, AGG(t.return_count) AS v FROM retail_model.returns AS t WHERE t.amount BETWEEN 10 AND 10 OR NOT (t.amount = 10) GROUP BY t.return_id
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('returns'[return_id], "__rows", COUNTROWS(returns), "v", 'returns'[return_count]), ((('returns'[amount] >= 10) && ('returns'[amount] <= 10)) || NOT(('returns'[amount] = 10)))), "return_id", 'returns'[return_id], "v", COALESCE([v], 0))
