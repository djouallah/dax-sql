// note: the view expander's grid (tools/ossie/grid.mjs), where total: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT AGG(t.return_count) AS v FROM retail_model.returns AS t WHERE t.amount IN (10, 10)
EVALUATE SELECTCOLUMNS(CALCULATETABLE(ROW("v", 'returns'[return_count]), ('returns'[amount] IN {10, 10})), "v", COALESCE([v], 0))
