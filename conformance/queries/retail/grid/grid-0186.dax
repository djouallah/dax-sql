// note: the view expander's grid (tools/ossie/grid.mjs), cte: its SQL as dax-sql's SQL front end writes it in DAX:
// WITH s AS (SELECT return_id, total_returns AS mm FROM retail_model.returns WHERE amount < 10) SELECT return_id, AGG(mm) AS v FROM s GROUP BY return_id
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('returns'[return_id], "__rows", COUNTROWS(returns), "v", 'returns'[total_returns]), ('returns'[amount] < 10)), "return_id", 'returns'[return_id], "v", [v])
