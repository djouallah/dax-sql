// note: the view expander's grid (tools/ossie/grid.mjs), where and: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.customer_id, AGG(t.total_returns) AS v FROM retail_model.returns AS t WHERE NOT (t.amount = 10) AND t.amount < 10 GROUP BY t.customer_id
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('returns'[customer_id], "__rows", COUNTROWS('returns'), "v", 'returns'[total_returns]), NOT(('returns'[amount] = 10)), ('returns'[amount] < 10)), "customer_id", 'returns'[customer_id], "v", [v])
