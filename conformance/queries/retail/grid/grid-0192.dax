// note: the view expander's grid (tools/ossie/grid.mjs), where total: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT AGG(t.return_count) AS v FROM retail_model.returns AS t WHERE t.return_id = 'R1'
EVALUATE SELECTCOLUMNS(CALCULATETABLE(ROW("v", 'returns'[return_count]), ('returns'[return_id] = "R1")), "v", COALESCE([v], 0))
