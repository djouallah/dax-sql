// note: the view expander's grid (tools/ossie/grid.mjs), having: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.customer_id, AGG(t.total_returns) AS v FROM retail_model.returns AS t GROUP BY t.customer_id HAVING AGG(t.return_count) > 0
EVALUATE SELECTCOLUMNS(FILTER(SUMMARIZECOLUMNS('returns'[customer_id], "__rows", COUNTROWS(returns), "v", 'returns'[total_returns]), (COALESCE('returns'[return_count], 0) > 0)), "customer_id", 'returns'[customer_id], "v", [v])
