// note: the view expander's grid (tools/ossie/grid.mjs), rollup: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.customer_id, AGG(t.total_returns) AS v FROM retail_model.returns AS t GROUP BY ROLLUP (t.customer_id) ORDER BY t.customer_id NULLS LAST
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS(ROLLUPADDISSUBTOTAL('returns'[customer_id], "__level1_customer_id"), "__rows", COUNTROWS('returns'), "v", 'returns'[total_returns]), "customer_id", 'returns'[customer_id], "v", [v]) ORDER BY ISBLANK([customer_id]), [customer_id]
