// note: the view expander's grid (tools/ossie/grid.mjs), having null: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.customer_id, AGG(t.visit_count) AS v FROM retail_model.visits AS t GROUP BY t.customer_id HAVING AGG(t.visit_count) IS NOT NULL
EVALUATE SELECTCOLUMNS(FILTER(SUMMARIZECOLUMNS('visits'[customer_id], "__rows", COUNTROWS(visits), "v", 'visits'[visit_count]), NOT(ISBLANK(COALESCE([v], 0)))), "customer_id", 'visits'[customer_id], "v", COALESCE([v], 0))
