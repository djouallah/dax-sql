// note: the view expander's grid (tools/ossie/grid.mjs), order by measure: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.customer_id, AGG(t.visit_count) AS v FROM retail_model.visits AS t GROUP BY t.customer_id ORDER BY v DESC NULLS LAST, t.customer_id NULLS FIRST
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('visits'[customer_id], "__rows", COUNTROWS(visits), "v", 'visits'[visit_count]), "customer_id", 'visits'[customer_id], "v", COALESCE([v], 0)) ORDER BY [v] DESC, [customer_id]
