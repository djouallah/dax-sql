// note: the view expander's grid (tools/ossie/grid.mjs), rollup: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.customer_id, AGG(t.visit_count) AS v FROM retail_model.visits AS t GROUP BY ROLLUP (t.customer_id) ORDER BY t.customer_id NULLS LAST
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS(ROLLUPADDISSUBTOTAL('visits'[customer_id], "__level1_customer_id"), "__rows", COUNTROWS('visits'), "v", 'visits'[visit_count]), "customer_id", 'visits'[customer_id], "v", COALESCE([v], 0)) ORDER BY ISBLANK([customer_id]), [customer_id]
