// note: the view expander's grid (tools/ossie/grid.mjs), scalar ops: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.customer_id, AGG(t.visit_count) * 2 AS a, AGG(t.visit_count) + 1 AS b, COALESCE(AGG(t.visit_count), 0) AS c FROM retail_model.visits AS t GROUP BY t.customer_id
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('visits'[customer_id], "__rows", COUNTROWS('visits'), "a", IF(ISBLANK(COUNTROWS('visits')), BLANK(), (COALESCE('visits'[visit_count], 0) * 2)), "b", IF(ISBLANK(COUNTROWS('visits')), BLANK(), (COALESCE('visits'[visit_count], 0) + 1)), "c", IF(ISBLANK(COUNTROWS('visits')), BLANK(), COALESCE(COALESCE('visits'[visit_count], 0), 0))), "customer_id", 'visits'[customer_id], "a", [a], "b", [b], "c", [c])
