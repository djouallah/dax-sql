// note: the view expander's grid (tools/ossie/grid.mjs), where or: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.customer_id, AGG(t.visit_count) AS v FROM retail_model.visits AS t WHERE t.visit_id = 'V3' OR t.visit_id = 'V1' GROUP BY t.customer_id
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('visits'[customer_id], "__rows", COUNTROWS(visits), "v", 'visits'[visit_count]), (('visits'[visit_id] = "V3") || ('visits'[visit_id] = "V1"))), "customer_id", 'visits'[customer_id], "v", COALESCE([v], 0))
