// note: the view expander's grid (tools/ossie/grid.mjs), cte: its SQL as dax-sql's SQL front end writes it in DAX:
// WITH s AS (SELECT customer_id, visit_count AS mm FROM retail_model.visits WHERE NOT (customer_id = 'C4')) SELECT customer_id, AGG(mm) AS v FROM s GROUP BY customer_id
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('visits'[customer_id], "__rows", COUNTROWS(visits), "v", 'visits'[visit_count]), NOT(('visits'[customer_id] = "C4"))), "customer_id", 'visits'[customer_id], "v", COALESCE([v], 0))
