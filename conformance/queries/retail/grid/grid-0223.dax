// note: the view expander's grid (tools/ossie/grid.mjs), where or: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.visit_id, AGG(t.visit_count) AS v FROM retail_model.visits AS t WHERE t.customer_id = 'C4' OR t.visit_id IS NOT NULL GROUP BY t.visit_id
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('visits'[visit_id], "__rows", COUNTROWS('visits'), "v", 'visits'[visit_count]), (('visits'[customer_id] = "C4") || NOT(ISBLANK('visits'[visit_id])))), "visit_id", 'visits'[visit_id], "v", COALESCE([v], 0))
