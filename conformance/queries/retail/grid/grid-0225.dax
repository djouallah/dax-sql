// note: the view expander's grid (tools/ossie/grid.mjs), having: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.visit_id, AGG(t.visit_count) AS v FROM retail_model.visits AS t GROUP BY t.visit_id HAVING AGG(t.visit_count) > 0
EVALUATE SELECTCOLUMNS(FILTER(SUMMARIZECOLUMNS('visits'[visit_id], "__rows", COUNTROWS(visits), "v", 'visits'[visit_count]), (COALESCE([v], 0) > 0)), "visit_id", 'visits'[visit_id], "v", COALESCE([v], 0))
