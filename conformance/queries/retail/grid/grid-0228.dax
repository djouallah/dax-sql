// note: the view expander's grid (tools/ossie/grid.mjs), order by measure: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.visit_id, AGG(t.visit_count) AS v FROM retail_model.visits AS t GROUP BY t.visit_id ORDER BY v DESC NULLS LAST, t.visit_id NULLS FIRST
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('visits'[visit_id], "__rows", COUNTROWS(visits), "v", 'visits'[visit_count]), "visit_id", 'visits'[visit_id], "v", COALESCE([v], 0)) ORDER BY [v] DESC, [visit_id]
