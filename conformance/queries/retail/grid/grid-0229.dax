// note: the view expander's grid (tools/ossie/grid.mjs), group by all: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.visit_id, AGG(t.visit_count) AS v FROM retail_model.visits AS t GROUP BY ALL
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('visits'[visit_id], "__rows", COUNTROWS('visits'), "v", 'visits'[visit_count]), "visit_id", 'visits'[visit_id], "v", COALESCE([v], 0))
