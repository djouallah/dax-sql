// note: the view expander's grid (tools/ossie/grid.mjs), rollup: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.visit_id, AGG(t.visit_count) AS v FROM retail_model.visits AS t GROUP BY ROLLUP (t.visit_id) ORDER BY t.visit_id NULLS LAST
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS(ROLLUPADDISSUBTOTAL('visits'[visit_id], "__level1_visit_id"), "__rows", COUNTROWS(visits), "v", 'visits'[visit_count]), "visit_id", 'visits'[visit_id], "v", COALESCE([v], 0)) ORDER BY ISBLANK([visit_id]), [visit_id]
