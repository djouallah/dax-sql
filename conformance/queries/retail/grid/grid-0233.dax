// note: the view expander's grid (tools/ossie/grid.mjs), derived table: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT s.visit_id, s.v FROM (SELECT t.visit_id, AGG(t.visit_count) AS v FROM retail_model.visits AS t GROUP BY t.visit_id) AS s WHERE s.v IS NOT NULL
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('visits'[visit_id], "__rows", COUNTROWS(visits), "v", 'visits'[visit_count]), "visit_id", 'visits'[visit_id], "v", COALESCE([v], 0))
