// note: the view expander's grid (tools/ossie/grid.mjs), where and: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.customer_id, AGG(t.visit_count) AS v FROM retail_model.visits AS t WHERE t.customer_id IS NOT NULL AND t.customer_id IN ('C3', 'C4') GROUP BY t.customer_id
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('visits'[customer_id], "__rows", COUNTROWS('visits'), "v", 'visits'[visit_count]), NOT(ISBLANK('visits'[customer_id])), ('visits'[customer_id] IN {"C3", "C4"})), "customer_id", 'visits'[customer_id], "v", COALESCE([v], 0))
