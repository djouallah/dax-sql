// note: the view expander's grid (tools/ossie/grid.mjs), where total: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT AGG(t.visit_count) AS v FROM retail_model.visits AS t WHERE NOT (t.visit_id = 'V2')
EVALUATE SELECTCOLUMNS(CALCULATETABLE(ROW("v", 'visits'[visit_count]), NOT(('visits'[visit_id] = "V2"))), "v", COALESCE([v], 0))
