// note: the view expander's grid (tools/ossie/grid.mjs), where and: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.visit_id, AGG(t.visit_count) AS v FROM retail_model.visits AS t WHERE t.visit_id = 'V3' AND t.customer_id = 'C3' GROUP BY t.visit_id
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('visits'[visit_id], "__rows", COUNTROWS(visits), "v", 'visits'[visit_count]), ('visits'[visit_id] = "V3"), ('visits'[customer_id] = "C3")), "visit_id", 'visits'[visit_id], "v", COALESCE([v], 0))
