// note: the view expander's grid (tools/ossie/grid.mjs), where or: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.visit_id, AGG(t.visit_count) AS v FROM retail_model.visits AS t WHERE t.customer_id = 'C3' OR t.visit_id IN ('V1', 'V2') GROUP BY t.visit_id
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('visits'[visit_id], "__rows", COUNTROWS(visits), "v", 'visits'[visit_count]), (('visits'[customer_id] = "C3") || ('visits'[visit_id] IN {"V1", "V2"}))), "visit_id", 'visits'[visit_id], "v", COALESCE([v], 0))
