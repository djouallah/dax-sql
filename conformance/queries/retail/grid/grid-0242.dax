// note: the view expander's grid (tools/ossie/grid.mjs), where total: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT AGG(t.visit_count) AS v FROM retail_model.visits AS t WHERE t.visit_id IN ('V2', 'V3')
EVALUATE SELECTCOLUMNS(CALCULATETABLE(ROW("v", 'visits'[visit_count]), ('visits'[visit_id] IN {"V2", "V3"})), "v", COALESCE([v], 0))
