// note: the view expander's grid (tools/ossie/grid.mjs), where and: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.visit_id, AGG(t.visit_count) AS v FROM retail_model.visits AS t WHERE NOT (t.customer_id = 'C4') AND t.visit_id = 'V1' GROUP BY t.visit_id
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('visits'[visit_id], "__rows", COUNTROWS(visits), "v", 'visits'[visit_count]), NOT(('visits'[customer_id] = "C4")), ('visits'[visit_id] = "V1")), "visit_id", 'visits'[visit_id], "v", COALESCE([v], 0))
