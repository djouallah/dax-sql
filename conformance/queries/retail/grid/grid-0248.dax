// note: the view expander's grid (tools/ossie/grid.mjs), cte: its SQL as dax-sql's SQL front end writes it in DAX:
// WITH s AS (SELECT visit_id, visit_count AS mm FROM retail_model.visits WHERE customer_id IS NOT NULL) SELECT visit_id, AGG(mm) AS v FROM s GROUP BY visit_id
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('visits'[visit_id], "__rows", COUNTROWS(visits), "v", 'visits'[visit_count]), NOT(ISBLANK('visits'[customer_id]))), "visit_id", 'visits'[visit_id], "v", COALESCE([v], 0))
