// note: the view expander's grid (tools/ossie/grid.mjs), star where one: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.customer_id, AGG(f.total_revenue) AS v FROM retail_model.orders AS f JOIN retail_model.customers AS o ON f.customer_id = o.customer_id WHERE o.region IN ('NORTH', 'NORTH') GROUP BY o.customer_id
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('customers'[customer_id], "__rows", COUNTROWS(orders), "v", 'orders'[total_revenue]), ('customers'[region] IN {"NORTH", "NORTH"}), NOT(ISBLANK('customers'[customer_id]))), "customer_id", 'customers'[customer_id], "v", [v])
