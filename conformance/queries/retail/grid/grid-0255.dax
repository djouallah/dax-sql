// note: the view expander's grid (tools/ossie/grid.mjs), one side counted once: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.customer_id, AGG(f.total_revenue) AS a, AGG(o.customer_count) AS b FROM retail_model.orders AS f JOIN retail_model.customers AS o ON f.customer_id = o.customer_id GROUP BY o.customer_id
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('customers'[customer_id], "__rows", COUNTROWS(orders), "a", 'orders'[total_revenue], "b", CALCULATE('customers'[customer_count], orders)), NOT(ISBLANK('customers'[customer_id]))), "customer_id", 'customers'[customer_id], "a", [a], "b", COALESCE([b], 0))
