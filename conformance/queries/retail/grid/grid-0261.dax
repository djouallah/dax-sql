// note: the view expander's grid (tools/ossie/grid.mjs), star two sides: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.customer_id, f.amount, AGG(f.total_revenue) AS v FROM retail_model.orders AS f LEFT JOIN retail_model.customers AS o ON f.customer_id = o.customer_id GROUP BY o.customer_id, f.amount
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('customers'[customer_id], 'orders'[amount], "__rows", COUNTROWS('orders'), "v", 'orders'[total_revenue]), "customer_id", 'customers'[customer_id], "amount", 'orders'[amount], "v", [v])
