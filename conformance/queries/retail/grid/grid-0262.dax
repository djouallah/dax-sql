// note: the view expander's grid (tools/ossie/grid.mjs), star total: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT AGG(f.total_revenue) AS v FROM retail_model.orders AS f LEFT JOIN retail_model.customers AS o ON f.customer_id = o.customer_id
EVALUATE SELECTCOLUMNS(ROW("v", 'orders'[total_revenue]), "v", [v])
