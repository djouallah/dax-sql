// note: the view expander's grid (tools/ossie/grid.mjs), fan-out: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT f.order_id, AGG(o.customer_count) AS v FROM retail_model.orders AS f LEFT JOIN retail_model.customers AS o ON f.customer_id = o.customer_id GROUP BY f.order_id
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('orders'[order_id], "__rows", COUNTROWS('orders'), "v", CALCULATE('customers'[customer_count], 'orders')), "order_id", 'orders'[order_id], "v", COALESCE([v], 0))
