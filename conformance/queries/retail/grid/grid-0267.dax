// note: the view expander's grid (tools/ossie/grid.mjs), star where many: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.region, AGG(f.total_revenue) AS v FROM retail_model.orders AS f JOIN retail_model.customers AS o ON f.customer_id = o.customer_id WHERE NOT (f.customer_id = 'C2') GROUP BY o.region
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('customers'[region], "__rows", COUNTROWS('orders'), "v", 'orders'[total_revenue]), NOT(('orders'[customer_id] = "C2")), NOT(ISBLANK('customers'[customer_id]))), "region", 'customers'[region], "v", [v])
