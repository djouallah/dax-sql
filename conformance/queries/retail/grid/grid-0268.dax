// note: the view expander's grid (tools/ossie/grid.mjs), star two sides: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.region, f.customer_id, AGG(f.total_revenue) AS v FROM retail_model.orders AS f JOIN retail_model.customers AS o ON f.customer_id = o.customer_id GROUP BY o.region, f.customer_id
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('customers'[region], 'orders'[customer_id], "__rows", COUNTROWS(orders), "v", 'orders'[total_revenue]), NOT(ISBLANK('customers'[customer_id]))), "region", 'customers'[region], "customer_id", 'orders'[customer_id], "v", [v])
