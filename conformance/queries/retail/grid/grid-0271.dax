// note: the view expander's grid (tools/ossie/grid.mjs), fan-out: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT f.customer_id, AGG(o.customer_count) AS v FROM retail_model.orders AS f JOIN retail_model.customers AS o ON f.customer_id = o.customer_id GROUP BY f.customer_id
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('orders'[customer_id], "__rows", COUNTROWS(orders), "v", CALCULATE('customers'[customer_count], orders)), NOT(ISBLANK('customers'[customer_id]))), "customer_id", 'orders'[customer_id], "v", COALESCE([v], 0))
