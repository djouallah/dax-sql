// note: the view expander's grid (tools/ossie/grid.mjs), one side counted once: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.region, AGG(f.return_count) AS a, AGG(o.customer_count) AS b FROM retail_model.returns AS f JOIN retail_model.customers AS o ON f.customer_id = o.customer_id GROUP BY o.region
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('customers'[region], "__rows", COUNTROWS(returns), "a", 'returns'[return_count], "b", CALCULATE('customers'[customer_count], returns)), NOT(ISBLANK('customers'[customer_id]))), "region", 'customers'[region], "a", COALESCE([a], 0), "b", COALESCE([b], 0))
