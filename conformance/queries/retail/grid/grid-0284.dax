// note: the view expander's grid (tools/ossie/grid.mjs), fan-out: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT f.amount, AGG(o.customer_count) AS v FROM retail_model.returns AS f JOIN retail_model.customers AS o ON f.customer_id = o.customer_id GROUP BY f.amount
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('returns'[amount], "__rows", COUNTROWS(returns), "v", CALCULATE('customers'[customer_count], returns)), NOT(ISBLANK('customers'[customer_id]))), "amount", 'returns'[amount], "v", COALESCE([v], 0))
