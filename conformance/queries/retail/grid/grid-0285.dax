// note: the view expander's grid (tools/ossie/grid.mjs), star where one: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.customer_id, AGG(f.return_count) AS v FROM retail_model.returns AS f JOIN retail_model.customers AS o ON f.customer_id = o.customer_id WHERE o.region IS NOT NULL GROUP BY o.customer_id
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('customers'[customer_id], "__rows", COUNTROWS('returns'), "v", 'returns'[return_count]), NOT(ISBLANK('customers'[region])), NOT(ISBLANK('customers'[customer_id]))), "customer_id", 'customers'[customer_id], "v", COALESCE([v], 0))
