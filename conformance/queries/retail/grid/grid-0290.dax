// note: the view expander's grid (tools/ossie/grid.mjs), star: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.region, AGG(f.visit_count) AS v FROM retail_model.visits AS f JOIN retail_model.customers AS o ON f.customer_id = o.customer_id GROUP BY o.region
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('customers'[region], "__rows", COUNTROWS('visits'), "v", 'visits'[visit_count]), NOT(ISBLANK('customers'[customer_id]))), "region", 'customers'[region], "v", COALESCE([v], 0))
