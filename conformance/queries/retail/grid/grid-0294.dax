// note: the view expander's grid (tools/ossie/grid.mjs), star total: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT AGG(f.visit_count) AS v FROM retail_model.visits AS f JOIN retail_model.customers AS o ON f.customer_id = o.customer_id
EVALUATE SELECTCOLUMNS(CALCULATETABLE(ROW("v", 'visits'[visit_count]), NOT(ISBLANK('customers'[customer_id]))), "v", COALESCE([v], 0))
