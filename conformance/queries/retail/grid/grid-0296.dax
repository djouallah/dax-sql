// note: the view expander's grid (tools/ossie/grid.mjs), one to many: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.region, AGG(o.customer_count) AS a, AGG(f.visit_count) AS b FROM retail_model.customers AS o LEFT JOIN retail_model.visits AS f ON f.customer_id = o.customer_id GROUP BY o.region
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('customers'[region], "__rows", COUNTROWS('customers'), "a", 'customers'[customer_count], "b", CALCULATE('visits'[visit_count], KEEPFILTERS(NOT(ISBLANK('customers'[customer_id]))))), "region", 'customers'[region], "a", COALESCE([a], 0), "b", COALESCE([b], 0))
