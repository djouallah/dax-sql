// note: the view expander's grid (tools/ossie/grid.mjs), fan-out: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT f.visit_id, AGG(o.customer_count) AS v FROM retail_model.visits AS f JOIN retail_model.customers AS o ON f.customer_id = o.customer_id GROUP BY f.visit_id
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('visits'[visit_id], "__rows", COUNTROWS('visits'), "v", CALCULATE('customers'[customer_count], 'visits')), NOT(ISBLANK('customers'[customer_id]))), "visit_id", 'visits'[visit_id], "v", COALESCE([v], 0))
