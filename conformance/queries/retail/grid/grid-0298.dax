// SELECT o.region, AGG(f.visit_count) AS v FROM retail_model.visits AS f LEFT JOIN retail_model.customers AS o ON f.customer_id = o.customer_id GROUP BY o.region
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('customers'[region], "__rows", COUNTROWS(visits), "v", 'visits'[visit_count]), "region", 'customers'[region], "v", COALESCE([v], 0))
