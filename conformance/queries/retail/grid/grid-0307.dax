// note: the view expander's grid (tools/ossie/grid.mjs), chasm: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.region, AGG(a.total_revenue) AS x, AGG(b.return_count) AS y FROM retail_model.customers AS o LEFT JOIN retail_model.orders AS a ON a.customer_id = o.customer_id LEFT JOIN retail_model.returns AS b ON b.customer_id = o.customer_id GROUP BY o.region
DEFINE
VAR __v1 = GENERATEALL(GENERATEALL(SELECTCOLUMNS(customers, "o.customer_id", 'customers'[customer_id], "o.region", 'customers'[region]), FILTER(SELECTCOLUMNS(orders, "a.order_id", 'orders'[order_id], "a.customer_id", 'orders'[customer_id]), ([a.customer_id] = [o.customer_id]))), FILTER(SELECTCOLUMNS(returns, "b.return_id", 'returns'[return_id], "b.customer_id", 'returns'[customer_id]), ([b.customer_id] = [o.customer_id])))
VAR __v2 = DISTINCT(SELECTCOLUMNS(__v1, "region", [o.region]))
EVALUATE SELECTCOLUMNS(ADDCOLUMNS(__v2, "__m1", CALCULATE('orders'[total_revenue], REMOVEFILTERS(), TREATAS(SELECTCOLUMNS(FILTER(__v1, (NOT(ISBLANK([a.order_id])) && ([o.region] == [region]))), "__k1", [a.order_id]), 'orders'[order_id])), "__m2", COALESCE(CALCULATE('returns'[return_count], REMOVEFILTERS(), TREATAS(SELECTCOLUMNS(FILTER(__v1, (NOT(ISBLANK([b.return_id])) && ([o.region] == [region]))), "__k1", [b.return_id]), 'returns'[return_id])), 0)), "region", [region], "x", [__m1], "y", [__m2])
