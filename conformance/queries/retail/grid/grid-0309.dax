// note: the view expander's grid (tools/ossie/grid.mjs), chasm: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.customer_id, AGG(a.return_count) AS x, AGG(b.visit_count) AS y FROM retail_model.customers AS o LEFT JOIN retail_model.returns AS a ON a.customer_id = o.customer_id LEFT JOIN retail_model.visits AS b ON b.customer_id = o.customer_id GROUP BY o.customer_id
DEFINE
VAR __v1 = GENERATEALL(GENERATEALL(SELECTCOLUMNS('customers', "o.customer_id", 'customers'[customer_id]), FILTER(SELECTCOLUMNS('returns', "a.return_id", 'returns'[return_id], "a.customer_id", 'returns'[customer_id]), ([a.customer_id] = [o.customer_id]))), FILTER(SELECTCOLUMNS('visits', "b.visit_id", 'visits'[visit_id], "b.customer_id", 'visits'[customer_id]), ([b.customer_id] = [o.customer_id])))
VAR __v2 = DISTINCT(SELECTCOLUMNS(__v1, "customer_id", [o.customer_id]))
EVALUATE SELECTCOLUMNS(ADDCOLUMNS(__v2, "__m1", COALESCE(CALCULATE('returns'[return_count], REMOVEFILTERS(), TREATAS(SELECTCOLUMNS(FILTER(__v1, (NOT(ISBLANK([a.return_id])) && ([o.customer_id] == [customer_id]))), "__k1", [a.return_id]), 'returns'[return_id])), 0), "__m2", COALESCE(CALCULATE('visits'[visit_count], REMOVEFILTERS(), TREATAS(SELECTCOLUMNS(FILTER(__v1, (NOT(ISBLANK([b.visit_id])) && ([o.customer_id] == [customer_id]))), "__k1", [b.visit_id]), 'visits'[visit_id])), 0)), "customer_id", [customer_id], "x", [__m1], "y", [__m2])
