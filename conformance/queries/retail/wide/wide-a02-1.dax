// note: Apache Ossie wide table compliance A02 (a02_count_empty_input.ost):  Its Layer 3 query {"dimensions":["customers.region"],"metrics":["orders.total_revenue","returns.return_count"]}, lowered to Layer 2 SQL, model query 1 of 2, as dax-sql's SQL front end writes it in DAX:
// WITH b_orders AS ( SELECT customers.region AS region, AGG(orders.total_revenue) AS c1, 1 AS present FROM retail_model.orders LEFT JOIN retail_model.customers ON orders.customer_id = customers.customer_id GROUP BY customers.region ), b_returns AS ( SELECT customers.region AS region, AGG(returns.return_count) AS c1, 1 AS present FROM retail_model.returns LEFT JOIN retail_model.customers ON returns.customer_id = customers.customer_id GROUP BY customers.region ), keys AS ( SELECT region FROM b_orders UNION SELECT region FROM b_returns ) SELECT keys.region, b_orders.c1 AS total_revenue, CASE WHEN b_returns.present IS NULL THEN 0 ELSE b_returns.c1 END AS return_count FROM keys LEFT JOIN b_orders ON b_orders.region IS NOT DISTINCT FROM keys.region LEFT JOIN b_returns ON b_returns.region IS NOT DISTINCT FROM keys.region
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('customers'[region], "__rows", COUNTROWS('orders'), "c1", 'orders'[total_revenue]), "region", 'customers'[region], "c1", [c1], "present", 1)
