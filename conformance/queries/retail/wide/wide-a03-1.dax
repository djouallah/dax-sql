// note: Apache Ossie wide table compliance A03 (a03_three_branches.ost):  Its Layer 3 query {"dimensions":["customers.region"],"metrics":["orders.total_revenue","returns.total_returns","visits.visit_count"]}, lowered to Layer 2 SQL, model query 1 of 3, as dax-sql's SQL front end writes it in DAX:
// WITH b_orders AS ( SELECT customers.region AS region, AGG(orders.total_revenue) AS c1, 1 AS present FROM retail_model.orders LEFT JOIN retail_model.customers ON orders.customer_id = customers.customer_id GROUP BY customers.region ), b_returns AS ( SELECT customers.region AS region, AGG(returns.total_returns) AS c1, 1 AS present FROM retail_model.returns LEFT JOIN retail_model.customers ON returns.customer_id = customers.customer_id GROUP BY customers.region ), b_visits AS ( SELECT customers.region AS region, AGG(visits.visit_count) AS c1, 1 AS present FROM retail_model.visits LEFT JOIN retail_model.customers ON visits.customer_id = customers.customer_id GROUP BY customers.region ), keys AS ( SELECT region FROM b_orders UNION SELECT region FROM b_returns UNION SELECT region FROM b_visits ) SELECT keys.region, b_orders.c1 AS total_revenue, b_returns.c1 AS total_returns, CASE WHEN b_visits.present IS NULL THEN 0 ELSE b_visits.c1 END AS visit_count FROM keys LEFT JOIN b_orders ON b_orders.region IS NOT DISTINCT FROM keys.region LEFT JOIN b_returns ON b_returns.region IS NOT DISTINCT FROM keys.region LEFT JOIN b_visits ON b_visits.region IS NOT DISTINCT FROM keys.region
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('customers'[region], "__rows", COUNTROWS(orders), "c1", 'orders'[total_revenue]), "region", 'customers'[region], "c1", [c1], "present", 1)
