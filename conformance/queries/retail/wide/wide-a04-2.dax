// note: Apache Ossie wide table compliance A04 (a04_filter_on_dimension.ost):  Its Layer 3 query {"dimensions":["customers.region"],"metrics":["orders.total_revenue","returns.total_returns"],"filter":"customers.region <> 'EAST'"}, lowered to Layer 2 SQL, model query 2 of 2, as dax-sql's SQL front end writes it in DAX:
// WITH b_orders AS ( SELECT customers.region AS region, AGG(orders.total_revenue) AS c1, 1 AS present FROM retail_model.orders LEFT JOIN retail_model.customers ON orders.customer_id = customers.customer_id WHERE customers.region <> 'EAST' GROUP BY customers.region ), b_returns AS ( SELECT customers.region AS region, AGG(returns.total_returns) AS c1, 1 AS present FROM retail_model.returns LEFT JOIN retail_model.customers ON returns.customer_id = customers.customer_id WHERE customers.region <> 'EAST' GROUP BY customers.region ), keys AS ( SELECT region FROM b_orders UNION SELECT region FROM b_returns ) SELECT keys.region, b_orders.c1 AS total_revenue, b_returns.c1 AS total_returns FROM keys LEFT JOIN b_orders ON b_orders.region IS NOT DISTINCT FROM keys.region LEFT JOIN b_returns ON b_returns.region IS NOT DISTINCT FROM keys.region
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('customers'[region], "__rows", COUNTROWS(returns), "c1", 'returns'[total_returns]), ('customers'[region] <> "EAST")), "region", 'customers'[region], "c1", [c1], "present", 1)
