// note: Apache Ossie wide table compliance A09 (a09_aliases.ost):  Its Layer 3 query {"dimensions":[{"field":"customers.region","alias":"area"}],"metrics":[{"metric":"orders.total_revenue","alias":"revenue"}]}, lowered to Layer 2 SQL, as dax-sql's SQL front end writes it in DAX:
// SELECT customers.region AS area, AGG(orders.total_revenue) AS revenue FROM retail_model.orders LEFT JOIN retail_model.customers ON orders.customer_id = customers.customer_id GROUP BY customers.region
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('customers'[region], "__rows", COUNTROWS(orders), "revenue", 'orders'[total_revenue]), "area", 'customers'[region], "revenue", [revenue])
