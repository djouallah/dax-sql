// note: Apache Ossie wide table compliance A10 (a10_filter_without_dimension.ost):  Its Layer 3 query {"metrics":["orders.total_revenue"],"filter":"customers.region = 'EAST'"}, lowered to Layer 2 SQL, as dax-sql's SQL front end writes it in DAX:
// SELECT AGG(orders.total_revenue) AS total_revenue FROM retail_model.orders LEFT JOIN retail_model.customers ON orders.customer_id = customers.customer_id WHERE customers.region = 'EAST'
EVALUATE SELECTCOLUMNS(CALCULATETABLE(ROW("total_revenue", 'orders'[total_revenue]), ('customers'[region] = "EAST")), "total_revenue", [total_revenue])
