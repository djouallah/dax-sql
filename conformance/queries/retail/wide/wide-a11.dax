// note: Apache Ossie wide table compliance A11 (a11_filter_on_home_dataset.ost):  Its Layer 3 query {"dimensions":["customers.region"],"metrics":["orders.total_revenue"],"filter":"orders.amount > 100"}, lowered to Layer 2 SQL, as dax-sql's SQL front end writes it in DAX:
// SELECT customers.region AS region, AGG(orders.total_revenue) AS total_revenue FROM retail_model.orders LEFT JOIN retail_model.customers ON orders.customer_id = customers.customer_id WHERE orders.amount > 100 GROUP BY customers.region
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('customers'[region], "__rows", COUNTROWS('orders'), "total_revenue", 'orders'[total_revenue]), ('orders'[amount] > 100)), "region", 'customers'[region], "total_revenue", [total_revenue])
