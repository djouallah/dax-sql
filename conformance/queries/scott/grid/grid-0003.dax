// note: the view expander's grid (tools/ossie/grid.mjs), two metrics: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.comm, AGG(t.sum_comm) AS a, AGG(t.avg_comm) AS b FROM scott_model.emp AS t GROUP BY t.comm
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('emp'[comm], "__rows", COUNTROWS(emp), "a", 'emp'[sum_comm], "b", 'emp'[avg_comm]), "comm", 'emp'[comm], "a", [a], "b", [b])
