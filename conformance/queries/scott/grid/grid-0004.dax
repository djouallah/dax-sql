// note: the view expander's grid (tools/ossie/grid.mjs), two groups: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.comm, t.empno, AGG(t.emp_count) AS v FROM scott_model.emp AS t GROUP BY t.comm, t.empno
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('emp'[comm], 'emp'[empno], "__rows", COUNTROWS(emp), "v", 'emp'[emp_count]), "comm", 'emp'[comm], "empno", 'emp'[empno], "v", COALESCE([v], 0))
