// note: the view expander's grid (tools/ossie/grid.mjs), where: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.comm, AGG(t.avg_sal) AS v FROM scott_model.emp AS t WHERE t.empno < 7844 GROUP BY t.comm
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('emp'[comm], "__rows", COUNTROWS(emp), "v", 'emp'[avg_sal]), ('emp'[empno] < 7844)), "comm", 'emp'[comm], "v", [v])
