// note: the view expander's grid (tools/ossie/grid.mjs), where or: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.comm, AGG(t.sum_sal) AS v FROM scott_model.emp AS t WHERE t.ename <> 'KING' OR t.comm IN (300, 1400) GROUP BY t.comm
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('emp'[comm], "__rows", COUNTROWS(emp), "v", 'emp'[sum_sal]), (('emp'[ename] <> "KING") || ('emp'[comm] IN {300, 1400}))), "comm", 'emp'[comm], "v", [v])
