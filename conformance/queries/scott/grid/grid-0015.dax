// note: the view expander's grid (tools/ossie/grid.mjs), scalar ops: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.comm, AGG(t.emp_count) * 2 AS a, AGG(t.emp_count) + 1 AS b, COALESCE(AGG(t.emp_count), 0) AS c FROM scott_model.emp AS t GROUP BY t.comm
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('emp'[comm], "__rows", COUNTROWS(emp), "a", IF(ISBLANK(COUNTROWS(emp)), BLANK(), (COALESCE('emp'[emp_count], 0) * 2)), "b", IF(ISBLANK(COUNTROWS(emp)), BLANK(), (COALESCE('emp'[emp_count], 0) + 1)), "c", IF(ISBLANK(COUNTROWS(emp)), BLANK(), COALESCE(COALESCE('emp'[emp_count], 0), 0))), "comm", 'emp'[comm], "a", [a], "b", [b], "c", [c])
