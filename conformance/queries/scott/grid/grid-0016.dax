// note: the view expander's grid (tools/ossie/grid.mjs), ratio: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.comm, CAST(AGG(t.comm_count) AS DOUBLE) / NULLIF(AGG(t.emp_count), 0) AS r FROM scott_model.emp AS t GROUP BY t.comm
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('emp'[comm], "__rows", COUNTROWS('emp'), "r", IF(ISBLANK(COUNTROWS('emp')), BLANK(), (CONVERT(COALESCE('emp'[comm_count], 0), DOUBLE) / IF((COALESCE('emp'[emp_count], 0) == 0), BLANK(), COALESCE('emp'[emp_count], 0))))), "comm", 'emp'[comm], "r", [r])
