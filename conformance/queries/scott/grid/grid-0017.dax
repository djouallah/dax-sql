// note: the view expander's grid (tools/ossie/grid.mjs), cte: its SQL as dax-sql's SQL front end writes it in DAX:
// WITH s AS (SELECT comm, avg_sal AS mm FROM scott_model.emp WHERE empno = 7844) SELECT comm, AGG(mm) AS v FROM s GROUP BY comm
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('emp'[comm], "__rows", COUNTROWS('emp'), "v", 'emp'[avg_sal]), ('emp'[empno] = 7844)), "comm", 'emp'[comm], "v", [v])
