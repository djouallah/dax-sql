// note: the view expander's grid (tools/ossie/grid.mjs), star: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.deptno, AGG(f.emp_count) AS v FROM scott_model.emp AS f LEFT JOIN scott_model.dept AS o ON f.deptno = o.deptno GROUP BY o.deptno
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('dept'[deptno], "__rows", COUNTROWS(emp), "v", 'emp'[emp_count]), "deptno", 'dept'[deptno], "v", COALESCE([v], 0))
