// note: the view expander's grid (tools/ossie/grid.mjs), one side counted once: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.deptno, AGG(f.comm_count) AS a, AGG(o.dept_count) AS b FROM scott_model.emp AS f LEFT JOIN scott_model.dept AS o ON f.deptno = o.deptno GROUP BY o.deptno
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('dept'[deptno], "__rows", COUNTROWS('emp'), "a", 'emp'[comm_count], "b", CALCULATE('dept'[dept_count], 'emp')), "deptno", 'dept'[deptno], "a", COALESCE([a], 0), "b", COALESCE([b], 0))
