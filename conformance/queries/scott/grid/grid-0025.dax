EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('dept'[deptno], "__rows", COUNTROWS(dept), "a", 'dept'[dept_count], "b", CALCULATE('emp'[sum_comm], KEEPFILTERS(NOT(ISBLANK('dept'[deptno]))))), "deptno", 'dept'[deptno], "a", COALESCE([a], 0), "b", [b])
