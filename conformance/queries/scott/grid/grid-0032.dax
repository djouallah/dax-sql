// note: the view expander's grid (tools/ossie/grid.mjs), two groups: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.comm, t.deptno, AGG(t.sum_sal) AS v FROM scott_model.emp AS t GROUP BY t.comm, t.deptno
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('emp'[comm], 'emp'[deptno], "__rows", COUNTROWS(emp), "v", 'emp'[sum_sal]), "comm", 'emp'[comm], "deptno", 'emp'[deptno], "v", [v])
