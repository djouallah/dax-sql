// note: the view expander's grid (tools/ossie/grid.mjs), where and: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.comm, AGG(t.avg_sal) AS v FROM scott_model.emp AS t WHERE t.hiredate <> DATE '1982-01-23' AND t.sal IS NOT NULL GROUP BY t.comm
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('emp'[comm], "__rows", COUNTROWS('emp'), "v", 'emp'[avg_sal]), ('emp'[hiredate] <> DATE(1982, 1, 23)), NOT(ISBLANK('emp'[sal]))), "comm", 'emp'[comm], "v", [v])
