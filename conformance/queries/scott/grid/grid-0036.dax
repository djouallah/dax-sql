// note: the view expander's grid (tools/ossie/grid.mjs), where total: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT AGG(t.sum_comm) AS v FROM scott_model.emp AS t WHERE NOT (t.sal = 1500)
EVALUATE SELECTCOLUMNS(CALCULATETABLE(ROW("v", 'emp'[sum_comm]), NOT(('emp'[sal] = 1500))), "v", [v])
