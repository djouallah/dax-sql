// note: the view expander's grid (tools/ossie/grid.mjs), order limit: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.comm, AGG(t.avg_sal) AS v FROM scott_model.emp AS t GROUP BY t.comm ORDER BY t.comm NULLS FIRST LIMIT 3
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('emp'[comm], "__rows", COUNTROWS('emp'), "v", 'emp'[avg_sal]), "comm", 'emp'[comm], "v", [v]) ORDER BY [comm]
