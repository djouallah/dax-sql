// note: the view expander's grid (tools/ossie/grid.mjs), order by measure: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.comm, AGG(t.sum_comm) AS v FROM scott_model.emp AS t GROUP BY t.comm ORDER BY v DESC NULLS LAST, t.comm NULLS FIRST
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('emp'[comm], "__rows", COUNTROWS(emp), "v", 'emp'[sum_comm]), "comm", 'emp'[comm], "v", [v]) ORDER BY [v] DESC, [comm]
