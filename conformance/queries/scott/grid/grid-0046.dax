// note: the view expander's grid (tools/ossie/grid.mjs), derived table: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT s.comm, s.v FROM (SELECT t.comm, AGG(t.emp_count) AS v FROM scott_model.emp AS t GROUP BY t.comm) AS s WHERE s.v IS NOT NULL
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('emp'[comm], "__rows", COUNTROWS('emp'), "v", 'emp'[emp_count]), "comm", 'emp'[comm], "v", COALESCE([v], 0))
