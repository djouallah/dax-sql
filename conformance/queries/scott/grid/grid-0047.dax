// note: the view expander's grid (tools/ossie/grid.mjs), star: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.loc, AGG(f.comm_count) AS v FROM scott_model.emp AS f JOIN scott_model.dept AS o ON f.deptno = o.deptno GROUP BY o.loc
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('dept'[loc], "__rows", COUNTROWS('emp'), "v", 'emp'[comm_count]), NOT(ISBLANK('dept'[deptno]))), "loc", 'dept'[loc], "v", COALESCE([v], 0))
