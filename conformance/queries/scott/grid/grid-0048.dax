// note: the view expander's grid (tools/ossie/grid.mjs), star where one: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.loc, AGG(f.emp_count) AS v FROM scott_model.emp AS f JOIN scott_model.dept AS o ON f.deptno = o.deptno WHERE o.dname IS NOT NULL GROUP BY o.loc
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('dept'[loc], "__rows", COUNTROWS('emp'), "v", 'emp'[emp_count]), NOT(ISBLANK('dept'[dname])), NOT(ISBLANK('dept'[deptno]))), "loc", 'dept'[loc], "v", COALESCE([v], 0))
