// note: the view expander's grid (tools/ossie/grid.mjs), star two sides: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.loc, f.ename, AGG(f.avg_comm) AS v FROM scott_model.emp AS f JOIN scott_model.dept AS o ON f.deptno = o.deptno GROUP BY o.loc, f.ename
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('dept'[loc], 'emp'[ename], "__rows", COUNTROWS(emp), "v", 'emp'[avg_comm]), NOT(ISBLANK('dept'[deptno]))), "loc", 'dept'[loc], "ename", 'emp'[ename], "v", [v])
