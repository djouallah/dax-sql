// note: the view expander's grid (tools/ossie/grid.mjs), one to many: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.dname, AGG(o.dept_count) AS a, AGG(f.sum_sal) AS b FROM scott_model.dept AS o LEFT JOIN scott_model.emp AS f ON f.deptno = o.deptno GROUP BY o.dname
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('dept'[dname], "__rows", COUNTROWS(dept), "a", 'dept'[dept_count], "b", CALCULATE('emp'[sum_sal], KEEPFILTERS(NOT(ISBLANK('dept'[deptno]))))), "dname", 'dept'[dname], "a", COALESCE([a], 0), "b", [b])
