// note: the view expander's grid (tools/ossie/grid.mjs), fan-out: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT f.empno, AGG(o.dept_count) AS v FROM scott_model.emp AS f JOIN scott_model.dept AS o ON f.deptno = o.deptno GROUP BY f.empno
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('emp'[empno], "__rows", COUNTROWS(emp), "v", CALCULATE('dept'[dept_count], emp)), NOT(ISBLANK('dept'[deptno]))), "empno", 'emp'[empno], "v", COALESCE([v], 0))
