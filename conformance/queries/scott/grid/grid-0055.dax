// note: the view expander's grid (tools/ossie/grid.mjs), chasm: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.deptno, AGG(a.bonus_count) AS x, AGG(b.emp_count) AS y FROM scott_model.emp AS o LEFT JOIN scott_model.bonus AS a ON a.ename = o.ename LEFT JOIN scott_model.emp AS b ON b.mgr = o.empno GROUP BY o.deptno
DEFINE
VAR __v1 = GENERATEALL(GENERATEALL(SELECTCOLUMNS('emp', "o.empno", 'emp'[empno], "o.deptno", 'emp'[deptno], "o.ename", 'emp'[ename]), FILTER(SELECTCOLUMNS('bonus', "a.ename", 'bonus'[ename], "a.job", 'bonus'[job], "a.sal", 'bonus'[sal], "a.comm", 'bonus'[comm]), ([a.ename] = [o.ename]))), FILTER(SELECTCOLUMNS('emp', "b.empno", 'emp'[empno], "b.mgr", 'emp'[mgr]), ([b.mgr] = [o.empno])))
VAR __v2 = DISTINCT(SELECTCOLUMNS(__v1, "deptno", [o.deptno]))
EVALUATE SELECTCOLUMNS(ADDCOLUMNS(__v2, "__m1", COALESCE(CALCULATE('bonus'[bonus_count], REMOVEFILTERS(), TREATAS(SELECTCOLUMNS(FILTER(__v1, (NOT((((ISBLANK([a.ename]) && ISBLANK([a.job])) && ISBLANK([a.sal])) && ISBLANK([a.comm]))) && ([o.deptno] == [deptno]))), "__k1", [a.ename], "__k2", [a.job], "__k3", [a.sal], "__k4", [a.comm]), 'bonus'[ename], 'bonus'[job], 'bonus'[sal], 'bonus'[comm])), 0), "__m2", COALESCE(CALCULATE('emp'[emp_count], REMOVEFILTERS(), TREATAS(SELECTCOLUMNS(FILTER(__v1, (NOT(ISBLANK([b.empno])) && ([o.deptno] == [deptno]))), "__k1", [b.empno]), 'emp'[empno])), 0)), "deptno", [deptno], "x", [__m1], "y", [__m2])
