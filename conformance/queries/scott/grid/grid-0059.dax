// note: the view expander's grid (tools/ossie/grid.mjs), two metrics: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.ename, AGG(t.avg_sal) AS a, AGG(t.sum_sal) AS b FROM scott_model.emp AS t GROUP BY t.ename
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('emp'[ename], "__rows", COUNTROWS('emp'), "a", 'emp'[avg_sal], "b", 'emp'[sum_sal]), "ename", 'emp'[ename], "a", [a], "b", [b])
