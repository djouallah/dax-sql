// note: the view expander's grid (tools/ossie/grid.mjs), two groups: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.ename, t.empno, AGG(t.sum_sal) AS v FROM scott_model.emp AS t GROUP BY t.ename, t.empno
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('emp'[ename], 'emp'[empno], "__rows", COUNTROWS(emp), "v", 'emp'[sum_sal]), "ename", 'emp'[ename], "empno", 'emp'[empno], "v", [v])
