// note: the view expander's grid (tools/ossie/grid.mjs), where and: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.ename, AGG(t.sum_comm) AS v FROM scott_model.emp AS t WHERE t.deptno >= 20 AND t.ename IN ('JONES', 'TURNER') GROUP BY t.ename
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('emp'[ename], "__rows", COUNTROWS('emp'), "v", 'emp'[sum_comm]), ('emp'[deptno] >= 20), ('emp'[ename] IN {"JONES", "TURNER"})), "ename", 'emp'[ename], "v", [v])
