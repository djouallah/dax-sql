// note: the view expander's grid (tools/ossie/grid.mjs), where or: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.ename, AGG(t.emp_count) AS v FROM scott_model.emp AS t WHERE t.mgr IS NOT NULL OR t.deptno IS NOT NULL GROUP BY t.ename
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('emp'[ename], "__rows", COUNTROWS('emp'), "v", 'emp'[emp_count]), (NOT(ISBLANK('emp'[mgr])) || NOT(ISBLANK('emp'[deptno])))), "ename", 'emp'[ename], "v", COALESCE([v], 0))
