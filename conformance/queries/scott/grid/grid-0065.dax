// note: the view expander's grid (tools/ossie/grid.mjs), having: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.ename, AGG(t.avg_comm) AS v FROM scott_model.emp AS t GROUP BY t.ename HAVING AGG(t.emp_count) > 0
EVALUATE SELECTCOLUMNS(FILTER(SUMMARIZECOLUMNS('emp'[ename], "__rows", COUNTROWS('emp'), "v", 'emp'[avg_comm]), (COALESCE('emp'[emp_count], 0) > 0)), "ename", 'emp'[ename], "v", [v])
