// note: the view expander's grid (tools/ossie/grid.mjs), order by measure: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.ename, AGG(t.sum_sal) AS v FROM scott_model.emp AS t GROUP BY t.ename ORDER BY v DESC NULLS LAST, t.ename NULLS FIRST
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('emp'[ename], "__rows", COUNTROWS(emp), "v", 'emp'[sum_sal]), "ename", 'emp'[ename], "v", [v]) ORDER BY [v] DESC, [ename]
