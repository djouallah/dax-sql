// note: the view expander's grid (tools/ossie/grid.mjs), rollup: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.deptno, AGG(t.comm_count) AS v FROM scott_model.emp AS t GROUP BY ROLLUP (t.deptno) ORDER BY t.deptno NULLS LAST
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS(ROLLUPADDISSUBTOTAL('emp'[deptno], "__level1_deptno"), "__rows", COUNTROWS(emp), "v", 'emp'[comm_count]), "deptno", 'emp'[deptno], "v", COALESCE([v], 0)) ORDER BY ISBLANK([deptno]), [deptno]
