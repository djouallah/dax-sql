// note: the view expander's grid (tools/ossie/grid.mjs), scalar ops: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.ename, AGG(t.comm_count) * 2 AS a, AGG(t.comm_count) + 1 AS b, COALESCE(AGG(t.comm_count), 0) AS c FROM scott_model.emp AS t GROUP BY t.ename
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('emp'[ename], "__rows", COUNTROWS('emp'), "a", IF(ISBLANK(COUNTROWS('emp')), BLANK(), (COALESCE('emp'[comm_count], 0) * 2)), "b", IF(ISBLANK(COUNTROWS('emp')), BLANK(), (COALESCE('emp'[comm_count], 0) + 1)), "c", IF(ISBLANK(COUNTROWS('emp')), BLANK(), COALESCE(COALESCE('emp'[comm_count], 0), 0))), "ename", 'emp'[ename], "a", [a], "b", [b], "c", [c])
