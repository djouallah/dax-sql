// note: the view expander's grid (tools/ossie/grid.mjs), ratio: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.ename, CAST(AGG(t.emp_count) AS DOUBLE) / NULLIF(AGG(t.comm_count), 0) AS r FROM scott_model.emp AS t GROUP BY t.ename
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('emp'[ename], "__rows", COUNTROWS('emp'), "r", IF(ISBLANK(COUNTROWS('emp')), BLANK(), (CONVERT(COALESCE('emp'[emp_count], 0), DOUBLE) / IF((COALESCE('emp'[comm_count], 0) == 0), BLANK(), COALESCE('emp'[comm_count], 0))))), "ename", 'emp'[ename], "r", [r])
