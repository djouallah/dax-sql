// note: the view expander's grid (tools/ossie/grid.mjs), star: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.dname, AGG(f.sum_comm) AS v FROM scott_model.emp AS f JOIN scott_model.dept AS o ON f.deptno = o.deptno GROUP BY o.dname
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('dept'[dname], "__rows", COUNTROWS('emp'), "v", 'emp'[sum_comm]), NOT(ISBLANK('dept'[deptno]))), "dname", 'dept'[dname], "v", [v])
