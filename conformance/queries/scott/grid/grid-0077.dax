// note: the view expander's grid (tools/ossie/grid.mjs), star where many: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.dname, AGG(f.avg_comm) AS v FROM scott_model.emp AS f JOIN scott_model.dept AS o ON f.deptno = o.deptno WHERE f.hiredate IS NOT NULL GROUP BY o.dname
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('dept'[dname], "__rows", COUNTROWS('emp'), "v", 'emp'[avg_comm]), NOT(ISBLANK('emp'[hiredate])), NOT(ISBLANK('dept'[deptno]))), "dname", 'dept'[dname], "v", [v])
