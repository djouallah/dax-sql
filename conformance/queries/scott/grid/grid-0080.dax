// note: the view expander's grid (tools/ossie/grid.mjs), one side counted once: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.loc, AGG(f.comm_count) AS a, AGG(o.dept_count) AS b FROM scott_model.emp AS f JOIN scott_model.dept AS o ON f.deptno = o.deptno GROUP BY o.loc
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('dept'[loc], "__rows", COUNTROWS(emp), "a", 'emp'[comm_count], "b", CALCULATE('dept'[dept_count], emp)), NOT(ISBLANK('dept'[deptno]))), "loc", 'dept'[loc], "a", COALESCE([a], 0), "b", COALESCE([b], 0))
