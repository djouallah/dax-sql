EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('dept'[loc], "__rows", COUNTROWS('dept'), "a", 'dept'[dept_count], "b", CALCULATE('emp'[comm_count], KEEPFILTERS(NOT(ISBLANK('dept'[deptno]))))), "loc", 'dept'[loc], "a", COALESCE([a], 0), "b", COALESCE([b], 0))
