// note: the view expander's grid (tools/ossie/grid.mjs), chasm: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.hiredate, AGG(a.sum_bonus) AS x, AGG(b.pet_count) AS y FROM scott_model.emp AS o LEFT JOIN scott_model.bonus AS a ON a.ename = o.ename LEFT JOIN scott_model.pet AS b ON b.empno = o.empno GROUP BY o.hiredate
DEFINE
VAR __v1 = GENERATEALL(GENERATEALL(SELECTCOLUMNS(emp, "o.empno", 'emp'[empno], "o.hiredate", 'emp'[hiredate], "o.ename", 'emp'[ename]), FILTER(SELECTCOLUMNS(bonus, "a.ename", 'bonus'[ename], "a.job", 'bonus'[job], "a.sal", 'bonus'[sal], "a.comm", 'bonus'[comm]), ([a.ename] = [o.ename]))), FILTER(SELECTCOLUMNS(pet, "b.pname", 'pet'[pname], "b.empno", 'pet'[empno]), ([b.empno] = [o.empno])))
VAR __v2 = DISTINCT(SELECTCOLUMNS(__v1, "hiredate", [o.hiredate]))
EVALUATE SELECTCOLUMNS(ADDCOLUMNS(__v2, "__m1", CALCULATE('bonus'[sum_bonus], REMOVEFILTERS(), TREATAS(SELECTCOLUMNS(FILTER(__v1, (NOT((((ISBLANK([a.ename]) && ISBLANK([a.job])) && ISBLANK([a.sal])) && ISBLANK([a.comm]))) && ([o.hiredate] == [hiredate]))), "__k1", [a.ename], "__k2", [a.job], "__k3", [a.sal], "__k4", [a.comm]), 'bonus'[ename], 'bonus'[job], 'bonus'[sal], 'bonus'[comm])), "__m2", COALESCE(CALCULATE('pet'[pet_count], REMOVEFILTERS(), TREATAS(SELECTCOLUMNS(FILTER(__v1, (NOT(ISBLANK([b.pname])) && ([o.hiredate] == [hiredate]))), "__k1", [b.pname]), 'pet'[pname])), 0)), "hiredate", [hiredate], "x", [__m1], "y", [__m2])
