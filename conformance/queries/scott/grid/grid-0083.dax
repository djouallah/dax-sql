EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('emp'[hiredate], "__rows", COUNTROWS('emp'), "x", CALCULATE('bonus'[sum_bonus], KEEPFILTERS(NOT(ISBLANK('emp'[ename])))), "y", CALCULATE('pet'[pet_count], KEEPFILTERS(NOT(ISBLANK('emp'[empno]))))), "hiredate", 'emp'[hiredate], "x", [x], "y", COALESCE([y], 0))
