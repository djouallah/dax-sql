// note: the view expander's grid (tools/ossie/grid.mjs), two metrics: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.empno, AGG(t.sum_comm) AS a, AGG(t.sum_comm) AS b FROM scott_model.emp AS t GROUP BY t.empno
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('emp'[empno], "__rows", COUNTROWS(emp), "a", 'emp'[sum_comm], "b", 'emp'[sum_comm]), "empno", 'emp'[empno], "a", [a], "b", [b])
