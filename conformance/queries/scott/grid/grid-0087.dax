// note: the view expander's grid (tools/ossie/grid.mjs), two groups: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.empno, t.comm, AGG(t.avg_comm) AS v FROM scott_model.emp AS t GROUP BY t.empno, t.comm
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('emp'[empno], 'emp'[comm], "__rows", COUNTROWS(emp), "v", 'emp'[avg_comm]), "empno", 'emp'[empno], "comm", 'emp'[comm], "v", [v])
