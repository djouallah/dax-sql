// note: the view expander's grid (tools/ossie/grid.mjs), where: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.empno, AGG(t.sum_sal) AS v FROM scott_model.emp AS t WHERE t.comm <> 0 GROUP BY t.empno
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('emp'[empno], "__rows", COUNTROWS('emp'), "v", 'emp'[sum_sal]), ('emp'[comm] <> 0)), "empno", 'emp'[empno], "v", [v])
