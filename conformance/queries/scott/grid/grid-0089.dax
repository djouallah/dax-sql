// note: the view expander's grid (tools/ossie/grid.mjs), where and: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.empno, AGG(t.avg_sal) AS v FROM scott_model.emp AS t WHERE t.job = 'MANAGER' AND t.deptno <> 30 GROUP BY t.empno
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('emp'[empno], "__rows", COUNTROWS(emp), "v", 'emp'[avg_sal]), ('emp'[job] = "MANAGER"), ('emp'[deptno] <> 30)), "empno", 'emp'[empno], "v", [v])
