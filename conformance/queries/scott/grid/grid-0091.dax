// note: the view expander's grid (tools/ossie/grid.mjs), where total: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT AGG(t.comm_count) AS v FROM scott_model.emp AS t WHERE t.comm BETWEEN 0 AND 0
EVALUATE SELECTCOLUMNS(CALCULATETABLE(ROW("v", 'emp'[comm_count]), (('emp'[comm] >= 0) && ('emp'[comm] <= 0))), "v", COALESCE([v], 0))
