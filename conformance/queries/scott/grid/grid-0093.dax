// note: the view expander's grid (tools/ossie/grid.mjs), having null: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.empno, AGG(t.avg_comm) AS v FROM scott_model.emp AS t GROUP BY t.empno HAVING AGG(t.avg_comm) IS NOT NULL
EVALUATE SELECTCOLUMNS(FILTER(SUMMARIZECOLUMNS('emp'[empno], "__rows", COUNTROWS(emp), "v", 'emp'[avg_comm]), NOT(ISBLANK([v]))), "empno", 'emp'[empno], "v", [v])
