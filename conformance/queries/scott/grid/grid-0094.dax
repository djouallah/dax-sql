// note: the view expander's grid (tools/ossie/grid.mjs), order limit: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.empno, AGG(t.comm_count) AS v FROM scott_model.emp AS t GROUP BY t.empno ORDER BY t.empno NULLS FIRST LIMIT 3
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('emp'[empno], "__rows", COUNTROWS(emp), "v", 'emp'[comm_count]), "empno", 'emp'[empno], "v", COALESCE([v], 0)) ORDER BY [empno]
