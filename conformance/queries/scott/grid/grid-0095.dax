// note: the view expander's grid (tools/ossie/grid.mjs), order by measure: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.empno, AGG(t.sum_sal) AS v FROM scott_model.emp AS t GROUP BY t.empno ORDER BY v DESC NULLS LAST, t.empno NULLS FIRST
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('emp'[empno], "__rows", COUNTROWS(emp), "v", 'emp'[sum_sal]), "empno", 'emp'[empno], "v", [v]) ORDER BY [v] DESC, [empno]
