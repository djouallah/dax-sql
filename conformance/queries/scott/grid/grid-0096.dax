// note: the view expander's grid (tools/ossie/grid.mjs), group by all: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.empno, AGG(t.emp_count) AS v FROM scott_model.emp AS t GROUP BY ALL
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('emp'[empno], "__rows", COUNTROWS('emp'), "v", 'emp'[emp_count]), "empno", 'emp'[empno], "v", COALESCE([v], 0))
