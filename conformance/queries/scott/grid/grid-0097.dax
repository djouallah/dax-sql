// note: the view expander's grid (tools/ossie/grid.mjs), rollup: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.ename, AGG(t.sum_sal) AS v FROM scott_model.emp AS t GROUP BY ROLLUP (t.ename) ORDER BY t.ename NULLS LAST
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS(ROLLUPADDISSUBTOTAL('emp'[ename], "__level1_ename"), "__rows", COUNTROWS('emp'), "v", 'emp'[sum_sal]), "ename", 'emp'[ename], "v", [v]) ORDER BY ISBLANK([ename]), [ename]
