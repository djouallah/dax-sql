// note: the view expander's grid (tools/ossie/grid.mjs), cte: its SQL as dax-sql's SQL front end writes it in DAX:
// WITH s AS (SELECT empno, emp_count AS mm FROM scott_model.emp WHERE NOT (job = 'SALESMAN')) SELECT empno, AGG(mm) AS v FROM s GROUP BY empno
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('emp'[empno], "__rows", COUNTROWS(emp), "v", 'emp'[emp_count]), NOT(('emp'[job] = "SALESMAN"))), "empno", 'emp'[empno], "v", COALESCE([v], 0))
