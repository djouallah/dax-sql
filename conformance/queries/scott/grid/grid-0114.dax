// note: the view expander's grid (tools/ossie/grid.mjs), where: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.comm, AGG(t.emp_count) AS v FROM scott_model.emp AS t WHERE t.empno = 7698 GROUP BY t.comm
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('emp'[comm], "__rows", COUNTROWS(emp), "v", 'emp'[emp_count]), ('emp'[empno] = 7698)), "comm", 'emp'[comm], "v", COALESCE([v], 0))
