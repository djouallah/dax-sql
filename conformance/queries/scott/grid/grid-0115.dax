// note: the view expander's grid (tools/ossie/grid.mjs), where and: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.comm, AGG(t.sum_sal) AS v FROM scott_model.emp AS t WHERE t.hiredate BETWEEN DATE '1980-12-17' AND DATE '1981-02-04' AND t.sal = 1600 GROUP BY t.comm
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('emp'[comm], "__rows", COUNTROWS(emp), "v", 'emp'[sum_sal]), (('emp'[hiredate] >= DATE(1980, 12, 17)) && ('emp'[hiredate] <= DATE(1981, 2, 4))), ('emp'[sal] = 1600)), "comm", 'emp'[comm], "v", [v])
