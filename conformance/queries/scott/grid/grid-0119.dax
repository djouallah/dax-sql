// note: the view expander's grid (tools/ossie/grid.mjs), having null: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.comm, AGG(t.comm_count) AS v FROM scott_model.emp AS t GROUP BY t.comm HAVING AGG(t.avg_sal) IS NOT NULL
EVALUATE SELECTCOLUMNS(FILTER(SUMMARIZECOLUMNS('emp'[comm], "__rows", COUNTROWS(emp), "v", 'emp'[comm_count]), NOT(ISBLANK('emp'[avg_sal]))), "comm", 'emp'[comm], "v", COALESCE([v], 0))
