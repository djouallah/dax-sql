// note: the view expander's grid (tools/ossie/grid.mjs), scalar ops: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.comm, AGG(t.sum_comm) * 2 AS a, AGG(t.sum_comm) + 1 AS b, COALESCE(AGG(t.sum_comm), 0) AS c FROM scott_model.emp AS t GROUP BY t.comm
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('emp'[comm], "__rows", COUNTROWS('emp'), "a", ('emp'[sum_comm] * 2), "b", ('emp'[sum_comm] + 1), "c", IF(ISBLANK(COUNTROWS('emp')), BLANK(), COALESCE('emp'[sum_comm], 0))), "comm", 'emp'[comm], "a", [a], "b", [b], "c", [c])
