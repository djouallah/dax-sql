// note: the view expander's grid (tools/ossie/grid.mjs), ratio: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.comm, CAST(AGG(t.emp_count) AS DOUBLE) / NULLIF(AGG(t.sum_sal), 0) AS r FROM scott_model.emp AS t GROUP BY t.comm
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('emp'[comm], "__rows", COUNTROWS(emp), "r", IF(ISBLANK(COUNTROWS(emp)), BLANK(), (CONVERT(COALESCE('emp'[emp_count], 0), DOUBLE) / IF(('emp'[sum_sal] == 0), BLANK(), 'emp'[sum_sal])))), "comm", 'emp'[comm], "r", [r])
