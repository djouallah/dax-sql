// note: the view expander's grid (tools/ossie/grid.mjs), star where one: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.empno, AGG(f.avg_sal) AS v FROM scott_model.emp AS f JOIN scott_model.emp AS o ON f.mgr = o.empno WHERE o.mgr <> 7698 GROUP BY o.empno
DEFINE
VAR __v1 = GENERATE(SELECTCOLUMNS(emp, "f.empno", 'emp'[empno], "f.mgr", 'emp'[mgr]), FILTER(SELECTCOLUMNS(emp, "o.empno", 'emp'[empno], "o.mgr", 'emp'[mgr]), ([f.mgr] = [o.empno])))
VAR __v2 = FILTER(__v1, ([o.mgr] <> 7698))
VAR __v3 = DISTINCT(SELECTCOLUMNS(__v2, "empno", [o.empno]))
EVALUATE SELECTCOLUMNS(ADDCOLUMNS(__v3, "__m1", CALCULATE('emp'[avg_sal], REMOVEFILTERS(), TREATAS(SELECTCOLUMNS(FILTER(__v2, (NOT(ISBLANK([f.empno])) && ([o.empno] == [empno]))), "__k1", [f.empno]), 'emp'[empno]))), "empno", [empno], "v", [__m1])
