// note: the view expander's grid (tools/ossie/grid.mjs), two groups: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.loc, t.dname, AGG(t.dept_count) AS v FROM scott_model.dept AS t GROUP BY t.loc, t.dname
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('dept'[loc], 'dept'[dname], "__rows", COUNTROWS(dept), "v", 'dept'[dept_count]), "loc", 'dept'[loc], "dname", 'dept'[dname], "v", COALESCE([v], 0))
