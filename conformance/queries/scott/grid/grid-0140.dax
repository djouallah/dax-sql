// note: the view expander's grid (tools/ossie/grid.mjs), where: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.ename, AGG(t.sum_comm) AS v FROM scott_model.emp AS t WHERE t.hiredate < DATE '1981-09-28' GROUP BY t.ename
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('emp'[ename], "__rows", COUNTROWS(emp), "v", 'emp'[sum_comm]), ('emp'[hiredate] < DATE(1981, 9, 28))), "ename", 'emp'[ename], "v", [v])
