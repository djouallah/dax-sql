// note: the view expander's grid (tools/ossie/grid.mjs), where and: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.ename, AGG(t.comm_count) AS v FROM scott_model.emp AS t WHERE t.hiredate IS NOT NULL AND t.mgr IN (7839, 7698) GROUP BY t.ename
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('emp'[ename], "__rows", COUNTROWS('emp'), "v", 'emp'[comm_count]), NOT(ISBLANK('emp'[hiredate])), ('emp'[mgr] IN {7839, 7698})), "ename", 'emp'[ename], "v", COALESCE([v], 0))
