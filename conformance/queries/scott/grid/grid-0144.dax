// note: the view expander's grid (tools/ossie/grid.mjs), having: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.ename, AGG(t.emp_count) AS v FROM scott_model.emp AS t GROUP BY t.ename HAVING AGG(t.sum_comm) > 0
EVALUATE SELECTCOLUMNS(FILTER(SUMMARIZECOLUMNS('emp'[ename], "__rows", COUNTROWS('emp'), "v", 'emp'[emp_count]), ('emp'[sum_comm] > 0)), "ename", 'emp'[ename], "v", COALESCE([v], 0))
