// note: the view expander's grid (tools/ossie/grid.mjs), having null: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.ename, AGG(t.emp_count) AS v FROM scott_model.emp AS t GROUP BY t.ename HAVING AGG(t.sum_comm) IS NOT NULL
EVALUATE SELECTCOLUMNS(FILTER(SUMMARIZECOLUMNS('emp'[ename], "__rows", COUNTROWS('emp'), "v", 'emp'[emp_count]), NOT(ISBLANK('emp'[sum_comm]))), "ename", 'emp'[ename], "v", COALESCE([v], 0))
