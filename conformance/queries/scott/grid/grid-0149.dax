// note: the view expander's grid (tools/ossie/grid.mjs), rollup: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.ename, AGG(t.emp_count) AS v FROM scott_model.emp AS t GROUP BY ROLLUP (t.ename) ORDER BY t.ename NULLS LAST
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS(ROLLUPADDISSUBTOTAL('emp'[ename], "__level1_ename"), "__rows", COUNTROWS(emp), "v", 'emp'[emp_count]), "ename", 'emp'[ename], "v", COALESCE([v], 0)) ORDER BY ISBLANK([ename]), [ename]
