// note: the view expander's grid (tools/ossie/grid.mjs), cte: its SQL as dax-sql's SQL front end writes it in DAX:
// WITH s AS (SELECT ename, sum_comm AS mm FROM scott_model.emp WHERE sal <> 1300) SELECT ename, AGG(mm) AS v FROM s GROUP BY ename
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('emp'[ename], "__rows", COUNTROWS(emp), "v", 'emp'[sum_comm]), ('emp'[sal] <> 1300)), "ename", 'emp'[ename], "v", [v])
