// note: the view expander's grid (tools/ossie/grid.mjs), derived table: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT s.ename, s.v FROM (SELECT t.ename, AGG(t.comm_count) AS v FROM scott_model.emp AS t GROUP BY t.ename) AS s WHERE s.v IS NOT NULL
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('emp'[ename], "__rows", COUNTROWS(emp), "v", 'emp'[comm_count]), "ename", 'emp'[ename], "v", COALESCE([v], 0))
