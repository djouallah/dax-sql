// note: the view expander's grid (tools/ossie/grid.mjs), star where one: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.sal, AGG(f.comm_count) AS v FROM scott_model.emp AS f JOIN scott_model.emp AS o ON f.mgr = o.empno WHERE o.mgr < 7566 GROUP BY o.sal
DEFINE
VAR __v1 = GENERATE(SELECTCOLUMNS(emp, "f.empno", 'emp'[empno], "f.mgr", 'emp'[mgr]), FILTER(SELECTCOLUMNS(emp, "o.empno", 'emp'[empno], "o.sal", 'emp'[sal], "o.mgr", 'emp'[mgr]), ([f.mgr] = [o.empno])))
VAR __v2 = FILTER(__v1, ([o.mgr] < 7566))
VAR __v3 = DISTINCT(SELECTCOLUMNS(__v2, "sal", [o.sal]))
EVALUATE SELECTCOLUMNS(ADDCOLUMNS(__v3, "__m1", COALESCE(CALCULATE('emp'[comm_count], REMOVEFILTERS(), TREATAS(SELECTCOLUMNS(FILTER(__v2, (NOT(ISBLANK([f.empno])) && ([o.sal] == [sal]))), "__k1", [f.empno]), 'emp'[empno])), 0)), "sal", [sal], "v", [__m1])
