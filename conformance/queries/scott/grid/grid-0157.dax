// note: the view expander's grid (tools/ossie/grid.mjs), star two sides: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.sal, f.mgr, AGG(f.emp_count) AS v FROM scott_model.emp AS f JOIN scott_model.emp AS o ON f.mgr = o.empno GROUP BY o.sal, f.mgr
DEFINE
VAR __v1 = GENERATE(SELECTCOLUMNS('emp', "f.empno", 'emp'[empno], "f.mgr", 'emp'[mgr]), FILTER(SELECTCOLUMNS('emp', "o.empno", 'emp'[empno], "o.sal", 'emp'[sal]), ([f.mgr] = [o.empno])))
VAR __v2 = DISTINCT(SELECTCOLUMNS(__v1, "sal", [o.sal], "mgr", [f.mgr]))
EVALUATE SELECTCOLUMNS(ADDCOLUMNS(__v2, "__m1", COALESCE(CALCULATE('emp'[emp_count], REMOVEFILTERS(), TREATAS(SELECTCOLUMNS(FILTER(__v1, ((NOT(ISBLANK([f.empno])) && ([o.sal] == [sal])) && ([f.mgr] == [mgr]))), "__k1", [f.empno]), 'emp'[empno])), 0)), "sal", [sal], "mgr", [mgr], "v", [__m1])
