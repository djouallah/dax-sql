// note: the view expander's grid (tools/ossie/grid.mjs), star total: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT AGG(f.sum_age) AS v FROM scott_model.pet AS f JOIN scott_model.emp AS o ON f.empno = o.empno
EVALUATE SELECTCOLUMNS(CALCULATETABLE(ROW("v", 'pet'[sum_age]), NOT(ISBLANK('emp'[empno]))), "v", [v])
