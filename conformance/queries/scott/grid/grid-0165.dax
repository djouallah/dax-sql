// note: the view expander's grid (tools/ossie/grid.mjs), two groups: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.dname, t.deptno, AGG(t.dept_count) AS v FROM scott_model.dept AS t GROUP BY t.dname, t.deptno
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('dept'[dname], 'dept'[deptno], "__rows", COUNTROWS(dept), "v", 'dept'[dept_count]), "dname", 'dept'[dname], "deptno", 'dept'[deptno], "v", COALESCE([v], 0))
