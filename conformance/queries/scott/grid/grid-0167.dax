// note: the view expander's grid (tools/ossie/grid.mjs), where and: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.loc, AGG(t.dept_count) AS v FROM scott_model.dept AS t WHERE t.dname IS NOT NULL AND t.loc IN ('NEW YORK', 'BOSTON') GROUP BY t.loc
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('dept'[loc], "__rows", COUNTROWS('dept'), "v", 'dept'[dept_count]), NOT(ISBLANK('dept'[dname])), ('dept'[loc] IN {"NEW YORK", "BOSTON"})), "loc", 'dept'[loc], "v", COALESCE([v], 0))
