// note: the view expander's grid (tools/ossie/grid.mjs), having null: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.loc, AGG(t.dept_count) AS v FROM scott_model.dept AS t GROUP BY t.loc HAVING AGG(t.dept_count) IS NOT NULL
EVALUATE SELECTCOLUMNS(FILTER(SUMMARIZECOLUMNS('dept'[loc], "__rows", COUNTROWS(dept), "v", 'dept'[dept_count]), NOT(ISBLANK(COALESCE([v], 0)))), "loc", 'dept'[loc], "v", COALESCE([v], 0))
