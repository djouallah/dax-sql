// note: the view expander's grid (tools/ossie/grid.mjs), order by measure: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.loc, AGG(t.dept_count) AS v FROM scott_model.dept AS t GROUP BY t.loc ORDER BY v DESC NULLS LAST, t.loc NULLS FIRST
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('dept'[loc], "__rows", COUNTROWS(dept), "v", 'dept'[dept_count]), "loc", 'dept'[loc], "v", COALESCE([v], 0)) ORDER BY [v] DESC, [loc]
