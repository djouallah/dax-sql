// note: the view expander's grid (tools/ossie/grid.mjs), group by all: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.deptno, AGG(t.dept_count) AS v FROM scott_model.dept AS t GROUP BY ALL
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('dept'[deptno], "__rows", COUNTROWS('dept'), "v", 'dept'[dept_count]), "deptno", 'dept'[deptno], "v", COALESCE([v], 0))
