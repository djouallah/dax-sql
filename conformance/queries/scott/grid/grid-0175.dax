// note: the view expander's grid (tools/ossie/grid.mjs), rollup: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.dname, AGG(t.dept_count) AS v FROM scott_model.dept AS t GROUP BY ROLLUP (t.dname) ORDER BY t.dname NULLS LAST
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS(ROLLUPADDISSUBTOTAL('dept'[dname], "__level1_dname"), "__rows", COUNTROWS(dept), "v", 'dept'[dept_count]), "dname", 'dept'[dname], "v", COALESCE([v], 0)) ORDER BY ISBLANK([dname]), [dname]
