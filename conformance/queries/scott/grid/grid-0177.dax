// note: the view expander's grid (tools/ossie/grid.mjs), ratio: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.empno, CAST(AGG(t.pet_count) AS DOUBLE) / NULLIF(AGG(t.pet_count), 0) AS r FROM scott_model.pet AS t GROUP BY t.empno
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('pet'[empno], "__rows", COUNTROWS('pet'), "r", IF(ISBLANK(COUNTROWS('pet')), BLANK(), (CONVERT(COALESCE('pet'[pet_count], 0), DOUBLE) / IF((COALESCE('pet'[pet_count], 0) == 0), BLANK(), COALESCE('pet'[pet_count], 0))))), "empno", 'pet'[empno], "r", [r])
