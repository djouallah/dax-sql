// note: the view expander's grid (tools/ossie/grid.mjs), derived table: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT s.loc, s.v FROM (SELECT t.loc, AGG(t.dept_count) AS v FROM scott_model.dept AS t GROUP BY t.loc) AS s WHERE s.v IS NOT NULL
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('dept'[loc], "__rows", COUNTROWS('dept'), "v", 'dept'[dept_count]), "loc", 'dept'[loc], "v", COALESCE([v], 0))
