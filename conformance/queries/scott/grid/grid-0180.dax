// note: the view expander's grid (tools/ossie/grid.mjs), star: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.comm, AGG(f.pet_count) AS v FROM scott_model.pet AS f JOIN scott_model.emp AS o ON f.empno = o.empno GROUP BY o.comm
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('emp'[comm], "__rows", COUNTROWS(pet), "v", 'pet'[pet_count]), NOT(ISBLANK('emp'[empno]))), "comm", 'emp'[comm], "v", COALESCE([v], 0))
