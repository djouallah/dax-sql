// note: the view expander's grid (tools/ossie/grid.mjs), star two sides: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.comm, f.empno, AGG(f.pet_count) AS v FROM scott_model.pet AS f JOIN scott_model.emp AS o ON f.empno = o.empno GROUP BY o.comm, f.empno
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('emp'[comm], 'pet'[empno], "__rows", COUNTROWS(pet), "v", 'pet'[pet_count]), NOT(ISBLANK('emp'[empno]))), "comm", 'emp'[comm], "empno", 'pet'[empno], "v", COALESCE([v], 0))
