// note: the view expander's grid (tools/ossie/grid.mjs), one side counted once: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.ename, AGG(f.pet_count) AS a, AGG(o.comm_count) AS b FROM scott_model.pet AS f JOIN scott_model.emp AS o ON f.empno = o.empno GROUP BY o.ename
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('emp'[ename], "__rows", COUNTROWS(pet), "a", 'pet'[pet_count], "b", CALCULATE('emp'[comm_count], pet)), NOT(ISBLANK('emp'[empno]))), "ename", 'emp'[ename], "a", COALESCE([a], 0), "b", COALESCE([b], 0))
