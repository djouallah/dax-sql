// note: the view expander's grid (tools/ossie/grid.mjs), one to many: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.ename, AGG(o.avg_comm) AS a, AGG(f.pet_count) AS b FROM scott_model.emp AS o LEFT JOIN scott_model.pet AS f ON f.empno = o.empno GROUP BY o.ename
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('emp'[ename], "__rows", COUNTROWS(emp), "a", 'emp'[avg_comm], "b", CALCULATE('pet'[pet_count], KEEPFILTERS(NOT(ISBLANK('emp'[empno]))))), "ename", 'emp'[ename], "a", [a], "b", COALESCE([b], 0))
