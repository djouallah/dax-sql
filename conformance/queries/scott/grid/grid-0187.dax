// note: the view expander's grid (tools/ossie/grid.mjs), fan-out: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT f.species, AGG(o.sum_comm) AS v FROM scott_model.pet AS f JOIN scott_model.emp AS o ON f.empno = o.empno GROUP BY f.species
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('pet'[species], "__rows", COUNTROWS('pet'), "v", CALCULATE('emp'[sum_comm], 'pet')), NOT(ISBLANK('emp'[empno]))), "species", 'pet'[species], "v", [v])
