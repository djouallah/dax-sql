// note: the view expander's grid (tools/ossie/grid.mjs), where: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.deptno, AGG(t.dept_count) AS v FROM scott_model.dept AS t WHERE t.dname IS NOT NULL GROUP BY t.deptno
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('dept'[deptno], "__rows", COUNTROWS(dept), "v", 'dept'[dept_count]), NOT(ISBLANK('dept'[dname]))), "deptno", 'dept'[deptno], "v", COALESCE([v], 0))
