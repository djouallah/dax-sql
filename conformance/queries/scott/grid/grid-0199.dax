// note: the view expander's grid (tools/ossie/grid.mjs), order by measure: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.deptno, AGG(t.dept_count) AS v FROM scott_model.dept AS t GROUP BY t.deptno ORDER BY v DESC NULLS LAST, t.deptno NULLS FIRST
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('dept'[deptno], "__rows", COUNTROWS(dept), "v", 'dept'[dept_count]), "deptno", 'dept'[deptno], "v", COALESCE([v], 0)) ORDER BY [v] DESC, [deptno]
