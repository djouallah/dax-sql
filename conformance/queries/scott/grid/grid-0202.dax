// note: the view expander's grid (tools/ossie/grid.mjs), scalar ops: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.dname, AGG(t.dept_count) * 2 AS a, AGG(t.dept_count) + 1 AS b, COALESCE(AGG(t.dept_count), 0) AS c FROM scott_model.dept AS t GROUP BY t.dname
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('dept'[dname], "__rows", COUNTROWS(dept), "a", IF(ISBLANK(COUNTROWS(dept)), BLANK(), (COALESCE('dept'[dept_count], 0) * 2)), "b", IF(ISBLANK(COUNTROWS(dept)), BLANK(), (COALESCE('dept'[dept_count], 0) + 1)), "c", IF(ISBLANK(COUNTROWS(dept)), BLANK(), COALESCE(COALESCE('dept'[dept_count], 0), 0))), "dname", 'dept'[dname], "a", [a], "b", [b], "c", [c])
