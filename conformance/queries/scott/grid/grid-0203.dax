// note: the view expander's grid (tools/ossie/grid.mjs), ratio: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.age, CAST(AGG(t.pet_count) AS DOUBLE) / NULLIF(AGG(t.pet_count), 0) AS r FROM scott_model.pet AS t GROUP BY t.age
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('pet'[age], "__rows", COUNTROWS(pet), "r", IF(ISBLANK(COUNTROWS(pet)), BLANK(), (CONVERT(COALESCE('pet'[pet_count], 0), DOUBLE) / IF((COALESCE('pet'[pet_count], 0) == 0), BLANK(), COALESCE('pet'[pet_count], 0))))), "age", 'pet'[age], "r", [r])
