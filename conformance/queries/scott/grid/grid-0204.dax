// note: the view expander's grid (tools/ossie/grid.mjs), cte: its SQL as dax-sql's SQL front end writes it in DAX:
// WITH s AS (SELECT deptno, dept_count AS mm FROM scott_model.dept WHERE dname = 'ACCOUNTING') SELECT deptno, AGG(mm) AS v FROM s GROUP BY deptno
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('dept'[deptno], "__rows", COUNTROWS('dept'), "v", 'dept'[dept_count]), ('dept'[dname] = "ACCOUNTING")), "deptno", 'dept'[deptno], "v", COALESCE([v], 0))
