// note: the view expander's grid (tools/ossie/grid.mjs), derived table: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT s.deptno, s.v FROM (SELECT t.deptno, AGG(t.dept_count) AS v FROM scott_model.dept AS t GROUP BY t.deptno) AS s WHERE s.v IS NOT NULL
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('dept'[deptno], "__rows", COUNTROWS('dept'), "v", 'dept'[dept_count]), "deptno", 'dept'[deptno], "v", COALESCE([v], 0))
