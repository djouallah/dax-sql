// note: the view expander's grid (tools/ossie/grid.mjs), star where many: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.deptno, AGG(f.sum_age) AS v FROM scott_model.pet AS f JOIN scott_model.emp AS o ON f.empno = o.empno WHERE f.pname = 'STEALTH' GROUP BY o.deptno
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('emp'[deptno], "__rows", COUNTROWS(pet), "v", 'pet'[sum_age]), ('pet'[pname] = "STEALTH"), NOT(ISBLANK('emp'[empno]))), "deptno", 'emp'[deptno], "v", [v])
