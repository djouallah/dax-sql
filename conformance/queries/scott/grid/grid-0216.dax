// note: the view expander's grid (tools/ossie/grid.mjs), two metrics: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.empno, AGG(t.sum_age) AS a, AGG(t.pet_count) AS b FROM scott_model.pet AS t GROUP BY t.empno
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('pet'[empno], "__rows", COUNTROWS(pet), "a", 'pet'[sum_age], "b", 'pet'[pet_count]), "empno", 'pet'[empno], "a", [a], "b", COALESCE([b], 0))
