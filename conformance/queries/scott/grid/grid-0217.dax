// note: the view expander's grid (tools/ossie/grid.mjs), two groups: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.loc, t.deptno, AGG(t.dept_count) AS v FROM scott_model.dept AS t GROUP BY t.loc, t.deptno
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('dept'[loc], 'dept'[deptno], "__rows", COUNTROWS('dept'), "v", 'dept'[dept_count]), "loc", 'dept'[loc], "deptno", 'dept'[deptno], "v", COALESCE([v], 0))
