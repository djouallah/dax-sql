// note: the view expander's grid (tools/ossie/grid.mjs), where and: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.dname, AGG(t.dept_count) AS v FROM scott_model.dept AS t WHERE t.dname = 'SALES' AND NOT (t.loc = 'CHICAGO') GROUP BY t.dname
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('dept'[dname], "__rows", COUNTROWS('dept'), "v", 'dept'[dept_count]), ('dept'[dname] = "SALES"), NOT(('dept'[loc] = "CHICAGO"))), "dname", 'dept'[dname], "v", COALESCE([v], 0))
