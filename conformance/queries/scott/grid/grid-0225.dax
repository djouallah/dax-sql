// note: the view expander's grid (tools/ossie/grid.mjs), order by measure: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.dname, AGG(t.dept_count) AS v FROM scott_model.dept AS t GROUP BY t.dname ORDER BY v DESC NULLS LAST, t.dname NULLS FIRST
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('dept'[dname], "__rows", COUNTROWS(dept), "v", 'dept'[dept_count]), "dname", 'dept'[dname], "v", COALESCE([v], 0)) ORDER BY [v] DESC, [dname]
