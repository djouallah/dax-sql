// note: the view expander's grid (tools/ossie/grid.mjs), scalar ops: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.losal, AGG(t.grade_count) * 2 AS a, AGG(t.grade_count) + 1 AS b, COALESCE(AGG(t.grade_count), 0) AS c FROM scott_model.salgrade AS t GROUP BY t.losal
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('salgrade'[losal], "__rows", COUNTROWS('salgrade'), "a", IF(ISBLANK(COUNTROWS('salgrade')), BLANK(), (COALESCE('salgrade'[grade_count], 0) * 2)), "b", IF(ISBLANK(COUNTROWS('salgrade')), BLANK(), (COALESCE('salgrade'[grade_count], 0) + 1)), "c", IF(ISBLANK(COUNTROWS('salgrade')), BLANK(), COALESCE(COALESCE('salgrade'[grade_count], 0), 0))), "losal", 'salgrade'[losal], "a", [a], "b", [b], "c", [c])
