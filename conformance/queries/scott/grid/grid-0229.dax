// note: the view expander's grid (tools/ossie/grid.mjs), ratio: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.empno, CAST(AGG(t.sum_age) AS DOUBLE) / NULLIF(AGG(t.sum_age), 0) AS r FROM scott_model.pet AS t GROUP BY t.empno
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('pet'[empno], "__rows", COUNTROWS(pet), "r", IF(ISBLANK(COUNTROWS(pet)), BLANK(), (CONVERT('pet'[sum_age], DOUBLE) / IF(('pet'[sum_age] == 0), BLANK(), 'pet'[sum_age])))), "empno", 'pet'[empno], "r", [r])
