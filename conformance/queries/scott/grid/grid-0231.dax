// note: the view expander's grid (tools/ossie/grid.mjs), derived table: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT s.dname, s.v FROM (SELECT t.dname, AGG(t.dept_count) AS v FROM scott_model.dept AS t GROUP BY t.dname) AS s WHERE s.v IS NOT NULL
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('dept'[dname], "__rows", COUNTROWS('dept'), "v", 'dept'[dept_count]), "dname", 'dept'[dname], "v", COALESCE([v], 0))
