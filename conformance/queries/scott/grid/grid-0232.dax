// note: the view expander's grid (tools/ossie/grid.mjs), star: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.empno, AGG(f.pet_count) AS v FROM scott_model.pet AS f JOIN scott_model.emp AS o ON f.empno = o.empno GROUP BY o.empno
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('emp'[empno], "__rows", COUNTROWS('pet'), "v", 'pet'[pet_count]), NOT(ISBLANK('emp'[empno]))), "empno", 'emp'[empno], "v", COALESCE([v], 0))
