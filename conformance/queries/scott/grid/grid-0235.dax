// note: the view expander's grid (tools/ossie/grid.mjs), star two sides: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.empno, f.age, AGG(f.sum_age) AS v FROM scott_model.pet AS f JOIN scott_model.emp AS o ON f.empno = o.empno GROUP BY o.empno, f.age
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('emp'[empno], 'pet'[age], "__rows", COUNTROWS('pet'), "v", 'pet'[sum_age]), NOT(ISBLANK('emp'[empno]))), "empno", 'emp'[empno], "age", 'pet'[age], "v", [v])
