// note: the view expander's grid (tools/ossie/grid.mjs), one side counted once: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.job, AGG(f.sum_age) AS a, AGG(o.avg_sal) AS b FROM scott_model.pet AS f JOIN scott_model.emp AS o ON f.empno = o.empno GROUP BY o.job
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('emp'[job], "__rows", COUNTROWS('pet'), "a", 'pet'[sum_age], "b", CALCULATE('emp'[avg_sal], 'pet')), NOT(ISBLANK('emp'[empno]))), "job", 'emp'[job], "a", [a], "b", [b])
