// note: the view expander's grid (tools/ossie/grid.mjs), fan-out: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT f.empno, AGG(o.emp_count) AS v FROM scott_model.pet AS f JOIN scott_model.emp AS o ON f.empno = o.empno GROUP BY f.empno
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('pet'[empno], "__rows", COUNTROWS(pet), "v", CALCULATE('emp'[emp_count], pet)), NOT(ISBLANK('emp'[empno]))), "empno", 'pet'[empno], "v", COALESCE([v], 0))
