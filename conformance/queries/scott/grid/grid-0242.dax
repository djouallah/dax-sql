// note: the view expander's grid (tools/ossie/grid.mjs), two metrics: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.species, AGG(t.pet_count) AS a, AGG(t.pet_count) AS b FROM scott_model.pet AS t GROUP BY t.species
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('pet'[species], "__rows", COUNTROWS(pet), "a", 'pet'[pet_count], "b", 'pet'[pet_count]), "species", 'pet'[species], "a", COALESCE([a], 0), "b", COALESCE([b], 0))
