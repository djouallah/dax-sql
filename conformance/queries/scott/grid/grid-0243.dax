// note: the view expander's grid (tools/ossie/grid.mjs), two groups: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.losal, t.grade, AGG(t.grade_count) AS v FROM scott_model.salgrade AS t GROUP BY t.losal, t.grade
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('salgrade'[losal], 'salgrade'[grade], "__rows", COUNTROWS('salgrade'), "v", 'salgrade'[grade_count]), "losal", 'salgrade'[losal], "grade", 'salgrade'[grade], "v", COALESCE([v], 0))
