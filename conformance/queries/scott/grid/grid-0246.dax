// note: the view expander's grid (tools/ossie/grid.mjs), where or: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.dname, AGG(t.dept_count) AS v FROM scott_model.dept AS t WHERE NOT (t.deptno = 40) OR t.loc = 'DALLAS' GROUP BY t.dname
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('dept'[dname], "__rows", COUNTROWS('dept'), "v", 'dept'[dept_count]), (NOT(('dept'[deptno] = 40)) || ('dept'[loc] = "DALLAS"))), "dname", 'dept'[dname], "v", COALESCE([v], 0))
