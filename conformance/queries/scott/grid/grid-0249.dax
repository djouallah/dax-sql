// note: the view expander's grid (tools/ossie/grid.mjs), having null: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.losal, AGG(t.grade_count) AS v FROM scott_model.salgrade AS t GROUP BY t.losal HAVING AGG(t.grade_count) IS NOT NULL
EVALUATE SELECTCOLUMNS(FILTER(SUMMARIZECOLUMNS('salgrade'[losal], "__rows", COUNTROWS('salgrade'), "v", 'salgrade'[grade_count]), NOT(ISBLANK(COALESCE([v], 0)))), "losal", 'salgrade'[losal], "v", COALESCE([v], 0))
