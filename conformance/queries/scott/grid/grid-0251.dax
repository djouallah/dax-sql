// note: the view expander's grid (tools/ossie/grid.mjs), order by measure: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.losal, AGG(t.grade_count) AS v FROM scott_model.salgrade AS t GROUP BY t.losal ORDER BY v DESC NULLS LAST, t.losal NULLS FIRST
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('salgrade'[losal], "__rows", COUNTROWS(salgrade), "v", 'salgrade'[grade_count]), "losal", 'salgrade'[losal], "v", COALESCE([v], 0)) ORDER BY [v] DESC, [losal]
