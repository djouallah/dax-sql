// note: the view expander's grid (tools/ossie/grid.mjs), ratio: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.species, CAST(AGG(t.pet_count) AS DOUBLE) / NULLIF(AGG(t.sum_age), 0) AS r FROM scott_model.pet AS t GROUP BY t.species
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('pet'[species], "__rows", COUNTROWS('pet'), "r", IF(ISBLANK(COUNTROWS('pet')), BLANK(), (CONVERT(COALESCE('pet'[pet_count], 0), DOUBLE) / IF(('pet'[sum_age] == 0), BLANK(), 'pet'[sum_age])))), "species", 'pet'[species], "r", [r])
