// note: the view expander's grid (tools/ossie/grid.mjs), star where one: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.comm, AGG(f.sum_bonus) AS v FROM scott_model.bonus AS f LEFT JOIN scott_model.emp AS o ON f.ename = o.ename WHERE o.empno IS NOT NULL GROUP BY o.comm
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('emp'[comm], "__rows", COUNTROWS(bonus), "v", 'bonus'[sum_bonus]), NOT(ISBLANK('emp'[empno]))), "comm", 'emp'[comm], "v", [v])
