// note: the view expander's grid (tools/ossie/grid.mjs), star where many: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.comm, AGG(f.bonus_count) AS v FROM scott_model.bonus AS f LEFT JOIN scott_model.emp AS o ON f.ename = o.ename WHERE f.job <> 'PRESIDENT' GROUP BY o.comm
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('emp'[comm], "__rows", COUNTROWS(bonus), "v", 'bonus'[bonus_count]), ('bonus'[job] <> "PRESIDENT")), "comm", 'emp'[comm], "v", COALESCE([v], 0))
