// note: the view expander's grid (tools/ossie/grid.mjs), fan-out: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT f.job, AGG(o.emp_count) AS v FROM scott_model.bonus AS f LEFT JOIN scott_model.emp AS o ON f.ename = o.ename GROUP BY f.job
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('bonus'[job], "__rows", COUNTROWS('bonus'), "v", CALCULATE('emp'[emp_count], 'bonus')), "job", 'bonus'[job], "v", COALESCE([v], 0))
