// note: the view expander's grid (tools/ossie/grid.mjs), two groups: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.hisal, t.grade, AGG(t.grade_count) AS v FROM scott_model.salgrade AS t GROUP BY t.hisal, t.grade
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('salgrade'[hisal], 'salgrade'[grade], "__rows", COUNTROWS(salgrade), "v", 'salgrade'[grade_count]), "hisal", 'salgrade'[hisal], "grade", 'salgrade'[grade], "v", COALESCE([v], 0))
