// note: the view expander's grid (tools/ossie/grid.mjs), where and: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.loc, AGG(t.dept_count) AS v FROM scott_model.dept AS t WHERE t.deptno >= 30 AND NOT (t.dname = 'RESEARCH') GROUP BY t.loc
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('dept'[loc], "__rows", COUNTROWS('dept'), "v", 'dept'[dept_count]), ('dept'[deptno] >= 30), NOT(('dept'[dname] = "RESEARCH"))), "loc", 'dept'[loc], "v", COALESCE([v], 0))
