// note: the view expander's grid (tools/ossie/grid.mjs), where total: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT AGG(t.dept_count) AS v FROM scott_model.dept AS t WHERE t.dname = 'SALES'
EVALUATE SELECTCOLUMNS(CALCULATETABLE(ROW("v", 'dept'[dept_count]), ('dept'[dname] = "SALES")), "v", COALESCE([v], 0))
