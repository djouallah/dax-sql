// note: the view expander's grid (tools/ossie/grid.mjs), having: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.hisal, AGG(t.grade_count) AS v FROM scott_model.salgrade AS t GROUP BY t.hisal HAVING AGG(t.grade_count) > 0
EVALUATE SELECTCOLUMNS(FILTER(SUMMARIZECOLUMNS('salgrade'[hisal], "__rows", COUNTROWS('salgrade'), "v", 'salgrade'[grade_count]), (COALESCE([v], 0) > 0)), "hisal", 'salgrade'[hisal], "v", COALESCE([v], 0))
