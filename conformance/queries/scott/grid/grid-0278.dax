// note: the view expander's grid (tools/ossie/grid.mjs), rollup: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.grade, AGG(t.grade_count) AS v FROM scott_model.salgrade AS t GROUP BY ROLLUP (t.grade) ORDER BY t.grade NULLS LAST
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS(ROLLUPADDISSUBTOTAL('salgrade'[grade], "__level1_grade"), "__rows", COUNTROWS(salgrade), "v", 'salgrade'[grade_count]), "grade", 'salgrade'[grade], "v", COALESCE([v], 0)) ORDER BY ISBLANK([grade]), [grade]
