// note: the view expander's grid (tools/ossie/grid.mjs), star two sides: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.deptno, f.comm, AGG(f.bonus_count) AS v FROM scott_model.bonus AS f LEFT JOIN scott_model.emp AS o ON f.ename = o.ename GROUP BY o.deptno, f.comm
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('emp'[deptno], 'bonus'[comm], "__rows", COUNTROWS('bonus'), "v", 'bonus'[bonus_count]), "deptno", 'emp'[deptno], "comm", 'bonus'[comm], "v", COALESCE([v], 0))
