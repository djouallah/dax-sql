// note: the view expander's grid (tools/ossie/grid.mjs), one side counted once: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.mgr, AGG(f.bonus_count) AS a, AGG(o.avg_sal) AS b FROM scott_model.bonus AS f LEFT JOIN scott_model.emp AS o ON f.ename = o.ename GROUP BY o.mgr
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('emp'[mgr], "__rows", COUNTROWS(bonus), "a", 'bonus'[bonus_count], "b", CALCULATE('emp'[avg_sal], bonus)), "mgr", 'emp'[mgr], "a", COALESCE([a], 0), "b", [b])
