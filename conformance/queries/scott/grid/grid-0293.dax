// note: the view expander's grid (tools/ossie/grid.mjs), two groups: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.grade, t.hisal, AGG(t.grade_count) AS v FROM scott_model.salgrade AS t GROUP BY t.grade, t.hisal
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('salgrade'[grade], 'salgrade'[hisal], "__rows", COUNTROWS('salgrade'), "v", 'salgrade'[grade_count]), "grade", 'salgrade'[grade], "hisal", 'salgrade'[hisal], "v", COALESCE([v], 0))
