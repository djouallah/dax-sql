// note: the view expander's grid (tools/ossie/grid.mjs), order by measure: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.grade, AGG(t.grade_count) AS v FROM scott_model.salgrade AS t GROUP BY t.grade ORDER BY v DESC NULLS LAST, t.grade NULLS FIRST
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('salgrade'[grade], "__rows", COUNTROWS(salgrade), "v", 'salgrade'[grade_count]), "grade", 'salgrade'[grade], "v", COALESCE([v], 0)) ORDER BY [v] DESC, [grade]
