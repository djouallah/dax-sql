// note: the view expander's grid (tools/ossie/grid.mjs), rollup: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.losal, AGG(t.grade_count) AS v FROM scott_model.salgrade AS t GROUP BY ROLLUP (t.losal) ORDER BY t.losal NULLS LAST
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS(ROLLUPADDISSUBTOTAL('salgrade'[losal], "__level1_losal"), "__rows", COUNTROWS('salgrade'), "v", 'salgrade'[grade_count]), "losal", 'salgrade'[losal], "v", COALESCE([v], 0)) ORDER BY ISBLANK([losal]), [losal]
