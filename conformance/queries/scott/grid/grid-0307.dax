// note: the view expander's grid (tools/ossie/grid.mjs), derived table: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT s.grade, s.v FROM (SELECT t.grade, AGG(t.grade_count) AS v FROM scott_model.salgrade AS t GROUP BY t.grade) AS s WHERE s.v IS NOT NULL
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('salgrade'[grade], "__rows", COUNTROWS('salgrade'), "v", 'salgrade'[grade_count]), "grade", 'salgrade'[grade], "v", COALESCE([v], 0))
