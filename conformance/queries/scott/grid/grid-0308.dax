// note: the view expander's grid (tools/ossie/grid.mjs), star: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.mgr, AGG(f.bonus_count) AS v FROM scott_model.bonus AS f LEFT JOIN scott_model.emp AS o ON f.ename = o.ename GROUP BY o.mgr
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('emp'[mgr], "__rows", COUNTROWS('bonus'), "v", 'bonus'[bonus_count]), "mgr", 'emp'[mgr], "v", COALESCE([v], 0))
