// note: the view expander's grid (tools/ossie/grid.mjs), star where one: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.mgr, AGG(f.sum_bonus) AS v FROM scott_model.bonus AS f LEFT JOIN scott_model.emp AS o ON f.ename = o.ename WHERE o.job <> 'ANALYST' GROUP BY o.mgr
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('emp'[mgr], "__rows", COUNTROWS('bonus'), "v", 'bonus'[sum_bonus]), ('emp'[job] <> "ANALYST")), "mgr", 'emp'[mgr], "v", [v])
