// note: the view expander's grid (tools/ossie/grid.mjs), star where many: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.mgr, AGG(f.bonus_count) AS v FROM scott_model.bonus AS f LEFT JOIN scott_model.emp AS o ON f.ename = o.ename WHERE f.sal <> 5000 GROUP BY o.mgr
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('emp'[mgr], "__rows", COUNTROWS(bonus), "v", 'bonus'[bonus_count]), ('bonus'[sal] <> 5000)), "mgr", 'emp'[mgr], "v", COALESCE([v], 0))
