// note: the view expander's grid (tools/ossie/grid.mjs), one side counted once: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.empno, AGG(f.sum_bonus) AS a, AGG(o.comm_count) AS b FROM scott_model.bonus AS f LEFT JOIN scott_model.emp AS o ON f.ename = o.ename GROUP BY o.empno
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('emp'[empno], "__rows", COUNTROWS('bonus'), "a", 'bonus'[sum_bonus], "b", CALCULATE('emp'[comm_count], 'bonus')), "empno", 'emp'[empno], "a", [a], "b", COALESCE([b], 0))
