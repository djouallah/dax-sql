// note: the view expander's grid (tools/ossie/grid.mjs), one to many: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.empno, AGG(o.sum_sal) AS a, AGG(f.sum_bonus) AS b FROM scott_model.emp AS o LEFT JOIN scott_model.bonus AS f ON f.ename = o.ename GROUP BY o.empno
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('emp'[empno], "__rows", COUNTROWS('emp'), "a", 'emp'[sum_sal], "b", CALCULATE('bonus'[sum_bonus], KEEPFILTERS(NOT(ISBLANK('emp'[ename]))))), "empno", 'emp'[empno], "a", [a], "b", [b])
