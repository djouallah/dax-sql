// note: the view expander's grid (tools/ossie/grid.mjs), two groups: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.hisal, t.losal, AGG(t.grade_count) AS v FROM scott_model.salgrade AS t GROUP BY t.hisal, t.losal
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('salgrade'[hisal], 'salgrade'[losal], "__rows", COUNTROWS('salgrade'), "v", 'salgrade'[grade_count]), "hisal", 'salgrade'[hisal], "losal", 'salgrade'[losal], "v", COALESCE([v], 0))
