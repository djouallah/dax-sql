// note: the view expander's grid (tools/ossie/grid.mjs), where or: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.losal, AGG(t.grade_count) AS v FROM scott_model.salgrade AS t WHERE t.losal >= 2001 OR t.losal < 2001 GROUP BY t.losal
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('salgrade'[losal], "__rows", COUNTROWS('salgrade'), "v", 'salgrade'[grade_count]), (('salgrade'[losal] >= 2001) || ('salgrade'[losal] < 2001))), "losal", 'salgrade'[losal], "v", COALESCE([v], 0))
