// note: the view expander's grid (tools/ossie/grid.mjs), order limit: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.empno, AGG(t.sum_age) AS v FROM scott_model.pet AS t GROUP BY t.empno ORDER BY t.empno NULLS FIRST LIMIT 3
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('pet'[empno], "__rows", COUNTROWS(pet), "v", 'pet'[sum_age]), "empno", 'pet'[empno], "v", [v]) ORDER BY [empno]
