// note: the view expander's grid (tools/ossie/grid.mjs), rollup: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.species, AGG(t.pet_count) AS v FROM scott_model.pet AS t GROUP BY ROLLUP (t.species) ORDER BY t.species NULLS LAST
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS(ROLLUPADDISSUBTOTAL('pet'[species], "__level1_species"), "__rows", COUNTROWS('pet'), "v", 'pet'[pet_count]), "species", 'pet'[species], "v", COALESCE([v], 0)) ORDER BY ISBLANK([species]), [species]
