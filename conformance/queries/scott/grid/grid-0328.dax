// note: the view expander's grid (tools/ossie/grid.mjs), scalar ops: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.age, AGG(t.pet_count) * 2 AS a, AGG(t.pet_count) + 1 AS b, COALESCE(AGG(t.pet_count), 0) AS c FROM scott_model.pet AS t GROUP BY t.age
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('pet'[age], "__rows", COUNTROWS(pet), "a", IF(ISBLANK(COUNTROWS(pet)), BLANK(), (COALESCE('pet'[pet_count], 0) * 2)), "b", IF(ISBLANK(COUNTROWS(pet)), BLANK(), (COALESCE('pet'[pet_count], 0) + 1)), "c", IF(ISBLANK(COUNTROWS(pet)), BLANK(), COALESCE(COALESCE('pet'[pet_count], 0), 0))), "age", 'pet'[age], "a", [a], "b", [b], "c", [c])
