// note: the view expander's grid (tools/ossie/grid.mjs), derived table: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT s.empno, s.v FROM (SELECT t.empno, AGG(t.sum_age) AS v FROM scott_model.pet AS t GROUP BY t.empno) AS s WHERE s.v IS NOT NULL
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('pet'[empno], "__rows", COUNTROWS('pet'), "v", 'pet'[sum_age]), "empno", 'pet'[empno], "v", [v])
