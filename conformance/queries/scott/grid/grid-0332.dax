// note: the view expander's grid (tools/ossie/grid.mjs), group: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.species, AGG(t.pet_count) AS v FROM scott_model.pet AS t GROUP BY t.species
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('pet'[species], "__rows", COUNTROWS('pet'), "v", 'pet'[pet_count]), "species", 'pet'[species], "v", COALESCE([v], 0))
