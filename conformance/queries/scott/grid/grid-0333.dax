// note: the view expander's grid (tools/ossie/grid.mjs), two metrics: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.job, AGG(t.bonus_count) AS a, AGG(t.sum_bonus) AS b FROM scott_model.bonus AS t GROUP BY t.job
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('bonus'[job], "__rows", COUNTROWS('bonus'), "a", 'bonus'[bonus_count], "b", 'bonus'[sum_bonus]), "job", 'bonus'[job], "a", COALESCE([a], 0), "b", [b])
