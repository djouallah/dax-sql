// note: the view expander's grid (tools/ossie/grid.mjs), two groups: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.losal, t.hisal, AGG(t.grade_count) AS v FROM scott_model.salgrade AS t GROUP BY t.losal, t.hisal
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('salgrade'[losal], 'salgrade'[hisal], "__rows", COUNTROWS(salgrade), "v", 'salgrade'[grade_count]), "losal", 'salgrade'[losal], "hisal", 'salgrade'[hisal], "v", COALESCE([v], 0))
