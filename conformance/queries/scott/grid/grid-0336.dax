// note: the view expander's grid (tools/ossie/grid.mjs), where and: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.hisal, AGG(t.grade_count) AS v FROM scott_model.salgrade AS t WHERE t.grade < 4 AND NOT (t.grade = 2) GROUP BY t.hisal
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('salgrade'[hisal], "__rows", COUNTROWS('salgrade'), "v", 'salgrade'[grade_count]), ('salgrade'[grade] < 4), NOT(('salgrade'[grade] = 2))), "hisal", 'salgrade'[hisal], "v", COALESCE([v], 0))
