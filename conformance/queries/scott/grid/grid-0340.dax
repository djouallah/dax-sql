// note: the view expander's grid (tools/ossie/grid.mjs), having null: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.age, AGG(t.pet_count) AS v FROM scott_model.pet AS t GROUP BY t.age HAVING AGG(t.pet_count) IS NOT NULL
EVALUATE SELECTCOLUMNS(FILTER(SUMMARIZECOLUMNS('pet'[age], "__rows", COUNTROWS('pet'), "v", 'pet'[pet_count]), NOT(ISBLANK(COALESCE([v], 0)))), "age", 'pet'[age], "v", COALESCE([v], 0))
