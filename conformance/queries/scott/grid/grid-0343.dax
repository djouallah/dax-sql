// note: the view expander's grid (tools/ossie/grid.mjs), group by all: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.species, AGG(t.sum_age) AS v FROM scott_model.pet AS t GROUP BY ALL
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('pet'[species], "__rows", COUNTROWS('pet'), "v", 'pet'[sum_age]), "species", 'pet'[species], "v", [v])
