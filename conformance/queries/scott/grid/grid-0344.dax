// note: the view expander's grid (tools/ossie/grid.mjs), rollup: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.pname, AGG(t.pet_count) AS v FROM scott_model.pet AS t GROUP BY ROLLUP (t.pname) ORDER BY t.pname NULLS LAST
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS(ROLLUPADDISSUBTOTAL('pet'[pname], "__level1_pname"), "__rows", COUNTROWS('pet'), "v", 'pet'[pet_count]), "pname", 'pet'[pname], "v", COALESCE([v], 0)) ORDER BY ISBLANK([pname]), [pname]
