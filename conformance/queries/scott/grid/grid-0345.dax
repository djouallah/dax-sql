// note: the view expander's grid (tools/ossie/grid.mjs), scalar ops: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.species, AGG(t.sum_age) * 2 AS a, AGG(t.sum_age) + 1 AS b, COALESCE(AGG(t.sum_age), 0) AS c FROM scott_model.pet AS t GROUP BY t.species
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('pet'[species], "__rows", COUNTROWS('pet'), "a", ('pet'[sum_age] * 2), "b", ('pet'[sum_age] + 1), "c", IF(ISBLANK(COUNTROWS('pet')), BLANK(), COALESCE('pet'[sum_age], 0))), "species", 'pet'[species], "a", [a], "b", [b], "c", [c])
