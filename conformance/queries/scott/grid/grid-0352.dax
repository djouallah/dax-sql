// note: the view expander's grid (tools/ossie/grid.mjs), where: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.grade, AGG(t.grade_count) AS v FROM scott_model.salgrade AS t WHERE t.hisal = 2000 GROUP BY t.grade
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('salgrade'[grade], "__rows", COUNTROWS(salgrade), "v", 'salgrade'[grade_count]), ('salgrade'[hisal] = 2000)), "grade", 'salgrade'[grade], "v", COALESCE([v], 0))
