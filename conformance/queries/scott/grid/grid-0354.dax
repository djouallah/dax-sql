// note: the view expander's grid (tools/ossie/grid.mjs), where or: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.grade, AGG(t.grade_count) AS v FROM scott_model.salgrade AS t WHERE NOT (t.losal = 1401) OR t.hisal IN (3000, 1200) GROUP BY t.grade
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('salgrade'[grade], "__rows", COUNTROWS(salgrade), "v", 'salgrade'[grade_count]), (NOT(('salgrade'[losal] = 1401)) || ('salgrade'[hisal] IN {3000, 1200}))), "grade", 'salgrade'[grade], "v", COALESCE([v], 0))
