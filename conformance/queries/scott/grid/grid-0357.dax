// note: the view expander's grid (tools/ossie/grid.mjs), having null: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.empno, AGG(t.pet_count) AS v FROM scott_model.pet AS t GROUP BY t.empno HAVING AGG(t.pet_count) IS NOT NULL
EVALUATE SELECTCOLUMNS(FILTER(SUMMARIZECOLUMNS('pet'[empno], "__rows", COUNTROWS('pet'), "v", 'pet'[pet_count]), NOT(ISBLANK(COALESCE([v], 0)))), "empno", 'pet'[empno], "v", COALESCE([v], 0))
