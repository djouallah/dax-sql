// note: the view expander's grid (tools/ossie/grid.mjs), order limit: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.empno, AGG(t.pet_count) AS v FROM scott_model.pet AS t GROUP BY t.empno ORDER BY t.empno NULLS FIRST LIMIT 3
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('pet'[empno], "__rows", COUNTROWS('pet'), "v", 'pet'[pet_count]), "empno", 'pet'[empno], "v", COALESCE([v], 0)) ORDER BY [empno]
