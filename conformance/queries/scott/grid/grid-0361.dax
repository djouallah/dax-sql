// note: the view expander's grid (tools/ossie/grid.mjs), rollup: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.species, AGG(t.sum_age) AS v FROM scott_model.pet AS t GROUP BY ROLLUP (t.species) ORDER BY t.species NULLS LAST
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS(ROLLUPADDISSUBTOTAL('pet'[species], "__level1_species"), "__rows", COUNTROWS('pet'), "v", 'pet'[sum_age]), "species", 'pet'[species], "v", [v]) ORDER BY ISBLANK([species]), [species]
