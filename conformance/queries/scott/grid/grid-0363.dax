// note: the view expander's grid (tools/ossie/grid.mjs), ratio: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.ename, CAST(AGG(t.sum_bonus) AS DOUBLE) / NULLIF(AGG(t.sum_bonus), 0) AS r FROM scott_model.bonus AS t GROUP BY t.ename
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('bonus'[ename], "__rows", COUNTROWS(bonus), "r", IF(ISBLANK(COUNTROWS(bonus)), BLANK(), (CONVERT('bonus'[sum_bonus], DOUBLE) / IF(('bonus'[sum_bonus] == 0), BLANK(), 'bonus'[sum_bonus])))), "ename", 'bonus'[ename], "r", [r])
