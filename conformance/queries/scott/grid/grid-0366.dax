// note: the view expander's grid (tools/ossie/grid.mjs), group: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.comm, AGG(t.bonus_count) AS v FROM scott_model.bonus AS t GROUP BY t.comm
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('bonus'[comm], "__rows", COUNTROWS('bonus'), "v", 'bonus'[bonus_count]), "comm", 'bonus'[comm], "v", COALESCE([v], 0))
