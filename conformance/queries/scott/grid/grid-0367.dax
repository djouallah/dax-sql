// note: the view expander's grid (tools/ossie/grid.mjs), two groups: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.species, t.pname, AGG(t.pet_count) AS v FROM scott_model.pet AS t GROUP BY t.species, t.pname
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('pet'[species], 'pet'[pname], "__rows", COUNTROWS('pet'), "v", 'pet'[pet_count]), "species", 'pet'[species], "pname", 'pet'[pname], "v", COALESCE([v], 0))
