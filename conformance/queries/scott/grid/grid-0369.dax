// note: the view expander's grid (tools/ossie/grid.mjs), where and: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.hisal, AGG(t.grade_count) AS v FROM scott_model.salgrade AS t WHERE t.losal >= 2001 AND t.hisal < 1400 GROUP BY t.hisal
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('salgrade'[hisal], "__rows", COUNTROWS(salgrade), "v", 'salgrade'[grade_count]), ('salgrade'[losal] >= 2001), ('salgrade'[hisal] < 1400)), "hisal", 'salgrade'[hisal], "v", COALESCE([v], 0))
