// note: the view expander's grid (tools/ossie/grid.mjs), where or: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.hisal, AGG(t.grade_count) AS v FROM scott_model.salgrade AS t WHERE t.losal < 1401 OR t.grade IN (3, 1) GROUP BY t.hisal
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('salgrade'[hisal], "__rows", COUNTROWS(salgrade), "v", 'salgrade'[grade_count]), (('salgrade'[losal] < 1401) || ('salgrade'[grade] IN {3, 1}))), "hisal", 'salgrade'[hisal], "v", COALESCE([v], 0))
