// note: the view expander's grid (tools/ossie/grid.mjs), having null: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.age, AGG(t.sum_age) AS v FROM scott_model.pet AS t GROUP BY t.age HAVING AGG(t.sum_age) IS NOT NULL
EVALUATE SELECTCOLUMNS(FILTER(SUMMARIZECOLUMNS('pet'[age], "__rows", COUNTROWS(pet), "v", 'pet'[sum_age]), NOT(ISBLANK([v]))), "age", 'pet'[age], "v", [v])
