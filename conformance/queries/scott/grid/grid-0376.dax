// note: the view expander's grid (tools/ossie/grid.mjs), group by all: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.sal, AGG(t.bonus_count) AS v FROM scott_model.bonus AS t GROUP BY ALL
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('bonus'[sal], "__rows", COUNTROWS('bonus'), "v", 'bonus'[bonus_count]), "sal", 'bonus'[sal], "v", COALESCE([v], 0))
