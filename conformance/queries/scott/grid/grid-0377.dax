// note: the view expander's grid (tools/ossie/grid.mjs), rollup: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.age, AGG(t.sum_age) AS v FROM scott_model.pet AS t GROUP BY ROLLUP (t.age) ORDER BY t.age NULLS LAST
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS(ROLLUPADDISSUBTOTAL('pet'[age], "__level1_age"), "__rows", COUNTROWS(pet), "v", 'pet'[sum_age]), "age", 'pet'[age], "v", [v]) ORDER BY ISBLANK([age]), [age]
