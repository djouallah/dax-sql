// note: the view expander's grid (tools/ossie/grid.mjs), scalar ops: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.sal, AGG(t.sum_bonus) * 2 AS a, AGG(t.sum_bonus) + 1 AS b, COALESCE(AGG(t.sum_bonus), 0) AS c FROM scott_model.bonus AS t GROUP BY t.sal
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('bonus'[sal], "__rows", COUNTROWS(bonus), "a", ('bonus'[sum_bonus] * 2), "b", ('bonus'[sum_bonus] + 1), "c", IF(ISBLANK(COUNTROWS(bonus)), BLANK(), COALESCE('bonus'[sum_bonus], 0))), "sal", 'bonus'[sal], "a", [a], "b", [b], "c", [c])
