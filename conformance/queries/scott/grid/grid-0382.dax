// note: the view expander's grid (tools/ossie/grid.mjs), two groups: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.empno, t.species, AGG(t.sum_age) AS v FROM scott_model.pet AS t GROUP BY t.empno, t.species
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('pet'[empno], 'pet'[species], "__rows", COUNTROWS('pet'), "v", 'pet'[sum_age]), "empno", 'pet'[empno], "species", 'pet'[species], "v", [v])
