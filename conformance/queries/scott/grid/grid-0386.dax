// note: the view expander's grid (tools/ossie/grid.mjs), where total: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT AGG(t.pet_count) AS v FROM scott_model.pet AS t WHERE t.empno >= 7902
EVALUATE SELECTCOLUMNS(CALCULATETABLE(ROW("v", 'pet'[pet_count]), ('pet'[empno] >= 7902)), "v", COALESCE([v], 0))
