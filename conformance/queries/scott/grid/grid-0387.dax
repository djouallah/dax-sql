// note: the view expander's grid (tools/ossie/grid.mjs), having: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.species, AGG(t.sum_age) AS v FROM scott_model.pet AS t GROUP BY t.species HAVING AGG(t.sum_age) > 0
EVALUATE SELECTCOLUMNS(FILTER(SUMMARIZECOLUMNS('pet'[species], "__rows", COUNTROWS('pet'), "v", 'pet'[sum_age]), ([v] > 0)), "species", 'pet'[species], "v", [v])
