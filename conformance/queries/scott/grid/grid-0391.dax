// note: the view expander's grid (tools/ossie/grid.mjs), group by all: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.comm, AGG(t.sum_bonus) AS v FROM scott_model.bonus AS t GROUP BY ALL
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('bonus'[comm], "__rows", COUNTROWS('bonus'), "v", 'bonus'[sum_bonus]), "comm", 'bonus'[comm], "v", [v])
