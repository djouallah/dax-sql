// note: the view expander's grid (tools/ossie/grid.mjs), rollup: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.ename, AGG(t.sum_bonus) AS v FROM scott_model.bonus AS t GROUP BY ROLLUP (t.ename) ORDER BY t.ename NULLS LAST
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS(ROLLUPADDISSUBTOTAL('bonus'[ename], "__level1_ename"), "__rows", COUNTROWS('bonus'), "v", 'bonus'[sum_bonus]), "ename", 'bonus'[ename], "v", [v]) ORDER BY ISBLANK([ename]), [ename]
