// note: the view expander's grid (tools/ossie/grid.mjs), scalar ops: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.sal, AGG(t.bonus_count) * 2 AS a, AGG(t.bonus_count) + 1 AS b, COALESCE(AGG(t.bonus_count), 0) AS c FROM scott_model.bonus AS t GROUP BY t.sal
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('bonus'[sal], "__rows", COUNTROWS('bonus'), "a", IF(ISBLANK(COUNTROWS('bonus')), BLANK(), (COALESCE('bonus'[bonus_count], 0) * 2)), "b", IF(ISBLANK(COUNTROWS('bonus')), BLANK(), (COALESCE('bonus'[bonus_count], 0) + 1)), "c", IF(ISBLANK(COUNTROWS('bonus')), BLANK(), COALESCE(COALESCE('bonus'[bonus_count], 0), 0))), "sal", 'bonus'[sal], "a", [a], "b", [b], "c", [c])
