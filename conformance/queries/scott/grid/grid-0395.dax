// note: the view expander's grid (tools/ossie/grid.mjs), derived table: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT s.sal, s.v FROM (SELECT t.sal, AGG(t.bonus_count) AS v FROM scott_model.bonus AS t GROUP BY t.sal) AS s WHERE s.v IS NOT NULL
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('bonus'[sal], "__rows", COUNTROWS('bonus'), "v", 'bonus'[bonus_count]), "sal", 'bonus'[sal], "v", COALESCE([v], 0))
