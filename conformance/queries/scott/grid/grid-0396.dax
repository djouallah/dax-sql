// note: the view expander's grid (tools/ossie/grid.mjs), group: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.ename, AGG(t.sum_bonus) AS v FROM scott_model.bonus AS t GROUP BY t.ename
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('bonus'[ename], "__rows", COUNTROWS('bonus'), "v", 'bonus'[sum_bonus]), "ename", 'bonus'[ename], "v", [v])
