// note: the view expander's grid (tools/ossie/grid.mjs), two groups: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.sal, t.ename, AGG(t.bonus_count) AS v FROM scott_model.bonus AS t GROUP BY t.sal, t.ename
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('bonus'[sal], 'bonus'[ename], "__rows", COUNTROWS('bonus'), "v", 'bonus'[bonus_count]), "sal", 'bonus'[sal], "ename", 'bonus'[ename], "v", COALESCE([v], 0))
