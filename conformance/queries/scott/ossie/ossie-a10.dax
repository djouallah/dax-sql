// note: Apache Ossie query compliance A10 (a10_cte_passes_measures_through.ost): A CTE passes measures through and restricts their rows. As dax-sql's SQL front end writes its SQL in DAX:
// WITH staff AS ( SELECT deptno, sum_sal AS payroll, emp_count AS headcount FROM scott_model.emp WHERE job IN ('CLERK', 'SALESMAN')) SELECT deptno, AGG(payroll) AS payroll, AGG(headcount) AS headcount FROM staff GROUP BY deptno ORDER BY deptno
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('emp'[deptno], "__rows", COUNTROWS('emp'), "payroll", 'emp'[sum_sal], "headcount", 'emp'[emp_count]), ('emp'[job] IN {"CLERK", "SALESMAN"})), "deptno", 'emp'[deptno], "payroll", [payroll], "headcount", COALESCE([headcount], 0)) ORDER BY [deptno]
