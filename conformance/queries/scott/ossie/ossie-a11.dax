// note: Apache Ossie query compliance A11 (a11_agg_in_where_subquery.ost): AGG() in a scalar subquery in WHERE. As dax-sql's SQL front end writes its SQL in DAX:
// SELECT deptno, AGG(emp_count) AS emp_count FROM scott_model.emp WHERE sal > (SELECT AGG(avg_sal) FROM scott_model.emp) GROUP BY deptno ORDER BY deptno
DEFINE
VAR __v1 = MAXX(SELECTCOLUMNS(ROW("avg_sal", 'emp'[avg_sal]), "avg_sal", [avg_sal]), [avg_sal])
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('emp'[deptno], "__rows", COUNTROWS('emp'), "emp_count", 'emp'[emp_count]), ('emp'[sal] > __v1)), "deptno", 'emp'[deptno], "emp_count", COALESCE([emp_count], 0)) ORDER BY [deptno]
