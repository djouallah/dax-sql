// note: Apache Ossie query compliance A14 (a14_agg_in_correlated_subquery.ost): AGG() in a correlated scalar subquery in WHERE. As dax-sql's SQL front end writes its SQL in DAX:
// SELECT deptno, AGG(emp_count) AS emp_count FROM scott_model.emp AS e WHERE sal > ( SELECT AGG(avg_sal) FROM scott_model.emp AS x WHERE x.deptno = e.deptno) GROUP BY deptno ORDER BY deptno
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('emp'[deptno], "__rows", COUNTROWS('emp'), "emp_count", 'emp'[emp_count]), FILTER(ALL('emp'[sal], 'emp'[deptno]), ('emp'[sal] > (VAR __o1 = 'emp'[deptno] RETURN CALCULATE(MAXX(SELECTCOLUMNS(CALCULATETABLE(ROW("avg_sal", 'emp'[avg_sal]), ('emp'[deptno] = __o1)), "avg_sal", [avg_sal]), [avg_sal]), REMOVEFILTERS()))))), "deptno", 'emp'[deptno], "emp_count", COALESCE([emp_count], 0)) ORDER BY [deptno]
