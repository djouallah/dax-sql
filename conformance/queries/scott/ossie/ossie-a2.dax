// note: Apache Ossie query compliance A2 (a02_measure_per_group.ost): A measure is evaluated for each group. As dax-sql's SQL front end writes its SQL in DAX:
// SELECT deptno, AGG(sum_sal) AS sum_sal, AGG(emp_count) AS emp_count FROM scott_model.emp GROUP BY deptno ORDER BY deptno
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('emp'[deptno], "__rows", COUNTROWS('emp'), "sum_sal", 'emp'[sum_sal], "emp_count", 'emp'[emp_count]), "deptno", 'emp'[deptno], "sum_sal", [sum_sal], "emp_count", COALESCE([emp_count], 0)) ORDER BY [deptno]
