// note: Apache Ossie query compliance A3 (a03_where_before_measure.ost): WHERE removes rows before a measure is evaluated. As dax-sql's SQL front end writes its SQL in DAX:
// SELECT deptno, AGG(sum_sal) AS sum_sal, AGG(emp_count) AS emp_count FROM scott_model.emp WHERE job <> 'CLERK' GROUP BY deptno ORDER BY deptno
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('emp'[deptno], "__rows", COUNTROWS(emp), "sum_sal", 'emp'[sum_sal], "emp_count", 'emp'[emp_count]), ('emp'[job] <> "CLERK")), "deptno", 'emp'[deptno], "sum_sal", [sum_sal], "emp_count", COALESCE([emp_count], 0)) ORDER BY 'emp'[deptno]
