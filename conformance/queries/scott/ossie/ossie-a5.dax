// note: Apache Ossie query compliance A5 (a05_scalar_ops_on_measure_values.ost): Scalar operators apply to the values of AGG(). As dax-sql's SQL front end writes its SQL in DAX:
// SELECT deptno, CAST(AGG(sum_sal) AS DOUBLE) / AGG(emp_count) AS sal_per_emp, AGG(avg_sal) AS avg_sal, AGG(sum_sal) + COALESCE(AGG(sum_comm), 0) AS total_pay FROM scott_model.emp GROUP BY deptno ORDER BY deptno
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('emp'[deptno], "__rows", COUNTROWS('emp'), "sal_per_emp", IF(ISBLANK(COUNTROWS('emp')), BLANK(), (CONVERT('emp'[sum_sal], DOUBLE) / COALESCE('emp'[emp_count], 0))), "avg_sal", 'emp'[avg_sal], "total_pay", IF(ISBLANK(COUNTROWS('emp')), BLANK(), ('emp'[sum_sal] + COALESCE('emp'[sum_comm], 0)))), "deptno", 'emp'[deptno], "sal_per_emp", [sal_per_emp], "avg_sal", [avg_sal], "total_pay", [total_pay]) ORDER BY [deptno]
