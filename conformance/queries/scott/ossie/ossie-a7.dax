// note: Apache Ossie query compliance A7 (a07_empty_input_set.ost): A measure over no rows. As dax-sql's SQL front end writes its SQL in DAX:
// SELECT AGG(emp_count) AS emp_count, AGG(sum_sal) AS sum_sal, AGG(avg_sal) AS avg_sal FROM scott_model.emp WHERE deptno = 40
EVALUATE SELECTCOLUMNS(CALCULATETABLE(ROW("emp_count", 'emp'[emp_count], "sum_sal", 'emp'[sum_sal], "avg_sal", 'emp'[avg_sal]), ('emp'[deptno] = 40)), "emp_count", COALESCE([emp_count], 0), "sum_sal", [sum_sal], "avg_sal", [avg_sal])
