// note: Apache Ossie query compliance A9 (a09_rollup_not_average_of_averages.ost): ROLLUP evaluates a measure again for each grouping set. As dax-sql's SQL front end writes its SQL in DAX:
// SELECT deptno, AGG(emp_count) AS emp_count, AGG(avg_sal) AS avg_sal FROM scott_model.emp GROUP BY ROLLUP (deptno) ORDER BY deptno NULLS LAST
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS(ROLLUPADDISSUBTOTAL('emp'[deptno], "__level1_deptno"), "__rows", COUNTROWS('emp'), "emp_count", 'emp'[emp_count], "avg_sal", 'emp'[avg_sal]), "deptno", 'emp'[deptno], "emp_count", COALESCE([emp_count], 0), "avg_sal", [avg_sal]) ORDER BY ISBLANK([deptno]), [deptno]
