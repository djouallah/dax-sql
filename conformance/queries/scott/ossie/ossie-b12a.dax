// note: Apache Ossie query compliance B12a (b12_full_join_each_row_once.ost): FULL OUTER JOIN. As dax-sql's SQL front end writes its SQL in DAX:
// SELECT AGG(e.emp_count) AS e_count, AGG(e.sum_sal) AS e_sal, AGG(p.pet_count) AS p_count, AGG(p.sum_age) AS p_age FROM scott_model.emp AS e FULL JOIN scott_model.pet AS p ON p.empno = e.empno
DEFINE
VAR __v1 = UNION(GENERATEALL(SELECTCOLUMNS(emp, "e.empno", 'emp'[empno]), FILTER(SELECTCOLUMNS(pet, "p.pname", 'pet'[pname], "p.empno", 'pet'[empno]), ([p.empno] = [e.empno]))), SELECTCOLUMNS(FILTER(SELECTCOLUMNS(pet, "p.pname", 'pet'[pname], "p.empno", 'pet'[empno]), ISEMPTY(FILTER(SELECTCOLUMNS(emp, "e.empno", 'emp'[empno]), ([p.empno] = [e.empno])))), "e.empno", BLANK(), "p.pname", [p.pname], "p.empno", [p.empno]))
VAR __v2 = ROW("__all", 1)
EVALUATE SELECTCOLUMNS(ADDCOLUMNS(__v2, "__m1", COALESCE(CALCULATE('emp'[emp_count], REMOVEFILTERS(), TREATAS(SELECTCOLUMNS(FILTER(__v1, NOT(ISBLANK([e.empno]))), "__k1", [e.empno]), 'emp'[empno])), 0), "__m2", CALCULATE('emp'[sum_sal], REMOVEFILTERS(), TREATAS(SELECTCOLUMNS(FILTER(__v1, NOT(ISBLANK([e.empno]))), "__k1", [e.empno]), 'emp'[empno])), "__m3", COALESCE(CALCULATE('pet'[pet_count], REMOVEFILTERS(), TREATAS(SELECTCOLUMNS(FILTER(__v1, NOT(ISBLANK([p.pname]))), "__k1", [p.pname]), 'pet'[pname])), 0), "__m4", CALCULATE('pet'[sum_age], REMOVEFILTERS(), TREATAS(SELECTCOLUMNS(FILTER(__v1, NOT(ISBLANK([p.pname]))), "__k1", [p.pname]), 'pet'[pname]))), "e_count", [__m1], "e_sal", [__m2], "p_count", [__m3], "p_age", [__m4])
