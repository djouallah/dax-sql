// note: Apache Ossie query compliance B14 (b14_ratio_across_relations.ost): A ratio of measures from two relations. As dax-sql's SQL front end writes its SQL in DAX:
// SELECT AGG(d.dept_count) AS dept_count, AGG(e.emp_count) AS emp_count, AGG(e.sum_sal) AS sum_sal, CAST(AGG(e.sum_sal) AS DOUBLE) / AGG(d.dept_count) AS sal_per_dept FROM scott_model.dept AS d JOIN scott_model.emp AS e ON e.deptno = d.deptno
EVALUATE SELECTCOLUMNS(CALCULATETABLE(ROW("dept_count", CALCULATE('dept'[dept_count], emp), "emp_count", 'emp'[emp_count], "sum_sal", 'emp'[sum_sal], "sal_per_dept", (CONVERT('emp'[sum_sal], DOUBLE) / CALCULATE(COALESCE('dept'[dept_count], 0), emp))), NOT(ISBLANK('dept'[deptno]))), "dept_count", COALESCE([dept_count], 0), "emp_count", COALESCE([emp_count], 0), "sum_sal", [sum_sal], "sal_per_dept", [sal_per_dept])
