// note: Apache Ossie query compliance B15 (b15_left_join_changes_ratio.ost): A LEFT JOIN keeps an empty department, and the ratio changes. As dax-sql's SQL front end writes its SQL in DAX:
// SELECT AGG(d.dept_count) AS dept_count, AGG(e.emp_count) AS emp_count, AGG(e.sum_sal) AS sum_sal, CAST(AGG(e.sum_sal) AS DOUBLE) / AGG(d.dept_count) AS sal_per_dept FROM scott_model.dept AS d LEFT JOIN scott_model.emp AS e ON e.deptno = d.deptno
EVALUATE SELECTCOLUMNS(ROW("dept_count", 'dept'[dept_count], "emp_count", CALCULATE('emp'[emp_count], KEEPFILTERS(NOT(ISBLANK('dept'[deptno])))), "sum_sal", CALCULATE('emp'[sum_sal], KEEPFILTERS(NOT(ISBLANK('dept'[deptno])))), "sal_per_dept", (CONVERT(CALCULATE('emp'[sum_sal], KEEPFILTERS(NOT(ISBLANK('dept'[deptno])))), DOUBLE) / COALESCE('dept'[dept_count], 0))), "dept_count", COALESCE([dept_count], 0), "emp_count", COALESCE([emp_count], 0), "sum_sal", [sum_sal], "sal_per_dept", [sal_per_dept])
