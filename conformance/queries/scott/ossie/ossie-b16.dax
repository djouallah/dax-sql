// note: Apache Ossie query compliance B16 (b16_on_filter_keeps_left_rows.ost): A filter in the ON clause of a LEFT JOIN keeps every left row. As dax-sql's SQL front end writes its SQL in DAX:
// SELECT AGG(d.dept_count) AS dept_count, AGG(e.emp_count) AS emp_count, AGG(e.sum_sal) AS sum_sal, CAST(AGG(e.sum_sal) AS DOUBLE) / AGG(d.dept_count) AS sal_per_dept FROM scott_model.dept AS d LEFT JOIN scott_model.emp AS e ON e.deptno = d.deptno AND e.job = 'CLERK'
EVALUATE SELECTCOLUMNS(ROW("dept_count", 'dept'[dept_count], "emp_count", CALCULATE('emp'[emp_count], KEEPFILTERS(NOT(ISBLANK('dept'[deptno]))), KEEPFILTERS(('emp'[job] = "CLERK"))), "sum_sal", CALCULATE('emp'[sum_sal], KEEPFILTERS(NOT(ISBLANK('dept'[deptno]))), KEEPFILTERS(('emp'[job] = "CLERK"))), "sal_per_dept", (CONVERT(CALCULATE('emp'[sum_sal], KEEPFILTERS(NOT(ISBLANK('dept'[deptno]))), KEEPFILTERS(('emp'[job] = "CLERK"))), DOUBLE) / COALESCE('dept'[dept_count], 0))), "dept_count", COALESCE([dept_count], 0), "emp_count", COALESCE([emp_count], 0), "sum_sal", [sum_sal], "sal_per_dept", [sal_per_dept])
