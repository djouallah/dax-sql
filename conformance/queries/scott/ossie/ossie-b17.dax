// note: Apache Ossie query compliance B17 (b17_left_join_empty_group.ost): LEFT JOIN, grouped: a group with an empty input set. As dax-sql's SQL front end writes its SQL in DAX:
// SELECT d.dname, AGG(e.emp_count) AS emp_count, AGG(e.sum_sal) AS sum_sal, AGG(e.avg_sal) AS avg_sal FROM scott_model.dept AS d LEFT JOIN scott_model.emp AS e ON e.deptno = d.deptno GROUP BY d.dname ORDER BY d.dname
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('dept'[dname], "__rows", COUNTROWS('dept'), "emp_count", CALCULATE('emp'[emp_count], KEEPFILTERS(NOT(ISBLANK('dept'[deptno])))), "sum_sal", CALCULATE('emp'[sum_sal], KEEPFILTERS(NOT(ISBLANK('dept'[deptno])))), "avg_sal", CALCULATE('emp'[avg_sal], KEEPFILTERS(NOT(ISBLANK('dept'[deptno]))))), "dname", 'dept'[dname], "emp_count", COALESCE([emp_count], 0), "sum_sal", [sum_sal], "avg_sal", [avg_sal]) ORDER BY [dname]
