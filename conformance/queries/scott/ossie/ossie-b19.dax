// note: Apache Ossie query compliance B19 (b19_nonunique_filter_no_fan_out.ost): A join to a non-distinct filter relation does not inflate a measure. As dax-sql's SQL front end writes its SQL in DAX:
// SELECT e.job, AGG(e.sum_sal) AS sum_sal FROM scott_model.emp AS e JOIN (SELECT deptno FROM scott_model.emp WHERE job = 'SALESMAN') AS t ON e.deptno = t.deptno GROUP BY e.job ORDER BY e.job
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('emp'[job], "__rows", COUNTROWS(emp), "sum_sal", 'emp'[sum_sal]), TREATAS(SELECTCOLUMNS(SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('emp'[deptno], "__rows", COUNTROWS(emp)), ('emp'[job] = "SALESMAN")), "deptno", 'emp'[deptno]), "deptno", [deptno]), 'emp'[deptno])), "job", 'emp'[job], "sum_sal", [sum_sal]) ORDER BY 'emp'[job]
