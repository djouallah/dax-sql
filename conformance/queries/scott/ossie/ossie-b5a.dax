// note: Apache Ossie query compliance B5a (b05_manager_counted_once.ost): Fan-out: the owners' salary, by species of pet. As dax-sql's SQL front end writes its SQL in DAX:
// SELECT p.species, AGG(e.emp_count) AS owners, AGG(e.sum_sal) AS owners_sal, AGG(p.pet_count) AS pets, AGG(p.sum_age) AS sum_age FROM scott_model.emp AS e JOIN scott_model.pet AS p ON p.empno = e.empno GROUP BY p.species ORDER BY p.species
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('pet'[species], "__rows", COUNTROWS('pet'), "owners", CALCULATE('emp'[emp_count], 'pet'), "owners_sal", CALCULATE('emp'[sum_sal], 'pet'), "pets", 'pet'[pet_count], "sum_age", 'pet'[sum_age]), NOT(ISBLANK('emp'[empno]))), "species", 'pet'[species], "owners", COALESCE([owners], 0), "owners_sal", [owners_sal], "pets", COALESCE([pets], 0), "sum_age", [sum_age]) ORDER BY [species]
