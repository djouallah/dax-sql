// note: Apache Ossie query compliance B6 (b06_range_join_fan_out.ost): Fan-out through a range join. As dax-sql's SQL front end writes its SQL in DAX:
// SELECT e.deptno, AGG(e.emp_count) AS emp_count, AGG(s.grade_count) AS grade_count FROM scott_model.emp AS e JOIN scott_model.salgrade AS s ON e.sal BETWEEN s.losal AND s.hisal GROUP BY e.deptno ORDER BY e.deptno
DEFINE
VAR __v1 = GENERATE(SELECTCOLUMNS('emp', "e.empno", 'emp'[empno], "e.deptno", 'emp'[deptno], "e.sal", 'emp'[sal]), FILTER(SELECTCOLUMNS('salgrade', "s.grade", 'salgrade'[grade], "s.losal", 'salgrade'[losal], "s.hisal", 'salgrade'[hisal]), (([e.sal] >= [s.losal]) && ([e.sal] <= [s.hisal]))))
VAR __v2 = DISTINCT(SELECTCOLUMNS(__v1, "deptno", [e.deptno]))
EVALUATE SELECTCOLUMNS(ADDCOLUMNS(__v2, "__m1", COALESCE(CALCULATE('emp'[emp_count], REMOVEFILTERS(), TREATAS(SELECTCOLUMNS(FILTER(__v1, (NOT(ISBLANK([e.empno])) && ([e.deptno] == [deptno]))), "__k1", [e.empno]), 'emp'[empno])), 0), "__m2", COALESCE(CALCULATE('salgrade'[grade_count], REMOVEFILTERS(), TREATAS(SELECTCOLUMNS(FILTER(__v1, (NOT(ISBLANK([s.grade])) && ([e.deptno] == [deptno]))), "__k1", [s.grade]), 'salgrade'[grade])), 0)), "deptno", [deptno], "emp_count", [__m1], "grade_count", [__m2]) ORDER BY [deptno]
