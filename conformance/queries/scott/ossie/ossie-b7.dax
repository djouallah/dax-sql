// note: Apache Ossie query compliance B7 (b07_three_way_join_fan_out.ost): Fan-out in a three-way join. As dax-sql's SQL front end writes its SQL in DAX:
// SELECT s.grade, AGG(e.emp_count) AS emp_count, AGG(e.sum_sal) AS sum_sal, AGG(d.dept_count) AS dept_count FROM scott_model.emp AS e JOIN scott_model.dept AS d ON e.deptno = d.deptno JOIN scott_model.salgrade AS s ON e.sal BETWEEN s.losal AND s.hisal GROUP BY s.grade ORDER BY s.grade
DEFINE
VAR __v1 = GENERATE(GENERATE(SELECTCOLUMNS(emp, "e.empno", 'emp'[empno], "e.deptno", 'emp'[deptno], "e.sal", 'emp'[sal]), FILTER(SELECTCOLUMNS(dept, "d.deptno", 'dept'[deptno]), ([e.deptno] = [d.deptno]))), FILTER(SELECTCOLUMNS(salgrade, "s.grade", 'salgrade'[grade], "s.losal", 'salgrade'[losal], "s.hisal", 'salgrade'[hisal]), (([e.sal] >= [s.losal]) && ([e.sal] <= [s.hisal]))))
VAR __v2 = DISTINCT(SELECTCOLUMNS(__v1, "grade", [s.grade]))
EVALUATE SELECTCOLUMNS(ADDCOLUMNS(__v2, "__m1", COALESCE(CALCULATE('emp'[emp_count], REMOVEFILTERS(), TREATAS(SELECTCOLUMNS(FILTER(__v1, (NOT(ISBLANK([e.empno])) && ([s.grade] == [grade]))), "__k1", [e.empno]), 'emp'[empno])), 0), "__m2", CALCULATE('emp'[sum_sal], REMOVEFILTERS(), TREATAS(SELECTCOLUMNS(FILTER(__v1, (NOT(ISBLANK([e.empno])) && ([s.grade] == [grade]))), "__k1", [e.empno]), 'emp'[empno])), "__m3", COALESCE(CALCULATE('dept'[dept_count], REMOVEFILTERS(), TREATAS(SELECTCOLUMNS(FILTER(__v1, (NOT(ISBLANK([d.deptno])) && ([s.grade] == [grade]))), "__k1", [d.deptno]), 'dept'[deptno])), 0)), "grade", [grade], "emp_count", [__m1], "sum_sal", [__m2], "dept_count", [__m3]) ORDER BY [grade]
