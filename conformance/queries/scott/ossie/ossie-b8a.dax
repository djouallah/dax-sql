// note: Apache Ossie query compliance B8a (b08_many_to_many_chasm_trap.ost): Many-to-many join: employees and their manager's pets. As dax-sql's SQL front end writes its SQL in DAX:
// SELECT p.species, AGG(e.emp_count) AS reports, AGG(e.sum_sal) AS reports_sal, AGG(p.pet_count) AS pets, AGG(p.sum_age) AS sum_age FROM scott_model.emp AS e JOIN scott_model.pet AS p ON p.empno = e.mgr GROUP BY p.species ORDER BY p.species
DEFINE
VAR __v1 = GENERATE(SELECTCOLUMNS(emp, "e.empno", 'emp'[empno], "e.mgr", 'emp'[mgr]), FILTER(SELECTCOLUMNS(pet, "p.pname", 'pet'[pname], "p.species", 'pet'[species], "p.empno", 'pet'[empno]), ([p.empno] = [e.mgr])))
VAR __v2 = DISTINCT(SELECTCOLUMNS(__v1, "species", [p.species]))
EVALUATE SELECTCOLUMNS(ADDCOLUMNS(__v2, "__m1", COALESCE(CALCULATE('emp'[emp_count], REMOVEFILTERS(), TREATAS(SELECTCOLUMNS(FILTER(__v1, (NOT(ISBLANK([e.empno])) && ([p.species] == [species]))), "__k1", [e.empno]), 'emp'[empno])), 0), "__m2", CALCULATE('emp'[sum_sal], REMOVEFILTERS(), TREATAS(SELECTCOLUMNS(FILTER(__v1, (NOT(ISBLANK([e.empno])) && ([p.species] == [species]))), "__k1", [e.empno]), 'emp'[empno])), "__m3", COALESCE(CALCULATE('pet'[pet_count], REMOVEFILTERS(), TREATAS(SELECTCOLUMNS(FILTER(__v1, (NOT(ISBLANK([p.pname])) && ([p.species] == [species]))), "__k1", [p.pname]), 'pet'[pname])), 0), "__m4", CALCULATE('pet'[sum_age], REMOVEFILTERS(), TREATAS(SELECTCOLUMNS(FILTER(__v1, (NOT(ISBLANK([p.pname])) && ([p.species] == [species]))), "__k1", [p.pname]), 'pet'[pname]))), "species", [species], "reports", [__m1], "reports_sal", [__m2], "pets", [__m3], "sum_age", [__m4]) ORDER BY [species]
