// note: Apache Ossie query compliance B8b (b08_many_to_many_chasm_trap.ost): Chasm trap: bonus and pet both join to emp. As dax-sql's SQL front end writes its SQL in DAX:
// SELECT e.ename, AGG(e.sum_sal) AS sal, AGG(b.bonus_count) AS bonuses, AGG(b.sum_bonus) AS bonus, AGG(p.pet_count) AS pets FROM scott_model.bonus AS b JOIN scott_model.emp AS e ON b.ename = e.ename LEFT JOIN scott_model.pet AS p ON p.empno = e.empno GROUP BY e.ename ORDER BY e.ename
DEFINE
VAR __v1 = GENERATEALL(GENERATE(SELECTCOLUMNS(bonus, "b.ename", 'bonus'[ename], "b.job", 'bonus'[job], "b.sal", 'bonus'[sal], "b.comm", 'bonus'[comm]), FILTER(SELECTCOLUMNS(emp, "e.empno", 'emp'[empno], "e.ename", 'emp'[ename]), ([b.ename] = [e.ename]))), FILTER(SELECTCOLUMNS(pet, "p.pname", 'pet'[pname], "p.empno", 'pet'[empno]), ([p.empno] = [e.empno])))
VAR __v2 = DISTINCT(SELECTCOLUMNS(__v1, "ename", [e.ename]))
EVALUATE SELECTCOLUMNS(ADDCOLUMNS(__v2, "__m1", CALCULATE('emp'[sum_sal], REMOVEFILTERS(), TREATAS(SELECTCOLUMNS(FILTER(__v1, (NOT(ISBLANK([e.empno])) && ([e.ename] == [ename]))), "__k1", [e.empno]), 'emp'[empno])), "__m2", COALESCE(CALCULATE('bonus'[bonus_count], REMOVEFILTERS(), TREATAS(SELECTCOLUMNS(FILTER(__v1, (NOT((((ISBLANK([b.ename]) && ISBLANK([b.job])) && ISBLANK([b.sal])) && ISBLANK([b.comm]))) && ([e.ename] == [ename]))), "__k1", [b.ename], "__k2", [b.job], "__k3", [b.sal], "__k4", [b.comm]), 'bonus'[ename], 'bonus'[job], 'bonus'[sal], 'bonus'[comm])), 0), "__m3", CALCULATE('bonus'[sum_bonus], REMOVEFILTERS(), TREATAS(SELECTCOLUMNS(FILTER(__v1, (NOT((((ISBLANK([b.ename]) && ISBLANK([b.job])) && ISBLANK([b.sal])) && ISBLANK([b.comm]))) && ([e.ename] == [ename]))), "__k1", [b.ename], "__k2", [b.job], "__k3", [b.sal], "__k4", [b.comm]), 'bonus'[ename], 'bonus'[job], 'bonus'[sal], 'bonus'[comm])), "__m4", COALESCE(CALCULATE('pet'[pet_count], REMOVEFILTERS(), TREATAS(SELECTCOLUMNS(FILTER(__v1, (NOT(ISBLANK([p.pname])) && ([e.ename] == [ename]))), "__k1", [p.pname]), 'pet'[pname])), 0)), "ename", [ename], "sal", [__m1], "bonuses", [__m2], "bonus", [__m3], "pets", [__m4]) ORDER BY [ename]
