// note: Apache Ossie query compliance B9 (b09_inner_join_matched_rows.ost): INNER JOIN: each side keeps only its matched rows. As dax-sql's SQL front end writes its SQL in DAX:
// SELECT AGG(e.emp_count) AS e_count, AGG(e.sum_sal) AS e_sal, AGG(m.emp_count) AS m_count, AGG(m.sum_sal) AS m_sal FROM scott_model.emp AS e JOIN scott_model.emp AS m ON e.mgr = m.empno
DEFINE
VAR __v1 = GENERATE(SELECTCOLUMNS('emp', "e.empno", 'emp'[empno], "e.mgr", 'emp'[mgr]), FILTER(SELECTCOLUMNS('emp', "m.empno", 'emp'[empno]), ([e.mgr] = [m.empno])))
VAR __v2 = ROW("__all", 1)
EVALUATE SELECTCOLUMNS(ADDCOLUMNS(__v2, "__m1", COALESCE(CALCULATE('emp'[emp_count], REMOVEFILTERS(), TREATAS(SELECTCOLUMNS(FILTER(__v1, NOT(ISBLANK([e.empno]))), "__k1", [e.empno]), 'emp'[empno])), 0), "__m2", CALCULATE('emp'[sum_sal], REMOVEFILTERS(), TREATAS(SELECTCOLUMNS(FILTER(__v1, NOT(ISBLANK([e.empno]))), "__k1", [e.empno]), 'emp'[empno])), "__m3", COALESCE(CALCULATE('emp'[emp_count], REMOVEFILTERS(), TREATAS(SELECTCOLUMNS(FILTER(__v1, NOT(ISBLANK([m.empno]))), "__k1", [m.empno]), 'emp'[empno])), 0), "__m4", CALCULATE('emp'[sum_sal], REMOVEFILTERS(), TREATAS(SELECTCOLUMNS(FILTER(__v1, NOT(ISBLANK([m.empno]))), "__k1", [m.empno]), 'emp'[empno]))), "e_count", [__m1], "e_sal", [__m2], "m_count", [__m3], "m_sal", [__m4])
