// note: the view expander's grid (tools/ossie/grid.mjs), having null: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.customer_id, AGG(t.customer_count) AS v FROM stores_model.customers AS t GROUP BY t.customer_id HAVING AGG(t.customer_count) IS NOT NULL
EVALUATE SELECTCOLUMNS(FILTER(SUMMARIZECOLUMNS('customers'[customer_id], "__rows", COUNTROWS(customers), "v", 'customers'[customer_count]), NOT(ISBLANK(COALESCE([v], 0)))), "customer_id", 'customers'[customer_id], "v", COALESCE([v], 0))
