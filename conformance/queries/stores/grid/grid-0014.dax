// note: the view expander's grid (tools/ossie/grid.mjs), cte: its SQL as dax-sql's SQL front end writes it in DAX:
// WITH s AS (SELECT customer_id, customer_count AS mm FROM stores_model.customers WHERE NOT (customer_id = 'C3')) SELECT customer_id, AGG(mm) AS v FROM s GROUP BY customer_id
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('customers'[customer_id], "__rows", COUNTROWS(customers), "v", 'customers'[customer_count]), NOT(('customers'[customer_id] = "C3"))), "customer_id", 'customers'[customer_id], "v", COALESCE([v], 0))
