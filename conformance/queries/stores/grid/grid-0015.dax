// note: the view expander's grid (tools/ossie/grid.mjs), derived table: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT s.customer_id, s.v FROM (SELECT t.customer_id, AGG(t.customer_count) AS v FROM stores_model.customers AS t GROUP BY t.customer_id) AS s WHERE s.v IS NOT NULL
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('customers'[customer_id], "__rows", COUNTROWS('customers'), "v", 'customers'[customer_count]), "customer_id", 'customers'[customer_id], "v", COALESCE([v], 0))
