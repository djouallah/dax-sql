// note: the view expander's grid (tools/ossie/grid.mjs), where: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.customer_id, AGG(t.customer_count) AS v FROM stores_model.customers AS t WHERE t.region IS NULL GROUP BY t.customer_id
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('customers'[customer_id], "__rows", COUNTROWS(customers), "v", 'customers'[customer_count]), ISBLANK('customers'[region])), "customer_id", 'customers'[customer_id], "v", COALESCE([v], 0))
