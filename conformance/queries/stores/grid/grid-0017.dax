// note: the view expander's grid (tools/ossie/grid.mjs), where and: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.customer_id, AGG(t.customer_count) AS v FROM stores_model.customers AS t WHERE t.customer_id IN ('C2', 'C3') AND t.customer_id = 'C1' GROUP BY t.customer_id
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('customers'[customer_id], "__rows", COUNTROWS(customers), "v", 'customers'[customer_count]), ('customers'[customer_id] IN {"C2", "C3"}), ('customers'[customer_id] = "C1")), "customer_id", 'customers'[customer_id], "v", COALESCE([v], 0))
