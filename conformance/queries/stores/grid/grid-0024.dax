// note: the view expander's grid (tools/ossie/grid.mjs), where or: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.region, AGG(t.customer_count) AS v FROM stores_model.customers AS t WHERE t.region IN ('EAST', 'WEST') OR t.region IS NOT NULL GROUP BY t.region
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('customers'[region], "__rows", COUNTROWS('customers'), "v", 'customers'[customer_count]), (('customers'[region] IN {"EAST", "WEST"}) || NOT(ISBLANK('customers'[region])))), "region", 'customers'[region], "v", COALESCE([v], 0))
