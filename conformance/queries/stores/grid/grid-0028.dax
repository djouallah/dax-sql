// note: the view expander's grid (tools/ossie/grid.mjs), order by measure: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.region, AGG(t.customer_count) AS v FROM stores_model.customers AS t GROUP BY t.region ORDER BY v DESC NULLS LAST, t.region NULLS FIRST
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('customers'[region], "__rows", COUNTROWS(customers), "v", 'customers'[customer_count]), "region", 'customers'[region], "v", COALESCE([v], 0)) ORDER BY [v] DESC, [region]
