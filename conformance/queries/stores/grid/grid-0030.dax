// note: the view expander's grid (tools/ossie/grid.mjs), scalar ops: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.region, AGG(t.customer_count) * 2 AS a, AGG(t.customer_count) + 1 AS b, COALESCE(AGG(t.customer_count), 0) AS c FROM stores_model.customers AS t GROUP BY t.region
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('customers'[region], "__rows", COUNTROWS('customers'), "a", IF(ISBLANK(COUNTROWS('customers')), BLANK(), (COALESCE('customers'[customer_count], 0) * 2)), "b", IF(ISBLANK(COUNTROWS('customers')), BLANK(), (COALESCE('customers'[customer_count], 0) + 1)), "c", IF(ISBLANK(COUNTROWS('customers')), BLANK(), COALESCE(COALESCE('customers'[customer_count], 0), 0))), "region", 'customers'[region], "a", [a], "b", [b], "c", [c])
