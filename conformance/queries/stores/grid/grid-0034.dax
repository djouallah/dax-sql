// note: the view expander's grid (tools/ossie/grid.mjs), where and: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.region, AGG(t.customer_count) AS v FROM stores_model.customers AS t WHERE t.region IS NOT NULL AND t.region IN ('WEST', 'EAST') GROUP BY t.region
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('customers'[region], "__rows", COUNTROWS(customers), "v", 'customers'[customer_count]), NOT(ISBLANK('customers'[region])), ('customers'[region] IN {"WEST", "EAST"})), "region", 'customers'[region], "v", COALESCE([v], 0))
