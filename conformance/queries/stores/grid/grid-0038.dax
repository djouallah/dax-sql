// note: the view expander's grid (tools/ossie/grid.mjs), where: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.region, AGG(t.customer_count) AS v FROM stores_model.customers AS t WHERE t.customer_id IS NOT NULL GROUP BY t.region
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('customers'[region], "__rows", COUNTROWS(customers), "v", 'customers'[customer_count]), NOT(ISBLANK('customers'[customer_id]))), "region", 'customers'[region], "v", COALESCE([v], 0))
