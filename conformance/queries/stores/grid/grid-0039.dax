// note: the view expander's grid (tools/ossie/grid.mjs), where and: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.region, AGG(t.customer_count) AS v FROM stores_model.customers AS t WHERE t.region = 'EAST' AND t.customer_id = 'C2' GROUP BY t.region
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('customers'[region], "__rows", COUNTROWS(customers), "v", 'customers'[customer_count]), ('customers'[region] = "EAST"), ('customers'[customer_id] = "C2")), "region", 'customers'[region], "v", COALESCE([v], 0))
