// note: the view expander's grid (tools/ossie/grid.mjs), where or: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.region, AGG(t.customer_count) AS v FROM stores_model.customers AS t WHERE t.customer_id IN ('C1', 'C2') OR t.region = 'EAST' GROUP BY t.region
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('customers'[region], "__rows", COUNTROWS('customers'), "v", 'customers'[customer_count]), (('customers'[customer_id] IN {"C1", "C2"}) || ('customers'[region] = "EAST"))), "region", 'customers'[region], "v", COALESCE([v], 0))
