// note: the view expander's grid (tools/ossie/grid.mjs), cte: its SQL as dax-sql's SQL front end writes it in DAX:
// WITH s AS (SELECT region, customer_count AS mm FROM stores_model.customers WHERE customer_id IS NOT NULL) SELECT region, AGG(mm) AS v FROM s GROUP BY region
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('customers'[region], "__rows", COUNTROWS(customers), "v", 'customers'[customer_count]), NOT(ISBLANK('customers'[customer_id]))), "region", 'customers'[region], "v", COALESCE([v], 0))
