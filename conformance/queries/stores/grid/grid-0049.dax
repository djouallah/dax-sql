// note: the view expander's grid (tools/ossie/grid.mjs), two groups: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.sale_date_id, t.customer_id, AGG(t.total_sales) AS v FROM stores_model.store_sales AS t GROUP BY t.sale_date_id, t.customer_id
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('store_sales'[sale_date_id], 'store_sales'[customer_id], "__rows", COUNTROWS(store_sales), "v", 'store_sales'[total_sales]), "sale_date_id", 'store_sales'[sale_date_id], "customer_id", 'store_sales'[customer_id], "v", [v])
