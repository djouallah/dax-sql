// note: the view expander's grid (tools/ossie/grid.mjs), rollup: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.item_id, AGG(t.total_sales) AS v FROM stores_model.store_sales AS t GROUP BY ROLLUP (t.item_id) ORDER BY t.item_id NULLS LAST
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS(ROLLUPADDISSUBTOTAL('store_sales'[item_id], "__level1_item_id"), "__rows", COUNTROWS('store_sales'), "v", 'store_sales'[total_sales]), "item_id", 'store_sales'[item_id], "v", [v]) ORDER BY ISBLANK([item_id]), [item_id]
