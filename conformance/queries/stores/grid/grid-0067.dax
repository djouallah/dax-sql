// note: the view expander's grid (tools/ossie/grid.mjs), where or: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.customer_id, AGG(t.total_sales) AS v FROM stores_model.store_sales AS t WHERE t.sale_date_id IN ('D2024a', 'D2023') OR t.store_id IS NOT NULL GROUP BY t.customer_id
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('store_sales'[customer_id], "__rows", COUNTROWS('store_sales'), "v", 'store_sales'[total_sales]), (('store_sales'[sale_date_id] IN {"D2024a", "D2023"}) || NOT(ISBLANK('store_sales'[store_id])))), "customer_id", 'store_sales'[customer_id], "v", [v])
