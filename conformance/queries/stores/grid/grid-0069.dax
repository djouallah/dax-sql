// note: the view expander's grid (tools/ossie/grid.mjs), having: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.customer_id, AGG(t.total_sales) AS v FROM stores_model.store_sales AS t GROUP BY t.customer_id HAVING AGG(t.total_sales) > 0
EVALUATE SELECTCOLUMNS(FILTER(SUMMARIZECOLUMNS('store_sales'[customer_id], "__rows", COUNTROWS('store_sales'), "v", 'store_sales'[total_sales]), ([v] > 0)), "customer_id", 'store_sales'[customer_id], "v", [v])
