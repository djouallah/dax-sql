// note: the view expander's grid (tools/ossie/grid.mjs), rollup: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.sale_date_id, AGG(t.total_sales) AS v FROM stores_model.store_sales AS t GROUP BY ROLLUP (t.sale_date_id) ORDER BY t.sale_date_id NULLS LAST
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS(ROLLUPADDISSUBTOTAL('store_sales'[sale_date_id], "__level1_sale_date_id"), "__rows", COUNTROWS('store_sales'), "v", 'store_sales'[total_sales]), "sale_date_id", 'store_sales'[sale_date_id], "v", [v]) ORDER BY ISBLANK([sale_date_id]), [sale_date_id]
