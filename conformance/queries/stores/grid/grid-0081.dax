// note: the view expander's grid (tools/ossie/grid.mjs), where or: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.customer_id, AGG(t.total_sales) AS v FROM stores_model.store_sales AS t WHERE NOT (t.customer_id = 'C3') OR t.customer_id IS NOT NULL GROUP BY t.customer_id
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('store_sales'[customer_id], "__rows", COUNTROWS(store_sales), "v", 'store_sales'[total_sales]), (NOT(('store_sales'[customer_id] = "C3")) || NOT(ISBLANK('store_sales'[customer_id])))), "customer_id", 'store_sales'[customer_id], "v", [v])
