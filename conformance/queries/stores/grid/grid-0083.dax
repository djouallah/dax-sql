// note: the view expander's grid (tools/ossie/grid.mjs), rollup: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.store_id, AGG(t.total_sales) AS v FROM stores_model.store_sales AS t GROUP BY ROLLUP (t.store_id) ORDER BY t.store_id NULLS LAST
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS(ROLLUPADDISSUBTOTAL('store_sales'[store_id], "__level1_store_id"), "__rows", COUNTROWS('store_sales'), "v", 'store_sales'[total_sales]), "store_id", 'store_sales'[store_id], "v", [v]) ORDER BY ISBLANK([store_id]), [store_id]
