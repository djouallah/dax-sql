// note: the view expander's grid (tools/ossie/grid.mjs), two groups: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.customer_id, t.sales_amount, AGG(t.total_sales) AS v FROM stores_model.store_sales AS t GROUP BY t.customer_id, t.sales_amount
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('store_sales'[customer_id], 'store_sales'[sales_amount], "__rows", COUNTROWS(store_sales), "v", 'store_sales'[total_sales]), "customer_id", 'store_sales'[customer_id], "sales_amount", 'store_sales'[sales_amount], "v", [v])
