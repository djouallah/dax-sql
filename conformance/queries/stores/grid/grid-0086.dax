// note: the view expander's grid (tools/ossie/grid.mjs), where: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.customer_id, AGG(t.total_sales) AS v FROM stores_model.store_sales AS t WHERE t.item_id IN ('I1', 'I1') GROUP BY t.customer_id
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('store_sales'[customer_id], "__rows", COUNTROWS(store_sales), "v", 'store_sales'[total_sales]), ('store_sales'[item_id] IN {"I1", "I1"})), "customer_id", 'store_sales'[customer_id], "v", [v])
