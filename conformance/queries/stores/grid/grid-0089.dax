// note: the view expander's grid (tools/ossie/grid.mjs), where total: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT AGG(t.total_sales) AS v FROM stores_model.store_sales AS t WHERE t.sales_amount IN (25, 200)
EVALUATE SELECTCOLUMNS(CALCULATETABLE(ROW("v", 'store_sales'[total_sales]), ('store_sales'[sales_amount] IN {25, 200})), "v", [v])
