// note: the view expander's grid (tools/ossie/grid.mjs), cte: its SQL as dax-sql's SQL front end writes it in DAX:
// WITH s AS (SELECT customer_id, total_sales AS mm FROM stores_model.store_sales WHERE NOT (sale_date_id = 'D2024a')) SELECT customer_id, AGG(mm) AS v FROM s GROUP BY customer_id
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('store_sales'[customer_id], "__rows", COUNTROWS('store_sales'), "v", 'store_sales'[total_sales]), NOT(('store_sales'[sale_date_id] = "D2024a"))), "customer_id", 'store_sales'[customer_id], "v", [v])
