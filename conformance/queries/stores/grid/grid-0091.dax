// note: the view expander's grid (tools/ossie/grid.mjs), two groups: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.sale_date_id, t.item_id, AGG(t.total_sales) AS v FROM stores_model.store_sales AS t GROUP BY t.sale_date_id, t.item_id
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('store_sales'[sale_date_id], 'store_sales'[item_id], "__rows", COUNTROWS('store_sales'), "v", 'store_sales'[total_sales]), "sale_date_id", 'store_sales'[sale_date_id], "item_id", 'store_sales'[item_id], "v", [v])
