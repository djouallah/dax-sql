// note: the view expander's grid (tools/ossie/grid.mjs), where or: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.sale_date_id, AGG(t.total_sales) AS v FROM stores_model.store_sales AS t WHERE NOT (t.sale_id = 'SS5') OR t.sale_date_id IS NOT NULL GROUP BY t.sale_date_id
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('store_sales'[sale_date_id], "__rows", COUNTROWS('store_sales'), "v", 'store_sales'[total_sales]), (NOT(('store_sales'[sale_id] = "SS5")) || NOT(ISBLANK('store_sales'[sale_date_id])))), "sale_date_id", 'store_sales'[sale_date_id], "v", [v])
