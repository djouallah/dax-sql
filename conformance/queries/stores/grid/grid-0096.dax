// note: the view expander's grid (tools/ossie/grid.mjs), cte: its SQL as dax-sql's SQL front end writes it in DAX:
// WITH s AS (SELECT sale_date_id, total_sales AS mm FROM stores_model.store_sales WHERE NOT (item_id = 'I2')) SELECT sale_date_id, AGG(mm) AS v FROM s GROUP BY sale_date_id
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('store_sales'[sale_date_id], "__rows", COUNTROWS('store_sales'), "v", 'store_sales'[total_sales]), NOT(('store_sales'[item_id] = "I2"))), "sale_date_id", 'store_sales'[sale_date_id], "v", [v])
