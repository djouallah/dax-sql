// note: the view expander's grid (tools/ossie/grid.mjs), where and: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.item_id, AGG(t.total_sales) AS v FROM stores_model.store_sales AS t WHERE t.customer_id = 'C3' AND t.sales_amount IN (50, 25) GROUP BY t.item_id
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('store_sales'[item_id], "__rows", COUNTROWS('store_sales'), "v", 'store_sales'[total_sales]), ('store_sales'[customer_id] = "C3"), ('store_sales'[sales_amount] IN {50, 25})), "item_id", 'store_sales'[item_id], "v", [v])
