// note: the view expander's grid (tools/ossie/grid.mjs), where or: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.item_id, AGG(t.total_sales) AS v FROM stores_model.store_sales AS t WHERE t.sale_id IN ('SS4', 'SS5') OR t.sales_amount >= 50 GROUP BY t.item_id
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('store_sales'[item_id], "__rows", COUNTROWS('store_sales'), "v", 'store_sales'[total_sales]), (('store_sales'[sale_id] IN {"SS4", "SS5"}) || ('store_sales'[sales_amount] >= 50))), "item_id", 'store_sales'[item_id], "v", [v])
