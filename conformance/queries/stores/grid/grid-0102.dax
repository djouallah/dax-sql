// note: the view expander's grid (tools/ossie/grid.mjs), where total: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT AGG(t.total_sales) AS v FROM stores_model.store_sales AS t WHERE NOT (t.sale_date_id = 'D2023')
EVALUATE SELECTCOLUMNS(CALCULATETABLE(ROW("v", 'store_sales'[total_sales]), NOT(('store_sales'[sale_date_id] = "D2023"))), "v", [v])
