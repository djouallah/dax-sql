// note: the view expander's grid (tools/ossie/grid.mjs), order by measure: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.item_id, AGG(t.total_sales) AS v FROM stores_model.store_sales AS t GROUP BY t.item_id ORDER BY v DESC NULLS LAST, t.item_id NULLS FIRST
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('store_sales'[item_id], "__rows", COUNTROWS(store_sales), "v", 'store_sales'[total_sales]), "item_id", 'store_sales'[item_id], "v", [v]) ORDER BY [v] DESC, [item_id]
