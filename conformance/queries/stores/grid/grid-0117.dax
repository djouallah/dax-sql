// note: the view expander's grid (tools/ossie/grid.mjs), where or: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.return_id, AGG(t.total_returns) AS v FROM stores_model.store_returns AS t WHERE NOT (t.return_id = 'SR1') OR t.return_id = 'SR2' GROUP BY t.return_id
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('store_returns'[return_id], "__rows", COUNTROWS('store_returns'), "v", 'store_returns'[total_returns]), (NOT(('store_returns'[return_id] = "SR1")) || ('store_returns'[return_id] = "SR2"))), "return_id", 'store_returns'[return_id], "v", [v])
