// note: the view expander's grid (tools/ossie/grid.mjs), where total: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT AGG(t.total_returns) AS v FROM stores_model.store_returns AS t WHERE t.return_date_id IS NOT NULL
EVALUATE SELECTCOLUMNS(CALCULATETABLE(ROW("v", 'store_returns'[total_returns]), NOT(ISBLANK('store_returns'[return_date_id]))), "v", [v])
