// note: the view expander's grid (tools/ossie/grid.mjs), having: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.return_id, AGG(t.total_returns) AS v FROM stores_model.store_returns AS t GROUP BY t.return_id HAVING AGG(t.total_returns) > 0
EVALUATE SELECTCOLUMNS(FILTER(SUMMARIZECOLUMNS('store_returns'[return_id], "__rows", COUNTROWS('store_returns'), "v", 'store_returns'[total_returns]), ([v] > 0)), "return_id", 'store_returns'[return_id], "v", [v])
