// note: the view expander's grid (tools/ossie/grid.mjs), order by measure: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.return_id, AGG(t.total_returns) AS v FROM stores_model.store_returns AS t GROUP BY t.return_id ORDER BY v DESC NULLS LAST, t.return_id NULLS FIRST
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('store_returns'[return_id], "__rows", COUNTROWS('store_returns'), "v", 'store_returns'[total_returns]), "return_id", 'store_returns'[return_id], "v", [v]) ORDER BY [v] DESC, [return_id]
