// note: the view expander's grid (tools/ossie/grid.mjs), group by all: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.return_id, AGG(t.total_returns) AS v FROM stores_model.store_returns AS t GROUP BY ALL
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('store_returns'[return_id], "__rows", COUNTROWS(store_returns), "v", 'store_returns'[total_returns]), "return_id", 'store_returns'[return_id], "v", [v])
