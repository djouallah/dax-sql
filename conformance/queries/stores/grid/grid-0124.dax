// note: the view expander's grid (tools/ossie/grid.mjs), rollup: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.return_date_id, AGG(t.total_returns) AS v FROM stores_model.store_returns AS t GROUP BY ROLLUP (t.return_date_id) ORDER BY t.return_date_id NULLS LAST
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS(ROLLUPADDISSUBTOTAL('store_returns'[return_date_id], "__level1_return_date_id"), "__rows", COUNTROWS('store_returns'), "v", 'store_returns'[total_returns]), "return_date_id", 'store_returns'[return_date_id], "v", [v]) ORDER BY ISBLANK([return_date_id]), [return_date_id]
