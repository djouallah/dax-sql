// note: the view expander's grid (tools/ossie/grid.mjs), two groups: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.return_amount, t.return_date_id, AGG(t.total_returns) AS v FROM stores_model.store_returns AS t GROUP BY t.return_amount, t.return_date_id
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('store_returns'[return_amount], 'store_returns'[return_date_id], "__rows", COUNTROWS(store_returns), "v", 'store_returns'[total_returns]), "return_amount", 'store_returns'[return_amount], "return_date_id", 'store_returns'[return_date_id], "v", [v])
