// note: the view expander's grid (tools/ossie/grid.mjs), rollup: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.return_amount, AGG(t.total_returns) AS v FROM stores_model.store_returns AS t GROUP BY ROLLUP (t.return_amount) ORDER BY t.return_amount NULLS LAST
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS(ROLLUPADDISSUBTOTAL('store_returns'[return_amount], "__level1_return_amount"), "__rows", COUNTROWS(store_returns), "v", 'store_returns'[total_returns]), "return_amount", 'store_returns'[return_amount], "v", [v]) ORDER BY ISBLANK([return_amount]), [return_amount]
