// note: the view expander's grid (tools/ossie/grid.mjs), scalar ops: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.return_amount, AGG(t.total_returns) * 2 AS a, AGG(t.total_returns) + 1 AS b, COALESCE(AGG(t.total_returns), 0) AS c FROM stores_model.store_returns AS t GROUP BY t.return_amount
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('store_returns'[return_amount], "__rows", COUNTROWS(store_returns), "a", ('store_returns'[total_returns] * 2), "b", ('store_returns'[total_returns] + 1), "c", IF(ISBLANK(COUNTROWS(store_returns)), BLANK(), COALESCE('store_returns'[total_returns], 0))), "return_amount", 'store_returns'[return_amount], "a", [a], "b", [b], "c", [c])
