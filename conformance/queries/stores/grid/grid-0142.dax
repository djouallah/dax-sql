// note: the view expander's grid (tools/ossie/grid.mjs), derived table: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT s.return_amount, s.v FROM (SELECT t.return_amount, AGG(t.total_returns) AS v FROM stores_model.store_returns AS t GROUP BY t.return_amount) AS s WHERE s.v IS NOT NULL
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('store_returns'[return_amount], "__rows", COUNTROWS('store_returns'), "v", 'store_returns'[total_returns]), "return_amount", 'store_returns'[return_amount], "v", [v])
