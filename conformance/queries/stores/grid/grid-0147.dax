// note: the view expander's grid (tools/ossie/grid.mjs), cte: its SQL as dax-sql's SQL front end writes it in DAX:
// WITH s AS (SELECT return_amount, total_returns AS mm FROM stores_model.store_returns WHERE NOT (return_date_id = 'D2024a')) SELECT return_amount, AGG(mm) AS v FROM s GROUP BY return_amount
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('store_returns'[return_amount], "__rows", COUNTROWS(store_returns), "v", 'store_returns'[total_returns]), NOT(('store_returns'[return_date_id] = "D2024a"))), "return_amount", 'store_returns'[return_amount], "v", [v])
