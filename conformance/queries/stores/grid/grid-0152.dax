// note: the view expander's grid (tools/ossie/grid.mjs), cte: its SQL as dax-sql's SQL front end writes it in DAX:
// WITH s AS (SELECT return_id, total_returns AS mm FROM stores_model.store_returns WHERE return_date_id IS NOT NULL) SELECT return_id, AGG(mm) AS v FROM s GROUP BY return_id
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('store_returns'[return_id], "__rows", COUNTROWS(store_returns), "v", 'store_returns'[total_returns]), NOT(ISBLANK('store_returns'[return_date_id]))), "return_id", 'store_returns'[return_id], "v", [v])
