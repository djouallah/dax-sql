// note: the view expander's grid (tools/ossie/grid.mjs), where total: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT AGG(t.total_returns) AS v FROM stores_model.store_returns AS t WHERE t.return_amount >= 10
EVALUATE SELECTCOLUMNS(CALCULATETABLE(ROW("v", 'store_returns'[total_returns]), ('store_returns'[return_amount] >= 10)), "v", [v])
