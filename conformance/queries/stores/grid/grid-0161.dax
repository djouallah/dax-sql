// note: the view expander's grid (tools/ossie/grid.mjs), where or: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.return_id, AGG(t.total_returns) AS v FROM stores_model.store_returns AS t WHERE t.return_amount = 5 OR t.item_id IS NOT NULL GROUP BY t.return_id
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('store_returns'[return_id], "__rows", COUNTROWS('store_returns'), "v", 'store_returns'[total_returns]), (('store_returns'[return_amount] = 5) || NOT(ISBLANK('store_returns'[item_id])))), "return_id", 'store_returns'[return_id], "v", [v])
