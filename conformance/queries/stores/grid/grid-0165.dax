// note: the view expander's grid (tools/ossie/grid.mjs), star where one: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.item_id, AGG(f.total_sales) AS v FROM stores_model.store_sales AS f LEFT JOIN stores_model.item AS o ON f.item_id = o.item_id WHERE o.item_id IN ('I2', 'I1') GROUP BY o.item_id
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('item'[item_id], "__rows", COUNTROWS('store_sales'), "v", 'store_sales'[total_sales]), ('item'[item_id] IN {"I2", "I1"})), "item_id", 'item'[item_id], "v", [v])
