// note: the view expander's grid (tools/ossie/grid.mjs), star two sides: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.item_id, f.sales_amount, AGG(f.total_sales) AS v FROM stores_model.store_sales AS f LEFT JOIN stores_model.item AS o ON f.item_id = o.item_id GROUP BY o.item_id, f.sales_amount
