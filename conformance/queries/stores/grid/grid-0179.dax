// note: the view expander's grid (tools/ossie/grid.mjs), star two sides: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.date_id, f.item_id, AGG(f.total_sales) AS v FROM stores_model.store_sales AS f LEFT JOIN stores_model.date_dim AS o ON f.sale_date_id = o.date_id GROUP BY o.date_id, f.item_id
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('date_dim'[date_id], 'store_sales'[item_id], "__rows", COUNTROWS('store_sales'), "v", 'store_sales'[total_sales]), "date_id", 'date_dim'[date_id], "item_id", 'store_sales'[item_id], "v", [v])
