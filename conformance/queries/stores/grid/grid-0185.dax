// note: the view expander's grid (tools/ossie/grid.mjs), star total: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT AGG(f.total_sales) AS v FROM stores_model.store_sales AS f JOIN stores_model.date_dim AS o ON f.sale_date_id = o.date_id
EVALUATE SELECTCOLUMNS(CALCULATETABLE(ROW("v", 'store_sales'[total_sales]), NOT(ISBLANK('date_dim'[date_id]))), "v", [v])
