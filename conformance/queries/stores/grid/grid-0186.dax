// note: the view expander's grid (tools/ossie/grid.mjs), star where one: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.date_id, AGG(f.total_sales) AS v FROM stores_model.store_sales AS f JOIN stores_model.date_dim AS o ON f.sale_date_id = o.date_id WHERE o.date_id <> 'D2023' GROUP BY o.date_id
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('date_dim'[date_id], "__rows", COUNTROWS('store_sales'), "v", 'store_sales'[total_sales]), ('date_dim'[date_id] <> "D2023"), NOT(ISBLANK('date_dim'[date_id]))), "date_id", 'date_dim'[date_id], "v", [v])
