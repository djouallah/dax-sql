// note: the view expander's grid (tools/ossie/grid.mjs), star where one: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.store_id, AGG(f.total_sales) AS v FROM stores_model.store_sales AS f JOIN stores_model.store AS o ON f.store_id = o.store_id WHERE o.state = 'NY' GROUP BY o.store_id
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('store'[store_id], "__rows", COUNTROWS('store_sales'), "v", 'store_sales'[total_sales]), ('store'[state] = "NY"), NOT(ISBLANK('store'[store_id]))), "store_id", 'store'[store_id], "v", [v])
