// note: the view expander's grid (tools/ossie/grid.mjs), star two sides: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.state, f.item_id, AGG(f.total_sales) AS v FROM stores_model.store_sales AS f JOIN stores_model.store AS o ON f.store_id = o.store_id GROUP BY o.state, f.item_id
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('store'[state], 'store_sales'[item_id], "__rows", COUNTROWS(store_sales), "v", 'store_sales'[total_sales]), NOT(ISBLANK('store'[store_id]))), "state", 'store'[state], "item_id", 'store_sales'[item_id], "v", [v])
