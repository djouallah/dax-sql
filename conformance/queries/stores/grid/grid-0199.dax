// note: the view expander's grid (tools/ossie/grid.mjs), star where one: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.store_id, AGG(f.total_sales) AS v FROM stores_model.store_sales AS f LEFT JOIN stores_model.store AS o ON f.store_id = o.store_id WHERE o.closing_date_id = 'D2024a' GROUP BY o.store_id
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('store'[store_id], "__rows", COUNTROWS('store_sales'), "v", 'store_sales'[total_sales]), ('store'[closing_date_id] = "D2024a")), "store_id", 'store'[store_id], "v", [v])
