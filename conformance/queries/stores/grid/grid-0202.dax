// note: the view expander's grid (tools/ossie/grid.mjs), star total: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT AGG(f.total_sales) AS v FROM stores_model.store_sales AS f LEFT JOIN stores_model.store AS o ON f.store_id = o.store_id
EVALUATE SELECTCOLUMNS(ROW("v", 'store_sales'[total_sales]), "v", [v])
