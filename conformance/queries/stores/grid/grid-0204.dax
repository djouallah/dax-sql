// note: the view expander's grid (tools/ossie/grid.mjs), star where one: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.region, AGG(f.total_sales) AS v FROM stores_model.store_sales AS f JOIN stores_model.customers AS o ON f.customer_id = o.customer_id WHERE o.region <> 'EAST' GROUP BY o.region
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('customers'[region], "__rows", COUNTROWS(store_sales), "v", 'store_sales'[total_sales]), ('customers'[region] <> "EAST"), NOT(ISBLANK('customers'[customer_id]))), "region", 'customers'[region], "v", [v])
