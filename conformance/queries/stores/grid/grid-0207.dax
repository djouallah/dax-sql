// note: the view expander's grid (tools/ossie/grid.mjs), star total: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT AGG(f.total_sales) AS v FROM stores_model.store_sales AS f JOIN stores_model.customers AS o ON f.customer_id = o.customer_id
EVALUATE SELECTCOLUMNS(CALCULATETABLE(ROW("v", 'store_sales'[total_sales]), NOT(ISBLANK('customers'[customer_id]))), "v", [v])
