// note: the view expander's grid (tools/ossie/grid.mjs), one to many: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.region, AGG(o.customer_count) AS a, AGG(f.total_sales) AS b FROM stores_model.customers AS o LEFT JOIN stores_model.store_sales AS f ON f.customer_id = o.customer_id GROUP BY o.region
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('customers'[region], "__rows", COUNTROWS(customers), "a", 'customers'[customer_count], "b", CALCULATE('store_sales'[total_sales], KEEPFILTERS(NOT(ISBLANK('customers'[customer_id]))))), "region", 'customers'[region], "a", COALESCE([a], 0), "b", [b])
