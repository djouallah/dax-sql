// note: the view expander's grid (tools/ossie/grid.mjs), fan-out: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT f.item_id, AGG(o.customer_count) AS v FROM stores_model.store_sales AS f JOIN stores_model.customers AS o ON f.customer_id = o.customer_id GROUP BY f.item_id
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('store_sales'[item_id], "__rows", COUNTROWS('store_sales'), "v", CALCULATE('customers'[customer_count], 'store_sales')), NOT(ISBLANK('customers'[customer_id]))), "item_id", 'store_sales'[item_id], "v", COALESCE([v], 0))
