// note: the view expander's grid (tools/ossie/grid.mjs), one side counted once: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.customer_id, AGG(f.total_sales) AS a, AGG(o.customer_count) AS b FROM stores_model.store_sales AS f LEFT JOIN stores_model.customers AS o ON f.customer_id = o.customer_id GROUP BY o.customer_id
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('customers'[customer_id], "__rows", COUNTROWS('store_sales'), "a", 'store_sales'[total_sales], "b", CALCULATE('customers'[customer_count], 'store_sales')), "customer_id", 'customers'[customer_id], "a", [a], "b", COALESCE([b], 0))
