// note: the view expander's grid (tools/ossie/grid.mjs), fan-out: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT f.sales_amount, AGG(o.customer_count) AS v FROM stores_model.store_sales AS f LEFT JOIN stores_model.customers AS o ON f.customer_id = o.customer_id GROUP BY f.sales_amount
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('store_sales'[sales_amount], "__rows", COUNTROWS('store_sales'), "v", CALCULATE('customers'[customer_count], 'store_sales')), "sales_amount", 'store_sales'[sales_amount], "v", COALESCE([v], 0))
