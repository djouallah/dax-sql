// note: the view expander's grid (tools/ossie/grid.mjs), star where many: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.brand, AGG(f.total_returns) AS v FROM stores_model.store_returns AS f LEFT JOIN stores_model.item AS o ON f.item_id = o.item_id WHERE f.item_id IS NOT NULL GROUP BY o.brand
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('item'[brand], "__rows", COUNTROWS(store_returns), "v", 'store_returns'[total_returns]), NOT(ISBLANK('store_returns'[item_id]))), "brand", 'item'[brand], "v", [v])
