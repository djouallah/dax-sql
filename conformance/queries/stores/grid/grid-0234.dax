// note: the view expander's grid (tools/ossie/grid.mjs), star total: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT AGG(f.total_returns) AS v FROM stores_model.store_returns AS f JOIN stores_model.item AS o ON f.item_id = o.item_id
EVALUATE SELECTCOLUMNS(CALCULATETABLE(ROW("v", 'store_returns'[total_returns]), NOT(ISBLANK('item'[item_id]))), "v", [v])
