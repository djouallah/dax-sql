// note: the view expander's grid (tools/ossie/grid.mjs), star where many: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.item_id, AGG(f.total_returns) AS v FROM stores_model.store_returns AS f JOIN stores_model.item AS o ON f.item_id = o.item_id WHERE f.return_amount < 10 GROUP BY o.item_id
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('item'[item_id], "__rows", COUNTROWS(store_returns), "v", 'store_returns'[total_returns]), ('store_returns'[return_amount] < 10), NOT(ISBLANK('item'[item_id]))), "item_id", 'item'[item_id], "v", [v])
