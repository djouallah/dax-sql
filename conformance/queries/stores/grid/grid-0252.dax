// note: the view expander's grid (tools/ossie/grid.mjs), chasm: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.item_id, AGG(a.total_returns) AS x, AGG(b.total_sales) AS y FROM stores_model.item AS o LEFT JOIN stores_model.store_returns AS a ON a.item_id = o.item_id LEFT JOIN stores_model.store_sales AS b ON b.item_id = o.item_id GROUP BY o.item_id
DEFINE
VAR __v1 = GENERATEALL(GENERATEALL(SELECTCOLUMNS(item, "o.item_id", 'item'[item_id]), FILTER(SELECTCOLUMNS(store_returns, "a.return_id", 'store_returns'[return_id], "a.item_id", 'store_returns'[item_id]), ([a.item_id] = [o.item_id]))), FILTER(SELECTCOLUMNS(store_sales, "b.sale_id", 'store_sales'[sale_id], "b.item_id", 'store_sales'[item_id]), ([b.item_id] = [o.item_id])))
VAR __v2 = DISTINCT(SELECTCOLUMNS(__v1, "item_id", [o.item_id]))
EVALUATE SELECTCOLUMNS(ADDCOLUMNS(__v2, "__m1", CALCULATE('store_returns'[total_returns], REMOVEFILTERS(), TREATAS(SELECTCOLUMNS(FILTER(__v1, (NOT(ISBLANK([a.return_id])) && ([o.item_id] == [item_id]))), "__k1", [a.return_id]), 'store_returns'[return_id])), "__m2", CALCULATE('store_sales'[total_sales], REMOVEFILTERS(), TREATAS(SELECTCOLUMNS(FILTER(__v1, (NOT(ISBLANK([b.sale_id])) && ([o.item_id] == [item_id]))), "__k1", [b.sale_id]), 'store_sales'[sale_id]))), "item_id", [item_id], "x", [__m1], "y", [__m2])
