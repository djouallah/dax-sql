// note: the view expander's grid (tools/ossie/grid.mjs), chasm: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.date_id, AGG(a.total_returns) AS x, AGG(b.total_sales) AS y FROM stores_model.date_dim AS o LEFT JOIN stores_model.store_returns AS a ON a.return_date_id = o.date_id LEFT JOIN stores_model.store_sales AS b ON b.sale_date_id = o.date_id GROUP BY o.date_id
DEFINE
VAR __v1 = GENERATEALL(GENERATEALL(SELECTCOLUMNS('date_dim', "o.date_id", 'date_dim'[date_id]), FILTER(SELECTCOLUMNS('store_returns', "a.return_id", 'store_returns'[return_id], "a.return_date_id", 'store_returns'[return_date_id]), ([a.return_date_id] = [o.date_id]))), FILTER(SELECTCOLUMNS('store_sales', "b.sale_id", 'store_sales'[sale_id], "b.sale_date_id", 'store_sales'[sale_date_id]), ([b.sale_date_id] = [o.date_id])))
VAR __v2 = DISTINCT(SELECTCOLUMNS(__v1, "date_id", [o.date_id]))
EVALUATE SELECTCOLUMNS(ADDCOLUMNS(__v2, "__m1", CALCULATE('store_returns'[total_returns], REMOVEFILTERS(), TREATAS(SELECTCOLUMNS(FILTER(__v1, (NOT(ISBLANK([a.return_id])) && ([o.date_id] == [date_id]))), "__k1", [a.return_id]), 'store_returns'[return_id])), "__m2", CALCULATE('store_sales'[total_sales], REMOVEFILTERS(), TREATAS(SELECTCOLUMNS(FILTER(__v1, (NOT(ISBLANK([b.sale_id])) && ([o.date_id] == [date_id]))), "__k1", [b.sale_id]), 'store_sales'[sale_id]))), "date_id", [date_id], "x", [__m1], "y", [__m2])
