// note: Apache Ossie wide table compliance A16 (a16_shared_dimensions_stores.ost):  Its Layer 3 query {"dimensions":["item.brand","date_dim.year"],"metrics":["store_sales.total_sales","store_returns.total_returns"]}, lowered to Layer 2 SQL, model query 1 of 2, as dax-sql's SQL front end writes it in DAX:
// WITH b_store_sales AS ( SELECT item.brand AS brand, date_dim."year" AS "year", AGG(store_sales.total_sales) AS c1, 1 AS present FROM stores_model.store_sales LEFT JOIN stores_model.item ON store_sales.item_id = item.item_id LEFT JOIN stores_model.date_dim ON store_sales.sale_date_id = date_dim.date_id GROUP BY item.brand, date_dim."year" ), b_store_returns AS ( SELECT item.brand AS brand, date_dim."year" AS "year", AGG(store_returns.total_returns) AS c1, 1 AS present FROM stores_model.store_returns LEFT JOIN stores_model.item ON store_returns.item_id = item.item_id LEFT JOIN stores_model.date_dim ON store_returns.return_date_id = date_dim.date_id GROUP BY item.brand, date_dim."year" ), keys AS ( SELECT brand, "year" FROM b_store_sales UNION SELECT brand, "year" FROM b_store_returns ) SELECT keys.brand, keys."year", b_store_sales.c1 AS total_sales, b_store_returns.c1 AS total_returns FROM keys LEFT JOIN b_store_sales ON b_store_sales.brand IS NOT DISTINCT FROM keys.brand AND b_store_sales."year" IS NOT DISTINCT FROM keys."year" LEFT JOIN b_store_returns ON b_store_returns.brand IS NOT DISTINCT FROM keys.brand AND b_store_returns."year" IS NOT DISTINCT FROM keys."year"
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('item'[brand], 'date_dim'[year], "__rows", COUNTROWS('store_sales'), "c1", 'store_sales'[total_sales]), "brand", 'item'[brand], "year", 'date_dim'[year], "c1", [c1], "present", 1)
