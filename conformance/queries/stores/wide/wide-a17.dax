// note: Apache Ossie wide table compliance A17 (a17_unmatched_home_null_group.ost):  Its Layer 3 query {"dimensions":["customers.region"],"metrics":["store_sales.total_sales"]}, lowered to Layer 2 SQL, as dax-sql's SQL front end writes it in DAX:
// SELECT customers.region AS region, AGG(store_sales.total_sales) AS total_sales FROM stores_model.store_sales LEFT JOIN stores_model.customers ON store_sales.customer_id = customers.customer_id GROUP BY customers.region
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('customers'[region], "__rows", COUNTROWS(store_sales), "total_sales", 'store_sales'[total_sales]), "region", 'customers'[region], "total_sales", [total_sales])
