// note: Apache Ossie wide table compliance A18 (a18_anchor_with_metric.ost):  Its Layer 3 query {"dimensions":["item.brand","store.state"],"metrics":["store_sales.total_sales"]}, lowered to Layer 2 SQL, as dax-sql's SQL front end writes it in DAX:
// SELECT item.brand AS brand, store.state AS state, AGG(store_sales.total_sales) AS total_sales FROM stores_model.store_sales LEFT JOIN stores_model.item ON store_sales.item_id = item.item_id LEFT JOIN stores_model.store ON store_sales.store_id = store.store_id GROUP BY item.brand, store.state
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('item'[brand], 'store'[state], "__rows", COUNTROWS(store_sales), "total_sales", 'store_sales'[total_sales]), "brand", 'item'[brand], "state", 'store'[state], "total_sales", [total_sales])
