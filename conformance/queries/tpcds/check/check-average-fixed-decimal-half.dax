// note: AVERAGE of a fixed decimal column whose exact average is a half at its fifth place (8 sales each: 242.02875, 409.59125, 609.76125): how Power BI rounds it to four places (half away from zero, to even, or a double's), and AVERAGEX, and SUM / COUNT
EVALUATE
ROW(
    "avg 2-16", CALCULATE(AVERAGE('store_sales'[ss_ext_sales_price]), 'store'[s_store_sk] = 2, 'item'[i_item_sk] = 16),
    "avg 6-8", CALCULATE(AVERAGE('store_sales'[ss_ext_sales_price]), 'store'[s_store_sk] = 6, 'item'[i_item_sk] = 8),
    "avg 5-12", CALCULATE(AVERAGE('store_sales'[ss_ext_sales_price]), 'store'[s_store_sk] = 5, 'item'[i_item_sk] = 12),
    "avgx 6-8", CALCULATE(AVERAGEX('store_sales', 'store_sales'[ss_ext_sales_price]), 'store'[s_store_sk] = 6, 'item'[i_item_sk] = 8),
    "sum/count 6-8", CALCULATE(SUM('store_sales'[ss_ext_sales_price]) / COUNT('store_sales'[ss_ext_sales_price]), 'store'[s_store_sk] = 6, 'item'[i_item_sk] = 8),
    "avg 6-8 * 1e5", CALCULATE(AVERAGE('store_sales'[ss_ext_sales_price]), 'store'[s_store_sk] = 6, 'item'[i_item_sk] = 8) * 100000
)
