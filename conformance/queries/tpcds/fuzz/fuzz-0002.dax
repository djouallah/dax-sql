// note: a random query (conformance/tools/fuzz.mjs tpcds 120 20261124, number 2)
EVALUATE SUMMARIZECOLUMNS('date_dim'[d_moy], 'store'[s_city], "m0", CALCULATE(VAR v = SUM('store_sales'[ss_quantity]) RETURN v * 2 + COALESCE([Archive Source Rows], 0), DATESYTD('date_dim'[d_date]), USERELATIONSHIP('catalog_sales'[cs_ship_addr_sk], 'customer_address'[ca_address_sk])), "m1", ROUND(DIVIDE(CALCULATE([Catalog Sales YoY], REMOVEFILTERS('store'), TREATAS({ "blue", "almond" }, 'item'[i_color])), CALCULATE(CALCULATE(AVERAGE('catalog_sales'[cs_ext_sales_price]), DATESBETWEEN('date_dim'[d_date], DATE(2025, 10, 24), DATE(2026, 5, 13))), ALL('item'[i_brand]))), 2))
