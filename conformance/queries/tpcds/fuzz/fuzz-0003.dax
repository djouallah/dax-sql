// note: a random query (conformance/tools/fuzz.mjs tpcds 120 20261124, number 3)
EVALUATE ROW("m0", MAX([Store Net Profit], (CALCULATE([Catalog Sales Quantity], DATESBETWEEN('date_dim'[d_date], DATE(2025, 9, 13), DATE(2024, 1, 11))) + MIN('catalog_sales'[cs_ext_sales_price]))), "m1", CALCULATE(ABS(CALCULATE(AVERAGE('store_sales'[ss_ext_sales_price]), 'item'[i_color] >= "zz-none")), DATESBETWEEN('date_dim'[d_date], DATE(2026, 6, 3), DATE(2026, 7, 26))), "m2", IF(ISINSCOPE('item'[i_brand]), AVERAGE('catalog_sales'[cs_quantity]), MAX(AVERAGE('catalog_sales'[cs_ext_sales_price]), [Store Profit % by Item Category])))
