// note: a random query (conformance/tools/fuzz.mjs tpcds 120 20261124, number 17)
EVALUATE SUMMARIZECOLUMNS('store'[s_state], 'customer_address'[ca_state], FILTER(ALL('item'[i_color]), 'item'[i_color] <> "coral"), TREATAS({ "navy", "plum", "khaki" }, 'item'[i_color]), "m0", IF(ISBLANK(MAX('store_sales'[ss_net_profit])), 0, CALCULATE(COALESCE([Catalog Sales Same Period LY], 0), FILTER(ALL('store'[s_store_name]), 'store'[s_store_name] <> "anti"))), "m1", IF(ISBLANK(VAR v = [Catalog Sales Quantity] RETURN v * 2 + DISTINCTCOUNT('promotion'[p_promo_name])), 0, DISTINCTCOUNT('item'[i_class])), "m2", IF(ISINSCOPE('item'[i_current_price]), [Catalog Revenue], ROUND([Store Revenue Same Period LY], 1)))
