// note: a random query (conformance/tools/fuzz.mjs tpcds 120 20261124, number 18)
EVALUATE SUMMARIZECOLUMNS('item'[i_category], TREATAS({ "TWO DAY", "NEXT DAY", "EXPRESS" }, 'ship_mode'[sm_type]), FILTER(VALUES('promotion'[p_promo_name]), 'promotion'[p_promo_name] IN { "barought", "able" }), "m0", CALCULATE([Catalog Sales Same Period LY], KEEPFILTERS('store'[s_state] IN { "GA", "TN" })), "m1", (TOTALYTD([Archive Source Rows], 'date_dim'[d_date]) * CALCULATE([Store Net Profit], ALLEXCEPT('customer_address', 'customer_address'[ca_state]), ALLEXCEPT('store', 'store'[s_city]))))
