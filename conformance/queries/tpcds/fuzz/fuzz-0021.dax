// note: a random query (conformance/tools/fuzz.mjs tpcds 120 20261124, number 21)
EVALUATE SUMMARIZECOLUMNS('item'[i_current_price], 'date_dim'[d_qoy], FILTER(ALL('store'[s_state]), 'store'[s_state] <> "TN"), "m0", CALCULATE(IF(ISINSCOPE('customer_address'[ca_state]), [Archive Source Rows], [Archive Source Rows]), ALL('store'[s_state])), "m1", IF(ISINSCOPE('customer_demographics'[cd_marital_status]), VAR v = [Catalog Revenue] RETURN v * 2 + [Catalog Sales Same Period LY], CALCULATE([Archive Source Rows], DATESBETWEEN('date_dim'[d_date], DATE(2026, 10, 19), DATE(1999, 1, 1)))), "m2", (TOTALYTD([Store Revenue YoY], 'date_dim'[d_date]) * CALCULATE(AVERAGE('catalog_sales'[cs_ext_sales_price]), REMOVEFILTERS('catalog_sales'))))
