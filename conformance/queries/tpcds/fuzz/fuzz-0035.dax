// note: a random query (conformance/tools/fuzz.mjs tpcds 120 20261124, number 35)
EVALUATE SUMMARIZECOLUMNS('store'[s_state], 'customer_demographics'[cd_education_status], FILTER(VALUES('ship_mode'[sm_type]), 'ship_mode'[sm_type] IN { "OVERNIGHT", "REGULAR" }), FILTER(VALUES('date_dim'[d_year]), 'date_dim'[d_year] IN { 2024, -1 }), "m0", IF(ISBLANK(ROUND(COUNTROWS('item'), 2)), 0, MAX('store_sales'[ss_net_profit])), "m1", CALCULATE(VAR v = [Store Revenue YTD] RETURN v * 2 + SUM('catalog_sales'[cs_net_profit]), REMOVEFILTERS('item')))
