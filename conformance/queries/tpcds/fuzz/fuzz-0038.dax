// note: a random query (conformance/tools/fuzz.mjs tpcds 120 20261124, number 38)
EVALUATE SUMMARIZECOLUMNS('item'[i_current_price], 'date_dim'[d_year], "m0", IF(AVERAGE('catalog_sales'[cs_quantity]) > 1000, MAX('catalog_sales'[cs_net_profit]), [Store Profit % by Item Category]), "m1", ABS(MAX('store_sales'[ss_quantity])), "m2", VAR v = DISTINCTCOUNT('date_dim'[d_qoy]) RETURN v * 2 + [Store Revenue YTD])
