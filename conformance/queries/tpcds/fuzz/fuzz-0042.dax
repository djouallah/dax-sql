// note: a random query (conformance/tools/fuzz.mjs tpcds 120 20261124, number 42)
EVALUATE SUMMARIZECOLUMNS('promotion'[p_promo_name], "m0", [Catalog Sales Quantity], "m1", IF(ISINSCOPE('store'[s_city]), CALCULATE([Store Revenue Same Period LY], FILTER(VALUES('store'[s_state]), ABS(SUM('catalog_sales'[cs_ext_sales_price])) > 0)), SUMX(VALUES('item'[i_class]), [Archive Source Rows])))
