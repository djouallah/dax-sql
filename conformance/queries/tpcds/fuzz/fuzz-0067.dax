// note: a random query (conformance/tools/fuzz.mjs tpcds 120 20261124, number 67)
EVALUATE CALCULATETABLE(SUMMARIZECOLUMNS('ship_mode'[sm_type], "m0", DIVIDE(VAR v = IF(ISINSCOPE('item'[i_current_price]), MAX('store_sales'[ss_ext_sales_price]), SUM('catalog_sales'[cs_ext_sales_price])) RETURN v * 2 + ROUND([Store Revenue], 0), CALCULATE(DIVIDE(CALCULATE(AVERAGE('catalog_sales'[cs_quantity]), DATESBETWEEN('date_dim'[d_date], DATE(2024, 8, 20), DATE(2026, 3, 16))), [Store Revenue YoY]), ALL('item'[i_class]))), "m1", DIVIDE(COUNTROWS(FILTER(VALUES('store'[s_state]), CALCULATE(MIN('store_sales'[ss_ext_sales_price]), ALL('customer_demographics'[cd_education_status]), ALL('date_dim'[d_year])) > 100)), CALCULATE([Store Revenue YTD], ALL('item'[i_category])))), 'item'[i_category] >= "Home")
