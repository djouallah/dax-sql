// note: a random query (conformance/tools/fuzz.mjs tpcds 120 20261124, number 73)
EVALUATE SUMMARIZECOLUMNS('item'[i_color], "m0", DIVIDE(ROUND([Catalog Revenue], 2), CALCULATE(RANKX(ALL('store'[s_city]), [Store Revenue YoY]), ALL('date_dim'[d_qoy]))), "m1", CALCULATE(IF(ISINSCOPE('promotion'[p_promo_name]), [Store Revenue YTD], DISTINCTCOUNT('customer_demographics'[cd_education_status])), KEEPFILTERS('date_dim'[d_qoy] IN { 3, 1 }), TREATAS({ "Oak Grove", "Fairview" }, 'store'[s_city])), "m2", CALCULATE(COUNTROWS('store'), FILTER(ALL('date_dim'[d_moy]), 'date_dim'[d_moy] <> 7), USERELATIONSHIP('catalog_sales'[cs_ship_addr_sk], 'customer_address'[ca_address_sk])))
