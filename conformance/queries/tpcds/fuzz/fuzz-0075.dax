// note: a random query (conformance/tools/fuzz.mjs tpcds 120 20261124, number 75)
EVALUATE SUMMARIZECOLUMNS('store'[s_state], "m0", MINX(VALUES('item'[i_category]), IF(ISINSCOPE('item'[i_class]), CALCULATE(AVERAGE('catalog_sales'[cs_net_profit]), DATEADD('date_dim'[d_date], -1, MONTH)), DISTINCTCOUNT('store'[s_city]))), "m1", DIVIDE(VAR v = [Archive Source Rows] RETURN v * 2 + VAR v = [Store Revenue Same Period LY] RETURN v * 2 + [Store Net Profit], ABS(TOTALYTD(SUM('store_sales'[ss_ext_sales_price]), 'date_dim'[d_date]))), "m2", CALCULATE(CALCULATE(DIVIDE(MIN('catalog_sales'[cs_net_profit]), CALCULATE(MIN('store_sales'[ss_quantity]), ALL('ship_mode'[sm_type]))), ALLEXCEPT('customer_demographics', 'customer_demographics'[cd_marital_status])), FILTER(VALUES('item'[i_category]), COUNTROWS('store_sales') > 0)))
