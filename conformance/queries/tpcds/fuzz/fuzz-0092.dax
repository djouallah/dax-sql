// note: a random query (conformance/tools/fuzz.mjs tpcds 120 20261124, number 92)
EVALUATE SUMMARIZECOLUMNS('store'[s_store_name], "m0", IF(ISINSCOPE('ship_mode'[sm_type]), IF(ISBLANK(CALCULATE([Catalog Sales Same Period LY], REMOVEFILTERS('item'), 'item'[i_color] = "plum")), 0, IF(HASONEVALUE('item'[i_current_price]), COUNTROWS('store'))), COUNTROWS('store')), "m1", IF(ISBLANK(IF(ISBLANK(IF(HASONEVALUE('customer_address'[ca_state]), COUNTROWS('store_sales'))), 0, [Store Profit % by Item Category])), 0, COALESCE(IF(ISINSCOPE('promotion'[p_promo_name]), [Catalog Sales Same Period LY], [Store Revenue YTD]), 0)))
