// note: a random query (conformance/tools/fuzz.mjs tpcds 150 31337 fuzz2, number 5)
EVALUATE ADDCOLUMNS(VALUES('date_dim'[d_moy]), "m0", IF(VAR v = ([Store Distinct Customers] * SUM('store_sales'[ss_net_profit])) RETURN v * 2 + CALCULATE(MAX('store_sales'[ss_quantity]), FILTER(VALUES('date_dim'[d_moy]), ABS([Catalog Sales Same Period LY]) > 10), REMOVEFILTERS('store')) > 0, IF(COUNTROWS('store_sales') > 1000, DIVIDE(SUM('catalog_sales'[cs_quantity]), [Store Revenue YoY]), RANKX(ALL('date_dim'[d_moy]), AVERAGE('catalog_sales'[cs_ext_sales_price]))), IF(HASONEVALUE('ship_mode'[sm_type]), DISTINCTCOUNT('customer_demographics'[cd_education_status]))))
