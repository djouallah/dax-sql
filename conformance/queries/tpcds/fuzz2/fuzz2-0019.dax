// note: a random query (conformance/tools/fuzz.mjs tpcds 150 31337 fuzz2, number 19)
EVALUATE SUMMARIZECOLUMNS('item'[i_color], "m0", RANKX(ALL('date_dim'[d_year]), [Catalog Revenue]), "m1", MAX(IF(ISBLANK(VAR v = [Store Net Profit] RETURN v * 2 + [Store Revenue YTD]), 0, IF(COUNTROWS('store_sales') > 10, [Catalog Sales Same Period LY], SUM('store_sales'[ss_quantity]))), RANKX(ALL('customer_demographics'[cd_education_status]), IF(ISINSCOPE('customer_demographics'[cd_marital_status]), [Store Revenue], [Store Net Profit]), , DESC, Dense)), "m2", IF(HASONEVALUE('date_dim'[d_year]), CALCULATE([Catalog Net Profit], DATESBETWEEN('date_dim'[d_date], DATE(2026, 7, 17), DATE(2024, 4, 29)))))
