// note: a random query (conformance/tools/fuzz.mjs tpcds 150 31337 fuzz2, number 21)
EVALUATE SUMMARIZECOLUMNS('date_dim'[d_year], FILTER(VALUES('store'[s_store_name]), 'store'[s_store_name] IN { "pri", "ese" }), FILTER(ALL('promotion'[p_promo_name]), 'promotion'[p_promo_name] <> "ese"), "m0", COUNTROWS(FILTER(VALUES('date_dim'[d_moy]), IF(ISINSCOPE('store'[s_store_name]), [Store Profit % by Item Category], VAR v = [Archive Source Rows] RETURN v * 2 + MAX('catalog_sales'[cs_net_profit])) > 1)), "m1", COALESCE(DIVIDE([Store Revenue YoY], SUM('store_sales'[ss_ext_sales_price])), 0), "m2", SUM('store_sales'[ss_quantity]))
