EVALUATE CALCULATETABLE(SUMMARIZECOLUMNS('date_dim'[d_moy], 'item'[i_category], "m0", ROUND(VAR v = SUM('catalog_sales'[cs_quantity]) RETURN v * 2 + [Store Revenue Same Period LY], 1)), 'customer_demographics'[cd_marital_status] <> "S")
