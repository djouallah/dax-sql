// note: a random query (conformance/tools/fuzz.mjs tpcds 150 31337 fuzz2, number 57)
EVALUATE SUMMARIZECOLUMNS('store'[s_city], 'item'[i_class], 'date_dim'[d_year], "m0", IF(ISINSCOPE('ship_mode'[sm_type]), SUM('store_sales'[ss_net_profit]), IF(ISINSCOPE('item'[i_current_price]), MINX(VALUES('customer_address'[ca_state]), DISTINCTCOUNT('customer_demographics'[cd_marital_status])), IF([Archive Files] > 0, [Catalog Sales Quantity], COUNTROWS('catalog_sales')))), "m1", [Archive Files], "m2", IF(([Store Profit % by Item Category] - CALCULATE(DISTINCTCOUNT('item'[i_class]), TREATAS({ "Sports" }, 'item'[i_category]))) > 10, TOTALYTD(IF(AVERAGE('store_sales'[ss_ext_sales_price]) > 1000, MIN('store_sales'[ss_net_profit]), COUNTROWS('catalog_sales')), 'date_dim'[d_date]), DIVIDE(AVERAGE('catalog_sales'[cs_ext_sales_price]), CALCULATE(RANKX(ALL('promotion'[p_promo_name]), [Store Revenue Same Period LY], , DESC, Dense), ALL('item'[i_current_price])))))
