// note: a random query (conformance/tools/fuzz.mjs tpcds 150 31337 fuzz2, number 64)
EVALUATE ROW("m0", COALESCE(IF(ISINSCOPE('customer_demographics'[cd_marital_status]), AVERAGE('catalog_sales'[cs_ext_sales_price]), MAX('catalog_sales'[cs_quantity])), 0), "m1", (RANKX(ALL('item'[i_class]), AVERAGE('store_sales'[ss_net_profit])) - MAXX(VALUES('date_dim'[d_moy]), [Store Net Profit])), "m2", DIVIDE(DIVIDE(DISTINCTCOUNT('item'[i_current_price]), CALCULATE([Store Revenue Same Period LY], ALL('item'[i_category]))), CALCULATE(DIVIDE([Catalog Net Profit], AVERAGE('catalog_sales'[cs_quantity])), ALL('ship_mode'[sm_type]))))
