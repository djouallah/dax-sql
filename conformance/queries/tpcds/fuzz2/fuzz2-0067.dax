// note: a random query (conformance/tools/fuzz.mjs tpcds 150 31337 fuzz2, number 67)
EVALUATE CALCULATETABLE(SUMMARIZECOLUMNS('store'[s_store_name], "m0", CALCULATE(TOTALYTD(CALCULATE([Catalog Sales YoY], KEEPFILTERS('item'[i_category] IN { "Books", "Music", "Shoes" })), 'date_dim'[d_date]), TREATAS({ "REGULAR", "TWO DAY", "EXPRESS" }, 'ship_mode'[sm_type])), "m1", [Store Revenue]), DATEADD('date_dim'[d_date], -1, QUARTER))
