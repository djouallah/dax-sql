// note: a random query (conformance/tools/fuzz.mjs tpcds 150 31337 fuzz2, number 72)
EVALUATE SUMMARIZECOLUMNS("m0", IF(ISBLANK(COUNTROWS(FILTER(VALUES('store'[s_state]), CALCULATE(AVERAGE('store_sales'[ss_net_profit]), KEEPFILTERS('item'[i_current_price] = 41.92), 'customer_address'[ca_state] >= "TX") > 0))), 0, CALCULATE(COUNTROWS('item'), KEEPFILTERS('item'[i_color] = "blue"), FILTER(VALUES('item'[i_color]), COUNTROWS(FILTER(VALUES('customer_address'[ca_state]), [Store Profit % by Item Category] > 10)) > 10))), "m1", IF(COUNTROWS('item') > 10, CALCULATE(MIN('catalog_sales'[cs_ext_sales_price]), FILTER(ALL('date_dim'[d_qoy]), 'date_dim'[d_qoy] <> 3), ALL('store'[s_state])), MINX(VALUES('store'[s_city]), COALESCE([Store Distinct Customers], 0))), "m2", COALESCE([Catalog Sales Same Period LY], 0))
