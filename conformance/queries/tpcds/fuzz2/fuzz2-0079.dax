// note: a random query (conformance/tools/fuzz.mjs tpcds 150 31337 fuzz2, number 79)
EVALUATE CALCULATETABLE(SUMMARIZECOLUMNS('store'[s_city], "m0", CALCULATE(MAX(ROUND(COUNTROWS('store'), 0), ABS([Catalog Sales Quantity])), 'store'[s_city] IN { "Oak Grove", "Midway", "Fairview" })), TREATAS({ "rock", "pants", "classical" }, 'item'[i_class]))
