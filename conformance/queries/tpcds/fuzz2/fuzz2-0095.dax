// note: a random query (conformance/tools/fuzz.mjs tpcds 150 31337 fuzz2, number 95)
EVALUATE SUMMARIZECOLUMNS('date_dim'[d_moy], 'store'[s_state], KEEPFILTERS(TREATAS({ "navy", "khaki" }, 'item'[i_color])), "m0", MINX(VALUES('customer_demographics'[cd_marital_status]), ([Catalog Revenue] + IF([Store Distinct Customers] > 1000, [Store Profit % by Item Category], [Catalog Sales Same Period LY]))), "m1", MINX(VALUES('store'[s_state]), IF(HASONEVALUE('store'[s_state]), RANKX(ALL('store'[s_state]), [Archive Source Rows]))))
