EVALUATE SUMMARIZECOLUMNS('item'[i_color], 'date_dim'[d_moy], 'item'[i_current_price], KEEPFILTERS(TREATAS({ "pants", "fiction" }, 'item'[i_class])), FILTER(ALL('item'[i_color]), 'item'[i_color] <> "khaki"), "m0", RANKX(ALL('item'[i_current_price]), [Store Revenue YoY], , DESC, Dense), "m1", MIN('store_sales'[ss_net_profit]), "m2", MIN('catalog_sales'[cs_quantity]))
