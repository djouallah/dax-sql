// note: a random query (conformance/tools/fuzz.mjs tpcds 150 31337 fuzz2, number 126)
EVALUATE CALCULATETABLE(SUMMARIZECOLUMNS('store'[s_store_name], 'promotion'[p_promo_name], "m0", (MINX(VALUES('customer_demographics'[cd_marital_status]), [Store Distinct Customers]) - ABS(([Archive Source Rows] * MIN('store_sales'[ss_ext_sales_price])))), "m1", VAR v = AVERAGEX(VALUES('item'[i_current_price]), IF([Archive Files] > 1000, [Catalog Revenue], COUNTROWS('store'))) RETURN v * 2 + CALCULATE(([Store Revenue YTD] * [Catalog Revenue]), USERELATIONSHIP('catalog_sales'[cs_ship_addr_sk], 'customer_address'[ca_address_sk]))), 'date_dim'[d_moy] <> 2)
