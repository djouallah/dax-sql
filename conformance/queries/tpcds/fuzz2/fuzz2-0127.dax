// note: a random query (conformance/tools/fuzz.mjs tpcds 150 31337 fuzz2, number 127)
EVALUATE SUMMARIZECOLUMNS('date_dim'[d_year], FILTER(ALL('item'[i_current_price]), 'item'[i_current_price] <> 37.82), "m0", CALCULATE(CALCULATE([Store Profit % by Item Category], DATESYTD('date_dim'[d_date])), USERELATIONSHIP('catalog_sales'[cs_ship_addr_sk], 'customer_address'[ca_address_sk]), ALLEXCEPT('item', 'item'[i_brand])), "m1", IF(ISBLANK(DIVIDE([Catalog Sales Same Period LY], [Store Profit % by Item Category])), 0, IF(ISBLANK(DISTINCTCOUNT('item'[i_category])), 0, AVERAGE('catalog_sales'[cs_quantity]))), "m2", COUNTROWS('catalog_sales'))
