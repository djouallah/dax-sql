// note: a random query (conformance/tools/fuzz.mjs tpcds 150 31337 fuzz2, number 144)
EVALUATE CALCULATETABLE(SUMMARIZECOLUMNS('store'[s_store_name], "m0", DIVIDE(MIN('store_sales'[ss_net_profit]), CALCULATE(ABS([Catalog Sales Same Period LY]), ALL('customer_demographics'[cd_education_status]))), "m1", MIN('catalog_sales'[cs_net_profit])), 'customer_address'[ca_state] <> "CA")
