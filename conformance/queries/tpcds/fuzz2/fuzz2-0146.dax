// note: a random query (conformance/tools/fuzz.mjs tpcds 150 31337 fuzz2, number 146)
EVALUATE SUMMARIZECOLUMNS("m0", DIVIDE(AVERAGEX(VALUES('date_dim'[d_qoy]), [Catalog Sales Same Period LY]), CALCULATE(DIVIDE(TOTALYTD([Catalog Sales Quantity], 'date_dim'[d_date]), CALCULATE(CALCULATE(AVERAGE('store_sales'[ss_net_profit]), SAMEPERIODLASTYEAR('date_dim'[d_date]), DATESYTD('date_dim'[d_date])), ALL('date_dim'[d_qoy]))), ALL('customer_address'[ca_state]))), "m1", IF([Archive Files] > 0, [Catalog Sales Same Period LY], ROUND(AVERAGE('catalog_sales'[cs_net_profit]), 0)), "m2", IF(ISBLANK(DIVIDE(VAR v = MIN('catalog_sales'[cs_net_profit]) RETURN v * 2 + MAX('store_sales'[ss_ext_sales_price]), CALCULATE([Store Revenue Same Period LY], ALL('item'[i_class])))), 0, CALCULATE(COUNTROWS(FILTER(VALUES('item'[i_brand]), COUNTROWS('item') > 10)), KEEPFILTERS('promotion'[p_promo_name] IN { "ought" }))))
