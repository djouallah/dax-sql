EVALUATE ROW("m0", CALCULATE([Catalog Sales Quantity], ALLEXCEPT('item', 'item'[i_category])), "m1", COUNTROWS(FILTER(VALUES('item'[i_class]), AVERAGE('store_sales'[ss_quantity]) > 1)), "m2", MIN('catalog_sales'[cs_quantity]))
