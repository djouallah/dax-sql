// note: a random query (conformance/tools/fuzz.mjs tpcds 150 20261125 fuzz3, number 2)
EVALUATE ADDCOLUMNS(VALUES('store'[s_state]), "m0", DIVIDE([Archive Source Rows], CALCULATE(AVERAGE('catalog_sales'[cs_quantity]), ALL('item'[i_category]))), "m1", CALCULATE(MAX([Catalog Net Profit], SUM('catalog_sales'[cs_quantity])), ALLSELECTED('customer_demographics'[cd_education_status])))
