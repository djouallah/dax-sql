// note: a random query (conformance/tools/fuzz.mjs tpcds 150 20261125 fuzz3, number 7)
EVALUATE SUMMARIZECOLUMNS('item'[i_class], 'item'[i_color], 'item'[i_category], "m0", VAR v = TOTALYTD(COUNTROWS('store'), 'date_dim'[d_date]) RETURN v * 2 + DIVIDE([Store Profit % by Item Category], CALCULATE([Store Profit % by Item Category], ALL('customer_address'[ca_state]))), "m1", MIN('store_sales'[ss_quantity]), "m2", DIVIDE(IF(ISINSCOPE('customer_demographics'[cd_marital_status]), [Catalog Sales Same Period LY], [Catalog Sales Quantity]), COUNTROWS(FILTER(VALUES('customer_demographics'[cd_education_status]), [Store Revenue YoY] > 1000))))
