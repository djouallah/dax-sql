EVALUATE ADDCOLUMNS(CROSSJOIN(VALUES('customer_demographics'[cd_marital_status]), VALUES('ship_mode'[sm_type])), "m0", DIVIDE(COUNTROWS('store_sales'), CALCULATE([Store Revenue Same Period LY], DATESINPERIOD('date_dim'[d_date], DATE(2026, 1, 8), -3, MONTH))))
