// note: a random query (conformance/tools/fuzz.mjs tpcds 150 20261125 fuzz3, number 10)
EVALUATE TOPN(3, ADDCOLUMNS(VALUES('promotion'[p_promo_name]), "m0", SWITCH(TRUE(), AVERAGEX(VALUES('item'[i_category]), [Store Profit % by Item Category]) > 1000, [Catalog Revenue], SUMX(SUMMARIZE('store_sales', 'store'[s_store_name]), [Store Net Profit]) < 0, IF(HASONEVALUE('customer_address'[ca_state]), MIN('store_sales'[ss_net_profit])), CALCULATE(COUNTROWS('store'), FILTER(ALL('date_dim'[d_moy]), 'date_dim'[d_moy] <> 7), ALLSELECTED('store_sales')))), [m0], DESC, 'promotion'[p_promo_name], ASC)
