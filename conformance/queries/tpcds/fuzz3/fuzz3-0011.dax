// note: a random query (conformance/tools/fuzz.mjs tpcds 150 20261125 fuzz3, number 11)
EVALUATE ROW("m0", IF(ISINSCOPE('item'[i_current_price]), IF(COUNTROWS(FILTER(VALUES('customer_demographics'[cd_education_status]), SUM('catalog_sales'[cs_ext_sales_price]) > 0)) > 0, SWITCH(TRUE(), MAX('catalog_sales'[cs_ext_sales_price]) > 100, MAX('store_sales'[ss_net_profit]), MAX('catalog_sales'[cs_net_profit]) < 0, [Store Distinct Customers], [Archive Source Rows]), LEN(LEFT(UPPER(CONCATENATEX(VALUES('date_dim'[d_year]), 'date_dim'[d_year], "|", 'date_dim'[d_year], ASC)), 6))), ABS([Store Distinct Customers])), "m1", SUMX(SUMMARIZE('catalog_sales', 'customer_demographics'[cd_marital_status]), IF(ISINSCOPE('promotion'[p_promo_name]), MAX(DISTINCTCOUNT('item'[i_color]), [Archive Source Rows]), IF(SELECTEDVALUE('item'[i_brand]) = "amalgpack #6", [Store Net Profit], [Store Distinct Customers]))))
