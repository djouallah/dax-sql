// note: a random query (conformance/tools/fuzz.mjs tpcds 150 20261125 fuzz3, number 22)
EVALUATE SUMMARIZECOLUMNS('date_dim'[d_qoy], 'promotion'[p_promo_name], "m0", CALCULATE(RANKX(ALL('item'[i_current_price]), MAX('catalog_sales'[cs_quantity])), DATESBETWEEN('date_dim'[d_date], DATE(2026, 12, 26), DATE(2024, 11, 17))), "m1", DIVIDE(CALCULATE(COUNTROWS('catalog_sales'), DATESBETWEEN('date_dim'[d_date], DATE(2025, 9, 23), DATE(2024, 10, 5))), [Catalog Net Profit]), "m2", [Catalog Sales Quantity])
