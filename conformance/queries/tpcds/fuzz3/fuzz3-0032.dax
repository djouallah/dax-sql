// note: a random query (conformance/tools/fuzz.mjs tpcds 150 20261125 fuzz3, number 32)
EVALUATE SUMMARIZECOLUMNS('promotion'[p_promo_name], TREATAS({ "able" }, 'store'[s_store_name]), FILTER(ALL('store'[s_store_name]), 'store'[s_store_name] <> "anti"), "m0", SWITCH(TRUE(), TOTALYTD(AVERAGE('catalog_sales'[cs_ext_sales_price]), 'date_dim'[d_date]) > 100, [Store Distinct Customers], (COUNTROWS('store') + COUNTROWS('store_sales')) < 100, IF(ISINSCOPE('item'[i_color]), [Catalog Sales Quantity], MAX('catalog_sales'[cs_ext_sales_price])), [Store Net Profit]), "m1", [Catalog Sales YoY])
