// note: a random query (conformance/tools/fuzz.mjs tpcds 150 20261125 fuzz3, number 34)
EVALUATE ADDCOLUMNS(VALUES('store'[s_state]), "m0", SUMX(SUMMARIZE('catalog_sales', 'customer_demographics'[cd_education_status]), CALCULATE([Catalog Net Profit], DATESINPERIOD('date_dim'[d_date], DATE(2025, 1, 11), -1, MONTH))), "m1", CALCULATE(COUNTROWS(FILTER(VALUES('date_dim'[d_qoy]), [Store Revenue] > 10)), ALLSELECTED('item'[i_category])))
