// note: a random query (conformance/tools/fuzz.mjs tpcds 150 20261125 fuzz3, number 42)
EVALUATE SUMMARIZECOLUMNS(TREATAS({ "anti" }, 'store'[s_store_name]), "m0", ABS(SWITCH(TRUE(), LEN(LEFT(UPPER(CONCATENATEX(VALUES('ship_mode'[sm_type]), 'ship_mode'[sm_type], "|", 'ship_mode'[sm_type], ASC)), 6)) > 100, IF(HASONEVALUE('item'[i_brand]), DISTINCTCOUNT('item'[i_current_price])), RANKX(ALL('customer_demographics'[cd_marital_status]), MAX('catalog_sales'[cs_net_profit]), , DESC, Dense) < 0, [Store Net Profit], IF(OR([Archive Files] > 1000, NOT(ISBLANK([Archive Source Rows]))), [Archive Source Rows], MAX('store_sales'[ss_ext_sales_price])))), "m1", VAR v = SWITCH(TRUE(), IF(OR(COUNTROWS('store_sales') > 1, NOT(ISBLANK([Store Revenue Same Period LY]))), SUM('catalog_sales'[cs_quantity]), DISTINCTCOUNT('customer_demographics'[cd_education_status])) > 1000, IF(AND([Store Net Profit] > 1, NOT(ISBLANK(MAX('catalog_sales'[cs_net_profit])))), [Catalog Revenue], [Store Revenue Same Period LY]), CALCULATE(AVERAGE('catalog_sales'[cs_quantity]), FILTER(VALUES('item'[i_class]), CALCULATE(AVERAGE('store_sales'[ss_ext_sales_price]), DATESBETWEEN('date_dim'[d_date], DATE(2026, 2, 12), DATE(2025, 6, 12))) > 100), FILTER(ALL('promotion'[p_promo_name]), 'promotion'[p_promo_name] <> "barought")) < 10, CALCULATE([Catalog Sales Same Period LY], INDEX(1, ALL('date_dim'[d_moy]), ORDERBY('date_dim'[d_moy], ASC))), SWITCH(TRUE(), MIN('store_sales'[ss_ext_sales_price]) > 0, MIN('catalog_sales'[cs_quantity]), [Catalog Sales YoY] < 100, COUNTROWS('store_sales'), [Catalog Sales YoY])) RETURN v * 2 + IF(SELECTEDVALUE('date_dim'[d_qoy]) = 1, COUNTROWS(FILTER(VALUES('store'[s_state]), COUNTROWS('catalog_sales') > 100)), CALCULATE([Catalog Revenue], INDEX(2, ALL('date_dim'[d_year]), ORDERBY('date_dim'[d_year], ASC)))), "m2", IF(ISINSCOPE('store'[s_store_name]), [Archive Source Rows], MAXX(VALUES('date_dim'[d_year]), [Store Profit % by Item Category])))
