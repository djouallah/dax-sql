// note: a random query (conformance/tools/fuzz.mjs tpcds 150 20261125 fuzz3, number 51)
EVALUATE TOPN(3, SUMMARIZECOLUMNS('date_dim'[d_year], "m0", VAR v = IF(AND(COUNTROWS(UNION(VALUES('customer_demographics'[cd_education_status]), VALUES('customer_demographics'[cd_education_status]))) > 0, NOT(ISBLANK(COUNTROWS(FILTER(VALUES('item'[i_brand]), [Catalog Sales Quantity] > 1000))))), IF(AND([Store Revenue] > 1, NOT(ISBLANK([Store Profit % by Item Category]))), [Store Revenue YoY], MIN('catalog_sales'[cs_ext_sales_price])), DISTINCTCOUNT('store'[s_store_name])) RETURN v * 2 + [Store Revenue Same Period LY]), [m0], ASC)
