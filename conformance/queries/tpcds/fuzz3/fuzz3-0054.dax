// note: a random query (conformance/tools/fuzz.mjs tpcds 150 20261125 fuzz3, number 54)
EVALUATE SUMMARIZECOLUMNS('item'[i_class], FILTER(ALL('item'[i_class]), 'item'[i_class] <> "dresses"), "m0", [Store Revenue Same Period LY], "m1", ABS(SWITCH(TRUE(), MAX('catalog_sales'[cs_net_profit]) > 10, [Store Revenue], CALCULATE([Catalog Revenue], DATESBETWEEN('date_dim'[d_date], DATE(2026, 9, 13), DATE(2025, 3, 9))) < 100, COALESCE([Archive Files], 0), ([Store Revenue Same Period LY] + MAX('store_sales'[ss_quantity])))), "m2", CALCULATE(MIN('catalog_sales'[cs_net_profit]), DATESBETWEEN('date_dim'[d_date], DATE(2024, 7, 16), DATE(2024, 9, 22))))
