// note: a random query (conformance/tools/fuzz.mjs tpcds 150 20261125 fuzz3, number 58)
EVALUATE ROW("m0", IF(SELECTEDVALUE('customer_demographics'[cd_marital_status]) = "zz-none", CALCULATE([Store Revenue YTD], ALLSELECTED('customer_demographics'[cd_education_status])), DIVIDE([Store Revenue Same Period LY], [Store Revenue])), "m1", DIVIDE(CALCULATE([Catalog Sales Quantity], TREATAS({ "4 yr Degree", "2 yr Degree", "Unknown" }, 'customer_demographics'[cd_education_status])), CALCULATE(COUNTROWS('item'), KEEPFILTERS('date_dim'[d_moy] IN { 9 }), DATESYTD('date_dim'[d_date]))))
