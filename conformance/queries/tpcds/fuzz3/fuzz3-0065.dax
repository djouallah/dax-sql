// note: a random query (conformance/tools/fuzz.mjs tpcds 150 20261125 fuzz3, number 65)
EVALUATE TOPN(3, SUMMARIZECOLUMNS('ship_mode'[sm_type], "m0", ABS(CALCULATE(AVERAGE('store_sales'[ss_net_profit]), KEEPFILTERS('date_dim'[d_qoy] IN { 2, 1 }), TREATAS({ "coral" }, 'item'[i_color])))), [m0], ASC)
