// note: a random query (conformance/tools/fuzz.mjs tpcds 150 20261125 fuzz3, number 71)
EVALUATE SUMMARIZECOLUMNS('customer_demographics'[cd_education_status], "m0", CALCULATE(SWITCH(TRUE(), SWITCH(TRUE(), [Archive Source Rows] > 1, SUM('store_sales'[ss_ext_sales_price]), COUNTROWS('store_sales') < 100, AVERAGE('store_sales'[ss_ext_sales_price]), [Store Profit % by Item Category]) > 0, CALCULATE(AVERAGE('catalog_sales'[cs_net_profit]), DATESBETWEEN('date_dim'[d_date], DATE(1999, 1, 1), DATE(2025, 1, 10))), COUNTROWS(FILTER(VALUES('item'[i_class]), [Store Distinct Customers] > 100)) < 0, ROUND([Store Revenue], 1), DIVIDE([Catalog Net Profit], CALCULATE([Catalog Sales YoY], ALL('store'[s_state])))), PARALLELPERIOD('date_dim'[d_date], -1, YEAR)))
