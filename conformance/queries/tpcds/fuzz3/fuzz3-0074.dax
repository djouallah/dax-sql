// note: a random query (conformance/tools/fuzz.mjs tpcds 150 20261125 fuzz3, number 74)
EVALUATE SUMMARIZE('catalog_sales', 'store'[s_city], "m0", [Store Revenue YTD], "m1", IF(AND(COALESCE([Catalog Sales Quantity], 0) > 100, NOT(ISBLANK(CALCULATE(COUNTROWS(FILTER(VALUES('customer_demographics'[cd_education_status]), [Store Net Profit] > 100)), ALLSELECTED('item'[i_class]))))), COALESCE(IF([Catalog Revenue] > 10, MAX('store_sales'[ss_ext_sales_price]), AVERAGE('catalog_sales'[cs_ext_sales_price])), 0), CALCULATE(LEN(LEFT(UPPER(CONCATENATEX(VALUES('store'[s_state]), 'store'[s_state], "|", 'store'[s_state], ASC)), 3)), DATESBETWEEN('date_dim'[d_date], DATE(2024, 5, 27), DATE(2024, 7, 17)))))
