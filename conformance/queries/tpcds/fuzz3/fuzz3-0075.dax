// note: a random query (conformance/tools/fuzz.mjs tpcds 150 20261125 fuzz3, number 75)
EVALUATE SUMMARIZECOLUMNS('item'[i_category], 'item'[i_current_price], FILTER(VALUES('ship_mode'[sm_type]), 'ship_mode'[sm_type] IN { "zz-none", "OVERNIGHT" }), FILTER(VALUES('date_dim'[d_qoy]), 'date_dim'[d_qoy] IN { 1 }), "m0", SWITCH(TRUE(), COUNTROWS('store') > 1, VAR v = IF(ISINSCOPE('item'[i_category]), [Store Distinct Customers], DISTINCTCOUNT('item'[i_class])) RETURN v * 2 + IF(SELECTEDVALUE('item'[i_color]) = "khaki", [Store Revenue Same Period LY], MAX('catalog_sales'[cs_ext_sales_price])), [Store Revenue YoY] < 10, DIVIDE(CALCULATE(DISTINCTCOUNT('date_dim'[d_qoy]), FILTER(ALL('item'[i_class]), 'item'[i_class] <> "fiction")), CALCULATE(LEN(LEFT(UPPER(CONCATENATEX(VALUES('store'[s_state]), 'store'[s_state], "|", 'store'[s_state], ASC)), 2)), ALL('item'[i_color]))), [Catalog Revenue]))
