// note: a random query (conformance/tools/fuzz.mjs tpcds 150 20261125 fuzz3, number 80)
EVALUATE TOPN(1, ADDCOLUMNS(VALUES('item'[i_current_price]), "m0", IF(IF(ISINSCOPE('item'[i_brand]), TOTALYTD(AVERAGE('catalog_sales'[cs_net_profit]), 'date_dim'[d_date]), IF(HASONEVALUE('item'[i_color]), COUNTROWS('store_sales'))) > 1, COUNTROWS(UNION(VALUES('customer_address'[ca_state]), VALUES('customer_address'[ca_state]))), CALCULATE(RANKX(ALL('item'[i_color]), DISTINCTCOUNT('customer_demographics'[cd_education_status])), PARALLELPERIOD('date_dim'[d_date], -1, YEAR)))), [m0], DESC, 'item'[i_current_price], ASC)
