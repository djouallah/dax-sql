// note: a random query (conformance/tools/fuzz.mjs tpcds 150 20261125 fuzz3, number 86)
EVALUATE ADDCOLUMNS(VALUES('item'[i_class]), "m0", IF(HASONEVALUE('store'[s_state]), [Store Profit % by Item Category]), "m1", IF(DIVIDE(SUM('catalog_sales'[cs_ext_sales_price]), CALCULATE([Catalog Sales Same Period LY], ALL('customer_demographics'[cd_marital_status]))) > 0, CALCULATE([Store Distinct Customers], DATESBETWEEN('date_dim'[d_date], DATE(2026, 5, 13), DATE(2026, 4, 28))), IF(MAX('store_sales'[ss_ext_sales_price]) > 1000, MIN('catalog_sales'[cs_ext_sales_price]), MIN('catalog_sales'[cs_quantity]))))
