// note: a random query (conformance/tools/fuzz.mjs tpcds 150 20261125 fuzz3, number 98)
EVALUATE TOPN(2, SUMMARIZECOLUMNS('customer_address'[ca_state], "m0", SUMX(SUMMARIZE('store_sales', 'date_dim'[d_moy]), MAXX(VALUES('store'[s_city]), IF(AND([Archive Files] > 1000, NOT(ISBLANK(DISTINCTCOUNT('date_dim'[d_qoy])))), [Store Net Profit], MIN('catalog_sales'[cs_ext_sales_price]))))), [m0], ASC)
