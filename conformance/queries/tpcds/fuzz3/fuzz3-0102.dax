// note: a random query (conformance/tools/fuzz.mjs tpcds 150 20261125 fuzz3, number 102)
EVALUATE SUMMARIZECOLUMNS('promotion'[p_promo_name], 'item'[i_class], "m0", COALESCE(CALCULATE(MAX('store_sales'[ss_quantity]), DATESBETWEEN('date_dim'[d_date], DATE(2024, 5, 30), DATE(2026, 8, 3))), 0), "m1", DIVIDE(MAX('store_sales'[ss_quantity]), [Store Revenue YTD]), "m2", IF(AND(COUNTROWS(UNION(VALUES('item'[i_category]), VALUES('item'[i_category]))) > 1, NOT(ISBLANK(RANKX(ALL('customer_address'[ca_state]), [Archive Source Rows])))), [Store Revenue], COALESCE([Store Profit % by Item Category], 0)))
