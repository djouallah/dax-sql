// note: a random query (conformance/tools/fuzz.mjs tpcds 150 20261125 fuzz3, number 110)
EVALUATE SUMMARIZECOLUMNS(KEEPFILTERS(TREATAS({ "zz-none", "S", "M" }, 'customer_demographics'[cd_marital_status])), FILTER(VALUES('item'[i_brand]), 'item'[i_brand] IN { "scholaruniv #4", "exportcorp #7" }), "m0", IF(SUM('catalog_sales'[cs_quantity]) > 1, IF(HASONEVALUE('item'[i_class]), CALCULATE(MAX('store_sales'[ss_net_profit]), 'store'[s_store_name] <> "able", KEEPFILTERS('date_dim'[d_year] IN { 2024, 2026 }))), MAX('store_sales'[ss_quantity])), "m1", DIVIDE(LEN(LEFT(UPPER(CONCATENATEX(VALUES('store'[s_city]), 'store'[s_city], "|", 'store'[s_city], ASC)), 5)), CALCULATE(CALCULATE(DISTINCTCOUNT('promotion'[p_promo_name]), KEEPFILTERS('promotion'[p_promo_name] IN { "bar" })), ALLSELECTED('item'), 'customer_demographics'[cd_marital_status] >= "S")))
