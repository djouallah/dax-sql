// note: a random query (conformance/tools/fuzz.mjs tpcds 150 20261125 fuzz3, number 121)
EVALUATE SUMMARIZECOLUMNS("m0", CALCULATE([Store Profit % by Item Category], INDEX(2, ALL('ship_mode'[sm_type]), ORDERBY('ship_mode'[sm_type], ASC))), "m1", SWITCH(TRUE(), CALCULATE(MAX('catalog_sales'[cs_quantity]), INDEX(-1, ALL('store'[s_state]), ORDERBY('store'[s_state], DESC))) > 10, CALCULATE(AVERAGE('catalog_sales'[cs_ext_sales_price]), ALLSELECTED('store'[s_store_name])), SUMX(SUMMARIZE('catalog_sales', 'store'[s_store_name]), [Catalog Sales Quantity]) < 100, IF(OR(MIN('store_sales'[ss_quantity]) > 1, NOT(ISBLANK(SUM('catalog_sales'[cs_ext_sales_price])))), MIN('catalog_sales'[cs_net_profit]), [Catalog Net Profit]), [Catalog Sales Quantity]))
