// note: a random query (conformance/tools/fuzz.mjs tpcds 150 20261125 fuzz3, number 126)
EVALUATE SUMMARIZECOLUMNS('customer_demographics'[cd_marital_status], 'item'[i_category], 'item'[i_current_price], "m0", CALCULATE(CALCULATE([Store Net Profit], INDEX(1, ALL('date_dim'[d_year]), ORDERBY('date_dim'[d_year], ASC))), DATESINPERIOD('date_dim'[d_date], DATE(1999, 1, 1), -1, MONTH)), "m1", [Store Net Profit], "m2", DIVIDE(LEN(CONCATENATEX(VALUES('customer_address'[ca_state]), 'customer_address'[ca_state], ",")), DIVIDE(MAX('catalog_sales'[cs_net_profit]), CALCULATE(AVERAGE('store_sales'[ss_ext_sales_price]), ALL('item'[i_color])))))
