// note: a random query (conformance/tools/fuzz.mjs tpcds 150 20261125 fuzz3, number 131)
EVALUATE ROW("m0", IF([Store Revenue Same Period LY] > 100, IF(OR(CALCULATE([Archive Source Rows], INDEX(1, ALL('date_dim'[d_moy]), ORDERBY('date_dim'[d_moy], DESC))) > 10, NOT(ISBLANK(SWITCH(TRUE(), DISTINCTCOUNT('customer_demographics'[cd_marital_status]) > 1000, MIN('store_sales'[ss_quantity]), [Catalog Net Profit] < 100, [Store Profit % by Item Category], AVERAGE('store_sales'[ss_net_profit]))))), MIN('store_sales'[ss_ext_sales_price]), [Catalog Sales Same Period LY]), CALCULATE(([Store Net Profit] - [Store Revenue YoY]), ALLSELECTED('promotion'[p_promo_name]))))
