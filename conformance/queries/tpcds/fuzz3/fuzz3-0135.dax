// note: a random query (conformance/tools/fuzz.mjs tpcds 150 20261125 fuzz3, number 135)
EVALUATE SUMMARIZECOLUMNS(FILTER(ALL('store'[s_state]), 'store'[s_state] <> "TX"), FILTER(VALUES('promotion'[p_promo_name]), 'promotion'[p_promo_name] IN { "cally", "pri" }), "m0", ([Catalog Revenue] + VAR v = AVERAGE('store_sales'[ss_quantity]) RETURN v * 2 + IF(SELECTEDVALUE('date_dim'[d_year]) = 2024, DISTINCTCOUNT('item'[i_current_price]), MAX('store_sales'[ss_quantity]))), "m1", TOTALYTD(COALESCE(AVERAGE('catalog_sales'[cs_ext_sales_price]), 0), 'date_dim'[d_date]), "m2", CALCULATE(CALCULATE(DISTINCTCOUNT('item'[i_brand]), PARALLELPERIOD('date_dim'[d_date], -1, QUARTER)), NOT('item'[i_color] IN { "snow" })))
