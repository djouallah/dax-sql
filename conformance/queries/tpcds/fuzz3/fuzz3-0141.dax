// note: a random query (conformance/tools/fuzz.mjs tpcds 150 20261125 fuzz3, number 141)
EVALUATE SUMMARIZECOLUMNS("m0", IF(HASONEVALUE('item'[i_brand]), VAR v = [Catalog Sales YoY] RETURN v * 2 + MAX('catalog_sales'[cs_ext_sales_price])), "m1", RANKX(ALL('store'[s_store_name]), MIN('store_sales'[ss_quantity])), "m2", CALCULATE(IF(ISBLANK(IF(ISINSCOPE('customer_demographics'[cd_education_status]), COUNTROWS('item'), [Catalog Sales Quantity])), 0, CALCULATE([Catalog Sales Quantity], INDEX(-1, ALL('date_dim'[d_moy]), ORDERBY('date_dim'[d_moy], DESC)))), PREVIOUSMONTH('date_dim'[d_date])))
