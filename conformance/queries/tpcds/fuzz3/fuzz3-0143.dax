// note: a random query (conformance/tools/fuzz.mjs tpcds 150 20261125 fuzz3, number 143)
EVALUATE SUMMARIZECOLUMNS("m0", IF(COUNTROWS('catalog_sales') > 0, COALESCE(CALCULATE([Store Revenue Same Period LY], ALL('customer_demographics'[cd_marital_status]), ALL('item'[i_color])), 0), MIN('store_sales'[ss_quantity])), "m1", RANKX(ALL('item'[i_brand]), SWITCH(TRUE(), DIVIDE([Archive Files], CALCULATE([Archive Source Rows], ALL('store'[s_city]))) > 100, SUM('catalog_sales'[cs_ext_sales_price]), DISTINCTCOUNT('customer_demographics'[cd_education_status]) < 100, SWITCH(TRUE(), COUNTROWS('catalog_sales') > 100, [Store Net Profit], [Store Net Profit] < 100, [Archive Source Rows], COUNTROWS('item')), IF([Catalog Net Profit] > 1000, [Store Distinct Customers], COUNTROWS('catalog_sales')))), "m2", CALCULATE([Store Revenue Same Period LY], REMOVEFILTERS('store_sales')))
