// note: a random query (conformance/tools/fuzz.mjs tpcds 150 20261125 fuzz3, number 148)
EVALUATE TOPN(5, ADDCOLUMNS(VALUES('customer_demographics'[cd_marital_status]), "m0", DIVIDE(IF(MIN('store_sales'[ss_net_profit]) > 1000, MAX('store_sales'[ss_quantity]), [Archive Source Rows]), IF(HASONEVALUE('date_dim'[d_year]), AVERAGE('store_sales'[ss_quantity])))), [m0], DESC, 'customer_demographics'[cd_marital_status], ASC)
