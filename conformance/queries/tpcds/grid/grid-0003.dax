// note: the view expander's grid (tools/ossie/grid.mjs), two metrics: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.ss_quantity, AGG(t."Store Revenue") AS a, AGG(t."Store Net Profit") AS b FROM tpcds.store_sales AS t GROUP BY t.ss_quantity
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('store_sales'[ss_quantity], "__rows", COUNTROWS('store_sales'), "a", 'store_sales'[Store Revenue], "b", 'store_sales'[Store Net Profit]), "ss_quantity", 'store_sales'[ss_quantity], "a", [a], "b", [b])
