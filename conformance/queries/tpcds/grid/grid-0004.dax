// note: the view expander's grid (tools/ossie/grid.mjs), two groups: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.ss_quantity, t.ss_addr_sk, AGG(t."Store Revenue") AS v FROM tpcds.store_sales AS t GROUP BY t.ss_quantity, t.ss_addr_sk
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('store_sales'[ss_quantity], 'store_sales'[ss_addr_sk], "__rows", COUNTROWS('store_sales'), "v", 'store_sales'[Store Revenue]), "ss_quantity", 'store_sales'[ss_quantity], "ss_addr_sk", 'store_sales'[ss_addr_sk], "v", [v])
