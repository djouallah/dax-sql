// note: the view expander's grid (tools/ossie/grid.mjs), where: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.ss_quantity, AGG(t."Store Revenue") AS v FROM tpcds.store_sales AS t WHERE t.ss_ticket_number = 300 GROUP BY t.ss_quantity
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('store_sales'[ss_quantity], "__rows", COUNTROWS(store_sales), "v", 'store_sales'[Store Revenue]), ('store_sales'[ss_ticket_number] = 300)), "ss_quantity", 'store_sales'[ss_quantity], "v", [v])
