// note: the view expander's grid (tools/ossie/grid.mjs), where total: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT AGG(t."Store Distinct Customers") AS v FROM tpcds.store_sales AS t WHERE t.cache_buster >= 2
EVALUATE SELECTCOLUMNS(CALCULATETABLE(ROW("v", 'store_sales'[Store Distinct Customers]), ('store_sales'[cache_buster] >= 2)), "v", [v])
