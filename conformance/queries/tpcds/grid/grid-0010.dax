// note: the view expander's grid (tools/ossie/grid.mjs), having null: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.ss_quantity, AGG(t."Store Distinct Customers") AS v FROM tpcds.store_sales AS t GROUP BY t.ss_quantity HAVING AGG(t."Store Revenue") IS NOT NULL
EVALUATE SELECTCOLUMNS(FILTER(SUMMARIZECOLUMNS('store_sales'[ss_quantity], "__rows", COUNTROWS(store_sales), "v", 'store_sales'[Store Distinct Customers]), NOT(ISBLANK('store_sales'[Store Revenue]))), "ss_quantity", 'store_sales'[ss_quantity], "v", [v])
