// note: the view expander's grid (tools/ossie/grid.mjs), order limit: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.ss_quantity, AGG(t."Store Distinct Customers") AS v FROM tpcds.store_sales AS t GROUP BY t.ss_quantity ORDER BY t.ss_quantity NULLS FIRST LIMIT 3
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('store_sales'[ss_quantity], "__rows", COUNTROWS(store_sales), "v", 'store_sales'[Store Distinct Customers]), "ss_quantity", 'store_sales'[ss_quantity], "v", [v]) ORDER BY [ss_quantity]
