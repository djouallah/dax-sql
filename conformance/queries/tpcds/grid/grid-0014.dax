// note: the view expander's grid (tools/ossie/grid.mjs), rollup: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.cache_buster, AGG(t."Store Net Profit") AS v FROM tpcds.store_sales AS t GROUP BY ROLLUP (t.cache_buster) ORDER BY t.cache_buster NULLS LAST
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS(ROLLUPADDISSUBTOTAL('store_sales'[cache_buster], "__level1_cache_buster"), "__rows", COUNTROWS(store_sales), "v", 'store_sales'[Store Net Profit]), "cache_buster", 'store_sales'[cache_buster], "v", [v]) ORDER BY ISBLANK([cache_buster]), [cache_buster]
