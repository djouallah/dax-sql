// note: the view expander's grid (tools/ossie/grid.mjs), scalar ops: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.ss_quantity, AGG(t."Store Distinct Customers") * 2 AS a, AGG(t."Store Distinct Customers") + 1 AS b, COALESCE(AGG(t."Store Distinct Customers"), 0) AS c FROM tpcds.store_sales AS t GROUP BY t.ss_quantity
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('store_sales'[ss_quantity], "__rows", COUNTROWS('store_sales'), "a", ('store_sales'[Store Distinct Customers] * 2), "b", ('store_sales'[Store Distinct Customers] + 1), "c", IF(ISBLANK(COUNTROWS('store_sales')), BLANK(), COALESCE('store_sales'[Store Distinct Customers], 0))), "ss_quantity", 'store_sales'[ss_quantity], "a", [a], "b", [b], "c", [c])
