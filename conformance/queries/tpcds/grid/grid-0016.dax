// note: the view expander's grid (tools/ossie/grid.mjs), ratio: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.ss_quantity, CAST(AGG(t."Store Distinct Customers") AS DOUBLE) / NULLIF(AGG(t."Store Revenue"), 0) AS r FROM tpcds.store_sales AS t GROUP BY t.ss_quantity
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('store_sales'[ss_quantity], "__rows", COUNTROWS('store_sales'), "r", IF(ISBLANK(COUNTROWS('store_sales')), BLANK(), (CONVERT('store_sales'[Store Distinct Customers], DOUBLE) / IF(('store_sales'[Store Revenue] == 0), BLANK(), 'store_sales'[Store Revenue])))), "ss_quantity", 'store_sales'[ss_quantity], "r", [r])
