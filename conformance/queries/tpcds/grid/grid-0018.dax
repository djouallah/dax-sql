// note: the view expander's grid (tools/ossie/grid.mjs), derived table: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT s.ss_quantity, s.v FROM (SELECT t.ss_quantity, AGG(t."Store Net Profit") AS v FROM tpcds.store_sales AS t GROUP BY t.ss_quantity) AS s WHERE s.v IS NOT NULL
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('store_sales'[ss_quantity], "__rows", COUNTROWS(store_sales), "v", 'store_sales'[Store Net Profit]), "ss_quantity", 'store_sales'[ss_quantity], "v", [v])
