// note: the view expander's grid (tools/ossie/grid.mjs), snowflake: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT c.i_brand, AGG(f."Store Distinct Customers") AS v FROM tpcds.store_sales AS f JOIN tpcds.promotion AS b ON f.ss_promo_sk = b.p_promo_sk JOIN tpcds.item AS c ON b.p_item_sk = c.i_item_sk GROUP BY c.i_brand
DEFINE
VAR __v1 = GENERATE(GENERATE(SELECTCOLUMNS(store_sales, "f.cache_buster", 'store_sales'[cache_buster], "f.ss_addr_sk", 'store_sales'[ss_addr_sk], "f.ss_cdemo_sk", 'store_sales'[ss_cdemo_sk], "f.ss_customer_sk", 'store_sales'[ss_customer_sk], "f.ss_item_sk", 'store_sales'[ss_item_sk], "f.ss_promo_sk", 'store_sales'[ss_promo_sk], "f.ss_sold_date_sk", 'store_sales'[ss_sold_date_sk], "f.ss_store_sk", 'store_sales'[ss_store_sk], "f.ss_ticket_number", 'store_sales'[ss_ticket_number], "f.ss_quantity", 'store_sales'[ss_quantity], "f.ss_ext_list_price", 'store_sales'[ss_ext_list_price], "f.ss_ext_sales_price", 'store_sales'[ss_ext_sales_price], "f.ss_list_price", 'store_sales'[ss_list_price], "f.ss_net_profit", 'store_sales'[ss_net_profit]), FILTER(SELECTCOLUMNS(promotion, "b.p_promo_sk", 'promotion'[p_promo_sk], "b.p_item_sk", 'promotion'[p_item_sk]), ([f.ss_promo_sk] = [b.p_promo_sk]))), FILTER(SELECTCOLUMNS(item, "c.i_item_sk", 'item'[i_item_sk], "c.i_brand", 'item'[i_brand]), ([b.p_item_sk] = [c.i_item_sk])))
VAR __v2 = DISTINCT(SELECTCOLUMNS(__v1, "i_brand", [c.i_brand]))
EVALUATE SELECTCOLUMNS(ADDCOLUMNS(__v2, "__m1", CALCULATE('store_sales'[Store Distinct Customers], REMOVEFILTERS(), TREATAS(SELECTCOLUMNS(FILTER(__v1, (NOT((((((((((((((ISBLANK([f.cache_buster]) && ISBLANK([f.ss_addr_sk])) && ISBLANK([f.ss_cdemo_sk])) && ISBLANK([f.ss_customer_sk])) && ISBLANK([f.ss_item_sk])) && ISBLANK([f.ss_promo_sk])) && ISBLANK([f.ss_sold_date_sk])) && ISBLANK([f.ss_store_sk])) && ISBLANK([f.ss_ticket_number])) && ISBLANK([f.ss_quantity])) && ISBLANK([f.ss_ext_list_price])) && ISBLANK([f.ss_ext_sales_price])) && ISBLANK([f.ss_list_price])) && ISBLANK([f.ss_net_profit]))) && ([c.i_brand] == [i_brand]))), "__k1", [f.cache_buster], "__k2", [f.ss_addr_sk], "__k3", [f.ss_cdemo_sk], "__k4", [f.ss_customer_sk], "__k5", [f.ss_item_sk], "__k6", [f.ss_promo_sk], "__k7", [f.ss_sold_date_sk], "__k8", [f.ss_store_sk], "__k9", [f.ss_ticket_number], "__k10", [f.ss_quantity], "__k11", [f.ss_ext_list_price], "__k12", [f.ss_ext_sales_price], "__k13", [f.ss_list_price], "__k14", [f.ss_net_profit]), 'store_sales'[cache_buster], 'store_sales'[ss_addr_sk], 'store_sales'[ss_cdemo_sk], 'store_sales'[ss_customer_sk], 'store_sales'[ss_item_sk], 'store_sales'[ss_promo_sk], 'store_sales'[ss_sold_date_sk], 'store_sales'[ss_store_sk], 'store_sales'[ss_ticket_number], 'store_sales'[ss_quantity], 'store_sales'[ss_ext_list_price], 'store_sales'[ss_ext_sales_price], 'store_sales'[ss_list_price], 'store_sales'[ss_net_profit]))), "i_brand", [i_brand], "v", [__m1])
