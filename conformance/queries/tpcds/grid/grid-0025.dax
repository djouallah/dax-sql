// note: the view expander's grid (tools/ossie/grid.mjs), chasm: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.d_qoy, AGG(a."Catalog Revenue") AS x, AGG(b."Store Net Profit") AS y FROM tpcds.date_dim AS o LEFT JOIN tpcds.catalog_sales AS a ON a.cs_sold_date_sk = o.d_date_sk_1 LEFT JOIN tpcds.store_sales AS b ON b.ss_sold_date_sk = o.d_date_sk_1 GROUP BY o.d_qoy
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('date_dim'[d_qoy], "__rows", COUNTROWS('date_dim'), "x", CALCULATE('catalog_sales'[Catalog Revenue], KEEPFILTERS(NOT(ISBLANK('date_dim'[d_date_sk_1])))), "y", CALCULATE('store_sales'[Store Net Profit], KEEPFILTERS(NOT(ISBLANK('date_dim'[d_date_sk_1]))))), "d_qoy", 'date_dim'[d_qoy], "x", [x], "y", [y])
