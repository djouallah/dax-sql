// note: the view expander's grid (tools/ossie/grid.mjs), two metrics: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.ss_cdemo_sk, AGG(t."Store Net Profit") AS a, AGG(t."Store Net Profit") AS b FROM tpcds.store_sales AS t GROUP BY t.ss_cdemo_sk
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('store_sales'[ss_cdemo_sk], "__rows", COUNTROWS(store_sales), "a", 'store_sales'[Store Net Profit], "b", 'store_sales'[Store Net Profit]), "ss_cdemo_sk", 'store_sales'[ss_cdemo_sk], "a", [a], "b", [b])
