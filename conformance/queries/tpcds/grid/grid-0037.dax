// note: the view expander's grid (tools/ossie/grid.mjs), order by measure: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.ss_cdemo_sk, AGG(t."Store Revenue") AS v FROM tpcds.store_sales AS t GROUP BY t.ss_cdemo_sk ORDER BY v DESC NULLS LAST, t.ss_cdemo_sk NULLS FIRST
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('store_sales'[ss_cdemo_sk], "__rows", COUNTROWS('store_sales'), "v", 'store_sales'[Store Revenue]), "ss_cdemo_sk", 'store_sales'[ss_cdemo_sk], "v", [v]) ORDER BY [v] DESC, [ss_cdemo_sk]
