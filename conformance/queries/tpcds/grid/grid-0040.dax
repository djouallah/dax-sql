// note: the view expander's grid (tools/ossie/grid.mjs), scalar ops: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.ss_cdemo_sk, AGG(t."Store Revenue") * 2 AS a, AGG(t."Store Revenue") + 1 AS b, COALESCE(AGG(t."Store Revenue"), 0) AS c FROM tpcds.store_sales AS t GROUP BY t.ss_cdemo_sk
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('store_sales'[ss_cdemo_sk], "__rows", COUNTROWS('store_sales'), "a", ('store_sales'[Store Revenue] * 2), "b", ('store_sales'[Store Revenue] + 1), "c", IF(ISBLANK(COUNTROWS('store_sales')), BLANK(), COALESCE('store_sales'[Store Revenue], 0))), "ss_cdemo_sk", 'store_sales'[ss_cdemo_sk], "a", [a], "b", [b], "c", [c])
