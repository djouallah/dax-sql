// note: the view expander's grid (tools/ossie/grid.mjs), star where one: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.d_dow, AGG(f."Store Net Profit") AS v FROM tpcds.store_sales AS f LEFT JOIN tpcds.date_dim AS o ON f.ss_sold_date_sk = o.d_date_sk_1 WHERE NOT (o.d_quarter_name = '2024Q4') GROUP BY o.d_dow
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('date_dim'[d_dow], "__rows", COUNTROWS('store_sales'), "v", 'store_sales'[Store Net Profit]), NOT(('date_dim'[d_quarter_name] = "2024Q4"))), "d_dow", 'date_dim'[d_dow], "v", [v])
