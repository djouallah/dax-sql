// note: the view expander's grid (tools/ossie/grid.mjs), star two sides: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.d_dow, f.cache_buster, AGG(f."Store Revenue") AS v FROM tpcds.store_sales AS f LEFT JOIN tpcds.date_dim AS o ON f.ss_sold_date_sk = o.d_date_sk_1 GROUP BY o.d_dow, f.cache_buster
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('date_dim'[d_dow], 'store_sales'[cache_buster], "__rows", COUNTROWS(store_sales), "v", 'store_sales'[Store Revenue]), "d_dow", 'date_dim'[d_dow], "cache_buster", 'store_sales'[cache_buster], "v", [v])
