// note: the view expander's grid (tools/ossie/grid.mjs), snowflake: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT c.i_current_price, AGG(f."Catalog Net Profit") AS v FROM tpcds.catalog_sales AS f JOIN tpcds.promotion AS b ON f.cs_promo_sk = b.p_promo_sk JOIN tpcds.item AS c ON b.p_item_sk = c.i_item_sk GROUP BY c.i_current_price
DEFINE
VAR __v1 = GENERATE(GENERATE(SELECTCOLUMNS('catalog_sales', "f.cache_buster", 'catalog_sales'[cache_buster], "f.cs_bill_addr_sk", 'catalog_sales'[cs_bill_addr_sk], "f.cs_bill_cdemo_sk", 'catalog_sales'[cs_bill_cdemo_sk], "f.cs_catalog_page_sk", 'catalog_sales'[cs_catalog_page_sk], "f.cs_item_sk", 'catalog_sales'[cs_item_sk], "f.cs_promo_sk", 'catalog_sales'[cs_promo_sk], "f.cs_ship_addr_sk", 'catalog_sales'[cs_ship_addr_sk], "f.cs_ship_cdemo_sk", 'catalog_sales'[cs_ship_cdemo_sk], "f.cs_ship_mode_sk", 'catalog_sales'[cs_ship_mode_sk], "f.cs_sold_date_sk", 'catalog_sales'[cs_sold_date_sk], "f.cs_order_number", 'catalog_sales'[cs_order_number], "f.cs_quantity", 'catalog_sales'[cs_quantity], "f.cs_ext_list_price", 'catalog_sales'[cs_ext_list_price], "f.cs_ext_sales_price", 'catalog_sales'[cs_ext_sales_price], "f.cs_list_price", 'catalog_sales'[cs_list_price], "f.cs_net_profit", 'catalog_sales'[cs_net_profit]), FILTER(SELECTCOLUMNS('promotion', "b.p_promo_sk", 'promotion'[p_promo_sk], "b.p_item_sk", 'promotion'[p_item_sk]), ([f.cs_promo_sk] = [b.p_promo_sk]))), FILTER(SELECTCOLUMNS('item', "c.i_item_sk", 'item'[i_item_sk], "c.i_current_price", 'item'[i_current_price]), ([b.p_item_sk] = [c.i_item_sk])))
VAR __v2 = DISTINCT(SELECTCOLUMNS(__v1, "i_current_price", [c.i_current_price]))
EVALUATE SELECTCOLUMNS(ADDCOLUMNS(__v2, "__m1", CALCULATE('catalog_sales'[Catalog Net Profit], REMOVEFILTERS(), TREATAS(SELECTCOLUMNS(FILTER(__v1, (NOT((((((((((((((((ISBLANK([f.cache_buster]) && ISBLANK([f.cs_bill_addr_sk])) && ISBLANK([f.cs_bill_cdemo_sk])) && ISBLANK([f.cs_catalog_page_sk])) && ISBLANK([f.cs_item_sk])) && ISBLANK([f.cs_promo_sk])) && ISBLANK([f.cs_ship_addr_sk])) && ISBLANK([f.cs_ship_cdemo_sk])) && ISBLANK([f.cs_ship_mode_sk])) && ISBLANK([f.cs_sold_date_sk])) && ISBLANK([f.cs_order_number])) && ISBLANK([f.cs_quantity])) && ISBLANK([f.cs_ext_list_price])) && ISBLANK([f.cs_ext_sales_price])) && ISBLANK([f.cs_list_price])) && ISBLANK([f.cs_net_profit]))) && ([c.i_current_price] == [i_current_price]))), "__k1", [f.cache_buster], "__k2", [f.cs_bill_addr_sk], "__k3", [f.cs_bill_cdemo_sk], "__k4", [f.cs_catalog_page_sk], "__k5", [f.cs_item_sk], "__k6", [f.cs_promo_sk], "__k7", [f.cs_ship_addr_sk], "__k8", [f.cs_ship_cdemo_sk], "__k9", [f.cs_ship_mode_sk], "__k10", [f.cs_sold_date_sk], "__k11", [f.cs_order_number], "__k12", [f.cs_quantity], "__k13", [f.cs_ext_list_price], "__k14", [f.cs_ext_sales_price], "__k15", [f.cs_list_price], "__k16", [f.cs_net_profit]), 'catalog_sales'[cache_buster], 'catalog_sales'[cs_bill_addr_sk], 'catalog_sales'[cs_bill_cdemo_sk], 'catalog_sales'[cs_catalog_page_sk], 'catalog_sales'[cs_item_sk], 'catalog_sales'[cs_promo_sk], 'catalog_sales'[cs_ship_addr_sk], 'catalog_sales'[cs_ship_cdemo_sk], 'catalog_sales'[cs_ship_mode_sk], 'catalog_sales'[cs_sold_date_sk], 'catalog_sales'[cs_order_number], 'catalog_sales'[cs_quantity], 'catalog_sales'[cs_ext_list_price], 'catalog_sales'[cs_ext_sales_price], 'catalog_sales'[cs_list_price], 'catalog_sales'[cs_net_profit]))), "i_current_price", [i_current_price], "v", [__m1])
