// note: the view expander's grid (tools/ossie/grid.mjs), chasm: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.i_current_price, AGG(a."Catalog Revenue") AS x, AGG(b."Store Distinct Customers") AS y FROM tpcds.item AS o LEFT JOIN tpcds.catalog_sales AS a ON a.cs_item_sk = o.i_item_sk LEFT JOIN tpcds.store_sales AS b ON b.ss_item_sk = o.i_item_sk GROUP BY o.i_current_price
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('item'[i_current_price], "__rows", COUNTROWS('item'), "x", CALCULATE('catalog_sales'[Catalog Revenue], KEEPFILTERS(NOT(ISBLANK('item'[i_item_sk])))), "y", CALCULATE('store_sales'[Store Distinct Customers], KEEPFILTERS(NOT(ISBLANK('item'[i_item_sk]))))), "i_current_price", 'item'[i_current_price], "x", [x], "y", [y])
