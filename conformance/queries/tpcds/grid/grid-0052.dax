// note: the view expander's grid (tools/ossie/grid.mjs), group: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.ss_store_sk, AGG(t."Store Net Profit") AS v FROM tpcds.store_sales AS t GROUP BY t.ss_store_sk
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('store_sales'[ss_store_sk], "__rows", COUNTROWS('store_sales'), "v", 'store_sales'[Store Net Profit]), "ss_store_sk", 'store_sales'[ss_store_sk], "v", [v])
