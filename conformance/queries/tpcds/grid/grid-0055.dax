// note: the view expander's grid (tools/ossie/grid.mjs), where: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.ss_cdemo_sk, AGG(t."Store Distinct Customers") AS v FROM tpcds.store_sales AS t WHERE t.ss_list_price <> 74.02 GROUP BY t.ss_cdemo_sk
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('store_sales'[ss_cdemo_sk], "__rows", COUNTROWS(store_sales), "v", 'store_sales'[Store Distinct Customers]), ('store_sales'[ss_list_price] <> 74.02)), "ss_cdemo_sk", 'store_sales'[ss_cdemo_sk], "v", [v])
