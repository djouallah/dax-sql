// note: the view expander's grid (tools/ossie/grid.mjs), where and: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.ss_cdemo_sk, AGG(t."Store Revenue") AS v FROM tpcds.store_sales AS t WHERE t.ss_net_profit < -75.72 AND t.ss_ext_list_price BETWEEN 6.7 AND 1732.3 GROUP BY t.ss_cdemo_sk
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('store_sales'[ss_cdemo_sk], "__rows", COUNTROWS('store_sales'), "v", 'store_sales'[Store Revenue]), ('store_sales'[ss_net_profit] < (-75.72)), (('store_sales'[ss_ext_list_price] >= 6.7) && ('store_sales'[ss_ext_list_price] <= 1732.3))), "ss_cdemo_sk", 'store_sales'[ss_cdemo_sk], "v", [v])
