// note: the view expander's grid (tools/ossie/grid.mjs), rollup: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.ss_item_sk, AGG(t."Store Revenue") AS v FROM tpcds.store_sales AS t GROUP BY ROLLUP (t.ss_item_sk) ORDER BY t.ss_item_sk NULLS LAST
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS(ROLLUPADDISSUBTOTAL('store_sales'[ss_item_sk], "__level1_ss_item_sk"), "__rows", COUNTROWS('store_sales'), "v", 'store_sales'[Store Revenue]), "ss_item_sk", 'store_sales'[ss_item_sk], "v", [v]) ORDER BY ISBLANK([ss_item_sk]), [ss_item_sk]
