// note: the view expander's grid (tools/ossie/grid.mjs), cte: its SQL as dax-sql's SQL front end writes it in DAX:
// WITH s AS (SELECT ss_cdemo_sk, "Store Revenue" AS mm FROM tpcds.store_sales WHERE ss_item_sk <> 12) SELECT ss_cdemo_sk, AGG(mm) AS v FROM s GROUP BY ss_cdemo_sk
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('store_sales'[ss_cdemo_sk], "__rows", COUNTROWS('store_sales'), "v", 'store_sales'[Store Revenue]), ('store_sales'[ss_item_sk] <> 12)), "ss_cdemo_sk", 'store_sales'[ss_cdemo_sk], "v", [v])
