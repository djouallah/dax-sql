// note: the view expander's grid (tools/ossie/grid.mjs), star where many: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.d_qoy, AGG(f."Store Distinct Customers") AS v FROM tpcds.store_sales AS f JOIN tpcds.date_dim AS o ON f.ss_sold_date_sk = o.d_date_sk_1 WHERE f.ss_list_price <> 9.26 GROUP BY o.d_qoy
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('date_dim'[d_qoy], "__rows", COUNTROWS('store_sales'), "v", 'store_sales'[Store Distinct Customers]), ('store_sales'[ss_list_price] <> 9.26), NOT(ISBLANK('date_dim'[d_date_sk_1]))), "d_qoy", 'date_dim'[d_qoy], "v", [v])
