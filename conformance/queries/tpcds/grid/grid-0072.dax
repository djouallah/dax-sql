// note: the view expander's grid (tools/ossie/grid.mjs), star two sides: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.d_qoy, f.ss_quantity, AGG(f."Store Net Profit") AS v FROM tpcds.store_sales AS f JOIN tpcds.date_dim AS o ON f.ss_sold_date_sk = o.d_date_sk_1 GROUP BY o.d_qoy, f.ss_quantity
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('date_dim'[d_qoy], 'store_sales'[ss_quantity], "__rows", COUNTROWS('store_sales'), "v", 'store_sales'[Store Net Profit]), NOT(ISBLANK('date_dim'[d_date_sk_1]))), "d_qoy", 'date_dim'[d_qoy], "ss_quantity", 'store_sales'[ss_quantity], "v", [v])
