// note: the view expander's grid (tools/ossie/grid.mjs), chasm: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.p_cost, AGG(a."Catalog Sales Quantity") AS x, AGG(b."Store Revenue") AS y FROM tpcds.promotion AS o LEFT JOIN tpcds.catalog_sales AS a ON a.cs_promo_sk = o.p_promo_sk LEFT JOIN tpcds.store_sales AS b ON b.ss_promo_sk = o.p_promo_sk GROUP BY o.p_cost
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('promotion'[p_cost], "__rows", COUNTROWS('promotion'), "x", CALCULATE('catalog_sales'[Catalog Sales Quantity], KEEPFILTERS(NOT(ISBLANK('promotion'[p_promo_sk])))), "y", CALCULATE('store_sales'[Store Revenue], KEEPFILTERS(NOT(ISBLANK('promotion'[p_promo_sk]))))), "p_cost", 'promotion'[p_cost], "x", [x], "y", [y])
