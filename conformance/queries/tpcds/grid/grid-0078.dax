// note: the view expander's grid (tools/ossie/grid.mjs), two groups: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.ss_store_sk, t.ss_quantity, AGG(t."Store Revenue") AS v FROM tpcds.store_sales AS t GROUP BY t.ss_store_sk, t.ss_quantity
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('store_sales'[ss_store_sk], 'store_sales'[ss_quantity], "__rows", COUNTROWS('store_sales'), "v", 'store_sales'[Store Revenue]), "ss_store_sk", 'store_sales'[ss_store_sk], "ss_quantity", 'store_sales'[ss_quantity], "v", [v])
