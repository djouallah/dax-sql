// note: the view expander's grid (tools/ossie/grid.mjs), where: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.ss_store_sk, AGG(t."Store Distinct Customers") AS v FROM tpcds.store_sales AS t WHERE t.ss_sold_date_sk IN (2461201, 2461394) GROUP BY t.ss_store_sk
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('store_sales'[ss_store_sk], "__rows", COUNTROWS(store_sales), "v", 'store_sales'[Store Distinct Customers]), ('store_sales'[ss_sold_date_sk] IN {2461201, 2461394})), "ss_store_sk", 'store_sales'[ss_store_sk], "v", [v])
