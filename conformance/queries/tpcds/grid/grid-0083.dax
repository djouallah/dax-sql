// note: the view expander's grid (tools/ossie/grid.mjs), having: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.ss_promo_sk, AGG(t."Store Net Profit") AS v FROM tpcds.store_sales AS t GROUP BY t.ss_promo_sk HAVING AGG(t."Store Revenue") > 0
EVALUATE SELECTCOLUMNS(FILTER(SUMMARIZECOLUMNS('store_sales'[ss_promo_sk], "__rows", COUNTROWS(store_sales), "v", 'store_sales'[Store Net Profit]), ('store_sales'[Store Revenue] > 0)), "ss_promo_sk", 'store_sales'[ss_promo_sk], "v", [v])
