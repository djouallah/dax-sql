// note: the view expander's grid (tools/ossie/grid.mjs), rollup: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.ss_store_sk, AGG(t."Store Distinct Customers") AS v FROM tpcds.store_sales AS t GROUP BY ROLLUP (t.ss_store_sk) ORDER BY t.ss_store_sk NULLS LAST
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS(ROLLUPADDISSUBTOTAL('store_sales'[ss_store_sk], "__level1_ss_store_sk"), "__rows", COUNTROWS(store_sales), "v", 'store_sales'[Store Distinct Customers]), "ss_store_sk", 'store_sales'[ss_store_sk], "v", [v]) ORDER BY ISBLANK([ss_store_sk]), [ss_store_sk]
