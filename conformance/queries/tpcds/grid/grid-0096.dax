// note: the view expander's grid (tools/ossie/grid.mjs), star two sides: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.i_current_price, f.ss_addr_sk, AGG(f."Store Distinct Customers") AS v FROM tpcds.store_sales AS f LEFT JOIN tpcds.item AS o ON f.ss_item_sk = o.i_item_sk GROUP BY o.i_current_price, f.ss_addr_sk
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('item'[i_current_price], 'store_sales'[ss_addr_sk], "__rows", COUNTROWS('store_sales'), "v", 'store_sales'[Store Distinct Customers]), "i_current_price", 'item'[i_current_price], "ss_addr_sk", 'store_sales'[ss_addr_sk], "v", [v])
