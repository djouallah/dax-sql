DEFINE
VAR __v1 = GENERATEALL(GENERATEALL(SELECTCOLUMNS('customer_address', "o.ca_address_sk", 'customer_address'[ca_address_sk], "o.ca_zip", 'customer_address'[ca_zip]), FILTER(SELECTCOLUMNS('catalog_sales', "a.cache_buster", 'catalog_sales'[cache_buster], "a.cs_bill_addr_sk", 'catalog_sales'[cs_bill_addr_sk], "a.cs_bill_cdemo_sk", 'catalog_sales'[cs_bill_cdemo_sk], "a.cs_catalog_page_sk", 'catalog_sales'[cs_catalog_page_sk], "a.cs_item_sk", 'catalog_sales'[cs_item_sk], "a.cs_promo_sk", 'catalog_sales'[cs_promo_sk], "a.cs_ship_addr_sk", 'catalog_sales'[cs_ship_addr_sk], "a.cs_ship_cdemo_sk", 'catalog_sales'[cs_ship_cdemo_sk], "a.cs_ship_mode_sk", 'catalog_sales'[cs_ship_mode_sk], "a.cs_sold_date_sk", 'catalog_sales'[cs_sold_date_sk], "a.cs_order_number", 'catalog_sales'[cs_order_number], "a.cs_quantity", 'catalog_sales'[cs_quantity], "a.cs_ext_list_price", 'catalog_sales'[cs_ext_list_price], "a.cs_ext_sales_price", 'catalog_sales'[cs_ext_sales_price], "a.cs_list_price", 'catalog_sales'[cs_list_price], "a.cs_net_profit", 'catalog_sales'[cs_net_profit]), ([a.cs_bill_addr_sk] = [o.ca_address_sk]))), FILTER(SELECTCOLUMNS('store_sales', "b.cache_buster", 'store_sales'[cache_buster], "b.ss_addr_sk", 'store_sales'[ss_addr_sk], "b.ss_cdemo_sk", 'store_sales'[ss_cdemo_sk], "b.ss_customer_sk", 'store_sales'[ss_customer_sk], "b.ss_item_sk", 'store_sales'[ss_item_sk], "b.ss_promo_sk", 'store_sales'[ss_promo_sk], "b.ss_sold_date_sk", 'store_sales'[ss_sold_date_sk], "b.ss_store_sk", 'store_sales'[ss_store_sk], "b.ss_ticket_number", 'store_sales'[ss_ticket_number], "b.ss_quantity", 'store_sales'[ss_quantity], "b.ss_ext_list_price", 'store_sales'[ss_ext_list_price], "b.ss_ext_sales_price", 'store_sales'[ss_ext_sales_price], "b.ss_list_price", 'store_sales'[ss_list_price], "b.ss_net_profit", 'store_sales'[ss_net_profit]), ([b.ss_addr_sk] = [o.ca_address_sk])))
VAR __v2 = DISTINCT(SELECTCOLUMNS(__v1, "ca_zip", [o.ca_zip]))
EVALUATE SELECTCOLUMNS(ADDCOLUMNS(__v2, "__m1", CALCULATE('catalog_sales'[Catalog Revenue], REMOVEFILTERS(), TREATAS(SELECTCOLUMNS(FILTER(__v1, (NOT((((((((((((((((ISBLANK([a.cache_buster]) && ISBLANK([a.cs_bill_addr_sk])) && ISBLANK([a.cs_bill_cdemo_sk])) && ISBLANK([a.cs_catalog_page_sk])) && ISBLANK([a.cs_item_sk])) && ISBLANK([a.cs_promo_sk])) && ISBLANK([a.cs_ship_addr_sk])) && ISBLANK([a.cs_ship_cdemo_sk])) && ISBLANK([a.cs_ship_mode_sk])) && ISBLANK([a.cs_sold_date_sk])) && ISBLANK([a.cs_order_number])) && ISBLANK([a.cs_quantity])) && ISBLANK([a.cs_ext_list_price])) && ISBLANK([a.cs_ext_sales_price])) && ISBLANK([a.cs_list_price])) && ISBLANK([a.cs_net_profit]))) && ([o.ca_zip] == [ca_zip]))), "__k1", [a.cache_buster], "__k2", [a.cs_bill_addr_sk], "__k3", [a.cs_bill_cdemo_sk], "__k4", [a.cs_catalog_page_sk], "__k5", [a.cs_item_sk], "__k6", [a.cs_promo_sk], "__k7", [a.cs_ship_addr_sk], "__k8", [a.cs_ship_cdemo_sk], "__k9", [a.cs_ship_mode_sk], "__k10", [a.cs_sold_date_sk], "__k11", [a.cs_order_number], "__k12", [a.cs_quantity], "__k13", [a.cs_ext_list_price], "__k14", [a.cs_ext_sales_price], "__k15", [a.cs_list_price], "__k16", [a.cs_net_profit]), 'catalog_sales'[cache_buster], 'catalog_sales'[cs_bill_addr_sk], 'catalog_sales'[cs_bill_cdemo_sk], 'catalog_sales'[cs_catalog_page_sk], 'catalog_sales'[cs_item_sk], 'catalog_sales'[cs_promo_sk], 'catalog_sales'[cs_ship_addr_sk], 'catalog_sales'[cs_ship_cdemo_sk], 'catalog_sales'[cs_ship_mode_sk], 'catalog_sales'[cs_sold_date_sk], 'catalog_sales'[cs_order_number], 'catalog_sales'[cs_quantity], 'catalog_sales'[cs_ext_list_price], 'catalog_sales'[cs_ext_sales_price], 'catalog_sales'[cs_list_price], 'catalog_sales'[cs_net_profit])), "__m2", CALCULATE('store_sales'[Store Revenue], REMOVEFILTERS(), TREATAS(SELECTCOLUMNS(FILTER(__v1, (NOT((((((((((((((ISBLANK([b.cache_buster]) && ISBLANK([b.ss_addr_sk])) && ISBLANK([b.ss_cdemo_sk])) && ISBLANK([b.ss_customer_sk])) && ISBLANK([b.ss_item_sk])) && ISBLANK([b.ss_promo_sk])) && ISBLANK([b.ss_sold_date_sk])) && ISBLANK([b.ss_store_sk])) && ISBLANK([b.ss_ticket_number])) && ISBLANK([b.ss_quantity])) && ISBLANK([b.ss_ext_list_price])) && ISBLANK([b.ss_ext_sales_price])) && ISBLANK([b.ss_list_price])) && ISBLANK([b.ss_net_profit]))) && ([o.ca_zip] == [ca_zip]))), "__k1", [b.cache_buster], "__k2", [b.ss_addr_sk], "__k3", [b.ss_cdemo_sk], "__k4", [b.ss_customer_sk], "__k5", [b.ss_item_sk], "__k6", [b.ss_promo_sk], "__k7", [b.ss_sold_date_sk], "__k8", [b.ss_store_sk], "__k9", [b.ss_ticket_number], "__k10", [b.ss_quantity], "__k11", [b.ss_ext_list_price], "__k12", [b.ss_ext_sales_price], "__k13", [b.ss_list_price], "__k14", [b.ss_net_profit]), 'store_sales'[cache_buster], 'store_sales'[ss_addr_sk], 'store_sales'[ss_cdemo_sk], 'store_sales'[ss_customer_sk], 'store_sales'[ss_item_sk], 'store_sales'[ss_promo_sk], 'store_sales'[ss_sold_date_sk], 'store_sales'[ss_store_sk], 'store_sales'[ss_ticket_number], 'store_sales'[ss_quantity], 'store_sales'[ss_ext_list_price], 'store_sales'[ss_ext_sales_price], 'store_sales'[ss_list_price], 'store_sales'[ss_net_profit]))), "ca_zip", [ca_zip], "x", [__m1], "y", [__m2])
