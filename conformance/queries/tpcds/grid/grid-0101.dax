// note: the view expander's grid (tools/ossie/grid.mjs), two metrics: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.ss_promo_sk, AGG(t."Store Net Profit") AS a, AGG(t."Store Distinct Customers") AS b FROM tpcds.store_sales AS t GROUP BY t.ss_promo_sk
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('store_sales'[ss_promo_sk], "__rows", COUNTROWS('store_sales'), "a", 'store_sales'[Store Net Profit], "b", 'store_sales'[Store Distinct Customers]), "ss_promo_sk", 'store_sales'[ss_promo_sk], "a", [a], "b", [b])
