// note: the view expander's grid (tools/ossie/grid.mjs), where: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.ss_promo_sk, AGG(t."Store Revenue") AS v FROM tpcds.store_sales AS t WHERE t.ss_customer_sk >= 40 GROUP BY t.ss_promo_sk
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('store_sales'[ss_promo_sk], "__rows", COUNTROWS('store_sales'), "v", 'store_sales'[Store Revenue]), ('store_sales'[ss_customer_sk] >= 40)), "ss_promo_sk", 'store_sales'[ss_promo_sk], "v", [v])
