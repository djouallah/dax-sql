// note: the view expander's grid (tools/ossie/grid.mjs), where or: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.ss_promo_sk, AGG(t."Store Net Profit") AS v FROM tpcds.store_sales AS t WHERE t.ss_item_sk BETWEEN 1 AND 7 OR t.cache_buster BETWEEN 0 AND 3 GROUP BY t.ss_promo_sk
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('store_sales'[ss_promo_sk], "__rows", COUNTROWS('store_sales'), "v", 'store_sales'[Store Net Profit]), ((('store_sales'[ss_item_sk] >= 1) && ('store_sales'[ss_item_sk] <= 7)) || (('store_sales'[cache_buster] >= 0) && ('store_sales'[cache_buster] <= 3)))), "ss_promo_sk", 'store_sales'[ss_promo_sk], "v", [v])
