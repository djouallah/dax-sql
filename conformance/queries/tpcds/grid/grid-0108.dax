// note: the view expander's grid (tools/ossie/grid.mjs), having null: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.ss_promo_sk, AGG(t."Store Revenue") AS v FROM tpcds.store_sales AS t GROUP BY t.ss_promo_sk HAVING AGG(t."Store Net Profit") IS NOT NULL
EVALUATE SELECTCOLUMNS(FILTER(SUMMARIZECOLUMNS('store_sales'[ss_promo_sk], "__rows", COUNTROWS(store_sales), "v", 'store_sales'[Store Revenue]), NOT(ISBLANK('store_sales'[Store Net Profit]))), "ss_promo_sk", 'store_sales'[ss_promo_sk], "v", [v])
