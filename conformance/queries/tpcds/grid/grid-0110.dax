// note: the view expander's grid (tools/ossie/grid.mjs), order by measure: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.ss_promo_sk, AGG(t."Store Net Profit") AS v FROM tpcds.store_sales AS t GROUP BY t.ss_promo_sk ORDER BY v DESC NULLS LAST, t.ss_promo_sk NULLS FIRST
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('store_sales'[ss_promo_sk], "__rows", COUNTROWS(store_sales), "v", 'store_sales'[Store Net Profit]), "ss_promo_sk", 'store_sales'[ss_promo_sk], "v", [v]) ORDER BY [v] DESC, [ss_promo_sk]
