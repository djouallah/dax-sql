// note: the view expander's grid (tools/ossie/grid.mjs), group by all: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.ss_promo_sk, AGG(t."Store Distinct Customers") AS v FROM tpcds.store_sales AS t GROUP BY ALL
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('store_sales'[ss_promo_sk], "__rows", COUNTROWS('store_sales'), "v", 'store_sales'[Store Distinct Customers]), "ss_promo_sk", 'store_sales'[ss_promo_sk], "v", [v])
