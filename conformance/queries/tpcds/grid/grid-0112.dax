// note: the view expander's grid (tools/ossie/grid.mjs), rollup: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.ss_quantity, AGG(t."Store Distinct Customers") AS v FROM tpcds.store_sales AS t GROUP BY ROLLUP (t.ss_quantity) ORDER BY t.ss_quantity NULLS LAST
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS(ROLLUPADDISSUBTOTAL('store_sales'[ss_quantity], "__level1_ss_quantity"), "__rows", COUNTROWS(store_sales), "v", 'store_sales'[Store Distinct Customers]), "ss_quantity", 'store_sales'[ss_quantity], "v", [v]) ORDER BY ISBLANK([ss_quantity]), [ss_quantity]
