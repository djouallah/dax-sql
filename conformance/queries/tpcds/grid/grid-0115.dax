// note: the view expander's grid (tools/ossie/grid.mjs), cte: its SQL as dax-sql's SQL front end writes it in DAX:
// WITH s AS (SELECT ss_promo_sk, "Store Net Profit" AS mm FROM tpcds.store_sales WHERE ss_promo_sk = 4) SELECT ss_promo_sk, AGG(mm) AS v FROM s GROUP BY ss_promo_sk
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('store_sales'[ss_promo_sk], "__rows", COUNTROWS(store_sales), "v", 'store_sales'[Store Net Profit]), ('store_sales'[ss_promo_sk] = 4)), "ss_promo_sk", 'store_sales'[ss_promo_sk], "v", [v])
