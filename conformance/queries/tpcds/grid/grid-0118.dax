// note: the view expander's grid (tools/ossie/grid.mjs), star where one: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.i_color, AGG(f."Store Distinct Customers") AS v FROM tpcds.store_sales AS f JOIN tpcds.item AS o ON f.ss_item_sk = o.i_item_sk WHERE o.i_current_price < 41.89 GROUP BY o.i_color
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('item'[i_color], "__rows", COUNTROWS('store_sales'), "v", 'store_sales'[Store Distinct Customers]), ('item'[i_current_price] < 41.89), NOT(ISBLANK('item'[i_item_sk]))), "i_color", 'item'[i_color], "v", [v])
