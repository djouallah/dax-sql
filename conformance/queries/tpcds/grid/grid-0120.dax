EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('item'[i_color], 'store_sales'[ss_cdemo_sk], "__rows", COUNTROWS('store_sales'), "v", 'store_sales'[Store Distinct Customers]), NOT(ISBLANK('item'[i_item_sk]))), "i_color", 'item'[i_color], "ss_cdemo_sk", 'store_sales'[ss_cdemo_sk], "v", [v])
