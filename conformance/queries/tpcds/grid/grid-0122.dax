EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('customer_demographics'[cd_marital_status], "__rows", COUNTROWS('customer_demographics'), "x", CALCULATE('catalog_sales'[Catalog Net Profit], KEEPFILTERS(NOT(ISBLANK('customer_demographics'[cd_demo_sk])))), "y", CALCULATE('store_sales'[Store Net Profit], KEEPFILTERS(NOT(ISBLANK('customer_demographics'[cd_demo_sk]))))), "cd_marital_status", 'customer_demographics'[cd_marital_status], "x", [x], "y", [y])
