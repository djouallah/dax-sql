// note: the view expander's grid (tools/ossie/grid.mjs), two metrics: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.ss_store_sk, AGG(t."Store Distinct Customers") AS a, AGG(t."Store Net Profit") AS b FROM tpcds.store_sales AS t GROUP BY t.ss_store_sk
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('store_sales'[ss_store_sk], "__rows", COUNTROWS('store_sales'), "a", 'store_sales'[Store Distinct Customers], "b", 'store_sales'[Store Net Profit]), "ss_store_sk", 'store_sales'[ss_store_sk], "a", [a], "b", [b])
