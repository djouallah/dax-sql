// note: the view expander's grid (tools/ossie/grid.mjs), where total: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT AGG(t."Store Revenue") AS v FROM tpcds.store_sales AS t WHERE t.ss_ext_sales_price <> 481.4
EVALUATE SELECTCOLUMNS(CALCULATETABLE(ROW("v", 'store_sales'[Store Revenue]), ('store_sales'[ss_ext_sales_price] <> 481.4)), "v", [v])
