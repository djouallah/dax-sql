// note: the view expander's grid (tools/ossie/grid.mjs), order by measure: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.cs_catalog_page_sk, AGG(t."Catalog Sales Quantity") AS v FROM tpcds.catalog_sales AS t GROUP BY t.cs_catalog_page_sk ORDER BY v DESC NULLS LAST, t.cs_catalog_page_sk NULLS FIRST
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('catalog_sales'[cs_catalog_page_sk], "__rows", COUNTROWS('catalog_sales'), "v", 'catalog_sales'[Catalog Sales Quantity]), "cs_catalog_page_sk", 'catalog_sales'[cs_catalog_page_sk], "v", [v]) ORDER BY [v] DESC, [cs_catalog_page_sk]
