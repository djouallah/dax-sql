// note: the view expander's grid (tools/ossie/grid.mjs), rollup: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.cs_bill_addr_sk, AGG(t."Catalog Net Profit") AS v FROM tpcds.catalog_sales AS t GROUP BY ROLLUP (t.cs_bill_addr_sk) ORDER BY t.cs_bill_addr_sk NULLS LAST
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS(ROLLUPADDISSUBTOTAL('catalog_sales'[cs_bill_addr_sk], "__level1_cs_bill_addr_sk"), "__rows", COUNTROWS('catalog_sales'), "v", 'catalog_sales'[Catalog Net Profit]), "cs_bill_addr_sk", 'catalog_sales'[cs_bill_addr_sk], "v", [v]) ORDER BY ISBLANK([cs_bill_addr_sk]), [cs_bill_addr_sk]
