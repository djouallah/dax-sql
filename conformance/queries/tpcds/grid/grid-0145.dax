// note: the view expander's grid (tools/ossie/grid.mjs), star total: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT AGG(f."Store Revenue") AS v FROM tpcds.store_sales AS f JOIN tpcds.item AS o ON f.ss_item_sk = o.i_item_sk
EVALUATE SELECTCOLUMNS(CALCULATETABLE(ROW("v", 'store_sales'[Store Revenue]), NOT(ISBLANK('item'[i_item_sk]))), "v", [v])
