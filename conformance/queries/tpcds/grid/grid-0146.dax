// note: the view expander's grid (tools/ossie/grid.mjs), chasm: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.ca_address_sk, AGG(a."Catalog Sales Quantity") AS x, AGG(b."Store Revenue") AS y FROM tpcds.customer_address AS o LEFT JOIN tpcds.catalog_sales AS a ON a.cs_ship_addr_sk = o.ca_address_sk LEFT JOIN tpcds.store_sales AS b ON b.ss_addr_sk = o.ca_address_sk GROUP BY o.ca_address_sk
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('customer_address'[ca_address_sk], "__rows", COUNTROWS('customer_address'), "x", CALCULATE('catalog_sales'[Catalog Sales Quantity], KEEPFILTERS(NOT(ISBLANK('customer_address'[ca_address_sk]))), USERELATIONSHIP('catalog_sales'[cs_ship_addr_sk], 'customer_address'[ca_address_sk])), "y", CALCULATE('store_sales'[Store Revenue], KEEPFILTERS(NOT(ISBLANK('customer_address'[ca_address_sk]))))), "ca_address_sk", 'customer_address'[ca_address_sk], "x", [x], "y", [y])
