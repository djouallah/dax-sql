// note: the view expander's grid (tools/ossie/grid.mjs), two metrics: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.cs_catalog_page_sk, AGG(t."Catalog Revenue") AS a, AGG(t."Catalog Revenue") AS b FROM tpcds.catalog_sales AS t GROUP BY t.cs_catalog_page_sk
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('catalog_sales'[cs_catalog_page_sk], "__rows", COUNTROWS('catalog_sales'), "a", 'catalog_sales'[Catalog Revenue], "b", 'catalog_sales'[Catalog Revenue]), "cs_catalog_page_sk", 'catalog_sales'[cs_catalog_page_sk], "a", [a], "b", [b])
