// note: the view expander's grid (tools/ossie/grid.mjs), two groups: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.cs_catalog_page_sk, t.cs_ship_mode_sk, AGG(t."Catalog Sales Quantity") AS v FROM tpcds.catalog_sales AS t GROUP BY t.cs_catalog_page_sk, t.cs_ship_mode_sk
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('catalog_sales'[cs_catalog_page_sk], 'catalog_sales'[cs_ship_mode_sk], "__rows", COUNTROWS('catalog_sales'), "v", 'catalog_sales'[Catalog Sales Quantity]), "cs_catalog_page_sk", 'catalog_sales'[cs_catalog_page_sk], "cs_ship_mode_sk", 'catalog_sales'[cs_ship_mode_sk], "v", [v])
