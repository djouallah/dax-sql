// note: the view expander's grid (tools/ossie/grid.mjs), where: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.cs_catalog_page_sk, AGG(t."Catalog Net Profit") AS v FROM tpcds.catalog_sales AS t WHERE t.cs_bill_addr_sk IN (1, 2) GROUP BY t.cs_catalog_page_sk
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('catalog_sales'[cs_catalog_page_sk], "__rows", COUNTROWS(catalog_sales), "v", 'catalog_sales'[Catalog Net Profit]), ('catalog_sales'[cs_bill_addr_sk] IN {1, 2})), "cs_catalog_page_sk", 'catalog_sales'[cs_catalog_page_sk], "v", [v])
