// SELECT t.cs_catalog_page_sk, AGG(t."Catalog Revenue") AS v FROM tpcds.catalog_sales AS t WHERE t.cs_ext_list_price < 160.92 OR NOT (t.cs_ship_addr_sk = 3) GROUP BY t.cs_catalog_page_sk
