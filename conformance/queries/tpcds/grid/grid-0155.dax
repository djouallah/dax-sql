// note: the view expander's grid (tools/ossie/grid.mjs), having: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.cs_bill_cdemo_sk, AGG(t."Catalog Revenue") AS v FROM tpcds.catalog_sales AS t GROUP BY t.cs_bill_cdemo_sk HAVING AGG(t."Catalog Revenue") > 0
EVALUATE SELECTCOLUMNS(FILTER(SUMMARIZECOLUMNS('catalog_sales'[cs_bill_cdemo_sk], "__rows", COUNTROWS('catalog_sales'), "v", 'catalog_sales'[Catalog Revenue]), ([v] > 0)), "cs_bill_cdemo_sk", 'catalog_sales'[cs_bill_cdemo_sk], "v", [v])
