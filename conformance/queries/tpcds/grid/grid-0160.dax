// note: the view expander's grid (tools/ossie/grid.mjs), rollup: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.cs_item_sk, AGG(t."Catalog Sales Quantity") AS v FROM tpcds.catalog_sales AS t GROUP BY ROLLUP (t.cs_item_sk) ORDER BY t.cs_item_sk NULLS LAST
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS(ROLLUPADDISSUBTOTAL('catalog_sales'[cs_item_sk], "__level1_cs_item_sk"), "__rows", COUNTROWS(catalog_sales), "v", 'catalog_sales'[Catalog Sales Quantity]), "cs_item_sk", 'catalog_sales'[cs_item_sk], "v", [v]) ORDER BY ISBLANK([cs_item_sk]), [cs_item_sk]
