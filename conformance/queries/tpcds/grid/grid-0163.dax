// note: the view expander's grid (tools/ossie/grid.mjs), cte: its SQL as dax-sql's SQL front end writes it in DAX:
// WITH s AS (SELECT cs_catalog_page_sk, "Catalog Net Profit" AS mm FROM tpcds.catalog_sales WHERE cs_list_price = 44.18) SELECT cs_catalog_page_sk, AGG(mm) AS v FROM s GROUP BY cs_catalog_page_sk
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('catalog_sales'[cs_catalog_page_sk], "__rows", COUNTROWS(catalog_sales), "v", 'catalog_sales'[Catalog Net Profit]), ('catalog_sales'[cs_list_price] = 44.18)), "cs_catalog_page_sk", 'catalog_sales'[cs_catalog_page_sk], "v", [v])
