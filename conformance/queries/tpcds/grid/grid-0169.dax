// note: the view expander's grid (tools/ossie/grid.mjs), star total: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT AGG(f."Store Revenue") AS v FROM tpcds.store_sales AS f JOIN tpcds.store AS o ON f.ss_store_sk = o.s_store_sk
EVALUATE SELECTCOLUMNS(CALCULATETABLE(ROW("v", 'store_sales'[Store Revenue]), NOT(ISBLANK('store'[s_store_sk]))), "v", [v])
