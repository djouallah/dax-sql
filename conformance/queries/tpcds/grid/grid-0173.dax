// note: the view expander's grid (tools/ossie/grid.mjs), two metrics: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.cs_bill_cdemo_sk, AGG(t."Catalog Net Profit") AS a, AGG(t."Catalog Revenue") AS b FROM tpcds.catalog_sales AS t GROUP BY t.cs_bill_cdemo_sk
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('catalog_sales'[cs_bill_cdemo_sk], "__rows", COUNTROWS(catalog_sales), "a", 'catalog_sales'[Catalog Net Profit], "b", 'catalog_sales'[Catalog Revenue]), "cs_bill_cdemo_sk", 'catalog_sales'[cs_bill_cdemo_sk], "a", [a], "b", [b])
