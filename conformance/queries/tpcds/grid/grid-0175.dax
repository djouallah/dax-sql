// note: the view expander's grid (tools/ossie/grid.mjs), where: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.cs_bill_cdemo_sk, AGG(t."Catalog Sales Quantity") AS v FROM tpcds.catalog_sales AS t WHERE t.cs_ext_list_price = 952.49 GROUP BY t.cs_bill_cdemo_sk
