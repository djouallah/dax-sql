// note: the view expander's grid (tools/ossie/grid.mjs), where and: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.cs_bill_cdemo_sk, AGG(t."Catalog Revenue") AS v FROM tpcds.catalog_sales AS t WHERE t.cs_net_profit IS NOT NULL AND t.cache_buster IN (2, 2) GROUP BY t.cs_bill_cdemo_sk
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('catalog_sales'[cs_bill_cdemo_sk], "__rows", COUNTROWS('catalog_sales'), "v", 'catalog_sales'[Catalog Revenue]), NOT(ISBLANK('catalog_sales'[cs_net_profit])), ('catalog_sales'[cache_buster] IN {2, 2})), "cs_bill_cdemo_sk", 'catalog_sales'[cs_bill_cdemo_sk], "v", [v])
