// note: the view expander's grid (tools/ossie/grid.mjs), where total: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT AGG(t."Catalog Revenue") AS v FROM tpcds.catalog_sales AS t WHERE t.cs_promo_sk IS NOT NULL
EVALUATE SELECTCOLUMNS(CALCULATETABLE(ROW("v", 'catalog_sales'[Catalog Revenue]), NOT(ISBLANK('catalog_sales'[cs_promo_sk]))), "v", [v])
