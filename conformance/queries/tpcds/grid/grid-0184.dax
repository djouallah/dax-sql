// note: the view expander's grid (tools/ossie/grid.mjs), rollup: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.cs_promo_sk, AGG(t."Catalog Sales Quantity") AS v FROM tpcds.catalog_sales AS t GROUP BY ROLLUP (t.cs_promo_sk) ORDER BY t.cs_promo_sk NULLS LAST
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS(ROLLUPADDISSUBTOTAL('catalog_sales'[cs_promo_sk], "__level1_cs_promo_sk"), "__rows", COUNTROWS(catalog_sales), "v", 'catalog_sales'[Catalog Sales Quantity]), "cs_promo_sk", 'catalog_sales'[cs_promo_sk], "v", [v]) ORDER BY ISBLANK([cs_promo_sk]), [cs_promo_sk]
