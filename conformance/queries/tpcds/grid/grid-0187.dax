// note: the view expander's grid (tools/ossie/grid.mjs), cte: its SQL as dax-sql's SQL front end writes it in DAX:
// WITH s AS (SELECT cs_bill_cdemo_sk, "Catalog Sales Quantity" AS mm FROM tpcds.catalog_sales WHERE cs_item_sk IS NOT NULL) SELECT cs_bill_cdemo_sk, AGG(mm) AS v FROM s GROUP BY cs_bill_cdemo_sk
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('catalog_sales'[cs_bill_cdemo_sk], "__rows", COUNTROWS('catalog_sales'), "v", 'catalog_sales'[Catalog Sales Quantity]), NOT(ISBLANK('catalog_sales'[cs_item_sk]))), "cs_bill_cdemo_sk", 'catalog_sales'[cs_bill_cdemo_sk], "v", [v])
