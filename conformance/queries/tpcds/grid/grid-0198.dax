// note: the view expander's grid (tools/ossie/grid.mjs), where and: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.cs_catalog_page_sk, AGG(t."Catalog Net Profit") AS v FROM tpcds.catalog_sales AS t WHERE NOT (t.cs_ship_addr_sk = 10) AND t.cs_ship_addr_sk < 12 GROUP BY t.cs_catalog_page_sk
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('catalog_sales'[cs_catalog_page_sk], "__rows", COUNTROWS(catalog_sales), "v", 'catalog_sales'[Catalog Net Profit]), NOT(('catalog_sales'[cs_ship_addr_sk] = 10)), ('catalog_sales'[cs_ship_addr_sk] < 12)), "cs_catalog_page_sk", 'catalog_sales'[cs_catalog_page_sk], "v", [v])
