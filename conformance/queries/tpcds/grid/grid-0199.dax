// note: the view expander's grid (tools/ossie/grid.mjs), where or: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.cs_catalog_page_sk, AGG(t."Catalog Revenue") AS v FROM tpcds.catalog_sales AS t WHERE t.cs_quantity IN (32, 50) OR NOT (t.cs_sold_date_sk = 2461399) GROUP BY t.cs_catalog_page_sk
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('catalog_sales'[cs_catalog_page_sk], "__rows", COUNTROWS('catalog_sales'), "v", 'catalog_sales'[Catalog Revenue]), (('catalog_sales'[cs_quantity] IN {32, 50}) || NOT(('catalog_sales'[cs_sold_date_sk] = 2461399)))), "cs_catalog_page_sk", 'catalog_sales'[cs_catalog_page_sk], "v", [v])
