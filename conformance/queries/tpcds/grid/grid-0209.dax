// WITH s AS (SELECT cs_catalog_page_sk, "Catalog Revenue" AS mm FROM tpcds.catalog_sales WHERE cs_item_sk IS NOT NULL) SELECT cs_catalog_page_sk, AGG(mm) AS v FROM s GROUP BY cs_catalog_page_sk
