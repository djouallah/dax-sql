// note: the view expander's grid (tools/ossie/grid.mjs), where total: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT AGG(t."Catalog Sales Quantity") AS v FROM tpcds.catalog_sales AS t WHERE t.cs_quantity IN (35, 42)
EVALUATE SELECTCOLUMNS(CALCULATETABLE(ROW("v", 'catalog_sales'[Catalog Sales Quantity]), ('catalog_sales'[cs_quantity] IN {35, 42})), "v", [v])
