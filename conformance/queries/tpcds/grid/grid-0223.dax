// note: the view expander's grid (tools/ossie/grid.mjs), having: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.cs_ship_addr_sk, AGG(t."Catalog Net Profit") AS v FROM tpcds.catalog_sales AS t GROUP BY t.cs_ship_addr_sk HAVING AGG(t."Catalog Revenue") > 0
EVALUATE SELECTCOLUMNS(FILTER(SUMMARIZECOLUMNS('catalog_sales'[cs_ship_addr_sk], "__rows", COUNTROWS(catalog_sales), "v", 'catalog_sales'[Catalog Net Profit]), ('catalog_sales'[Catalog Revenue] > 0)), "cs_ship_addr_sk", 'catalog_sales'[cs_ship_addr_sk], "v", [v])
