// note: the view expander's grid (tools/ossie/grid.mjs), rollup: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.cs_ship_mode_sk, AGG(t."Catalog Revenue") AS v FROM tpcds.catalog_sales AS t GROUP BY ROLLUP (t.cs_ship_mode_sk) ORDER BY t.cs_ship_mode_sk NULLS LAST
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS(ROLLUPADDISSUBTOTAL('catalog_sales'[cs_ship_mode_sk], "__level1_cs_ship_mode_sk"), "__rows", COUNTROWS(catalog_sales), "v", 'catalog_sales'[Catalog Revenue]), "cs_ship_mode_sk", 'catalog_sales'[cs_ship_mode_sk], "v", [v]) ORDER BY ISBLANK([cs_ship_mode_sk]), [cs_ship_mode_sk]
