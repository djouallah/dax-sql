// note: the view expander's grid (tools/ossie/grid.mjs), ratio: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.cs_ship_addr_sk, CAST(AGG(t."Catalog Revenue") AS DOUBLE) / NULLIF(AGG(t."Catalog Revenue"), 0) AS r FROM tpcds.catalog_sales AS t GROUP BY t.cs_ship_addr_sk
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('catalog_sales'[cs_ship_addr_sk], "__rows", COUNTROWS('catalog_sales'), "r", IF(ISBLANK(COUNTROWS('catalog_sales')), BLANK(), (CONVERT('catalog_sales'[Catalog Revenue], DOUBLE) / IF(('catalog_sales'[Catalog Revenue] == 0), BLANK(), 'catalog_sales'[Catalog Revenue])))), "cs_ship_addr_sk", 'catalog_sales'[cs_ship_addr_sk], "r", [r])
