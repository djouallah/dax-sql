// note: the view expander's grid (tools/ossie/grid.mjs), star where one: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.p_cost, AGG(f."Store Distinct Customers") AS v FROM tpcds.store_sales AS f LEFT JOIN tpcds.promotion AS o ON f.ss_promo_sk = o.p_promo_sk WHERE o.p_promo_sk BETWEEN 1 AND 7 GROUP BY o.p_cost
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('promotion'[p_cost], "__rows", COUNTROWS('store_sales'), "v", 'store_sales'[Store Distinct Customers]), (('promotion'[p_promo_sk] >= 1) && ('promotion'[p_promo_sk] <= 7))), "p_cost", 'promotion'[p_cost], "v", [v])
