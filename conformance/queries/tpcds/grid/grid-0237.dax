// note: the view expander's grid (tools/ossie/grid.mjs), star total: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT AGG(f."Store Distinct Customers") AS v FROM tpcds.store_sales AS f JOIN tpcds.promotion AS o ON f.ss_promo_sk = o.p_promo_sk
EVALUATE SELECTCOLUMNS(CALCULATETABLE(ROW("v", 'store_sales'[Store Distinct Customers]), NOT(ISBLANK('promotion'[p_promo_sk]))), "v", [v])
