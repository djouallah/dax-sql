// note: the view expander's grid (tools/ossie/grid.mjs), two groups: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.cs_ship_addr_sk, t.cs_promo_sk, AGG(t."Catalog Net Profit") AS v FROM tpcds.catalog_sales AS t GROUP BY t.cs_ship_addr_sk, t.cs_promo_sk
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('catalog_sales'[cs_ship_addr_sk], 'catalog_sales'[cs_promo_sk], "__rows", COUNTROWS('catalog_sales'), "v", 'catalog_sales'[Catalog Net Profit]), "cs_ship_addr_sk", 'catalog_sales'[cs_ship_addr_sk], "cs_promo_sk", 'catalog_sales'[cs_promo_sk], "v", [v])
