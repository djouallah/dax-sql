// note: the view expander's grid (tools/ossie/grid.mjs), where: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.cs_ship_addr_sk, AGG(t."Catalog Net Profit") AS v FROM tpcds.catalog_sales AS t WHERE t.cs_quantity BETWEEN 1 AND 24 GROUP BY t.cs_ship_addr_sk
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('catalog_sales'[cs_ship_addr_sk], "__rows", COUNTROWS('catalog_sales'), "v", 'catalog_sales'[Catalog Net Profit]), (('catalog_sales'[cs_quantity] >= 1) && ('catalog_sales'[cs_quantity] <= 24))), "cs_ship_addr_sk", 'catalog_sales'[cs_ship_addr_sk], "v", [v])
