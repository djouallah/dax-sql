// note: the view expander's grid (tools/ossie/grid.mjs), where and: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.cs_ship_addr_sk, AGG(t."Catalog Revenue") AS v FROM tpcds.catalog_sales AS t WHERE t.cs_promo_sk = 7 AND t.cs_ship_cdemo_sk >= 4 GROUP BY t.cs_ship_addr_sk
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('catalog_sales'[cs_ship_addr_sk], "__rows", COUNTROWS('catalog_sales'), "v", 'catalog_sales'[Catalog Revenue]), ('catalog_sales'[cs_promo_sk] = 7), ('catalog_sales'[cs_ship_cdemo_sk] >= 4)), "cs_ship_addr_sk", 'catalog_sales'[cs_ship_addr_sk], "v", [v])
