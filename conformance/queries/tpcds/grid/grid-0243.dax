// note: the view expander's grid (tools/ossie/grid.mjs), where or: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.cs_ship_addr_sk, AGG(t."Catalog Sales Quantity") AS v FROM tpcds.catalog_sales AS t WHERE t.cs_catalog_page_sk <> 6 OR NOT (t.cs_order_number = 143) GROUP BY t.cs_ship_addr_sk
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('catalog_sales'[cs_ship_addr_sk], "__rows", COUNTROWS('catalog_sales'), "v", 'catalog_sales'[Catalog Sales Quantity]), (('catalog_sales'[cs_catalog_page_sk] <> 6) || NOT(('catalog_sales'[cs_order_number] = 143)))), "cs_ship_addr_sk", 'catalog_sales'[cs_ship_addr_sk], "v", [v])
