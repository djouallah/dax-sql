// note: the view expander's grid (tools/ossie/grid.mjs), where total: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT AGG(t."Catalog Net Profit") AS v FROM tpcds.catalog_sales AS t WHERE t.cs_item_sk BETWEEN 1 AND 8
EVALUATE SELECTCOLUMNS(CALCULATETABLE(ROW("v", 'catalog_sales'[Catalog Net Profit]), (('catalog_sales'[cs_item_sk] >= 1) && ('catalog_sales'[cs_item_sk] <= 8))), "v", [v])
