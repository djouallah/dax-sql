// note: the view expander's grid (tools/ossie/grid.mjs), having null: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.cs_ship_addr_sk, AGG(t."Catalog Net Profit") AS v FROM tpcds.catalog_sales AS t GROUP BY t.cs_ship_addr_sk HAVING AGG(t."Catalog Sales Quantity") IS NOT NULL
EVALUATE SELECTCOLUMNS(FILTER(SUMMARIZECOLUMNS('catalog_sales'[cs_ship_addr_sk], "__rows", COUNTROWS(catalog_sales), "v", 'catalog_sales'[Catalog Net Profit]), NOT(ISBLANK('catalog_sales'[Catalog Sales Quantity]))), "cs_ship_addr_sk", 'catalog_sales'[cs_ship_addr_sk], "v", [v])
