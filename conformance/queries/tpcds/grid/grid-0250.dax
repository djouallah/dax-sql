// note: the view expander's grid (tools/ossie/grid.mjs), rollup: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.row_count, AGG(t."Archive Files") AS v FROM tpcds.stg_tpcds_archive_log AS t GROUP BY ROLLUP (t.row_count) ORDER BY t.row_count NULLS LAST
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS(ROLLUPADDISSUBTOTAL('stg_tpcds_archive_log'[row_count], "__level1_row_count"), "__rows", COUNTROWS('stg_tpcds_archive_log'), "v", 'stg_tpcds_archive_log'[Archive Files]), "row_count", 'stg_tpcds_archive_log'[row_count], "v", [v]) ORDER BY ISBLANK([row_count]), [row_count]
