// note: the view expander's grid (tools/ossie/grid.mjs), scalar ops: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.source_type, AGG(t."Archive Files") * 2 AS a, AGG(t."Archive Files") + 1 AS b, COALESCE(AGG(t."Archive Files"), 0) AS c FROM tpcds.stg_tpcds_archive_log AS t GROUP BY t.source_type
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('stg_tpcds_archive_log'[source_type], "__rows", COUNTROWS(stg_tpcds_archive_log), "a", ('stg_tpcds_archive_log'[Archive Files] * 2), "b", ('stg_tpcds_archive_log'[Archive Files] + 1), "c", IF(ISBLANK(COUNTROWS(stg_tpcds_archive_log)), BLANK(), COALESCE('stg_tpcds_archive_log'[Archive Files], 0))), "source_type", 'stg_tpcds_archive_log'[source_type], "a", [a], "b", [b], "c", [c])
