// note: the view expander's grid (tools/ossie/grid.mjs), cte: its SQL as dax-sql's SQL front end writes it in DAX:
// WITH s AS (SELECT cs_ship_addr_sk, "Catalog Sales Quantity" AS mm FROM tpcds.catalog_sales WHERE cs_ship_mode_sk IN (1, 5)) SELECT cs_ship_addr_sk, AGG(mm) AS v FROM s GROUP BY cs_ship_addr_sk
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('catalog_sales'[cs_ship_addr_sk], "__rows", COUNTROWS(catalog_sales), "v", 'catalog_sales'[Catalog Sales Quantity]), ('catalog_sales'[cs_ship_mode_sk] IN {1, 5})), "cs_ship_addr_sk", 'catalog_sales'[cs_ship_addr_sk], "v", [v])
