// note: the view expander's grid (tools/ossie/grid.mjs), two metrics: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.source_type, AGG(t."Archive Files") AS a, AGG(t."Archive Source Rows") AS b FROM tpcds.stg_tpcds_archive_log AS t GROUP BY t.source_type
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('stg_tpcds_archive_log'[source_type], "__rows", COUNTROWS(stg_tpcds_archive_log), "a", 'stg_tpcds_archive_log'[Archive Files], "b", 'stg_tpcds_archive_log'[Archive Source Rows]), "source_type", 'stg_tpcds_archive_log'[source_type], "a", [a], "b", [b])
