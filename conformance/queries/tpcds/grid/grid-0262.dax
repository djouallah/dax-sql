// note: the view expander's grid (tools/ossie/grid.mjs), two groups: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.cs_bill_cdemo_sk, t.cache_buster, AGG(t."Catalog Net Profit") AS v FROM tpcds.catalog_sales AS t GROUP BY t.cs_bill_cdemo_sk, t.cache_buster
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('catalog_sales'[cs_bill_cdemo_sk], 'catalog_sales'[cache_buster], "__rows", COUNTROWS(catalog_sales), "v", 'catalog_sales'[Catalog Net Profit]), "cs_bill_cdemo_sk", 'catalog_sales'[cs_bill_cdemo_sk], "cache_buster", 'catalog_sales'[cache_buster], "v", [v])
