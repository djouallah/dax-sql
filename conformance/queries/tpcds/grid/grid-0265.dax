// SELECT t.cs_bill_cdemo_sk, AGG(t."Catalog Sales Quantity") AS v FROM tpcds.catalog_sales AS t WHERE t.cs_ship_addr_sk < 10 OR t.cs_order_number BETWEEN 1 AND 49 GROUP BY t.cs_bill_cdemo_sk
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('catalog_sales'[cs_bill_cdemo_sk], "__rows", COUNTROWS(catalog_sales), "v", 'catalog_sales'[Catalog Sales Quantity]), (('catalog_sales'[cs_ship_addr_sk] < 10) || (('catalog_sales'[cs_order_number] >= 1) && ('catalog_sales'[cs_order_number] <= 49)))), "cs_bill_cdemo_sk", 'catalog_sales'[cs_bill_cdemo_sk], "v", [v])
