// note: the view expander's grid (tools/ossie/grid.mjs), where total: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT AGG(t."Catalog Net Profit") AS v FROM tpcds.catalog_sales AS t WHERE t.cs_ship_cdemo_sk < 11
EVALUATE SELECTCOLUMNS(CALCULATETABLE(ROW("v", 'catalog_sales'[Catalog Net Profit]), ('catalog_sales'[cs_ship_cdemo_sk] < 11)), "v", [v])
