// note: the view expander's grid (tools/ossie/grid.mjs), star: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.ca_city, AGG(f."Store Revenue") AS v FROM tpcds.store_sales AS f LEFT JOIN tpcds.customer_address AS o ON f.ss_addr_sk = o.ca_address_sk GROUP BY o.ca_city
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('customer_address'[ca_city], "__rows", COUNTROWS('store_sales'), "v", 'store_sales'[Store Revenue]), "ca_city", 'customer_address'[ca_city], "v", [v])
