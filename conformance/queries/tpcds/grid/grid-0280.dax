// note: the view expander's grid (tools/ossie/grid.mjs), star two sides: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.ca_city, f.ss_promo_sk, AGG(f."Store Distinct Customers") AS v FROM tpcds.store_sales AS f LEFT JOIN tpcds.customer_address AS o ON f.ss_addr_sk = o.ca_address_sk GROUP BY o.ca_city, f.ss_promo_sk
