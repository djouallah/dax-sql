// note: the view expander's grid (tools/ossie/grid.mjs), two groups: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.source_type, t.source_filename, AGG(t."Archive Files") AS v FROM tpcds.stg_tpcds_archive_log AS t GROUP BY t.source_type, t.source_filename
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('stg_tpcds_archive_log'[source_type], 'stg_tpcds_archive_log'[source_filename], "__rows", COUNTROWS(stg_tpcds_archive_log), "v", 'stg_tpcds_archive_log'[Archive Files]), "source_type", 'stg_tpcds_archive_log'[source_type], "source_filename", 'stg_tpcds_archive_log'[source_filename], "v", [v])
