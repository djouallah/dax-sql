// note: the view expander's grid (tools/ossie/grid.mjs), where: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.source_type, AGG(t."Archive Files") AS v FROM tpcds.stg_tpcds_archive_log AS t WHERE t.etag <> 'sf10-230b' GROUP BY t.source_type
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('stg_tpcds_archive_log'[source_type], "__rows", COUNTROWS('stg_tpcds_archive_log'), "v", 'stg_tpcds_archive_log'[Archive Files]), ('stg_tpcds_archive_log'[etag] <> "sf10-230b")), "source_type", 'stg_tpcds_archive_log'[source_type], "v", [v])
