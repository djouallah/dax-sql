// note: the view expander's grid (tools/ossie/grid.mjs), where and: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.source_type, AGG(t."Archive Files") AS v FROM tpcds.stg_tpcds_archive_log AS t WHERE t.source_filename <> 'date_dim/part-00000.parquet' AND t.source_filename IN ('store_sales/part-00000.parquet', 'item/part-00000.parquet') GROUP BY t.source_type
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('stg_tpcds_archive_log'[source_type], "__rows", COUNTROWS('stg_tpcds_archive_log'), "v", 'stg_tpcds_archive_log'[Archive Files]), ('stg_tpcds_archive_log'[source_filename] <> "date_dim/part-00000.parquet"), ('stg_tpcds_archive_log'[source_filename] IN {"store_sales/part-00000.parquet", "item/part-00000.parquet"})), "source_type", 'stg_tpcds_archive_log'[source_type], "v", [v])
