// note: the view expander's grid (tools/ossie/grid.mjs), order by measure: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.file_stem, AGG(t."Archive Source Rows") AS v FROM tpcds.stg_tpcds_archive_log AS t GROUP BY t.file_stem ORDER BY v DESC NULLS LAST, t.file_stem NULLS FIRST
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('stg_tpcds_archive_log'[file_stem], "__rows", COUNTROWS('stg_tpcds_archive_log'), "v", 'stg_tpcds_archive_log'[Archive Source Rows]), "file_stem", 'stg_tpcds_archive_log'[file_stem], "v", [v]) ORDER BY [v] DESC, [file_stem]
