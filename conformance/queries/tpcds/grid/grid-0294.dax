// note: the view expander's grid (tools/ossie/grid.mjs), rollup: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.etag, AGG(t."Archive Files") AS v FROM tpcds.stg_tpcds_archive_log AS t GROUP BY ROLLUP (t.etag) ORDER BY t.etag NULLS LAST
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS(ROLLUPADDISSUBTOTAL('stg_tpcds_archive_log'[etag], "__level1_etag"), "__rows", COUNTROWS('stg_tpcds_archive_log'), "v", 'stg_tpcds_archive_log'[Archive Files]), "etag", 'stg_tpcds_archive_log'[etag], "v", [v]) ORDER BY ISBLANK([etag]), [etag]
