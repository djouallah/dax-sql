// note: the view expander's grid (tools/ossie/grid.mjs), cte: its SQL as dax-sql's SQL front end writes it in DAX:
// WITH s AS (SELECT source_type, "Archive Files" AS mm FROM tpcds.stg_tpcds_archive_log WHERE source_type IS NOT NULL) SELECT source_type, AGG(mm) AS v FROM s GROUP BY source_type
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('stg_tpcds_archive_log'[source_type], "__rows", COUNTROWS('stg_tpcds_archive_log'), "v", 'stg_tpcds_archive_log'[Archive Files]), NOT(ISBLANK('stg_tpcds_archive_log'[source_type]))), "source_type", 'stg_tpcds_archive_log'[source_type], "v", [v])
