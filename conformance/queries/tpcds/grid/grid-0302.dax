// note: the view expander's grid (tools/ossie/grid.mjs), star two sides: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.ca_county, f.ss_item_sk, AGG(f."Store Net Profit") AS v FROM tpcds.store_sales AS f JOIN tpcds.customer_address AS o ON f.ss_addr_sk = o.ca_address_sk GROUP BY o.ca_county, f.ss_item_sk
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('customer_address'[ca_county], 'store_sales'[ss_item_sk], "__rows", COUNTROWS('store_sales'), "v", 'store_sales'[Store Net Profit]), NOT(ISBLANK('customer_address'[ca_address_sk]))), "ca_county", 'customer_address'[ca_county], "ss_item_sk", 'store_sales'[ss_item_sk], "v", [v])
