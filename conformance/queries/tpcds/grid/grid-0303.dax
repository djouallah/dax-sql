// note: the view expander's grid (tools/ossie/grid.mjs), star total: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT AGG(f."Store Revenue") AS v FROM tpcds.store_sales AS f JOIN tpcds.customer_address AS o ON f.ss_addr_sk = o.ca_address_sk
EVALUATE SELECTCOLUMNS(CALCULATETABLE(ROW("v", 'store_sales'[Store Revenue]), NOT(ISBLANK('customer_address'[ca_address_sk]))), "v", [v])
