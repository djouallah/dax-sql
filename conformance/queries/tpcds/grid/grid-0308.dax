// note: the view expander's grid (tools/ossie/grid.mjs), where and: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.etag, AGG(t."Archive Files") AS v FROM tpcds.stg_tpcds_archive_log AS t WHERE t.file_stem IS NOT NULL AND NOT (t.archived_at = TIMESTAMP '2026-09-03 02:15:00') GROUP BY t.etag
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('stg_tpcds_archive_log'[etag], "__rows", COUNTROWS('stg_tpcds_archive_log'), "v", 'stg_tpcds_archive_log'[Archive Files]), NOT(ISBLANK('stg_tpcds_archive_log'[file_stem])), NOT(('stg_tpcds_archive_log'[archived_at] = (DATE(2026, 9, 3) + TIME(2, 15, 0))))), "etag", 'stg_tpcds_archive_log'[etag], "v", [v])
