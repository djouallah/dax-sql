// note: the view expander's grid (tools/ossie/grid.mjs), where or: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.etag, AGG(t."Archive Source Rows") AS v FROM tpcds.stg_tpcds_archive_log AS t WHERE t.row_count IS NOT NULL OR t.etag <> 'sf10-1f3a' GROUP BY t.etag
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('stg_tpcds_archive_log'[etag], "__rows", COUNTROWS(stg_tpcds_archive_log), "v", 'stg_tpcds_archive_log'[Archive Source Rows]), (NOT(ISBLANK('stg_tpcds_archive_log'[row_count])) || ('stg_tpcds_archive_log'[etag] <> "sf10-1f3a"))), "etag", 'stg_tpcds_archive_log'[etag], "v", [v])
