// note: the view expander's grid (tools/ossie/grid.mjs), where total: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT AGG(t."Archive Files") AS v FROM tpcds.stg_tpcds_archive_log AS t WHERE NOT (t.source_type = 'fact')
EVALUATE SELECTCOLUMNS(CALCULATETABLE(ROW("v", 'stg_tpcds_archive_log'[Archive Files]), NOT(('stg_tpcds_archive_log'[source_type] = "fact"))), "v", [v])
