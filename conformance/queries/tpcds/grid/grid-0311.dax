// note: the view expander's grid (tools/ossie/grid.mjs), having: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.row_count, AGG(t."Archive Source Rows") AS v FROM tpcds.stg_tpcds_archive_log AS t GROUP BY t.row_count HAVING AGG(t."Archive Source Rows") > 0
EVALUATE SELECTCOLUMNS(FILTER(SUMMARIZECOLUMNS('stg_tpcds_archive_log'[row_count], "__rows", COUNTROWS('stg_tpcds_archive_log'), "v", 'stg_tpcds_archive_log'[Archive Source Rows]), ([v] > 0)), "row_count", 'stg_tpcds_archive_log'[row_count], "v", [v])
