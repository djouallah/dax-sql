// note: the view expander's grid (tools/ossie/grid.mjs), order by measure: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.row_count, AGG(t."Archive Files") AS v FROM tpcds.stg_tpcds_archive_log AS t GROUP BY t.row_count ORDER BY v DESC NULLS LAST, t.row_count NULLS FIRST
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('stg_tpcds_archive_log'[row_count], "__rows", COUNTROWS(stg_tpcds_archive_log), "v", 'stg_tpcds_archive_log'[Archive Files]), "row_count", 'stg_tpcds_archive_log'[row_count], "v", [v]) ORDER BY [v] DESC, [row_count]
