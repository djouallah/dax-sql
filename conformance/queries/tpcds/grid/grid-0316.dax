// note: the view expander's grid (tools/ossie/grid.mjs), rollup: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.archived_at, AGG(t."Archive Source Rows") AS v FROM tpcds.stg_tpcds_archive_log AS t GROUP BY ROLLUP (t.archived_at) ORDER BY t.archived_at NULLS LAST
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS(ROLLUPADDISSUBTOTAL('stg_tpcds_archive_log'[archived_at], "__level1_archived_at"), "__rows", COUNTROWS('stg_tpcds_archive_log'), "v", 'stg_tpcds_archive_log'[Archive Source Rows]), "archived_at", 'stg_tpcds_archive_log'[archived_at], "v", [v]) ORDER BY ISBLANK([archived_at]), [archived_at]
