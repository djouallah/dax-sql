// note: the view expander's grid (tools/ossie/grid.mjs), scalar ops: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.row_count, AGG(t."Archive Source Rows") * 2 AS a, AGG(t."Archive Source Rows") + 1 AS b, COALESCE(AGG(t."Archive Source Rows"), 0) AS c FROM tpcds.stg_tpcds_archive_log AS t GROUP BY t.row_count
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('stg_tpcds_archive_log'[row_count], "__rows", COUNTROWS(stg_tpcds_archive_log), "a", ('stg_tpcds_archive_log'[Archive Source Rows] * 2), "b", ('stg_tpcds_archive_log'[Archive Source Rows] + 1), "c", IF(ISBLANK(COUNTROWS(stg_tpcds_archive_log)), BLANK(), COALESCE('stg_tpcds_archive_log'[Archive Source Rows], 0))), "row_count", 'stg_tpcds_archive_log'[row_count], "a", [a], "b", [b], "c", [c])
