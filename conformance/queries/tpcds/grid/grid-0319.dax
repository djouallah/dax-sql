// note: the view expander's grid (tools/ossie/grid.mjs), cte: its SQL as dax-sql's SQL front end writes it in DAX:
// WITH s AS (SELECT etag, "Archive Source Rows" AS mm FROM tpcds.stg_tpcds_archive_log WHERE archived_at <> TIMESTAMP '2026-09-03 02:15:00') SELECT etag, AGG(mm) AS v FROM s GROUP BY etag
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('stg_tpcds_archive_log'[etag], "__rows", COUNTROWS('stg_tpcds_archive_log'), "v", 'stg_tpcds_archive_log'[Archive Source Rows]), ('stg_tpcds_archive_log'[archived_at] <> (DATE(2026, 9, 3) + TIME(2, 15, 0)))), "etag", 'stg_tpcds_archive_log'[etag], "v", [v])
