// note: the view expander's grid (tools/ossie/grid.mjs), star total: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT AGG(f."Store Revenue") AS v FROM tpcds.store_sales AS f JOIN tpcds.customer_demographics AS o ON f.ss_cdemo_sk = o.cd_demo_sk
EVALUATE SELECTCOLUMNS(CALCULATETABLE(ROW("v", 'store_sales'[Store Revenue]), NOT(ISBLANK('customer_demographics'[cd_demo_sk]))), "v", [v])
