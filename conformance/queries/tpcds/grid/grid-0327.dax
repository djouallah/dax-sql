// note: the view expander's grid (tools/ossie/grid.mjs), two groups: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.file_stem, t.archive_path, AGG(t."Archive Source Rows") AS v FROM tpcds.stg_tpcds_archive_log AS t GROUP BY t.file_stem, t.archive_path
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('stg_tpcds_archive_log'[file_stem], 'stg_tpcds_archive_log'[archive_path], "__rows", COUNTROWS(stg_tpcds_archive_log), "v", 'stg_tpcds_archive_log'[Archive Source Rows]), "file_stem", 'stg_tpcds_archive_log'[file_stem], "archive_path", 'stg_tpcds_archive_log'[archive_path], "v", [v])
