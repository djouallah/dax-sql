// note: the view expander's grid (tools/ossie/grid.mjs), where: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.file_stem, AGG(t."Archive Files") AS v FROM tpcds.stg_tpcds_archive_log AS t WHERE t.source_type IS NOT NULL GROUP BY t.file_stem
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('stg_tpcds_archive_log'[file_stem], "__rows", COUNTROWS('stg_tpcds_archive_log'), "v", 'stg_tpcds_archive_log'[Archive Files]), NOT(ISBLANK('stg_tpcds_archive_log'[source_type]))), "file_stem", 'stg_tpcds_archive_log'[file_stem], "v", [v])
