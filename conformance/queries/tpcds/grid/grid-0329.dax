// note: the view expander's grid (tools/ossie/grid.mjs), where and: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.file_stem, AGG(t."Archive Files") AS v FROM tpcds.stg_tpcds_archive_log AS t WHERE t.archive_path = 'Files/archive/tpcds/sf10/store_sales/part-00000.parquet' AND t.archive_path IN ('Files/archive/tpcds/sf10/date_dim/part-00000.parquet', 'Files/archive/tpcds/sf10/item/part-00000.parquet') GROUP BY t.file_stem
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('stg_tpcds_archive_log'[file_stem], "__rows", COUNTROWS('stg_tpcds_archive_log'), "v", 'stg_tpcds_archive_log'[Archive Files]), ('stg_tpcds_archive_log'[archive_path] = "Files/archive/tpcds/sf10/store_sales/part-00000.parquet"), ('stg_tpcds_archive_log'[archive_path] IN {"Files/archive/tpcds/sf10/date_dim/part-00000.parquet", "Files/archive/tpcds/sf10/item/part-00000.parquet"})), "file_stem", 'stg_tpcds_archive_log'[file_stem], "v", [v])
