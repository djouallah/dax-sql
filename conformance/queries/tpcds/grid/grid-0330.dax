// note: the view expander's grid (tools/ossie/grid.mjs), where or: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.file_stem, AGG(t."Archive Source Rows") AS v FROM tpcds.stg_tpcds_archive_log AS t WHERE NOT (t.archived_at = TIMESTAMP '2026-09-05 04:15:00') OR t.row_count BETWEEN 6 AND 380 GROUP BY t.file_stem
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('stg_tpcds_archive_log'[file_stem], "__rows", COUNTROWS('stg_tpcds_archive_log'), "v", 'stg_tpcds_archive_log'[Archive Source Rows]), (NOT(('stg_tpcds_archive_log'[archived_at] = (DATE(2026, 9, 5) + TIME(4, 15, 0)))) || (('stg_tpcds_archive_log'[row_count] >= 6) && ('stg_tpcds_archive_log'[row_count] <= 380)))), "file_stem", 'stg_tpcds_archive_log'[file_stem], "v", [v])
