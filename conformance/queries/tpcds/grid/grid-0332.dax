// note: the view expander's grid (tools/ossie/grid.mjs), having: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.etag, AGG(t."Archive Source Rows") AS v FROM tpcds.stg_tpcds_archive_log AS t GROUP BY t.etag HAVING AGG(t."Archive Source Rows") > 0
EVALUATE SELECTCOLUMNS(FILTER(SUMMARIZECOLUMNS('stg_tpcds_archive_log'[etag], "__rows", COUNTROWS(stg_tpcds_archive_log), "v", 'stg_tpcds_archive_log'[Archive Source Rows]), ([v] > 0)), "etag", 'stg_tpcds_archive_log'[etag], "v", [v])
