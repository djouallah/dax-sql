// note: the view expander's grid (tools/ossie/grid.mjs), ratio: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.row_count, CAST(AGG(t."Archive Files") AS DOUBLE) / NULLIF(AGG(t."Archive Files"), 0) AS r FROM tpcds.stg_tpcds_archive_log AS t GROUP BY t.row_count
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('stg_tpcds_archive_log'[row_count], "__rows", COUNTROWS('stg_tpcds_archive_log'), "r", IF(ISBLANK(COUNTROWS('stg_tpcds_archive_log')), BLANK(), (CONVERT('stg_tpcds_archive_log'[Archive Files], DOUBLE) / IF(('stg_tpcds_archive_log'[Archive Files] == 0), BLANK(), 'stg_tpcds_archive_log'[Archive Files])))), "row_count", 'stg_tpcds_archive_log'[row_count], "r", [r])
