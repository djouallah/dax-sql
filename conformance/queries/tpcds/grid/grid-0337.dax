// note: the view expander's grid (tools/ossie/grid.mjs), cte: its SQL as dax-sql's SQL front end writes it in DAX:
// WITH s AS (SELECT file_stem, "Archive Files" AS mm FROM tpcds.stg_tpcds_archive_log WHERE row_count IS NOT NULL) SELECT file_stem, AGG(mm) AS v FROM s GROUP BY file_stem
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('stg_tpcds_archive_log'[file_stem], "__rows", COUNTROWS(stg_tpcds_archive_log), "v", 'stg_tpcds_archive_log'[Archive Files]), NOT(ISBLANK('stg_tpcds_archive_log'[row_count]))), "file_stem", 'stg_tpcds_archive_log'[file_stem], "v", [v])
