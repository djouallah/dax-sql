// note: the view expander's grid (tools/ossie/grid.mjs), two metrics: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.etag, AGG(t."Archive Source Rows") AS a, AGG(t."Archive Source Rows") AS b FROM tpcds.stg_tpcds_archive_log AS t GROUP BY t.etag
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('stg_tpcds_archive_log'[etag], "__rows", COUNTROWS('stg_tpcds_archive_log'), "a", 'stg_tpcds_archive_log'[Archive Source Rows], "b", 'stg_tpcds_archive_log'[Archive Source Rows]), "etag", 'stg_tpcds_archive_log'[etag], "a", [a], "b", [b])
