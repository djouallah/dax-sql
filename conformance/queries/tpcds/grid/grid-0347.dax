// note: the view expander's grid (tools/ossie/grid.mjs), where and: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.row_count, AGG(t."Archive Source Rows") AS v FROM tpcds.stg_tpcds_archive_log AS t WHERE t.etag IS NOT NULL AND t.etag IS NOT NULL GROUP BY t.row_count
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('stg_tpcds_archive_log'[row_count], "__rows", COUNTROWS('stg_tpcds_archive_log'), "v", 'stg_tpcds_archive_log'[Archive Source Rows]), NOT(ISBLANK('stg_tpcds_archive_log'[etag])), NOT(ISBLANK('stg_tpcds_archive_log'[etag]))), "row_count", 'stg_tpcds_archive_log'[row_count], "v", [v])
