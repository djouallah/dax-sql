// note: the view expander's grid (tools/ossie/grid.mjs), where or: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.row_count, AGG(t."Archive Source Rows") AS v FROM tpcds.stg_tpcds_archive_log AS t WHERE NOT (t.source_filename = 'item/part-00000.parquet') OR t.source_type <> 'dimension' GROUP BY t.row_count
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('stg_tpcds_archive_log'[row_count], "__rows", COUNTROWS(stg_tpcds_archive_log), "v", 'stg_tpcds_archive_log'[Archive Source Rows]), (NOT(('stg_tpcds_archive_log'[source_filename] = "item/part-00000.parquet")) || ('stg_tpcds_archive_log'[source_type] <> "dimension"))), "row_count", 'stg_tpcds_archive_log'[row_count], "v", [v])
