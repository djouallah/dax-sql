// note: the view expander's grid (tools/ossie/grid.mjs), where total: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT AGG(t."Archive Source Rows") AS v FROM tpcds.stg_tpcds_archive_log AS t WHERE t.archived_at BETWEEN TIMESTAMP '2026-09-01 00:15:00' AND TIMESTAMP '2026-09-02 01:15:00'
EVALUATE SELECTCOLUMNS(CALCULATETABLE(ROW("v", 'stg_tpcds_archive_log'[Archive Source Rows]), (('stg_tpcds_archive_log'[archived_at] >= (DATE(2026, 9, 1) + TIME(0, 15, 0))) && ('stg_tpcds_archive_log'[archived_at] <= (DATE(2026, 9, 2) + TIME(1, 15, 0))))), "v", [v])
