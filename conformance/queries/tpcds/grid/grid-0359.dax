// note: the view expander's grid (tools/ossie/grid.mjs), two metrics: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.row_count, AGG(t."Archive Source Rows") AS a, AGG(t."Archive Files") AS b FROM tpcds.stg_tpcds_archive_log AS t GROUP BY t.row_count
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('stg_tpcds_archive_log'[row_count], "__rows", COUNTROWS('stg_tpcds_archive_log'), "a", 'stg_tpcds_archive_log'[Archive Source Rows], "b", 'stg_tpcds_archive_log'[Archive Files]), "row_count", 'stg_tpcds_archive_log'[row_count], "a", [a], "b", [b])
