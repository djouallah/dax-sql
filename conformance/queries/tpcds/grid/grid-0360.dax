// note: the view expander's grid (tools/ossie/grid.mjs), two groups: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.etag, t.archive_path, AGG(t."Archive Files") AS v FROM tpcds.stg_tpcds_archive_log AS t GROUP BY t.etag, t.archive_path
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('stg_tpcds_archive_log'[etag], 'stg_tpcds_archive_log'[archive_path], "__rows", COUNTROWS('stg_tpcds_archive_log'), "v", 'stg_tpcds_archive_log'[Archive Files]), "etag", 'stg_tpcds_archive_log'[etag], "archive_path", 'stg_tpcds_archive_log'[archive_path], "v", [v])
