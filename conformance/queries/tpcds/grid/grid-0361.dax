// note: the view expander's grid (tools/ossie/grid.mjs), where: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.etag, AGG(t."Archive Source Rows") AS v FROM tpcds.stg_tpcds_archive_log AS t WHERE t.archived_at < TIMESTAMP '2026-09-05 04:15:00' GROUP BY t.etag
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('stg_tpcds_archive_log'[etag], "__rows", COUNTROWS(stg_tpcds_archive_log), "v", 'stg_tpcds_archive_log'[Archive Source Rows]), ('stg_tpcds_archive_log'[archived_at] < (DATE(2026, 9, 5) + TIME(4, 15, 0)))), "etag", 'stg_tpcds_archive_log'[etag], "v", [v])
