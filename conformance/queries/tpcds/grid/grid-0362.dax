// note: the view expander's grid (tools/ossie/grid.mjs), where and: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.etag, AGG(t."Archive Source Rows") AS v FROM tpcds.stg_tpcds_archive_log AS t WHERE t.source_type = 'fact' AND NOT (t.etag = 'sf10-26dc') GROUP BY t.etag
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('stg_tpcds_archive_log'[etag], "__rows", COUNTROWS(stg_tpcds_archive_log), "v", 'stg_tpcds_archive_log'[Archive Source Rows]), ('stg_tpcds_archive_log'[source_type] = "fact"), NOT(('stg_tpcds_archive_log'[etag] = "sf10-26dc"))), "etag", 'stg_tpcds_archive_log'[etag], "v", [v])
