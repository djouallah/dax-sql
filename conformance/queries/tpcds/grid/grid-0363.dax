// SELECT t.etag, AGG(t."Archive Files") AS v FROM tpcds.stg_tpcds_archive_log AS t WHERE t.source_type <> 'fact' OR t.archive_path = 'Files/archive/tpcds/sf10/store/part-00000.parquet' GROUP BY t.etag
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('stg_tpcds_archive_log'[etag], "__rows", COUNTROWS('stg_tpcds_archive_log'), "v", 'stg_tpcds_archive_log'[Archive Files]), (('stg_tpcds_archive_log'[source_type] <> "fact") || ('stg_tpcds_archive_log'[archive_path] = "Files/archive/tpcds/sf10/store/part-00000.parquet"))), "etag", 'stg_tpcds_archive_log'[etag], "v", [v])
