// note: the view expander's grid (tools/ossie/grid.mjs), having null: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.etag, AGG(t."Archive Source Rows") AS v FROM tpcds.stg_tpcds_archive_log AS t GROUP BY t.etag HAVING AGG(t."Archive Files") IS NOT NULL
EVALUATE SELECTCOLUMNS(FILTER(SUMMARIZECOLUMNS('stg_tpcds_archive_log'[etag], "__rows", COUNTROWS('stg_tpcds_archive_log'), "v", 'stg_tpcds_archive_log'[Archive Source Rows]), NOT(ISBLANK('stg_tpcds_archive_log'[Archive Files]))), "etag", 'stg_tpcds_archive_log'[etag], "v", [v])
