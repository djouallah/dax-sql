// note: the view expander's grid (tools/ossie/grid.mjs), cte: its SQL as dax-sql's SQL front end writes it in DAX:
// WITH s AS (SELECT etag, "Archive Files" AS mm FROM tpcds.stg_tpcds_archive_log WHERE NOT (archive_path = 'Files/archive/tpcds/sf10/catalog_sales/part-00000.parquet')) SELECT etag, AGG(mm) AS v FROM s GROUP BY etag
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('stg_tpcds_archive_log'[etag], "__rows", COUNTROWS('stg_tpcds_archive_log'), "v", 'stg_tpcds_archive_log'[Archive Files]), NOT(('stg_tpcds_archive_log'[archive_path] = "Files/archive/tpcds/sf10/catalog_sales/part-00000.parquet"))), "etag", 'stg_tpcds_archive_log'[etag], "v", [v])
