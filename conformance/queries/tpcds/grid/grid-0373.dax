// note: the view expander's grid (tools/ossie/grid.mjs), two groups: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.row_count, t.archived_at, AGG(t."Archive Files") AS v FROM tpcds.stg_tpcds_archive_log AS t GROUP BY t.row_count, t.archived_at
EVALUATE SELECTCOLUMNS(SUMMARIZECOLUMNS('stg_tpcds_archive_log'[row_count], 'stg_tpcds_archive_log'[archived_at], "__rows", COUNTROWS(stg_tpcds_archive_log), "v", 'stg_tpcds_archive_log'[Archive Files]), "row_count", 'stg_tpcds_archive_log'[row_count], "archived_at", 'stg_tpcds_archive_log'[archived_at], "v", [v])
