// note: the view expander's grid (tools/ossie/grid.mjs), where or: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT t.row_count, AGG(t."Archive Files") AS v FROM tpcds.stg_tpcds_archive_log AS t WHERE t.row_count >= 1096 OR NOT (t.source_type = 'dimension') GROUP BY t.row_count
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('stg_tpcds_archive_log'[row_count], "__rows", COUNTROWS(stg_tpcds_archive_log), "v", 'stg_tpcds_archive_log'[Archive Files]), (('stg_tpcds_archive_log'[row_count] >= 1096) || NOT(('stg_tpcds_archive_log'[source_type] = "dimension")))), "row_count", 'stg_tpcds_archive_log'[row_count], "v", [v])
