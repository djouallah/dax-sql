// note: the view expander's grid (tools/ossie/grid.mjs), where total: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT AGG(t."Archive Source Rows") AS v FROM tpcds.stg_tpcds_archive_log AS t WHERE t.source_filename IN ('catalog_sales/part-00000.parquet', 'catalog_sales/part-00000.parquet')
EVALUATE SELECTCOLUMNS(CALCULATETABLE(ROW("v", 'stg_tpcds_archive_log'[Archive Source Rows]), ('stg_tpcds_archive_log'[source_filename] IN {"catalog_sales/part-00000.parquet", "catalog_sales/part-00000.parquet"})), "v", [v])
