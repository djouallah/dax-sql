// note: the view expander's grid (tools/ossie/grid.mjs), cte: its SQL as dax-sql's SQL front end writes it in DAX:
// WITH s AS (SELECT row_count, "Archive Files" AS mm FROM tpcds.stg_tpcds_archive_log WHERE NOT (source_type = 'fact')) SELECT row_count, AGG(mm) AS v FROM s GROUP BY row_count
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('stg_tpcds_archive_log'[row_count], "__rows", COUNTROWS('stg_tpcds_archive_log'), "v", 'stg_tpcds_archive_log'[Archive Files]), NOT(('stg_tpcds_archive_log'[source_type] = "fact"))), "row_count", 'stg_tpcds_archive_log'[row_count], "v", [v])
