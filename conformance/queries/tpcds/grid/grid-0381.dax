// note: the view expander's grid (tools/ossie/grid.mjs), star where one: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.cd_demo_sk, AGG(f."Store Net Profit") AS v FROM tpcds.store_sales AS f LEFT JOIN tpcds.customer_demographics AS o ON f.ss_cdemo_sk = o.cd_demo_sk WHERE o.cd_marital_status = 'S' GROUP BY o.cd_demo_sk
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('customer_demographics'[cd_demo_sk], "__rows", COUNTROWS('store_sales'), "v", 'store_sales'[Store Net Profit]), ('customer_demographics'[cd_marital_status] = "S")), "cd_demo_sk", 'customer_demographics'[cd_demo_sk], "v", [v])
