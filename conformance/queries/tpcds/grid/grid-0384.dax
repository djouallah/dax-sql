// note: the view expander's grid (tools/ossie/grid.mjs), star total: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT AGG(f."Catalog Net Profit") AS v FROM tpcds.catalog_sales AS f JOIN tpcds.date_dim AS o ON f.cs_sold_date_sk = o.d_date_sk_1
EVALUATE SELECTCOLUMNS(CALCULATETABLE(ROW("v", 'catalog_sales'[Catalog Net Profit]), NOT(ISBLANK('date_dim'[d_date_sk_1]))), "v", [v])
