// note: the view expander's grid (tools/ossie/grid.mjs), star: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.i_size, AGG(f."Catalog Revenue") AS v FROM tpcds.catalog_sales AS f JOIN tpcds.item AS o ON f.cs_item_sk = o.i_item_sk GROUP BY o.i_size
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('item'[i_size], "__rows", COUNTROWS(catalog_sales), "v", 'catalog_sales'[Catalog Revenue]), NOT(ISBLANK('item'[i_item_sk]))), "i_size", 'item'[i_size], "v", [v])
