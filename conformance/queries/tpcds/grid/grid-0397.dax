// note: the view expander's grid (tools/ossie/grid.mjs), star where many: its SQL as dax-sql's SQL front end writes it in DAX:
// SELECT o.d_year, AGG(f."Catalog Sales Quantity") AS v FROM tpcds.catalog_sales AS f LEFT JOIN tpcds.date_dim AS o ON f.cs_sold_date_sk = o.d_date_sk_1 WHERE f.cs_bill_addr_sk BETWEEN 1 AND 6 GROUP BY o.d_year
EVALUATE SELECTCOLUMNS(CALCULATETABLE(SUMMARIZECOLUMNS('date_dim'[d_year], "__rows", COUNTROWS(catalog_sales), "v", 'catalog_sales'[Catalog Sales Quantity]), (('catalog_sales'[cs_bill_addr_sk] >= 1) && ('catalog_sales'[cs_bill_addr_sk] <= 6))), "d_year", 'date_dim'[d_year], "v", [v])
