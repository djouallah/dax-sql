// note: the paper's "Store Revenue Time Analysis matrix" visual, round 1 (state AR), as Power BI wrote it
DEFINE
	VAR __DS0FilterTable = 
		TREATAS({"AR"}, 'customer_address'[ca_state])

	VAR __DS0FilterTable2 = 
		TREATAS({"2 yr Degree"}, 'customer_demographics'[cd_education_status])

	VAR __DS0FilterTable3 = 
		TREATAS({2025}, 'date_dim'[d_year])

	VAR __DS0FilterTable4 = 
		FILTER(
			KEEPFILTERS(VALUES('catalog_sales'[cache_buster])),
			'catalog_sales'[cache_buster] < 2
		)

	VAR __DS0FilterTable5 = 
		FILTER(KEEPFILTERS(VALUES('store_sales'[cache_buster])), 'store_sales'[cache_buster] < 2)

	VAR __DS0Core = 
		SUMMARIZECOLUMNS(
			'item'[i_category],
			'date_dim'[d_quarter_name],
			'date_dim'[d_year],
			__DS0FilterTable,
			__DS0FilterTable2,
			__DS0FilterTable3,
			__DS0FilterTable4,
			__DS0FilterTable5,
			"Store_Revenue", 'store_sales'[Store Revenue],
			"Store_Revenue_YoY", 'store_sales'[Store Revenue YoY],
			"Store_Revenue_YTD", 'store_sales'[Store Revenue YTD]
		)

	VAR __DS0PrimaryWindowed = 
		TOPN(501, __DS0Core, 'item'[i_category], 0, 'date_dim'[d_quarter_name], 1, 'date_dim'[d_year], 1)

EVALUATE
	__DS0PrimaryWindowed

ORDER BY
	'item'[i_category] DESC, 'date_dim'[d_quarter_name], 'date_dim'[d_year]
