// note: visual calculation, two levels on the rows, state then store: RANK with an ORDERBY cannot take a reset
// expect: error
DEFINE
	COLUMN 'V'[calc] = RANK(ORDERBY([Rev], DESC), LOWESTPARENT)
	TABLE 'V' =
		SELECTCOLUMNS(
			SUMMARIZECOLUMNS(ROLLUPADDISSUBTOTAL('store'[s_state], "T1", 'store'[s_store_name], "T2"), "Rev", [Store Revenue]),
			"state", 'store'[s_state], "T1", [T1], "store", 'store'[s_store_name], "T2", [T2], "Rev", [Rev]
		)
		WITH VISUAL SHAPE
		AXIS rows
			GROUP [state] TOTAL [T1]
			GROUP [store] TOTAL [T2]
			ORDER BY [state] ASC, [store] ASC
		DENSIFY "IsDensifiedRow"
EVALUATE 'V'
ORDER BY 'V'[T1], 'V'[state], 'V'[T2], 'V'[store]
