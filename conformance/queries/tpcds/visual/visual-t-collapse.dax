// note: visual calculation, three levels on the rows, state, city, store: COLLAPSE one level
DEFINE
	COLUMN 'V'[calc] = COLLAPSE([Rev], ROWS)
	TABLE 'V' =
		SELECTCOLUMNS(
			SUMMARIZECOLUMNS(ROLLUPADDISSUBTOTAL('store'[s_state], "T1", 'store'[s_city], "T2", 'store'[s_store_name], "T3"), "Rev", [Store Revenue]),
			"state", 'store'[s_state], "T1", [T1], "city", 'store'[s_city], "T2", [T2], "store", 'store'[s_store_name], "T3", [T3], "Rev", [Rev]
		)
		WITH VISUAL SHAPE
		AXIS rows
			GROUP [state] TOTAL [T1]
			GROUP [city] TOTAL [T2]
			GROUP [store] TOTAL [T3]
			ORDER BY [state] ASC, [city] ASC, [store] ASC
		DENSIFY "IsDensifiedRow"
EVALUATE 'V'
ORDER BY 'V'[T1], 'V'[state], 'V'[T2], 'V'[city], 'V'[T3], 'V'[store]
