      {
        "name": "store_sales",
        "description": "The larger fact table and this dataset's mart: 26,206,837 rows at SF10, 262,082,396 at SF100. Carries the paper's `cache_buster` column, unread here.",
        "sourceLineageTag": "[mart].[store_sales]",
        "columns": [
          {
            "name": "cache_buster",
            "dataType": "int64",
            "sourceColumn": "cache_buster",
            "sourceLineageTag": "cache_buster",
            "summarizeBy": "none"
