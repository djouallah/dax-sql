          {
            "name": "cs_ext_list_price",
            "dataType": "decimal",
            "sourceColumn": "cs_ext_list_price",
            "sourceLineageTag": "cs_ext_list_price",
            "summarizeBy": "none",
            "formatString": "#,##0.00"
          },
          {
            "name": "cs_ext_sales_price",
            "dataType": "decimal",
            "sourceColumn": "cs_ext_sales_price",
            "sourceLineageTag": "cs_ext_sales_price",
            "summarizeBy": "none",
            "formatString": "#,##0.00"
          },
          {
            "name": "cs_list_price",
            "dataType": "decimal",
            "sourceColumn": "cs_list_price",
            "sourceLineageTag": "cs_list_price",
            "summarizeBy": "none",
            "formatString": "#,##0.00"
          },
          {
            "name": "cs_net_profit",
            "dataType": "decimal",
            "sourceColumn": "cs_net_profit",
            "sourceLineageTag": "cs_net_profit",
            "summarizeBy": "none",
            "formatString": "#,##0.00"
          }
        ],
        "measures": [
          {
            "name": "Catalog Revenue",
            "expression": "SUM(catalog_sales[cs_ext_sales_price])",
            "formatString": "#,##0.00",
            "description": "Q3's value -- the bar chart the paper ranks by promotion."
          },
          {
            "name": "Catalog Sales Quantity",
            "expression": "SUM(catalog_sales[cs_quantity])",
            "formatString": "#,##0",
            "description": "Q4's value."
          },
          {
            "name": "Catalog Sales Same Period LY",
            "expression": "CALCULATE([Catalog Sales Quantity], SAMEPERIODLASTYEAR(date_dim[d_date]))",
            "formatString": "#,##0",
            "description": "Q4's prior-year series."
          },
          {
            "name": "Catalog Sales YoY",
            "expression": "DIVIDE([Catalog Sales Quantity] - [Catalog Sales Same Period LY], [Catalog Sales Same Period LY])",
            "formatString": "0.00%",
            "description": "Q4's third series."
          },
          {
            "name": "Catalog Net Profit",
            "expression": "SUM(catalog_sales[cs_net_profit])",
            "formatString": "#,##0.00",
            "description": "Not a paper measure. Carried so the catalog-page composite has a second value and cs_net_profit is not a column the suite never touches."
          }
        ],
        "partitions": [
          {
            "name": "catalog_sales",
            "mode": "directLake",
            "source": {
              "type": "entity",
              "entityName": "catalog_sales",
              "expressionSource": "DirectLake",
              "schemaName": "mart"
            }
          }
        ]
      },
      {
        "name": "stg_tpcds_archive_log",
        "description": "What download_tpcds.py landed: one row per parquet file. `etag` carries sf<N>, so a reader can tell which scale factor a run measured.",
        "sourceLineageTag": "[landing].[stg_tpcds_archive_log]",
        "columns": [
          {
            "name": "source_type",
            "dataType": "string",
            "sourceColumn": "source_type",
            "sourceLineageTag": "source_type",
            "summarizeBy": "none"
          },
          {
            "name": "source_filename",
            "dataType": "string",
            "sourceColumn": "source_filename",
            "sourceLineageTag": "source_filename",
            "summarizeBy": "none"
          },
          {
            "name": "archive_path",
            "dataType": "string",
            "sourceColumn": "archive_path",
            "sourceLineageTag": "archive_path",
            "summarizeBy": "none"
          },
          {
            "name": "archived_at",
            "dataType": "dateTime",
            "sourceColumn": "archived_at",
            "sourceLineageTag": "archived_at",
            "summarizeBy": "none",
            "formatString": "yyyy-MM-dd"
          },
          {
            "name": "row_count",
            "dataType": "int64",
            "sourceColumn": "row_count",
            "sourceLineageTag": "row_count",
            "summarizeBy": "none"
          },
          {
            "name": "etag",
            "dataType": "string",
            "sourceColumn": "etag",
            "sourceLineageTag": "etag",
            "summarizeBy": "none"
          },
          {
            "name": "file_stem",
            "dataType": "string",
            "sourceColumn": "file_stem",
            "sourceLineageTag": "file_stem",
            "summarizeBy": "none"
          }
        ],
        "measures": [
          {
            "name": "Archive Files",
            "expression": "COUNTROWS(stg_tpcds_archive_log)",
            "formatString": "#,##0",
            "description": "Raw-tier query."
          },
          {
            "name": "Archive Source Rows",
            "expression": "SUM(stg_tpcds_archive_log[row_count])",
            "formatString": "#,##0",
            "description": "Rows the generator logged, summed -- the same number the singular tests reconcile."
          }
        ],
        "partitions": [
          {
            "name": "stg_tpcds_archive_log",
            "mode": "directLake",
            "source": {
              "type": "entity",
              "entityName": "stg_tpcds_archive_log",
              "expressionSource": "DirectLake",
              "schemaName": "landing"
            }
          }
        ]
      }
    ],
