            "sourceLineageTag": "ss_promo_sk",
            "summarizeBy": "none"
          },
          {
            "name": "ss_sold_date_sk",
            "dataType": "int64",
            "sourceColumn": "ss_sold_date_sk",
            "sourceLineageTag": "ss_sold_date_sk",
            "summarizeBy": "none"
          },
          {
            "name": "ss_store_sk",
