            "sourceColumn": "ss_store_sk",
            "sourceLineageTag": "ss_store_sk",
            "summarizeBy": "none"
          },
          {
            "name": "ss_ticket_number",
            "dataType": "int64",
            "sourceColumn": "ss_ticket_number",
            "sourceLineageTag": "ss_ticket_number",
            "summarizeBy": "none"
          },
          {
            "name": "ss_quantity",
            "dataType": "int64",
            "sourceColumn": "ss_quantity",
            "sourceLineageTag": "ss_quantity",
            "summarizeBy": "none"
          },
          {
            "name": "ss_ext_list_price",
            "dataType": "decimal",
            "sourceColumn": "ss_ext_list_price",
            "sourceLineageTag": "ss_ext_list_price",
            "summarizeBy": "none",
            "formatString": "#,##0.00"
          },
          {
            "name": "ss_ext_sales_price",
            "dataType": "decimal",
            "sourceColumn": "ss_ext_sales_price",
            "sourceLineageTag": "ss_ext_sales_price",
            "summarizeBy": "none",
            "formatString": "#,##0.00"
          },
          {
            "name": "ss_list_price",
            "dataType": "decimal",
            "sourceColumn": "ss_list_price",
            "sourceLineageTag": "ss_list_price",
            "summarizeBy": "none",
            "formatString": "#,##0.00"
          },
          {
            "name": "ss_net_profit",
            "dataType": "decimal",
            "sourceColumn": "ss_net_profit",
            "sourceLineageTag": "ss_net_profit",
            "summarizeBy": "none",
            "formatString": "#,##0.00"
          }
        ],
        "measures": [
          {
            "name": "Store Revenue",
            "expression": "SUM(store_sales[ss_ext_sales_price])",
            "formatString": "#,##0.00",
            "description": "Q5's value. The matrix on the paper's report page titles it Store Revenue."
          },
          {
            "name": "Store Net Profit",
            "expression": "SUM(store_sales[ss_net_profit])",
            "formatString": "#,##0.00",
            "description": "The numerator of Q2's share."
          },
          {
            "name": "Store Distinct Customers",
            "expression": "DISTINCTCOUNT(store_sales[ss_customer_sk])",
            "formatString": "#,##0",
            "description": "Q1. The report page's Customer Count card, which reads 496K at SF10 -- 500,000 customers exist and 496K of them appear in store_sales."
          },
          {
            "name": "Store Profit % by Item Category",
            "expression": "DIVIDE([Store Net Profit], CALCULATE([Store Net Profit], REMOVEFILTERS('item')))",
            "formatString": "0.00%",
            "description": "Q2. Each category's share of total store profit, which is what the donut splits."
          },
          {
            "name": "Store Revenue Same Period LY",
            "expression": "CALCULATE([Store Revenue], SAMEPERIODLASTYEAR(date_dim[d_date]))",
            "formatString": "#,##0.00",
            "description": "Q5's prior-year term. Needs date_dim marked as the date table."
          },
          {
            "name": "Store Revenue YoY",
            "expression": "DIVIDE([Store Revenue] - [Store Revenue Same Period LY], [Store Revenue Same Period LY])",
            "formatString": "0.00%",
            "description": "Q5's year-over-year column."
          },
          {
            "name": "Store Revenue YTD",
            "expression": "TOTALYTD([Store Revenue], date_dim[d_date])",
            "formatString": "#,##0.00",
            "description": "Q5's year-to-date column."
          }
        ],
        "partitions": [
          {
            "name": "store_sales",
            "mode": "directLake",
            "source": {
              "type": "entity",
              "entityName": "store_sales",
              "expressionSource": "DirectLake",
              "schemaName": "mart"
            }
          }
        ]
      },
