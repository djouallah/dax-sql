{
  "name": "dax-sql",
  "version": "0.2.4",
  "license": "MIT",
  "author": "N.S. Devaraj (https://github.com/nsdevaraj)",
  "description": "DAX and Apache Ossie SQL queries over semantic models (TMSL, TMDL, Ossie) compiled to one SQL SELECT for DuckDB or T-SQL (Microsoft Fabric), held to Power BI's answers",
  "keywords": [
    "dax",
    "sql",
    "power-bi",
    "semantic-model",
    "tabular",
    "tmsl",
    "tmdl",
    "duckdb",
    "tsql",
    "fabric",
    "ossie",
    "compiler"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/djouallah/dax-sql.git"
  },
  "homepage": "https://djouallah.github.io/dax-sql/",
  "bugs": "https://github.com/djouallah/dax-sql/issues",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./formats/tmsl.js": "./formats/tmsl.js",
    "./formats/tmdl.js": "./formats/tmdl.js",
    "./formats/ossie.js": "./formats/ossie.js",
    "./formats/ossie-wide.js": "./formats/ossie-wide.js"
  },
  "files": [
    "src/",
    "formats/tmsl.js",
    "formats/tmdl.js",
    "formats/ossie.js",
    "formats/ossie-sql.js",
    "formats/ossie-wide.js",
    "DESIGN.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "test": "node --test test/*.test.js formats/test/*.test.js"
  },
  "devDependencies": {
    "@duckdb/node-api": "^2.0.0-r.1",
    "c8": "^12.0.0",
    "yaml": "2.8.1"
  }
}
